    record_reconcile_target_live.add_argument("--evidence-code", choices=("runtime_error_browser_use_target_not_interactive",), required=True)
    record_reconcile_target_live.set_defaults(action="record-reconcile-target-not-interactive-live")
    record_reconcile_target_history = sub.add_parser("record-reconcile-target-not-interactive-history", help="reconcile a helper-rejected target after a later same-run state change")
    record_reconcile_target_history.add_argument("--run-id", required=True)
    record_reconcile_target_history.add_argument("--session", required=True)
    record_reconcile_target_history.add_argument("--descriptor", required=True)
    record_reconcile_target_history.add_argument("--authority")
    record_reconcile_target_history.add_argument("--task-id", help="required when the recording lifecycle is temporary")
    record_reconcile_target_history.add_argument("--operation-id", required=True)
    record_reconcile_target_history.add_argument("--target-text-length", type=int, required=True)
    record_reconcile_target_history.add_argument("--target-text-sha256", required=True)
    record_reconcile_target_history.add_argument("--state-marker", required=True)
    record_reconcile_target_history.add_argument("--evidence-code", choices=("runtime_error_browser_use_target_not_interactive",), required=True)
    record_reconcile_target_history.set_defaults(action="record-reconcile-target-not-interactive-history")
    record_reconcile_click = sub.add_parser("record-reconcile-click-readback", help="reconcile one dispatched click after exact same-run URL/state readback")
    record_reconcile_click.add_argument("--run-id", required=True)
    record_reconcile_click.add_argument("--session", required=True)
    record_reconcile_click.add_argument("--descriptor", required=True)
    record_reconcile_click.add_argument("--authority")
    record_reconcile_click.add_argument("--task-id", help="required when the recording lifecycle is temporary")
    record_reconcile_click.add_argument("--operation-id", required=True)
    record_reconcile_click.set_defaults(action="record-reconcile-click-readback")
    record_reconcile_click_live = sub.add_parser("record-reconcile-click-readback-live", help="reconcile a dispatched coordinate click after fresh same-run route/state proof")
    record_reconcile_click_live.add_argument("--run-id", required=True)
    record_reconcile_click_live.add_argument("--session", required=True)
    record_reconcile_click_live.add_argument("--descriptor", required=True)
    record_reconcile_click_live.add_argument("--authority")
    record_reconcile_click_live.add_argument("--task-id", help="required when the recording lifecycle is temporary")
    record_reconcile_click_live.add_argument("--operation-id", required=True)
    record_reconcile_click_live.add_argument("--expected-path", required=True)
    record_reconcile_click_live.add_argument("--state-marker", required=True)
    record_reconcile_click_live.set_defaults(action="record-reconcile-click-readback-live")
    target_inspect = sub.add_parser("record-target-inspect", help="resolve one target from fresh state without clicking")
    target_inspect.add_argument("--run-id", required=True)
    target_inspect.add_argument("--session", required=True)
    target_inspect.add_argument("--descriptor", required=True)
    target_inspect.add_argument("--authority")
    target_inspect.add_argument("--authority-renewal", "--authority-renewal-path", dest="authority_renewal", help="immutable 0600 renewal JSON for the next authority generation")
    target_inspect.add_argument("--task-id", help="required when the recording lifecycle is temporary")
    target_inspect.add_argument("--target-text", required=True)
    target_inspect.set_defaults(action="record-target-inspect")
    target_click = sub.add_parser("record-target-click", help="resolve one fresh target and click it")
    target_click.add_argument("--run-id", required=True)
    target_click.add_argument("--session", required=True)
    target_click.add_argument("--descriptor", required=True)
    target_click.add_argument("--authority", required=True)
    target_click.add_argument("--authority-renewal", "--authority-renewal-path", dest="authority_renewal", help="immutable 0600 renewal JSON for the next authority generation")
    target_click.add_argument("--task-id", help="required when the recording lifecycle is temporary")
    target_click.add_argument("--target-text", required=True)
    target_click.add_argument("--allow-coordinate-fallback", action="store_true", help="allow fresh bbox center click for non-interactive elements")
    target_click.set_defaults(action="record-target-click")
    record_finalize = sub.add_parser("record-finalize", help="close and verify an active recording session")
    record_finalize.add_argument("--run-id", required=True)
    record_finalize.add_argument("--session", required=True)
    record_finalize.add_argument("--descriptor", required=True)
    record_finalize.add_argument("--authority")
    record_finalize.add_argument("--authority-renewal", "--authority-renewal-path", dest="authority_renewal", help="immutable 0600 renewal JSON for the next authority generation")
    record_finalize.add_argument("--task-id", help="required when finalizing a temporary recording")
    record_finalize.add_argument("--delete-approved", action="store_true", help="user approved deletion after the AI asked whether the task is complete")
    record_finalize.add_argument("--user-ok", dest="delete_approved", action="store_true", help=argparse.SUPPRESS)
    record_finalize.add_argument("--cleanup-only", action="store_true", help="terminal cleanup only; permits descriptor-bound expired authority without browser actions")
    record_finalize.set_defaults(action="record-finalize")
    recording_status = sub.add_parser("recording-status", help="classify recording descriptors by fresh process/listener/recorder evidence")
    recording_status.add_argument("--descriptor", help="inspect one descriptor; otherwise inspect all canonical recording descriptors")
    recording_status.add_argument("--mark-stale", action="store_true", help="mark only positively stale active/continued descriptors; never deletes or stops processes")
    recording_status.set_defaults(action="recording-status")
    flow_finalize = sub.add_parser("flow-finalize-lease", help="finalize one run-owned Browser Use flow lease")
    flow_finalize.add_argument("--lease", required=True)
    flow_finalize.add_argument("--delete-approved", action="store_true", help="user approved deletion after the AI asked whether the task is complete")
    flow_finalize.add_argument("--user-ok", dest="delete_approved", action="store_true", help=argparse.SUPPRESS)
    flow_finalize.set_defaults(action="flow-finalize-lease")
    for mode in ("public", "authorized"):
        command = sub.add_parser(mode, help=f"run Browser Use in {mode} mode")
        command.add_argument("--run-id", required=True)
        command.add_argument("--session", required=True)
        command.add_argument("--automation-id", default="manual")
        command.add_argument("--lifecycle", choices=("scheduled", "single-use", TEMPORARY_LIFECYCLE), required=True)
        command.add_argument("--task-id", help="required for the temporary authorized lifecycle")
        command.add_argument("--port", type=int)
        command.add_argument("--allowed-origin", action="append", default=[])
        command.add_argument("--authority", help="0600 authority JSON required for authorized mode")
        command.add_argument("--post-command-json", default="", help="bounded read-only post commands as JSON arrays")
        command.add_argument("--artifact-dir", default="", help="canonical 0700 directory for bounded screenshot/readback artifacts")
        command.add_argument("command", nargs=argparse.REMAINDER, help="Browser Use command after --, for example: -- open https://example.com")
        command.set_defaults(action="execute", mode=mode)
    rooms = sub.add_parser("rooms", aliases=["room-list"], help="list helper-owned Browser Use rooms")
    rooms.add_argument("--json", dest="json_output", action="store_true", help="emit the sanitized registry as JSON")
    rooms.set_defaults(action="rooms")
    room_update = sub.add_parser("room-update", help="update one room state with owner-bound activity")
    room_update.add_argument("--room-id", required=True)
    room_update.add_argument("--run-id", required=True)
    room_update.add_argument("--state", choices=tuple(sorted(ROOM_REGISTRY_STATES)), default="active")
    room_update.add_argument("--activity", default="update")
    room_update.set_defaults(action="room-update")
    room_release = sub.add_parser("room-release", help="release one owner-bound room")
    room_release.add_argument("--room-id", required=True)
    room_release.add_argument("--run-id", required=True)
    room_release.add_argument("--activity", default="release")
    room_release.set_defaults(action="room-release")
    validate = sub.add_parser("validate", help="no-launch executable, root, version, hash and port-range validation")
    validate.set_defaults(action="validate")
    clean = sub.add_parser("janitor", help="remove only expired exact quarantine directories after rechecks")
    clean.set_defaults(action="janitor")
    reconcile = sub.add_parser("reconcile-failed-startup", help="reconcile one descriptorless single-use launch after exact absence readback")
    reconcile.add_argument("--run-id", required=True)
    reconcile.add_argument("--profile-lock", required=True)
    reconcile.add_argument("--profile", required=True)
    reconcile.add_argument("--port", type=int, required=True)
    reconcile.set_defaults(action="reconcile-failed-startup")
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        config = read_toml()
        if args.action == "validate":
            versions = validate_installation(config)
            print(json.dumps({"status": "completed", "launch": False, "versions_hashes": versions, "finalized": True}, sort_keys=True))
            return 0
        if args.action == "janitor":
            return janitor(config)
        if args.action == "rooms":
            return room_registry_command(config, args)
        if args.action == "room-update":
            print(json.dumps(room_registry_update(config, args.room_id, run_id=args.run_id, state=args.state, activity=args.activity), sort_keys=True))
            return 0
        if args.action == "room-release":
            print(json.dumps(room_registry_release(config, args.room_id, run_id=args.run_id, activity=args.activity), sort_keys=True))
            return 0
        if args.action == "reconcile-failed-startup":
            return reconcile_failed_startup(args)
        if args.action == "login-handoff":
            return login_handoff(args)
        if args.action == "continue":
            return continue_handoff(args)
        if args.action == "handoff-watchdog":
            return handoff_watchdog(args)
        if args.action == "finalize":
            return finalize_handoff(args)
        if args.action == "record-start":
            return record_start(args)
        if args.action == "record-command":
            return record_command(args)
        if args.action == "record-resume":
            return record_resume(args)
        if args.action == "record-recover":
            return record_recover(args)
        if args.action == "record-reconcile-target-not-interactive":
            return record_reconcile_target_not_interactive(args)
        if args.action == "record-reconcile-navigation":
            return record_reconcile_navigation(args)
        if args.action == "record-reconcile-eval-syntax-error":
            return record_reconcile_eval_syntax_error(args)
        if args.action == "record-reconcile-target-not-interactive-live":
            return record_reconcile_target_not_interactive_live(args)
        if args.action == "record-reconcile-target-not-interactive-history":
            return record_reconcile_target_not_interactive_history(args)
        if args.action == "record-reconcile-click-readback":
            return record_reconcile_click_readback(args)
        if args.action == "record-reconcile-click-readback-live":
            return record_reconcile_click_readback_live(args)
        if args.action == "record-target-inspect":
            return record_target_inspect(args)
        if args.action == "record-target-click":
            return record_target_click(args)
        if args.action == "record-finalize":
            return record_finalize(args)
        if args.action == "recording-status":
            return recording_status(args)
        if args.action == "flow-finalize-lease":
            return flow_finalize_lease(args)
        return execute(args)
    except Blocker as exc:
        print(json.dumps({"status": "blocked", "exact_blocker": exc.code, "detail": exc.detail, "finalized": False}, sort_keys=True))
        return 1
    except (OSError, ValueError, tomllib.TOMLDecodeError) as exc:
        print(json.dumps({"status": "blocked", "exact_blocker": "browser_use_runtime_error", "detail": type(exc).__name__, "finalized": False}, sort_keys=True))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
