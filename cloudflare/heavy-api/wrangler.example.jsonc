{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heavy-chain-api-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "ai": { "binding": "AI" },
  "services": [{ "binding": "AUTH_SERVICE", "service": "consumer-auth" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-with-d1-database",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_MEDIA",
      "bucket_name": "replace-with-private-r2-bucket"
    }
  ],
  "vars": {
    "AUTH_ISSUER": "https://consumer-auth.example.workers.dev",
    "FRONTEND_ORIGINS": "https://replace-with-frontend.example",
    "AI_IMAGE_PROVIDER": "workers_ai",
    "AI_IMAGE_ENABLED": "false",
    "HEAVY_IMAGE_ENTITLEMENT_ENABLED": "false",
    "HEAVY_TERMS_VERSION": "heavy-terms-v1",
    "HEAVY_RIGHTS_ATTESTATION_VERSION": "heavy-rights-v1",
    "HEAVY_TERMS_DOCUMENT_VERSION": "heavy-terms-document-v1",
    "HEAVY_TERMS_DOCUMENT_DIGEST": "25d74ddf231dcdf959f20c533bde9d07fd80afc8722dfe4f0804030cfca05998",
    "HEAVY_RIGHTS_DOCUMENT_VERSION": "heavy-rights-document-v1",
    "HEAVY_RIGHTS_DOCUMENT_DIGEST": "76a48a0a6806c543ba2edd5672f6c4e4936c15478f5c72d179a2cd9c46e498eb",
    "AI_IMAGE_ALLOWED_ACTIONS": "generate-image,edit-image,model-matrix",
    "AI_IMAGE_TIMEOUT_MS": "45000",
    "AI_MONTHLY_IMAGE_UNITS": "25",
    "AI_DAILY_IMAGE_UNITS": "100",
    "AI_DAILY_ESTIMATED_NEURONS": "5000",
    "PUBLIC_SHARE_ENABLED": "false",
    "PUBLIC_APP_ORIGIN": "https://replace-with-frontend.example"
  }
  // Set the server-only browser media capability key separately:
  // npx wrangler secret put MEDIA_READ_SECRET
}
