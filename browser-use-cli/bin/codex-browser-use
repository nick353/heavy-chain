    target_click = sub.add_parser("record-target-click", help="resolve one fresh target and click it")
    target_click.add_argument("--run-id", required=True)
    target_click.add_argument("--session", required=True)
    target_click.add_argument("--descriptor", required=True)
    target_click.add_argument("--authority")
    target_click.add_argument("--authority-renewal", "--authority-renewal-path", dest="authority_renewal", help="immutable 0600 renewal JSON for the next authority generation")
    target_click.add_argument("--auto-renew", action="store_true", default=True, help="automatically issue one bounded append-only authority renewal when admission budget is insufficient")
    target_click.add_argument("--task-id", help="required when the recording lifecycle is temporary")
    target_click.add_argument("--target-text", required=True)
    target_click.add_argument("--allow-coordinate-fallback", action="store_true", help="allow fresh bbox center click for non-interactive elements")
    target_click.set_defaults(action="record-target-click")
    record_finalize = sub.add_parser("record-finalize", help="close and verify an active recording session")
    record_finalize.add_argument("--run-id", required=True)
    record_finalize.add_argument("--session", required=True)
    record_finalize.add_argument("--descriptor", required=True)
    record_finalize.add_argument("--authority")
    record_finalize.add_argument("--authority-renewal", "--authority-renewal-path", dest="authority_renewal", help="immutable 0600 renewal JSON for the next authority generation")
    record_finalize.add_argument("--task-id", help="required when finalizing a temporary recording")
    record_finalize.add_argument("--delete-approved", action="store_true", help="user approved deletion after the AI asked whether the task is complete")
    record_finalize.add_argument("--user-ok", dest="delete_approved", action="store_true", help=argparse.SUPPRESS)
    record_finalize.add_argument("--preserve-temporary", action="store_true", help="finalize the recording while retaining an authenticated temporary profile for a later shared claim")
    record_finalize.add_argument("--cleanup-only", action="store_true", help="terminal cleanup only; permits descriptor-bound expired authority without browser actions")
    record_finalize.set_defaults(action="record-finalize")
    recording_status = sub.add_parser("recording-status", help="inspect recording descriptors and separate inspection success from overall completion")
    recording_status.add_argument("--descriptor", help="inspect one descriptor; otherwise inspect all canonical recording descriptors")
    recording_status.add_argument("--mark-stale", action="store_true", help="mark only positively stale active/continued descriptors; never deletes or stops processes")
    recording_status.set_defaults(action="recording-status")
    legacy_lock_audit = sub.add_parser("audit-legacy-locks", help="read-only classify legacy Browser Use locks; never deletes, moves, or kills")
    legacy_lock_audit.add_argument("--root", default=_LEGACY_STATE_ROOT, help=argparse.SUPPRESS)
    legacy_lock_audit.add_argument("--exclude-quarantine", action="store_true", help="omit already-quarantined lock files from the observation")
    legacy_lock_audit.set_defaults(action="audit-legacy-locks")
    flow_finalize = sub.add_parser("flow-finalize-lease", help="finalize one run-owned Browser Use flow lease")
    flow_finalize.add_argument("--lease", required=True)
    flow_finalize.add_argument("--delete-approved", action="store_true", help="user approved deletion after the AI asked whether the task is complete")
    flow_finalize.add_argument("--user-ok", dest="delete_approved", action="store_true", help=argparse.SUPPRESS)
    flow_finalize.add_argument("--preserve-temporary", action="store_true", help="finalize the recording while retaining an authenticated temporary profile for a later shared claim")
    flow_finalize.set_defaults(action="flow-finalize-lease")
    for mode in ("public", "authorized"):
        command = sub.add_parser(mode, help=f"run Browser Use in {mode} mode")
        command.add_argument("--run-id", required=True)
        command.add_argument("--session", required=True)
        command.add_argument("--automation-id", default="manual")
        command.add_argument("--lifecycle", choices=("scheduled", "single-use", TEMPORARY_LIFECYCLE), required=True)
        command.add_argument("--task-id", help="required for the temporary authorized lifecycle")
        command.add_argument("--port", type=int)
        command.add_argument("--allowed-origin", action="append", default=[])
        command.add_argument("--authority", help="0600 authority JSON required for authorized mode")
        command.add_argument("--shared-lease", help="borrow one claimed authenticated temporary profile lease; authorized temporary only")
        command.add_argument("--post-command-json", default="", help="bounded read-only post commands as JSON arrays")
        command.add_argument("--artifact-dir", default="", help="canonical 0700 directory for bounded screenshot/readback artifacts")
        command.add_argument("command", nargs=argparse.REMAINDER, help="Browser Use command after --, for example: -- open https://example.com")
        command.set_defaults(action="execute", mode=mode)
    rooms = sub.add_parser("rooms", aliases=["room-list"], help="list helper-owned Browser Use rooms")
    rooms.add_argument("--json", dest="json_output", action="store_true", help="emit the sanitized registry as JSON")
    rooms.add_argument("--reconcile-stale", action="store_true", help="mark only descriptor-backed rooms with no process, listener, or daemon as stale")
    rooms.add_argument("--sync-admission-source-sha256", help=argparse.SUPPRESS)
    rooms.add_argument("--sync-admission-installed-sha256", help=argparse.SUPPRESS)
    rooms.set_defaults(action="rooms")
    helper_handoff = sub.add_parser("helper-generation-handoff", help="prepare or commit one owner-bound live-room helper generation handoff")
    helper_handoff.add_argument("--phase", choices=("prepare", "commit"), required=True)
    helper_handoff.add_argument("--source-helper-sha256")
    helper_handoff.add_argument("--installed-helper-sha256")
    helper_handoff.add_argument("--handoff", help="prepared handoff token for the commit phase")
    helper_handoff.set_defaults(action="helper-generation-handoff")
    helper_sync = sub.add_parser("helper-generation-sync-all", help="automatically align all live sessions and project the latest helper generation for historical sessions")
    helper_sync.set_defaults(action="helper-generation-sync-all")
    room_update = sub.add_parser("room-update", help="update one room state with owner-bound activity")
    room_update.add_argument("--room-id", required=True)
    room_update.add_argument("--run-id", required=True)
    room_update.add_argument("--state", choices=tuple(sorted(ROOM_REGISTRY_STATES)), default="active")
    room_update.add_argument("--activity", default="update")
    room_update.set_defaults(action="room-update")
    room_release = sub.add_parser("room-release", help="release one owner-bound room")
    room_release.add_argument("--room-id", required=True)
    room_release.add_argument("--run-id", required=True)
    room_release.add_argument("--activity", default="release")
    room_release.set_defaults(action="room-release")
    room_stale_release = sub.add_parser("room-reconcile-stale-release", help="release one owner-matching dead room after exact process/listener/daemon/lock readback")
    room_stale_release.add_argument("--room-id", required=True)
    room_stale_release.add_argument("--run-id", required=True)
    room_stale_release.add_argument("--activity", default="stale-room-release")
    room_stale_release.set_defaults(action="room-reconcile-stale-release")
    room_admin_release = sub.add_parser("room-admin-release", help="release one dead room after explicit owner-approved cleanup")
    room_admin_release.add_argument("--room-id", required=True)
    room_admin_release.add_argument("--owner-id", required=True)
    room_admin_release.add_argument("--delete-approved", action="store_true")
    room_admin_release.add_argument("--delete-profile", action="store_true")
    room_admin_release.add_argument("--activity", default="admin-release")
    room_admin_release.set_defaults(action="room-admin-release")
    validate = sub.add_parser("validate", help="no-launch executable, root, version, hash and port-range validation")
    validate.set_defaults(action="validate")
    runtime_readback_parser = sub.add_parser("runtime-readback", help="read expected/current executable identity without launching Browser Use")
    runtime_readback_parser.set_defaults(action="runtime-readback")
    clean = sub.add_parser("janitor", help="remove only expired exact quarantine directories after rechecks")
    clean.set_defaults(action="janitor")
    reconcile = sub.add_parser("reconcile-failed-startup", help="reconcile one descriptorless single-use launch after exact absence readback")
    reconcile.add_argument("--run-id", required=True)
    reconcile.add_argument("--profile-lock", required=True)
    reconcile.add_argument("--profile", required=True)
    reconcile.add_argument("--port", type=int, required=True)
    reconcile.set_defaults(action="reconcile-failed-startup")
    reconcile_single_use_execute = sub.add_parser("reconcile-failed-single-use-execute", help="close and reconcile one owner-bound descriptorless public one-shot launch")
    reconcile_single_use_execute.add_argument("--run-id", required=True)
    reconcile_single_use_execute.add_argument("--session", required=True)
    reconcile_single_use_execute.add_argument("--room-id", required=True)
    reconcile_single_use_execute.add_argument("--profile", required=True)
    reconcile_single_use_execute.add_argument("--port", type=int, required=True)
    reconcile_single_use_execute.set_defaults(action="reconcile-failed-single-use-execute")
    reconcile_temporary = sub.add_parser("reconcile-failed-temporary-startup", help="reconcile one descriptorless temporary startup after exact owner and absence readback")
    reconcile_temporary.add_argument("--run-id", required=True)
    reconcile_temporary.add_argument("--session", required=True)
    reconcile_temporary.add_argument("--task-id", required=True)
    reconcile_temporary.add_argument("--room-id", required=True)
    reconcile_temporary.add_argument("--profile", required=True)
    reconcile_temporary.add_argument("--port", type=int, required=True)
    reconcile_temporary.set_defaults(action="reconcile-failed-temporary-startup")
    stop_preserve = sub.add_parser("record-stop-preserve-temporary", help="stop one owned temporary recording while preserving its profile; does not finalize video")
    stop_preserve.add_argument("--run-id", required=True)
    stop_preserve.add_argument("--session", required=True)
    stop_preserve.add_argument("--task-id", required=True)
    stop_preserve.add_argument("--descriptor", required=True)
    stop_preserve.add_argument("--authority", help="optional explicit 0600 authority JSON; defaults to the descriptor current authority")
    stop_preserve.add_argument("--refresh-helper", action="store_true", help="compatibility alias; terminal stop adopts one current helper generation automatically")
    stop_preserve.add_argument("--cleanup-only", action="store_true", help="allow descriptor-bound stop cleanup after authority expiry; does not finalize video or resolve effects")
    stop_preserve.set_defaults(action="record-stop-preserve-temporary")
    shared_claim = sub.add_parser("temporary-share-claim", help="claim one idle authenticated temporary profile for this run without copying credentials")
    shared_claim.add_argument("--run-id", required=True)
    shared_claim.add_argument("--session", required=True)
    shared_claim.add_argument("--task-id", required=True)
    shared_claim.add_argument("--automation-id", default="manual")
    shared_claim.add_argument("--authority", required=True)
    shared_claim.add_argument("--origin", help="select one allowed origin when the authority covers multiple origins")
    shared_claim.add_argument("--source-run-id", help="select an exact retained profile owner run when account/origin candidates are not unique")
    shared_claim.add_argument("--source-task-id", help="select an exact retained profile owner task together with --source-run-id")
    shared_claim.set_defaults(action="temporary-share-claim")
    shared_release = sub.add_parser("temporary-share-release", help="release one shared profile lease while retaining the authenticated profile")
    shared_release.add_argument("--run-id", required=True)
    shared_release.add_argument("--session", required=True)
    shared_release.add_argument("--task-id", required=True)
    shared_release.add_argument("--authority", help="optional explicit 0600 authority JSON; defaults to the claimed lease authority")
    shared_release.add_argument("--lease", required=True)
    shared_release.set_defaults(action="temporary-share-release")
    shared_publish = sub.add_parser("temporary-share-publish", help="publish one cleanup-complete retained authenticated profile without opening a browser")
    shared_publish.add_argument("--run-id", required=True)
    shared_publish.add_argument("--session", required=True)
    shared_publish.add_argument("--task-id", required=True)
    shared_publish.add_argument("--descriptor", required=True)
    shared_publish.set_defaults(action="temporary-share-publish")
    shared_list = sub.add_parser("temporary-share-list", help="read the display-only shared authenticated-profile inventory without claiming or attaching")
    shared_list.set_defaults(action="temporary-share-list")
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        if args.action == "authority-issue":
            return issue_authority(args)
        if args.action == "authority-renew":
            return renew_authority(args)
        config = read_toml()
        if args.action == "runtime-readback":
            return runtime_readback(config)
        if args.action == "validate":
            versions = validate_installation(config)
            print(json.dumps({"status": "completed", "launch": False, "versions_hashes": versions, "finalized": True}, sort_keys=True))
            return 0
        if args.action == "janitor":
            return janitor(config)
        if args.action == "rooms":
            return room_registry_command(config, args)
        if args.action == "helper-generation-handoff":
            return helper_generation_handoff_command(config, args)
        if args.action == "helper-generation-sync-all":
            print(json.dumps(helper_generation_sync_all(config), sort_keys=True))
            return 0
        if args.action == "room-update":
            print(json.dumps(room_registry_update(config, args.room_id, run_id=args.run_id, state=args.state, activity=args.activity), sort_keys=True))
            return 0
        if args.action == "room-release":
            print(json.dumps(room_registry_release(config, args.room_id, run_id=args.run_id, activity=args.activity), sort_keys=True))
            return 0
        if args.action == "room-reconcile-stale-release":
            print(json.dumps(room_registry_release_stale(config, args.room_id, run_id=args.run_id, activity=args.activity), sort_keys=True))
            return 0
        if args.action == "room-admin-release":
            print(json.dumps(room_registry_admin_release(config, args.room_id, owner_id=args.owner_id, delete_approved=args.delete_approved, delete_profile=args.delete_profile, activity=args.activity), sort_keys=True))
            return 0
        if args.action == "reconcile-failed-startup":
            return reconcile_failed_startup(args)
        if args.action == "reconcile-failed-single-use-execute":
            return reconcile_failed_single_use_execute(args, config)
        if args.action == "reconcile-failed-temporary-startup":
            return reconcile_temporary_startup(args, config)
        if args.action == "record-stop-preserve-temporary":
            return record_stop_preserve_temporary(args)
        if args.action == "temporary-share-claim":
            return claim_shared_temporary_profile(args)
        if args.action == "temporary-share-release":
            return release_shared_temporary_profile(args)
        if args.action == "temporary-share-publish":
            return publish_retained_temporary_profile(args)
        if args.action == "temporary-share-list":
            return temporary_share_list(config)
        if args.action == "resume":
            return task_resume(args)
        if args.action == "login-handoff":
            return login_handoff(args)
        if args.action == "continue":
            return continue_handoff(args)
        if args.action == "handoff-watchdog":
            return handoff_watchdog(args)
        if args.action == "finalize":
            return finalize_handoff(args)
        if args.action == "record-start":
            return record_start(args)
        if args.action == "record-command":
            return record_command(args)
        if args.action == "record-batch":
            return record_batch(args)
        if args.action == "record-auth-wait":
            return record_auth_wait(args)
        if args.action == "record-resume":
            return record_resume(args)
        if args.action == "record-recover":
            return record_recover(args)
        if args.action == "record-cleanup-daemon":
            return record_cleanup_daemon(args)
        if args.action == "record-reconcile-target-not-interactive":
            return record_reconcile_target_not_interactive(args)
        if args.action == "record-reconcile-operation-history":
            return record_reconcile_operation_history(args)
        if args.action == "record-reconcile-read-only-orphan":
            return record_reconcile_read_only_orphan(args)
        if args.action == "record-reconcile-navigation":
            return record_reconcile_navigation(args)
        if args.action == "record-reconcile-eval-syntax-error":
            return record_reconcile_eval_syntax_error(args)
        if args.action == "record-reconcile-target-not-interactive-live":
            return record_reconcile_target_not_interactive_live(args)
        if args.action == "record-reconcile-target-not-interactive-history":
            return record_reconcile_target_not_interactive_history(args)
        if args.action == "record-reconcile-click-no-dispatch":
            return record_reconcile_click_no_dispatch(args)
        if args.action == "record-reconcile-no-dispatch":
            return record_reconcile_no_dispatch(args)
        if args.action == "record-reconcile-click-readback":
            return record_reconcile_click_readback(args)
        if args.action == "record-reconcile-click-readback-live":
            return record_reconcile_click_readback_live(args)
        if args.action == "record-target-inspect":
            return record_target_inspect(args)
        if args.action == "record-target-click":
            return record_target_click(args)
        if args.action == "record-finalize":
            return record_finalize(args)
        if args.action == "recording-status":
            return recording_status(args)
        if args.action == "audit-legacy-locks":
            print(json.dumps(audit_legacy_locks(args.root, include_quarantine=not args.exclude_quarantine), sort_keys=True))
            return 0
        if args.action == "flow-finalize-lease":
            return flow_finalize_lease(args)
        return execute(args)
    except Blocker as exc:
        print(json.dumps({"status": "blocked", "exact_blocker": exc.code, "detail": public_blocker_detail(exc.detail), "finalized": False}, sort_keys=True))
        return 1
    except (OSError, ValueError, tomllib.TOMLDecodeError) as exc:
        print(json.dumps({"status": "blocked", "exact_blocker": "browser_use_runtime_error", "detail": type(exc).__name__, "finalized": False}, sort_keys=True))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
