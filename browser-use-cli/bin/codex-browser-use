    record_reconcile.add_argument("--target-text-sha256", required=True)
    record_reconcile.add_argument("--evidence-code", choices=("runtime_error_browser_use_target_not_interactive",), required=True)
    record_reconcile.set_defaults(action="record-reconcile-target-not-interactive")
    record_reconcile_navigation = sub.add_parser("record-reconcile-navigation", help="reconcile one recovered read-only open after fresh same-run URL/state readback")
    record_reconcile_navigation.add_argument("--run-id", required=True)
    record_reconcile_navigation.add_argument("--session", required=True)
    record_reconcile_navigation.add_argument("--descriptor", required=True)
    record_reconcile_navigation.add_argument("--authority")
