# The job-detail expression is generated by the source adapter and is kept as
# a digest here so this helper can enforce exact equality without duplicating a
# long JavaScript expression in two languages.  The digest is of the complete
# bounded expression, not a prefix or a substring.
READ_ONLY_EVAL_SHA256 = frozenset({
    "44dc9d0dadd1b02f55866be2b8db42b64c00fada0cd4bd893a0b93bea527d143",
})


def is_read_only_command(command: list[str]) -> bool:
    return bool(command) and (
        command[0] in READ_ONLY_OPERATION_COMMANDS
        or (command[0] == "eval" and len(command) == 2 and (
            command[1] in READ_ONLY_EVAL_EXPRESSIONS
            or hashlib.sha256(command[1].encode("utf-8")).hexdigest() in READ_ONLY_EVAL_SHA256
        ))
    )


