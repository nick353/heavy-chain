{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Each protected request is checked by the dedicated Heavy Auth service.
  "name": "heavy-chain-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "ai": { "binding": "AI" },
  "images": { "binding": "IMAGES" },
  "services": [{ "binding": "AUTH_SERVICE", "service": "consumer-auth" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heavy-chain-production-db",
      "database_id": "f2a6ef3b-14d0-4527-94eb-59ed22a469d9",
      "migrations_dir": "migrations"
    }
  ],
  // Admitted image jobs run here so a generation finishes even after the user leaves the page.
  "queues": {
    "producers": [{ "binding": "IMAGE_JOB_QUEUE", "queue": "heavy-image-jobs" }],
    "consumers": [{ "queue": "heavy-image-jobs", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 2 }]
  },
  "r2_buckets": [
    {
      "binding": "PRIVATE_MEDIA",
      "bucket_name": "heavy-chain-private-media"
    }
  ],
  "vars": {
    "AUTH_ISSUER": "https://consumer-auth.nichika2000823.workers.dev",
    "FRONTEND_ORIGINS": "https://heavy-chain-web.nichika2000823.workers.dev,https://heavychain.app,https://heavy-chain.zeabur.app",
    "AI_IMAGE_PROVIDER": "openai",
    "AI_IMAGE_ENABLED": "true",
    "HEAVY_IMAGE_ENTITLEMENT_ENABLED": "true",
    "HEAVY_TERMS_VERSION": "heavy-terms-v1",
    "HEAVY_RIGHTS_ATTESTATION_VERSION": "heavy-rights-v1",
    "HEAVY_TERMS_DOCUMENT_VERSION": "heavy-terms-document-v1",
    "HEAVY_TERMS_DOCUMENT_DIGEST": "25d74ddf231dcdf959f20c533bde9d07fd80afc8722dfe4f0804030cfca05998",
    "HEAVY_RIGHTS_DOCUMENT_VERSION": "heavy-rights-document-v1",
    "HEAVY_RIGHTS_DOCUMENT_DIGEST": "76a48a0a6806c543ba2edd5672f6c4e4936c15478f5c72d179a2cd9c46e498eb",
    "AI_IMAGE_ALLOWED_ACTIONS": "generate-image,edit-image,model-matrix,optimize-prompt,chat-plan,image-plan",
    "AI_IMAGE_TIMEOUT_MS": "180000",
    "AI_MONTHLY_IMAGE_UNITS": "30000",
    "AI_ACCOUNT_MONTHLY_IMAGE_UNITS": "30000",
    "AI_DAILY_IMAGE_UNITS": "10000",
    "AI_DAILY_ESTIMATED_NEURONS": "3000000",
    "AI_CONCURRENT_IMAGE_JOBS": "8",
    "AI_USER_CONCURRENT_IMAGE_JOBS": "3",
    "PUBLIC_SHARE_ENABLED": "true",
    "PUBLIC_APP_ORIGIN": "https://heavychain.app"
  }
}
