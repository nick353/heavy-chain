    record_reconcile_eval = sub.add_parser("record-reconcile-eval-syntax-error", help="reconcile one parser-level eval syntax error without replaying eval")
    record_reconcile_eval.add_argument("--run-id", required=True)
    record_reconcile_eval.add_argument("--session", required=True)
    record_reconcile_eval.add_argument("--descriptor", required=True)
    record_reconcile_eval.add_argument("--authority")
