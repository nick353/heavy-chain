    record_recover = sub.add_parser("record-recover", help="perform bounded read-only reconciliation on the same recording run")
    record_recover.add_argument("--run-id", required=True)
    record_recover.add_argument("--session", required=True)
    record_recover.add_argument("--descriptor", required=True)
    record_recover.add_argument("--authority")
    record_recover.add_argument("--authority-renewal", "--authority-renewal-path", dest="authority_renewal", help="immutable 0600 renewal JSON for the next authority generation")
