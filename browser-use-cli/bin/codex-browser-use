    record_reconcile_eval.add_argument("--state-marker", required=True)
    record_reconcile_eval.add_argument("--evidence-code", choices=("browser_use_cli_syntax_error_before_page_dispatch",), required=True)
    record_reconcile_eval.set_defaults(action="record-reconcile-eval-syntax-error")
    record_reconcile_target_live = sub.add_parser("record-reconcile-target-not-interactive-live", help="reconcile a live helper-rejected target after fresh noninteractive readback")
    record_reconcile_target_live.add_argument("--run-id", required=True)
    record_reconcile_target_live.add_argument("--session", required=True)
    record_reconcile_target_live.add_argument("--descriptor", required=True)
    record_reconcile_target_live.add_argument("--authority")
