    record_command.add_argument("command", nargs=argparse.REMAINDER, help="Browser Use command after --")
    record_command.set_defaults(action="record-command")
    record_resume = sub.add_parser("record-resume", help="resume recording on an existing verified scheduled Chrome process")
    record_resume.add_argument("--run-id", required=True)
    record_resume.add_argument("--session", required=True)
    record_resume.add_argument("--descriptor", required=True)
    record_resume.add_argument("--authority")
    record_resume.add_argument("--authority-renewal", "--authority-renewal-path", dest="authority_renewal", help="immutable 0600 renewal JSON for the next authority generation")
