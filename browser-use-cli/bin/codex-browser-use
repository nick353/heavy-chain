#!/usr/bin/env python3
"""Bounded Browser Use CLI wrapper for public and explicitly authorized lanes.

The wrapper intentionally keeps page output, cookies, tokens, credentials, and CDP
URLs out of durable state.  It is an accidental-collision guard for same-user
profiles and ports, not a hostile-process sandbox or a redirect/CDP mediator.
"""

from __future__ import annotations

import argparse
import ast
import datetime as dt
import errno
import hashlib
import importlib.metadata
import ipaddress
import json
import logging
import math
import mimetypes
import os
import pathlib
import plistlib
import re
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import time
import tomllib
import urllib.parse
import uuid
from typing import Any

try:
    import psutil
except ImportError:  # pragma: no cover - the installed runtime is expected to provide it
    psutil = None


_EXPLICIT_STATE_ROOT = os.environ.get("BROWSER_USE_STATE_ROOT")
_PORTABLE_STATE_ROOT = os.path.expanduser("~/.browser-use-cli")
_LEGACY_STATE_ROOT = os.path.expanduser("~/.codex/browser-use")
_EXPLICIT_CONFIG_PATH = os.environ.get("BROWSER_USE_RUNTIME_CONFIG")
_PRIMARY_CONFIG_PATH = os.path.join(_PORTABLE_STATE_ROOT, "browser-use-runtime.toml")
# Keep the portable state root as the first choice, while allowing an existing
# pre-portable Codex installation to continue using its user-relative config.
# The legacy fallback contains no machine-specific absolute path and is only
# selected when the portable config does not exist yet.
_LEGACY_CONFIG_PATH = os.path.join(_LEGACY_STATE_ROOT, "browser-use-runtime.toml")
if _EXPLICIT_STATE_ROOT:
    DEFAULT_STATE_ROOT = os.path.realpath(_EXPLICIT_STATE_ROOT)
elif _EXPLICIT_CONFIG_PATH and os.path.realpath(os.path.dirname(_EXPLICIT_CONFIG_PATH)) == os.path.realpath(_LEGACY_STATE_ROOT):
    DEFAULT_STATE_ROOT = os.path.realpath(_LEGACY_STATE_ROOT)
elif os.path.isfile(_LEGACY_CONFIG_PATH) and not os.path.exists(_PRIMARY_CONFIG_PATH):
    DEFAULT_STATE_ROOT = os.path.realpath(_LEGACY_STATE_ROOT)
else:
    DEFAULT_STATE_ROOT = os.path.realpath(_PORTABLE_STATE_ROOT)
CONFIG_PATH = os.path.realpath(
    _EXPLICIT_CONFIG_PATH
    or (_LEGACY_CONFIG_PATH if os.path.isfile(_LEGACY_CONFIG_PATH) and not os.path.exists(_PRIMARY_CONFIG_PATH) else _PRIMARY_CONFIG_PATH)
)
EUID = os.geteuid()
TRUSTED_EXECUTABLE_OWNER_UIDS = {0, EUID}
ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
# macOS sockaddr_un.sun_path is shorter than a normal CLI identifier. Keep a
# margin below the platform limit because the daemon socket is
# <BROWSER_USE_HOME>/<session>.sock. Long caller IDs are canonicalized before
# Browser Use sees them; the effective ID remains short and deterministic.
MAX_UNIX_SOCKET_PATH_BYTES = 96
MAX_DAEMON_SESSION_ID_LENGTH = 40
SAFE_COMMAND_FLAGS = {"--headed", "--json", "--connect"}
BLOCKED_GLOBAL_FLAGS = {"--profile", "--cdp-url", "--session", "--mcp", "--template"}
HANDOFF_SCHEMA = "browser-use-login-handoff.v1"
TEMPORARY_LIFECYCLE = "temporary"
TEMPORARY_PROFILE_ROOT = os.path.realpath(os.environ.get("BROWSER_USE_TEMPORARY_PROFILE_ROOT") or os.path.join(DEFAULT_STATE_ROOT, "profiles", "temporary"))
TEMPORARY_PORT_RANGE = (20080, 20099)
TEMPORARY_PROFILE_MARKER_SCHEMA = "browser-use-profile.v2"
TEMPORARY_TTL_SECONDS = 86400
TEMPORARY_COMPLETION_POLICY = "ai_assessment_then_delete_approval"
TEMPORARY_CLEANUP_STATUSES = {"claimed", "cleanup_pending", "stale"}
HANDOFF_STATUSES = {"active", "continued", "claimed", "cleanup_pending"}
HANDOFF_CLAIM_SUFFIX = ".abandoned"
HANDOFF_CONSUMED_SUFFIX = ".consumed"
HANDOFF_COMPLETE_SUFFIX = ".cleanup-complete.json"
RECORDING_SCHEMA = "browser-use-recording.v1"
RECORDING_STATUS_SCHEMA = "browser-use-recording-status.v1"
OPERATION_LEDGER_SCHEMA = "browser-use-operation-ledger.v1"
AUTHORITY_RENEWAL_SCHEMA = "browser-use-authority-renewal.v1"
AUTHORITY_LEDGER_SCHEMA = "browser-use-authority-ledger.v1"
AUTHORITY_HISTORY_SCHEMA = "browser-use-authority-descriptor-history.v1"
AUTHORITY_CLOCK_SKEW_SECONDS = 5
AUTHORITY_READBACK_BUDGET_SECONDS = 15
AUTHORITY_CHECKPOINT_BUDGET_SECONDS = 5
AUTHORITY_COMMAND_BUDGETS = {
    "record-start": 30,
    "record-command": 30,
    "record-resume": 30,
    "record-recover": 20,
    "record-reconcile": 20,
    "record-finalize": 30,
    "target-inspect": 15,
    "target-click": 30,
}
AUTHORITY_RENEWAL_ALLOWED_KEYS = {
    "schema", "browser_surface", "run_id", "session", "expires_at",
    "allowed_origins", "account_identity", "data_exposure", "side_effect_scope",
    "approval", "readback_required", "previous_authority_sha256",
    "authority_generation", "issuer_id",
}
OPERATION_EFFECT_STATES = {"none", "executed", "unknown"}
READ_ONLY_OPERATION_COMMANDS = {"state", "get", "screenshot", "extract", "wait", "scroll", "back", "close-tab"}
MAX_CAPTURED_READBACK_CHARS = 32_000
RECORDING_STATUSES = {"active", "continued", "cleanup_pending", "finalized", "stale"}
MAX_RECORDING_RECOVERY_ATTEMPTS = 2
PINNED_BROWSER_USE_VERSION = "0.13.7"
_LAST_RECORDING_CLI_FAILURE = ""
_LAST_CLI_FAILURE = ""


class Blocker(RuntimeError):
    def __init__(self, code: str, detail: str = "") -> None:
        self.code = code
        self.detail = detail
        super().__init__(f"{code}: {detail}" if detail else code)


def now_utc() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc)


def iso(value: dt.datetime) -> str:
    return value.astimezone(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def validate_id(value: str, field: str) -> str:
    if not isinstance(value, str) or not ID_RE.fullmatch(value):
        raise Blocker("browser_use_invalid_identifier", field)
    return value


def session_socket_path(home: str, session: str) -> str:
    return os.path.join(home, f"{session}.sock")


def session_socket_path_bytes(home: str, session: str) -> int:
    return len(os.fsencode(session_socket_path(home, session)))


def canonical_session_id(value: str, home: str) -> str:
    """Return a stable daemon-safe ID while preserving caller provenance."""
    raw = validate_id(value, "session")
    # The configured Browser Use home is canonical and bounded by the runtime
    # config. Preserve all normal IDs; only caller IDs that can make the daemon
    # socket path unsafe need rewriting.
    if len(raw) <= MAX_DAEMON_SESSION_ID_LENGTH:
        return raw

    digest = hashlib.sha256(raw.encode("utf-8")).hexdigest()[:10]
    prefix = raw[:24].rstrip("-_.") or "bu"
    candidate = f"{prefix}-{digest}"
    while session_socket_path_bytes(home, candidate) > MAX_UNIX_SOCKET_PATH_BYTES and len(prefix) > 3:
        prefix = prefix[:-1].rstrip("-_.") or "bu"
        candidate = f"{prefix}-{digest}"
    if session_socket_path_bytes(home, candidate) > MAX_UNIX_SOCKET_PATH_BYTES:
        candidate = f"bu-{digest}"
    if len(candidate) > MAX_DAEMON_SESSION_ID_LENGTH:
        candidate = f"bu-{digest}"
    return candidate


def safe_id(value: str, field: str) -> str:
    value = validate_id(value, field)
    if field == "session" and len(value) > MAX_DAEMON_SESSION_ID_LENGTH:
        raise Blocker("browser_use_session_identifier_too_long", str(len(value)))
    return value


def session_aliases(config: dict[str, Any], requested: str, effective: str) -> list[str]:
    if requested == effective:
        return []
    if canonical_session_id(requested, config["roots"]["browser_use_home"]) != effective:
        raise Blocker("browser_use_session_binding_invalid")
    return [requested]


def lstat(path: str) -> os.stat_result:
    try:
        return os.lstat(path)
    except FileNotFoundError as exc:
        raise Blocker("browser_use_path_missing", path) from exc


def assert_regular_file(path: str, *, mode: int | None = None) -> os.stat_result:
    if not os.path.isabs(path) or os.path.realpath(path) != path:
        raise Blocker("browser_use_noncanonical_or_symlink_path", path)
    st = lstat(path)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        raise Blocker("browser_use_unsafe_file_type", path)
    if st.st_uid != EUID:
        raise Blocker("browser_use_file_owner_mismatch", path)
    if mode is not None and (st.st_mode & 0o777) != mode:
        raise Blocker("browser_use_file_mode_mismatch", path)
    return st


def assert_directory(path: str, *, create: bool = False) -> None:
    if not os.path.isabs(path):
        raise Blocker("browser_use_nonabsolute_root", path)
    if not os.path.exists(path):
        if not create:
            raise Blocker("browser_use_root_missing", path)
        os.makedirs(path, mode=0o700, exist_ok=True)
    st = lstat(path)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        raise Blocker("browser_use_unsafe_root", path)
    if st.st_uid != EUID:
        raise Blocker("browser_use_root_owner_mismatch", path)
    os.chmod(path, 0o700)


def sha256_file(path: str) -> str:
    assert_regular_file(path)
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def sha256_trusted_executable(path: str) -> str:
    """Hash an installed executable after its bounded trust checks."""
    if not os.path.isabs(path) or os.path.realpath(path) != path:
        raise Blocker("browser_use_noncanonical_or_symlink_path", path)
    st = lstat(path)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        raise Blocker("browser_use_unsafe_file_type", path)
    if st.st_uid not in TRUSTED_EXECUTABLE_OWNER_UIDS:
        raise Blocker("browser_use_executable_owner_mismatch", path)
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def helper_snapshot_path(recording_dir: str) -> str:
    """Return the run-owned immutable helper path for a recording."""
    recording_root = os.path.realpath(recording_dir)
    if not os.path.isabs(recording_root) or os.path.realpath(recording_root) != recording_root:
        raise Blocker("browser_use_recording_dir_noncanonical")
    generation_dir = os.path.join(recording_root, ".helper-generation")
    return os.path.join(generation_dir, "codex-browser-use")


def create_helper_snapshot(recording_dir: str) -> tuple[str, str]:
    """Persist the exact helper generation that admitted a new recording.

    The snapshot is private to the run and is never replaced in-place. A
    later helper invocation may exec this snapshot when the installed helper
    changed, preserving one code generation for the whole recording.
    """
    source = os.path.realpath(sys.argv[0])
    source_digest = sha256_file(source)
    snapshot = helper_snapshot_path(recording_dir)
    generation_dir = os.path.dirname(snapshot)
    assert_directory(generation_dir, create=True)
    if os.path.lexists(snapshot):
        assert_regular_file(snapshot, mode=0o700)
        if sha256_file(snapshot) != source_digest:
            raise Blocker("browser_use_recording_helper_snapshot_conflict")
        return snapshot, source_digest
    temporary = os.path.join(generation_dir, f".codex-browser-use.{uuid.uuid4().hex}.tmp")
    fd = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o700)
    try:
        with open(source, "rb") as source_handle:
            while True:
                chunk = source_handle.read(1024 * 1024)
                if not chunk:
                    break
                offset = 0
                while offset < len(chunk):
                    written = os.write(fd, chunk[offset:])
                    if written <= 0:
                        raise OSError(errno.EIO, "helper snapshot write made no progress")
                    offset += written
        os.fsync(fd)
    finally:
        os.close(fd)
    try:
        os.chmod(temporary, 0o700)
        try:
            os.link(temporary, snapshot)
        except FileExistsError:
            os.unlink(temporary)
            assert_regular_file(snapshot, mode=0o700)
            if sha256_file(snapshot) != source_digest:
                raise Blocker("browser_use_recording_helper_snapshot_conflict")
            return snapshot, source_digest
        os.unlink(temporary)
        os.chmod(snapshot, 0o700)
    except Exception:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise
    assert_regular_file(snapshot, mode=0o700)
    if sha256_file(snapshot) != source_digest:
        raise Blocker("browser_use_recording_helper_snapshot_digest_mismatch")
    return snapshot, source_digest


def validate_helper_snapshot(descriptor: dict[str, Any]) -> str | None:
    """Validate a run-pinned helper without accepting the current helper."""
    snapshot = descriptor.get("helper_snapshot_path")
    if snapshot is None:
        return None
    expected = helper_snapshot_path(descriptor["recording_dir"])
    if not isinstance(snapshot, str) or os.path.realpath(snapshot) != snapshot or snapshot != expected:
        raise Blocker("browser_use_recording_helper_snapshot_path_invalid")
    assert_regular_file(snapshot, mode=0o700)
    if sha256_file(snapshot) != descriptor.get("helper_sha256"):
        raise Blocker("browser_use_recording_helper_snapshot_digest_mismatch")
    if descriptor.get("helper_snapshot_owner_uid") is not None and descriptor["helper_snapshot_owner_uid"] != EUID:
        raise Blocker("browser_use_recording_helper_snapshot_owner_mismatch")
    if descriptor.get("helper_snapshot_mode") is not None and descriptor["helper_snapshot_mode"] != 0o700:
        raise Blocker("browser_use_recording_helper_snapshot_mode_mismatch")
    dependency_digest = descriptor.get("helper_dependency_digest")
    versions = descriptor.get("versions_hashes")
    if dependency_digest is not None:
        if not isinstance(versions, dict):
            raise Blocker("browser_use_recording_helper_dependency_identity_missing")
        expected = hashlib.sha256(json.dumps(versions, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
        if dependency_digest != expected:
            raise Blocker("browser_use_recording_helper_dependency_identity_mismatch")
    process = descriptor.get("process")
    if descriptor.get("helper_process_lineage_digest") is not None:
        if not isinstance(process, dict) or not isinstance(process.get("root_pid"), int) or not isinstance(process.get("root_start_time"), (int, float)):
            raise Blocker("browser_use_recording_helper_process_identity_missing")
        lineage = {
            "run_id": descriptor.get("run_id"),
            "session": descriptor.get("session"),
            "profile": descriptor.get("profile"),
            "port": descriptor.get("port"),
            "process": process,
            "helper_sha256": descriptor.get("helper_sha256"),
        }
        expected = hashlib.sha256(json.dumps(lineage, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
        if descriptor.get("helper_process_lineage_digest") != expected:
            raise Blocker("browser_use_recording_helper_process_identity_mismatch")
    return snapshot


def read_toml() -> dict[str, Any]:
    assert_regular_file(CONFIG_PATH, mode=0o600)
    with open(CONFIG_PATH, "rb") as handle:
        config = tomllib.load(handle)
    if config.get("schema") != "browser-use-runtime.v1":
        raise Blocker("browser_use_runtime_schema_mismatch")
    return config


def executable_version(path: str, kind: str) -> str:
    if kind == "browser_use":
        try:
            return importlib.metadata.version("browser-use")
        except importlib.metadata.PackageNotFoundError as exc:
            raise Blocker("browser_use_package_version_unavailable") from exc
    if kind == "python":
        return sys.version.split()[0]
    if kind == "chrome":
        # On macOS, launching the Chrome executable with --version while an
        # existing Chrome instance owns the app singleton can block instead of
        # returning. Read the signed app bundle metadata without starting or
        # attaching to a browser process.
        bundle_info = pathlib.Path(path).resolve().parents[1] / "Info.plist"
        try:
            with bundle_info.open("rb") as handle:
                value = plistlib.load(handle).get("CFBundleShortVersionString")
            match = re.fullmatch(r"\d+\.\d+(?:\.\d+){1,2}", str(value or ""))
            if match:
                return match.group(0)
        except (OSError, plistlib.InvalidFileException, ValueError, TypeError):
            # Fall through to the bounded executable probe so the failure is
            # still classified as an installation validation blocker.
            pass
    try:
        result = subprocess.run([path, "--version"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
    except subprocess.TimeoutExpired as exc:
        raise Blocker("browser_use_executable_version_timeout", kind) from exc
    except OSError as exc:
        raise Blocker("browser_use_executable_version_unavailable", kind) from exc
    output = (result.stdout + " " + result.stderr).strip()
    match = re.search(r"(\d+\.\d+(?:\.\d+){1,2})", output)
    # ffmpeg/ffprobe print a valid version banner but return a non-zero
    # status when no media input is supplied.  The banner is sufficient for
    # the pinned executable/hash check; other executables remain strict.
    if (result.returncode != 0 and kind not in {"ffmpeg", "ffprobe"}) or not match:
        raise Blocker("browser_use_executable_version_unavailable", kind)
    return match.group(1)


def validate_executable(spec: dict[str, Any], kind: str) -> dict[str, str]:
    path = spec["path"]
    canonical = spec["canonical_path"]
    if not os.path.isabs(path) or not os.path.isabs(canonical) or os.path.realpath(path) != canonical:
        raise Blocker("browser_use_executable_canonical_path_mismatch", kind)
    st = lstat(path)
    if stat.S_ISLNK(st.st_mode):
        raise Blocker("browser_use_executable_symlink_mismatch", kind)
    if not stat.S_ISREG(os.stat(canonical).st_mode):
        raise Blocker("browser_use_executable_not_regular", kind)
    canonical_st = os.stat(canonical)
    if canonical_st.st_uid not in TRUSTED_EXECUTABLE_OWNER_UIDS:
        raise Blocker("browser_use_executable_owner_mismatch", kind)
    expected_mode = int(spec["mode"], 8)
    if (canonical_st.st_mode & 0o777) != expected_mode:
        raise Blocker("browser_use_executable_mode_mismatch", kind)
    digest = sha256_trusted_executable(canonical)
    if digest != spec["sha256"]:
        raise Blocker("browser_use_executable_hash_mismatch", kind)
    version = executable_version(canonical, kind)
    if version != spec["version"]:
        raise Blocker("browser_use_executable_version_mismatch", kind)
    return {"path": path, "canonical_path": canonical, "version": version, "sha256": digest}


def validate_installation(config: dict[str, Any]) -> dict[str, Any]:
    executables = config["executables"]
    # Keep the ordinary Browser Use lane independent from optional recording
    # tooling.  Recording commands validate ffmpeg/ffprobe explicitly below.
    required = ("browser_use", "chrome", "python")
    versions = {kind: validate_executable(executables[kind], kind) for kind in required}
    roots = config["roots"]
    validate_runtime_lifecycle_config(config)
    for path in roots.values():
        assert_directory(path, create=True)
    ports = config["ports"]
    if ports["scheduled_end"] - ports["scheduled_start"] + 1 != config["ports"]["max_parallel"]:
        raise Blocker("browser_use_scheduled_port_range_parallel_mismatch")
    if ports["single_use_end"] - ports["single_use_start"] + 1 != config["ports"]["max_parallel"]:
        raise Blocker("browser_use_single_use_port_range_parallel_mismatch")
    if psutil is None:
        raise Blocker("browser_use_psutil_unavailable")
    return versions


def validate_runtime_lifecycle_config(config: dict[str, Any]) -> None:
    """Validate lifecycle roots, non-overlapping ranges, and fixed temporary TTL."""
    roots = config.get("roots") or {}
    temporary_root = roots.get("temporary_profiles")
    if temporary_root != TEMPORARY_PROFILE_ROOT or os.path.realpath(temporary_root) != TEMPORARY_PROFILE_ROOT:
        raise Blocker("browser_use_temporary_profile_root_invalid")
    ports = config.get("ports") or {}
    ranges = {
        "scheduled": (ports.get("scheduled_start"), ports.get("scheduled_end")),
        "single-use": (ports.get("single_use_start"), ports.get("single_use_end")),
        TEMPORARY_LIFECYCLE: (ports.get("temporary_start"), ports.get("temporary_end")),
    }
    normalized: dict[str, tuple[int, int]] = {}
    for lifecycle, pair in ranges.items():
        start, end = pair
        if not isinstance(start, int) or not isinstance(end, int) or start <= 0 or end < start:
            raise Blocker("browser_use_port_range_invalid", lifecycle)
        if lifecycle == TEMPORARY_LIFECYCLE and (start, end) != TEMPORARY_PORT_RANGE:
            raise Blocker("browser_use_temporary_port_range_invalid")
        if end - start + 1 != int(ports.get("max_parallel", 0)):
            raise Blocker("browser_use_port_range_parallel_mismatch", lifecycle)
        normalized[lifecycle] = (start, end)
    names = list(normalized)
    for index, left in enumerate(names):
        for right in names[index + 1:]:
            left_start, left_end = normalized[left]
            right_start, right_end = normalized[right]
            if max(left_start, right_start) <= min(left_end, right_end):
                raise Blocker("browser_use_port_ranges_overlap", f"{left}:{right}")
    ttl = ((config.get("limits") or {}).get("temporary_ttl_seconds"))
    if ttl != TEMPORARY_TTL_SECONDS:
        raise Blocker("browser_use_temporary_ttl_invalid")


def configure_logging(log_root: str) -> None:
    path = os.path.join(log_root, "critical.log")
    if not os.path.exists(path):
        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.close(fd)
    assert_regular_file(path, mode=0o600)
    logging.basicConfig(filename=path, level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")


def validate_recording_runtime(config: dict[str, Any]) -> dict[str, Any]:
    recording = config.get("recording")
    if not isinstance(recording, dict):
        raise Blocker("browser_use_recording_runtime_missing")
    runtime_dir = recording.get("runtime_dir")
    dependencies_dir = recording.get("dependencies_dir")
    site_packages_dir = recording.get("site_packages_dir")
    if not isinstance(runtime_dir, str) or not isinstance(dependencies_dir, str) or not isinstance(site_packages_dir, str):
        raise Blocker("browser_use_recording_runtime_invalid")
    assert_directory(runtime_dir)
    assert_directory(dependencies_dir)
    assert_directory(site_packages_dir)
    assert_regular_file(os.path.join(runtime_dir, "sitecustomize.py"), mode=0o600)
    try:
        framerate = int(recording.get("default_framerate", 12))
        max_commands = int(recording.get("max_commands", 128))
    except (TypeError, ValueError) as exc:
        raise Blocker("browser_use_recording_runtime_invalid") from exc
    if not 1 <= framerate <= 60 or not 1 <= max_commands <= 512:
        raise Blocker("browser_use_recording_runtime_invalid")
    return {"runtime_dir": runtime_dir, "dependencies_dir": dependencies_dir, "site_packages_dir": site_packages_dir, "default_framerate": framerate, "max_commands": max_commands}


def validate_recording_tools(config: dict[str, Any]) -> dict[str, str]:
    executables = config.get("executables") or {}
    tools: dict[str, str] = {}
    for kind in ("ffprobe", "ffmpeg"):
        spec = executables.get(kind)
        if not isinstance(spec, dict):
            raise Blocker("browser_use_recording_tool_missing", kind)
        tools[kind] = validate_executable(spec, kind)["canonical_path"]
    return tools


def validate_recording_output_dir(path: str) -> str:
    if not isinstance(path, str) or not os.path.isabs(path) or os.path.realpath(path) != path:
        raise Blocker("browser_use_recording_dir_noncanonical")
    parent = os.path.dirname(path)
    assert_directory(parent)
    if os.path.lexists(path):
        assert_directory(path)
        if any(pathlib.Path(path).iterdir()):
            raise Blocker("browser_use_recording_dir_not_empty")
    else:
        os.mkdir(path, 0o700)
    assert_directory(path)
    return path


def recording_status_path(recording_dir: str) -> str:
    return os.path.join(recording_dir, ".recording-status.json")


def recording_manifest_path(recording_dir: str) -> str:
    return os.path.join(recording_dir, "browser-use-recording-manifest.json")


def write_recording_manifest(path: str, manifest: dict[str, Any]) -> None:
    try:
        json_atomic_no_replace(path, manifest)
    except Blocker as exc:
        if exc.code != "browser_use_receipt_already_exists":
            raise
        existing = read_json_safe(path)
        expected_video = (manifest.get("video") or {}).get("sha256")
        actual_video = (existing.get("video") or {}).get("sha256")
        if existing.get("schema") != RECORDING_SCHEMA or existing.get("status") not in {"completed", "blocked"} or existing.get("run_id") != manifest.get("run_id") or existing.get("session") != manifest.get("session") or actual_video != expected_video:
            raise Blocker("browser_use_recording_manifest_binding_mismatch")
        # Same run/video: atomically refresh derived evidence such as the
        # representative frame selected from the finalized stream.
        json_atomic_replace(path, manifest)


def recording_descriptor_root(config: dict[str, Any]) -> str:
    root = config["roots"]["recordings"]
    assert_directory(root, create=True)
    return root


def assert_recording_descriptor_path(config: dict[str, Any], path: str) -> None:
    root = os.path.realpath(recording_descriptor_root(config))
    if not os.path.isabs(path) or os.path.realpath(path) != path or not path.startswith(root + os.sep):
        raise Blocker("browser_use_recording_descriptor_scope_mismatch")
    if not path.endswith(".json"):
        raise Blocker("browser_use_recording_descriptor_path_invalid")


def recording_env(config: dict[str, Any], recording_dir: str, status_path: str, framerate: int) -> dict[str, Any]:
    runtime = validate_recording_runtime(config)
    value = {
        "runtime_dir": runtime["runtime_dir"],
        "dependencies_dir": runtime["dependencies_dir"],
        "site_packages_dir": runtime["site_packages_dir"],
        "recording_dir": recording_dir,
        "status_path": status_path,
        "framerate": framerate,
    }
    if browser_harness_cli_enabled():
        parent = pathlib.Path(recording_dir).parent
        if parent.name != "recordings":
            raise Blocker("browser_use_recording_dir_not_harness_scoped")
        value.update({
            "harness_workspace": str(parent.parent),
            "recording_name": pathlib.Path(recording_dir).name,
            "recording_source_dir": recording_dir,
            "tab_inventory_path": os.path.join(recording_dir, "tab-inventory.json"),
        })
    return value


TAB_INVENTORY_SCHEMA = "browser-use-recording-tabs.v1"
TAB_INVENTORY_ROLES = {"working", "baseline", "auxiliary"}
TAB_INVENTORY_MAX_AUXILIARY = 16


def read_recording_tab_inventory(path: str) -> dict[str, Any]:
    """Read only the recording tab identity metadata; never page content."""
    value = read_json_safe(path)
    required = {"schema", "working_target_id", "tabs", "baseline_target_ids", "auxiliary_target_ids"}
    if value.get("schema") != TAB_INVENTORY_SCHEMA or not required.issubset(value):
        raise Blocker("browser_use_recording_tab_inventory_invalid")
    if not isinstance(value["working_target_id"], str) or not value["working_target_id"]:
        raise Blocker("browser_use_recording_tab_inventory_working_tab_invalid")
    if not isinstance(value["tabs"], list):
        raise Blocker("browser_use_recording_tab_inventory_tabs_invalid")
    for tab in value["tabs"]:
        if not isinstance(tab, dict):
            raise Blocker("browser_use_recording_tab_inventory_tab_invalid")
        allowed = {"target_id", "role", "url_length", "url_sha256", "title_length", "title_sha256"}
        if set(tab) != allowed or tab.get("role") not in TAB_INVENTORY_ROLES:
            raise Blocker("browser_use_recording_tab_inventory_tab_metadata_invalid")
        if not isinstance(tab.get("target_id"), str) or not tab["target_id"] or len(tab["target_id"]) > 256:
            raise Blocker("browser_use_recording_tab_inventory_target_id_invalid")
        if not isinstance(tab.get("url_length"), int) or tab["url_length"] < 0:
            raise Blocker("browser_use_recording_tab_inventory_url_metadata_invalid")
        if not isinstance(tab.get("title_length"), int) or tab["title_length"] < 0:
            raise Blocker("browser_use_recording_tab_inventory_title_metadata_invalid")
        for field in ("url_sha256", "title_sha256"):
            if not isinstance(tab.get(field), str) or not re.fullmatch(r"[0-9a-f]{64}", tab[field]):
                raise Blocker("browser_use_recording_tab_inventory_hash_invalid", field)
    target_ids = {tab["target_id"] for tab in value["tabs"]}
    if value["working_target_id"] not in target_ids:
        raise Blocker("browser_use_recording_tab_inventory_working_tab_missing")
    if not isinstance(value["baseline_target_ids"], list) or not all(isinstance(item, str) for item in value["baseline_target_ids"]):
        raise Blocker("browser_use_recording_tab_inventory_baseline_invalid")
    if not isinstance(value["auxiliary_target_ids"], list) or not all(isinstance(item, str) for item in value["auxiliary_target_ids"]):
        raise Blocker("browser_use_recording_tab_inventory_auxiliary_invalid")
    if len(value["auxiliary_target_ids"]) > TAB_INVENTORY_MAX_AUXILIARY:
        raise Blocker("browser_use_recording_auxiliary_tab_limit_exceeded")
    value.setdefault("active_target_id", value["working_target_id"])
    if not isinstance(value["active_target_id"], str) or not value["active_target_id"]:
        raise Blocker("browser_use_recording_tab_inventory_active_tab_invalid")
    tab_ids = [tab["target_id"] for tab in value["tabs"]]
    if len(tab_ids) != len(set(tab_ids)):
        raise Blocker("browser_use_recording_tab_inventory_duplicate_target_id")
    baseline_ids = list(value["baseline_target_ids"])
    auxiliary_ids = list(value["auxiliary_target_ids"])
    if len(baseline_ids) != len(set(baseline_ids)) or len(auxiliary_ids) != len(set(auxiliary_ids)):
        raise Blocker("browser_use_recording_tab_inventory_duplicate_role_id")
    if set(baseline_ids) & set(auxiliary_ids) or value["working_target_id"] in set(baseline_ids) | set(auxiliary_ids):
        raise Blocker("browser_use_recording_tab_inventory_role_overlap")
    roles = {tab["target_id"]: tab["role"] for tab in value["tabs"]}
    expected_baseline = {target_id for target_id, role in roles.items() if role == "baseline"}
    expected_auxiliary = {target_id for target_id, role in roles.items() if role == "auxiliary"}
    if roles.get(value["working_target_id"]) != "working":
        raise Blocker("browser_use_recording_tab_inventory_working_role_invalid")
    if set(baseline_ids) != expected_baseline or set(auxiliary_ids) != expected_auxiliary:
        raise Blocker("browser_use_recording_tab_inventory_role_index_mismatch")
    if value["active_target_id"] not in roles or roles[value["active_target_id"]] == "baseline":
        raise Blocker("browser_use_recording_tab_inventory_active_role_invalid")
    return value


def write_harness_recording_status(
    path: str,
    recording: dict[str, Any],
    *,
    active: bool,
    finalized: bool,
    state: str | None = None,
    reason: str | None = None,
) -> None:
    """Persist the helper-owned status contract for Browser Harness recordings."""
    source = pathlib.Path(recording["recording_source_dir"])
    frames = sorted(p for p in source.glob("*.jpg") if p.stem.isdigit()) if source.is_dir() else []
    value = {
        "schema": RECORDING_STATUS_SCHEMA,
        "recorder_configured": True,
        "recorder_active": active,
        "finalized": finalized,
        "recording_dir": str(source),
        "recording_backend": "browser-harness",
        "frame_count": len(frames),
    }
    if state is not None:
        value["state"] = state
        value["durable_state"] = state
    if reason is not None:
        value["state_reason"] = str(reason)[:160]
        value["state_updated_at"] = iso(now_utc())
    if os.path.lexists(path):
        json_atomic_replace(path, value)
    else:
        json_atomic_no_replace(path, value)


def capture_recording_frame(
    config: dict[str, Any],
    home: str,
    port: int,
    session: str,
    recording: dict[str, Any],
) -> str | None:
    """Append one visual frame without changing the Browser Use target.

    Browser Harness owns the recorder, while Browser Use CLI owns the page
    actions.  Browser Use 0.13.x does not call Harness ``observe()`` after
    its actions, so the start frame was previously the only numeric frame in
    the final MP4.  Ask the same Harness session to capture the already
    verified working tab into the next numeric frame path.  This is
    read-only and keeps the existing flow lease/session/tab binding intact.
    """
    if not browser_harness_cli_enabled():
        return None
    source_dir = os.path.realpath(str(recording.get("recording_source_dir") or ""))
    if not source_dir or not os.path.isdir(source_dir):
        raise Blocker("browser_use_recording_source_dir_missing")
    frame_numbers = []
    for candidate in pathlib.Path(source_dir).glob("*.jpg"):
        if candidate.stem.isdigit():
            frame_numbers.append(int(candidate.stem))
    next_number = max(frame_numbers, default=0) + 1
    frame_path = os.path.join(source_dir, f"{next_number:04d}.jpg")
    capture_path = os.path.join(source_dir, f".capture-{next_number:04d}.png")
    if os.path.lexists(frame_path):
        raise Blocker("browser_use_recording_frame_path_collision")
    if os.path.lexists(capture_path):
        raise Blocker("browser_use_recording_capture_path_collision")
    code, readback_exit = run_cli_keep_alive(
        config,
        home,
        port,
        session,
        ["screenshot", capture_path],
        False,
        recording=recording,
    )
    if code != 0:
        raise Blocker("browser_use_recording_frame_capture_failed", _LAST_RECORDING_CLI_FAILURE or str(code))
    if readback_exit not in (None, 0):
        raise Blocker("browser_use_recording_frame_capture_readback_failed", str(readback_exit))
    try:
        stat = os.stat(capture_path)
    except OSError as exc:
        raise Blocker("browser_use_recording_frame_missing") from exc
    if not stat.st_mode or stat.st_size <= 0:
        raise Blocker("browser_use_recording_frame_empty")
    try:
        from PIL import Image

        with Image.open(capture_path) as image:
            converted = image.convert("RGB")
            converted.save(frame_path, format="JPEG", quality=90, optimize=True)
    except Exception as exc:
        raise Blocker("browser_use_recording_frame_jpeg_conversion_failed") from exc
    finally:
        try:
            os.unlink(capture_path)
        except FileNotFoundError:
            pass
        except OSError as exc:
            raise Blocker("browser_use_recording_capture_cleanup_failed") from exc
    try:
        frame_stat = os.stat(frame_path)
    except OSError as exc:
        raise Blocker("browser_use_recording_frame_missing") from exc
    if frame_stat.st_size <= 0:
        raise Blocker("browser_use_recording_frame_empty")
    write_harness_recording_status(recording["status_path"], recording, active=True, finalized=False)
    return frame_path


def read_recording_status(path: str, *, require_active: bool | None = None) -> dict[str, Any]:
    value = read_json_safe(path)
    if value.get("schema") != RECORDING_STATUS_SCHEMA:
        raise Blocker("browser_use_recording_status_schema_invalid")
    if not isinstance(value.get("recorder_configured"), bool) or not isinstance(value.get("recorder_active"), bool):
        raise Blocker("browser_use_recording_status_invalid")
    if require_active is True and value.get("recorder_active") is not True:
        raise Blocker("browser_use_recording_not_active")
    if require_active is False and value.get("recorder_active") is not False:
        raise Blocker("browser_use_recording_not_finalized")
    return value


def mark_recording_abandoned(path: str, *, reason: str) -> dict[str, Any]:
    """Persist an honest stopped/abandoned recorder state without finalizing video."""
    value = read_recording_status(path, require_active=None)
    if value.get("finalized") is True:
        raise Blocker("browser_use_recording_already_finalized")
    value.update(
        {
            "recorder_active": False,
            "finalized": False,
            "state": "abandoned",
            "durable_state": "abandoned",
            "state_reason": str(reason)[:160],
            "state_updated_at": iso(now_utc()),
        }
    )
    json_atomic_replace(path, value)
    return value


def require_recording_continuable(descriptor: dict[str, Any]) -> None:
    """Reject descriptor markers that are no longer live recording leases."""
    if descriptor.get("status") not in {"active", "continued"}:
        raise Blocker("browser_use_recording_descriptor_not_live", str(descriptor.get("status", "missing")))


def _recording_descriptor_paths(config: dict[str, Any]) -> list[str]:
    root = pathlib.Path(recording_descriptor_root(config))
    paths: list[str] = []
    for path in sorted(root.rglob("*.json")):
        if path.is_symlink() or not path.is_file():
            continue
        try:
            value = read_json_safe(str(path))
        except Blocker:
            continue
        descriptor_fields = {"status", "run_id", "session", "status_path", "process", "owned_chrome", "profile", "lock_paths"}
        if value.get("schema") == RECORDING_SCHEMA and value.get("status") in RECORDING_STATUSES and descriptor_fields.issubset(value):
            paths.append(os.path.realpath(str(path)))
    return paths


def require_cross_run_reconciliation_clear(config: dict[str, Any], *, run_id: str, automation_id: str, account_identity: str) -> None:
    """Prevent a fresh run from bypassing an unresolved prior effect.

    The generic helper has no business-resource key, so the conservative scope
    is the workflow automation plus account identity.  A workflow-owned
    source-of-truth reconciliation must clear the prior descriptor before a
    new effectful run may start; this helper never invents that proof.
    """
    for path in _recording_descriptor_paths(config):
        try:
            value = read_json_safe(path)
        except Blocker as exc:
            raise Blocker("browser_use_external_effect_reconciliation_required", exc.code) from exc
        if value.get("run_id") == run_id or value.get("status") not in {"active", "continued", "cleanup_pending", "stale"}:
            continue
        if value.get("automation_id") != automation_id or value.get("account_identity") != account_identity:
            continue
        try:
            pending = _operation_ledger_reconciliation(value)
        except Blocker as exc:
            raise Blocker("browser_use_external_effect_reconciliation_required", f"{os.path.basename(path)}:{exc.code}") from exc
        if pending:
            ids = ",".join(entry["operation_id"] for entry in pending[:12])
            raise Blocker("browser_use_external_effect_reconciliation_required", f"prior_run={value.get('run_id')}:{ids}")


def _diagnostic_process_liveness(config: dict[str, Any], value: dict[str, Any]) -> tuple[bool | None, str | None]:
    """Probe the descriptor-bound process for status display only.

    This intentionally reuses the exact handoff identity checks but never
    changes descriptor admission, kills a process, releases a lock, or marks a
    run finalized.  A handoff-owned browser is reported as unknown because its
    owner is the handoff lifecycle, not the recording descriptor.
    """
    if value.get("owned_chrome") is not True:
        return None, None
    try:
        validate_handoff_process_identity(
            config,
            {"process": value["process"], "port": value["port"], "profile": value["profile"]},
            allow_missing=False,
        )
        return True, None
    except (KeyError, Blocker) as exc:
        return False, exc.code if isinstance(exc, Blocker) else "browser_use_recording_process_identity_invalid"


def _classify_recording_descriptor(config: dict[str, Any], path: str, value: dict[str, Any]) -> dict[str, Any]:
    """Return bounded liveness metadata without page content or cleanup side effects."""
    entry: dict[str, Any] = {
        "descriptor": os.path.realpath(path),
        "run_id": value.get("run_id"),
        "session": value.get("session"),
        "lifecycle": value.get("lifecycle"),
        "status": value.get("status"),
        "liveness": "unknown",
        "process_live": None,
        "process_live_blocker": None,
        "recorder_active": None,
        "recorder_finalized": None,
    }
    try:
        status = read_recording_status(str(value["status_path"]), require_active=None)
        entry["recorder_active"] = status["recorder_active"]
        entry["recorder_finalized"] = status["finalized"]
    except (KeyError, Blocker) as exc:
        entry["liveness"] = "stale"
        entry["exact_blocker"] = exc.code if isinstance(exc, Blocker) else "browser_use_recording_status_missing"
        return entry

    if value.get("status") == "finalized" or entry["recorder_finalized"] is True:
        entry["liveness"] = "finalized" if value.get("status") == "finalized" else "stale"
        if entry["liveness"] == "stale":
            entry["exact_blocker"] = "browser_use_recording_descriptor_status_not_finalized"
        return entry
    if value.get("status") not in {"active", "continued"}:
        entry["liveness"] = str(value.get("status") or "unknown")
        return entry

    process_live, process_blocker = _diagnostic_process_liveness(config, value)
    entry["process_live"] = process_live
    entry["process_live_blocker"] = process_blocker

    try:
        run_id = safe_id(str(value["run_id"]), "run_id")
        session = validate_id(str(value["session"]), "session")
        descriptor = read_recording_descriptor(config, path, run_id, session)
        validate_recording_process(config, descriptor)
        if entry["recorder_active"] is not True:
            raise Blocker("browser_use_recording_not_active")
    except (KeyError, Blocker) as exc:
        entry["liveness"] = "stale"
        entry["exact_blocker"] = exc.code if isinstance(exc, Blocker) else "browser_use_recording_descriptor_fields_missing"
        if isinstance(exc, Blocker) and exc.code == "browser_use_recording_helper_hash_mismatch":
            try:
                pinned = validate_helper_snapshot(value)
            except Blocker:
                pinned = None
            if pinned:
                entry["liveness"] = "recoverable"
                entry["recovery_available"] = True
                entry["recovery_action"] = "same-run command/resume/recover/finalize will exec the pinned helper generation"
        return entry
    entry["liveness"] = "live"
    return entry


def recording_status(args: argparse.Namespace) -> int:
    """Classify descriptors using fresh process/listener/recorder evidence."""
    config = read_toml()
    validate_installation(config)
    if args.descriptor:
        path = os.path.realpath(args.descriptor)
        assert_recording_descriptor_path(config, path)
        paths = [path]
    else:
        paths = _recording_descriptor_paths(config)
    entries: list[dict[str, Any]] = []
    marked_stale = 0
    for path in paths:
        try:
            value = read_json_safe(path)
        except Blocker:
            continue
        if value.get("schema") != RECORDING_SCHEMA:
            continue
        entry = _classify_recording_descriptor(config, path, value)
        if args.mark_stale and entry["liveness"] == "stale" and value.get("status") in {"active", "continued"}:
            value["status"] = "stale"
            stale_reason = entry.get("exact_blocker", "browser_use_recording_descriptor_stale")
            value["stale_state"] = {
                "state": "uncertain",
                "uncertain": True,
                "exact_blocker": stale_reason,
                "updated_at": iso(now_utc()),
            }
            json_atomic_replace(path, value)
            try:
                mark_recording_abandoned(str(value["status_path"]), reason=stale_reason)
            except Blocker as exc:
                if exc.code != "browser_use_recording_already_finalized":
                    raise
            entry["status"] = "stale"
            entry["marked_stale"] = True
            marked_stale += 1
        entries.append(entry)
    live = sum(entry["liveness"] == "live" for entry in entries)
    stale = sum(entry["liveness"] == "stale" for entry in entries)
    recoverable = sum(entry["liveness"] == "recoverable" for entry in entries)
    recoverable_live = sum(entry["liveness"] == "recoverable" and entry.get("process_live") is True for entry in entries)
    process_live_count = sum(entry.get("process_live") is True for entry in entries)
    print(json.dumps({"status": "completed", "entries": entries, "live_count": live, "stale_count": stale, "recoverable_count": recoverable, "recoverable_live_count": recoverable_live, "process_live_count": process_live_count, "marked_stale_count": marked_stale, "finalized": True}, sort_keys=True))
    return 0


def wait_for_recording_stop(path: str, timeout_seconds: float = 15.0) -> dict[str, Any]:
    deadline = time.monotonic() + timeout_seconds
    last_error: Blocker | None = None
    while time.monotonic() < deadline:
        try:
            value = read_recording_status(path, require_active=False)
            if value.get("finalized") is True:
                return value
        except Blocker as exc:
            last_error = exc
        time.sleep(0.25)
    if last_error is not None:
        raise last_error
    raise Blocker("browser_use_recording_stop_readback_timeout")


def probe_recording_video(config: dict[str, Any], recording_dir: str) -> dict[str, Any]:
    ffprobe = config["executables"]["ffprobe"]["canonical_path"]
    ffmpeg = config["executables"]["ffmpeg"]["canonical_path"]
    videos = sorted(pathlib.Path(recording_dir).glob("*.mp4"))
    if len(videos) != 1:
        raise Blocker("browser_use_recording_video_count_invalid")
    video = videos[0]
    if video.is_symlink() or not video.is_file() or video.parent.resolve() != pathlib.Path(recording_dir):
        raise Blocker("browser_use_recording_video_path_invalid")
    os.chmod(video, 0o600)
    probe = subprocess.run(
        [ffprobe, "-v", "error", "-count_frames", "-select_streams", "v:0", "-show_entries", "stream=codec_name,width,height,r_frame_rate,nb_read_frames", "-show_entries", "format=duration", "-of", "json", str(video)],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=30,
    )
    if probe.returncode != 0:
        raise Blocker("browser_use_recording_video_probe_failed")
    try:
        value = json.loads(probe.stdout)
        stream = (value.get("streams") or [])[0]
        frames = int(stream.get("nb_read_frames") or 0)
        duration = float((value.get("format") or {}).get("duration") or 0)
    except (IndexError, TypeError, ValueError, json.JSONDecodeError) as exc:
        raise Blocker("browser_use_recording_video_probe_invalid") from exc
    if frames <= 0 or duration <= 0:
        raise Blocker("browser_use_recording_video_empty")
    representative = pathlib.Path(recording_dir) / "representative-frame.jpg"
    representative_time = max(0.0, min(duration / 2.0, max(duration - 0.1, 0.0)))
    frame = subprocess.run(
        [ffmpeg, "-v", "error", "-y", "-ss", f"{representative_time:.3f}", "-i", str(video), "-frames:v", "1", "-q:v", "2", str(representative)],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=30,
    )
    if frame.returncode != 0 or not representative.exists():
        raise Blocker("browser_use_recording_representative_frame_failed")
    os.chmod(representative, 0o600)
    return {
        "video_path": str(video),
        "codec": stream.get("codec_name"),
        "width": stream.get("width"),
        "height": stream.get("height"),
        "framerate": stream.get("r_frame_rate"),
        "frames": frames,
        "duration_seconds": duration,
        "representative_time_seconds": representative_time,
        "sha256": sha256_file(str(video)),
        "representative_frame_path": str(representative),
        "representative_frame_sha256": sha256_file(str(representative)),
    }


def json_atomic_no_replace(path: str, value: dict[str, Any]) -> None:
    parent = os.path.dirname(path)
    assert_directory(parent, create=True)
    payload = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
    temp = os.path.join(parent, f".{os.path.basename(path)}.{uuid.uuid4().hex}.tmp")
    fd = os.open(temp, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    try:
        os.write(fd, payload)
        os.fsync(fd)
    finally:
        os.close(fd)
    try:
        os.link(temp, path)
        os.unlink(temp)
    except FileExistsError as exc:
        try:
            os.unlink(temp)
        except FileNotFoundError:
            pass
        raise Blocker("browser_use_receipt_already_exists", path) from exc
    os.chmod(path, 0o600)
    directory_fd = os.open(parent, os.O_RDONLY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def json_atomic_replace(path: str, value: dict[str, Any]) -> None:
    parent = os.path.dirname(path)
    assert_directory(parent, create=True)
    temp = os.path.join(parent, f".{os.path.basename(path)}.{uuid.uuid4().hex}.tmp")
    fd = os.open(temp, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    try:
        os.write(fd, (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(temp, path)
    os.chmod(path, 0o600)


def _ledger_public_command(command: list[str]) -> dict[str, Any]:
    """Return command metadata safe for durable state.

    Arguments are represented by shape only. Hashing arbitrary arguments is
    not a privacy boundary because URLs, target labels, and form values may
    still be sensitive even when the original text is not persisted.
    """
    name = str(command[0]) if command else ""
    return {
        "name": name,
        "argument_count": max(0, len(command) - 1),
        "read_only": name in READ_ONLY_OPERATION_COMMANDS,
        "argument_shapes": [
            "url" if str(arg).startswith(("http://", "https://")) else
            "path" if os.path.isabs(str(arg)) else
            "scalar"
            for arg in command[1:]
        ],
    }


def operation_ledger_path(descriptor: dict[str, Any]) -> str:
    value = descriptor.get("operation_ledger_path") or os.path.join(descriptor["recording_dir"], "operation-ledger.jsonl")
    if not os.path.isabs(value) or os.path.realpath(value) != value:
        raise Blocker("browser_use_operation_ledger_path_invalid")
    if os.path.dirname(value) != os.path.realpath(descriptor["recording_dir"]):
        raise Blocker("browser_use_operation_ledger_scope_invalid")
    return value


def operation_ledger_lock_path(descriptor: dict[str, Any]) -> str:
    return f"{operation_ledger_path(descriptor)}.lock"


def reconcile_operation_ledger_lock(descriptor: dict[str, Any]) -> None:
    """Recover only a dead, descriptor-bound append lock."""
    path = operation_ledger_lock_path(descriptor)
    if not os.path.lexists(path):
        return
    value = read_json_safe(path)
    if value.get("schema") != "browser-use-operation-ledger-lock.v1" or value.get("recording_run_id") != descriptor.get("run_id") or value.get("recording_nonce") != descriptor.get("nonce"):
        raise Blocker("browser_use_operation_ledger_lock_owner_unknown")
    pid = value.get("lock_pid")
    start_time = value.get("lock_start_time")
    if not isinstance(pid, int) or pid <= 0 or not isinstance(start_time, (int, float)):
        raise Blocker("browser_use_operation_ledger_lock_identity_invalid")
    alive = False
    try:
        process = psutil.Process(pid) if psutil is not None else None
        if process is not None:
            alive = process.is_running() and abs(float(process.create_time()) - float(start_time)) < 2.0
        else:
            os.kill(pid, 0)
            alive = True
    except (OSError, psutil.Error if psutil is not None else OSError):
        alive = False
    if alive:
        raise Blocker("browser_use_operation_ledger_lock_active")
    release_lock(path, str(value["run_id"]), str(value["nonce"]))


def _operation_ledger_rows(path: str) -> list[dict[str, Any]]:
    if not os.path.lexists(path):
        return []
    assert_regular_file(path, mode=0o600)
    rows: list[dict[str, Any]] = []
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            if not line.strip():
                continue
            try:
                row = json.loads(line)
            except json.JSONDecodeError as exc:
                raise Blocker("browser_use_operation_ledger_invalid") from exc
            if not isinstance(row, dict) or row.get("schema") != OPERATION_LEDGER_SCHEMA:
                raise Blocker("browser_use_operation_ledger_invalid")
            rows.append(row)
    previous = "0" * 64
    for expected_sequence, row in enumerate(rows, 1):
        if row.get("sequence") != expected_sequence or row.get("previous_chain_digest") != previous:
            raise Blocker("browser_use_operation_ledger_sequence_invalid")
        body = dict(row)
        chain = body.pop("chain_digest", None)
        expected_chain = hashlib.sha256((previous + json.dumps(body, sort_keys=True, separators=(",", ":"))).encode("utf-8")).hexdigest()
        if chain != expected_chain:
            raise Blocker("browser_use_operation_ledger_chain_invalid")
        previous = chain
    return rows


def _operation_ledger_reconciliation(descriptor: dict[str, Any]) -> list[dict[str, str]]:
    """Return the monotonic set of operations that still need reconciliation.

    Missing outcome proof is never interpreted as ``none``.  This function is
    intentionally derived from the append-only ledger and the bounded failure
    records so a later command cannot accidentally reopen an ambiguous effect.
    """
    try:
        rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    except Blocker as exc:
        # An unreadable, torn, foreign, or otherwise unsafe ledger is not an
        # empty ledger.  Effectful admission must stop until a workflow-owned
        # reconciliation restores trustworthy evidence.
        raise Blocker("browser_use_external_effect_reconciliation_required", exc.code) from exc

    intents: dict[str, dict[str, Any]] = {}
    outcomes: dict[str, dict[str, Any]] = {}
    reconciliations: dict[str, dict[str, Any]] = {}
    descriptor_reconciliations: set[str] = set()
    for item in descriptor.get("reconciliations", []):
        if not isinstance(item, dict) or item.get("resolution") not in {"none", "executed"}:
            continue
        for operation_id in item.get("operation_ids", []):
            if isinstance(operation_id, str):
                descriptor_reconciliations.add(operation_id)
    for row in rows:
        if row.get("recording_run_id") != descriptor.get("run_id") or row.get("session") != descriptor.get("session"):
            raise Blocker("browser_use_external_effect_reconciliation_required", "browser_use_operation_ledger_binding_invalid")
        operation_id = str(row.get("operation_id", ""))
        if row.get("phase") == "intent":
            intents[operation_id] = row
        elif row.get("phase") == "outcome":
            outcomes[operation_id] = row
        elif row.get("phase") == "reconciliation":
            reconciliations[operation_id] = row

    pending: list[dict[str, str]] = []
    for operation_id, intent in intents.items():
        outcome = outcomes.get(operation_id)
        reconciliation = reconciliations.get(operation_id)
        if operation_id in descriptor_reconciliations or (reconciliation is not None and str(reconciliation.get("external_effects")) in {"none", "executed"}):
            continue
        if outcome is None:
            pending.append({"operation_id": operation_id, "reason": "orphan_intent", "external_effects": "unknown"})
        elif str(outcome.get("external_effects")) == "unknown":
            pending.append({"operation_id": operation_id, "reason": "unknown_external_effect", "external_effects": "unknown"})

    for item in descriptor.get("failed_operations", []):
        if not isinstance(item, dict) or not item.get("external_action_possible"):
            continue
        operation_id = str(item.get("operation_id") or "failed-operation")
        reconciliation = reconciliations.get(operation_id)
        if operation_id in descriptor_reconciliations or (reconciliation is not None and str(reconciliation.get("external_effects")) in {"none", "executed"}):
            continue
        if not any(entry["operation_id"] == operation_id for entry in pending):
            pending.append({"operation_id": operation_id, "reason": "failed_external_action_possible", "external_effects": "unknown"})
    return pending


def pending_operation_reconciliation_ids(descriptor: dict[str, Any]) -> list[str]:
    return [entry["operation_id"] for entry in _operation_ledger_reconciliation(descriptor)]


def require_no_pending_effect_reconciliation(descriptor: dict[str, Any], *, effectful: bool) -> None:
    """Deny a new external-effect operation while proof is incomplete."""
    if not effectful:
        return
    pending = pending_operation_reconciliation_ids(descriptor)
    if pending:
        raise Blocker("browser_use_external_effect_reconciliation_required", ",".join(pending[:12]))


def append_operation_intent_durable(descriptor: dict[str, Any], *, operation_id: str, command: list[str], external_effects: str, outcome: str) -> dict[str, Any]:
    """Append and reread an intent before any browser dispatch."""
    row = append_operation_ledger(
        descriptor,
        operation_id=operation_id,
        phase="intent",
        command=command,
        external_effects=external_effects,
        outcome=outcome,
    )
    try:
        rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    except Blocker as exc:
        try:
            write_recovery_checkpoint(
                descriptor,
                exact_blocker="browser_use_operation_intent_durability_unverified",
                next_action="same-run ledger reconciliation before any dispatch",
                operation_id=operation_id,
            )
        except Exception:
            pass
        raise Blocker("browser_use_operation_intent_durability_unverified", exc.code) from exc
    if not any(item.get("operation_id") == operation_id and item.get("phase") == "intent" for item in rows):
        raise Blocker("browser_use_operation_intent_durability_unverified")
    return row


def append_operation_outcome_durable(descriptor: dict[str, Any], *, operation_id: str, command: list[str], external_effects: str, outcome: str) -> dict[str, Any] | None:
    """Append one outcome and prove it is visible, retrying only the append.

    The retry never dispatches the browser command again.  If the outcome still
    cannot be proven, the checkpoint keeps the run in reconciliation-required
    state and the caller must stop.
    """
    last_error: Blocker | None = None
    for _attempt in range(2):
        try:
            rows = _operation_ledger_rows(operation_ledger_path(descriptor))
            existing = next((item for item in rows if item.get("operation_id") == operation_id and item.get("phase") == "outcome"), None)
            if existing is not None:
                return existing
            append_operation_ledger(
                descriptor,
                operation_id=operation_id,
                phase="outcome",
                command=command,
                external_effects=external_effects,
                outcome=outcome,
            )
            rows = _operation_ledger_rows(operation_ledger_path(descriptor))
            existing = next((item for item in rows if item.get("operation_id") == operation_id and item.get("phase") == "outcome"), None)
            if existing is not None:
                return existing
        except Blocker as exc:
            last_error = exc
    try:
        write_recovery_checkpoint(
            descriptor,
            exact_blocker="browser_use_operation_outcome_append_failed",
            next_action="same-run ledger reconciliation before any retry",
            operation_id=operation_id,
        )
    except Exception:
        pass
    detail = last_error.code if last_error is not None else "outcome_not_visible"
    raise Blocker("browser_use_operation_outcome_append_failed", detail)


def append_operation_reconciliation_durable(descriptor: dict[str, Any], *, operation_id: str, external_effects: str, outcome: str) -> dict[str, Any] | None:
    """Append one explicit reconciliation without rewriting the original outcome."""
    if external_effects not in {"none", "executed"}:
        raise Blocker("browser_use_operation_reconciliation_resolution_invalid")
    path = operation_ledger_path(descriptor)
    for _attempt in range(2):
        try:
            rows = _operation_ledger_rows(path)
            existing = next((item for item in rows if item.get("operation_id") == operation_id and item.get("phase") == "reconciliation"), None)
            if existing is not None:
                return existing
            append_operation_ledger(
                descriptor,
                operation_id=operation_id,
                phase="reconciliation",
                command=["reconciliation"],
                external_effects=external_effects,
                outcome=outcome,
            )
            rows = _operation_ledger_rows(path)
            existing = next((item for item in rows if item.get("operation_id") == operation_id and item.get("phase") == "reconciliation"), None)
            if existing is not None:
                return existing
        except Blocker:
            continue
    raise Blocker("browser_use_operation_reconciliation_append_failed")


def close_orphan_operation_intents(descriptor: dict[str, Any]) -> list[str]:
    """Record orphan closure without ever clearing the unknown-effect gate."""
    pending = _operation_ledger_reconciliation(descriptor)
    for entry in pending:
        if entry["reason"] != "orphan_intent":
            continue
        operation_id = entry["operation_id"]
        append_operation_outcome_durable(
            descriptor,
            operation_id=operation_id,
            command=["recovery"],
            external_effects="unknown",
            outcome="orphan_intent_closed_by_recover",
        )
    return pending_operation_reconciliation_ids(descriptor)


def _navigation_reconciliation_candidate(rows: list[dict[str, Any]], operation_id: str) -> tuple[dict[str, Any], dict[str, Any]]:
    """Validate the narrow, read-only navigation intent eligible for reconciliation.

    The ledger intentionally stores command shape rather than URL text.  This
    helper therefore admits only an original ``open`` intent that was already
    classified as having no external effect, followed by the bounded recovery
    outcome that left the effect state unknown.  It must never be used to
    reinterpret a click, form submission, upload, or other effectful command.
    """
    if not re.fullmatch(r"[a-f0-9]{32}", str(operation_id)):
        raise Blocker("browser_use_navigation_reconciliation_operation_id_invalid")
    intents = {
        str(row.get("operation_id")): row
        for row in rows
        if row.get("phase") == "intent"
    }
    outcomes = {
        str(row.get("operation_id")): row
        for row in rows
        if row.get("phase") == "outcome"
    }
    intent = intents.get(operation_id)
    outcome = outcomes.get(operation_id)
    if intent is None or outcome is None:
        raise Blocker("browser_use_navigation_reconciliation_operation_missing")
    command = intent.get("command")
    if not isinstance(command, dict) or command.get("name") != "open":
        raise Blocker("browser_use_navigation_reconciliation_operation_not_open")
    if command.get("argument_count") != 1 or command.get("argument_shapes") != ["url"]:
        raise Blocker("browser_use_navigation_reconciliation_open_shape_invalid")
    if intent.get("external_effects") != "none":
        raise Blocker("browser_use_navigation_reconciliation_original_effect_not_none")
    if outcome.get("external_effects") != "unknown" or outcome.get("outcome") != "orphan_intent_closed_by_recover":
        raise Blocker("browser_use_navigation_reconciliation_outcome_mismatch")
    return intent, outcome


def _target_click_reconciliation_candidate(rows: list[dict[str, Any]], operation_id: str) -> tuple[dict[str, Any], dict[str, Any]]:
    """Validate the helper-rejected target click eligible for live reconciliation."""
    if not re.fullmatch(r"[a-f0-9]{32}", str(operation_id)):
        raise Blocker("browser_use_target_reconciliation_operation_id_invalid")
    intents = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "intent"}
    outcomes = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "outcome"}
    intent = intents.get(operation_id)
    outcome = outcomes.get(operation_id)
    if intent is None or outcome is None:
        raise Blocker("browser_use_target_reconciliation_operation_missing")
    command = intent.get("command")
    if not isinstance(command, dict) or command.get("name") != "target-click":
        raise Blocker("browser_use_target_reconciliation_operation_not_target_click")
    if intent.get("external_effects") != "unknown":
        raise Blocker("browser_use_target_reconciliation_original_effect_not_unknown")
    if outcome.get("external_effects") != "unknown" or outcome.get("outcome") != "browser_use_target_click_failed":
        raise Blocker("browser_use_target_reconciliation_outcome_mismatch")
    return intent, outcome


def _coordinate_click_reconciliation_candidate(rows: list[dict[str, Any]], operation_id: str) -> tuple[dict[str, Any], dict[str, Any]]:
    """Validate a coordinate click whose post-dispatch readback was late."""
    if not re.fullmatch(r"[a-f0-9]{32}", str(operation_id)):
        raise Blocker("browser_use_click_reconciliation_operation_id_invalid")
    intents = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "intent"}
    outcomes = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "outcome"}
    intent = intents.get(operation_id)
    outcome = outcomes.get(operation_id)
    if intent is None or outcome is None:
        raise Blocker("browser_use_click_reconciliation_operation_missing")
    command = intent.get("command")
    if not isinstance(command, dict) or command.get("name") != "click" or command.get("argument_count") != 2 or command.get("argument_shapes") != ["scalar", "scalar"]:
        raise Blocker("browser_use_click_reconciliation_operation_not_coordinate_click")
    if intent.get("external_effects") != "unknown":
        raise Blocker("browser_use_click_reconciliation_original_effect_not_unknown")
    if outcome.get("external_effects") != "unknown" or outcome.get("outcome") != "post_dispatch_navigation_readback_failed":
        raise Blocker("browser_use_click_reconciliation_outcome_mismatch")
    return intent, outcome


def _eval_syntax_error_reconciliation_candidate(rows: list[dict[str, Any]], operation_id: str) -> tuple[dict[str, Any], dict[str, Any]]:
    """Validate an eval that failed in the Browser Use CLI parser before page dispatch.

    This is intentionally narrower than a general eval reconciliation.  It
    accepts only the one-argument eval shape and the exact dispatch-failed
    ledger outcome produced by the old helper.  The caller must also provide
    the CLI's syntax-error evidence code and a fresh same-run page readback.
    """
    if not re.fullmatch(r"[a-f0-9]{32}", str(operation_id)):
        raise Blocker("browser_use_eval_reconciliation_operation_id_invalid")
    intents = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "intent"}
    outcomes = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "outcome"}
    intent = intents.get(operation_id)
    outcome = outcomes.get(operation_id)
    if intent is None or outcome is None:
        raise Blocker("browser_use_eval_reconciliation_operation_missing")
    command = intent.get("command")
    if not isinstance(command, dict) or command.get("name") != "eval":
        raise Blocker("browser_use_eval_reconciliation_operation_not_eval")
    if command.get("argument_count") != 1 or command.get("argument_shapes") != ["scalar"]:
        raise Blocker("browser_use_eval_reconciliation_eval_shape_invalid")
    if intent.get("external_effects") != "unknown":
        raise Blocker("browser_use_eval_reconciliation_original_effect_not_unknown")
    if outcome.get("external_effects") != "unknown" or outcome.get("outcome") != "dispatch_failed":
        raise Blocker("browser_use_eval_reconciliation_outcome_mismatch")
    return intent, outcome


def append_operation_ledger(descriptor: dict[str, Any], *, operation_id: str, phase: str, command: list[str], external_effects: str, outcome: str = "") -> dict[str, Any]:
    """Append one fsynced, secret-free intent/outcome row before/after dispatch."""
    if not re.fullmatch(r"[a-f0-9]{32}", str(operation_id)):
        raise Blocker("browser_use_operation_id_invalid")
    if phase not in {"intent", "outcome", "reconciliation"} or external_effects not in OPERATION_EFFECT_STATES:
        raise Blocker("browser_use_operation_ledger_entry_invalid")
    if not isinstance(command, list) or not command or not isinstance(command[0], str):
        raise Blocker("browser_use_operation_ledger_command_invalid")
    path = operation_ledger_path(descriptor)
    parent = os.path.dirname(path)
    assert_directory(parent, create=True)
    lock_path = operation_ledger_lock_path(descriptor)
    reconcile_operation_ledger_lock(descriptor)
    lock_token = f"operation-ledger-{os.getpid()}-{uuid.uuid4().hex}"
    lock_file(lock_path, {"schema": "browser-use-operation-ledger-lock.v1", "run_id": lock_token, "nonce": lock_token, "recording_run_id": descriptor.get("run_id"), "recording_nonce": descriptor.get("nonce"), "lock_pid": os.getpid(), "lock_start_time": psutil.Process(os.getpid()).create_time() if psutil is not None else 0.0})
    try:
        rows = _operation_ledger_rows(path)
        for row in rows:
            if row.get("recording_run_id") != descriptor.get("run_id") or row.get("session") != descriptor.get("session"):
                raise Blocker("browser_use_operation_ledger_binding_invalid")
        matching = [row for row in rows if row.get("operation_id") == operation_id]
        if phase == "intent" and matching:
            raise Blocker("browser_use_operation_id_replay")
        if phase == "outcome" and not any(row.get("phase") == "intent" for row in matching):
            raise Blocker("browser_use_operation_intent_missing")
        if phase == "outcome" and any(row.get("phase") == "outcome" for row in matching):
            raise Blocker("browser_use_operation_outcome_replay")
        if phase == "reconciliation" and any(row.get("phase") == "reconciliation" for row in matching):
            raise Blocker("browser_use_operation_reconciliation_replay")
        if phase == "reconciliation" and not matching:
            failed_operation = next(
                (
                    item
                    for item in descriptor.get("failed_operations", [])
                    if isinstance(item, dict) and str(item.get("operation_id") or "failed-operation") == operation_id
                ),
                None,
            )
            if failed_operation is None:
                raise Blocker("browser_use_operation_reconciliation_target_missing")
        previous = rows[-1].get("chain_digest", "0" * 64) if rows else "0" * 64
        body = {
            "schema": OPERATION_LEDGER_SCHEMA,
            "sequence": len(rows) + 1,
            "event_id": uuid.uuid4().hex,
            "operation_id": operation_id,
            "phase": phase,
            "command": _ledger_public_command(command),
            "external_effects": external_effects,
            "outcome": str(outcome or "")[:160],
            "recorded_at": iso(now_utc()),
            "previous_chain_digest": previous,
            "recording_run_id": str(descriptor.get("run_id", "")),
            "session": str(descriptor.get("session", "")),
        }
        body["chain_digest"] = hashlib.sha256((previous + json.dumps(body, sort_keys=True, separators=(",", ":"))).encode("utf-8")).hexdigest()
        fd = os.open(path, os.O_CREAT | os.O_APPEND | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0), 0o600)
        try:
            os.write(fd, (json.dumps(body, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8"))
            os.fsync(fd)
        finally:
            os.close(fd)
        os.chmod(path, 0o600)
        return body
    finally:
        release_lock(lock_path, lock_token, lock_token)


def operation_effect_summary(descriptor: dict[str, Any]) -> str:
    """Reduce the durable operation trail without treating missing proof as none."""
    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    if not rows:
        if any(bool(item.get("external_action_possible")) for item in descriptor.get("failed_operations", []) if isinstance(item, dict)):
            return "unknown"
        return "none"
    outcomes: dict[str, str] = {}
    for row in rows:
        if row.get("recording_run_id") != descriptor.get("run_id") or row.get("session") != descriptor.get("session"):
            raise Blocker("browser_use_operation_ledger_binding_invalid")
        if row.get("phase") == "outcome":
            outcomes[str(row["operation_id"])] = str(row.get("external_effects"))
        elif row.get("phase") == "reconciliation":
            outcomes[str(row["operation_id"])] = str(row.get("external_effects"))
    for item in descriptor.get("reconciliations", []):
        if not isinstance(item, dict) or item.get("resolution") not in {"none", "executed"}:
            continue
        for operation_id in item.get("operation_ids", []):
            if isinstance(operation_id, str):
                outcomes[operation_id] = "executed" if item.get("resolution") == "executed" else "none"
    intent_ids = {str(row["operation_id"]) for row in rows if row.get("phase") == "intent"}
    if intent_ids - set(outcomes):
        return "unknown"
    values = set(outcomes.values())
    if "unknown" in values:
        return "unknown"
    if "executed" in values:
        return "executed"
    return "none"


def write_recovery_checkpoint(descriptor: dict[str, Any], *, exact_blocker: str, next_action: str, operation_id: str | None = None) -> str:
    """Persist a non-authoritative, secret-free restart hint for the next run."""
    path = os.path.join(os.path.realpath(descriptor["recording_dir"]), "recovery-checkpoint.json")
    ledger_readback_blocker: str | None = None
    try:
        rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    except Blocker as exc:
        # Preserve the checkpoint even when the ledger itself is damaged.  The
        # checkpoint is not a proof of completion; it only records that the
        # next operation must perform workflow-owned reconciliation.
        rows = []
        ledger_readback_blocker = exc.code
    payload = {
        "schema": "browser-use-recovery-checkpoint.v1",
        "run_id": descriptor.get("run_id"),
        "session": descriptor.get("session"),
        "stage": "recovering",
        "operation_id": operation_id,
        "exact_blocker": str(exact_blocker)[:160],
        "next_action": str(next_action)[:160],
        "retry_count": int(descriptor.get("recovery_retry_count", 0)),
        "ledger_tail_digest": rows[-1].get("chain_digest") if rows else "0" * 64,
        "ledger_readback_blocker": ledger_readback_blocker,
        "updated_at": iso(now_utc()),
    }
    json_atomic_replace(path, payload)
    descriptor["checkpoint_path"] = path
    return path


def read_json_safe(path: str) -> dict[str, Any]:
    assert_regular_file(path, mode=0o600)
    with open(path, "rb") as handle:
        value = json.load(handle)
    if not isinstance(value, dict):
        raise Blocker("browser_use_json_object_required", path)
    return value


def handoff_root(config: dict[str, Any]) -> str:
    root = os.path.join(config["roots"]["browser_use_home"], "handoffs")
    assert_directory(root, create=True)
    return root


def assert_handoff_path(path: str, root: str) -> None:
    if not os.path.isabs(path) or os.path.realpath(path) != path:
        raise Blocker("browser_use_handoff_path_noncanonical")
    canonical_root = os.path.realpath(root)
    parent = os.path.realpath(os.path.dirname(path))
    if parent != canonical_root and not parent.startswith(canonical_root + os.sep):
        raise Blocker("browser_use_handoff_path_scope_mismatch")
    if not os.path.basename(path).endswith((".json", ".json.consumed", ".json.abandoned")):
        raise Blocker("browser_use_handoff_path_invalid")


def handoff_lock_paths(config: dict[str, Any], value: dict[str, Any]) -> list[str]:
    paths = value.get("lock_paths")
    if not isinstance(paths, list) or len(paths) != 2 or not all(isinstance(item, str) for item in paths):
        raise Blocker("browser_use_handoff_lease_invalid")
    locks_root = os.path.realpath(config["roots"]["locks"])
    for path in paths:
        if not os.path.isabs(path) or os.path.realpath(path) != path or os.path.dirname(path) != locks_root:
            raise Blocker("browser_use_handoff_lease_scope_mismatch")
        assert_regular_file(path, mode=0o600)
    return paths


def read_handoff(config: dict[str, Any], path: str, run_id: str, session: str, *, require_unexpired: bool) -> dict[str, Any]:
    root = handoff_root(config)
    assert_handoff_path(path, root)
    value = read_json_safe(path)
    required = {"schema", "status", "run_id", "session", "automation_id", "nonce", "authority_sha256", "origin", "profile", "profile_hash", "profile_marker_sha256", "port", "daemon_session", "process", "lock_paths", "lease_path", "download_dir"}
    missing = sorted(required - value.keys())
    if missing:
        raise Blocker("browser_use_handoff_fields_missing", ",".join(missing))
    if value["schema"] != HANDOFF_SCHEMA or value["status"] not in HANDOFF_STATUSES:
        raise Blocker("browser_use_handoff_schema_or_status_invalid")
    if value["run_id"] != run_id or value["session"] != session or value["daemon_session"] != session:
        raise Blocker("browser_use_handoff_binding_mismatch")
    requested_session = value.get("requested_session")
    if requested_session is not None:
        validate_id(requested_session, "session")
        if canonical_session_id(requested_session, config["roots"]["browser_use_home"]) != session:
            raise Blocker("browser_use_session_binding_invalid")
    safe_id(value["automation_id"], "automation_id")
    safe_id(value["nonce"], "nonce")
    lifecycle = str(value.get("lifecycle", "single-use"))
    if lifecycle not in {"single-use", "scheduled", TEMPORARY_LIFECYCLE}:
        raise Blocker("browser_use_handoff_lifecycle_invalid")
    if lifecycle == TEMPORARY_LIFECYCLE:
        for field in ("task_id", "creation_binding", "authority_scope"):
            if field not in value:
                raise Blocker("browser_use_temporary_handoff_fields_missing", field)
        safe_id(value["task_id"], "task_id")
        if value.get("mode", "authorized") != "authorized":
            raise Blocker("browser_use_temporary_requires_authorized_mode")
    expected_lease = os.path.realpath(path)
    legacy_claim_lease = _handoff_base_path(path) if path.endswith((HANDOFF_CLAIM_SUFFIX, HANDOFF_CONSUMED_SUFFIX)) else None
    if value["lease_path"] != expected_lease and value["lease_path"] != legacy_claim_lease:
        raise Blocker("browser_use_handoff_lease_binding_mismatch")
    if not isinstance(value["authority_sha256"], str) or not re.fullmatch(r"[0-9a-f]{64}", value["authority_sha256"]):
        raise Blocker("browser_use_handoff_authority_binding_invalid")
    origin = normalize_origin(value["origin"])
    if not isinstance(value["profile_hash"], str) or not re.fullmatch(r"[0-9a-f]{64}", value["profile_hash"]):
        raise Blocker("browser_use_handoff_profile_binding_invalid")
    if not isinstance(value["profile_marker_sha256"], str) or not re.fullmatch(r"[0-9a-f]{64}", value["profile_marker_sha256"]):
        raise Blocker("browser_use_handoff_profile_marker_binding_invalid")
    try:
        port = int(value["port"])
    except (TypeError, ValueError) as exc:
        raise Blocker("browser_use_handoff_port_invalid") from exc
    ports = config["ports"]
    if lifecycle == "scheduled":
        port_start, port_end = ports["scheduled_start"], ports["scheduled_end"]
    elif lifecycle == "single-use":
        port_start, port_end = ports["single_use_start"], ports["single_use_end"]
    else:
        port_start, port_end = ports["temporary_start"], ports["temporary_end"]
    if not port_start <= port <= port_end:
        raise Blocker("browser_use_handoff_port_out_of_range")
    profile = value["profile"]
    # A recording bound to a login handoff intentionally points at the
    # handoff-owned profile. Validate that profile against the source
    # handoff's lifecycle, not the destination recording's lifecycle. The
    # start path rejects a mismatch before recording begins; this branch also
    # lets terminal cleanup close a previously started mismatched recording
    # without deleting the shared handoff profile.
    profile_lifecycle = lifecycle
    if value.get("source_handoff_descriptor"):
        source_path = os.path.realpath(str(value["source_handoff_descriptor"]))
        source_run_id = safe_id(value.get("source_run_id"), "run_id")
        source_session = validate_id(value.get("source_session"), "session")
        source = read_handoff(config, source_path, source_run_id, source_session, require_unexpired=False)
        profile_lifecycle = str(source.get("lifecycle", lifecycle))
    profile_root = os.path.realpath(config["roots"]["scheduled_profiles"] if profile_lifecycle == "scheduled" else config["roots"]["single_use_profiles"] if profile_lifecycle == "single-use" else config["roots"]["temporary_profiles"])
    if not isinstance(profile, str) or not os.path.isabs(profile) or os.path.realpath(profile) != profile or not profile.startswith(profile_root + os.sep):
        raise Blocker("browser_use_handoff_profile_scope_mismatch")
    if lifecycle == "scheduled" and os.path.realpath(profile) != os.path.join(profile_root, value["automation_id"]):
        raise Blocker("browser_use_handoff_scheduled_profile_binding_mismatch")
    if lifecycle == TEMPORARY_LIFECYCLE:
        expected = temporary_profile_path(config, value["creation_binding"])
        if os.path.realpath(profile) != expected:
            raise Blocker("browser_use_temporary_handoff_binding_mismatch")
        room_id = value.get("room_id")
        if room_id:
            room = room_registry_lookup(config, room_id)
            if room is None or room.get("profile") != os.path.realpath(profile) or int(room.get("port", -1)) != int(value["port"]):
                raise Blocker("browser_use_temporary_handoff_binding_mismatch")
        elif int(value["port"]) != temporary_port(config, value["creation_binding"]):
            raise Blocker("browser_use_temporary_handoff_binding_mismatch")
    download_dir = value["download_dir"]
    downloads_root = os.path.realpath(config["roots"]["downloads"])
    if not isinstance(download_dir, str) or not os.path.isabs(download_dir) or os.path.realpath(download_dir) != download_dir or not download_dir.startswith(downloads_root + os.sep):
        raise Blocker("browser_use_handoff_download_scope_mismatch")
    process = value["process"]
    if not isinstance(process, dict) or not isinstance(process.get("root_pid"), int) or not isinstance(process.get("root_start_time"), (int, float)):
        raise Blocker("browser_use_handoff_process_identity_invalid")
    if require_unexpired:
        expires = handoff_expiry(value)
        if expires.tzinfo is None or expires <= now_utc():
            raise Blocker("browser_use_handoff_expired")
    handoff_lock_paths(config, value)
    value["origin"] = origin
    value["port"] = port
    return value


def handoff_expiry(descriptor: dict[str, Any]) -> dt.datetime:
    try:
        expires = dt.datetime.fromisoformat(str(descriptor["expires_at"]).replace("Z", "+00:00"))
    except (KeyError, TypeError, ValueError) as exc:
        raise Blocker("browser_use_handoff_expiry_invalid") from exc
    if expires.tzinfo is None:
        raise Blocker("browser_use_handoff_expiry_invalid")
    return expires.astimezone(dt.timezone.utc)


def authority_for_handoff(path: str, run_id: str, session: str, descriptor: dict[str, Any], config: dict[str, Any] | None = None) -> dict[str, Any]:
    requested_session = descriptor.get("requested_session")
    # A same-session authority drift check must not be masked by an unrelated
    # missing global config.  Only load config when a requested/effective
    # session alias is actually needed.
    aliases = []
    if isinstance(requested_session, str) and requested_session != session:
        config = config or read_toml()
        aliases = session_aliases(config, requested_session, session)
    authority = parse_authority(path, run_id, session, aliases=aliases)
    digest = sha256_file(path)
    if digest != descriptor["authority_sha256"]:
        raise Blocker("browser_use_handoff_authority_changed")
    if descriptor["origin"] not in {normalize_origin(item) for item in authority["allowed_origins"]}:
        raise Blocker("browser_use_handoff_origin_not_authorized")
    return authority


def validate_handoff_resources(config: dict[str, Any], descriptor: dict[str, Any]) -> None:
    profile = descriptor["profile"]
    assert_directory(profile)
    marker = os.path.join(profile, ".browser-use-profile.json")
    assert_regular_file(marker, mode=0o600)
    if sha256_file(marker) != descriptor["profile_marker_sha256"]:
        raise Blocker("browser_use_handoff_profile_marker_changed")
    marker_value = read_json_safe(marker)
    lifecycle = str(descriptor.get("lifecycle", "single-use"))
    if lifecycle == TEMPORARY_LIFECYCLE:
        expected = {
            "mode": "authorized",
            "lifecycle": TEMPORARY_LIFECYCLE,
            "automation_id": descriptor["automation_id"],
            "task_id": descriptor["task_id"],
            "run_id": descriptor["run_id"],
            "creation_binding": descriptor["creation_binding"],
            "canonical_profile": os.path.realpath(profile),
            "port": descriptor["port"],
            "authority_sha256": descriptor["authority_sha256"],
            "authority_scope": descriptor["authority_scope"],
            "account_identity": descriptor["account_identity"],
            "origins": sorted(descriptor.get("origins") or [descriptor["origin"]]),
        }
        marker_value = validate_temporary_marker(config, profile, expected)
        if profile_hash(profile, descriptor["nonce"]) != descriptor["profile_hash"]:
            raise Blocker("browser_use_handoff_profile_hash_mismatch")
        assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
        return
    expected_run_id = "persistent" if lifecycle == "scheduled" else descriptor["run_id"]
    expected_nonce = "persistent" if lifecycle == "scheduled" else descriptor["nonce"]
    if marker_value.get("schema") != "browser-use-profile.v1" or marker_value.get("run_id") != expected_run_id or marker_value.get("nonce") != expected_nonce or marker_value.get("automation_id") != descriptor["automation_id"]:
        raise Blocker("browser_use_handoff_profile_marker_binding_mismatch")
    if profile_hash(profile, descriptor["nonce"]) != descriptor["profile_hash"]:
        raise Blocker("browser_use_handoff_profile_hash_mismatch")
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])


def validate_handoff_process_identity(config: dict[str, Any], descriptor: dict[str, Any], *, allow_missing: bool) -> bool:
    profile = descriptor["profile"]
    chrome_path = config["executables"]["chrome"]["canonical_path"]
    try:
        process = psutil.Process(descriptor["process"]["root_pid"])
        if abs(process.create_time() - descriptor["process"]["root_start_time"]) > 0.5 or not process_matches(process, chrome_path, descriptor["port"], profile):
            raise Blocker("browser_use_handoff_chrome_identity_drift")
    except psutil.NoSuchProcess as exc:
        if allow_missing:
            assert_debug_listener_absent(descriptor["port"])
            return False
        raise Blocker("browser_use_handoff_chrome_missing") from exc
    except psutil.Error as exc:
        raise Blocker("browser_use_handoff_process_identity_recheck_failed") from exc
    if not port_listener(descriptor["port"]) or not lsof_listener(descriptor["port"]):
        raise Blocker("browser_use_handoff_listener_missing")
    return True


def validate_handoff_identity(config: dict[str, Any], descriptor: dict[str, Any]) -> None:
    validate_handoff_resources(config, descriptor)
    validate_handoff_process_identity(config, descriptor, allow_missing=False)


def assert_handoff_keep_alive(config: dict[str, Any], process_identity: dict[str, Any], port: int, profile: str) -> None:
    """Require the headed Chrome handoff to survive the Browser Use readback."""
    validate_handoff_process_identity(
        config,
        {"process": process_identity, "port": port, "profile": profile},
        allow_missing=False,
    )


def consume_handoff(config: dict[str, Any], path: str, run_id: str, session: str) -> str:
    requested = os.path.realpath(path)
    path = _handoff_base_path(requested)
    consumed = path + HANDOFF_CONSUMED_SUFFIX
    abandoned = path + HANDOFF_CLAIM_SUFFIX
    # A caller that retries with a claimed/consumed path is a replay loser, not
    # a new lease.  Normalize all handoff aliases before checking the claim.
    if requested != path or os.path.lexists(consumed) or os.path.lexists(abandoned):
        raise Blocker("browser_use_handoff_replay_rejected")
    try:
        # A hard link is a same-filesystem, no-replace claim.  The destination
        # cannot overwrite a concurrent claimant.
        os.link(path, consumed)
    except FileExistsError as exc:
        raise Blocker("browser_use_handoff_replay_rejected") from exc
    except FileNotFoundError as exc:
        if os.path.lexists(consumed) or os.path.lexists(abandoned):
            raise Blocker("browser_use_handoff_replay_rejected") from exc
        raise Blocker("browser_use_handoff_missing") from exc

    try:
        # Never read the source after the claim.  If this process crashes before
        # unlinking the source, the claimed descriptor remains the sole usable
        # lease and future consumers are rejected by the destination check.
        descriptor = read_handoff(config, consumed, run_id, session, require_unexpired=False)
        if descriptor["status"] != "active":
            raise Blocker("browser_use_handoff_replay_rejected")
        descriptor["status"] = "claimed"
        descriptor["lease_path"] = os.path.realpath(consumed)
        update_handoff(consumed, descriptor)
        os.unlink(path)
    except (Blocker, OSError, ValueError, json.JSONDecodeError):
        # Keep both files on any post-claim uncertainty.  In particular, do not
        # restore/replace the source and do not allow a second consumer.
        raise
    return consumed


def update_handoff(path: str, descriptor: dict[str, Any]) -> None:
    json_atomic_replace(path, descriptor)


def launch_handoff_watchdog(config: dict[str, Any], descriptor_path: str, run_id: str, session: str) -> int:
    helper_path = os.path.realpath(__file__)
    assert_regular_file(helper_path, mode=0o700)
    assert_handoff_path(descriptor_path, handoff_root(config))
    try:
        process = subprocess.Popen(
            [sys.executable, helper_path, "handoff-watchdog", "--run-id", run_id, "--session", session, "--descriptor", descriptor_path],
            cwd=config["roots"]["browser_use_home"],
            env=make_env(config["roots"]["browser_use_home"]),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            start_new_session=True,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise Blocker("browser_use_handoff_watchdog_start_failed") from exc
    return process.pid


def make_env(home: str, recording: dict[str, Any] | None = None) -> dict[str, str]:
    env = dict(os.environ)
    for key in list(env):
        upper = key.upper()
        if key in {"PYTHONPATH", "PYTHONHOME", "BROWSER_USE_API_KEY", "OPENAI_API_KEY", "ANTHROPIC_API_KEY"}:
            env.pop(key, None)
        elif any(fragment in upper for fragment in ("PASSWORD", "SECRET", "TOKEN", "API_KEY", "COOKIE")):
            env.pop(key, None)
    env["BROWSER_USE_HOME"] = home
    if recording is not None:
        env["PYTHONPATH"] = os.pathsep.join((recording["runtime_dir"], recording["dependencies_dir"], recording["site_packages_dir"]))
        env["BROWSER_USE_RECORD_VIDEO_DIR"] = recording["recording_dir"]
        env["BROWSER_USE_RECORD_VIDEO_FRAMERATE"] = str(recording["framerate"])
        env["BROWSER_USE_RECORDING_STATUS_PATH"] = recording["status_path"]
        if recording.get("tab_inventory_path"):
            env["BH_RECORDING_TAB_INVENTORY_PATH"] = recording["tab_inventory_path"]
    return env


def browser_harness_cli_enabled() -> bool:
    """Require the pinned Browser Use/Harness CLI; never use the legacy CLI."""
    try:
        raw = importlib.metadata.version("browser-use")
    except importlib.metadata.PackageNotFoundError as exc:
        raise Blocker("browser_use_pinned_package_missing") from exc
    if raw != PINNED_BROWSER_USE_VERSION:
        raise Blocker("browser_use_legacy_or_unpinned_version_rejected", raw)
    return True


def browser_harness_root(session: str) -> str:
    """Use a short, per-session private root so Harness sockets stay bounded."""
    digest = hashlib.sha256(session.encode("utf-8")).hexdigest()[:16]
    return os.path.join("/tmp", f"codex-browser-use-{digest}")


def browser_harness_env(home: str, port: int, session: str, recording: dict[str, Any] | None = None) -> dict[str, str]:
    """Build an isolated CLI 3.0 environment without inheriting credentials."""
    root = browser_harness_root(session)
    env = make_env(home, recording)
    env.update(
        {
            "BU_NAME": session,
            "BU_CDP_URL": f"http://127.0.0.1:{port}",
            "BH_HOME": os.path.join(root, "home"),
            "BH_RUNTIME_DIR": os.path.join(root, "runtime"),
            "BH_TMP_DIR": os.path.join(root, "tmp"),
            "BH_AGENT_WORKSPACE": recording.get("harness_workspace", os.path.join(root, "workspace")) if recording else os.path.join(root, "workspace"),
            "BH_RECORD": "1" if recording else "0",
            "BH_TELEMETRY": "0",
        }
    )
    env.pop("BU_CDP_WS", None)
    return env


_BROWSER_HARNESS_STATE_JS = r"""(()=>{
  const nodes = Array.from(document.querySelectorAll('body *')).slice(0, 1000);
  const esc = (value) => String(value ?? '').replace(/[\\\n\r]/g, ' ').replace(/[<>]/g, '');
  const depth = (element) => {
    let current = element, count = 0;
    while (current && current.parentElement && current.parentElement !== document.body) {
      count += 1; current = current.parentElement;
    }
    return Math.min(count, 20);
  };
  return nodes.map((element, index) => {
    const attrs = Array.from(element.attributes || [])
      .filter((attr) => ['id', 'class', 'role', 'type', 'tabindex', 'href', 'aria-label', 'name'].includes(attr.name))
      .map((attr) => `${attr.name}=\"${esc(attr.value)}\"`).join(' ');
    const ownText = element.children.length ? '' : (element.innerText || element.value || '').trim().replace(/\\s+/g, ' ').slice(0, 300);
    return `${' '.repeat(depth(element) * 2)}[${index}]<${element.tagName.toLowerCase()}${attrs ? ` ${attrs}` : ''}>${ownText ? ` ${esc(ownText)}` : ''}`;
  }).join('\n');
})()"""


_BROWSER_HARNESS_TAB_GUARD = r'''
from browser_harness.helpers import (
    cdp, current_tab, goto_url, list_tabs, switch_tab, ensure_real_tab,
    page_info, js, wait, wait_for_load, new_tab, close_tab, type_text,
    press_key, capture_screenshot, scroll, click_at_xy,
)
from urllib.parse import urlparse

_TAB_INVENTORY_SCHEMA = "browser-use-recording-tabs.v1"
_TAB_INVENTORY_MAX_AUXILIARY = 16
_TAB_INVENTORY_WORKING_COMMANDS = {
    "open", "state", "get", "extract", "eval", "screenshot", "upload",
    "click", "dblclick", "rightclick", "type", "input", "keys", "scroll",
    "back", "wait", "hover", "ax-inspect", "ax-click",
}

def _tab_inventory_path():
    return os.environ.get("BH_RECORDING_TAB_INVENTORY_PATH")

def _tab_metadata(tab, role):
    target_id = str(tab.get("targetId") or tab.get("target_id") or "")
    url = str(tab.get("url") or "")
    title = str(tab.get("title") or "")
    return {
        "target_id": target_id,
        "role": role,
        "url_length": len(url),
        "url_sha256": hashlib.sha256(url.encode("utf-8")).hexdigest(),
        "title_length": len(title),
        "title_sha256": hashlib.sha256(title.encode("utf-8")).hexdigest(),
    }

def _tab_id(tab):
    return str(tab.get("targetId") or tab.get("target_id") or "")

def _target_infos():
    result = cdp("Target.getTargets")
    return {
        str(info.get("targetId")): info
        for info in result.get("targetInfos", [])
        if info.get("type") == "page" and info.get("targetId")
    }

def _select_new_working_tab(value, tabs, new_ids):
    """Follow the tab actually opened by the command's current interaction."""
    if not new_ids:
        return value
    source_id = str(value.get("command_target_id") or value.get("active_target_id") or "")
    attached_id = _current_target_id()
    infos = _target_infos()
    candidates = []
    for position, tab in enumerate(tabs):
        target_id = _tab_id(tab)
        if target_id not in new_ids:
            continue
        info = infos.get(target_id, {})
        opener_id = str(info.get("openerId") or "")
        # A daemon/session handoff is the strongest signal, followed by the
        # opener relationship. Only then use a single newly-created page.
        # A new tab is eligible for automatic promotion only when the browser
        # proves it was opened by the current run command.  An attached/active
        # tab alone is not enough: it may be a user or foreign tab.
        opened_by_command = bool(source_id) and opener_id == source_id
        signal = 3 if target_id == attached_id and opened_by_command else 2 if opened_by_command else 0
        candidates.append((signal, position, target_id))
    if not candidates:
        return value
    strongest = max(signal for signal, _, _ in candidates)
    if strongest == 0 and len(candidates) != 1:
        return value
    _, _, target_id = max(candidates)
    previous_working_id = str(value.get("working_target_id") or "")
    baseline_ids = set(value.get("baseline_target_ids", []))

    # A page can legitimately open its next work surface in a new target even
    # though the command was issued against the current working tab.  Merely
    # changing active_target_id leaves screenshots/readbacks bound to the old
    # tab on the next command.  Promote the strongly identified new target to
    # working and demote only the former run-owned working tab to auxiliary.
    # Baseline/user tabs are never reclassified or closed here.
    value["working_target_id"] = target_id
    value["active_target_id"] = target_id
    auxiliary = set(value.get("auxiliary_target_ids", []))
    auxiliary.discard(target_id)
    if previous_working_id and previous_working_id != target_id and previous_working_id not in baseline_ids:
        auxiliary.add(previous_working_id)
    value["auxiliary_target_ids"] = sorted(auxiliary)
    for tab in value.get("tabs", []):
        tab_id = str(tab.get("target_id") or "")
        if tab_id == target_id:
            tab["role"] = "working"
        elif tab_id == previous_working_id and tab.get("role") == "working":
            tab["role"] = "auxiliary"
    return value

def _current_target_id():
    return _tab_id(current_tab())

def _write_tab_inventory(value):
    path = _tab_inventory_path()
    if not path:
        return value
    parent = os.path.dirname(path)
    os.makedirs(parent, mode=0o700, exist_ok=True)
    temp = f"{path}.{os.getpid()}.tmp"
    with open(temp, "w", encoding="utf-8") as handle:
        json.dump(value, handle, sort_keys=True, separators=(",", ":"))
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temp, 0o600)
    os.replace(temp, path)
    return value

def _read_tab_inventory():
    path = _tab_inventory_path()
    if not path:
        return None
    try:
        with open(path, "r", encoding="utf-8") as handle:
            value = json.load(handle)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        raise RuntimeError("browser_use_recording_tab_inventory_invalid") from exc
    if not isinstance(value, dict) or value.get("schema") != _TAB_INVENTORY_SCHEMA:
        raise RuntimeError("browser_use_recording_tab_inventory_invalid")
    return value

def _tab_inventory_by_id(value):
    return {str(tab.get("target_id")): tab for tab in value.get("tabs", []) if isinstance(tab, dict)}

def _tab_snapshot(value, tabs):
    known = _tab_inventory_by_id(value)
    current_ids = {_tab_id(tab) for tab in tabs}
    if value.get("working_target_id") not in current_ids:
        raise RuntimeError("browser_use_recording_working_tab_missing")
    active_target_id = str(value.get("active_target_id") or value["working_target_id"])
    if active_target_id not in current_ids:
        if active_target_id != value["working_target_id"]:
            active_target_id = value["working_target_id"]
        else:
            raise RuntimeError("browser_use_recording_working_tab_missing")
    # After a command promotes a newly opened run-owned tab, subsequent
    # background readbacks must follow that working tab even if an older
    # auxiliary tab was the last persisted active target.  Keep this
    # background-only; do not activate Chrome or take keyboard focus.
    if known.get(active_target_id, {}).get("role") == "auxiliary":
        active_target_id = value["working_target_id"]
    # The OS-visible tab may be a user/baseline tab while the run-owned tab
    # remains in the background. Never route a recording command or a
    # screenshot to that foreign tab.
    if known.get(active_target_id, {}).get("role") == "baseline":
        active_target_id = value["working_target_id"]
    value["active_target_id"] = active_target_id
    command_target_id = str(value.get("command_target_id") or "")
    if known.get(command_target_id, {}).get("role") == "baseline":
        value["command_target_id"] = None
    new_ids = current_ids - set(known)
    if new_ids:
        # Reconcile a tab opened by the immediately preceding run command only
        # when every new target has an explicit opener relationship to that
        # command's target.  Otherwise preserve the fail-closed foreign-tab
        # guard and require a fresh run/handoff.
        if len(set(value.get("auxiliary_target_ids", [])) | new_ids) > _TAB_INVENTORY_MAX_AUXILIARY:
            raise RuntimeError("browser_use_recording_auxiliary_tab_limit_exceeded")
        source_id = str(value.get("command_target_id") or value.get("active_target_id") or "")
        infos = _target_infos()
        if not source_id or any(str(infos.get(target_id, {}).get("openerId") or "") != source_id for target_id in new_ids):
            raise RuntimeError("browser_use_recording_untracked_tab_increase")
        for target_id in sorted(new_ids):
            tab = next((item for item in tabs if _tab_id(item) == target_id), None)
            if tab is None:
                raise RuntimeError("browser_use_recording_untracked_tab_increase")
            value.setdefault("tabs", []).append(_tab_metadata(tab, "auxiliary"))
            value.setdefault("auxiliary_target_ids", []).append(target_id)
        value = _select_new_working_tab(value, tabs, new_ids)
        known = _tab_inventory_by_id(value)
        # Re-read the promoted target after reconciliation.  The initial
        # active_target_id may still point at the former working tab because
        # it was computed before the opener-bound promotion above.
        active_target_id = str(value.get("active_target_id") or value["working_target_id"])
        if active_target_id not in current_ids or known.get(active_target_id, {}).get("role") == "baseline":
            active_target_id = value["working_target_id"]
    return {
        "schema": _TAB_INVENTORY_SCHEMA,
        "working_target_id": value["working_target_id"],
        "active_target_id": active_target_id,
        "command_target_id": value.get("command_target_id"),
        "baseline_target_ids": list(value.get("baseline_target_ids", [])),
        "auxiliary_target_ids": list(value.get("auxiliary_target_ids", [])),
        "tabs": [_tab_metadata(tab, known[_tab_id(tab)]["role"]) for tab in tabs],
        "updated_at": round(time.time(), 3),
    }

def _initialize_tab_inventory():
    if not _tab_inventory_path():
        return None
    tabs = list_tabs(include_chrome=True)
    if not tabs:
        raise RuntimeError("browser_use_recording_working_tab_missing")
    working = ensure_real_tab()
    if not working:
        working = current_tab()
    working_id = _tab_id(working)
    if not working_id or working_id not in {_tab_id(tab) for tab in tabs}:
        raise RuntimeError("browser_use_recording_working_tab_missing")
    value = {
        "schema": _TAB_INVENTORY_SCHEMA,
        "working_target_id": working_id,
        "active_target_id": working_id,
        "command_target_id": None,
        "baseline_target_ids": [
            _tab_id(tab) for tab in tabs if _tab_id(tab) != working_id
        ],
        "auxiliary_target_ids": [],
        "tabs": [
            _tab_metadata(tab, "working" if _tab_id(tab) == working_id else "baseline")
            for tab in tabs
        ],
        "updated_at": round(time.time(), 3),
    }
    return _write_tab_inventory(value)

def _prepare_recording_command(name, command):
    value = _read_tab_inventory()
    if value is None:
        return None
    tabs = list_tabs(include_chrome=True)
    value = _tab_snapshot(value, tabs)
    by_id = _tab_inventory_by_id(value)
    if name == "switch":
        if len(command) < 2 or str(command[1]) not in by_id:
            raise RuntimeError("browser_use_recording_switch_tab_untracked")
        if str(command[1]) not in {_tab_id(tab) for tab in tabs}:
            raise RuntimeError("browser_use_recording_switch_tab_missing")
        if by_id[str(command[1])].get("role") == "baseline":
            raise RuntimeError("browser_use_recording_foreign_tab_switch_rejected")
        value["active_target_id"] = str(command[1])
    elif name == "close-tab":
        target_id = str(command[1]) if len(command) > 1 and command[1] else _current_target_id()
        role = by_id.get(target_id, {}).get("role")
        if role == "baseline":
            raise RuntimeError("browser_use_recording_foreign_tab_close_rejected")
        if target_id == value["working_target_id"]:
            raise RuntimeError("browser_use_recording_working_tab_close_rejected")
        if target_id == value.get("active_target_id"):
            value["active_target_id"] = value["working_target_id"]
    elif name in _TAB_INVENTORY_WORKING_COMMANDS:
        target_id = value["working_target_id"] if name == "open" else str(value.get("active_target_id") or value["working_target_id"])
        value["command_target_id"] = target_id
        # Bind every command to the target's CDP session without activating
        # the tab.  `switch_tab()` calls Target.activateTarget, which brings
        # Chrome to the foreground on macOS and can steal the user's
        # keyboard focus.  Input.dispatch* and Page.navigate work against an
        # attached background target session, so foreground activation is not
        # required for recording commands.  An explicit `switch` command
        # remains the only operation that intentionally changes tab focus.
        attach_recording_target(target_id, activate=False)
    return _write_tab_inventory(value)

def _finish_recording_command():
    value = _read_tab_inventory()
    if value is None:
        return None
    tabs = list_tabs(include_chrome=True)
    known = _tab_inventory_by_id(value)
    current_ids = {_tab_id(tab) for tab in tabs}
    if value.get("working_target_id") not in current_ids:
        raise RuntimeError("browser_use_recording_working_tab_missing")
    active_target_id = str(value.get("active_target_id") or value["working_target_id"])
    if active_target_id not in current_ids:
        active_target_id = value["working_target_id"]
    if known.get(active_target_id, {}).get("role") == "baseline":
        active_target_id = value["working_target_id"]
    new_ids = current_ids - set(known)
    auxiliary = list(value.get("auxiliary_target_ids", []))
    if len(set(auxiliary) | new_ids) > _TAB_INVENTORY_MAX_AUXILIARY:
        raise RuntimeError("browser_use_recording_auxiliary_tab_limit_exceeded")
    for target_id in sorted(new_ids):
        auxiliary.append(target_id)
        known[target_id] = {"role": "auxiliary"}
    value = {
        "schema": _TAB_INVENTORY_SCHEMA,
        "working_target_id": value["working_target_id"],
        "active_target_id": active_target_id,
        "command_target_id": value.get("command_target_id"),
        "baseline_target_ids": list(value.get("baseline_target_ids", [])),
        "auxiliary_target_ids": sorted(set(auxiliary)),
        "tabs": [_tab_metadata(tab, known[_tab_id(tab)]["role"]) for tab in tabs],
        "updated_at": round(time.time(), 3),
    }
    value = _select_new_working_tab(value, tabs, new_ids)
    value["command_target_id"] = None
    return _write_tab_inventory(value)
'''


def browser_harness_script(command: list[str]) -> str:
    """Translate the helper's bounded command vocabulary to Harness helpers."""
    command_literal = json.dumps(command, ensure_ascii=True)
    state_expression = json.dumps(_BROWSER_HARNESS_STATE_JS, ensure_ascii=True)
    return f'''import hashlib, json, os, time
from browser_harness import helpers as _browser_helpers
from browser_harness.recorder import recording_dir, start_recording, stop_recording
{_BROWSER_HARNESS_TAB_GUARD}

cmd = {command_literal}
name = cmd[0]

def emit(value):
    if _tab_inventory_path() and name not in {{"record-start", "record-stop"}}:
        inventory = _finish_recording_command()
        if isinstance(value, dict) and isinstance(value.get("data"), dict):
            value["data"]["tab_inventory"] = inventory
    print(json.dumps(value, ensure_ascii=True, separators=(",", ":")))

def info():
    return page_info()

def state_text():
    return js({state_expression})

def element_bbox(index):
    return js("(()=>{{const e=Array.from(document.querySelectorAll('body *'))[%d];if(!e)return null;const r=e.getBoundingClientRect();return {{x:r.x,y:r.y,width:r.width,height:r.height}};}})()" % int(index))

def attach_recording_target(target_id, activate=False):
    """Bind the daemon to the run target without stealing the OS focus.

    Read-only checkpoints (especially screenshots) must be safe while the
    user is working in another tab or application. Target.activateTarget is
    intentionally reserved for commands that actually interact with the
    target; screenshots and readbacks can attach to a background target.
    """
    target_id = str(target_id)
    if activate:
        switch_tab(target_id)
        return
    # Every Browser Harness CLI invocation may inherit a daemon whose target
    # id is unchanged but whose CDP session is stale.  Do not trust the
    # daemon's current_tab/session pair; verify the target still exists and
    # create a fresh background attachment for every command.  This keeps the
    # working tab in the background and therefore does not steal keyboard
    # focus from the user.
    tabs = list_tabs(include_chrome=True)
    known_ids = {{
        str(tab.get("targetId") or tab.get("target_id") or "")
        for tab in tabs
    }}
    if target_id not in known_ids:
        raise RuntimeError("browser_use_recording_working_tab_missing")
    attached = cdp("Target.attachToTarget", targetId=target_id, flatten=True)
    session_id = attached.get("sessionId")
    if not session_id:
        raise RuntimeError("browser_use_recording_background_attach_failed")
    _browser_helpers._send({{"meta": "set_session", "session_id": session_id, "target_id": target_id}})

if name == "record-start":
    expected = cmd[2]
    actual = start_recording(cmd[1], title=cmd[3] if len(cmd) > 3 else None)
    if os.path.realpath(actual) != os.path.realpath(expected):
        raise RuntimeError("recording path mismatch")
    inventory = _initialize_tab_inventory()
    emit({{"success": True, "data": {{"recording_dir": actual, "recording_active": True, "page": info(), "tab_inventory": inventory}}}})
elif name == "record-stop":
    expected = cmd[1]
    # Stopping the recorder is independent of page/session readback.  If a
    # target session is stale, cleanup must still be able to flush the MP4
    # and remove the active marker instead of failing before stop_recording.
    actual = stop_recording()
    if not actual or os.path.realpath(actual) != os.path.realpath(expected):
        raise RuntimeError("recording stop path mismatch")
    emit({{"success": True, "data": {{"recording_dir": actual, "recording_active": False}}}})
elif name == "open":
    _prepare_recording_command(name, cmd)
    if _tab_inventory_path():
        goto_url(cmd[1])
    else:
        new_tab(cmd[1])
    wait_for_load(15)
    emit({{"success": True, "data": info()}})
elif name == "state":
    _prepare_recording_command(name, cmd)
    current = info()
    emit({{"success": True, "data": {{"url": current.get("url", ""), "title": current.get("title", ""), "state": state_text()}}}})
elif name == "get":
    _prepare_recording_command(name, cmd)
    current = info()
    if len(cmd) >= 2 and cmd[1] == "title":
        emit({{"success": True, "data": {{"title": current.get("title", "")}}}})
    elif len(cmd) >= 2 and cmd[1] == "url":
        emit({{"success": True, "data": {{"url": current.get("url", "")}}}})
    elif len(cmd) >= 3 and cmd[1] == "attributes":
        index = int(cmd[2])
        attrs = js("(()=>{{const e=Array.from(document.querySelectorAll('body *'))[%d];if(!e)return null;return Object.fromEntries(Array.from(e.attributes).map(a=>[a.name,a.value]));}})()" % index)
        emit({{"success": True, "data": {{"index": index, "attributes": attrs or {{}}}}}})
    elif len(cmd) >= 3 and cmd[1] == "bbox":
        index = int(cmd[2])
        emit({{"success": True, "data": {{"index": index, "bbox": element_bbox(index)}}}})
    else:
        raise RuntimeError("unsupported get field")
elif name == "extract":
    _prepare_recording_command(name, cmd)
    emit({{"success": True, "data": {{"text": js("document.body.innerText")}}}})
elif name == "eval":
    _prepare_recording_command(name, cmd)
    emit({{"success": True, "data": {{"result": js(cmd[1])}}}})
elif name == "screenshot":
    _prepare_recording_command(name, cmd)
    emit({{"success": True, "data": {{"path": capture_screenshot(cmd[1])}}}})
elif name == "upload":
    _prepare_recording_command(name, cmd)
    # Upload is authorized-only and preflight-validated by the parent helper.
    # Resolve the file input from the current DOM at execution time; callers
    # must not persist an element index across state changes.
    if len(cmd) == 2:
        input_index = 0
        file_path = cmd[1]
    elif len(cmd) == 3 and str(cmd[1]).isdigit():
        input_index = int(cmd[1])
        file_path = cmd[2]
    else:
        raise RuntimeError("upload requires <path> or <file-input-index> <path>")
    document = cdp("DOM.getDocument", depth=-1)
    root_node = (document.get("root") or {{}}).get("nodeId")
    if root_node is None:
        raise RuntimeError("upload_document_root_missing")
    file_nodes = cdp("DOM.querySelectorAll", nodeId=int(root_node), selector="input[type=file]").get("nodeIds", [])
    if input_index < 0 or input_index >= len(file_nodes):
        raise RuntimeError("upload_file_input_not_found")
    cdp("DOM.setFileInputFiles", nodeId=int(file_nodes[input_index]), files=[file_path])
    emit({{"success": True, "data": {{"input_index": input_index, "file_attached": True}}}})
elif name == "click":
    _prepare_recording_command(name, cmd)
    if len(cmd) == 2:
        bbox = element_bbox(int(cmd[1]))
        if not bbox or bbox["width"] <= 0 or bbox["height"] <= 0:
            raise RuntimeError("element has no visible bounding box")
        click_at_xy(bbox["x"] + bbox["width"] / 2, bbox["y"] + bbox["height"] / 2)
    else:
        click_at_xy(float(cmd[1]), float(cmd[2]))
    emit({{"success": True, "data": {{}}}})
elif name in {{"dblclick", "rightclick"}}:
    _prepare_recording_command(name, cmd)
    button = "right" if name == "rightclick" else "left"
    click_at_xy(float(cmd[1]), float(cmd[2]), button=button, clicks=2 if name == "dblclick" else 1)
    emit({{"success": True, "data": {{}}}})
elif name in {{"type", "input"}}:
    _prepare_recording_command(name, cmd)
    type_text(cmd[-1])
    emit({{"success": True, "data": {{}}}})
elif name == "keys":
    _prepare_recording_command(name, cmd)
    for key in cmd[1:]:
        press_key(key)
    emit({{"success": True, "data": {{}}}})
elif name == "scroll":
    _prepare_recording_command(name, cmd)
    if len(cmd) == 2:
        scroll(0, 0, dy=float(cmd[1]))
    elif len(cmd) >= 3:
        scroll(float(cmd[1]), float(cmd[2]), dy=float(cmd[3]) if len(cmd) > 3 else -300, dx=float(cmd[4]) if len(cmd) > 4 else 0)
    emit({{"success": True, "data": {{}}}})
elif name == "back":
    _prepare_recording_command(name, cmd)
    cdp("Page.goBack")
    wait_for_load(15)
    emit({{"success": True, "data": {{}}}})
elif name == "wait":
    _prepare_recording_command(name, cmd)
    wait(float(cmd[1]) if len(cmd) > 1 else 1.0)
    emit({{"success": True, "data": {{}}}})
elif name == "switch":
    _prepare_recording_command(name, cmd)
    switch_tab(cmd[1])
    emit({{"success": True, "data": {{}}}})
elif name == "close-tab":
    _prepare_recording_command(name, cmd)
    close_tab(cmd[1] if len(cmd) > 1 else None)
    emit({{"success": True, "data": {{}}}})
elif name == "hover":
    _prepare_recording_command(name, cmd)
    cdp("Input.dispatchMouseEvent", type="mouseMoved", x=float(cmd[1]), y=float(cmd[2]))
    emit({{"success": True, "data": {{}}}})
else:
    raise RuntimeError(f"unsupported Browser Harness command: {{name}}")
'''


def browser_harness_ax_script(command: list[str]) -> str:
    """Build a fresh AX Tree target resolver for Browser Harness 0.13.7."""
    command_literal = json.dumps(command, ensure_ascii=True)
    target_literal = json.dumps(command[1] if len(command) > 1 else "", ensure_ascii=True)
    return """import hashlib, json, os, time
import re
from browser_harness import helpers as _browser_helpers
from browser_harness.recorder import recording_dir
__TAB_GUARD__

cmd = __COMMAND_LITERAL__
name = cmd[0]
target = cmd[1] if len(cmd) > 1 else ""

def emit(value):
    if _tab_inventory_path():
        inventory = _finish_recording_command()
        if isinstance(value, dict) and isinstance(value.get("data"), dict):
            value["data"]["tab_inventory"] = inventory
    print(json.dumps(value, ensure_ascii=True, separators=(",", ":")))

def text_value(value):
    if isinstance(value, dict):
        return str(value.get("value", ""))
    return str(value or "")

def normalized(value):
    return " ".join(str(value).split()).casefold()

def page_summary():
    current = page_info()
    url = str(current.get("url", ""))
    title = str(current.get("title", ""))
    return {
        "url_length": len(url),
        "url_sha256": hashlib.sha256(url.encode("utf-8")).hexdigest(),
        "title_length": len(title),
        "title_sha256": hashlib.sha256(title.encode("utf-8")).hexdigest(),
    }

def attach_recording_target(target_id, activate=False):
    # AX inspection must use the same fresh background attachment as normal
    # recording commands, without activating Chrome or stealing keyboard focus.
    target_id = str(target_id)
    if activate:
        switch_tab(target_id)
        return
    tabs = list_tabs(include_chrome=True)
    known_ids = {
        str(tab.get("targetId") or tab.get("target_id") or "")
        for tab in tabs
    }
    if target_id not in known_ids:
        raise RuntimeError("browser_use_recording_working_tab_missing")
    attached = cdp("Target.attachToTarget", targetId=target_id, flatten=True)
    session_id = attached.get("sessionId")
    if not session_id:
        raise RuntimeError("browser_use_recording_background_attach_failed")
    _browser_helpers._send({"meta": "set_session", "session_id": session_id, "target_id": target_id})

def resolve_state_target():
    candidate = _browser_helpers.js('''(()=>{
      const normalize = value => String(value ?? '').trim().toLocaleLowerCase().split(' ').filter(Boolean).join(' ');
      const targetNorm = normalize(__TARGET_LITERAL__);
      const interactiveTags = new Set(['a','button','input','select','textarea','summary']);
      const interactiveRoles = new Set(['button','checkbox','combobox','link','menuitem','option','radio','searchbox','slider','spinbutton','switch','tab','textbox','listbox','treeitem','gridcell']);
      const matches = Array.from(document.querySelectorAll('body *')).slice(0, 1000).map((element, index) => {
        const text = String(element.innerText || element.textContent || element.value || '').trim();
        const normalizedText = normalize(text);
        if (!targetNorm || !normalizedText.includes(targetNorm)) return null;
        const rect = element.getBoundingClientRect();
        if (!(rect.width > 0 && rect.height > 0)) return null;
        const tag = element.tagName.toLocaleLowerCase();
        const role = String(element.getAttribute('role') || '').toLocaleLowerCase();
        const attributes = {};
        for (const name of ['role','tabindex','aria-label','data-testid']) {
          const value = element.getAttribute(name);
          if (value !== null) attributes[name] = String(value);
        }
        const hasInlineHandler = ['onclick','onmousedown','onpointerdown'].some(name =>
          element.getAttribute(name) !== null || typeof element[name] === 'function'
        );
        return {
          index, tag, text_length: text.length,
          interactive: interactiveTags.has(tag) || interactiveRoles.has(role) || hasInlineHandler || ((attributes.tabindex ?? '').trim() !== '' && Number(attributes.tabindex) >= 0),
          hasInlineHandler,
          attributes,
          bbox: {x: rect.x, y: rect.y, width: rect.width, height: rect.height},
          exact_name: normalizedText === targetNorm,
        };
      }).filter(Boolean).sort((left, right) =>
        Number(right.exact_name) - Number(left.exact_name) ||
        Number(right.interactive) - Number(left.interactive) ||
        left.text_length - right.text_length || left.index - right.index
      );
      return matches[0] || null;
    })()''')
    if not isinstance(candidate, dict):
        raise RuntimeError("ax_target_not_found")
    candidate = dict(candidate)
    candidate.pop("exact_name", None)
    candidate["match_text_sha256"] = hashlib.sha256(str(target).encode("utf-8")).hexdigest()
    return candidate

def resolve_target():
    target_norm = normalized(target)
    if not target_norm:
        raise RuntimeError("ax_target_text_missing")
    interactive_roles = {
        "button", "checkbox", "combobox", "link", "menuitem", "option",
        "radio", "searchbox", "slider", "spinbutton", "switch", "tab",
        "textbox", "listbox", "treeitem", "gridcell"
    }
    matches = []
    try:
        nodes = cdp("Accessibility.getFullAXTree").get("nodes", [])
    except Exception:
        # Some pages or daemon sessions do not expose the Accessibility
        # domain.  The state resolver below is the safe fallback and keeps
        # target inspection usable without foreground activation.
        nodes = []
    for node in nodes:
        if node.get("ignored"):
            continue
        role = text_value(node.get("role"))
        accessible_name = text_value(node.get("name"))
        name_norm = normalized(accessible_name)
        if not accessible_name or target_norm not in name_norm:
            continue
        backend = node.get("backendDOMNodeId")
        if backend is None:
            continue
        try:
            model = cdp("DOM.getBoxModel", backendNodeId=int(backend)).get("model", {})
        except Exception:
            continue
        content = model.get("content") or []
        if len(content) < 8:
            continue
        try:
            xs = [float(value) for value in content[0::2]]
            ys = [float(value) for value in content[1::2]]
        except (TypeError, ValueError):
            continue
        bbox = {
            "x": min(xs), "y": min(ys),
            "width": max(xs) - min(xs), "height": max(ys) - min(ys)
        }
        if bbox["width"] <= 0 or bbox["height"] <= 0:
            continue
        interactive = role.casefold() in interactive_roles
        exact = name_norm == target_norm
        matches.append({
            "role": role,
            "name_length": len(accessible_name),
            "name_sha256": hashlib.sha256(accessible_name.encode("utf-8")).hexdigest(),
            "backend_present": True,
            "interactive": interactive,
            "exact_name": exact,
            "bbox": bbox,
            "backend": int(backend),
        })
    if not matches:
        return resolve_state_target()
    interactive_matches = [item for item in matches if item["interactive"]]
    if not interactive_matches:
        # The AX tree may expose only a static text node even when its
        # semantic parent is the actual button.  Re-resolve through the fresh
        # DOM state so a button/role/tabindex parent can win; never click the
        # static AX text as a coordinate fallback.
        return resolve_state_target()
    matches = interactive_matches
    matches.sort(key=lambda item: (
        not item["exact_name"], not item["interactive"],
        item["name_length"], item["role"], item["backend"]
    ))
    best = matches[0]
    rank = (best["exact_name"], best["interactive"], best["name_length"])
    tied = [
        item for item in matches
        if (item["exact_name"], item["interactive"], item["name_length"]) == rank
    ]
    if len(tied) > 1:
        raise RuntimeError("ax_target_ambiguous")
    best = dict(best)
    best.pop("exact_name", None)
    best.pop("backend", None)
    return best

_prepare_recording_command(name, cmd)
before = page_summary()
if name == "ax-inspect":
    try:
        candidate = resolve_target()
    except RuntimeError as exc:
        # A missing localized alias is a normal read-only probe result. Return
        # a bounded empty candidate so the caller can inspect the next alias;
        # ambiguous or transport failures still stop the operation.
        if str(exc) != "ax_target_not_found":
            raise
        candidate = None
    emit({"success": True, "data": {"candidate": candidate, "before": before}})
elif name == "ax-click":
    candidate = resolve_target()
    if candidate.get("interactive") is not True:
        raise RuntimeError("browser_use_target_not_interactive")
    bbox = candidate["bbox"]
    click_at_xy(bbox["x"] + bbox["width"] / 2, bbox["y"] + bbox["height"] / 2)
    wait(0.6)
    after = page_summary()
    emit({"success": True, "data": {
        "candidate": candidate, "before": before, "after": after,
        "state_changed": before != after
    }})
else:
    raise RuntimeError("unsupported AX target command")
""".replace("__COMMAND_LITERAL__", command_literal).replace("__TARGET_LITERAL__", target_literal).replace("__TAB_GUARD__", _BROWSER_HARNESS_TAB_GUARD)



def run_browser_harness_reload(config: dict[str, Any], home: str, port: int, session: str) -> subprocess.CompletedProcess[str]:
    browser = config["executables"]["browser_use"]["canonical_path"]
    return subprocess.run(
        [browser, "--reload"],
        cwd=home,
        env=browser_harness_env(home, port, session),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=60,
    )


def cleanup_browser_harness_root(session: str) -> bool:
    """Remove only the exact per-session Harness root after daemon shutdown."""
    root = browser_harness_root(session)
    runtime = os.path.join(root, "runtime")
    if any(os.path.lexists(os.path.join(runtime, name)) for name in ("bu.sock", "bu.pid", "bu.port")):
        return False
    if os.path.lexists(root):
        if not os.path.isdir(root) or os.path.islink(root):
            return False
        shutil.rmtree(root)
    return not os.path.lexists(root)


def recording_cli_failure_marker(stderr: str) -> str:
    name_match = re.search(r"NameError: name '([A-Za-z_][A-Za-z0-9_]*)' is not defined", str(stderr or ""))
    if name_match:
        return f"name_error_{name_match.group(1)}"
    runtime_match = re.search(r"RuntimeError: ([A-Za-z_][A-Za-z0-9_]*)", str(stderr or ""))
    if runtime_match:
        code = runtime_match.group(1)
        if code.startswith(("ax_", "browser_use_", "recording_")):
            return f"runtime_error_{code}"
    allowlisted = (
        ("missing_python_module", ("ModuleNotFoundError", "No module named")),
        ("import_error", ("ImportError",)),
        ("type_error", ("TypeError",)),
        ("attribute_error", ("AttributeError",)),
        ("key_error", ("KeyError",)),
        ("name_error", ("NameError",)),
        ("syntax_error", ("SyntaxError",)),
        ("value_error", ("ValueError",)),
        ("index_error", ("IndexError",)),
        ("assertion_error", ("AssertionError",)),
        ("runtime_error", ("RuntimeError",)),
        ("connection_error", ("ConnectionError", "Connection refused", "ERR_CONNECTION_REFUSED", "Could not connect")),
        ("timeout_error", ("TimeoutError", "timed out")),
        ("file_not_found", ("FileNotFoundError",)),
        ("daemon_no_response", ("No response from daemon",)),
        ("daemon_start_failed", ("Failed to start daemon",)),
        ("daemon_config_mismatch", ("already running with different config",)),
        ("browser_session_missing", ("No active browser session", "No browser session")),
        ("target_closed", ("Target closed", "page has been closed")),
        ("navigation_failed", ("Navigation", "navigation", "navigate")),
        ("cdp_connection_failed", ("CDP", "WebSocket", "websocket")),
        ("python_traceback", ("Traceback",)),
    )
    for marker, needles in allowlisted:
        if any(needle in stderr for needle in needles):
            return marker
    # Keep unknown diagnostics reproducible without retaining stderr, page
    # content, URLs, credentials, cookies, or tokens.
    encoded = stderr.encode("utf-8", errors="replace")
    fingerprint = hashlib.sha256(encoded).hexdigest()[:16]
    return f"cli_error_fingerprint_{fingerprint}_bytes_{len(encoded)}"


def parse_authority(path: str, run_id: str, session: str, *, aliases: list[str] | None = None, require_unexpired: bool = True) -> dict[str, Any]:
    assert_regular_file(path, mode=0o600)
    value = read_json_safe(path)
    required = {"browser_surface", "run_id", "session", "expires_at", "allowed_origins", "account_identity", "data_exposure", "side_effect_scope", "approval", "readback_required"}
    missing = sorted(required - value.keys())
    if missing:
        raise Blocker("browser_use_authority_fields_missing", ",".join(missing))
    accepted_sessions = {session, *(aliases or [])}
    if value["browser_surface"] != "browser_use_cli" or value["run_id"] != run_id or value["session"] not in accepted_sessions:
        raise Blocker("browser_use_authority_binding_mismatch")
    try:
        expires = dt.datetime.fromisoformat(str(value["expires_at"]).replace("Z", "+00:00"))
    except ValueError as exc:
        raise Blocker("browser_use_authority_expiry_invalid") from exc
    if expires.tzinfo is None or (require_unexpired and expires <= now_utc()):
        raise Blocker("browser_use_authority_expired")
    if not isinstance(value["allowed_origins"], list) or not value["allowed_origins"]:
        raise Blocker("browser_use_authority_allowed_origins_missing")
    for origin in value["allowed_origins"]:
        normalize_origin(origin)
    if not isinstance(value["account_identity"], str) or not value["account_identity"]:
        raise Blocker("browser_use_authority_account_identity_missing")
    for field in ("data_exposure", "side_effect_scope"):
        if not isinstance(value[field], str) or not value[field].strip():
            raise Blocker("browser_use_authority_scope_missing", field)
    if value["approval"] not in {True, "approved", "APPROVED"}:
        raise Blocker("browser_use_authority_approval_missing")
    if value["readback_required"] is not True:
        raise Blocker("browser_use_authority_readback_required")
    return value


def _authority_expiry(authority: dict[str, Any]) -> dt.datetime:
    try:
        expires = dt.datetime.fromisoformat(str(authority["expires_at"]).replace("Z", "+00:00"))
    except (KeyError, TypeError, ValueError) as exc:
        raise Blocker("browser_use_authority_expiry_invalid") from exc
    if expires.tzinfo is None:
        raise Blocker("browser_use_authority_expiry_invalid")
    return expires.astimezone(dt.timezone.utc)


def authority_scope_digest(authority: dict[str, Any]) -> str:
    scope = {
        "data_exposure": authority.get("data_exposure"),
        "side_effect_scope": authority.get("side_effect_scope"),
        "approval": authority.get("approval"),
        "readback_required": authority.get("readback_required"),
    }
    return hashlib.sha256(json.dumps(scope, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def authority_budget(command_class: str) -> dict[str, int]:
    if not isinstance(command_class, str) or not command_class.strip():
        raise Blocker("browser_use_authority_command_class_invalid")
    dispatch = AUTHORITY_COMMAND_BUDGETS.get(command_class, AUTHORITY_READBACK_BUDGET_SECONDS)
    return {
        "dispatch_seconds": dispatch,
        "readback_seconds": AUTHORITY_READBACK_BUDGET_SECONDS,
        "checkpoint_seconds": AUTHORITY_CHECKPOINT_BUDGET_SECONDS,
        "clock_skew_seconds": AUTHORITY_CLOCK_SKEW_SECONDS,
        "required_seconds": dispatch + AUTHORITY_READBACK_BUDGET_SECONDS + AUTHORITY_CHECKPOINT_BUDGET_SECONDS + AUTHORITY_CLOCK_SKEW_SECONDS,
    }


def remaining_authority_budget(authority: dict[str, Any], command_class: str, *, now: dt.datetime | None = None) -> dict[str, Any]:
    now = (now or now_utc()).astimezone(dt.timezone.utc)
    expiry = _authority_expiry(authority)
    budget = authority_budget(command_class)
    remaining = (expiry - now).total_seconds()
    return {
        "command_class": command_class,
        "expires_at": iso(expiry),
        "remaining_seconds": max(0.0, remaining),
        "sufficient": remaining >= budget["required_seconds"],
        **budget,
    }


def write_authority_renewal_checkpoint(descriptor: dict[str, Any], *, command_class: str, budget: dict[str, Any], exact_blocker: str = "browser_use_authority_renewal_required") -> str:
    """Write only bounded, non-secret admission evidence before dispatch."""
    recording_dir = os.path.realpath(str(descriptor.get("recording_dir") or ""))
    if not recording_dir or not os.path.isabs(recording_dir):
        raise Blocker("browser_use_authority_checkpoint_scope_invalid")
    assert_directory(recording_dir, create=True)
    path = os.path.join(recording_dir, "authority-renewal-checkpoint.json")
    payload = {
        "schema": "browser-use-authority-renewal-checkpoint.v1",
        "run_id": descriptor.get("run_id"),
        "session": descriptor.get("session"),
        "command_class": command_class,
        "authority_generation": descriptor.get("authority_generation", 1),
        "authority_sha256": descriptor.get("authority_sha256"),
        "exact_blocker": exact_blocker,
        "remaining_seconds": budget.get("remaining_seconds"),
        "required_seconds": budget.get("required_seconds"),
        "readback_seconds": budget.get("readback_seconds"),
        "checkpoint_seconds": budget.get("checkpoint_seconds"),
        "clock_skew_seconds": budget.get("clock_skew_seconds"),
        "updated_at": iso(now_utc()),
    }
    json_atomic_replace(path, payload)
    descriptor["authority_checkpoint_path"] = path
    return path


def _authority_history_path(descriptor: dict[str, Any], name: str) -> str:
    recording_dir = os.path.realpath(str(descriptor.get("recording_dir") or ""))
    if not recording_dir or not os.path.isabs(recording_dir):
        raise Blocker("browser_use_authority_history_scope_invalid")
    path = os.path.join(recording_dir, name)
    if os.path.realpath(os.path.dirname(path)) != recording_dir:
        raise Blocker("browser_use_authority_history_scope_invalid")
    return path


def _read_jsonl_chain(path: str, schema: str, code_prefix: str) -> list[dict[str, Any]]:
    if not os.path.lexists(path):
        return []
    assert_regular_file(path, mode=0o600)
    rows: list[dict[str, Any]] = []
    previous = "0" * 64
    with open(path, encoding="utf-8") as handle:
        for sequence, line in enumerate(handle, 1):
            try:
                row = json.loads(line)
            except json.JSONDecodeError as exc:
                raise Blocker(f"{code_prefix}_invalid") from exc
            if not isinstance(row, dict) or row.get("schema") != schema or row.get("sequence") != sequence or row.get("previous_chain_digest") != previous:
                raise Blocker(f"{code_prefix}_sequence_invalid")
            body = dict(row)
            chain = body.pop("chain_digest", None)
            expected = hashlib.sha256((previous + json.dumps(body, sort_keys=True, separators=(",", ":"))).encode()).hexdigest()
            if chain != expected:
                raise Blocker(f"{code_prefix}_chain_invalid")
            rows.append(row)
            previous = chain
    return rows


def _append_jsonl_chain(path: str, schema: str, row: dict[str, Any], code_prefix: str) -> dict[str, Any]:
    parent = os.path.dirname(path)
    assert_directory(parent, create=True)
    if os.path.lexists(path):
        assert_regular_file(path, mode=0o600)
    else:
        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.close(fd)
    rows = _read_jsonl_chain(path, schema, code_prefix)
    value = {"schema": schema, "sequence": len(rows) + 1, "previous_chain_digest": rows[-1].get("chain_digest", "0" * 64) if rows else "0" * 64, **row}
    value["chain_digest"] = hashlib.sha256((value["previous_chain_digest"] + json.dumps(value, sort_keys=True, separators=(",", ":"))).encode()).hexdigest()
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n")
        handle.flush()
        os.fsync(handle.fileno())
    if _read_jsonl_chain(path, schema, code_prefix)[-1] != value:
        raise Blocker(f"{code_prefix}_readback_failed")
    return value


def _authority_history_row(descriptor: dict[str, Any], authority: dict[str, Any], *, digest: str, generation: int, previous_digest: str | None, issuer_id: str) -> dict[str, Any]:
    return {
        "run_id": descriptor.get("run_id"),
        "session": descriptor.get("session"),
        "authority_generation": generation,
        "authority_sha256": digest,
        "previous_authority_sha256": previous_digest,
        "issuer_id": issuer_id,
        "expires_at": authority.get("expires_at"),
        "account_identity": authority.get("account_identity"),
        "allowed_origins": sorted({normalize_origin(item) for item in authority.get("allowed_origins", [])}),
        "authority_scope_digest": authority_scope_digest(authority),
    }


def append_authority_generation(descriptor: dict[str, Any], authority: dict[str, Any], *, digest: str, generation: int, previous_digest: str | None, issuer_id: str) -> None:
    ledger = _authority_history_path(descriptor, "authority-generation-ledger.jsonl")
    rows = _read_jsonl_chain(ledger, AUTHORITY_LEDGER_SCHEMA, "browser_use_authority_ledger")
    if rows and generation != int(rows[-1]["authority_generation"]) + 1:
        raise Blocker("browser_use_authority_generation_lineage_mismatch")
    if not rows and generation != 1:
        raise Blocker("browser_use_authority_generation_lineage_mismatch")
    if rows and previous_digest != rows[-1].get("authority_sha256"):
        raise Blocker("browser_use_authority_previous_digest_mismatch")
    row = _authority_history_row(descriptor, authority, digest=digest, generation=generation, previous_digest=previous_digest, issuer_id=issuer_id)
    _append_jsonl_chain(ledger, AUTHORITY_LEDGER_SCHEMA, row, "browser_use_authority_ledger")
    history = _authority_history_path(descriptor, "authority-descriptor-history.jsonl")
    lineage = {
        "profile": descriptor.get("profile"),
        "port": descriptor.get("port"),
        "process": descriptor.get("process"),
        "session": descriptor.get("session"),
        "helper_sha256": descriptor.get("helper_sha256"),
    }
    _append_jsonl_chain(history, AUTHORITY_HISTORY_SCHEMA, {**row, "resource_lineage_digest": hashlib.sha256(json.dumps(lineage, sort_keys=True, separators=(",", ":")).encode()).hexdigest()}, "browser_use_authority_history")
    descriptor["authority_ledger_path"] = ledger
    descriptor["authority_history_path"] = history


def _validate_renewal_contract(config: dict[str, Any], descriptor: dict[str, Any], current: dict[str, Any], current_digest: str, renewal_path: str) -> tuple[dict[str, Any], str, int, str]:
    if not os.path.isabs(renewal_path) or os.path.realpath(renewal_path) != renewal_path:
        raise Blocker("browser_use_authority_renewal_path_invalid")
    assert_regular_file(renewal_path, mode=0o600)
    value = read_json_safe(renewal_path)
    if set(value) - AUTHORITY_RENEWAL_ALLOWED_KEYS or value.get("schema") != AUTHORITY_RENEWAL_SCHEMA:
        raise Blocker("browser_use_authority_renewal_schema_invalid")
    missing = sorted(AUTHORITY_RENEWAL_ALLOWED_KEYS - set(value))
    if missing:
        raise Blocker("browser_use_authority_renewal_fields_missing", ",".join(missing))
    authority = parse_authority(renewal_path, descriptor["run_id"], descriptor["session"], aliases=session_aliases(config, descriptor.get("requested_session", descriptor["session"]), descriptor["session"]))
    if value.get("previous_authority_sha256") != current_digest:
        raise Blocker("browser_use_authority_previous_digest_mismatch")
    try:
        generation = int(value["authority_generation"])
    except (TypeError, ValueError) as exc:
        raise Blocker("browser_use_authority_generation_invalid") from exc
    expected_generation = int(descriptor.get("authority_generation", 1)) + 1
    if generation != expected_generation:
        raise Blocker("browser_use_authority_generation_lineage_mismatch")
    issuer_id = value.get("issuer_id")
    if not isinstance(issuer_id, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}", issuer_id):
        raise Blocker("browser_use_authority_issuer_id_invalid")
    if authority["account_identity"] != current["account_identity"]:
        raise Blocker("browser_use_authority_renewal_account_mismatch")
    if sorted({normalize_origin(item) for item in authority["allowed_origins"]}) != sorted({normalize_origin(item) for item in current["allowed_origins"]}):
        raise Blocker("browser_use_authority_renewal_origins_mismatch")
    if authority_scope_digest(authority) != authority_scope_digest(current):
        raise Blocker("browser_use_authority_renewal_scope_mismatch")
    if _authority_expiry(authority) <= now_utc() + dt.timedelta(seconds=AUTHORITY_CLOCK_SKEW_SECONDS):
        raise Blocker("browser_use_authority_renewal_expiry_insufficient")
    if (_authority_expiry(authority) - now_utc()).total_seconds() > 86400:
        raise Blocker("browser_use_authority_renewal_expiry_unbounded")
    return authority, sha256_file(renewal_path), generation, issuer_id


def renew_recording_authority(config: dict[str, Any], descriptor: dict[str, Any], current_path: str, renewal_path: str) -> dict[str, Any]:
    current_path = os.path.realpath(current_path)
    if descriptor.get("authority_current_path"):
        current_path = os.path.realpath(str(descriptor["authority_current_path"]))
    current = parse_authority(current_path, descriptor["run_id"], descriptor["session"], aliases=session_aliases(config, descriptor.get("requested_session", descriptor["session"]), descriptor["session"]), require_unexpired=False)
    current_digest = sha256_file(current_path)
    if current_digest != descriptor.get("authority_sha256"):
        raise Blocker("browser_use_recording_authority_changed")
    authority, digest, generation, issuer_id = _validate_renewal_contract(config, descriptor, current, current_digest, renewal_path)
    ledger = _authority_history_path(descriptor, "authority-generation-ledger.jsonl")
    if not _read_jsonl_chain(ledger, AUTHORITY_LEDGER_SCHEMA, "browser_use_authority_ledger"):
        append_authority_generation(
            descriptor,
            current,
            digest=current_digest,
            generation=int(descriptor.get("authority_generation", 1)),
            previous_digest=None,
            issuer_id=str(descriptor.get("authority_issuer_id") or "initial"),
        )
    append_authority_generation(descriptor, authority, digest=digest, generation=generation, previous_digest=current_digest, issuer_id=issuer_id)
    descriptor.update({
        "authority_sha256": digest,
        "authority_generation": generation,
        "authority_issuer_id": issuer_id,
        "authority_expires_at": authority["expires_at"],
        "authority_current_path": os.path.realpath(renewal_path),
    })
    return authority


def admit_authority_budget(config: dict[str, Any], descriptor: dict[str, Any], authority: dict[str, Any], command_class: str, *, renewal_path: str | None = None) -> dict[str, Any]:
    if renewal_path:
        authority = renew_recording_authority(config, descriptor, str(descriptor.get("authority_current_path") or descriptor.get("authority_path") or ""), renewal_path)
    budget = remaining_authority_budget(authority, command_class)
    if not budget["sufficient"]:
        try:
            write_authority_renewal_checkpoint(descriptor, command_class=command_class, budget=budget)
        except Blocker:
            pass
        raise Blocker("browser_use_authority_renewal_required")
    return budget


def normalize_origin(value: str) -> str:
    parsed = urllib.parse.urlparse(value)
    if parsed.scheme not in {"http", "https"} or parsed.username or parsed.password or not parsed.hostname or parsed.path not in {"", "/"} or parsed.query or parsed.fragment:
        raise Blocker("browser_use_allowed_origin_invalid")
    host = parsed.hostname.lower().rstrip(".")
    port = parsed.port
    if (parsed.scheme == "http" and port == 80) or (parsed.scheme == "https" and port == 443):
        port = None
    port_suffix = f":{port}" if port else ""
    return f"{parsed.scheme}://{host}{port_suffix}"


def is_forbidden_ip(host: str) -> bool:
    try:
        address = ipaddress.ip_address(host)
    except ValueError:
        return host.lower() in {"localhost", "localhost.localdomain", "metadata.google.internal", "instance-data.ec2.internal"} or host.lower().endswith(".local")
    return address.is_private or address.is_loopback or address.is_link_local or address.is_reserved or address.is_multicast or address.is_unspecified or address.is_loopback


def preflight_url(url: str, allowed_origins: list[str], unsafe_fragments: list[str]) -> str:
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in {"http", "https"} or parsed.username or parsed.password or not parsed.hostname:
        raise Blocker("browser_use_url_preflight_rejected")
    if any(fragment in parsed.path.lower() for fragment in unsafe_fragments):
        raise Blocker("browser_use_unsafe_url_path")
    host = parsed.hostname.lower().rstrip(".")
    if is_forbidden_ip(host):
        raise Blocker("browser_use_private_or_metadata_url")
    try:
        addresses = {item[4][0] for item in socket.getaddrinfo(host, parsed.port or (443 if parsed.scheme == "https" else 80), type=socket.SOCK_STREAM)}
    except OSError as exc:
        raise Blocker("browser_use_url_dns_preflight_failed", host) from exc
    if any(is_forbidden_ip(address) for address in addresses):
        raise Blocker("browser_use_private_or_metadata_url")
    origin_port_suffix = f":{parsed.port}" if parsed.port else ""
    origin = normalize_origin(f"{parsed.scheme}://{host}{origin_port_suffix}")
    if origin not in {normalize_origin(item) for item in allowed_origins}:
        raise Blocker("browser_use_origin_not_allowed", origin)
    return origin


def validate_upload(path: str, maximum: int) -> dict[str, Any]:
    if not os.path.isabs(path) or os.path.realpath(path) != path:
        raise Blocker("browser_use_upload_noncanonical_or_symlink")
    st = lstat(path)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode) or stat.S_ISFIFO(st.st_mode) or stat.S_ISCHR(st.st_mode) or stat.S_ISBLK(st.st_mode) or stat.S_ISDIR(st.st_mode):
        raise Blocker("browser_use_upload_file_type_rejected")
    if st.st_uid != EUID or st.st_size > maximum:
        raise Blocker("browser_use_upload_owner_or_size_rejected")
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except OSError as exc:
        raise Blocker("browser_use_upload_open_failed") from exc
    try:
        opened = os.fstat(fd)
        if opened.st_dev != st.st_dev or opened.st_ino != st.st_ino or opened.st_size != st.st_size or opened.st_mtime_ns != st.st_mtime_ns:
            raise Blocker("browser_use_upload_changed_after_validation")
        digest = hashlib.sha256()
        for chunk in iter(lambda: os.read(fd, 1024 * 1024), b""):
            digest.update(chunk)
    finally:
        os.close(fd)
    mime = mimetypes.guess_type(path)[0] or "application/octet-stream"
    classification = "image" if mime.startswith("image/") else "document" if mime.startswith(("text/", "application/pdf", "application/msword", "application/vnd.")) else "binary"
    return {"sha256": digest.hexdigest(), "size": st.st_size, "classification": classification, "destination": "authorized_browser_origin"}


def validate_command(command: list[str], mode: str, config: dict[str, Any], allowed_origins: list[str], download_dir: str) -> tuple[list[str], list[str], list[dict[str, Any]]]:
    if not command or command[0].startswith("-"):
        raise Blocker("browser_use_command_missing")
    name = command[0]
    allowed = set(config["commands"][mode])
    if name not in allowed:
        if mode == "public" and name in set(config["commands"]["authorized"]):
            raise Blocker("browser_use_public_requires_authorized_mode", "forms/submission/JS/upload/download require authorized mode")
        raise Blocker("browser_use_command_not_allowed", name)
    for arg in command[1:]:
        if arg in BLOCKED_GLOBAL_FLAGS or arg.startswith("--cdp-url=") or arg.startswith("--profile=") or arg.startswith("--session="):
            raise Blocker("browser_use_helper_owned_flag_rejected", arg.split("=", 1)[0])
    origins: list[str] = []
    for arg in command:
        if arg.startswith(("http://", "https://")):
            origins.append(preflight_url(arg, allowed_origins, config["policy"]["unsafe_path_fragments"]))
    if name == "open" and not origins:
        raise Blocker("browser_use_open_url_required")
    uploads: list[dict[str, Any]] = []
    if name == "upload":
        candidates = [arg for arg in command[1:] if not arg.startswith("-")]
        if not candidates:
            raise Blocker("browser_use_upload_path_required")
        uploads.append(validate_upload(candidates[-1], config["limits"]["max_upload_bytes"]))
    if mode == "public" and name in {"type", "input", "click", "select", "eval", "upload", "download", "python", "cookies"}:
        raise Blocker("browser_use_public_requires_authorized_mode")
    return command, sorted(set(origins)), uploads


def validate_capture_path(path: str, artifact_dir: str) -> str:
    """Validate a one-run capture path without allowing arbitrary overwrite."""
    if not isinstance(path, str) or not os.path.isabs(path) or os.path.realpath(path) != path:
        raise Blocker("browser_use_capture_path_noncanonical")
    if not isinstance(artifact_dir, str) or not os.path.isabs(artifact_dir) or os.path.realpath(artifact_dir) != artifact_dir:
        raise Blocker("browser_use_capture_artifact_dir_noncanonical")
    assert_directory(artifact_dir)
    relative = os.path.relpath(path, artifact_dir)
    if relative == os.pardir or relative.startswith(os.pardir + os.sep) or os.path.isabs(relative):
        raise Blocker("browser_use_capture_path_out_of_artifact_scope")
    parent = os.path.dirname(path)
    assert_directory(parent)
    if os.path.lexists(path):
        raise Blocker("browser_use_capture_path_already_exists")
    return path


def port_listener(port: int) -> bool:
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(0.2)
    try:
        result = sock.connect_ex(("127.0.0.1", port))
        if result == 0:
            return True
        if result == errno.ECONNREFUSED:
            return False
        raise Blocker("browser_use_listener_recheck_failed", str(result))
    except OSError as exc:
        raise Blocker("browser_use_listener_recheck_failed") from exc
    finally:
        sock.close()


def lsof_listener(port: int) -> bool:
    try:
        result = subprocess.run(["/usr/sbin/lsof", "-nP", "-a", f"-iTCP:{port}", "-sTCP:LISTEN", "-Fpct"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        raise Blocker("browser_use_listener_recheck_failed")
    if result.returncode not in {0, 1}:
        raise Blocker("browser_use_listener_recheck_failed")
    return result.returncode == 0 and bool(result.stdout.strip())


def assert_debug_listener_absent(port: int) -> None:
    """Require two independent local listener checks to report absence."""
    socket_listener = port_listener(port)
    lsof_listener_present = lsof_listener(port)
    if socket_listener or lsof_listener_present:
        raise Blocker("browser_use_listener_remains_after_cleanup")


def lock_file(path: str, payload: dict[str, Any]) -> None:
    parent = os.path.dirname(path)
    assert_directory(parent, create=True)
    try:
        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0), 0o600)
    except FileExistsError as exc:
        raise Blocker("browser_use_lock_already_held", path) from exc
    try:
        os.write(fd, (json.dumps(payload, sort_keys=True) + "\n").encode())
        os.fsync(fd)
    finally:
        os.close(fd)


def release_lock(path: str, run_id: str, nonce: str) -> bool:
    if not os.path.lexists(path):
        # A completed cleanup may be retried after the lock was already
        # released.  Missing is idempotent; malformed or foreign is not.
        return True
    try:
        value = read_json_safe(path)
    except (Blocker, json.JSONDecodeError) as exc:
        raise Blocker("browser_use_lock_release_recheck_failed", path) from exc
    if value.get("run_id") != run_id or value.get("nonce") != nonce:
        raise Blocker("browser_use_lock_owner_recheck_failed", path)
    try:
        os.unlink(path)
    except OSError as exc:
        raise Blocker("browser_use_lock_release_failed", path) from exc
    if os.path.lexists(path):
        raise Blocker("browser_use_lock_cleanup_readback_failed", path)
    return True


ROOM_REGISTRY_SCHEMA = "browser-use-room-registry.v1"
ROOM_REGISTRY_FILENAME = "room-registry.json"
ROOM_REGISTRY_LOCK_FILENAME = "room-registry.lock"
ROOM_REGISTRY_LIFECYCLES = {"temporary", "single-use", "scheduled"}
ROOM_REGISTRY_STATES = {"active", "starting", "held", "released", "rollback"}
ROOM_REGISTRY_ACTIVE_STATES = {"active", "starting", "held"}
ROOM_REGISTRY_ACTIVITY_RE = re.compile(r"^[a-z][a-z0-9_.:-]{0,47}$")


def room_registry_paths(config: dict[str, Any]) -> tuple[str, str]:
    """Return the helper-owned ledger and its short-lived exclusive lock."""
    state_root = (config.get("roots") or {}).get("browser_use_home")
    if not isinstance(state_root, str) or not os.path.isabs(state_root) or os.path.realpath(state_root) != state_root:
        raise Blocker("browser_use_room_registry_state_root_invalid")
    assert_directory(state_root, create=True)
    return os.path.join(state_root, ROOM_REGISTRY_FILENAME), os.path.join(state_root, ROOM_REGISTRY_LOCK_FILENAME)


def _empty_room_registry() -> dict[str, Any]:
    timestamp = iso(now_utc())
    return {"schema": ROOM_REGISTRY_SCHEMA, "version": 1, "rooms": [], "created_at": timestamp, "updated_at": timestamp}


def _validate_room_registry(value: dict[str, Any]) -> dict[str, Any]:
    if value.get("schema") != ROOM_REGISTRY_SCHEMA or value.get("version") != 1 or not isinstance(value.get("rooms"), list):
        raise Blocker("browser_use_room_registry_schema_invalid")
    for room in value["rooms"]:
        if not isinstance(room, dict) or not isinstance(room.get("room_id"), str) or room.get("lifecycle") not in ROOM_REGISTRY_LIFECYCLES:
            raise Blocker("browser_use_room_registry_entry_invalid")
        if room.get("state") not in ROOM_REGISTRY_STATES:
            raise Blocker("browser_use_room_registry_state_invalid")
        if not isinstance(room.get("profile"), str) or not isinstance(room.get("port"), int):
            raise Blocker("browser_use_room_registry_resource_invalid")
        if not isinstance(room.get("activity"), list) or not all(isinstance(item, dict) for item in room["activity"]):
            raise Blocker("browser_use_room_registry_activity_invalid")
    return value


def room_registry_read(config: dict[str, Any]) -> dict[str, Any]:
    ledger_path, _ = room_registry_paths(config)
    if not os.path.lexists(ledger_path):
        return _empty_room_registry()
    return _validate_room_registry(read_json_safe(ledger_path))


def _room_registry_transaction(config: dict[str, Any], mutator: Any) -> Any:
    """Run one bounded read/modify/write under an exclusive 0600 lock."""
    ledger_path, lock_path = room_registry_paths(config)
    token = f"registry-{os.getpid()}-{uuid.uuid4().hex}"
    payload = {"schema": "browser-use-room-registry-lock.v1", "owner_pid": os.getpid(), "owner_token": token, "acquired_at": iso(now_utc())}
    try:
        lock_file(lock_path, {"run_id": token, "nonce": token, **payload})
    except Blocker as exc:
        if exc.code == "browser_use_lock_already_held":
            raise Blocker("browser_use_room_registry_lock_conflict") from exc
        raise
    try:
        current = room_registry_read(config)
        updated, result = mutator(current)
        _validate_room_registry(updated)
        json_atomic_replace(ledger_path, updated)
        return result
    finally:
        release_lock(lock_path, token, token)


def _room_registry_owner(lifecycle: str, task_id: str | None, automation_id: str | None, run_id: str) -> tuple[str, str]:
    if lifecycle == TEMPORARY_LIFECYCLE:
        return "task", safe_id(task_id or "", "task_id")
    if lifecycle == "scheduled":
        return "automation", safe_id(automation_id or "", "automation_id")
    return "task", safe_id(task_id or run_id, "task_id")


def _room_registry_room_id(lifecycle: str, owner_type: str, owner_id: str) -> str:
    if lifecycle == "single-use":
        return f"room-{uuid.uuid4().hex}"
    digest = hashlib.sha256(f"{lifecycle}\0{owner_type}\0{owner_id}".encode()).hexdigest()[:32]
    return f"room-{digest}"


def _room_registry_profile_roots(config: dict[str, Any]) -> list[str]:
    roots = config.get("roots") or {}
    return [os.path.realpath(str(roots[name])) for name in ("scheduled_profiles", "single_use_profiles", "temporary_profiles") if isinstance(roots.get(name), str)]


def _room_registry_profile(config: dict[str, Any], lifecycle: str, room_id: str, profile: str | None, automation_id: str | None) -> str:
    if profile is None:
        if lifecycle == "scheduled":
            profile = os.path.join(config["roots"]["scheduled_profiles"], safe_id(automation_id or "", "automation_id"))
        else:
            root_name = "temporary_profiles" if lifecycle == TEMPORARY_LIFECYCLE else "single_use_profiles"
            profile = os.path.join(config["roots"][root_name], room_id)
    if not isinstance(profile, str) or not os.path.isabs(profile) or os.path.realpath(profile) != profile:
        raise Blocker("browser_use_room_registry_profile_invalid")
    if not any(profile == root or profile.startswith(root + os.sep) for root in _room_registry_profile_roots(config)):
        raise Blocker("browser_use_room_registry_profile_scope_mismatch")
    return profile


def _room_registry_port_range(config: dict[str, Any], lifecycle: str) -> tuple[int, int]:
    ports = config.get("ports") or {}
    if lifecycle == "scheduled":
        return int(ports["scheduled_start"]), int(ports["scheduled_end"])
    if lifecycle == "single-use":
        return int(ports["single_use_start"]), int(ports["single_use_end"])
    return int(ports["temporary_start"]), int(ports["temporary_end"])


def _room_registry_active_ports(registry: dict[str, Any]) -> set[int]:
    return {int(room["port"]) for room in registry["rooms"] if room.get("state") in ROOM_REGISTRY_ACTIVE_STATES}


def _room_registry_activity(value: Any) -> str:
    """Persist only a short event kind, never caller text, URL, or command."""
    first = str(value or "").split(maxsplit=1)[0].lower()
    return first if ROOM_REGISTRY_ACTIVITY_RE.fullmatch(first) else "activity"


def _room_registry_public(room: dict[str, Any]) -> dict[str, Any]:
    result = {key: room.get(key) for key in ("room_id", "lifecycle", "owner", "task_id", "automation_id", "profile", "port", "state", "created_at", "updated_at", "last_activity_at", "current_activity", "activity") if key in room}
    return result


def room_registry_claim(
    config: dict[str, Any],
    *,
    lifecycle: str,
    run_id: str,
    profile: str | None = None,
    port: int | None = None,
    task_id: str | None = None,
    automation_id: str | None = None,
    activity: str = "claim",
) -> dict[str, Any]:
    """Claim or reuse one room without replacing resource/authority locks."""
    if lifecycle not in ROOM_REGISTRY_LIFECYCLES:
        raise Blocker("browser_use_room_registry_lifecycle_invalid")
    run_id = safe_id(run_id, "run_id")
    owner_type, owner_id = _room_registry_owner(lifecycle, task_id, automation_id, run_id)
    if lifecycle == "scheduled" and owner_id == "manual":
        raise Blocker("browser_use_scheduled_automation_id_required")
    deterministic_id = _room_registry_room_id(lifecycle, owner_type, owner_id)
    lease_digest = hashlib.sha256(run_id.encode("utf-8")).hexdigest()

    def mutate(registry: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any]]:
        now = iso(now_utc())
        existing = next((room for room in registry["rooms"] if room.get("room_id") == deterministic_id), None)
        if existing is not None and lifecycle != "single-use" and port is not None and int(port) != int(existing.get("port", -1)):
            raise Blocker("browser_use_room_allocation_mismatch", owner_id)
        if existing is not None and lifecycle == "scheduled" and existing.get("state") in ROOM_REGISTRY_ACTIVE_STATES and existing.get("lease_digest") != lease_digest:
            raise Blocker("browser_use_room_scheduled_duplicate", owner_id)
        if existing is not None and lifecycle == TEMPORARY_LIFECYCLE and existing.get("state") == "active" and existing.get("lease_digest") != lease_digest:
            raise Blocker("browser_use_room_temporary_duplicate", owner_id)
        if existing is not None and lifecycle != "single-use" and existing.get("state") in ROOM_REGISTRY_ACTIVE_STATES and existing.get("lease_digest") == lease_digest:
            existing["updated_at"] = now
            existing["last_activity_at"] = now
            event = _room_registry_activity(activity)
            existing["current_activity"] = event
            existing["activity"].append({"at": now, "kind": event})
            existing["activity"] = existing["activity"][-8:]
            registry["updated_at"] = now
            return registry, _room_registry_public(existing)
        if existing is not None and lifecycle == "scheduled" and existing.get("state") == "released":
            if port is not None and int(port) != int(existing["port"]):
                raise Blocker("browser_use_room_scheduled_allocation_mismatch")
            if profile is not None and os.path.realpath(profile) != existing["profile"]:
                raise Blocker("browser_use_room_scheduled_allocation_mismatch")
        room_id = deterministic_id if lifecycle != "single-use" else _room_registry_room_id(lifecycle, owner_type, owner_id)
        if existing is not None and lifecycle != "single-use":
            room_id = existing["room_id"]
        selected_port = int(port) if port is not None else None
        start, end = _room_registry_port_range(config, lifecycle)
        active_ports = _room_registry_active_ports(registry)
        if selected_port is None and existing is not None:
            selected_port = int(existing["port"])
        if selected_port is None:
            offset = int(hashlib.sha256(owner_id.encode("utf-8")).hexdigest(), 16) % (end - start + 1)
            for index in range(end - start + 1):
                candidate = start + ((offset + index) % (end - start + 1))
                if candidate not in active_ports and not port_listener(candidate) and not lsof_listener(candidate):
                    selected_port = candidate
                    break
        if selected_port is None or not start <= selected_port <= end:
            raise Blocker("browser_use_room_registry_no_free_room", lifecycle)
        if selected_port in active_ports and (existing is None or int(existing.get("port", -1)) != selected_port):
            raise Blocker("browser_use_room_registry_port_conflict", str(selected_port))
        if (existing is None or existing.get("state") not in ROOM_REGISTRY_ACTIVE_STATES) and (port_listener(selected_port) or lsof_listener(selected_port)):
            raise Blocker("browser_use_room_registry_listener_conflict", str(selected_port))
        selected_profile = _room_registry_profile(config, lifecycle, room_id, profile if profile is not None else (existing.get("profile") if existing else None), automation_id)
        if existing is not None and lifecycle == "scheduled" and selected_profile != existing["profile"]:
            raise Blocker("browser_use_room_scheduled_allocation_mismatch")
        event = _room_registry_activity(activity)
        room = {
            "room_id": room_id,
            "lifecycle": lifecycle,
            "owner": {"kind": owner_type, "id": owner_id},
            "task_id": owner_id if owner_type == "task" else None,
            "automation_id": owner_id if owner_type == "automation" else None,
            "profile": selected_profile,
            "port": selected_port,
            "state": "active",
            "created_at": existing.get("created_at", now) if existing else now,
            "updated_at": now,
            "last_activity_at": now,
            "current_activity": event,
            "activity": (existing.get("activity", []) if existing else [])[-7:] + [{"at": now, "kind": event}],
            "lease_digest": lease_digest,
        }
        if existing is not None:
            index = registry["rooms"].index(existing)
            registry["rooms"][index] = room
        else:
            registry["rooms"].append(room)
        registry["updated_at"] = now
        return registry, _room_registry_public(room)

    return _room_registry_transaction(config, mutate)


def room_registry_update(config: dict[str, Any], room_id: str, *, run_id: str, state: str = "active", activity: str = "update") -> dict[str, Any]:
    if not isinstance(room_id, str) or not room_id.startswith("room-"):
        raise Blocker("browser_use_room_registry_room_id_invalid")
    if state not in ROOM_REGISTRY_STATES:
        raise Blocker("browser_use_room_registry_state_invalid")
    lease_digest = hashlib.sha256(safe_id(run_id, "run_id").encode("utf-8")).hexdigest()

    def mutate(registry: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any]]:
        room = next((item for item in registry["rooms"] if item.get("room_id") == room_id), None)
        if room is None:
            raise Blocker("browser_use_room_registry_room_missing")
        if room.get("lease_digest") != lease_digest and not (room.get("state") == "released" and state == "released"):
            raise Blocker("browser_use_room_registry_owner_conflict")
        now = iso(now_utc())
        room["state"] = state
        room["updated_at"] = now
        room["last_activity_at"] = now
        event = _room_registry_activity(activity)
        # Keep the last useful operation visible while a temporary or
        # scheduled room is merely held between browser commands.
        if not (state == "held" and event == "held"):
            room["current_activity"] = event
        room["activity"] = (room.get("activity") or [])[-7:] + [{"at": now, "kind": event}]
        registry["updated_at"] = now
        return registry, _room_registry_public(room)

    return _room_registry_transaction(config, mutate)


def room_registry_release(config: dict[str, Any], room_id: str, *, run_id: str, activity: str = "release") -> dict[str, Any]:
    ledger = room_registry_read(config)
    room = next((item for item in ledger["rooms"] if item.get("room_id") == room_id), None)
    if room is None:
        return {"room_id": room_id, "state": "released"}
    if room.get("state") == "released":
        return _room_registry_public(room)
    return room_registry_update(config, room_id, run_id=run_id, state="released", activity=activity)


def room_registry_list(config: dict[str, Any]) -> list[dict[str, Any]]:
    return [_room_registry_public(room) for room in room_registry_read(config)["rooms"]]


def room_registry_observations(config: dict[str, Any]) -> list[dict[str, Any]]:
    """Observe descriptor-backed runs without claiming ownership of resources."""
    observations: list[dict[str, Any]] = []
    for path in _recording_descriptor_paths(config):
        try:
            descriptor = read_json_safe(path)
            process = descriptor.get("process") or {}
            port = int(descriptor.get("port"))
            listener = bool(port_listener(port) or lsof_listener(port))
        except (Blocker, OSError, TypeError, ValueError):
            listener = None
            descriptor = {}
        room_id = descriptor.get("room_id")
        if not room_id:
            continue
        observations.append({
            "room_id": str(room_id),
            "descriptor": os.path.realpath(path),
            "run_id": descriptor.get("run_id"),
            "session": descriptor.get("session"),
            "lifecycle": descriptor.get("lifecycle"),
            "state": descriptor.get("status"),
            "port": descriptor.get("port"),
            "profile": descriptor.get("profile"),
            "listener_observed": listener,
            "process_start_time": process.get("root_start_time"),
            "ownership": "descriptor_bound_observation",
            "reclaim_allowed": False,
            "observed_at": iso(now_utc()),
        })
    return observations


def room_registry_lookup(config: dict[str, Any], room_id: str) -> dict[str, Any] | None:
    if not isinstance(room_id, str) or not room_id.startswith("room-"):
        return None
    return next((room for room in room_registry_list(config) if room.get("room_id") == room_id), None)


def room_registry_table(rooms: list[dict[str, Any]]) -> str:
    headers = ("LIFECYCLE", "OWNER", "PROFILE", "PORT", "STATE", "CURRENT", "CREATED", "UPDATED")
    rows = []
    for room in rooms:
        owner = room.get("owner") or {}
        owner_text = f"{owner.get('kind', 'owner')}:{owner.get('id', '')}"
        rows.append((str(room.get("lifecycle", "")), owner_text, str(room.get("profile", "")), str(room.get("port", "")), str(room.get("state", "")), str(room.get("current_activity", "")), str(room.get("created_at", "")), str(room.get("updated_at", ""))))
    widths = [max(len(headers[index]), *(len(row[index]) for row in rows)) for index in range(len(headers))]
    lines = ["  ".join(headers[index].ljust(widths[index]) for index in range(len(headers)))]
    lines.append("  ".join("-" * width for width in widths))
    lines.extend("  ".join(row[index].ljust(widths[index]) for index in range(len(headers))) for row in rows)
    return "\n".join(lines)


def room_registry_command(config: dict[str, Any], args: argparse.Namespace) -> int:
    rooms = room_registry_list(config)
    observations = room_registry_observations(config)
    if getattr(args, "json_output", False):
        print(json.dumps({"schema": ROOM_REGISTRY_SCHEMA, "rooms": rooms, "observations": observations, "reconciliation": "observation_only"}, sort_keys=True))
    else:
        print(room_registry_table(rooms))
        if observations:
            print(json.dumps({"observations": observations, "reconciliation": "observation_only"}, sort_keys=True))
    return 0


def assert_owned_locks(paths: list[str], run_id: str, nonce: str) -> None:
    for path in paths:
        value = read_json_safe(path)
        if value.get("run_id") != run_id or value.get("nonce") != nonce:
            raise Blocker("browser_use_lock_owner_recheck_failed")


def choose_port(config: dict[str, Any], lifecycle: str, automation_id: str) -> int:
    ports = config["ports"]
    if lifecycle == "scheduled":
        start, end = ports["scheduled_start"], ports["scheduled_end"]
    elif lifecycle == "single-use":
        start, end = ports["single_use_start"], ports["single_use_end"]
    else:
        raise Blocker("browser_use_port_selection_lifecycle_invalid", lifecycle)
    offset = int(hashlib.sha256(automation_id.encode()).hexdigest(), 16) % (end - start + 1)
    for index in range(end - start + 1):
        port = start + ((offset + index) % (end - start + 1))
        if not port_listener(port) and not lsof_listener(port):
            return port
    raise Blocker("browser_use_no_free_port", lifecycle)


def profile_hash(profile: str, nonce: str) -> str:
    return hashlib.sha256(f"{os.path.realpath(profile)}\0{nonce}".encode()).hexdigest()


def temporary_authority_scope(authority: dict[str, Any]) -> dict[str, Any]:
    return {
        "data_exposure": authority["data_exposure"],
        "side_effect_scope": authority["side_effect_scope"],
        "approval": authority["approval"],
        "readback_required": authority["readback_required"],
    }


def default_chat_task_id(requested_session: str) -> str:
    digest = hashlib.sha256(str(requested_session).encode("utf-8")).hexdigest()[:32]
    return f"chat-{digest}"


def resolve_default_lifecycle(mode: str, requested_lifecycle: str | None) -> str:
    if requested_lifecycle:
        return str(requested_lifecycle)
    return TEMPORARY_LIFECYCLE if mode == "authorized" else "single-use"


def ensure_temporary_task_id(args: argparse.Namespace, requested_session: str) -> None:
    if getattr(args, "lifecycle", None) == TEMPORARY_LIFECYCLE and not getattr(args, "task_id", None):
        args.task_id = default_chat_task_id(requested_session)


def delete_approval_signal(args: argparse.Namespace) -> bool:
    # --user-ok remains a compatibility alias for callers from the previous
    # contract; new callers should use the semantically explicit flag.
    return bool(getattr(args, "delete_approved", False) or getattr(args, "user_ok", False))


def require_temporary_delete_approval(
    descriptor: dict[str, Any],
    *,
    delete_approved: bool = False,
    cleanup_only: bool = False,
) -> None:
    if descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE:
        return
    if cleanup_only:
        if descriptor.get("status") in TEMPORARY_CLEANUP_STATUSES:
            return
        raise Blocker("browser_use_temporary_cleanup_only_requires_terminal_state")
    if delete_approved:
        return
    raise Blocker("browser_use_temporary_delete_approval_required")


def require_temporary_user_ok(
    descriptor: dict[str, Any],
    *,
    user_ok: bool = False,
    cleanup_only: bool = False,
) -> None:
    """Compatibility wrapper for the prior --user-ok contract."""
    require_temporary_delete_approval(
        descriptor,
        delete_approved=user_ok,
        cleanup_only=cleanup_only,
    )


def temporary_binding(
    *,
    mode: str,
    lifecycle: str,
    automation_id: str,
    task_id: str,
    run_id: str,
    authority_digest: str,
    authority_scope: dict[str, Any],
    account_identity: str,
    origins: list[str],
) -> str:
    if mode != "authorized" or lifecycle != TEMPORARY_LIFECYCLE:
        raise Blocker("browser_use_temporary_binding_invalid")
    safe_id(automation_id, "automation_id")
    safe_id(task_id, "task_id")
    safe_id(run_id, "run_id")
    if not re.fullmatch(r"[0-9a-f]{64}", authority_digest):
        raise Blocker("browser_use_temporary_authority_digest_invalid")
    value = {
        "mode": mode,
        "lifecycle": lifecycle,
        "automation_id": automation_id,
        "task_id": task_id,
        # The room/profile identity is task-scoped.  run_id and the current
        # authority digest are fresh-run attestation fields, not room keys;
        # including them would create a new temporary profile on every turn.
        "authority_scope": authority_scope,
        "account_identity": account_identity,
        "origins": sorted({normalize_origin(item) for item in origins}),
        "origin": sorted({normalize_origin(item) for item in origins})[0],
    }
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def temporary_profile_path(config: dict[str, Any], binding: str) -> str:
    root = os.path.realpath(config["roots"]["temporary_profiles"])
    if not re.fullmatch(r"[0-9a-f]{64}", binding):
        raise Blocker("browser_use_temporary_binding_invalid")
    return os.path.join(root, binding)


def temporary_port(config: dict[str, Any], binding: str) -> int:
    start = int(config["ports"]["temporary_start"])
    end = int(config["ports"]["temporary_end"])
    return start + (int(binding[:16], 16) % (end - start + 1))


def temporary_profile_lock_path(config: dict[str, Any], profile: str) -> str:
    return os.path.join(config["roots"]["locks"], f"temporary-profile-{hashlib.sha256(os.path.realpath(profile).encode()).hexdigest()[:24]}.lock")


def temporary_port_lock_path(config: dict[str, Any], port: int) -> str:
    return os.path.join(config["roots"]["locks"], f"port-{port}.lock")


def temporary_marker_value(
    config: dict[str, Any],
    *,
    profile: str,
    mode: str,
    automation_id: str,
    task_id: str,
    run_id: str,
    binding: str,
    port: int,
    authority_digest: str,
    authority_scope: dict[str, Any],
    account_identity: str,
    origins: list[str],
    created_at: str,
) -> dict[str, Any]:
    created = dt.datetime.fromisoformat(created_at.replace("Z", "+00:00"))
    expires_at = iso(created + dt.timedelta(seconds=TEMPORARY_TTL_SECONDS))
    return {
        "schema": TEMPORARY_PROFILE_MARKER_SCHEMA,
        "version": 2,
        "mode": mode,
        "lifecycle": TEMPORARY_LIFECYCLE,
        "automation_id": automation_id,
        "task_id": task_id,
        "run_id": run_id,
        "creation_binding": binding,
        "canonical_profile": os.path.realpath(profile),
        "created_at": created_at,
        "expires_at": expires_at,
        "port": port,
        "authority_sha256": authority_digest,
        "authority_scope": authority_scope,
        "account_identity": account_identity,
        "origins": sorted({normalize_origin(item) for item in origins}),
        "origin": sorted({normalize_origin(item) for item in origins})[0],
        "profile_lock_path": os.path.realpath(temporary_profile_lock_path(config, profile)),
        "port_lock_path": os.path.realpath(temporary_port_lock_path(config, port)),
        "owner_uid": EUID,
    }


def _parse_temporary_time(value: Any, field: str) -> dt.datetime:
    try:
        parsed = dt.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except (TypeError, ValueError) as exc:
        raise Blocker("browser_use_temporary_marker_time_invalid", field) from exc
    if parsed.tzinfo is None:
        raise Blocker("browser_use_temporary_marker_time_invalid", field)
    return parsed.astimezone(dt.timezone.utc)


def validate_temporary_marker(
    config: dict[str, Any],
    profile: str,
    expected: dict[str, Any],
    *,
    require_unexpired: bool = True,
) -> dict[str, Any]:
    root = os.path.realpath(config["roots"]["temporary_profiles"])
    if os.path.realpath(profile) != profile or not profile.startswith(root + os.sep):
        raise Blocker("browser_use_temporary_profile_scope_mismatch")
    assert_directory(profile)
    marker_path = os.path.join(profile, ".browser-use-profile.json")
    assert_regular_file(marker_path, mode=0o600)
    marker = read_json_safe(marker_path)
    required = {"schema", "version", "mode", "lifecycle", "automation_id", "task_id", "run_id", "creation_binding", "canonical_profile", "created_at", "expires_at", "port", "authority_sha256", "authority_scope", "account_identity", "origins", "origin", "profile_lock_path", "port_lock_path", "owner_uid"}
    if marker.get("schema") != TEMPORARY_PROFILE_MARKER_SCHEMA or marker.get("version") != 2 or not required.issubset(marker):
        raise Blocker("browser_use_temporary_marker_invalid")
    immutable_fields = ("mode", "lifecycle", "automation_id", "task_id", "creation_binding", "canonical_profile", "port", "authority_scope", "account_identity", "origins")
    for field in immutable_fields:
        if marker.get(field) != expected.get(field):
            raise Blocker("browser_use_temporary_binding_mismatch", field)
    if marker.get("canonical_profile") != profile or marker.get("owner_uid") != EUID:
        raise Blocker("browser_use_temporary_marker_binding_invalid")
    if not isinstance(marker.get("origins"), list) or not marker["origins"] or marker.get("origin") != sorted(marker["origins"])[0]:
        raise Blocker("browser_use_temporary_origin_binding_invalid")
    if marker.get("profile_lock_path") != os.path.realpath(temporary_profile_lock_path(config, profile)) or marker.get("port_lock_path") != os.path.realpath(temporary_port_lock_path(config, int(marker["port"]))):
        raise Blocker("browser_use_temporary_lock_binding_invalid")
    created = _parse_temporary_time(marker.get("created_at"), "created_at")
    expires = _parse_temporary_time(marker.get("expires_at"), "expires_at")
    if expires != created + dt.timedelta(seconds=TEMPORARY_TTL_SECONDS):
        raise Blocker("browser_use_temporary_ttl_immutable_violation")
    if require_unexpired and expires <= now_utc():
        raise Blocker("browser_use_temporary_profile_expired")
    return marker


def prepare_temporary_profile(
    config: dict[str, Any],
    *,
    mode: str,
    automation_id: str,
    task_id: str,
    run_id: str,
    authority_digest: str,
    authority_scope: dict[str, Any],
    account_identity: str,
    origins: list[str],
    download_dir: str,
    requested_port: int | None = None,
) -> dict[str, Any]:
    if mode != "authorized":
        raise Blocker("browser_use_temporary_requires_authorized_mode")
    task_id = safe_id(task_id, "task_id")
    binding = temporary_binding(mode=mode, lifecycle=TEMPORARY_LIFECYCLE, automation_id=automation_id, task_id=task_id, run_id=run_id, authority_digest=authority_digest, authority_scope=authority_scope, account_identity=account_identity, origins=origins)
    profile = temporary_profile_path(config, binding)
    port = requested_port if requested_port is not None else temporary_port(config, binding)
    if requested_port is not None and requested_port != port:
        raise Blocker("browser_use_temporary_fixed_port_mismatch")
    profile_lock = temporary_profile_lock_path(config, profile)
    payload = {"schema": "browser-use-lock.v1", "run_id": run_id, "nonce": binding, "helper_pid": os.getpid(), "helper_start_time": psutil.Process(os.getpid()).create_time(), "automation_id": automation_id, "task_id": task_id, "port": port, "canonical_profile": profile, "lifecycle": TEMPORARY_LIFECYCLE}
    lock_file(profile_lock, payload)
    try:
        assert_directory(os.path.dirname(profile), create=True)
        if os.path.lexists(profile):
            if os.path.islink(profile):
                raise Blocker("browser_use_temporary_profile_symlink")
            expected = temporary_marker_value(config, profile=profile, mode=mode, automation_id=automation_id, task_id=task_id, run_id=run_id, binding=binding, port=port, authority_digest=authority_digest, authority_scope=authority_scope, account_identity=account_identity, origins=origins, created_at="1970-01-01T00:00:00Z")
            marker_path = os.path.join(profile, ".browser-use-profile.json")
            existing = read_json_safe(marker_path) if os.path.lexists(marker_path) else {}
            expected.update({"created_at": existing.get("created_at"), "expires_at": existing.get("expires_at")})
            validate_temporary_marker(config, profile, expected)
        else:
            os.mkdir(profile, 0o700)
            created_at = iso(now_utc())
            marker = temporary_marker_value(config, profile=profile, mode=mode, automation_id=automation_id, task_id=task_id, run_id=run_id, binding=binding, port=port, authority_digest=authority_digest, authority_scope=authority_scope, account_identity=account_identity, origins=origins, created_at=created_at)
            json_atomic_no_replace(os.path.join(profile, ".browser-use-profile.json"), marker)
            assert_directory(os.path.join(profile, "Default"), create=True)
            json_atomic_no_replace(os.path.join(profile, "Default", "Preferences"), {"download": {"default_directory": download_dir, "prompt_for_download": False, "directory_upgrade": True}})
        marker = validate_temporary_marker(config, profile, temporary_marker_value(config, profile=profile, mode=mode, automation_id=automation_id, task_id=task_id, run_id=run_id, binding=binding, port=port, authority_digest=authority_digest, authority_scope=authority_scope, account_identity=account_identity, origins=origins, created_at=read_json_safe(os.path.join(profile, ".browser-use-profile.json"))["created_at"]))
        return {"profile": profile, "binding": binding, "port": port, "profile_lock": profile_lock, "marker": marker}
    except Exception:
        try:
            release_lock(profile_lock, run_id, binding)
        except Exception:
            pass
        raise


def prepare_profile(profile: str, scheduled: bool, automation_id: str, download_dir: str, run_id: str, nonce: str) -> None:
    parent = os.path.dirname(profile)
    assert_directory(parent, create=True)
    if not scheduled and os.path.lexists(profile):
        raise Blocker("browser_use_single_use_profile_already_exists")
    if scheduled and os.path.lexists(profile):
        if os.path.islink(profile):
            raise Blocker("browser_use_profile_symlink")
        assert_directory(profile)
    else:
        try:
            os.mkdir(profile, 0o700)
        except FileExistsError as exc:
            raise Blocker("browser_use_single_use_profile_already_exists") from exc
    assert_directory(profile)
    default_dir = os.path.join(profile, "Default")
    assert_directory(default_dir, create=True)
    marker = os.path.join(profile, ".browser-use-profile.json")
    marker_value = {"schema": "browser-use-profile.v1", "automation_id": automation_id, "run_id": run_id if not scheduled else "persistent", "nonce": nonce if not scheduled else "persistent"}
    if os.path.exists(marker):
        existing = read_json_safe(marker)
        if existing.get("automation_id") != automation_id:
            raise Blocker("browser_use_profile_automation_mismatch")
    else:
        json_atomic_no_replace(marker, marker_value)
    preferences = os.path.join(default_dir, "Preferences")
    if not os.path.exists(preferences):
        json_atomic_no_replace(preferences, {"download": {"default_directory": download_dir, "prompt_for_download": False, "directory_upgrade": True}})
    else:
        assert_regular_file(preferences, mode=0o600)


def process_matches(process: Any, chrome_path: str, port: int, profile: str) -> bool:
    try:
        if not process.is_running():
            return False
        command_line = process.cmdline()
        required = {
            "--remote-debugging-address=127.0.0.1",
            f"--remote-debugging-port={port}",
            f"--user-data-dir={profile}",
            "--profile-directory=Default",
        }
        return chrome_path in command_line and required.issubset(set(command_line))
    except (psutil.Error, OSError):
        return False


def launch_chrome(config: dict[str, Any], profile: str, port: int, download_dir: str, home: str) -> tuple[subprocess.Popen[bytes], dict[str, Any]]:
    chrome = config["executables"]["chrome"]["canonical_path"]
    if port_listener(port) or lsof_listener(port):
        raise Blocker("browser_use_port_already_listening", str(port))
    args = [chrome, "--remote-debugging-address=127.0.0.1", f"--remote-debugging-port={port}", f"--user-data-dir={profile}", "--profile-directory=Default", f"--download-default-directory={download_dir}", "--no-first-run", "--no-default-browser-check"]
    started_at = time.time()
    proc = subprocess.Popen(
        args,
        cwd=home,
        env=make_env(home),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        close_fds=True,
        start_new_session=True,
    )
    root_start = psutil.Process(proc.pid).create_time()
    deadline = time.monotonic() + 30
    matched: Any = None
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            raise Blocker("browser_use_chrome_exited_before_attach")
        if port_listener(port) and lsof_listener(port):
            try:
                root = psutil.Process(proc.pid)
                candidates = [root] + root.children(recursive=True)
                matched = next((candidate for candidate in candidates if process_matches(candidate, chrome, port, profile) and candidate.create_time() >= started_at - 1), None)
            except psutil.Error:
                matched = None
            if matched is not None:
                return proc, {"pid": matched.pid, "start_time": matched.create_time(), "root_pid": proc.pid, "root_start_time": root_start}
        time.sleep(0.25)
    raise Blocker("browser_use_chrome_process_identity_unverified")


def terminate_chrome(proc: subprocess.Popen[bytes] | None, identity: dict[str, Any] | None, chrome_path: str, port: int, profile: str) -> tuple[bool, str | None]:
    if identity is None:
        return False, "browser_use_process_identity_unavailable"
    try:
        candidate = psutil.Process(identity["root_pid"])
        if abs(candidate.create_time() - identity["root_start_time"]) > 0.5 or not process_matches(candidate, chrome_path, port, profile):
            return False, "browser_use_unknown_process_not_killed"
        candidate.terminate()
        try:
            candidate.wait(timeout=10)
        except psutil.TimeoutExpired:
            return False, "browser_use_chrome_did_not_exit"
    except psutil.NoSuchProcess:
        pass
    except psutil.Error:
        return False, "browser_use_process_identity_recheck_failed"
    try:
        assert_debug_listener_absent(port)
    except Blocker as exc:
        return False, exc.code
    return True, None


def verify_chrome_absent(chrome_path: str, port: int, profile: str) -> None:
    """Prove that a failed launch left no matching process or listener.

    A launch can fail before ``launch_chrome`` returns its process identity.
    In that case there is no verified process object that this helper may
    terminate.  We may still complete cleanup when two independent checks
    prove that the exact run-owned profile/port has no matching Chrome
    process and no listener.  A matching process is never killed here; it is
    reported as uncertain for the lifecycle owner to resolve.
    """
    if psutil is None:
        raise Blocker("browser_use_process_identity_recheck_failed")
    try:
        candidates = psutil.process_iter()
        for candidate in candidates:
            try:
                if process_matches(candidate, chrome_path, port, profile):
                    raise Blocker("browser_use_chrome_process_cleanup_unverified")
            except psutil.NoSuchProcess:
                continue
            except psutil.AccessDenied as exc:
                raise Blocker("browser_use_process_identity_recheck_failed") from exc
            except psutil.Error as exc:
                raise Blocker("browser_use_process_identity_recheck_failed") from exc
    except Blocker:
        raise
    except psutil.Error as exc:
        raise Blocker("browser_use_process_identity_recheck_failed") from exc
    assert_debug_listener_absent(port)


def close_owned_daemon_if_active(config: dict[str, Any], home: str, port: int, session: str) -> tuple[bool, str | None]:
    """Close only the daemon proven to belong to this helper session.

    Browser Use stores a pid and Unix socket under its dedicated home. On an
    error path, Chrome can be cleaned up while the daemon remains alive. Never
    kill an unverified process; ask the matching daemon to close and verify its
    markers disappear instead.
    """
    if browser_harness_cli_enabled():
        try:
            result = run_browser_harness_reload(config, home, port, session)
        except (OSError, subprocess.SubprocessError):
            return False, "browser_use_daemon_close_failed"
        if result.returncode != 0:
            return False, "browser_use_daemon_close_failed"
        runtime = os.path.join(browser_harness_root(session), "runtime")
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            if not any(os.path.lexists(os.path.join(runtime, name)) for name in ("bu.sock", "bu.pid", "bu.port")):
                return (True, None) if cleanup_browser_harness_root(session) else (False, "browser_use_harness_root_cleanup_unverified")
            time.sleep(0.1)
        return False, "browser_use_daemon_cleanup_unverified"

    raise Blocker("browser_use_legacy_cli_protocol_rejected")


def run_cli3_session(config: dict[str, Any], home: str, port: int, session: str, command: list[str], readback: bool, *, close_after: bool, recording: dict[str, Any] | None = None, diagnostic: bool = False) -> tuple[int, int | None]:
    global _LAST_RECORDING_CLI_FAILURE, _LAST_CLI_FAILURE
    if recording is not None:
        _LAST_RECORDING_CLI_FAILURE = ""
    if diagnostic:
        _LAST_CLI_FAILURE = ""
    if command[0] == "close":
        close_result = run_browser_harness_reload(config, home, port, session)
        if close_result.returncode == 0 and not cleanup_browser_harness_root(session):
            close_result.returncode = 1
        return close_result.returncode, None
    browser = config["executables"]["browser_use"]["canonical_path"]
    capture = recording is not None or diagnostic
    try:
        result = subprocess.run(
            [browser],
            input=browser_harness_script(command),
            cwd=home,
            env=browser_harness_env(home, port, session, recording),
            stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
            stderr=subprocess.PIPE if capture else subprocess.DEVNULL,
            text=True,
            timeout=180,
        )
    except (OSError, subprocess.SubprocessError):
        if recording is not None:
            _LAST_RECORDING_CLI_FAILURE = "browser_use_cli3_launch_failed"
        if diagnostic:
            _LAST_CLI_FAILURE = "browser_use_cli3_launch_failed"
        return 1, 1 if readback else None
    if result.returncode != 0:
        marker = recording_cli_failure_marker(result.stderr or "")
        logging.critical("browser_use_cli3_failed command=%s returncode=%s marker=%s", command[0], result.returncode, marker)
        if recording is not None:
            _LAST_RECORDING_CLI_FAILURE = marker
        if diagnostic:
            _LAST_CLI_FAILURE = marker
    readback_exit: int | None = None
    if readback and command[0] not in {"close", "close-tab"}:
        try:
            check = subprocess.run(
                [browser],
                input=browser_harness_script(["state"]),
                cwd=home,
                env=browser_harness_env(home, port, session, recording),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE if capture else subprocess.DEVNULL,
                text=True,
                timeout=120,
            )
            readback_exit = check.returncode
            if check.returncode != 0:
                logging.critical("browser_use_cli3_readback_failed command=%s returncode=%s marker=%s", command[0], check.returncode, recording_cli_failure_marker(check.stderr or ""))
            if check.returncode != 0 and diagnostic and not _LAST_CLI_FAILURE:
                _LAST_CLI_FAILURE = recording_cli_failure_marker(check.stderr or "")
        except (OSError, subprocess.SubprocessError):
            readback_exit = 1
            if diagnostic and not _LAST_CLI_FAILURE:
                _LAST_CLI_FAILURE = "browser_use_cli3_readback_failed"
    if close_after:
        close_result = run_browser_harness_reload(config, home, port, session)
        if result.returncode == 0 and close_result.returncode != 0:
            result.returncode = close_result.returncode
        if result.returncode == 0 and close_result.returncode == 0 and not cleanup_browser_harness_root(session):
            result.returncode = 1
    return result.returncode, readback_exit


def run_cli_session(config: dict[str, Any], home: str, port: int, session: str, command: list[str], readback: bool, *, close_after: bool, recording: dict[str, Any] | None = None, diagnostic: bool = False) -> tuple[int, int | None]:
    browser_harness_cli_enabled()
    return run_cli3_session(config, home, port, session, command, readback, close_after=close_after, recording=recording, diagnostic=diagnostic)


def run_cli(config: dict[str, Any], home: str, port: int, session: str, command: list[str], readback: bool, *, recording: dict[str, Any] | None = None, diagnostic: bool = False) -> tuple[int, int | None]:
    return run_cli_session(config, home, port, session, command, readback, close_after=True, recording=recording, diagnostic=diagnostic)


def run_cli3_with_post_commands(config: dict[str, Any], home: str, port: int, session: str, command: list[str], readback: bool, post_commands: list[list[str]], *, recording: dict[str, Any] | None = None) -> tuple[int, int | None, dict[str, str]]:
    browser = config["executables"]["browser_use"]["canonical_path"]
    env = browser_harness_env(home, port, session, recording)
    result = subprocess.run(
        [browser],
        input=browser_harness_script(command),
        cwd=home,
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=180,
    )
    if result.returncode != 0:
        logging.critical("browser_use_cli3_post_command_failed command=%s returncode=%s marker=%s", command[0], result.returncode, recording_cli_failure_marker(result.stderr or ""))
    captured: dict[str, str] = {}
    if result.returncode == 0:
        for index, post_command in enumerate(post_commands):
            post_result = subprocess.run(
                [browser],
                input=browser_harness_script(post_command),
                cwd=home,
                env=env,
                stdout=subprocess.PIPE if post_command[0] in {"state", "get", "eval", "extract"} else subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=120,
            )
            if post_command[0] in {"state", "get", "eval", "extract"}:
                captured[str(index)] = (post_result.stdout or "")[-65536:]
            if post_result.returncode != 0:
                logging.critical("browser_use_cli3_post_readback_failed command=%s returncode=%s marker=%s", post_command[0], post_result.returncode, recording_cli_failure_marker(post_result.stderr or ""))
                result.returncode = post_result.returncode
                break
    readback_exit: int | None = None
    if readback and command[0] not in {"close", "close-tab"}:
        check = subprocess.run(
            [browser],
            input=browser_harness_script(["state"]),
            cwd=home,
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=120,
        )
        readback_exit = check.returncode
        if check.returncode != 0:
            logging.critical("browser_use_cli3_post_state_failed command=%s returncode=%s marker=%s", command[0], check.returncode, recording_cli_failure_marker(check.stderr or ""))
    close_result = run_browser_harness_reload(config, home, port, session)
    if result.returncode == 0 and close_result.returncode != 0:
        result.returncode = close_result.returncode
    if result.returncode == 0 and close_result.returncode == 0 and not cleanup_browser_harness_root(session):
        result.returncode = 1
    return result.returncode, readback_exit, captured


def run_cli_with_post_commands(config: dict[str, Any], home: str, port: int, session: str, command: list[str], readback: bool, post_commands: list[list[str]], *, recording: dict[str, Any] | None = None) -> tuple[int, int | None, dict[str, str]]:
    browser_harness_cli_enabled()
    return run_cli3_with_post_commands(config, home, port, session, command, readback, post_commands, recording=recording)


def run_cli_keep_alive(config: dict[str, Any], home: str, port: int, session: str, command: list[str], readback: bool, *, recording: dict[str, Any] | None = None, diagnostic: bool = False) -> tuple[int, int | None]:
    return run_cli_session(config, home, port, session, command, readback, close_after=False, recording=recording, diagnostic=diagnostic)


def run_cli3_keep_alive_capture(config: dict[str, Any], home: str, port: int, session: str, command: list[str], *, recording: dict[str, Any] | None = None) -> tuple[int, int | None, str]:
    global _LAST_RECORDING_CLI_FAILURE
    _LAST_RECORDING_CLI_FAILURE = ""
    browser = config["executables"]["browser_use"]["canonical_path"]
    env = browser_harness_env(home, port, session, recording)
    script_builder = browser_harness_ax_script if command and command[0] in {"ax-inspect", "ax-click"} else browser_harness_script
    try:
        result = subprocess.run(
            [browser],
            input=script_builder(command),
            cwd=home,
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=180,
        )
    except (OSError, subprocess.SubprocessError):
        _LAST_RECORDING_CLI_FAILURE = "browser_use_cli3_capture_failed"
        return 1, 1, ""
    if result.returncode != 0:
        _LAST_RECORDING_CLI_FAILURE = recording_cli_failure_marker(result.stderr or "")
    try:
        check = subprocess.run(
            [browser],
            input=browser_harness_script(["state"]),
            cwd=home,
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            timeout=120,
        )
    except (OSError, subprocess.SubprocessError):
        check = None
    if check is None:
        readback_exit = 1
        if not _LAST_RECORDING_CLI_FAILURE:
            _LAST_RECORDING_CLI_FAILURE = "browser_use_cli3_capture_readback_failed"
    else:
        readback_exit = check.returncode
        if check.returncode != 0 and not _LAST_RECORDING_CLI_FAILURE:
            _LAST_RECORDING_CLI_FAILURE = recording_cli_failure_marker(check.stderr or "")
    # CLI 3.0 state is a fresh DOM snapshot. Keep enough transient output to
    # parse the JSON envelope without persisting it; the caller still emits
    # only hashed/non-secret target metadata into durable receipts.
    return result.returncode, readback_exit, (result.stdout or "")[-524288:]


def run_cli_keep_alive_capture(config: dict[str, Any], home: str, port: int, session: str, command: list[str], *, recording: dict[str, Any] | None = None) -> tuple[int, int | None, str]:
    browser_harness_cli_enabled()
    return run_cli3_keep_alive_capture(config, home, port, session, command, recording=recording)


def _plain_capture_response(command: list[str], stdout: str) -> dict[str, Any]:
    """Normalize safe non-JSON CLI output for the existing readback parsers."""
    text = str(stdout or "")
    if command == ["state"]:
        return {"success": True, "data": {"_raw_text": text}}
    if len(command) == 3 and command[0] == "get" and command[1] in {"attributes", "bbox"}:
        field = command[1]
        match = re.search(rf"(?m)^{re.escape(field)}:\s*(.+)$", text)
        if match:
            try:
                value = ast.literal_eval(match.group(1).strip())
            except (SyntaxError, ValueError):
                value = None
            if isinstance(value, dict):
                return {"success": True, "data": {"index": int(command[2]), field: value}}
    return {"success": True, "data": {"_raw_text": text}}


P5_PUBLIC_ORIGIN = "https://example.com"
P5_PUBLIC_URL = "https://example.com/"
P5_PUBLIC_TITLE = "Example Domain"
P5_PUBLIC_TITLE_SHA256 = hashlib.sha256(P5_PUBLIC_TITLE.encode("utf-8")).hexdigest()


def _json_values(value: Any):
    yield value
    if isinstance(value, dict):
        for child in value.values():
            yield from _json_values(child)
    elif isinstance(value, list):
        for child in value:
            yield from _json_values(child)


def _first_field(value: Any, names: set[str]) -> Any:
    for child in _json_values(value):
        if isinstance(child, dict):
            for key, item in child.items():
                if str(key).lower() in names:
                    return item
    return None


def _parse_cli_json(stdout: str) -> Any:
    candidates: list[Any] = []
    for line in str(stdout or "").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            candidates.append(json.loads(line))
        except (TypeError, ValueError, json.JSONDecodeError):
            continue
    if not candidates:
        raise Blocker("browser_use_semantic_readback_json_missing")
    return candidates[-1]


# Target resolution is intentionally implemented at the canonical helper
# boundary.  Browser Use element indexes are fresh-state scoped, so callers
# must never persist or replay an index from an earlier state snapshot.
_STATE_ELEMENT_RE = re.compile(
    r"^(?P<indent>\s*)\[(?P<index>\d+)\]<(?P<tag>[A-Za-z][A-Za-z0-9:_-]*)"
    r"(?P<attrs>[^>]*)>?(?P<inline>.*)$"
)
_STATE_ATTRIBUTE_RE = re.compile(
    r"(?P<name>[A-Za-z_:][A-Za-z0-9_.:-]*)"
    r"(?:\s*=\s*(?:\"(?P<double>[^\"]*)\"|'(?P<single>[^']*)'|(?P<bare>[^\s>]+)))?"
)
_INTERACTIVE_TAGS = {"a", "button", "input", "select", "textarea", "summary"}
_INTERACTIVE_ROLES = {
    "button",
    "checkbox",
    "combobox",
    "link",
    "menuitem",
    "option",
    "radio",
    "switch",
    "tab",
    "textbox",
}


def _state_text_from_cli(parsed: Any) -> str:
    """Extract only the transient state text needed for target resolution."""
    for value in _json_values(parsed):
        if isinstance(value, str) and re.search(r"\[\d+\]<[A-Za-z]", value):
            return value
    raise Blocker("browser_use_target_state_shape_invalid")


def _state_attr_map(raw: str) -> dict[str, str]:
    attrs: dict[str, str] = {}
    for match in _STATE_ATTRIBUTE_RE.finditer(raw or ""):
        name = match.group("name").lower()
        value = match.group("double")
        if value is None:
            value = match.group("single")
        if value is None:
            value = match.group("bare")
        attrs[name] = "" if value is None else value
    return attrs


def _state_candidates(state_text: str, target_text: str) -> list[dict[str, Any]]:
    """Return fresh candidates without retaining page text in durable state."""
    normalized_target = " ".join(str(target_text).split()).casefold()
    if not normalized_target:
        raise Blocker("browser_use_target_text_missing")
    lines = str(state_text).splitlines()
    elements: list[dict[str, Any]] = []
    for line_no, line in enumerate(lines):
        match = _STATE_ELEMENT_RE.match(line)
        if not match:
            continue
        indent = len(match.group("indent").replace("\t", "    "))
        inline = match.group("inline").strip()
        elements.append(
            {
                "line_no": line_no,
                "indent": indent,
                "index": int(match.group("index")),
                "tag": match.group("tag").lower(),
                "attributes": _state_attr_map(match.group("attrs")),
                "inline": inline,
            }
        )
    matches: list[dict[str, Any]] = []
    for position, candidate in enumerate(elements):
        end = len(lines)
        for following in elements[position + 1 :]:
            if following["indent"] <= candidate["indent"]:
                end = following["line_no"]
                break
        text_parts = [candidate["inline"]] if candidate["inline"] else []
        for line in lines[candidate["line_no"] + 1 : end]:
            stripped = line.strip()
            if stripped.startswith("|scroll element|"):
                break
            line_indent = len(line[: len(line) - len(line.lstrip(" \t"))].replace("\t", "    "))
            # Browser Use state can emit page/scroll markers at the same or a
            # shallower indentation than the preceding element.  They are
            # structural text, not descendants of that element; associating
            # them with the previous image/avatar is an unsafe false match.
            if stripped and line_indent > candidate["indent"] and not _STATE_ELEMENT_RE.match(line):
                text_parts.append(stripped)
        candidate_text = " ".join(" ".join(text_parts).split())
        if normalized_target not in candidate_text.casefold():
            continue
        matches.append(
            {
                "index": candidate["index"],
                "tag": candidate["tag"],
                "indent": candidate["indent"],
                "attributes": candidate["attributes"],
                "text_length": len(candidate_text),
                "match_text_sha256": hashlib.sha256(candidate_text.encode("utf-8")).hexdigest(),
            }
        )
    # Prefer the most specific (deepest) element.  Ties are deterministic and
    # still require a unique index, preventing an ambiguous text match from
    # turning into an arbitrary click.
    matches.sort(key=lambda item: (-int(item["indent"]), int(item["index"])))
    if not matches:
        raise Blocker("browser_use_target_not_found")
    deepest = int(matches[0]["indent"])
    selected = [item for item in matches if int(item["indent"]) == deepest]
    if len({int(item["index"]) for item in selected}) != 1:
        raise Blocker("browser_use_target_ambiguous")
    return matches


def _attributes_from_cli(parsed: Any) -> dict[str, str]:
    value = _first_field(parsed, {"attributes", "attrs"})
    if isinstance(value, dict):
        return {str(key).lower(): str(item) for key, item in value.items() if isinstance(key, str)}
    if isinstance(value, str):
        return _state_attr_map(value)
    return {}


def _bbox_from_cli(parsed: Any) -> dict[str, float]:
    for value in _json_values(parsed):
        if not isinstance(value, dict):
            continue
        lowered = {str(key).lower(): item for key, item in value.items()}
        try:
            if {"x", "y", "width", "height"}.issubset(lowered):
                bbox = {key: float(lowered[key]) for key in ("x", "y", "width", "height")}
            elif {"left", "top", "right", "bottom"}.issubset(lowered):
                bbox = {
                    "x": float(lowered["left"]),
                    "y": float(lowered["top"]),
                    "width": float(lowered["right"]) - float(lowered["left"]),
                    "height": float(lowered["bottom"]) - float(lowered["top"]),
                }
            else:
                continue
        except (TypeError, ValueError):
            continue
        if all(math.isfinite(item) for item in bbox.values()) and bbox["width"] > 0 and bbox["height"] > 0:
            return bbox
    raise Blocker("browser_use_target_bbox_invalid")


def _cli_coordinate(value: float) -> str:
    """Use Browser Use CLI's integer coordinate form when exact."""
    if float(value).is_integer():
        return str(int(value))
    return f"{value:.2f}".rstrip("0").rstrip(".")


def _target_is_interactive(candidate: dict[str, Any], attributes: dict[str, str]) -> bool:
    merged = {str(key).lower(): str(value) for key, value in candidate.get("attributes", {}).items()}
    merged.update({str(key).lower(): str(value) for key, value in attributes.items()})
    tag = str(candidate.get("tag") or "").lower()
    role = merged.get("role", "").lower()
    input_type = merged.get("type", "").lower()
    tabindex = merged.get("tabindex", "")
    return (
        tag in _INTERACTIVE_TAGS
        or role in _INTERACTIVE_ROLES
        or input_type in {"button", "submit", "reset", "checkbox", "radio"}
        or (tabindex.lstrip("-").isdigit() and int(tabindex) >= 0)
        or candidate.get("hasInlineHandler") is True
        or any(merged.get(name, "").strip() for name in ("onclick", "onmousedown", "onpointerdown"))
    )


def _target_state_summary(parsed: Any, raw_state: str) -> dict[str, Any]:
    """Return non-secret evidence, never the raw page state."""
    return {
        "state_sha256": hashlib.sha256(raw_state.encode("utf-8")).hexdigest(),
        "state_length": len(raw_state),
        "url_sha256": hashlib.sha256(str(_first_field(parsed, {"url", "href"}) or "").encode("utf-8")).hexdigest(),
        "title_sha256": hashlib.sha256(str(_first_field(parsed, {"title"}) or "").encode("utf-8")).hexdigest(),
    }


def _target_capture(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    recording: dict[str, Any],
    target_text: str,
) -> tuple[dict[str, Any], dict[str, Any]]:
    """Resolve a target from one fresh state and collect fresh metadata."""
    home = config["roots"]["browser_use_home"]
    port = descriptor["port"]
    session = descriptor["session"]

    def capture(command: list[str]) -> Any:
        if browser_harness_cli_enabled() and command and command[0] in {"ax-inspect", "ax-click"}:
            # A stale Browser Harness attachment can break a read-only AX
            # probe even when the run-owned Chrome and page are healthy. One
            # reload/rebind is safe for inspect; never retry a click because
            # its dispatch result can be ambiguous.
            max_attempts = 2 if command[0] == "ax-inspect" else 1
            code = 1
            readback_exit = 1
            stdout = ""
            for attempt in range(max_attempts):
                code, readback_exit, stdout = run_cli_keep_alive_capture(config, home, port, session, command, recording=recording)
                if code == 0 and readback_exit == 0:
                    break
                if attempt + 1 < max_attempts:
                    try:
                        refresh_exit = run_browser_harness_reload(config, home, port, session)
                    except (OSError, subprocess.SubprocessError):
                        refresh_exit = 1
                    if refresh_exit != 0:
                        break
            if code != 0:
                raise Blocker("browser_use_target_command_failed", _LAST_RECORDING_CLI_FAILURE or command[0])
            if readback_exit != 0:
                raise Blocker("browser_use_target_readback_failed", str(readback_exit))
            return _parse_cli_json(stdout)
        validate_command(command, descriptor["mode"], config, list(descriptor["target_origins"]), descriptor["download_dir"])
        code, readback_exit, stdout = run_cli_keep_alive_capture(config, home, port, session, command, recording=recording)
        if code != 0:
            raise Blocker("browser_use_target_command_failed", _LAST_RECORDING_CLI_FAILURE or command[0])
        if readback_exit != 0:
            raise Blocker("browser_use_target_readback_failed", str(readback_exit))
        return _parse_cli_json(stdout)

    if browser_harness_cli_enabled():
        parsed = capture(["ax-inspect", target_text])
        data = parsed.get("data") if isinstance(parsed, dict) else None
        candidate = data.get("candidate") if isinstance(data, dict) else None
        before = data.get("before") if isinstance(data, dict) else None
        if candidate is not None and not isinstance(candidate, dict):
            raise Blocker("browser_use_ax_target_readback_shape_invalid")
        if not isinstance(before, dict):
            raise Blocker("browser_use_ax_target_readback_shape_invalid")
        if candidate is None:
            candidate = {
                "backend_present": False,
                "interactive": False,
                "match_status": "not_found",
                "match_text_sha256": hashlib.sha256(str(target_text).encode("utf-8")).hexdigest(),
            }
        return candidate, before

    state_parsed = capture(["state"])
    state_raw = _state_text_from_cli(state_parsed)
    candidates = _state_candidates(state_raw, target_text)
    candidate = candidates[0]
    index = str(candidate["index"])
    attrs_parsed = capture(["get", "attributes", index])
    attributes = _attributes_from_cli(attrs_parsed)
    merged_attributes = dict(candidate.get("attributes") or {})
    merged_attributes.update(attributes)
    bbox_parsed = capture(["get", "bbox", index])
    bbox = _bbox_from_cli(bbox_parsed)
    candidate = {
        "index": int(candidate["index"]),
        "tag": candidate["tag"],
        "text_length": candidate["text_length"],
        "match_text_sha256": candidate["match_text_sha256"],
        "interactive": _target_is_interactive(candidate, merged_attributes),
        "attributes": {
            key: merged_attributes[key]
            for key in sorted(merged_attributes)
            if key in {"role", "type", "tabindex", "href", "aria-label", "data-testid"}
        },
        "bbox": bbox,
    }
    return candidate, _target_state_summary(state_parsed, state_raw)


def _verified_current_origin(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    recording: dict[str, Any],
    *,
    expected_origins: list[str] | None = None,
    expected_url: str | None = None,
    return_evidence: bool = False,
) -> str | dict[str, Any]:
    """Read the current URL in-flow and prove it is an authorized origin."""
    code, readback_exit, stdout = run_cli_keep_alive_capture(
        config,
        config["roots"]["browser_use_home"],
        descriptor["port"],
        descriptor["session"],
        ["get", "url"],
        recording=recording,
    )
    if code != 0:
        raise Blocker("browser_use_navigation_url_readback_failed", _LAST_RECORDING_CLI_FAILURE or str(code))
    if readback_exit != 0:
        raise Blocker("browser_use_navigation_url_readback_failed", str(readback_exit))
    try:
        parsed = _parse_cli_json(stdout)
        current_url = _first_field(parsed, {"url", "href"})
        parsed_url = urllib.parse.urlparse(str(current_url or ""))
        if parsed_url.scheme not in {"http", "https"} or parsed_url.username or parsed_url.password or not parsed_url.hostname:
            raise Blocker("browser_use_navigation_url_invalid")
        host = parsed_url.hostname.lower().rstrip(".")
        port = parsed_url.port
        port_suffix = f":{port}" if port and not ((parsed_url.scheme == "http" and port == 80) or (parsed_url.scheme == "https" and port == 443)) else ""
        current_origin = normalize_origin(f"{parsed_url.scheme}://{host}{port_suffix}")
        if expected_url:
            expected = urllib.parse.urlparse(str(expected_url))
            expected_host = (expected.hostname or "").lower().rstrip(".")
            expected_port = expected.port
            expected_origin = normalize_origin(f"{expected.scheme}://{expected_host}{f':{expected_port}' if expected_port and not ((expected.scheme == 'http' and expected_port == 80) or (expected.scheme == 'https' and expected_port == 443)) else ''}")
            if current_origin != expected_origin or parsed_url.path != (expected.path or "/") or parsed_url.query != expected.query or parsed_url.fragment != expected.fragment:
                raise Blocker("browser_use_navigation_exact_url_mismatch")
    except Blocker as exc:
        if exc.code == "browser_use_navigation_exact_url_mismatch":
            raise
        raise Blocker("browser_use_navigation_url_invalid") from exc
    allowed = expected_origins if expected_origins is not None else descriptor["target_origins"]
    try:
        allowed_origins = {normalize_origin(item) for item in allowed}
    except Blocker as exc:
        raise Blocker("browser_use_navigation_origin_policy_invalid") from exc
    if current_origin not in allowed_origins:
        raise Blocker("browser_use_navigation_origin_mismatch")
    evidence = {
        "schema": "browser-use-navigation-readback.v1",
        "origin": current_origin,
        "path_sha256": hashlib.sha256((parsed_url.path or "/").encode("utf-8")).hexdigest(),
        "path_length": len(parsed_url.path or "/"),
        "path_representation": "sha256_only",
        "verified_at": iso(now_utc()),
    }
    return evidence if return_evidence else current_origin


def _verified_navigation_with_checkpoint(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    recording: dict[str, Any],
    descriptor_path: str,
    *,
    expected_origins: list[str] | None = None,
    expected_url: str | None = None,
) -> str | dict[str, Any]:
    try:
        evidence = _verified_current_origin(
            config,
            descriptor,
            recording,
            expected_origins=expected_origins,
            expected_url=expected_url,
            return_evidence=True,
        )
        if browser_harness_cli_enabled():
            # URL/origin proof alone can succeed while the document is still
            # transitioning.  The fixed probe returns only URL and
            # readyState; its raw URL is never persisted.
            probe_url, ready_state = _fixed_url_state_probe(
                config,
                config["roots"]["browser_use_home"],
                descriptor["port"],
                descriptor["session"],
                recording,
            )
            if ready_state != "complete":
                raise Blocker("browser_use_navigation_ready_state_unverified")
            parsed_probe = urllib.parse.urlparse(probe_url)
            probe_origin = normalize_origin(
                f"{parsed_probe.scheme}://{parsed_probe.hostname.lower().rstrip('.')}{f':{parsed_probe.port}' if parsed_probe.port and not ((parsed_probe.scheme == 'http' and parsed_probe.port == 80) or (parsed_probe.scheme == 'https' and parsed_probe.port == 443)) else ''}"
            )
            if not isinstance(evidence, dict) or probe_origin != evidence.get("origin"):
                raise Blocker("browser_use_navigation_origin_reconciliation_failed")
            probe_path = parsed_probe.path or "/"
            if evidence.get("path_sha256") != hashlib.sha256(probe_path.encode("utf-8")).hexdigest() or evidence.get("path_length") != len(probe_path):
                raise Blocker("browser_use_navigation_path_reconciliation_failed")
            evidence["ready_state"] = "complete"
            evidence["ready_state_verified"] = True
        return evidence
    except Exception as exc:
        descriptor["navigation_verified"] = False
        blocker = exc.code if isinstance(exc, Blocker) else "browser_use_navigation_readback_failed"
        try:
            write_recovery_checkpoint(
                descriptor,
                exact_blocker=blocker,
                next_action="same-run navigation readback and tab reconciliation",
            )
            _write_recording_descriptor(config, os.path.realpath(descriptor_path), descriptor, replace=True)
        except Exception:
            pass
        raise


def _recording_target_context(config: dict[str, Any], args: argparse.Namespace, operation: str) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(config, args.descriptor, run_id, session, allow_pinned_helper_reexec=True)
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    authority = recording_authority(
        config,
        descriptor,
        args.authority,
        command_class="target-click" if operation == "target-click" else "target-inspect",
        renewal_path=getattr(args, "authority_renewal", None),
    )
    if getattr(args, "authority_renewal", None):
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    validate_recording_process(config, descriptor)
    if operation == "target-click" and descriptor["mode"] != "authorized":
        raise Blocker("browser_use_target_click_requires_authorized_mode")
    require_no_pending_effect_reconciliation(descriptor, effectful=operation == "target-click")
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])
    if descriptor.get("navigation_verified") is not True:
        raise Blocker("browser_use_target_requires_navigation_readback")
    _verified_navigation_with_checkpoint(config, descriptor, recording, os.path.realpath(args.descriptor))
    return descriptor, authority or {}, recording


def _record_target_operation_failure(
    config: dict[str, Any],
    descriptor_path: str,
    descriptor: dict[str, Any],
    *,
    operation: str,
    target_text: str,
    blocker: str,
    external_action_possible: bool,
    operation_id: str | None = None,
) -> None:
    """Persist bounded evidence when a target operation stops before success.

    A failed target command is still useful evidence for the next repair run,
    but target text and helper details must not be copied into durable state.
    Keep only the target digest, operation, exact blocker, and whether the
    click dispatch had already been attempted.
    """
    text = str(target_text or "")
    entry = {
        "operation": str(operation),
        "operation_id": str(operation_id) if operation_id else None,
        "status": "failed",
        "target_text_sha256": hashlib.sha256(text.encode("utf-8")).hexdigest(),
        "target_text_length": len(text),
        "exact_blocker": str(blocker)[:160],
        "external_action_possible": bool(external_action_possible),
        "external_effects": "unknown" if external_action_possible else "none",
        "recorded_at": iso(now_utc()),
    }
    descriptor.setdefault("failed_operations", []).append(entry)
    try:
        write_recovery_checkpoint(
            descriptor,
            exact_blocker=str(blocker),
            next_action="same-surface outcome reconciliation before any retry",
            operation_id=operation_id,
        )
    except Exception:
        pass
    _write_recording_descriptor(config, os.path.realpath(descriptor_path), descriptor, replace=True)


def record_target_inspect(args: argparse.Namespace) -> int:
    config = read_toml()
    validate_installation(config)
    descriptor, _authority, recording = _recording_target_context(config, args, "target-inspect")
    try:
        candidate, before = _target_capture(config, descriptor, recording, args.target_text)
        capture_recording_frame(
            config,
            config["roots"]["browser_use_home"],
            descriptor["port"],
            descriptor["session"],
            recording,
        )
        if descriptor.get("tab_inventory_path"):
            descriptor["tab_inventory"] = read_recording_tab_inventory(descriptor["tab_inventory_path"])
        descriptor["status"] = "continued"
        descriptor["operations"].append("target-inspect")
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
        print(json.dumps({"status": "recording_continued", "operation": "target-inspect", "descriptor": os.path.realpath(args.descriptor), "candidate": candidate, "before_state": before, "finalized": False}, sort_keys=True))
        return 0
    except Exception as exc:
        _record_target_operation_failure(
            config,
            args.descriptor,
            descriptor,
            operation="target-inspect",
            target_text=args.target_text,
            blocker=exc.code if isinstance(exc, Blocker) else "browser_use_target_inspect_failed",
            external_action_possible=False,
        )
        raise


def record_target_click(args: argparse.Namespace) -> int:
    config = read_toml()
    validate_installation(config)
    descriptor, authority, recording = _recording_target_context(config, args, "target-click")
    if not authority:
        raise Blocker("browser_use_authority_required")
    dispatch_attempted = False
    operation_id = uuid.uuid4().hex
    append_operation_intent_durable(
        descriptor,
        operation_id=operation_id,
        command=["target-click"],
        external_effects="unknown",
        outcome="dispatch_intent_durable",
    )
    try:
        if browser_harness_cli_enabled():
            dispatch_attempted = True
            code, readback_exit, stdout = run_cli_keep_alive_capture(
                config,
                config["roots"]["browser_use_home"],
                descriptor["port"],
                descriptor["session"],
                ["ax-click", args.target_text],
                recording=recording,
            )
            if code != 0:
                raise Blocker("browser_use_target_click_failed", _LAST_RECORDING_CLI_FAILURE or str(code))
            if readback_exit != 0:
                raise Blocker("browser_use_target_click_readback_failed", str(readback_exit))
            parsed = _parse_cli_json(stdout)
            data = parsed.get("data") if isinstance(parsed, dict) else None
            candidate = data.get("candidate") if isinstance(data, dict) else None
            before = data.get("before") if isinstance(data, dict) else None
            after_page = data.get("after") if isinstance(data, dict) else None
            if not isinstance(candidate, dict) or not isinstance(before, dict) or not isinstance(after_page, dict):
                raise Blocker("browser_use_ax_target_click_readback_shape_invalid")
            if candidate.get("interactive") is not True:
                raise Blocker("browser_use_target_not_interactive")
            code, readback_exit, post_stdout = run_cli_keep_alive_capture(
                config,
                config["roots"]["browser_use_home"],
                descriptor["port"],
                descriptor["session"],
                ["state"],
                recording=recording,
            )
            if code != 0 or readback_exit != 0:
                raise Blocker("browser_use_target_post_click_readback_failed", str(readback_exit if readback_exit != 0 else code))
            post_parsed = _parse_cli_json(post_stdout)
            post_raw = _state_text_from_cli(post_parsed)
            _verified_navigation_with_checkpoint(config, descriptor, recording, os.path.realpath(args.descriptor))
            after_state = _target_state_summary(post_parsed, post_raw)
            capture_recording_frame(
                config,
                config["roots"]["browser_use_home"],
                descriptor["port"],
                descriptor["session"],
                recording,
            )
            if descriptor.get("tab_inventory_path"):
                descriptor["tab_inventory"] = read_recording_tab_inventory(descriptor["tab_inventory_path"])
            descriptor["status"] = "continued"
            descriptor["operations"].append("target-click")
            descriptor["business_effect_proof"] = "workflow_source_of_truth_required"
            append_operation_outcome_durable(
                descriptor,
                operation_id=operation_id,
                command=["target-click"],
                external_effects="executed",
                outcome="post_click_readback_verified",
            )
            _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
            print(json.dumps({
                "status": "recording_continued", "operation": "target-click",
                "descriptor": os.path.realpath(args.descriptor),
                "click_mode": "ax_backend_box_center", "candidate": candidate,
                "before_state": before, "after_page": after_page,
                "after_state": after_state,
                "state_changed": bool(data.get("state_changed")) or before != after_page,
                "external_effects": "executed", "business_effect_proof": "workflow_source_of_truth_required", "operation_id": operation_id,
                "finalized": False,
            }, sort_keys=True))
            return 0

        candidate, before = _target_capture(config, descriptor, recording, args.target_text)
        if candidate["interactive"]:
            click_command = ["click", str(candidate["index"])]
            click_mode = "fresh_index"
        else:
            if not args.allow_coordinate_fallback:
                raise Blocker("browser_use_target_coordinate_fallback_requires_explicit_opt_in")
            bbox = candidate["bbox"]
            x = round(float(bbox["x"]) + float(bbox["width"]) / 2, 2)
            y = round(float(bbox["y"]) + float(bbox["height"]) / 2, 2)
            click_command = ["click", _cli_coordinate(x), _cli_coordinate(y)]
            click_mode = "fresh_bbox_coordinate"
        validate_command(click_command, descriptor["mode"], config, list(descriptor["target_origins"]), descriptor["download_dir"])
        dispatch_attempted = True
        code, readback_exit, _ = run_cli_keep_alive_capture(config, config["roots"]["browser_use_home"], descriptor["port"], descriptor["session"], click_command, recording=recording)
        if code != 0:
            raise Blocker("browser_use_target_click_failed", _LAST_RECORDING_CLI_FAILURE or str(code))
        if readback_exit != 0:
            raise Blocker("browser_use_target_click_readback_failed", str(readback_exit))
        code, readback_exit, post_stdout = run_cli_keep_alive_capture(config, config["roots"]["browser_use_home"], descriptor["port"], descriptor["session"], ["state"], recording=recording)
        if code != 0 or readback_exit != 0:
            raise Blocker("browser_use_target_post_click_readback_failed", str(readback_exit if readback_exit != 0 else code))
        post_parsed = _parse_cli_json(post_stdout)
        post_raw = _state_text_from_cli(post_parsed)
        _verified_navigation_with_checkpoint(config, descriptor, recording, os.path.realpath(args.descriptor))
        capture_recording_frame(
            config,
            config["roots"]["browser_use_home"],
            descriptor["port"],
            descriptor["session"],
            recording,
        )
        descriptor["status"] = "continued"
        descriptor["operations"].append("target-click")
        descriptor["business_effect_proof"] = "workflow_source_of_truth_required"
        append_operation_outcome_durable(
            descriptor,
            operation_id=operation_id,
            command=["target-click"],
            external_effects="executed",
            outcome="post_click_readback_verified",
        )
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
        print(json.dumps({"status": "recording_continued", "operation": "target-click", "descriptor": os.path.realpath(args.descriptor), "click_mode": click_mode, "candidate": candidate, "before_state": before, "after_state": _target_state_summary(post_parsed, post_raw), "state_changed": before["state_sha256"] != hashlib.sha256(post_raw.encode("utf-8")).hexdigest(), "external_effects": "executed", "business_effect_proof": "workflow_source_of_truth_required", "operation_id": operation_id, "finalized": False}, sort_keys=True))
        return 0
    except Exception as exc:
        _record_target_operation_failure(
            config,
            args.descriptor,
            descriptor,
            operation="target-click",
            target_text=args.target_text,
            blocker=exc.code if isinstance(exc, Blocker) else "browser_use_target_click_failed",
            external_action_possible=dispatch_attempted,
            operation_id=operation_id,
        )
        try:
            append_operation_outcome_durable(
                descriptor,
                operation_id=operation_id,
                command=["target-click"],
                external_effects="unknown" if dispatch_attempted else "none",
                outcome=exc.code if isinstance(exc, Blocker) else "target_click_failed",
            )
        except Blocker as outcome_exc:
            # Do not report only the click failure when the ledger outcome is
            # itself unverifiable; the run is now blocked on reconciliation.
            raise outcome_exc from exc
        raise


def _parse_fixed_url_state_probe(stdout: str) -> tuple[str, str]:
    """Parse only the fixed URL/readyState probe; never retain page text."""
    parsed = _parse_cli_json(stdout)
    data = parsed.get("data") if isinstance(parsed, dict) else None
    result = data.get("result") if isinstance(data, dict) else None
    if not isinstance(result, str):
        raise Blocker("browser_use_semantic_readback_probe_shape_invalid")
    try:
        probe = json.loads(result)
    except (TypeError, ValueError, json.JSONDecodeError) as exc:
        raise Blocker("browser_use_semantic_readback_probe_json_invalid") from exc
    if not isinstance(probe, dict) or set(probe) != {"url", "ready_state"}:
        raise Blocker("browser_use_semantic_readback_probe_shape_invalid")
    url = probe.get("url")
    ready_state = probe.get("ready_state")
    if not isinstance(url, str) or not isinstance(ready_state, str):
        raise Blocker("browser_use_semantic_readback_probe_shape_invalid")
    return url, ready_state


def _fixed_url_state_probe(config: dict[str, Any], home: str, port: int, session: str, recording: dict[str, str]) -> tuple[str, str]:
    """Use the pinned Harness command path for a fixed URL/readiness probe."""
    browser_harness_cli_enabled()
    expression = "JSON.stringify({url:location.href,ready_state:document.readyState})"
    result_code, readback_exit, stdout = run_cli3_keep_alive_capture(
        config, home, port, session, ["eval", expression], recording=recording
    )
    if result_code != 0 or readback_exit != 0:
        raise Blocker("browser_use_semantic_readback_probe_command_failed")
    return _parse_fixed_url_state_probe(stdout)


def _public_dns_proof(url: str) -> dict[str, Any]:
    parsed = urllib.parse.urlparse(url)
    host = parsed.hostname or ""
    try:
        addresses = sorted({item[4][0] for item in socket.getaddrinfo(host, parsed.port or 443, type=socket.SOCK_STREAM)})
    except OSError as exc:
        raise Blocker("browser_use_semantic_readback_dns_revalidation_failed", host) from exc
    private = [address for address in addresses if is_forbidden_ip(address)]
    return {
        "public_only": len(private) == 0 and len(addresses) > 0,
        "private_address_count": sum(1 for address in addresses if ipaddress.ip_address(address).is_private),
        "link_local_address_count": sum(1 for address in addresses if ipaddress.ip_address(address).is_link_local),
        "loopback_address_count": sum(1 for address in addresses if ipaddress.ip_address(address).is_loopback),
        "address_count": len(addresses),
    }


def _p5_public_tuple(descriptor: dict[str, Any], command: list[str]) -> None:
    if descriptor.get("mode") != "public" or descriptor.get("lifecycle") != "single-use" or descriptor.get("automation_id") != "automation-os-iab" or descriptor.get("target_origins") != [P5_PUBLIC_ORIGIN]:
        raise Blocker("browser_use_semantic_readback_tuple_invalid")
    if command not in (["state"], ["get", "title"], ["get", "url"]):
        raise Blocker("browser_use_semantic_readback_command_not_allowlisted")


def run_cli_semantic_readback(config: dict[str, Any], home: str, port: int, session: str, command: list[str], descriptor: dict[str, Any], recording: dict[str, str]) -> tuple[int, int | None, dict[str, Any]]:
    """Capture only the fixed P5 semantic fields; never persist raw stdout/page data."""
    _p5_public_tuple(descriptor, command)
    browser_harness_cli_enabled()
    if command in (["state"], ["get", "url"]):
        state_url, ready = _fixed_url_state_probe(config, home, port, session, recording)
        if command == ["get", "url"]:
            url = state_url
            if url != P5_PUBLIC_URL:
                raise Blocker("browser_use_semantic_readback_url_mismatch")
            origin = preflight_url(url, [P5_PUBLIC_ORIGIN], config["policy"]["unsafe_path_fragments"])
            dns = _public_dns_proof(url)
            if not dns["public_only"] or any(dns[key] != 0 for key in ("private_address_count", "link_local_address_count", "loopback_address_count")):
                raise Blocker("browser_use_semantic_readback_private_dns")
            return 0, 0, {"schema": "browser_use_semantic_readback.v1", "kind": "url", "url": url, "url_sha256": hashlib.sha256(url.encode("utf-8")).hexdigest(), "origin": origin, "origin_sha256": hashlib.sha256(origin.encode("utf-8")).hexdigest(), "redirect_hops": [], "redirect_count": 0, "final_dns_resolution": dns}
        if ready != "complete" or state_url != P5_PUBLIC_URL:
            raise Blocker("browser_use_semantic_readback_state_mismatch")
        origin = preflight_url(state_url, [P5_PUBLIC_ORIGIN], config["policy"]["unsafe_path_fragments"])
        dns = _public_dns_proof(state_url)
        if not dns["public_only"] or any(dns[key] != 0 for key in ("private_address_count", "link_local_address_count", "loopback_address_count")):
            raise Blocker("browser_use_semantic_readback_private_dns")
        sanitized = {"ready_state": "complete", "url": state_url, "origin": origin, "redirect_count": 0, "dns_revalidation": True, "dns_private_address_count": dns["private_address_count"], "dns_link_local_address_count": dns["link_local_address_count"], "dns_loopback_address_count": dns["loopback_address_count"]}
        return 0, 0, {"schema": "browser_use_semantic_readback.v1", "kind": "state", "state": sanitized, "state_sha256": hashlib.sha256(json.dumps(sanitized, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()}
    result_code, readback_exit, stdout = run_cli3_keep_alive_capture(
        config, home, port, session, command, recording=recording
    )
    if result_code != 0 or readback_exit != 0:
        failure_code = result_code if result_code != 0 else (readback_exit or 1)
        return failure_code, failure_code, {"schema": "browser_use_semantic_readback.v1", "exact_blocker": "browser_use_semantic_readback_command_failed"}
    parsed = _parse_cli_json(stdout)
    if command == ["get", "title"]:
        title = _first_field(parsed, {"title", "value", "result"})
        if not isinstance(title, str) or title != P5_PUBLIC_TITLE:
            raise Blocker("browser_use_semantic_readback_title_mismatch")
        return result_code, 0, {"schema": "browser_use_semantic_readback.v1", "kind": "title", "title_sha256": hashlib.sha256(title.encode("utf-8")).hexdigest(), "title_length": len(title)}
    raise Blocker("browser_use_semantic_readback_command_not_allowlisted")


def recording_descriptor_path(config: dict[str, Any], run_id: str, session: str, nonce: str) -> str:
    run_root = os.path.join(recording_descriptor_root(config), run_id)
    assert_directory(run_root, create=True)
    return os.path.join(run_root, f"{session}-{nonce}.json")


def read_recording_descriptor(config: dict[str, Any], path: str, run_id: str, session: str, *, allow_finalized: bool = False, allow_helper_hash_mismatch: bool = False, allow_pinned_helper_reexec: bool = False, allow_expired_temporary: bool = False, allow_stale_runtime_recovery: bool = False) -> dict[str, Any]:
    path = os.path.realpath(path)
    assert_recording_descriptor_path(config, path)
    value = read_json_safe(path)
    required = {"schema", "status", "mode", "lifecycle", "run_id", "session", "automation_id", "nonce", "helper_sha256", "recording_dir", "status_path", "recording_framerate", "port", "process", "owned_chrome", "profile", "download_dir", "lock_paths", "target_origins", "authority_sha256", "account_identity", "operations"}
    missing = sorted(required - value.keys())
    if missing:
        raise Blocker("browser_use_recording_descriptor_fields_missing", ",".join(missing))
    allowed_statuses = set(RECORDING_STATUSES) | ({"finalized"} if allow_finalized else set())
    if value["schema"] != RECORDING_SCHEMA or value["status"] not in allowed_statuses:
        raise Blocker("browser_use_recording_descriptor_schema_or_status_invalid")
    if value["run_id"] != run_id or value["session"] != session:
        raise Blocker("browser_use_recording_descriptor_binding_mismatch")
    if not isinstance(value["helper_sha256"], str) or not re.fullmatch(r"[0-9a-f]{64}", value["helper_sha256"]):
        raise Blocker("browser_use_recording_helper_hash_invalid")
    recording_dir = value["recording_dir"]
    if not isinstance(recording_dir, str) or not os.path.isabs(recording_dir) or os.path.realpath(recording_dir) != recording_dir:
        raise Blocker("browser_use_recording_dir_noncanonical")
    assert_directory(recording_dir)
    current_helper = os.path.realpath(sys.argv[0])
    current_helper_matches = value["helper_sha256"] == sha256_file(current_helper)
    if value.get("helper_snapshot_path"):
        validate_helper_snapshot(value)
    if not current_helper_matches:
        pinned_helper = validate_helper_snapshot(value)
        if allow_pinned_helper_reexec and pinned_helper and current_helper != pinned_helper:
            try:
                os.execve(pinned_helper, [pinned_helper, *sys.argv[1:]], os.environ.copy())
            except OSError as exc:
                raise Blocker("browser_use_recording_pinned_helper_reexec_failed", type(exc).__name__) from exc
            raise Blocker("browser_use_recording_pinned_helper_reexec_unavailable")
        raise Blocker("browser_use_recording_helper_hash_mismatch")
    requested_session = value.get("requested_session")
    if requested_session is not None:
        validate_id(requested_session, "session")
        if canonical_session_id(requested_session, config["roots"]["browser_use_home"]) != session:
            raise Blocker("browser_use_session_binding_invalid")
    safe_id(value["automation_id"], "automation_id")
    safe_id(value["nonce"], "nonce")
    if value["mode"] not in {"public", "authorized"} or value["lifecycle"] not in {"single-use", "scheduled", TEMPORARY_LIFECYCLE}:
        raise Blocker("browser_use_recording_descriptor_mode_invalid")
    lifecycle = str(value["lifecycle"])
    if lifecycle == TEMPORARY_LIFECYCLE:
        for field in ("task_id", "creation_binding", "authority_scope"):
            if field not in value:
                raise Blocker("browser_use_temporary_recording_fields_missing", field)
        if value["mode"] != "authorized":
            raise Blocker("browser_use_temporary_requires_authorized_mode")
    # A recording bound to a login handoff intentionally points at the
    # handoff-owned profile. Validate that profile against the source
    # handoff's lifecycle, not the destination recording's lifecycle. The
    # start path rejects a mismatch before recording begins; this branch also
    # lets terminal cleanup close a previously started mismatched recording
    # without deleting the shared handoff profile.
    profile_lifecycle = lifecycle
    if value.get("source_handoff_descriptor"):
        source_path = os.path.realpath(str(value["source_handoff_descriptor"]))
        source_run_id = safe_id(value.get("source_run_id"), "run_id")
        source_session = validate_id(value.get("source_session"), "session")
        source = read_handoff(config, source_path, source_run_id, source_session, require_unexpired=False)
        profile_lifecycle = str(source.get("lifecycle", lifecycle))
    profile_root = os.path.realpath(config["roots"]["scheduled_profiles"] if profile_lifecycle == "scheduled" else config["roots"]["single_use_profiles"] if profile_lifecycle == "single-use" else config["roots"]["temporary_profiles"])
    if not isinstance(value["profile"], str) or os.path.realpath(value["profile"]) != value["profile"] or not value["profile"].startswith(profile_root + os.sep):
        raise Blocker("browser_use_recording_profile_scope_mismatch")
    if lifecycle == "scheduled" and not value.get("source_handoff_descriptor") and os.path.realpath(value["profile"]) != os.path.join(profile_root, value["automation_id"]):
        raise Blocker("browser_use_recording_scheduled_profile_binding_mismatch")
    if lifecycle == TEMPORARY_LIFECYCLE:
        if os.path.realpath(value["profile"]) != temporary_profile_path(config, value["creation_binding"]):
            raise Blocker("browser_use_temporary_recording_profile_binding_mismatch")
        room_id = value.get("room_id")
        if room_id:
            room = room_registry_lookup(config, room_id)
            if room is None or room.get("profile") != os.path.realpath(value["profile"]) or int(room.get("port", -1)) != int(value["port"]):
                raise Blocker("browser_use_temporary_recording_room_binding_mismatch")
        elif int(value["port"]) != temporary_port(config, value["creation_binding"]):
            raise Blocker("browser_use_temporary_fixed_port_mismatch")
        if os.path.lexists(value["profile"]):
            validate_temporary_marker(config, value["profile"], {
                "mode": value["mode"], "lifecycle": lifecycle, "automation_id": value["automation_id"], "task_id": value["task_id"], "run_id": value["run_id"], "creation_binding": value["creation_binding"], "canonical_profile": value["profile"], "port": value["port"], "authority_sha256": value["authority_sha256"], "authority_scope": value["authority_scope"], "account_identity": value["account_identity"], "origins": value["target_origins"],
            }, require_unexpired=(not allow_expired_temporary) and value["status"] not in {"finalized", "cleanup_pending"})
            if value["status"] not in {"finalized", "cleanup_pending"} and not allow_stale_runtime_recovery:
                assert_owned_locks(value["lock_paths"], value["run_id"], value["nonce"])
        elif value["status"] != "finalized" and not (value.get("cleanup_state") or {}).get("profile_removed"):
            raise Blocker("browser_use_temporary_profile_missing")
    if value["status_path"] != recording_status_path(recording_dir):
        raise Blocker("browser_use_recording_status_path_binding_mismatch")
    if "helper_snapshot_path" in value and not allow_helper_hash_mismatch:
        validate_helper_snapshot(value)
    tab_inventory_path = value.get("tab_inventory_path")
    if tab_inventory_path is not None:
        expected_tab_inventory_path = os.path.join(recording_dir, "tab-inventory.json")
        if tab_inventory_path != expected_tab_inventory_path or not os.path.isabs(tab_inventory_path) or os.path.realpath(tab_inventory_path) != tab_inventory_path:
            raise Blocker("browser_use_recording_tab_inventory_path_binding_invalid")
    if not isinstance(value["recording_framerate"], int) or not 1 <= value["recording_framerate"] <= 60:
        raise Blocker("browser_use_recording_framerate_invalid")
    if not isinstance(value["target_origins"], list) or not value["target_origins"]:
        raise Blocker("browser_use_recording_origins_missing")
    if value["owned_chrome"] not in {True, False}:
        raise Blocker("browser_use_recording_process_binding_invalid")
    process = value["process"]
    if not isinstance(process, dict) or not isinstance(process.get("root_pid"), int) or not isinstance(process.get("root_start_time"), (int, float)):
        raise Blocker("browser_use_recording_process_identity_invalid")
    if not isinstance(value["lock_paths"], list) or not all(isinstance(item, str) for item in value["lock_paths"]):
        raise Blocker("browser_use_recording_lock_binding_invalid")
    if not isinstance(value["operations"], list):
        raise Blocker("browser_use_recording_operations_invalid")
    if "operation_ledger_path" in value:
        operation_ledger_path(value)
    if "checkpoint_path" in value:
        checkpoint = value["checkpoint_path"]
        if not isinstance(checkpoint, str) or os.path.realpath(os.path.dirname(checkpoint)) != os.path.realpath(recording_dir):
            raise Blocker("browser_use_recording_checkpoint_scope_invalid")
    return value


def recording_authority(config: dict[str, Any], descriptor: dict[str, Any], authority_path: str | None, *, cleanup_only: bool = False, command_class: str | None = None, renewal_path: str | None = None) -> dict[str, Any] | None:
    if descriptor["mode"] == "public":
        return None
    if not authority_path:
        raise Blocker("browser_use_authority_required")
    requested_session = descriptor.get("requested_session")
    aliases = session_aliases(config, requested_session, descriptor["session"]) if isinstance(requested_session, str) else []
    supplied_path = os.path.realpath(authority_path)
    current_path = os.path.realpath(str(descriptor.get("authority_current_path") or supplied_path))
    if descriptor.get("authority_current_path") and sha256_file(current_path) != descriptor["authority_sha256"]:
        raise Blocker("browser_use_authority_generation_lineage_mismatch")
    supplied_digest = sha256_file(supplied_path)
    if supplied_digest != descriptor["authority_sha256"]:
        # An old path may be supplied after a successful renewal.  Continue only
        # with the descriptor's immutable current generation; never reinterpret
        # the old file as current authority.
        if current_path == supplied_path:
            raise Blocker("browser_use_recording_authority_changed")
        if renewal_path is None and not os.path.lexists(current_path):
            raise Blocker("browser_use_authority_generation_lineage_mismatch")
    authority = parse_authority(current_path, descriptor["run_id"], descriptor["session"], aliases=aliases, require_unexpired=not cleanup_only and renewal_path is None)
    if renewal_path:
        authority = renew_recording_authority(config, descriptor, current_path, renewal_path)
        current_path = os.path.realpath(renewal_path)
    elif sha256_file(current_path) != descriptor["authority_sha256"]:
        raise Blocker("browser_use_recording_authority_changed")
    if descriptor["account_identity"] != authority["account_identity"]:
        raise Blocker("browser_use_recording_account_identity_mismatch")
    if not set(descriptor["target_origins"]).issubset({normalize_origin(item) for item in authority["allowed_origins"]}):
        raise Blocker("browser_use_recording_origin_not_authorized")
    if command_class and not cleanup_only:
        admit_authority_budget(config, descriptor, authority, command_class)
    return authority


def validate_recording_process(config: dict[str, Any], descriptor: dict[str, Any]) -> None:
    if descriptor.get("source_handoff_descriptor"):
        source_path = descriptor["source_handoff_descriptor"]
        source = read_handoff(config, source_path, descriptor["source_run_id"], descriptor["source_session"], require_unexpired=True)
        validate_handoff_identity(config, source)
        return
    validate_handoff_process_identity(
        config,
        {"process": descriptor["process"], "port": descriptor["port"], "profile": descriptor["profile"]},
        allow_missing=False,
    )


def _recording_runtime_is_stale(config: dict[str, Any], descriptor: dict[str, Any]) -> bool:
    """Freshly distinguish a dead owned runtime from a live normal path."""
    if descriptor.get("owned_chrome") is not True:
        return False
    try:
        process_present = validate_handoff_process_identity(
            config,
            {"process": descriptor["process"], "port": descriptor["port"], "profile": descriptor["profile"]},
            allow_missing=True,
        )
        if process_present is False:
            runtime = os.path.join(browser_harness_root(descriptor["session"]), "runtime")
            if any(os.path.lexists(os.path.join(runtime, name)) for name in ("bu.sock", "bu.pid", "bu.port")):
                raise Blocker("browser_use_recording_daemon_still_present")
            return True
    except Blocker as exc:
        if exc.code == "browser_use_handoff_chrome_missing":
            runtime = os.path.join(browser_harness_root(descriptor["session"]), "runtime")
            if any(os.path.lexists(os.path.join(runtime, name)) for name in ("bu.sock", "bu.pid", "bu.port")):
                raise Blocker("browser_use_recording_daemon_still_present") from exc
            return True
        raise
    return False


def _stale_runtime_lock_paths(config: dict[str, Any], descriptor: dict[str, Any]) -> list[str]:
    """Return only the two exact locks that a temporary recording can own."""
    if descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE or descriptor.get("owned_chrome") is not True:
        raise Blocker("browser_use_recording_stale_runtime_unsupported")
    expected = {
        os.path.realpath(temporary_profile_lock_path(config, descriptor["profile"])),
        os.path.realpath(temporary_port_lock_path(config, int(descriptor["port"]))),
    }
    actual = descriptor.get("lock_paths")
    if not isinstance(actual, list) or {os.path.realpath(str(path)) for path in actual} != expected or len(actual) != len(expected):
        raise Blocker("browser_use_recording_recovery_lock_binding_invalid")
    return sorted(expected)


def _release_stale_runtime_locks(config: dict[str, Any], descriptor: dict[str, Any]) -> list[str]:
    """Preflight every exact lock, then release only locks owned by this run."""
    paths = _stale_runtime_lock_paths(config, descriptor)
    for path in paths:
        if not os.path.lexists(path):
            continue
        value = read_json_safe(path)
        if value.get("run_id") != descriptor["run_id"] or value.get("nonce") != descriptor["nonce"]:
            raise Blocker("browser_use_recording_recovery_foreign_lock", path)
        if value.get("canonical_profile") != os.path.realpath(descriptor["profile"]):
            raise Blocker("browser_use_recording_recovery_lock_binding_invalid", path)
        if int(value.get("port", -1)) != int(descriptor["port"]):
            raise Blocker("browser_use_recording_recovery_lock_binding_invalid", path)
    for path in paths:
        release_lock(path, descriptor["run_id"], descriptor["nonce"])
    if any(os.path.lexists(path) for path in paths):
        raise Blocker("browser_use_recording_recovery_lock_release_readback_failed")
    return paths


def reconcile_stale_recording_runtime(config: dict[str, Any], descriptor: dict[str, Any], descriptor_path: str, *, max_attempts: int) -> dict[str, Any]:
    """Make a dead temporary recording restartable without touching its profile or effects."""
    current_state = str(descriptor.get("recovery_state") or "")
    paths = _stale_runtime_lock_paths(config, descriptor)
    room_id = descriptor.get("room_id")
    room = room_registry_lookup(config, room_id) if room_id else None
    if current_state == "restartable" and all(not os.path.lexists(path) for path in paths) and room and room.get("state") == "held":
        pending = pending_operation_reconciliation_ids(descriptor)
        return {
            "status": "recording_recovered",
            "descriptor": os.path.realpath(descriptor_path),
            "run_id": descriptor["run_id"],
            "session": descriptor["session"],
            "recovery_state": "restartable",
            "recording_status": "abandoned",
            "pending_reconciliation": pending,
            "effectful_resume_allowed": not pending,
            "idempotent": True,
            "finalized": False,
        }
    try:
        max_attempts = max(1, min(int(max_attempts), MAX_RECORDING_RECOVERY_ATTEMPTS))
    except (TypeError, ValueError) as exc:
        raise Blocker("browser_use_recording_recovery_attempts_invalid") from exc
    descriptor_max = int(descriptor.get("recovery_max_attempts", max_attempts))
    descriptor_max = max(1, min(descriptor_max, MAX_RECORDING_RECOVERY_ATTEMPTS))
    prior_attempts = int(descriptor.get("recovery_retry_count", 0))
    if prior_attempts >= descriptor_max:
        raise Blocker("browser_use_recording_recovery_attempt_limit", "fresh same-task record-start after reconciliation")

    pending = close_orphan_operation_intents(descriptor)
    if room_id:
        if room is None:
            raise Blocker("browser_use_recording_recovery_room_missing")
        room_registry_update(config, room_id, run_id=descriptor["run_id"], state="held", activity="record-recover")
    _release_stale_runtime_locks(config, descriptor)
    mark_recording_abandoned(descriptor["status_path"], reason="owned Chrome process and both listeners absent")
    descriptor.update(
        {
            "status": "stale",
            "recovery_state": "restartable",
            "recovery_max_attempts": descriptor_max,
            "recovery_retry_count": prior_attempts + 1,
            "stale_state": {
                "state": "abandoned",
                "uncertain": True,
                "exact_blocker": "browser_use_recording_stale_runtime_reconciled",
                "updated_at": iso(now_utc()),
            },
            "recording_status_state": "abandoned",
        }
    )
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_recording_stale_runtime_reconciled",
        next_action="fresh same-task record-start with the bound profile/port/room; reconcile unknown external effects before effectful retry",
    )
    _write_recording_descriptor(config, os.path.realpath(descriptor_path), descriptor, replace=True)
    pending_after = pending_operation_reconciliation_ids(descriptor)
    return {
        "status": "recording_recovered",
        "descriptor": os.path.realpath(descriptor_path),
        "run_id": descriptor["run_id"],
        "session": descriptor["session"],
        "recovery_state": "restartable",
        "recording_status": "abandoned",
        "pending_reconciliation": pending_after,
        "effectful_resume_allowed": not pending_after,
        "attempts": 1,
        "checkpoint": checkpoint,
        "finalized": False,
    }


def load_recording_commands(config: dict[str, Any], path: str, mode: str, allowed_origins: list[str], download_dir: str) -> list[list[str]]:
    assert_regular_file(path, mode=0o600)
    try:
        value = json.loads(pathlib.Path(path).read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise Blocker("browser_use_recording_commands_file_invalid") from exc
    if not isinstance(value, list) or not value or len(value) > int(config["recording"]["max_commands"]):
        raise Blocker("browser_use_recording_commands_invalid")
    commands: list[list[str]] = []
    for item in value:
        if not isinstance(item, list) or not all(isinstance(arg, str) for arg in item):
            raise Blocker("browser_use_recording_command_entry_invalid")
        command, _, _ = validate_command(item, mode, config, allowed_origins, download_dir)
        if command[0] == "close":
            raise Blocker("browser_use_recording_close_is_helper_owned")
        commands.append(command)
    return commands


def _recording_context(config: dict[str, Any], descriptor: dict[str, Any]) -> dict[str, Any]:
    return {
        "mode": descriptor["mode"],
        "lifecycle": descriptor["lifecycle"],
        "run_id": descriptor["run_id"],
        "session": descriptor["session"],
        "requested_session": descriptor.get("requested_session", descriptor["session"]),
        "automation_id": descriptor["automation_id"],
        "nonce": descriptor["nonce"],
        "task_id": descriptor.get("task_id"),
        "started_at": descriptor.get("started_at"),
        "lock_paths": list(descriptor["lock_paths"]),
        "process": descriptor["process"],
        "port": descriptor["port"],
        "profile": descriptor["profile"],
        "download_dir": descriptor["download_dir"],
        "cleanup": {},
        "room_terminal_cleanup": True,
        "config": config,
        "room_id": descriptor.get("room_id"),
    }


def require_temporary_task_id(args: argparse.Namespace, descriptor: dict[str, Any]) -> None:
    if descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE:
        return
    task_id = getattr(args, "task_id", None)
    if not task_id:
        raise Blocker("browser_use_temporary_task_id_required")
    safe_id(task_id, "task_id")
    if task_id != descriptor.get("task_id"):
        raise Blocker("browser_use_temporary_task_binding_mismatch")


def _cleanup_recording_owned_session(config: dict[str, Any], descriptor: dict[str, Any], *, require_video_session_closed: bool = True) -> tuple[bool, str | None]:
    if not descriptor.get("owned_chrome"):
        return True, None
    ctx = _recording_context(config, descriptor)
    ok, blocker = terminate_chrome(None, descriptor["process"], config["executables"]["chrome"]["canonical_path"], descriptor["port"], descriptor["profile"])
    if not ok:
        _record_context_cleanup_pending(ctx, blocker or "browser_use_cleanup_uncertain")
        return False, blocker or "browser_use_cleanup_uncertain"
    ctx["process_terminated"] = True
    ctx["listener_absent"] = True
    try:
        if descriptor.get("lifecycle") == "single-use" and os.path.lexists(descriptor["profile"]):
            cleanup_exact_profile(descriptor["profile"], config["roots"]["single_use_profiles"], descriptor["run_id"], descriptor["nonce"])
        elif descriptor.get("lifecycle") == TEMPORARY_LIFECYCLE and os.path.lexists(descriptor["profile"]):
            cleanup_temporary_profile(config, descriptor, process_verified=True)
        elif descriptor.get("lifecycle") == "scheduled" and not os.path.lexists(descriptor["profile"]):
            return False, "browser_use_scheduled_profile_missing_after_cleanup"
        elif descriptor.get("lifecycle") not in {"single-use", "scheduled", TEMPORARY_LIFECYCLE}:
            return False, "browser_use_recording_lifecycle_invalid"
        if os.path.lexists(descriptor["download_dir"]):
            cleanup_exact_download_dir(descriptor["download_dir"], config["roots"]["downloads"])
        if os.path.lexists(descriptor["download_dir"]):
            raise Blocker("browser_use_download_cleanup_readback_failed")
        released, release_error = _release_locks_after_verified_cleanup(ctx, descriptor["run_id"], descriptor["nonce"])
        if not released:
            return False, release_error or "browser_use_cleanup_uncertain"
    except Exception as exc:
        return False, _cleanup_failure_code(exc)
    return True, None


def _recording_finalize_cleanup_after_stop_failure(
    config: dict[str, Any],
    versions: dict[str, Any],
    descriptor: dict[str, Any],
    descriptor_path: str,
    failure: str,
) -> tuple[str | None, str]:
    """Close only this recording's resources after recorder stop failed.

    A failed Browser Harness ``record-stop`` is not evidence that the video
    finalized.  It is, however, a terminal boundary for the recording flow:
    leaving the run-owned Chrome and locks alive makes every later cleanup
    attempt less reliable.  Preserve the failure, attempt the normal daemon
    close, and then use the existing identity-checked Chrome cleanup.  The
    returned receipt is always blocked; this helper never creates a completed
    recording manifest.
    """
    ctx = _recording_context(config, descriptor)
    ctx.update(
        {
            "account_identity": descriptor.get("account_identity", "authorized"),
            "authority_summary": {
                "data_exposure": "authorized_recording" if descriptor.get("mode") == "authorized" else "public_read_only",
                "side_effect_scope": "bounded_recording",
                "approval": "approved" if descriptor.get("mode") == "authorized" else "not_required",
            },
            "preflight": True,
            "listener_verified": True,
            "process_identity_verified": True,
            "readback_exit": 0,
            "readback_required": True,
        }
    )
    cleanup: dict[str, Any] = {
        "status": "cleanup_pending",
        "recording_finalize": "blocked",
        "record_stop": "failed",
        "record_stop_blocker": failure,
        "daemon_close_attempted": False,
    }

    daemon_error: str | None = None
    if browser_harness_cli_enabled():
        cleanup["daemon_close_attempted"] = True
        try:
            daemon_closed, daemon_error = close_owned_daemon_if_active(
                config,
                config["roots"]["browser_use_home"],
                int(descriptor["port"]),
                descriptor["session"],
            )
        except Exception as exc:
            daemon_closed = False
            daemon_error = _cleanup_failure_code(exc, "browser_use_daemon_close_failed")
        cleanup["daemon_close"] = "closed" if daemon_closed else "failed"
        if daemon_error:
            cleanup["daemon_close_blocker"] = daemon_error

    cleanup_blocker: str | None = None
    if descriptor.get("owned_chrome"):
        try:
            cleaned, cleanup_blocker = _cleanup_recording_owned_session(config, descriptor)
        except Exception as exc:
            cleaned = False
            cleanup_blocker = _cleanup_failure_code(exc)
        if cleaned:
            try:
                recording = recording_env(
                    config,
                    descriptor["recording_dir"],
                    descriptor["status_path"],
                    descriptor["recording_framerate"],
                )
                write_harness_recording_status(descriptor["status_path"], recording, active=False, finalized=False)
            except Exception as exc:
                cleaned = False
                cleanup_blocker = _cleanup_failure_code(exc, "browser_use_recording_status_cleanup_readback_failed")
        if cleaned:
            cleanup.update(
                {
                    "status": "cleaned",
                    "process_terminated": True,
                    "listener_absent": True,
                    "profile_preserved": str(descriptor.get("lifecycle")) == "scheduled",
                    "temporary_profile_removed": str(descriptor.get("lifecycle")) == TEMPORARY_LIFECYCLE,
                    "download_dir_removed": not os.path.lexists(descriptor["download_dir"]),
                    "locks_removed": [path for path in descriptor.get("lock_paths", []) if not os.path.lexists(path)],
                    "locks_retained": [path for path in descriptor.get("lock_paths", []) if os.path.lexists(path)],
                }
            )
        else:
            cleanup["status"] = "cleanup_pending"
            cleanup["state"] = "uncertain"
            cleanup["uncertain"] = True
            cleanup["exact_blocker"] = cleanup_blocker or "browser_use_cleanup_uncertain"
            cleanup["locks_retained"] = list(descriptor.get("lock_paths", []))
    else:
        # A recording attached to a login handoff does not own the source
        # browser.  Preserve it for the handoff owner instead of closing it.
        cleanup.update({"status": "source_handoff_preserved", "shared_handoff_preserved": True})

    ctx["cleanup"] = cleanup
    descriptor["status"] = "cleanup_pending"
    descriptor["finalize_failure"] = failure
    descriptor["cleanup_state"] = cleanup
    persistence_failure: str | None = None
    try:
        _write_recording_descriptor(config, os.path.realpath(descriptor_path), descriptor, replace=True)
    except Exception as exc:
        persistence_failure = _cleanup_failure_code(exc, "browser_use_cleanup_pending_persistence_failed")
        cleanup["status"] = "cleanup_pending"
        cleanup["state"] = "uncertain"
        cleanup["uncertain"] = True
        cleanup["exact_blocker"] = persistence_failure
        ctx["cleanup"] = cleanup

    receipt_failure = persistence_failure or cleanup_blocker or failure
    receipt_path: str | None = None
    try:
        receipt_path = finalized_receipt(config, versions, ctx, receipt_failure)
    except Exception:
        # The original stop failure remains the stable user-facing blocker;
        # the descriptor/cleanup state is the durable retry evidence.
        receipt_path = None
    return receipt_path, receipt_failure


def _recording_failure_cleanup(config: dict[str, Any], ctx: dict[str, Any], chrome_proc: subprocess.Popen[bytes] | None, lifecycle: str, descriptor_path: str | None = None) -> str | None:
    failure = _cleanup_execute_failure(config, ctx, chrome_proc, lifecycle)
    if failure and descriptor_path:
        try:
            if os.path.lexists(descriptor_path):
                descriptor = read_json_safe(descriptor_path)
                descriptor["status"] = "cleanup_pending"
                descriptor["cleanup_state"] = dict(ctx.get("cleanup") or {})
                json_atomic_replace(descriptor_path, descriptor)
        except Exception:
            return "browser_use_recording_cleanup_pending_persistence_failed"
    return failure


def _write_recording_descriptor(config: dict[str, Any], path: str, descriptor: dict[str, Any], *, replace: bool) -> None:
    assert_recording_descriptor_path(config, path)
    if replace:
        json_atomic_replace(path, descriptor)
    else:
        json_atomic_no_replace(path, descriptor)


def record_start(args: argparse.Namespace) -> int:
    config = read_toml()
    args.lifecycle = resolve_default_lifecycle(args.mode, getattr(args, "lifecycle", None))
    if args.lifecycle == TEMPORARY_LIFECYCLE and args.mode != "authorized":
        raise Blocker("browser_use_temporary_requires_authorized_mode")
    versions = validate_installation(config)
    recording_tools = validate_recording_tools(config)
    recording_runtime = validate_recording_runtime(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    ensure_temporary_task_id(args, requested_session)
    automation_id = safe_id(args.automation_id, "automation_id")
    if args.lifecycle not in {"single-use", "scheduled", TEMPORARY_LIFECYCLE}:
        raise Blocker("browser_use_recording_lifecycle_invalid")
    if args.lifecycle == TEMPORARY_LIFECYCLE:
        if args.mode != "authorized":
            raise Blocker("browser_use_temporary_requires_authorized_mode")
        if not args.task_id:
            raise Blocker("browser_use_temporary_task_id_required")
        safe_id(args.task_id, "task_id")
    if args.handoff_descriptor and args.mode != "authorized":
        raise Blocker("browser_use_recording_handoff_requires_authorized_mode")
    if args.mode == "authorized":
        if not args.authority:
            raise Blocker("browser_use_authority_required")
        authority = parse_authority(args.authority, run_id, session, aliases=session_aliases(config, requested_session, session))
        allowed_origins = list(authority["allowed_origins"])
        authority_digest = sha256_file(args.authority)
        account_identity = authority["account_identity"]
    else:
        authority = None
        allowed_origins = [normalize_origin(item) for item in args.allowed_origin]
        if not allowed_origins:
            raise Blocker("browser_use_allowed_origins_required")
        authority_digest = None
        account_identity = "public"
    require_cross_run_reconciliation_clear(
        config,
        run_id=run_id,
        automation_id=automation_id,
        account_identity=account_identity,
    )
    recording_dir = validate_recording_output_dir(args.recording_dir)
    if authority is not None:
        start_budget = remaining_authority_budget(authority, "record-start")
        if not start_budget["sufficient"]:
            try:
                write_authority_renewal_checkpoint(
                    {"recording_dir": recording_dir, "run_id": run_id, "session": session, "authority_generation": 1, "authority_sha256": authority_digest},
                    command_class="record-start",
                    budget=start_budget,
                )
            except Blocker:
                pass
            raise Blocker("browser_use_authority_renewal_required")
    try:
        framerate = int(args.framerate or recording_runtime["default_framerate"])
    except (TypeError, ValueError) as exc:
        raise Blocker("browser_use_recording_framerate_invalid") from exc
    if not 1 <= framerate <= 60:
        raise Blocker("browser_use_recording_framerate_invalid")
    command = list(args.command)
    if command and command[0] == "--":
        command = command[1:]
    # record-start is a lifecycle boundary, not a navigation boundary. The
    # Browser Harness start command only creates the recorder and ensures a
    # real tab; an "open URL" supplied here would otherwise be reflected in
    # descriptor.operations while the page remains on the new-tab page.
    # Navigation must be issued through record-command in the same flow.
    if command and command != ["state"]:
        raise Blocker("browser_use_recording_start_target_command_rejected")
    # P6 flow start is deliberately non-navigating, while the underlying
    # Browser Use daemon still requires one bounded command to initialize the
    # recording session.  A read-only state probe preserves that contract;
    # navigation is issued later through record-command with its own sequence
    # and nonce.
    if not command:
        command = ["state"]
    temp_binding_value = None
    if args.handoff_descriptor:
        source_path = os.path.realpath(args.handoff_descriptor)
        source_run_id = safe_id(args.source_run_id, "run_id")
        source_requested_session = validate_id(args.source_session, "session")
        source_session = canonical_session_id(source_requested_session, config["roots"]["browser_use_home"])
        source = read_handoff(config, source_path, source_run_id, source_session, require_unexpired=True)
        validate_handoff_identity(config, source)
        if str(source.get("lifecycle", "")) != str(args.lifecycle):
            raise Blocker("browser_use_recording_handoff_lifecycle_mismatch")
        if source["origin"] not in set(allowed_origins) or source["account_identity"] != account_identity:
            raise Blocker("browser_use_recording_source_handoff_binding_mismatch")
        if args.lifecycle == TEMPORARY_LIFECYCLE and source.get("authority_sha256") != authority_digest:
            raise Blocker("browser_use_temporary_authority_binding_mismatch")
            if args.lifecycle == TEMPORARY_LIFECYCLE:
                if source.get("lifecycle") != TEMPORARY_LIFECYCLE or source.get("task_id") != args.task_id:
                    raise Blocker("browser_use_temporary_task_binding_mismatch")
            temp_binding_value = source["creation_binding"]
        port = source["port"]
        profile = source["profile"]
        download_dir = source["download_dir"]
        process_identity = source["process"]
        owned_chrome = False
        lock_paths: list[str] = []
    else:
        if args.lifecycle == TEMPORARY_LIFECYCLE:
            temp_binding_value = temporary_binding(mode=args.mode, lifecycle=args.lifecycle, automation_id=automation_id, task_id=args.task_id, run_id=run_id, authority_digest=authority_digest or "", authority_scope=temporary_authority_scope(authority or {}), account_identity=account_identity, origins=allowed_origins)
            profile = temporary_profile_path(config, temp_binding_value)
            download_dir = os.path.join(config["roots"]["downloads"], f"temporary-{temp_binding_value[:32]}")
        else:
            profile_root = config["roots"]["scheduled_profiles"] if args.lifecycle == "scheduled" else config["roots"]["single_use_profiles"]
            profile = os.path.join(profile_root, automation_id) if args.lifecycle == "scheduled" else None
            download_dir = os.path.join(config["roots"]["downloads"], f"{run_id}-{uuid.uuid4().hex}")
        if args.mode == "public" and automation_id == "automation-os-iab" and args.port != 19980:
            raise Blocker("browser_use_p5_public_port_required")
        if args.lifecycle == "scheduled":
            port_start, port_end = config["ports"]["scheduled_start"], config["ports"]["scheduled_end"]
        elif args.lifecycle == "single-use":
            port_start, port_end = config["ports"]["single_use_start"], config["ports"]["single_use_end"]
        else:
            port_start, port_end = config["ports"]["temporary_start"], config["ports"]["temporary_end"]
        if args.port is not None and not (port_start <= args.port <= port_end):
            raise Blocker("browser_use_recording_port_out_of_range")
        if args.lifecycle == "scheduled" and automation_id == "manual":
            raise Blocker("browser_use_scheduled_automation_id_required")
        port = args.port
        process_identity = None
        owned_chrome = True
        lock_paths = []
    command, origins, uploads = validate_command(command, args.mode, config, allowed_origins, download_dir)
    if args.handoff_descriptor and origins and source["origin"] not in origins:
        raise Blocker("browser_use_recording_source_origin_drift")
    ctx: dict[str, Any] = {"mode": args.mode, "lifecycle": args.lifecycle, "run_id": run_id, "session": session, "requested_session": requested_session, "automation_id": automation_id, "nonce": temp_binding_value if args.lifecycle == TEMPORARY_LIFECYCLE and temp_binding_value else uuid.uuid4().hex, "task_id": getattr(args, "task_id", None), "started_at": iso(now_utc()), "lock_paths": lock_paths, "cleanup": {}, "port": port, "profile": profile, "download_dir": download_dir, "owned_chrome": owned_chrome, "config": config, "room_id": source.get("room_id") if args.handoff_descriptor else None}
    if args.lifecycle == TEMPORARY_LIFECYCLE:
        ctx["creation_binding"] = temp_binding_value or source["creation_binding"]
        ctx["authority_scope"] = temporary_authority_scope(authority or {}) if authority else source["authority_scope"]
    chrome_proc: subprocess.Popen[bytes] | None = None
    descriptor_path: str | None = None
    try:
        if owned_chrome:
            room = room_registry_claim(
                config,
                lifecycle=args.lifecycle,
                run_id=run_id,
                profile=profile if args.lifecycle != "single-use" else None,
                port=port,
                task_id=getattr(args, "task_id", None),
                automation_id=automation_id,
                activity="record-start",
            )
            ctx["room_id"] = room["room_id"]
            profile, port = room["profile"], room["port"]
            ctx["profile"], ctx["port"] = profile, port
            if args.lifecycle == TEMPORARY_LIFECYCLE:
                temp_info = prepare_temporary_profile(config, mode=args.mode, automation_id=automation_id, task_id=args.task_id, run_id=run_id, authority_digest=authority_digest or "", authority_scope=ctx["authority_scope"], account_identity=account_identity, origins=allowed_origins, download_dir=download_dir, requested_port=port)
                profile = temp_info["profile"]
                ctx["profile"] = profile
                ctx["lock_paths"].append(temp_info["profile_lock"])
            else:
                prepare_profile(profile, args.lifecycle == "scheduled", automation_id, download_dir, run_id, ctx["nonce"])
            if os.path.exists(download_dir):
                raise Blocker("browser_use_download_directory_collision")
            os.mkdir(download_dir, 0o700)
            profile_lock = temporary_profile_lock_path(config, profile) if args.lifecycle == TEMPORARY_LIFECYCLE else os.path.join(config["roots"]["locks"], f"profile-{hashlib.sha256(os.path.realpath(profile).encode()).hexdigest()[:24]}.lock")
            port_lock = os.path.join(config["roots"]["locks"], f"port-{port}.lock")
            payload = {"schema": "browser-use-lock.v1", "run_id": run_id, "nonce": ctx["nonce"], "helper_pid": os.getpid(), "helper_start_time": psutil.Process(os.getpid()).create_time(), "automation_id": automation_id, "port": port, "canonical_profile": os.path.realpath(profile)}
            if args.lifecycle != TEMPORARY_LIFECYCLE:
                lock_file(profile_lock, payload)
                ctx["lock_paths"].append(profile_lock)
            lock_file(port_lock, payload)
            ctx["lock_paths"].append(port_lock)
            chrome_proc, process_identity = launch_chrome(config, profile, port, download_dir, config["roots"]["browser_use_home"])
            ctx["process"] = process_identity
        else:
            ctx["process"] = process_identity
        ctx["listener_verified"] = True
        ctx["process_identity_verified"] = True
        recording = recording_env(config, recording_dir, recording_status_path(recording_dir), framerate)
        if browser_harness_cli_enabled():
            start_command = ["record-start", recording["recording_name"], recording["recording_source_dir"], f"{run_id} browser recording"]
            code, readback_exit = run_cli_keep_alive(config, config["roots"]["browser_use_home"], port, session, start_command, True, recording=recording)
        else:
            code, readback_exit = run_cli_keep_alive(config, config["roots"]["browser_use_home"], port, session, command, True, recording=recording)
        if code != 0:
            raise Blocker("browser_use_recording_start_command_failed", _LAST_RECORDING_CLI_FAILURE or str(code))
        if readback_exit != 0:
            raise Blocker("browser_use_recording_start_readback_failed", str(readback_exit))
        if browser_harness_cli_enabled():
            write_harness_recording_status(recording["status_path"], recording, active=True, finalized=False)
        else:
            read_recording_status(recording["status_path"], require_active=True)
        tab_inventory = read_recording_tab_inventory(recording["tab_inventory_path"]) if browser_harness_cli_enabled() else None
        descriptor_path = recording_descriptor_path(config, run_id, session, ctx["nonce"])
        helper_snapshot, helper_digest = create_helper_snapshot(recording_dir)
        versions_hashes = {**versions, "recording_tools": {kind: {"canonical_path": path} for kind, path in recording_tools.items()}}
        dependency_digest = hashlib.sha256(json.dumps(versions_hashes, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
        process_lineage = {"run_id": run_id, "session": session, "profile": profile, "port": port, "process": process_identity, "helper_sha256": helper_digest}
        process_lineage_digest = hashlib.sha256(json.dumps(process_lineage, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
        descriptor = {"schema": RECORDING_SCHEMA, "status": "active", "mode": args.mode, "lifecycle": args.lifecycle, "completion_policy": TEMPORARY_COMPLETION_POLICY if args.lifecycle == TEMPORARY_LIFECYCLE else None, "completion_assessment": "not_assessed" if args.lifecycle == TEMPORARY_LIFECYCLE else None, "retention_decision": "retain_until_ai_assessment" if args.lifecycle == TEMPORARY_LIFECYCLE else None, "task_completion_signal": "not_received" if args.lifecycle == TEMPORARY_LIFECYCLE else None, "run_id": run_id, "session": session, "requested_session": requested_session, "automation_id": automation_id, "task_id": ctx.get("task_id"), "creation_binding": ctx.get("creation_binding"), "authority_scope": ctx.get("authority_scope"), "nonce": ctx["nonce"], "helper_sha256": helper_digest, "helper_snapshot_path": helper_snapshot, "helper_snapshot_owner_uid": EUID, "helper_snapshot_mode": 0o700, "helper_dependency_digest": dependency_digest, "helper_process_lineage_digest": process_lineage_digest, "started_at": ctx["started_at"], "authority_sha256": authority_digest, "authority_generation": 1 if authority_digest else None, "authority_issuer_id": str(authority.get("issuer_id") if authority and authority.get("issuer_id") else "initial"), "authority_expires_at": authority.get("expires_at") if authority else None, "authority_current_path": os.path.realpath(args.authority) if authority and args.authority else None, "authority_ledger_path": os.path.join(recording_dir, "authority-generation-ledger.jsonl") if authority_digest else None, "authority_history_path": os.path.join(recording_dir, "authority-descriptor-history.jsonl") if authority_digest else None, "account_identity": account_identity, "target_origins": sorted(set(origins or allowed_origins)), "recording_dir": recording_dir, "status_path": recording["status_path"], "operation_ledger_path": os.path.join(recording_dir, "operation-ledger.jsonl"), "recording_framerate": framerate, "port": port, "process": process_identity, "owned_chrome": owned_chrome, "profile": profile, "download_dir": download_dir, "lock_paths": list(ctx["lock_paths"]), "room_id": ctx.get("room_id"), "operations": [command[0]], "failed_operations": [], "navigation_verified": False, "business_effect_proof": "not_applicable", "source_handoff_descriptor": os.path.realpath(args.handoff_descriptor) if args.handoff_descriptor else None, "source_run_id": source_run_id if args.handoff_descriptor else None, "source_session": source_session if args.handoff_descriptor else None, "versions_hashes": versions_hashes, "uploads": uploads, "recording_backend": "browser-harness" if browser_harness_cli_enabled() else "legacy", "recording_source_dir": recording.get("recording_source_dir", recording_dir), "harness_workspace": recording.get("harness_workspace"), "tab_inventory_path": recording.get("tab_inventory_path"), "tab_inventory": tab_inventory}
        if authority is not None:
            append_authority_generation(descriptor, authority, digest=authority_digest, generation=1, previous_digest=None, issuer_id=descriptor["authority_issuer_id"])
        _write_recording_descriptor(config, descriptor_path, descriptor, replace=False)
        print(json.dumps({"status": "recording_ready", "descriptor": descriptor_path, "run_id": run_id, "requested_session": requested_session, "session": session, "session_socket_path_bytes": session_socket_path_bytes(config["roots"]["browser_use_home"], session), "recording_dir": recording_dir, "recording_status": "active", "finalized": False}, sort_keys=True))
        return 0
    except (Blocker, OSError, subprocess.SubprocessError, ValueError, json.JSONDecodeError) as exc:
        failure = exc.code if isinstance(exc, Blocker) else "browser_use_recording_runtime_error"
        cleanup_failure = _recording_failure_cleanup(config, ctx, chrome_proc, args.lifecycle, descriptor_path)
        if cleanup_failure:
            failure = cleanup_failure
        print(json.dumps({"status": "blocked", "exact_blocker": failure, "cleanup": ctx.get("cleanup", {}), "finalized": False}, sort_keys=True))
        return 1


def record_command(args: argparse.Namespace) -> int:
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    refresh_helper = bool(getattr(args, "refresh_helper", False))
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=False,
        allow_pinned_helper_reexec=True,
    )
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    authority = recording_authority(
        config,
        descriptor,
        args.authority,
        command_class="record-command",
        renewal_path=getattr(args, "authority_renewal", None),
    )
    if getattr(args, "authority_renewal", None):
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    validate_recording_process(config, descriptor)
    command = list(args.command)
    if command and command[0] == "--":
        command = command[1:]
    command, origins, _ = validate_command(command, descriptor["mode"], config, list(descriptor["target_origins"]), descriptor["download_dir"])
    if command[0] == "close":
        raise Blocker("browser_use_recording_close_is_helper_owned")
    if refresh_helper and command[0] not in {"state", "get", "screenshot", "extract", "wait"}:
        raise Blocker("browser_use_recording_helper_refresh_requires_read_only_command")
    if refresh_helper and descriptor.get("helper_sha256") != sha256_file(os.path.realpath(sys.argv[0])):
        raise Blocker("browser_use_recording_helper_hash_changed_requires_readmission")
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])
    semantic_readback: dict[str, Any] | None = None
    operation_id = uuid.uuid4().hex
    operation_effect = "none" if command[0] in READ_ONLY_OPERATION_COMMANDS or command[0] in {"open", "back", "switch", "close-tab"} else "unknown"
    require_no_pending_effect_reconciliation(descriptor, effectful=operation_effect == "unknown")
    append_operation_intent_durable(descriptor, operation_id=operation_id, command=command, external_effects=operation_effect, outcome="dispatch_intent_durable")
    p5_readback_command = descriptor.get("mode") == "public" and descriptor.get("lifecycle") == "single-use" and descriptor.get("automation_id") == "automation-os-iab" and descriptor.get("target_origins") == [P5_PUBLIC_ORIGIN] and command in (["state"], ["get", "title"], ["get", "url"])
    captured_readback = ""
    try:
        if getattr(args, "capture_readback", False):
            code, readback_exit, captured_readback = run_cli_keep_alive_capture(config, config["roots"]["browser_use_home"], descriptor["port"], descriptor["session"], command, recording=recording)
        elif p5_readback_command:
            code, readback_exit, semantic_readback = run_cli_semantic_readback(config, config["roots"]["browser_use_home"], descriptor["port"], descriptor["session"], command, descriptor, recording)
        else:
            code, readback_exit = run_cli_keep_alive(config, config["roots"]["browser_use_home"], descriptor["port"], descriptor["session"], command, True, recording=recording)
    except Exception as exc:
        append_operation_outcome_durable(descriptor, operation_id=operation_id, command=command, external_effects="unknown" if operation_effect == "unknown" else "none", outcome=exc.code if isinstance(exc, Blocker) else "dispatch_exception")
        if operation_effect in OPERATION_EFFECT_STATES:
            descriptor["recovery_state"] = "readback_pending"
            descriptor["effectful_retry_allowed"] = False
            try:
                write_recovery_checkpoint(
                    descriptor,
                    exact_blocker=exc.code if isinstance(exc, Blocker) else "browser_use_recording_dispatch_exception",
                    next_action="fresh authority admission, then same-resource read-only reconcile; never replay the effectful command",
                    operation_id=operation_id,
                )
                _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
            except Exception:
                pass
        raise
    if code != 0:
        parser_syntax_error = command[0] == "eval" and str(_LAST_RECORDING_CLI_FAILURE).strip() == "syntax_error"
        append_operation_outcome_durable(descriptor, operation_id=operation_id, command=command, external_effects="unknown" if operation_effect == "unknown" else "none", outcome="dispatch_failed")
        if operation_effect in OPERATION_EFFECT_STATES:
            descriptor["recovery_state"] = "readback_pending"
            descriptor["effectful_retry_allowed"] = False
            try:
                write_recovery_checkpoint(
                    descriptor,
                    exact_blocker="browser_use_recording_command_failed",
                    next_action="fresh authority admission, then same-resource read-only reconcile; never replay the effectful command",
                    operation_id=operation_id,
                )
                _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
            except Exception:
                pass
        if parser_syntax_error:
            # Browser Use rejected the expression before page dispatch.  Keep
            # the command blocked, but do not manufacture an unknown external
            # effect that would prevent an otherwise safe continuation.
            # The immutable ledger keeps the original dispatch_failed row;
            # the explicit reconciliation row records the safe resolution.
            append_operation_reconciliation_durable(
                descriptor,
                operation_id=operation_id,
                external_effects="none",
                outcome="syntax_error_before_page_dispatch",
            )
        raise Blocker("browser_use_recording_command_failed", _LAST_RECORDING_CLI_FAILURE or str(code))
    if readback_exit != 0:
        append_operation_outcome_durable(descriptor, operation_id=operation_id, command=command, external_effects="unknown" if operation_effect == "unknown" else "none", outcome="readback_failed")
        if operation_effect in OPERATION_EFFECT_STATES:
            descriptor["recovery_state"] = "readback_pending"
            descriptor["effectful_retry_allowed"] = False
            try:
                write_recovery_checkpoint(
                    descriptor,
                    exact_blocker="browser_use_recording_readback_failed",
                    next_action="fresh authority admission, then same-resource read-only reconcile; never replay the effectful command",
                    operation_id=operation_id,
                )
                _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
            except Exception:
                pass
        raise Blocker("browser_use_recording_readback_failed", str(readback_exit))
    read_recording_status(descriptor["status_path"], require_active=True)
    if descriptor.get("tab_inventory_path"):
        descriptor["tab_inventory"] = read_recording_tab_inventory(descriptor["tab_inventory_path"])
    navigation_evidence: dict[str, Any] | None = None
    if command[0] in {"open", "back", "switch"}:
        descriptor["navigation_verified"] = False
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    if command[0] == "open":
        navigation_evidence = _verified_navigation_with_checkpoint(config, descriptor, recording, os.path.realpath(args.descriptor), expected_origins=origins, expected_url=command[1])
        current_origin = str(navigation_evidence["origin"])
        if current_origin not in set(origins):
            raise Blocker("browser_use_open_readback_origin_mismatch")
        descriptor["navigation_verified"] = True
    elif command[0] in {"back", "switch"}:
        navigation_evidence = _verified_navigation_with_checkpoint(config, descriptor, recording, os.path.realpath(args.descriptor))
        descriptor["navigation_verified"] = True
    elif command[0] == "close-tab":
        descriptor["navigation_verified"] = False
    elif operation_effect == "unknown":
        # A successful command exit is not enough proof after a potentially
        # effectful dispatch.  Refresh the same-run origin/readiness proof
        # before any success outcome is written.  A failed probe is itself an
        # unknown external effect and therefore blocks every later retry.
        try:
            navigation_evidence = _verified_navigation_with_checkpoint(config, descriptor, recording, os.path.realpath(args.descriptor))
            descriptor["navigation_verified"] = True
        except Exception as exc:
            append_operation_outcome_durable(
                descriptor,
                operation_id=operation_id,
                command=command,
                external_effects="unknown",
                outcome="post_dispatch_navigation_readback_failed",
            )
            raise Blocker(
                "browser_use_navigation_readback_failed",
                exc.code if isinstance(exc, Blocker) else type(exc).__name__,
            ) from exc
    try:
        capture_recording_frame(
            config,
            config["roots"]["browser_use_home"],
            descriptor["port"],
            descriptor["session"],
            recording,
        )
    except Exception as exc:
        append_operation_outcome_durable(
            descriptor,
            operation_id=operation_id,
            command=command,
            external_effects="unknown" if operation_effect == "unknown" else "none",
            outcome="post_dispatch_capture_failed" if operation_effect == "unknown" else "capture_failed",
        )
        try:
            write_recovery_checkpoint(
                descriptor,
                exact_blocker=exc.code if isinstance(exc, Blocker) else "browser_use_recording_capture_failed",
                next_action="same-run readback reconciliation before any retry",
                operation_id=operation_id,
            )
        except Exception:
            pass
        raise
    descriptor["status"] = "continued"
    descriptor["operations"].append(command[0])
    if operation_effect == "unknown":
        descriptor["business_effect_proof"] = "workflow_source_of_truth_required"
    append_operation_outcome_durable(
        descriptor,
        operation_id=operation_id,
        command=command,
        external_effects="executed" if operation_effect == "unknown" else operation_effect,
        outcome="dispatch_completed",
    )
    if navigation_evidence is not None:
        descriptor["last_navigation_readback"] = navigation_evidence
    if origins:
        descriptor["target_origins"] = sorted(set(descriptor["target_origins"]) | set(origins))
    if descriptor.get("owned_chrome") and descriptor.get("room_id"):
        room_registry_update(
            config,
            descriptor["room_id"],
            run_id=descriptor["run_id"],
            state="active",
            activity=f"record-command-{command[0]}",
        )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    output = {"status": "recording_continued", "descriptor": os.path.realpath(args.descriptor), "session": descriptor["session"], "recording_status": "active", "external_effects": "executed" if operation_effect == "unknown" else operation_effect, "business_effect_proof": "workflow_source_of_truth_required" if operation_effect == "unknown" else "not_applicable", "operation_id": operation_id, "navigation_readback": navigation_evidence, "finalized": False}
    if captured_readback:
        # Keep the helper envelope below the bounded parent-process stdout
        # limit.  The raw page snapshot is transient only; callers persist
        # hashes/lengths, never this body.  Preserve the beginning because
        # login/error markers appear before the result list on most pages.
        output["captured_readback"] = captured_readback[:MAX_CAPTURED_READBACK_CHARS]
        if len(captured_readback) > MAX_CAPTURED_READBACK_CHARS:
            output["captured_readback"] += "\n[truncated]"
    if semantic_readback is not None:
        output["readback"] = semantic_readback
    print(json.dumps(output, sort_keys=True))
    return 0


def record_resume(args: argparse.Namespace) -> int:
    """Resume recording on the same verified scheduled Chrome process."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=False,
        allow_pinned_helper_reexec=True,
    )
    require_temporary_task_id(args, descriptor)
    if descriptor.get("status") not in {"active", "continued"}:
        raise Blocker("browser_use_recording_resume_descriptor_not_continuable")
    recording_authority(
        config,
        descriptor,
        args.authority,
        command_class="record-resume",
        renewal_path=getattr(args, "authority_renewal", None),
    )
    if getattr(args, "authority_renewal", None):
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    validate_recording_process(config, descriptor)
    old_status = read_json_safe(descriptor["status_path"])
    if old_status.get("finalized") is not True:
        raise Blocker("browser_use_recording_resume_requires_finalized_recorder")
    recording_dir = validate_recording_output_dir(args.recording_dir)
    recording = recording_env(
        config,
        recording_dir,
        recording_status_path(recording_dir),
        descriptor["recording_framerate"],
    )
    command = [
        "record-start",
        recording["recording_name"],
        recording["recording_source_dir"],
        f"{run_id} browser recording resumed",
    ]
    code, readback_exit = run_cli_keep_alive(
        config,
        config["roots"]["browser_use_home"],
        descriptor["port"],
        descriptor["session"],
        command,
        True,
        recording=recording,
    )
    if code != 0:
        raise Blocker("browser_use_recording_resume_start_failed", _LAST_RECORDING_CLI_FAILURE or str(code))
    if readback_exit != 0:
        raise Blocker("browser_use_recording_resume_readback_failed", str(readback_exit))
    write_harness_recording_status(recording["status_path"], recording, active=True, finalized=False)
    descriptor.update({
        "status": "continued",
        "helper_sha256": sha256_file(os.path.realpath(sys.argv[0])),
        "recording_dir": recording["recording_dir"],
        "status_path": recording["status_path"],
        "recording_source_dir": recording["recording_source_dir"],
        "harness_workspace": recording.get("harness_workspace"),
        "tab_inventory_path": recording.get("tab_inventory_path"),
        "recording_backend": "browser-harness",
        "operations": list(descriptor.get("operations", [])) + ["record-resume"],
        "tab_inventory": read_recording_tab_inventory(recording["tab_inventory_path"]),
    })
    if descriptor.get("owned_chrome") and descriptor.get("room_id"):
        room_registry_update(config, descriptor["room_id"], run_id=descriptor["run_id"], state="active", activity="record-resume")
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    print(json.dumps({
        "status": "recording_resumed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "recording_dir": recording["recording_dir"],
        "recording_status": "active",
        "same_process": True,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_recover(args: argparse.Namespace) -> int:
    """Perform bounded, read-only same-run reconciliation before resuming work."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=False,
        allow_pinned_helper_reexec=True,
        allow_stale_runtime_recovery=True,
    )
    require_temporary_task_id(args, descriptor)
    recording_authority(
        config,
        descriptor,
        args.authority,
        command_class="record-recover",
        renewal_path=getattr(args, "authority_renewal", None),
    )
    if getattr(args, "authority_renewal", None):
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    stale_runtime = _recording_runtime_is_stale(config, descriptor)
    if stale_runtime:
        try:
            output = reconcile_stale_recording_runtime(
                config,
                descriptor,
                os.path.realpath(args.descriptor),
                max_attempts=getattr(args, "max_attempts", MAX_RECORDING_RECOVERY_ATTEMPTS),
            )
        except Blocker as exc:
            current_attempts = int(descriptor.get("recovery_retry_count", 0))
            configured_limit = max(1, min(int(descriptor.get("recovery_max_attempts", getattr(args, "max_attempts", MAX_RECORDING_RECOVERY_ATTEMPTS))), MAX_RECORDING_RECOVERY_ATTEMPTS))
            descriptor["recovery_max_attempts"] = configured_limit
            descriptor["recovery_retry_count"] = min(current_attempts + 1, configured_limit)
            try:
                write_recovery_checkpoint(
                    descriptor,
                    exact_blocker=exc.code,
                    next_action="preserve unknown effects and retry only within the descriptor recovery limit",
                )
                _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
            except Exception:
                pass
            print(json.dumps({"status": "blocked", "descriptor": os.path.realpath(args.descriptor), "exact_blocker": exc.code, "detail": exc.detail, "finalized": False}, sort_keys=True))
            return 1
        print(json.dumps(output, sort_keys=True))
        return 0
    require_recording_continuable(descriptor)
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    validate_recording_process(config, descriptor)
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])
    # Close only the missing ledger outcome records.  The replacement outcome
    # is deliberately ``unknown`` so recovery cannot make an effectful retry
    # admissible or turn finalization into a false success.
    close_orphan_operation_intents(descriptor)
    max_attempts = max(1, min(int(getattr(args, "max_attempts", MAX_RECORDING_RECOVERY_ATTEMPTS)), MAX_RECORDING_RECOVERY_ATTEMPTS))
    descriptor_max_attempts = max(1, min(int(descriptor.get("recovery_max_attempts", max_attempts)), MAX_RECORDING_RECOVERY_ATTEMPTS))
    prior_recovery_attempts = int(descriptor.get("recovery_retry_count", 0))
    if prior_recovery_attempts >= descriptor_max_attempts:
        write_recovery_checkpoint(
            descriptor,
            exact_blocker="browser_use_recording_recovery_attempt_limit",
            next_action="fresh same-task admission or new owned run",
        )
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
        print(json.dumps({"status": "blocked", "descriptor": os.path.realpath(args.descriptor), "exact_blocker": "browser_use_recording_recovery_attempt_limit", "recovery_attempts": prior_recovery_attempts, "finalized": False}, sort_keys=True))
        return 1
    max_attempts = min(max_attempts, descriptor_max_attempts - prior_recovery_attempts)
    descriptor["recovery_max_attempts"] = descriptor_max_attempts
    last_blocker = "browser_use_recording_recovery_readback_failed"
    for attempt in range(1, max_attempts + 1):
        operation_id = uuid.uuid4().hex
        append_operation_intent_durable(descriptor, operation_id=operation_id, command=["state"], external_effects="none", outcome="recovery_readback_intent")
        try:
            code, readback_exit, stdout = run_cli_keep_alive_capture(
                config,
                config["roots"]["browser_use_home"],
                descriptor["port"],
                descriptor["session"],
                ["state"],
                recording=recording,
            )
            if code != 0 or readback_exit != 0:
                last_blocker = "browser_use_recording_recovery_readback_failed"
                append_operation_outcome_durable(descriptor, operation_id=operation_id, command=["state"], external_effects="none", outcome=last_blocker)
                continue
            parsed = _parse_cli_json(stdout)
            raw_state = _state_text_from_cli(parsed)
            summary = _target_state_summary(parsed, raw_state)
            append_operation_outcome_durable(descriptor, operation_id=operation_id, command=["state"], external_effects="none", outcome="recovery_readback_verified")
            if descriptor.get("tab_inventory_path"):
                descriptor["tab_inventory"] = read_recording_tab_inventory(descriptor["tab_inventory_path"])
            descriptor["status"] = "continued"
            descriptor["recovery_retry_count"] = prior_recovery_attempts + attempt - 1
            descriptor["last_recovery_readback"] = summary
            _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
            print(json.dumps({"status": "recording_recovered", "descriptor": os.path.realpath(args.descriptor), "run_id": run_id, "session": descriptor["session"], "attempts": attempt, "navigation_verified": descriptor.get("navigation_verified") is True, "readback": summary, "pending_reconciliation": pending_operation_reconciliation_ids(descriptor), "effectful_resume_allowed": not pending_operation_reconciliation_ids(descriptor), "finalized": False}, sort_keys=True))
            return 0
        except Exception as exc:
            last_blocker = exc.code if isinstance(exc, Blocker) else "browser_use_recording_recovery_failed"
            try:
                append_operation_outcome_durable(descriptor, operation_id=operation_id, command=["state"], external_effects="none", outcome=last_blocker)
            except Blocker as outcome_exc:
                # A recovery attempt must not continue as if its own ledger
                # outcome were durable.  Stop the bounded loop and persist the
                # stronger reconciliation blocker.
                last_blocker = outcome_exc.code
                break
    descriptor["recovery_retry_count"] = prior_recovery_attempts + max_attempts
    write_recovery_checkpoint(descriptor, exact_blocker=last_blocker, next_action="fresh same-run admission or new owned run")
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    print(json.dumps({"status": "blocked", "descriptor": os.path.realpath(args.descriptor), "exact_blocker": last_blocker, "recovery_attempts": max_attempts, "finalized": False}, sort_keys=True))
    return 1


def record_reconcile_navigation(args: argparse.Namespace) -> int:
    """Clear one recovered ``open`` intent only after fresh same-run readback.

    ``record-recover`` deliberately records an unknown outcome and therefore
    cannot reopen effectful work.  This command is the narrowly scoped owner
    path for the read-only case where the original intent was already marked
    ``external_effects=none`` and the live run now proves the authorized page
    is present.  It never dispatches the original navigation again.
    """
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        # A live run may be undergoing this helper's bounded, read-only
        # reconciliation after a canonical helper update.  The immutable
        # run-pinned snapshot remains the fallback for all later commands.
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
    )
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    recording_authority(config, descriptor, args.authority)
    validate_recording_process(config, descriptor)
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])

    pending = pending_operation_reconciliation_ids(descriptor)
    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    # A prior invocation of this same bounded read-only repair may have
    # stopped after dispatching its get/state probe but before appending the
    # probe outcome.  Only the helper's own, externally-none readback intents
    # are eligible for this idempotent closure; the original open intent is
    # never touched here.
    outcome_ids = {
        str(row.get("operation_id"))
        for row in rows
        if row.get("phase") == "outcome"
    }
    for row in rows:
        if (
            row.get("phase") == "intent"
            and str(row.get("operation_id")) not in outcome_ids
            and row.get("external_effects") == "none"
            and row.get("outcome") == "navigation_reconciliation_readback_intent"
            and isinstance(row.get("command"), dict)
            and row["command"].get("name") in {"get", "state"}
        ):
            append_operation_outcome_durable(
                descriptor,
                operation_id=str(row["operation_id"]),
                command=[str(row["command"].get("name")), "readback"],
                external_effects="none",
                outcome="navigation_reconciliation_readback_recovered",
            )
    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    if args.operation_id not in pending:
        reconciled = {
            operation_id
            for item in descriptor.get("reconciliations", [])
            if isinstance(item, dict) and item.get("resolution") in {"none", "executed"}
            for operation_id in item.get("operation_ids", [])
            if isinstance(operation_id, str)
        }
        ledger_reconciled = {
            str(row.get("operation_id"))
            for row in rows
            if row.get("phase") == "reconciliation" and row.get("external_effects") in {"none", "executed"}
        }
        if args.operation_id in reconciled or args.operation_id in ledger_reconciled:
            remaining = pending_operation_reconciliation_ids(descriptor)
            print(json.dumps({
                "status": "recording_reconciliation_already_completed",
                "descriptor": os.path.realpath(args.descriptor),
                "run_id": run_id,
                "session": descriptor["session"],
                "operation_id": args.operation_id,
                "resolution": "none",
                "pending_reconciliation": remaining,
                "fresh_run_admission_allowed": not remaining,
                "effectful_resume_allowed": not remaining,
                "finalized": False,
            }, sort_keys=True))
            return 0
        raise Blocker("browser_use_navigation_reconciliation_operation_not_pending")

    _navigation_reconciliation_candidate(rows, args.operation_id)

    def readback_operation(command: list[str], outcome: str) -> dict[str, Any]:
        readback_id = uuid.uuid4().hex
        append_operation_intent_durable(
            descriptor,
            operation_id=readback_id,
            command=command,
            external_effects="none",
            outcome="navigation_reconciliation_readback_intent",
        )
        try:
            code, readback_exit, stdout = run_cli_keep_alive_capture(
                config,
                config["roots"]["browser_use_home"],
                descriptor["port"],
                descriptor["session"],
                command,
                recording=recording,
            )
            if code != 0 or readback_exit != 0:
                append_operation_outcome_durable(
                    descriptor,
                    operation_id=readback_id,
                    command=command,
                    external_effects="none",
                    outcome=outcome,
                )
                raise Blocker("browser_use_navigation_reconciliation_readback_failed", command[0])
            parsed = _parse_cli_json(stdout)
            if command == ["state"]:
                raw_state = _state_text_from_cli(parsed)
                summary = _target_state_summary(parsed, raw_state)
            else:
                # ``get url`` is a URL envelope, not a page-state envelope.
                # Keep only a digest/length so no URL text enters durable state.
                url_value = str(_first_field(parsed, {"url", "href"}) or "")
                summary = {
                    "url_sha256": hashlib.sha256(url_value.encode("utf-8")).hexdigest(),
                    "url_length": len(url_value),
                }
            append_operation_outcome_durable(
                descriptor,
                operation_id=readback_id,
                command=command,
                external_effects="none",
                outcome="navigation_reconciliation_readback_verified",
            )
            return {"operation_id": readback_id, **summary}
        except Blocker as exc:
            try:
                append_operation_outcome_durable(
                    descriptor,
                    operation_id=readback_id,
                    command=command,
                    external_effects="none",
                    outcome="navigation_reconciliation_readback_failed",
                )
            except Blocker:
                pass
            raise
        except Exception as exc:
            append_operation_outcome_durable(
                descriptor,
                operation_id=readback_id,
                command=command,
                external_effects="none",
                outcome=outcome,
            )
            raise Blocker("browser_use_navigation_reconciliation_readback_failed", type(exc).__name__) from exc

    try:
        navigation = _verified_navigation_with_checkpoint(
            config,
            descriptor,
            recording,
            os.path.realpath(args.descriptor),
            expected_origins=list(descriptor["target_origins"]),
        )
        url_readback = readback_operation(["get", "url"], "navigation_url_readback_failed")
        state_readback = readback_operation(["state"], "navigation_state_readback_failed")
    except Exception as exc:
        blocker = exc.code if isinstance(exc, Blocker) else "browser_use_navigation_reconciliation_readback_failed"
        try:
            write_recovery_checkpoint(
                descriptor,
                exact_blocker=blocker,
                next_action="preserve the pending navigation intent and stop before any effectful operation",
                operation_id=args.operation_id,
            )
            _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
        except Exception:
            pass
        raise

    append_operation_reconciliation_durable(
        descriptor,
        operation_id=args.operation_id,
        external_effects="none",
        outcome="navigation_readback_verified_no_external_effect",
    )
    descriptor.setdefault("reconciliations", []).append({
        "operation_ids": [args.operation_id],
        "resolution": "none",
        "basis": "browser_use_navigation_readback_verified_no_external_effect",
        "readback_operation_ids": [url_readback["operation_id"], state_readback["operation_id"]],
        "navigation_origin": navigation.get("origin") if isinstance(navigation, dict) else str(navigation),
        "navigation_path_sha256": navigation.get("path_sha256") if isinstance(navigation, dict) else None,
        "navigation_path_length": navigation.get("path_length") if isinstance(navigation, dict) else None,
        "state_sha256": state_readback["state_sha256"],
        "state_length": state_readback["state_length"],
        "recorded_at": iso(now_utc()),
    })
    descriptor["navigation_verified"] = True
    descriptor["reconciliation_state"] = "completed"
    descriptor["reconciliation_exact_blocker"] = "browser_use_navigation_reconciliation_completed"
    descriptor["last_navigation_readback"] = navigation
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_navigation_reconciliation_completed",
        next_action="fresh same-task target inspection before any effectful UI operation",
        operation_id=args.operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    remaining = pending_operation_reconciliation_ids(descriptor)
    print(json.dumps({
        "status": "recording_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_id": args.operation_id,
        "resolution": "none",
        "evidence": "browser_use_navigation_readback_verified_no_external_effect",
        "readback": {"navigation": navigation, "url": url_readback, "state": state_readback},
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "effectful_resume_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_reconcile_eval_syntax_error(args: argparse.Namespace) -> int:
    """Reconcile one parser-level eval failure without replaying the eval."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
    )
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    recording_authority(config, descriptor, args.authority)
    validate_recording_process(config, descriptor)
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])

    pending = pending_operation_reconciliation_ids(descriptor)
    reconciled = {
        operation_id
        for item in descriptor.get("reconciliations", [])
        if isinstance(item, dict) and item.get("resolution") in {"none", "executed"}
        for operation_id in item.get("operation_ids", [])
        if isinstance(operation_id, str)
    }
    if args.operation_id not in pending:
        if args.operation_id in reconciled:
            remaining = pending_operation_reconciliation_ids(descriptor)
            print(json.dumps({
                "status": "recording_reconciliation_already_completed",
                "descriptor": os.path.realpath(args.descriptor),
                "run_id": run_id,
                "session": descriptor["session"],
                "operation_id": args.operation_id,
                "resolution": "none",
                "evidence": args.evidence_code,
                "pending_reconciliation": remaining,
                "fresh_run_admission_allowed": not remaining,
                "effectful_resume_allowed": not remaining,
                "finalized": False,
            }, sort_keys=True))
            return 0
        raise Blocker("browser_use_eval_reconciliation_operation_not_pending")

    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    _eval_syntax_error_reconciliation_candidate(rows, args.operation_id)
    navigation = _verified_navigation_with_checkpoint(
        config,
        descriptor,
        recording,
        os.path.realpath(args.descriptor),
        expected_origins=list(descriptor["target_origins"]),
    )

    expected_path = str(args.expected_path)
    parsed_expected = urllib.parse.urlparse(expected_path)
    if (
        not expected_path.startswith("/")
        or parsed_expected.path != expected_path
        or parsed_expected.query
        or parsed_expected.fragment
    ):
        raise Blocker("browser_use_eval_reconciliation_expected_path_invalid")
    if (
        not isinstance(navigation, dict)
        or navigation.get("path_length") != len(expected_path)
        or navigation.get("path_sha256") != hashlib.sha256(expected_path.encode("utf-8")).hexdigest()
    ):
        raise Blocker("browser_use_eval_reconciliation_expected_path_mismatch")

    readback_id = uuid.uuid4().hex
    readback_command = ["state"]
    append_operation_intent_durable(
        descriptor,
        operation_id=readback_id,
        command=readback_command,
        external_effects="none",
        outcome="eval_reconciliation_readback_intent",
    )
    try:
        code, readback_exit, stdout = run_cli_keep_alive_capture(
            config,
            config["roots"]["browser_use_home"],
            descriptor["port"],
            descriptor["session"],
            readback_command,
            recording=recording,
        )
        if code != 0 or readback_exit != 0:
            append_operation_outcome_durable(
                descriptor,
                operation_id=readback_id,
                command=readback_command,
                external_effects="none",
                outcome="eval_reconciliation_readback_failed",
            )
            raise Blocker("browser_use_eval_reconciliation_state_readback_failed")
        parsed = _parse_cli_json(stdout)
        raw_state = _state_text_from_cli(parsed)
        state_marker = str(args.state_marker)
        if not state_marker or state_marker not in raw_state:
            append_operation_outcome_durable(
                descriptor,
                operation_id=readback_id,
                command=readback_command,
                external_effects="none",
                outcome="eval_reconciliation_state_marker_missing",
            )
            raise Blocker("browser_use_eval_reconciliation_state_marker_missing")
        append_operation_outcome_durable(
            descriptor,
            operation_id=readback_id,
            command=readback_command,
            external_effects="none",
            outcome="eval_reconciliation_readback_verified",
        )
    except Blocker:
        try:
            append_operation_outcome_durable(
                descriptor,
                operation_id=readback_id,
                command=readback_command,
                external_effects="none",
                outcome="eval_reconciliation_readback_failed",
            )
        except Blocker:
            pass
        raise
    except Exception as exc:
        append_operation_outcome_durable(
            descriptor,
            operation_id=readback_id,
            command=readback_command,
            external_effects="none",
            outcome="eval_reconciliation_readback_failed",
        )
        raise Blocker("browser_use_eval_reconciliation_state_readback_failed", type(exc).__name__) from exc

    append_operation_reconciliation_durable(
        descriptor,
        operation_id=args.operation_id,
        external_effects="none",
        outcome="eval_syntax_error_before_page_dispatch",
    )
    descriptor.setdefault("reconciliations", []).append({
        "operation_ids": [args.operation_id],
        "resolution": "none",
        "basis": args.evidence_code,
        "eval_shape": "one_scalar_argument",
        "navigation_origin": navigation.get("origin"),
        "navigation_path_sha256": navigation.get("path_sha256"),
        "navigation_path_length": navigation.get("path_length"),
        "state_marker_sha256": hashlib.sha256(str(args.state_marker).encode("utf-8")).hexdigest(),
        "state_marker_length": len(str(args.state_marker)),
        "state_sha256": hashlib.sha256(raw_state.encode("utf-8")).hexdigest(),
        "state_length": len(raw_state),
        "readback_operation_ids": [readback_id],
        "recorded_at": iso(now_utc()),
    })
    descriptor["navigation_verified"] = True
    descriptor["reconciliation_state"] = "completed"
    descriptor["reconciliation_exact_blocker"] = "browser_use_eval_reconciliation_completed"
    descriptor["last_navigation_readback"] = navigation
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_eval_reconciliation_completed",
        next_action="fresh target inspect before the next effectful operation",
        operation_id=args.operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    remaining = pending_operation_reconciliation_ids(descriptor)
    print(json.dumps({
        "status": "recording_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_id": args.operation_id,
        "resolution": "none",
        "evidence": args.evidence_code,
        "navigation_readback": navigation,
        "state_marker_sha256": hashlib.sha256(str(args.state_marker).encode("utf-8")).hexdigest(),
        "state_marker_length": len(str(args.state_marker)),
        "state_sha256": hashlib.sha256(raw_state.encode("utf-8")).hexdigest(),
        "state_length": len(raw_state),
        "readback_operation_id": readback_id,
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "effectful_resume_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_reconcile_target_not_interactive_live(args: argparse.Namespace) -> int:
    """Reconcile one live target-click rejection after fresh noninteractive proof."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
    )
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    authority = recording_authority(config, descriptor, args.authority)
    if not authority:
        raise Blocker("browser_use_authority_required")
    validate_recording_process(config, descriptor)
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])

    target_hash = hashlib.sha256(str(args.target_text).encode("utf-8")).hexdigest()
    failures = [
        item
        for item in descriptor.get("failed_operations", [])
        if isinstance(item, dict)
        and item.get("operation") == "target-click"
        and item.get("operation_id") == args.operation_id
        and item.get("exact_blocker") == "browser_use_target_click_failed"
        and item.get("external_action_possible") is True
        and item.get("target_text_length") == len(args.target_text)
        and item.get("target_text_sha256") == target_hash
    ]
    if len(failures) != 1:
        raise Blocker("browser_use_target_reconciliation_evidence_mismatch")
    pending = pending_operation_reconciliation_ids(descriptor)
    if args.operation_id not in pending:
        raise Blocker("browser_use_target_reconciliation_operation_not_pending")
    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    _target_click_reconciliation_candidate(rows, args.operation_id)

    navigation = _verified_navigation_with_checkpoint(
        config,
        descriptor,
        recording,
        os.path.realpath(args.descriptor),
        expected_origins=list(descriptor["target_origins"]),
    )
    candidate, before = _target_capture(config, descriptor, recording, args.target_text)
    if candidate.get("interactive") is not False:
        raise Blocker("browser_use_target_reconciliation_candidate_changed")
    if candidate.get("text_length") != len(args.target_text) or candidate.get("match_text_sha256") != target_hash:
        raise Blocker("browser_use_target_reconciliation_evidence_mismatch")

    append_operation_reconciliation_durable(
        descriptor,
        operation_id=args.operation_id,
        external_effects="none",
        outcome="target_rejected_noninteractive_before_dispatch",
    )
    descriptor.setdefault("reconciliations", []).append({
        "operation_ids": [args.operation_id],
        "resolution": "none",
        "basis": "runtime_error_browser_use_target_not_interactive",
        "target_text_length": len(args.target_text),
        "target_text_sha256": target_hash,
        "candidate_interactive": False,
        "candidate_bbox": candidate.get("bbox"),
        "navigation_origin": navigation.get("origin") if isinstance(navigation, dict) else str(navigation),
        "before_state": before,
        "recorded_at": iso(now_utc()),
    })
    descriptor["navigation_verified"] = True
    descriptor["reconciliation_state"] = "completed"
    descriptor["reconciliation_exact_blocker"] = "browser_use_target_reconciliation_completed"
    descriptor["last_navigation_readback"] = navigation
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_target_reconciliation_completed",
        next_action="fresh target inspect, then one explicit fresh-bbox coordinate click if still authorized",
        operation_id=args.operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    remaining = pending_operation_reconciliation_ids(descriptor)
    print(json.dumps({
        "status": "recording_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_id": args.operation_id,
        "resolution": "none",
        "evidence": "runtime_error_browser_use_target_not_interactive",
        "candidate": candidate,
        "before_state": before,
        "navigation_readback": navigation,
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "effectful_resume_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_reconcile_target_not_interactive_history(args: argparse.Namespace) -> int:
    """Reconcile a helper rejection when the target disappeared after a later UI state change."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
    )
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    authority = recording_authority(config, descriptor, args.authority)
    if not authority:
        raise Blocker("browser_use_authority_required")
    validate_recording_process(config, descriptor)
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])

    target_hash = str(args.target_text_sha256)
    failures = [
        item
        for item in descriptor.get("failed_operations", [])
        if isinstance(item, dict)
        and item.get("operation") == "target-click"
        and item.get("operation_id") == args.operation_id
        and item.get("exact_blocker") == "browser_use_target_click_failed"
        and item.get("external_action_possible") is True
        and item.get("target_text_length") == args.target_text_length
        and item.get("target_text_sha256") == target_hash
    ]
    if len(failures) != 1:
        raise Blocker("browser_use_target_reconciliation_evidence_mismatch")
    pending = pending_operation_reconciliation_ids(descriptor)
    reconciled = {
        operation_id
        for item in descriptor.get("reconciliations", [])
        if isinstance(item, dict) and item.get("resolution") in {"none", "executed"}
        for operation_id in item.get("operation_ids", [])
        if isinstance(operation_id, str)
    }
    if args.operation_id not in pending:
        if args.operation_id in reconciled:
            remaining = pending_operation_reconciliation_ids(descriptor)
            print(json.dumps({
                "status": "recording_reconciliation_already_completed",
                "descriptor": os.path.realpath(args.descriptor),
                "run_id": run_id,
                "session": descriptor["session"],
                "operation_id": args.operation_id,
                "resolution": "none",
                "pending_reconciliation": remaining,
                "fresh_run_admission_allowed": not remaining,
                "effectful_resume_allowed": not remaining,
                "finalized": False,
            }, sort_keys=True))
            return 0
        raise Blocker("browser_use_target_reconciliation_operation_not_pending")

    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    _target_click_reconciliation_candidate(rows, args.operation_id)
    navigation = _verified_navigation_with_checkpoint(
        config,
        descriptor,
        recording,
        os.path.realpath(args.descriptor),
        expected_origins=list(descriptor["target_origins"]),
    )
    code, readback_exit, stdout = run_cli_keep_alive_capture(
        config,
        config["roots"]["browser_use_home"],
        descriptor["port"],
        descriptor["session"],
        ["state"],
        recording=recording,
    )
    if code != 0 or readback_exit != 0:
        raise Blocker("browser_use_target_reconciliation_state_readback_failed")
    parsed = _parse_cli_json(stdout)
    raw_state = _state_text_from_cli(parsed)
    state_marker = str(args.state_marker)
    if not state_marker or state_marker not in raw_state:
        raise Blocker("browser_use_target_reconciliation_state_marker_missing")

    append_operation_reconciliation_durable(
        descriptor,
        operation_id=args.operation_id,
        external_effects="none",
        outcome="target_rejected_noninteractive_before_dispatch",
    )
    descriptor.setdefault("reconciliations", []).append({
        "operation_ids": [args.operation_id],
        "resolution": "none",
        "basis": args.evidence_code,
        "target_text_length": args.target_text_length,
        "target_text_sha256": target_hash,
        "candidate_status": "not_present_after_later_same_run_state_change",
        "navigation_origin": navigation.get("origin") if isinstance(navigation, dict) else str(navigation),
        "state_marker_sha256": hashlib.sha256(state_marker.encode("utf-8")).hexdigest(),
        "state_marker_length": len(state_marker),
        "state_sha256": hashlib.sha256(raw_state.encode("utf-8")).hexdigest(),
        "state_length": len(raw_state),
        "recorded_at": iso(now_utc()),
    })
    descriptor["navigation_verified"] = True
    descriptor["reconciliation_state"] = "completed"
    descriptor["reconciliation_exact_blocker"] = "browser_use_target_reconciliation_completed"
    descriptor["last_navigation_readback"] = navigation
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_target_reconciliation_completed",
        next_action="fresh target inspect before the next effectful operation",
        operation_id=args.operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    remaining = pending_operation_reconciliation_ids(descriptor)
    print(json.dumps({
        "status": "recording_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_id": args.operation_id,
        "resolution": "none",
        "evidence": "target_click_helper_rejected_before_dispatch_after_same_run_state_change",
        "candidate_status": "not_present_after_later_same_run_state_change",
        "navigation_readback": navigation,
        "state_marker_length": len(state_marker),
        "state_marker_sha256": hashlib.sha256(state_marker.encode("utf-8")).hexdigest(),
        "state_length": len(raw_state),
        "state_sha256": hashlib.sha256(raw_state.encode("utf-8")).hexdigest(),
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "effectful_resume_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_reconcile_click_readback(args: argparse.Namespace) -> int:
    """Resolve one click only after exact same-run URL and page-state proof."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
    )
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    authority = recording_authority(config, descriptor, args.authority)
    if not authority:
        raise Blocker("browser_use_authority_required")
    validate_recording_process(config, descriptor)
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])
    pending = pending_operation_reconciliation_ids(descriptor)
    if args.operation_id not in pending:
        raise Blocker("browser_use_click_reconciliation_operation_not_pending")
    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    _coordinate_click_reconciliation_candidate(rows, args.operation_id)

    def readback(command: list[str], *, state: bool) -> tuple[str, dict[str, Any]]:
        readback_id = uuid.uuid4().hex
        append_operation_intent_durable(
            descriptor,
            operation_id=readback_id,
            command=command,
            external_effects="none",
            outcome="click_reconciliation_readback_intent",
        )
        try:
            code, readback_exit, stdout = run_cli_keep_alive_capture(
                config,
                config["roots"]["browser_use_home"],
                descriptor["port"],
                descriptor["session"],
                command,
                recording=recording,
            )
            if code != 0 or readback_exit != 0:
                append_operation_outcome_durable(
                    descriptor,
                    operation_id=readback_id,
                    command=command,
                    external_effects="none",
                    outcome="click_reconciliation_readback_failed",
                )
                raise Blocker("browser_use_click_reconciliation_readback_failed", command[0])
            parsed = _parse_cli_json(stdout)
            if state:
                raw_state = _state_text_from_cli(parsed)
                if "デザインワークスペースへようこそ" not in raw_state:
                    append_operation_outcome_durable(
                        descriptor,
                        operation_id=readback_id,
                        command=command,
                        external_effects="none",
                        outcome="click_reconciliation_business_state_missing",
                    )
                    raise Blocker("browser_use_click_reconciliation_business_state_missing")
                summary = _target_state_summary(parsed, raw_state)
            else:
                value = str(_first_field(parsed, {"url", "href"}) or "")
                parsed_url = urllib.parse.urlparse(value)
                if (
                    parsed_url.scheme != "https"
                    or (parsed_url.hostname or "").lower().rstrip(".") != "jp.linkaigc.com"
                    or (parsed_url.path or "/") != "/designProduction"
                    or parsed_url.query
                    or parsed_url.fragment
                ):
                    append_operation_outcome_durable(
                        descriptor,
                        operation_id=readback_id,
                        command=command,
                        external_effects="none",
                        outcome="click_reconciliation_url_mismatch",
                    )
                    raise Blocker("browser_use_click_reconciliation_url_mismatch")
                summary = {
                    "origin": "https://jp.linkaigc.com",
                    "path_sha256": hashlib.sha256("/designProduction".encode("utf-8")).hexdigest(),
                    "path_length": len("/designProduction"),
                    "path_representation": "sha256_only",
                }
            append_operation_outcome_durable(
                descriptor,
                operation_id=readback_id,
                command=command,
                external_effects="none",
                outcome="click_reconciliation_readback_verified",
            )
            return readback_id, summary
        except Blocker:
            raise
        except Exception as exc:
            try:
                append_operation_outcome_durable(
                    descriptor,
                    operation_id=readback_id,
                    command=command,
                    external_effects="none",
                    outcome="click_reconciliation_readback_failed",
                )
            except Blocker:
                pass
            raise Blocker("browser_use_click_reconciliation_readback_failed", type(exc).__name__) from exc

    url_id, navigation = readback(["get", "url"], state=False)
    state_id, state_summary = readback(["state"], state=True)
    append_operation_reconciliation_durable(
        descriptor,
        operation_id=args.operation_id,
        external_effects="executed",
        outcome="click_navigation_readback_verified",
    )
    descriptor.setdefault("reconciliations", []).append({
        "operation_ids": [args.operation_id],
        "resolution": "executed",
        "basis": "browser_use_click_navigation_readback_verified",
        "readback_operation_ids": [url_id, state_id],
        "navigation": navigation,
        "state": state_summary,
        "recorded_at": iso(now_utc()),
    })
    descriptor["navigation_verified"] = True
    descriptor["last_navigation_readback"] = {"schema": "browser-use-navigation-readback.v1", **navigation, "ready_state_verified": False}
    descriptor["reconciliation_state"] = "completed"
    descriptor["reconciliation_exact_blocker"] = "browser_use_click_reconciliation_completed"
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_click_reconciliation_completed",
        next_action="fresh read-only state and feature inspection in design workspace",
        operation_id=args.operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    remaining = pending_operation_reconciliation_ids(descriptor)
    print(json.dumps({
        "status": "recording_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_id": args.operation_id,
        "resolution": "executed",
        "evidence": "browser_use_click_navigation_readback_verified",
        "navigation": navigation,
        "state": state_summary,
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "effectful_resume_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_reconcile_click_readback_live(args: argparse.Namespace) -> int:
    """Reconcile a coordinate click after fresh same-run route and state proof."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
    )
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    authority = recording_authority(config, descriptor, args.authority)
    if not authority:
        raise Blocker("browser_use_authority_required")
    validate_recording_process(config, descriptor)
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])

    pending = pending_operation_reconciliation_ids(descriptor)
    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    if args.operation_id not in pending:
        reconciled = {
            operation_id
            for item in descriptor.get("reconciliations", [])
            if isinstance(item, dict) and item.get("resolution") in {"none", "executed"}
            for operation_id in item.get("operation_ids", [])
            if isinstance(operation_id, str)
        }
        if args.operation_id in reconciled:
            remaining = pending_operation_reconciliation_ids(descriptor)
            print(json.dumps({
                "status": "recording_reconciliation_already_completed",
                "descriptor": os.path.realpath(args.descriptor),
                "run_id": run_id,
                "session": descriptor["session"],
                "operation_id": args.operation_id,
                "resolution": "executed",
                "pending_reconciliation": remaining,
                "fresh_run_admission_allowed": not remaining,
                "effectful_resume_allowed": not remaining,
                "finalized": False,
            }, sort_keys=True))
            return 0
        raise Blocker("browser_use_click_reconciliation_operation_not_pending")
    _coordinate_click_reconciliation_candidate(rows, args.operation_id)

    expected_path = str(args.expected_path)
    parsed_expected = urllib.parse.urlparse(expected_path)
    if (
        not expected_path.startswith("/")
        or parsed_expected.path != expected_path
        or parsed_expected.query
        or parsed_expected.fragment
    ):
        raise Blocker("browser_use_click_reconciliation_expected_path_invalid")
    state_marker = str(args.state_marker)
    if not state_marker:
        raise Blocker("browser_use_click_reconciliation_state_marker_empty")

    navigation = _verified_navigation_with_checkpoint(
        config,
        descriptor,
        recording,
        os.path.realpath(args.descriptor),
        expected_origins=list(descriptor["target_origins"]),
    )
    if not isinstance(navigation, dict):
        raise Blocker("browser_use_click_reconciliation_navigation_evidence_missing")
    if (
        navigation.get("path_length") != len(expected_path)
        or navigation.get("path_sha256") != hashlib.sha256(expected_path.encode("utf-8")).hexdigest()
    ):
        raise Blocker("browser_use_click_reconciliation_expected_path_mismatch")

    code, readback_exit, stdout = run_cli_keep_alive_capture(
        config,
        config["roots"]["browser_use_home"],
        descriptor["port"],
        descriptor["session"],
        ["state"],
        recording=recording,
    )
    if code != 0 or readback_exit != 0:
        raise Blocker("browser_use_click_reconciliation_state_readback_failed")
    parsed = _parse_cli_json(stdout)
    raw_state = _state_text_from_cli(parsed)
    if state_marker not in raw_state:
        raise Blocker("browser_use_click_reconciliation_state_marker_missing")

    append_operation_reconciliation_durable(
        descriptor,
        operation_id=args.operation_id,
        external_effects="executed",
        outcome="click_navigation_readback_verified",
    )
    descriptor.setdefault("reconciliations", []).append({
        "operation_ids": [args.operation_id],
        "resolution": "executed",
        "basis": "browser_use_coordinate_click_navigation_readback_verified",
        "navigation": {
            "origin": navigation.get("origin"),
            "path_sha256": navigation.get("path_sha256"),
            "path_length": navigation.get("path_length"),
        },
        "state_marker_sha256": hashlib.sha256(state_marker.encode("utf-8")).hexdigest(),
        "state_marker_length": len(state_marker),
        "state_sha256": hashlib.sha256(raw_state.encode("utf-8")).hexdigest(),
        "state_length": len(raw_state),
        "recorded_at": iso(now_utc()),
    })
    descriptor["navigation_verified"] = True
    descriptor["reconciliation_state"] = "completed"
    descriptor["reconciliation_exact_blocker"] = "browser_use_coordinate_click_reconciliation_completed"
    descriptor["last_navigation_readback"] = navigation
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_coordinate_click_reconciliation_completed",
        next_action="fresh same-task target inspection before any effectful UI operation",
        operation_id=args.operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    remaining = pending_operation_reconciliation_ids(descriptor)
    print(json.dumps({
        "status": "recording_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_id": args.operation_id,
        "resolution": "executed",
        "evidence": "browser_use_coordinate_click_navigation_readback_verified",
        "navigation_readback": navigation,
        "state_marker_length": len(state_marker),
        "state_marker_sha256": hashlib.sha256(state_marker.encode("utf-8")).hexdigest(),
        "state_length": len(raw_state),
        "state_sha256": hashlib.sha256(raw_state.encode("utf-8")).hexdigest(),
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "effectful_resume_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_reconcile_target_not_interactive(args: argparse.Namespace) -> int:
    """Resolve only a helper-proven non-interactive target rejection."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
        allow_stale_runtime_recovery=True,
    )
    require_temporary_task_id(args, descriptor)
    recording_authority(config, descriptor, args.authority, cleanup_only=True)
    if descriptor.get("status") != "stale" or descriptor.get("recovery_state") != "restartable":
        raise Blocker("browser_use_recording_reconciliation_requires_restartable_stale")
    failures = [
        item
        for item in descriptor.get("failed_operations", [])
        if isinstance(item, dict)
        and item.get("exact_blocker") == "browser_use_target_click_failed"
        and item.get("external_action_possible") is True
        and item.get("target_text_length") == args.target_text_length
        and item.get("target_text_sha256") == args.target_text_sha256
    ]
    if len(failures) != 1:
        raise Blocker("browser_use_target_reconciliation_evidence_mismatch")
    pending = pending_operation_reconciliation_ids(descriptor)
    descriptor_reconciled = {
        operation_id
        for item in descriptor.get("reconciliations", [])
        if isinstance(item, dict) and item.get("resolution") in {"none", "executed"}
        for operation_id in item.get("operation_ids", [])
        if isinstance(operation_id, str)
    }
    if args.operation_id not in pending and args.operation_id not in descriptor_reconciled:
        raise Blocker("browser_use_target_reconciliation_operation_not_pending")
    operation_ids = [] if args.operation_id in descriptor_reconciled else [args.operation_id]
    if "failed-operation" in pending and "failed-operation" not in operation_ids:
        operation_ids.append("failed-operation")
    for operation_id in operation_ids:
        if re.fullmatch(r"[a-f0-9]{32}", operation_id):
            append_operation_reconciliation_durable(
                descriptor,
                operation_id=operation_id,
                external_effects="none",
                outcome="target_rejected_noninteractive_before_dispatch",
            )
    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    intents = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "intent"}
    outcomes = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "outcome"}
    for operation_id, intent in intents.items():
        outcome = outcomes.get(operation_id)
        if (
            operation_id in pending
            and operation_id not in operation_ids
            and intent.get("external_effects") == "none"
            and outcome is not None
            and outcome.get("external_effects") == "unknown"
            and outcome.get("outcome") == "orphan_intent_closed_by_recover"
        ):
            append_operation_reconciliation_durable(
                descriptor,
                operation_id=operation_id,
                external_effects="none",
                outcome="read_only_recovery_orphan_reconciled",
            )
            operation_ids.append(operation_id)
    descriptor.setdefault("reconciliations", []).append(
        {
            "operation_ids": operation_ids,
            "resolution": "none",
            "basis": args.evidence_code,
            "target_text_length": args.target_text_length,
            "target_text_sha256": args.target_text_sha256,
            "recorded_at": iso(now_utc()),
        }
    )
    descriptor["reconciliation_state"] = "completed"
    descriptor["reconciliation_exact_blocker"] = "browser_use_target_reconciliation_completed"
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_target_reconciliation_completed",
        next_action="fresh same-task record-start after noninteractive target rejection reconciliation",
        operation_id=args.operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    remaining = pending_operation_reconciliation_ids(descriptor)
    print(json.dumps({
        "status": "recording_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_ids": operation_ids,
        "resolution": "none",
        "evidence": args.evidence_code,
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_finalize(args: argparse.Namespace) -> int:
    config = read_toml()
    versions = validate_installation(config)
    recording_tools = validate_recording_tools(config)
    versions = {**versions, "recording_tools": {kind: {"canonical_path": path} for kind, path in recording_tools.items()}}
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    cleanup_only = bool(getattr(args, "cleanup_only", False))
    descriptor = read_recording_descriptor(config, args.descriptor, run_id, session, allow_helper_hash_mismatch=cleanup_only, allow_pinned_helper_reexec=not cleanup_only, allow_expired_temporary=cleanup_only)
    require_temporary_task_id(args, descriptor)
    require_temporary_delete_approval(
        descriptor,
        delete_approved=delete_approval_signal(args),
        cleanup_only=cleanup_only,
    )
    if descriptor.get("lifecycle") == TEMPORARY_LIFECYCLE and delete_approval_signal(args):
        descriptor["completion_assessment"] = "ai_judged_complete"
        descriptor["retention_decision"] = "delete_approved"
        descriptor["task_completion_signal"] = "delete_approval_received"
        descriptor["delete_approval_at"] = iso(now_utc())
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    if descriptor.get("status") == "stale" and not cleanup_only:
        raise Blocker("browser_use_recording_stale_descriptor_requires_cleanup_only")
    recording_authority(
        config,
        descriptor,
        args.authority,
        cleanup_only=cleanup_only,
        command_class="record-finalize" if not cleanup_only else None,
        renewal_path=getattr(args, "authority_renewal", None) if not cleanup_only else None,
    )
    if getattr(args, "authority_renewal", None) and not cleanup_only:
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    status = read_json_safe(descriptor["status_path"])
    # A close can finish asynchronously.  Once the recorder has truthfully
    # reported finalized, allow a retry to finish probing/cleanup even if the
    # Browser Use session has already disappeared.
    reconcile_cleanup = (
        cleanup_only
        and descriptor.get("status") == "cleanup_pending"
        and bool(descriptor.get("finalize_failure"))
        and (descriptor.get("cleanup_state") or {}).get("status") == "cleaned"
    )
    if status.get("finalized") is not True and not reconcile_cleanup:
        validate_recording_process(config, descriptor)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])
    if descriptor.get("status") == "cleanup_pending" and descriptor.get("finalize_failure"):
        cleanup_state = descriptor.get("cleanup_state") or {}
        if cleanup_only and cleanup_state.get("status") == "cleaned":
            if cleanup_state.get("process_terminated") is not True or cleanup_state.get("listener_absent") is not True:
                raise Blocker("browser_use_recording_cleanup_readback_incomplete")
            assert_debug_listener_absent(int(descriptor["port"]))
            if any(os.path.lexists(path) for path in descriptor.get("lock_paths", [])):
                raise Blocker("browser_use_recording_cleanup_locks_remain")
            if browser_harness_cli_enabled():
                write_harness_recording_status(descriptor["status_path"], recording, active=False, finalized=False)
            receipt_path = os.path.join(
                config["roots"]["receipts"],
                descriptor["run_id"],
                f"{descriptor['session']}-{descriptor['nonce']}.json",
            )
            if not os.path.lexists(receipt_path):
                raise Blocker("browser_use_recording_blocked_receipt_missing")
            print(json.dumps({"status": "blocked", "descriptor": os.path.realpath(args.descriptor), "receipt": receipt_path, "exact_blocker": str(descriptor["finalize_failure"]), "finalized": False, "cleanup_reconciled": True}, sort_keys=True))
            return 1
        raise Blocker("browser_use_recording_finalize_already_blocked", str(descriptor["finalize_failure"]))
    if status.get("finalized") is not True and browser_harness_cli_enabled():
        code, _ = run_cli_keep_alive(config, config["roots"]["browser_use_home"], descriptor["port"], descriptor["session"], ["record-stop", descriptor.get("recording_source_dir", descriptor["recording_dir"])], False, recording=recording)
        if code != 0:
            stop_failure = "browser_use_recording_stop_failed"
            receipt_path, final_failure = _recording_finalize_cleanup_after_stop_failure(
                config,
                versions,
                descriptor,
                os.path.realpath(args.descriptor),
                stop_failure,
            )
            print(json.dumps({"status": "blocked", "descriptor": os.path.realpath(args.descriptor), "receipt": receipt_path, "exact_blocker": final_failure, "recording_stop_blocker": _LAST_RECORDING_CLI_FAILURE or str(code), "finalized": False}, sort_keys=True))
            return 1
        write_harness_recording_status(descriptor["status_path"], recording, active=False, finalized=True)
        code, _ = run_cli_keep_alive(config, config["roots"]["browser_use_home"], descriptor["port"], descriptor["session"], ["close"], False, recording=recording)
    elif status.get("finalized") is not True:
        code, _ = run_cli_keep_alive(config, config["roots"]["browser_use_home"], descriptor["port"], descriptor["session"], ["close"], False, recording=recording)
        if code != 0:
            raise Blocker("browser_use_recording_close_failed", _LAST_RECORDING_CLI_FAILURE or str(code))
        wait_for_recording_stop(descriptor["status_path"])
    if browser_harness_cli_enabled():
        source_dir = pathlib.Path(descriptor.get("recording_source_dir", descriptor["recording_dir"]))
        frames = sorted(p for p in source_dir.glob("*.jpg") if p.stem.isdigit())
        if not frames:
            raise Blocker("browser_use_recording_frames_missing")
        video_path = source_dir / "browser-recording.mp4"
        ffmpeg = config["executables"]["ffmpeg"]["canonical_path"]
        pattern = str(source_dir / "*.jpg")
        render = subprocess.run([ffmpeg, "-v", "error", "-y", "-framerate", str(descriptor["recording_framerate"]), "-pattern_type", "glob", "-i", pattern, "-c:v", "libx264", "-pix_fmt", "yuv420p", "-movflags", "+faststart", str(video_path)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=120)
        if render.returncode != 0:
            raise Blocker("browser_use_recording_video_render_failed")
        video = probe_recording_video(config, str(source_dir))
    else:
        video = probe_recording_video(config, descriptor["recording_dir"])
    cleanup_blocker: str | None = None
    if descriptor["owned_chrome"]:
        cleaned, cleanup_blocker = _cleanup_recording_owned_session(config, descriptor)
        if not cleaned:
            raise Blocker(cleanup_blocker or "browser_use_recording_cleanup_uncertain")
    else:
        validate_recording_process(config, descriptor)
    effect_state = operation_effect_summary(descriptor)
    completion_blocker = "browser_use_external_effects_unknown" if effect_state == "unknown" else None
    ledger_rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    ledger_tail_digest = ledger_rows[-1].get("chain_digest") if ledger_rows else "0" * 64
    manifest = {"schema": RECORDING_SCHEMA, "status": "blocked" if completion_blocker else "completed", "run_id": descriptor["run_id"], "session": descriptor["session"], "recording_dir": descriptor["recording_dir"], "operations": descriptor["operations"], "failed_operations": descriptor.get("failed_operations", []), "target_origins": descriptor["target_origins"], "recording_framerate": descriptor["recording_framerate"], "video": video, "external_effects": effect_state, "business_effect_proof": descriptor.get("business_effect_proof", "not_applicable"), "completion_blocker": completion_blocker, "operation_ledger_path": operation_ledger_path(descriptor), "operation_ledger_tail_digest": ledger_tail_digest}
    if descriptor.get("tab_inventory_path"):
        manifest["tab_inventory_path"] = descriptor["tab_inventory_path"]
        manifest["tab_inventory"] = read_recording_tab_inventory(descriptor["tab_inventory_path"])
    manifest_path = recording_manifest_path(descriptor["recording_dir"])
    write_recording_manifest(manifest_path, manifest)
    descriptor["status"] = "finalized"
    descriptor["external_effects"] = effect_state
    if completion_blocker:
        descriptor["completion_blocker"] = completion_blocker
    descriptor["manifest_path"] = manifest_path
    descriptor["video"] = video
    descriptor["versions_hashes"] = versions
    if descriptor.get("tab_inventory_path"):
        descriptor["tab_inventory"] = manifest["tab_inventory"]
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    ctx = _recording_context(config, descriptor)
    cleanup_status = (
        "cleaned"
        if descriptor["owned_chrome"] and descriptor.get("lifecycle") == "single-use"
        else "scheduled_profile_preserved"
        if descriptor["owned_chrome"] and descriptor.get("lifecycle") == "scheduled"
        else "temporary_profile_removed"
        if descriptor["owned_chrome"] and descriptor.get("lifecycle") == TEMPORARY_LIFECYCLE
        else "source_handoff_preserved"
    )
    cleanup_receipt = {
        "status": cleanup_status,
        "profile_removed": not os.path.lexists(descriptor["profile"]),
        "download_dir_removed": not os.path.lexists(descriptor["download_dir"]),
        "locks_removed": list(descriptor["lock_paths"]) if descriptor["owned_chrome"] else [],
        "locks_retained": [],
    }
    ctx.update({"port": descriptor["port"], "task_id": descriptor.get("task_id"), "creation_binding": descriptor.get("creation_binding"), "authority_scope": descriptor.get("authority_scope"), "authority_sha256": descriptor.get("authority_sha256"), "profile_hash": profile_hash(descriptor["profile"], descriptor["nonce"]) if descriptor["owned_chrome"] else None, "target_origins": descriptor["target_origins"], "account_identity": descriptor["account_identity"], "authority_summary": {"data_exposure": "authorized_recording" if descriptor["mode"] == "authorized" else "public_read_only", "side_effect_scope": "bounded_recording", "approval": "approved" if descriptor["mode"] == "authorized" else "not_required"}, "preflight": True, "listener_verified": True, "process_identity_verified": True, "readback_exit": 0, "recording_manifest": manifest_path, "operation_ledger_path": operation_ledger_path(descriptor), "operation_ledger_tail_digest": ledger_tail_digest, "external_effects": effect_state, "cleanup": cleanup_receipt})
    receipt = finalized_receipt(config, versions, ctx, completion_blocker)
    if completion_blocker:
        print(json.dumps({"status": "blocked", "descriptor": os.path.realpath(args.descriptor), "manifest": manifest_path, "receipt": receipt, "video": video, "external_effects": effect_state, "exact_blocker": completion_blocker, "finalized": False}, sort_keys=True))
        return 1
    print(json.dumps({"status": "completed", "descriptor": os.path.realpath(args.descriptor), "manifest": manifest_path, "receipt": receipt, "video": video, "external_effects": effect_state, "finalized": True}, sort_keys=True))
    return 0


def validate_finalized_lease_artifacts(config: dict[str, Any], lease: dict[str, Any], descriptor_path: str, run_id: str, session: str) -> dict[str, Any]:
    """Revalidate an idempotent finalize call; a marker alone is not proof."""
    descriptor = read_recording_descriptor(config, descriptor_path, run_id, session, allow_finalized=True)
    effect_state = operation_effect_summary(descriptor)
    if effect_state == "unknown" or descriptor.get("external_effects") == "unknown":
        raise Blocker("browser_use_flow_lease_finalized_external_effects_unknown")
    manifest_path = os.path.realpath(str(descriptor.get("manifest_path") or ""))
    if not manifest_path or not os.path.lexists(manifest_path):
        raise Blocker("browser_use_flow_lease_finalized_manifest_missing")
    manifest = read_json_safe(manifest_path)
    if manifest.get("schema") != RECORDING_SCHEMA or manifest.get("status") != "completed" or manifest.get("run_id") != run_id or manifest.get("session") != session or manifest.get("external_effects") == "unknown":
        raise Blocker("browser_use_flow_lease_finalized_manifest_invalid")
    receipt_path = os.path.realpath(str(lease.get("receipt_path") or ""))
    if not receipt_path:
        nonce = safe_id(str(descriptor.get("nonce") or ""), "nonce")
        receipt_path = os.path.join(config["roots"]["receipts"], run_id, f"{session}-{nonce}.json")
    receipt = read_json_safe(receipt_path)
    if receipt.get("schema") != "browser-use-receipt.v1" or receipt.get("run_id") != run_id or receipt.get("session") != session or receipt.get("finalized") is not True or receipt.get("external_effects") == "unknown":
        raise Blocker("browser_use_flow_lease_finalized_receipt_invalid")
    authority_path = os.path.realpath(str(lease.get("authority_path") or ""))
    if authority_path:
        assert_regular_file(authority_path, mode=0o600)
        if descriptor.get("authority_sha256") and sha256_file(authority_path) != descriptor.get("authority_sha256"):
            raise Blocker("browser_use_flow_lease_finalized_authority_changed")
    assert_debug_listener_absent(int(descriptor["port"]))
    if any(os.path.lexists(path) for path in descriptor.get("lock_paths", [])):
        raise Blocker("browser_use_flow_lease_finalized_locks_remain")
    ledger_rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    if ledger_rows and manifest.get("operation_ledger_tail_digest") != ledger_rows[-1].get("chain_digest"):
        raise Blocker("browser_use_flow_lease_finalized_ledger_tail_mismatch")
    return {"descriptor": descriptor, "manifest": manifest, "receipt": receipt, "receipt_path": receipt_path}


def flow_finalize_lease(args: argparse.Namespace) -> int:
    """Finalize one run-owned flow lease at the task/run boundary.

    A flow lease is intentionally separate from individual Browser Use
    commands: command boundaries keep the same Chrome alive, while this
    boundary closes the session exactly once after the whole task is over.
    """
    config = read_toml()
    validate_installation(config)
    lease_path = os.path.realpath(str(args.lease))
    lease = read_json_safe(lease_path)
    lease_schema = str(lease.get("schema") or "")
    if lease_schema not in {"browser-use-flow-lease.v1", "browser-use-flow-lease.v2"} or lease.get("status") not in {"held", "finalized"}:
        raise Blocker("browser_use_flow_lease_binding_invalid")
    if lease_schema == "browser-use-flow-lease.v2":
        contract = lease.get("contract")
        owner = lease.get("owner")
        session_binding = lease.get("session_binding")
        if (
            not isinstance(contract, dict)
            or contract.get("schema") != "browser_use_cli_authorized_scheduled_flow.v1"
            or not isinstance(owner, dict)
            or not isinstance(session_binding, dict)
            or str(owner.get("run_id") or "") != str(contract.get("run_id") or "")
            or str(owner.get("automation_id") or "") != str(contract.get("automation_id") or "")
            or str(session_binding.get("effective") or "") != str(contract.get("effective_session") or "")
            or str(lease.get("run_id") or "") != str(contract.get("run_id") or "")
            or str(lease.get("automation_id") or "") != str(contract.get("automation_id") or "")
            or str(lease.get("session") or "") != str(contract.get("effective_session") or "")
        ):
            raise Blocker("browser_use_flow_lease_contract_binding_invalid")
        run_id_value = str(contract.get("run_id") or "")
        session_value = str(contract.get("effective_session") or "")
        automation_value = str(contract.get("automation_id") or "")
    else:
        if (
            not str(lease.get("run_id") or "").strip()
            or not str(lease.get("session") or "").strip()
            or not str(lease.get("automation_id") or "").strip()
        ):
            raise Blocker("browser_use_flow_lease_binding_invalid")
        run_id_value = str(lease["run_id"])
        session_value = str(lease["session"])
        automation_value = str(lease["automation_id"])
    if not str(lease.get("descriptor_path") or "").strip() or not str(lease.get("profile") or "").strip():
        raise Blocker("browser_use_flow_lease_binding_invalid")
    run_id = safe_id(run_id_value, "flow_lease_run_id")
    requested_session = validate_id(session_value, "flow_lease_session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    if session != requested_session:
        raise Blocker("browser_use_flow_lease_session_alias_rejected")
    descriptor_path = os.path.realpath(str(lease["descriptor_path"]))
    assert_recording_descriptor_path(config, descriptor_path)
    profile = os.path.realpath(str(lease["profile"]))
    lifecycle = str(lease.get("lifecycle") or "")
    automation_id = safe_id(automation_value, "flow_lease_automation_id")
    if lifecycle == "scheduled":
        expected_profile = os.path.join(config["roots"]["scheduled_profiles"], automation_id)
        if profile != expected_profile:
            raise Blocker("browser_use_flow_lease_scheduled_profile_binding_invalid")
    elif lifecycle == TEMPORARY_LIFECYCLE:
        task_id = lease.get("task_id")
        creation_binding = lease.get("creation_binding")
        if not isinstance(task_id, str) or not isinstance(creation_binding, str) or profile != temporary_profile_path(config, creation_binding):
            raise Blocker("browser_use_flow_lease_temporary_profile_binding_invalid")
    elif lifecycle == "single-use":
        if not profile.startswith(os.path.realpath(config["roots"]["single_use_profiles"]) + os.sep):
            raise Blocker("browser_use_flow_lease_single_use_profile_binding_invalid")
    else:
        raise Blocker("browser_use_flow_lease_lifecycle_invalid")
    if lease.get("status") == "finalized":
        validated = validate_finalized_lease_artifacts(config, lease, descriptor_path, run_id, session)
        lease["finalized"] = True
        print(json.dumps({"status": "completed", "lease": lease_path, "receipt": validated["receipt_path"], "finalized": True, "external_effects": validated["receipt"].get("external_effects", "none"), "cleanup_status": lease.get("cleanup_status")}, sort_keys=True))
        return 0
    authority_path = os.path.realpath(str(lease.get("authority_path") or ""))
    if not authority_path:
        raise Blocker("browser_use_flow_lease_authority_missing")
    assert_regular_file(authority_path, mode=0o600)
    record_args = argparse.Namespace(
        run_id=run_id,
        session=requested_session,
        descriptor=descriptor_path,
        authority=authority_path,
        task_id=lease.get("task_id"),
        delete_approved=delete_approval_signal(args),
    )
    record_finalize(record_args)
    descriptor = read_json_safe(descriptor_path)
    nonce = str(descriptor.get("nonce") or "")
    receipt_path = os.path.join(config["roots"]["receipts"], run_id, f"{session}-{nonce}.json")
    receipt = read_json_safe(receipt_path)
    if receipt.get("finalized") is not True:
        raise Blocker("browser_use_flow_lease_finalize_receipt_invalid")
    lease.update({
        "status": "finalized",
        "finalized": True,
        "receipt_path": receipt_path,
        "manifest_path": descriptor.get("manifest_path"),
        "cleanup_status": receipt.get("cleanup", {}).get("status"),
        "updated_at": iso(now_utc()),
    })
    json_atomic_replace(lease_path, lease)
    print(json.dumps({"status": "completed", "lease": lease_path, "receipt": receipt_path, "finalized": True, "cleanup_status": lease.get("cleanup_status")}, sort_keys=True))
    return 0


def scan_downloads(path: str, maximum: int) -> list[dict[str, Any]]:
    records: list[dict[str, Any]] = []
    for entry in pathlib.Path(path).iterdir():
        if entry.is_symlink() or not entry.is_file():
            raise Blocker("browser_use_download_file_type_rejected")
        st = entry.stat()
        if st.st_nlink != 1 or st.st_size > maximum:
            raise Blocker("browser_use_download_size_exceeded")
        records.append({"name": entry.name, "size": st.st_size, "sha256": sha256_file(str(entry)), "classification": mimetypes.guess_type(entry.name)[0] or "application/octet-stream", "destination": path, "auto_open": False, "auto_execute": False})
    return records


def quarantine_profile(config: dict[str, Any], profile: str, ctx: dict[str, Any]) -> str | None:
    if ctx.get("process_terminated") is not True or ctx.get("listener_absent") is not True:
        raise Blocker("browser_use_quarantine_process_cleanup_unverified")
    if not profile or not os.path.lexists(profile):
        return None
    single_use_root = os.path.realpath(config["roots"]["single_use_profiles"])
    if os.path.realpath(profile) != profile or not profile.startswith(single_use_root + os.sep):
        raise Blocker("browser_use_profile_cleanup_scope_mismatch")
    assert_directory(profile)
    assert_debug_listener_absent(int(ctx.get("port") or 0))
    quarantine_root = config["roots"]["quarantine"]
    assert_directory(quarantine_root, create=True)
    destination = os.path.join(quarantine_root, os.path.basename(profile))
    if os.path.lexists(destination):
        raise Blocker("browser_use_quarantine_destination_exists")
    expires = now_utc() + dt.timedelta(seconds=config["limits"]["quarantine_ttl_seconds"])
    marker = {"schema": "browser-use-quarantine.v1", "run_id": ctx["run_id"], "session": ctx["session"], "nonce": ctx["nonce"], "quarantined_at": iso(now_utc()), "expires_at": iso(expires), "related_pid": ctx.get("process", {}).get("root_pid"), "related_start_time": ctx.get("process", {}).get("root_start_time"), "port": ctx.get("port"), "lock_paths": ctx.get("lock_paths", []), "canonical_profile": os.path.realpath(profile), "owner_uid": EUID}
    marker["quarantine_path"] = os.path.join(quarantine_root, os.path.basename(profile))
    json_atomic_no_replace(os.path.join(profile, ".quarantine.json"), marker)
    os.rename(profile, destination)
    if os.path.lexists(profile) or not os.path.isdir(destination):
        raise Blocker("browser_use_quarantine_readback_failed")
    os.chmod(destination, 0o700)
    return destination


def cleanup_exact_profile(profile: str, single_use_root: str, run_id: str, nonce: str) -> None:
    if os.path.realpath(profile) != profile or not profile.startswith(single_use_root + os.sep):
        raise Blocker("browser_use_profile_cleanup_scope_mismatch")
    assert_directory(profile)
    marker = os.path.join(profile, ".browser-use-profile.json")
    assert_regular_file(marker, mode=0o600)
    marker_value = read_json_safe(marker)
    if marker_value.get("run_id") != run_id or marker_value.get("nonce") != nonce:
        raise Blocker("browser_use_profile_marker_binding_mismatch")
    shutil.rmtree(profile)


def cleanup_temporary_profile(config: dict[str, Any], descriptor: dict[str, Any], *, process_verified: bool = False) -> None:
    """Delete one temporary profile only after immutable binding and ownership rechecks."""
    profile = descriptor.get("profile")
    if not isinstance(profile, str) or not os.path.lexists(profile):
        if (descriptor.get("cleanup_state") or {}).get("profile_removed") is True:
            return
        raise Blocker("browser_use_temporary_profile_missing")
    expected = {
        "mode": descriptor.get("mode"),
        "lifecycle": TEMPORARY_LIFECYCLE,
        "automation_id": descriptor.get("automation_id"),
        "task_id": descriptor.get("task_id"),
        "run_id": descriptor.get("run_id"),
        "creation_binding": descriptor.get("creation_binding"),
        "canonical_profile": os.path.realpath(profile),
        "port": int(descriptor.get("port")),
        "authority_sha256": descriptor.get("authority_sha256"),
        "authority_scope": descriptor.get("authority_scope"),
        "account_identity": descriptor.get("account_identity"),
        "origins": sorted(descriptor.get("origins") or descriptor.get("target_origins") or []),
    }
    if descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE or not process_verified:
        raise Blocker("browser_use_temporary_cleanup_recheck_required")
    validate_temporary_marker(config, os.path.realpath(profile), expected, require_unexpired=False)
    marker_path = os.path.join(profile, ".browser-use-profile.json")
    before_profile = lstat(profile)
    before_marker = lstat(marker_path)
    marker_digest = sha256_file(marker_path)
    lock_paths = list(descriptor.get("lock_paths") or [])
    expected_profile_lock = temporary_profile_lock_path(config, profile)
    if expected_profile_lock not in lock_paths:
        raise Blocker("browser_use_temporary_profile_lock_missing")
    assert_owned_locks(lock_paths, descriptor["run_id"], descriptor["nonce"])
    if os.path.realpath(profile) != profile or os.path.islink(profile) or before_profile.st_uid != EUID:
        raise Blocker("browser_use_temporary_profile_recheck_failed")
    if os.path.realpath(marker_path) != marker_path or before_marker.st_uid != EUID:
        raise Blocker("browser_use_temporary_marker_recheck_failed")
    after_profile = lstat(profile)
    after_marker = lstat(marker_path)
    if (before_profile.st_dev, before_profile.st_ino) != (after_profile.st_dev, after_profile.st_ino) or (before_marker.st_dev, before_marker.st_ino) != (after_marker.st_dev, after_marker.st_ino) or sha256_file(marker_path) != marker_digest:
        raise Blocker("browser_use_temporary_profile_changed_during_recheck")
    shutil.rmtree(profile)
    if os.path.lexists(profile):
        raise Blocker("browser_use_temporary_profile_cleanup_readback_failed")


def cleanup_exact_download_dir(path: str, downloads_root: str) -> None:
    canonical_root = os.path.realpath(downloads_root)
    if not os.path.isabs(path) or os.path.realpath(path) != path or not path.startswith(canonical_root + os.sep):
        raise Blocker("browser_use_download_cleanup_scope_mismatch")
    assert_directory(path)
    shutil.rmtree(path)


def cleanup_empty_download_dir(path: str, downloads_root: str) -> bool:
    """Remove only an empty run-scoped download directory.

    Non-empty download output may be a workflow artifact, so it is retained
    for the caller and recorded in the receipt rather than deleted implicitly.
    """
    canonical_root = os.path.realpath(downloads_root)
    if not os.path.isabs(path) or os.path.realpath(path) != path or not path.startswith(canonical_root + os.sep):
        raise Blocker("browser_use_download_cleanup_scope_mismatch")
    assert_directory(path)
    if any(pathlib.Path(path).iterdir()):
        return False
    os.rmdir(path)
    if os.path.lexists(path):
        raise Blocker("browser_use_download_cleanup_readback_failed")
    return True


def _handoff_base_path(path: str) -> str:
    path = os.path.realpath(path)
    for suffix in (HANDOFF_CLAIM_SUFFIX, HANDOFF_CONSUMED_SUFFIX):
        if path.endswith(suffix):
            return path[: -len(suffix)]
    return path


def _cleanup_complete_path(base_path: str) -> str:
    return base_path + HANDOFF_COMPLETE_SUFFIX


def _cleanup_pending_path(base_path: str) -> str:
    return base_path + ".cleanup-pending.json"


def _read_cleanup_complete(base_path: str, run_id: str, session: str) -> bool:
    path = _cleanup_complete_path(base_path)
    if not os.path.lexists(path):
        return False
    try:
        value = read_json_safe(path)
    except (Blocker, json.JSONDecodeError) as exc:
        raise Blocker("browser_use_cleanup_completion_readback_failed") from exc
    if value.get("run_id") != run_id or value.get("session") != session:
        raise Blocker("browser_use_cleanup_completion_binding_mismatch")
    return value.get("completed") is True


def _write_cleanup_complete(base_path: str, descriptor: dict[str, Any]) -> None:
    path = _cleanup_complete_path(base_path)
    value = {
        "schema": "browser-use-cleanup-complete.v1",
        "completed": True,
        "run_id": descriptor["run_id"],
        "session": descriptor["session"],
        "nonce": descriptor["nonce"],
        "lifecycle": descriptor.get("lifecycle"),
        "task_id": descriptor.get("task_id"),
    }
    try:
        json_atomic_no_replace(path, value)
    except Blocker as exc:
        # Another retry may have finalized the same lease between the
        # pre-check and this no-replace write.  Accept only a matching,
        # positively read-back completion marker.
        if exc.code != "browser_use_receipt_already_exists" or not _read_cleanup_complete(base_path, descriptor["run_id"], descriptor["session"]):
            raise


def _record_cleanup_state(path: str, descriptor: dict[str, Any], **updates: Any) -> None:
    state = dict(descriptor.get("cleanup_state") or {})
    state.update(updates)
    descriptor["cleanup_state"] = state
    update_handoff(path, descriptor)


def _cleanup_failure_code(error: BaseException, default: str = "browser_use_cleanup_uncertain") -> str:
    return error.code if isinstance(error, Blocker) else default


def _record_context_cleanup_pending(ctx: dict[str, Any], blocker: str) -> None:
    cleanup = dict(ctx.get("cleanup") or {})
    cleanup.update({"status": "cleanup_pending", "state": "uncertain", "uncertain": True, "exact_blocker": blocker})
    # Keep the complete lease evidence.  A release attempt may have removed a
    # prior lock before a later lock became uncertain; filtering by existence
    # would erase that partial-release history from the durable receipt.
    cleanup["locks_retained"] = list(ctx.get("lock_paths") or [])
    ctx["cleanup"] = cleanup


def _release_lock_set(paths: list[str], run_id: str, nonce: str) -> tuple[bool, str | None, list[str]]:
    """Release an owned lock set, stopping at the first uncertain result."""
    # Finalization is retryable.  A previous attempt may already have removed
    # one or both exact locks; missing is safe, while an existing lock must
    # still be positively bound to this run before it is touched.
    for lock_path in paths:
        if not os.path.lexists(lock_path):
            continue
        try:
            value = read_json_safe(lock_path)
            if value.get("run_id") != run_id or value.get("nonce") != nonce:
                raise Blocker("browser_use_lock_owner_recheck_failed")
        except Exception as exc:
            return False, _cleanup_failure_code(exc), []

    released: list[str] = []
    for lock_path in paths:
        try:
            release_lock(lock_path, run_id, nonce)
            if os.path.lexists(lock_path):
                raise Blocker("browser_use_lock_cleanup_readback_failed")
        except Exception as exc:
            # Once one member is uncertain, do not touch any later member.
            return False, _cleanup_failure_code(exc), released
        released.append(lock_path)
    return True, None, released


def _release_locks_after_verified_cleanup(ctx: dict[str, Any], run_id: str, nonce: str) -> tuple[bool, str | None]:
    cleanup = dict(ctx.get("cleanup") or {})
    if cleanup.get("state") == "uncertain" or cleanup.get("uncertain") is True:
        return False, str(cleanup.get("exact_blocker") or "browser_use_cleanup_uncertain")
    paths = list(ctx.get("lock_paths") or [])
    released_ok, code, released = _release_lock_set(paths, run_id, nonce)
    if not released_ok:
        _record_context_cleanup_pending(ctx, code)
        return False, code
    room_id = ctx.get("room_id")
    if room_id:
        try:
            lifecycle = str(ctx.get("lifecycle") or "")
            terminal_cleanup = bool(ctx.get("room_terminal_cleanup"))
            if lifecycle == "single-use" or terminal_cleanup:
                room_registry_release(ctx["config"], room_id, run_id=run_id, activity="release")
            else:
                room_registry_update(ctx["config"], room_id, run_id=run_id, state="held", activity="held")
        except (Blocker, OSError, ValueError, KeyError) as exc:
            code = _cleanup_failure_code(exc, "browser_use_room_registry_release_failed")
            _record_context_cleanup_pending(ctx, code)
            return False, code
    cleanup.update({"status": "cleaned", "locks_removed": released})
    ctx["cleanup"] = cleanup
    return True, None


def _mark_cleanup_pending(base_path: str, claim_path: str, descriptor: dict[str, Any], blocker: str) -> None:
    state = dict(descriptor.get("cleanup_state") or {})
    state.update({"status": "cleanup_pending", "state": "uncertain", "uncertain": True, "exact_blocker": blocker, "updated_at": iso(now_utc()), "locks_retained": list(descriptor.get("lock_paths") or [])})
    descriptor["status"] = "cleanup_pending"
    descriptor["cleanup_state"] = state
    descriptor_write_failed = False
    try:
        update_handoff(claim_path, descriptor)
    except Exception:
        descriptor_write_failed = True
    sidecar_write_failed = False
    try:
        json_atomic_replace(
            _cleanup_pending_path(base_path),
            {"schema": "browser-use-cleanup-pending.v1", "status": "cleanup_pending", "state": "uncertain", "uncertain": True, "run_id": descriptor["run_id"], "session": descriptor["session"], "nonce": descriptor["nonce"], "lock_paths": list(descriptor.get("lock_paths") or []), "exact_blocker": blocker, "updated_at": iso(now_utc())},
        )
    except Exception:
        sidecar_write_failed = True
    if descriptor_write_failed or sidecar_write_failed:
        # Keep the descriptor and locks in place and expose only a stable,
        # secret-safe blocker; never replace it with the persistence exception.
        raise Blocker("browser_use_cleanup_pending_persistence_failed") from None


def _select_cleanup_candidate(base_path: str) -> str | None:
    for candidate in (base_path + HANDOFF_CLAIM_SUFFIX, base_path + HANDOFF_CONSUMED_SUFFIX, base_path):
        if os.path.lexists(candidate):
            return candidate
    return None


def _claim_handoff_for_cleanup(config: dict[str, Any], base_path: str, run_id: str, session: str) -> tuple[str, dict[str, Any]]:
    claim_path = base_path + HANDOFF_CLAIM_SUFFIX
    consumed_path = base_path + HANDOFF_CONSUMED_SUFFIX
    if os.path.lexists(claim_path):
        selected = claim_path
    elif os.path.lexists(consumed_path):
        selected = consumed_path
    else:
        try:
            os.link(base_path, claim_path)
        except FileExistsError as exc:
            if os.path.lexists(claim_path):
                selected = claim_path
            else:
                raise Blocker("browser_use_handoff_cleanup_claim_exists") from exc
        except FileNotFoundError as exc:
            if os.path.lexists(claim_path):
                selected = claim_path
            elif os.path.lexists(consumed_path):
                selected = consumed_path
            else:
                raise Blocker("browser_use_handoff_missing") from exc
        else:
            selected = claim_path

    # The selected descriptor is the only descriptor read after claiming.
    descriptor = read_handoff(config, selected, run_id, session, require_unexpired=False)
    if descriptor["status"] not in {"active", "continued", "claimed", "cleanup_pending"}:
        raise Blocker("browser_use_handoff_not_active")
    descriptor["status"] = "claimed"
    descriptor["lease_path"] = os.path.realpath(selected)
    _record_cleanup_state(selected, descriptor, claimed=True, claimed_at=iso(now_utc()))
    if os.path.lexists(base_path) and base_path != selected:
        try:
            os.unlink(base_path)
        except OSError as exc:
            raise Blocker("browser_use_handoff_claim_source_cleanup_pending") from exc
    return selected, descriptor


def _remove_handoff_descriptors(base_path: str, claim_path: str) -> None:
    for path in {base_path, base_path + HANDOFF_CONSUMED_SUFFIX, claim_path}:
        if os.path.lexists(path):
            try:
                os.unlink(path)
            except OSError as exc:
                raise Blocker("browser_use_handoff_cleanup_readback_failed") from exc


def cleanup_abandoned_handoff(config: dict[str, Any], descriptor_path: str, run_id: str, session: str, *, require_expired: bool = True) -> dict[str, Any]:
    base_path = _handoff_base_path(descriptor_path)
    if _read_cleanup_complete(base_path, run_id, session):
        return {"status": "handoff_already_cleaned", "cleaned": False, "finalized": True}
    candidate = _select_cleanup_candidate(base_path)
    if candidate is None:
        raise Blocker("browser_use_handoff_missing")
    candidate_descriptor = read_handoff(config, candidate, run_id, session, require_unexpired=False)
    existing_claim = candidate.endswith(HANDOFF_CLAIM_SUFFIX) or candidate_descriptor.get("status") in {"claimed", "cleanup_pending"}
    if require_expired and not existing_claim and handoff_expiry(candidate_descriptor) > now_utc():
        if candidate.endswith(HANDOFF_CONSUMED_SUFFIX):
            return {"status": "handoff_consumed", "cleaned": False, "finalized": True}
        raise Blocker("browser_use_handoff_not_expired")
    if not existing_claim:
        # Validate the owned filesystem lease before creating a cleanup claim.
        validate_handoff_resources(config, candidate_descriptor)

    claim_path = candidate
    descriptor = candidate_descriptor
    try:
        claim_path, descriptor = _claim_handoff_for_cleanup(config, base_path, run_id, session)
        state = dict(descriptor.get("cleanup_state") or {})
        if not state.get("process_terminated"):
            process_present = validate_handoff_process_identity(config, descriptor, allow_missing=True)
            if process_present:
                daemon_code, _ = run_cli_keep_alive(config, config["roots"]["browser_use_home"], descriptor["port"], session, ["close"], False)
                if daemon_code != 0:
                    raise Blocker("browser_use_handoff_daemon_close_failed")
            ok, cleanup_error = terminate_chrome(None, descriptor["process"], config["executables"]["chrome"]["canonical_path"], descriptor["port"], descriptor["profile"])
            if not ok or cleanup_error:
                raise Blocker(cleanup_error or "browser_use_handoff_chrome_cleanup_failed")
            assert_debug_listener_absent(descriptor["port"])
            _record_cleanup_state(claim_path, descriptor, process_terminated=True, listener_absent=True)
            state = dict(descriptor.get("cleanup_state") or {})
        if not state.get("listener_absent"):
            raise Blocker("browser_use_listener_recheck_failed")

        lifecycle = str(descriptor.get("lifecycle", "single-use"))
        if lifecycle == "single-use":
            if not state.get("profile_removed"):
                cleanup_exact_profile(descriptor["profile"], config["roots"]["single_use_profiles"], run_id, descriptor["nonce"])
                if os.path.lexists(descriptor["profile"]):
                    raise Blocker("browser_use_profile_cleanup_readback_failed")
                _record_cleanup_state(claim_path, descriptor, profile_removed=True)
                state = dict(descriptor.get("cleanup_state") or {})
            elif os.path.lexists(descriptor["profile"]):
                raise Blocker("browser_use_profile_cleanup_readback_failed")
        elif lifecycle == "scheduled":
            if not os.path.lexists(descriptor["profile"]):
                raise Blocker("browser_use_scheduled_profile_missing_after_cleanup")
            if not state.get("profile_preserved"):
                _record_cleanup_state(claim_path, descriptor, profile_preserved=True)
                state = dict(descriptor.get("cleanup_state") or {})
        elif lifecycle == TEMPORARY_LIFECYCLE:
            if not state.get("profile_removed"):
                cleanup_temporary_profile(config, descriptor, process_verified=True)
                _record_cleanup_state(claim_path, descriptor, profile_removed=True, temporary_profile_removed=True)
                state = dict(descriptor.get("cleanup_state") or {})
            elif os.path.lexists(descriptor["profile"]):
                raise Blocker("browser_use_temporary_profile_cleanup_readback_failed")
        else:
            raise Blocker("browser_use_handoff_lifecycle_invalid")

        if not state.get("download_dir_removed"):
            cleanup_exact_download_dir(descriptor["download_dir"], config["roots"]["downloads"])
            if os.path.lexists(descriptor["download_dir"]):
                raise Blocker("browser_use_download_cleanup_readback_failed")
            _record_cleanup_state(claim_path, descriptor, download_dir_removed=True)
            state = dict(descriptor.get("cleanup_state") or {})
        elif os.path.lexists(descriptor["download_dir"]):
            raise Blocker("browser_use_download_cleanup_readback_failed")

        if not state.get("locks_release_started"):
            assert_owned_locks(descriptor["lock_paths"], run_id, descriptor["nonce"])
            _record_cleanup_state(claim_path, descriptor, locks_release_started=True)
        released_ok, release_error, released = _release_lock_set(descriptor["lock_paths"], run_id, descriptor["nonce"])
        if not released_ok:
            raise Blocker(release_error or "browser_use_cleanup_uncertain")
        _record_cleanup_state(claim_path, descriptor, locks_released=True, locks_removed=released)
        room_id = descriptor.get("room_id")
        if room_id:
            if lifecycle == "single-use" or lifecycle == TEMPORARY_LIFECYCLE:
                room_registry_release(config, room_id, run_id=run_id, activity="release")
            else:
                room_registry_update(config, room_id, run_id=run_id, state="held", activity="held")
        _write_cleanup_complete(base_path, descriptor)
        _remove_handoff_descriptors(base_path, claim_path)
    except Exception as exc:
        code = exc.code if isinstance(exc, Blocker) else "browser_use_cleanup_uncertain"
        _mark_cleanup_pending(base_path, claim_path, descriptor, code)
        raise
    return {"status": "abandoned_handoff_cleaned", "cleaned": True, "finalized": True}


def handoff_watchdog(args: argparse.Namespace) -> int:
    try:
        config = read_toml()
        run_id = safe_id(args.run_id, "run_id")
        requested_session = validate_id(args.session, "session")
        session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
        descriptor_path = os.path.realpath(args.descriptor)
        descriptor = read_handoff(config, descriptor_path, run_id, session, require_unexpired=False)
        expires = handoff_expiry(descriptor)
        remaining = (expires - now_utc()).total_seconds()
        if remaining > 0:
            time.sleep(remaining)
        result = cleanup_abandoned_handoff(config, descriptor_path, run_id, session)
        print(json.dumps(result, sort_keys=True))
        return 0
    except Blocker as exc:
        print(json.dumps({"status": "blocked", "exact_blocker": exc.code, "finalized": False}, sort_keys=True))
        return 1
    except Exception as exc:
        print(json.dumps({"status": "blocked", "exact_blocker": _cleanup_failure_code(exc), "finalized": False}, sort_keys=True))
        return 1


def finalized_receipt(config: dict[str, Any], versions: dict[str, Any], ctx: dict[str, Any], failure: str | None) -> str:
    receipt_root = config["roots"]["receipts"]
    run_dir = os.path.join(receipt_root, ctx["run_id"])
    assert_directory(run_dir, create=True)
    path = os.path.join(run_dir, f"{ctx['session']}-{ctx['nonce']}.json")
    end_time = now_utc()
    receipt = {"schema": "browser-use-receipt.v1", "authority_mode": ctx["mode"], "lifecycle": ctx["lifecycle"], "run_id": ctx["run_id"], "session": ctx["session"], "requested_session": ctx.get("requested_session", ctx["session"]), "automation_id": ctx["automation_id"], "task_id": ctx.get("task_id"), "creation_binding": ctx.get("creation_binding"), "authority_sha256": ctx.get("authority_sha256"), "authority_scope": ctx.get("authority_scope"), "paths": {"profile": ctx.get("profile"), "download_dir": ctx.get("download_dir"), "browser_use_home": config["roots"]["browser_use_home"]}, "versions_hashes": versions, "pid": ctx.get("process", {}).get("root_pid"), "start_time": ctx.get("started_at"), "end_time": iso(end_time), "port": ctx.get("port"), "profile_hash": ctx.get("profile_hash"), "target_origins": sorted(ctx.get("target_origins", [])), "account_identity": ctx.get("account_identity", "public"), "authority_summary": ctx.get("authority_summary", {"data_exposure": "public_read_only", "side_effect_scope": "none", "approval": "not_required"}), "external_effects": ctx.get("external_effects", "none"), "operation_ledger_path": ctx.get("operation_ledger_path"), "operation_ledger_tail_digest": ctx.get("operation_ledger_tail_digest"), "guard_readback": {"preflight": ctx.get("preflight", False), "listener_verified": ctx.get("listener_verified", False), "process_identity_verified": ctx.get("process_identity_verified", False), "post_command_state_readback": ctx.get("readback_exit") is not None, "readback_exit": ctx.get("readback_exit"), "readback_required": ctx.get("readback_required", True)}, "uploads": ctx.get("uploads", []), "downloads": ctx.get("downloads", []), "exit": {"code": 1 if failure else 0, "exact_blocker": failure}, "cleanup": ctx.get("cleanup", {}), "quarantine": ctx.get("quarantine"), "finalized": failure is None}
    try:
        json_atomic_no_replace(path, receipt)
    except Blocker as exc:
        if exc.code != "browser_use_receipt_already_exists":
            raise
        existing = read_json_safe(path)
        if existing.get("schema") != "browser-use-receipt.v1" or existing.get("run_id") != ctx["run_id"] or existing.get("session") != ctx["session"] or existing.get("finalized") is not True:
            raise Blocker("browser_use_receipt_binding_mismatch")
    return path


def _login_handoff_descriptor_for_pending(descriptor_path: str, ctx: dict[str, Any], run_id: str, session: str, nonce: str) -> dict[str, Any]:
    if os.path.lexists(descriptor_path):
        try:
            descriptor = read_json_safe(descriptor_path)
            if isinstance(descriptor, dict):
                return descriptor
        except Exception:
            pass
    return {"run_id": run_id, "session": session, "nonce": nonce, "lock_paths": list(ctx.get("lock_paths") or [])}


def _record_login_handoff_cleanup_pending(ctx: dict[str, Any], descriptor_path: str | None, run_id: str, session: str, nonce: str, blocker: str) -> None:
    _record_context_cleanup_pending(ctx, blocker)
    if not descriptor_path:
        return
    base_path = _handoff_base_path(descriptor_path)
    descriptor = _login_handoff_descriptor_for_pending(descriptor_path, ctx, run_id, session, nonce)
    _mark_cleanup_pending(base_path, descriptor_path, descriptor, blocker)


def _cleanup_login_handoff_failure(config: dict[str, Any], ctx: dict[str, Any], descriptor_path: str | None, run_id: str, session: str, nonce: str, profile: str, download_dir: str, process_cleanup_ok: bool, cleanup_error: str | None) -> str:
    failure = cleanup_error or "browser_use_cleanup_uncertain"
    if not process_cleanup_ok:
        # Do not call quarantine_profile until process termination and
        # listener absence are verified.  Its guard intentionally rejects an
        # uncertain process state; surfacing that guard error here would hide
        # the original cleanup failure and leave the run harder to resume.
        ctx["quarantine"] = "quarantine_pending"
        _record_login_handoff_cleanup_pending(ctx, descriptor_path, run_id, session, nonce, failure)
        return failure

    try:
        lifecycle = str(ctx.get("lifecycle", "single-use"))
        if lifecycle == "single-use":
            if os.path.lexists(profile):
                cleanup_exact_profile(profile, config["roots"]["single_use_profiles"], run_id, nonce)
                if os.path.lexists(profile):
                    raise Blocker("browser_use_profile_cleanup_readback_failed")
        elif lifecycle == TEMPORARY_LIFECYCLE:
            if not os.path.lexists(profile):
                raise Blocker("browser_use_temporary_profile_missing_after_cleanup")
            ctx.setdefault("cleanup", {})["temporary_profile_preserved"] = True
        elif lifecycle == "scheduled" and not os.path.lexists(profile):
            raise Blocker("browser_use_scheduled_profile_missing_after_cleanup")
        elif lifecycle not in {"single-use", "scheduled", TEMPORARY_LIFECYCLE}:
            raise Blocker("browser_use_lifecycle_invalid")
        if os.path.lexists(download_dir):
            cleanup_exact_download_dir(download_dir, config["roots"]["downloads"])
            if os.path.lexists(download_dir):
                raise Blocker("browser_use_download_cleanup_readback_failed")
    except Exception as exc:
        failure = _cleanup_failure_code(exc)
        _record_login_handoff_cleanup_pending(ctx, descriptor_path, run_id, session, nonce, failure)
        return failure

    released, release_error = _release_locks_after_verified_cleanup(ctx, run_id, nonce)
    if not released:
        failure = release_error or "browser_use_cleanup_uncertain"
        _record_login_handoff_cleanup_pending(ctx, descriptor_path, run_id, session, nonce, failure)
        return failure
    if descriptor_path and os.path.lexists(descriptor_path):
        try:
            os.unlink(descriptor_path)
            if os.path.lexists(descriptor_path):
                raise Blocker("browser_use_handoff_cleanup_readback_failed")
        except Exception as exc:
            failure = _cleanup_failure_code(exc)
            _record_login_handoff_cleanup_pending(ctx, descriptor_path, run_id, session, nonce, failure)
    return failure


def login_handoff(args: argparse.Namespace) -> int:
    config = read_toml()
    lifecycle = resolve_default_lifecycle("authorized", getattr(args, "lifecycle", None))
    if lifecycle not in {"single-use", "scheduled", TEMPORARY_LIFECYCLE}:
        raise Blocker("browser_use_handoff_lifecycle_invalid")
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    args.lifecycle = lifecycle
    ensure_temporary_task_id(args, requested_session)
    automation_id = safe_id(args.automation_id, "automation_id")
    nonce = uuid.uuid4().hex
    validate_installation(config)
    configure_logging(config["roots"]["logs"])
    if not args.authority:
        raise Blocker("browser_use_authority_required")
    if lifecycle == TEMPORARY_LIFECYCLE:
        if not getattr(args, "task_id", None):
            raise Blocker("browser_use_temporary_task_id_required")
        safe_id(args.task_id, "task_id")
    authority = parse_authority(args.authority, run_id, session, aliases=session_aliases(config, requested_session, session))
    authority_digest = sha256_file(args.authority)
    authority_scope = temporary_authority_scope(authority)
    if lifecycle == TEMPORARY_LIFECYCLE:
        nonce = temporary_binding(mode="authorized", lifecycle=lifecycle, automation_id=automation_id, task_id=args.task_id, run_id=run_id, authority_digest=authority_digest, authority_scope=authority_scope, account_identity=authority["account_identity"], origins=list(authority["allowed_origins"]))
        profile = temporary_profile_path(config, nonce)
        download_dir = os.path.join(config["roots"]["downloads"], f"temporary-{nonce[:32]}")
    else:
        profile = os.path.join(config["roots"]["scheduled_profiles"], automation_id) if lifecycle == "scheduled" else None
        download_dir = os.path.join(config["roots"]["downloads"], f"{run_id}-{nonce}")
    allowed_origins = list(authority["allowed_origins"])
    origin = preflight_url(args.url, allowed_origins, config["policy"]["unsafe_path_fragments"])
    command = ["open", args.url]
    _, origins, uploads = validate_command(command, "authorized", config, allowed_origins, download_dir)
    if origins != [origin] or uploads:
        raise Blocker("browser_use_handoff_url_binding_failed")
    ctx: dict[str, Any] = {"mode": "authorized", "lifecycle": lifecycle, "run_id": run_id, "session": session, "requested_session": requested_session, "automation_id": automation_id, "nonce": nonce, "task_id": getattr(args, "task_id", None), "creation_binding": nonce if lifecycle == TEMPORARY_LIFECYCLE else None, "authority_scope": authority_scope if lifecycle == TEMPORARY_LIFECYCLE else None, "started_at": iso(now_utc()), "lock_paths": [], "cleanup": {}, "port": None, "profile": profile, "download_dir": download_dir, "config": config, "room_id": None}
    chrome_proc: subprocess.Popen[bytes] | None = None
    process_identity: dict[str, Any] | None = None
    process_cleanup_ok = True
    diagnostic_detail: str | None = None
    try:
        if lifecycle == "scheduled":
            port_start, port_end = config["ports"]["scheduled_start"], config["ports"]["scheduled_end"]
        elif lifecycle == "single-use":
            port_start, port_end = config["ports"]["single_use_start"], config["ports"]["single_use_end"]
        else:
            port_start, port_end = config["ports"]["temporary_start"], config["ports"]["temporary_end"]
        if args.port is not None and not port_start <= args.port <= port_end:
            raise Blocker("browser_use_handoff_port_out_of_range")
        port = args.port
        room = room_registry_claim(
            config,
            lifecycle=lifecycle,
            run_id=run_id,
            profile=profile if lifecycle != "single-use" else None,
            port=port,
            task_id=getattr(args, "task_id", None),
            automation_id=automation_id,
            activity="handoff-start",
        )
        ctx["room_id"] = room["room_id"]
        profile, port = room["profile"], room["port"]
        ctx["profile"], ctx["port"] = profile, port
        ctx["port"] = port
        if lifecycle == TEMPORARY_LIFECYCLE:
            temp_info = prepare_temporary_profile(config, mode="authorized", automation_id=automation_id, task_id=args.task_id, run_id=run_id, authority_digest=authority_digest, authority_scope=authority_scope, account_identity=authority["account_identity"], origins=list(authority["allowed_origins"]), download_dir=download_dir, requested_port=port)
            ctx["lock_paths"].append(temp_info["profile_lock"])
        else:
            prepare_profile(profile, lifecycle == "scheduled", automation_id, download_dir, run_id, nonce)
        if os.path.exists(download_dir):
            raise Blocker("browser_use_download_directory_collision")
        os.mkdir(download_dir, 0o700)
        assert_directory(download_dir)
        profile_lock = temporary_profile_lock_path(config, profile) if lifecycle == TEMPORARY_LIFECYCLE else os.path.join(config["roots"]["locks"], f"profile-{hashlib.sha256(os.path.realpath(profile).encode()).hexdigest()[:24]}.lock")
        port_lock = os.path.join(config["roots"]["locks"], f"port-{port}.lock")
        payload = {"schema": "browser-use-lock.v1", "run_id": run_id, "nonce": nonce, "helper_pid": os.getpid(), "helper_start_time": psutil.Process(os.getpid()).create_time(), "automation_id": automation_id, "port": port, "canonical_profile": os.path.realpath(profile)}
        if lifecycle != TEMPORARY_LIFECYCLE:
            lock_file(profile_lock, payload)
            ctx["lock_paths"].append(profile_lock)
        lock_file(port_lock, payload)
        ctx["lock_paths"].append(port_lock)
        chrome_proc, process_identity = launch_chrome(config, profile, port, download_dir, config["roots"]["browser_use_home"])
        ctx["process"] = process_identity
        ctx["listener_verified"] = True
        ctx["process_identity_verified"] = True
        code, readback_exit = run_cli_keep_alive(config, config["roots"]["browser_use_home"], port, session, command, True, diagnostic=True)
        if code != 0:
            detail = f"{code}:{_LAST_CLI_FAILURE}" if _LAST_CLI_FAILURE else str(code)
            diagnostic_detail = detail
            raise Blocker("browser_use_handoff_open_failed", detail)
        if readback_exit != 0:
            raise Blocker("browser_use_handoff_readback_failed", str(readback_exit))
        assert_handoff_keep_alive(config, process_identity, port, profile)
        marker = os.path.join(profile, ".browser-use-profile.json")
        descriptor_path = os.path.join(handoff_root(config), run_id, f"{session}-{nonce}.json")
        descriptor = {"schema": HANDOFF_SCHEMA, "status": "active", "mode": "authorized", "lifecycle": lifecycle, "completion_policy": TEMPORARY_COMPLETION_POLICY if lifecycle == TEMPORARY_LIFECYCLE else None, "completion_assessment": "not_assessed" if lifecycle == TEMPORARY_LIFECYCLE else None, "retention_decision": "retain_until_ai_assessment" if lifecycle == TEMPORARY_LIFECYCLE else None, "task_completion_signal": "not_received" if lifecycle == TEMPORARY_LIFECYCLE else None, "run_id": run_id, "requested_session": requested_session, "session": session, "automation_id": automation_id, "task_id": getattr(args, "task_id", None), "creation_binding": nonce if lifecycle == TEMPORARY_LIFECYCLE else None, "authority_scope": authority_scope if lifecycle == TEMPORARY_LIFECYCLE else None, "nonce": nonce, "authority_sha256": authority_digest, "account_identity": authority["account_identity"], "origin": origin, "origins": sorted({normalize_origin(item) for item in allowed_origins}), "expires_at": authority["expires_at"], "profile": os.path.realpath(profile), "profile_hash": profile_hash(profile, nonce), "profile_marker_sha256": sha256_file(marker), "port": port, "daemon_session": session, "process": process_identity, "lock_paths": list(ctx["lock_paths"]), "room_id": ctx.get("room_id"), "lease_path": os.path.realpath(descriptor_path), "download_dir": os.path.realpath(download_dir), "human_completion_signal": "not_received", "readback_exit": readback_exit}
        json_atomic_no_replace(descriptor_path, descriptor)
        ctx["descriptor_path"] = descriptor_path
        launch_handoff_watchdog(config, descriptor_path, run_id, session)
        print(json.dumps({"status": "handoff_ready", "descriptor": descriptor_path, "run_id": run_id, "requested_session": requested_session, "session": session, "session_socket_path_bytes": session_socket_path_bytes(config["roots"]["browser_use_home"], session), "nonce": nonce, "origin": origin, "human_completion_required": True, "human_completion_is_not_auth": True, "abandonment_watchdog": "bounded_to_expiry", "finalized": False}, sort_keys=True))
        return 0
    except (Blocker, OSError, subprocess.SubprocessError, ValueError, json.JSONDecodeError) as exc:
        failure = exc.code if isinstance(exc, Blocker) else "browser_use_runtime_error"
        daemon_cleanup_error: str | None = None
        if isinstance(ctx.get("port"), int):
            daemon_closed, daemon_cleanup_error = close_owned_daemon_if_active(
                config,
                config["roots"]["browser_use_home"],
                int(ctx["port"]),
                session,
            )
            if not daemon_closed:
                process_cleanup_ok = False
                failure = daemon_cleanup_error or "browser_use_daemon_cleanup_unverified"
        if chrome_proc is not None:
            daemon_cleanup_ok = process_cleanup_ok
            if process_identity is None:
                chrome_cleanup_ok, cleanup_error = False, "browser_use_process_identity_unavailable"
            else:
                try:
                    chrome_cleanup_ok, cleanup_error = terminate_chrome(chrome_proc, process_identity, config["executables"]["chrome"]["canonical_path"], int(ctx["port"]), profile)
                except Exception as cleanup_exc:
                    chrome_cleanup_ok, cleanup_error = False, _cleanup_failure_code(cleanup_exc)
            process_cleanup_ok = daemon_cleanup_ok and chrome_cleanup_ok
            if cleanup_error:
                process_cleanup_ok = False
            if process_cleanup_ok:
                ctx["process_terminated"] = True
                ctx["listener_absent"] = True
            if cleanup_error:
                failure = cleanup_error
        if process_cleanup_ok:
            ctx["process_terminated"] = True
            ctx["listener_absent"] = True
        ctx["process"] = process_identity or {}
        try:
            cleanup_result = _cleanup_login_handoff_failure(config, ctx, ctx.get("descriptor_path"), run_id, session, nonce, profile, download_dir, process_cleanup_ok, failure)
        except Blocker as cleanup_exc:
            failure = cleanup_exc.code
            cleanup_result = failure
        if cleanup_result:
            failure = cleanup_result
        print(json.dumps({"status": "blocked", "exact_blocker": failure, "diagnostic_detail": diagnostic_detail, "cleanup": ctx.get("cleanup", {}), "quarantine": ctx.get("quarantine"), "finalized": False}, sort_keys=True))
        return 1


def continue_handoff(args: argparse.Namespace) -> int:
    config = read_toml()
    # Runtime admission is provided by the canonical executable/root/hash/version
    # checks here, followed by descriptor-bound process, profile, lock, listener,
    # and post-command readback below.  Do not require a separate attestation
    # producer that is not part of this Browser Use lane.
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    if not args.human_complete:
        raise Blocker("browser_use_handoff_human_completion_signal_required")
    if not args.authority:
        raise Blocker("browser_use_authority_required")
    preview = read_handoff(config, args.descriptor, run_id, session, require_unexpired=True)
    require_temporary_task_id(args, preview)
    consumed_path = consume_handoff(config, args.descriptor, run_id, session)
    descriptor = read_handoff(config, consumed_path, run_id, session, require_unexpired=True)
    require_temporary_task_id(args, descriptor)
    authority = authority_for_handoff(args.authority, run_id, session, descriptor, config)
    validate_handoff_identity(config, descriptor)
    command = list(args.command)
    if command and command[0] == "--":
        command = command[1:]
    if command and command[0] == "close":
        raise Blocker("browser_use_continue_close_requires_finalize")
    command, origins, _ = validate_command(command, "authorized", config, list(authority["allowed_origins"]), descriptor["download_dir"])
    if origins and descriptor["origin"] not in origins:
        raise Blocker("browser_use_handoff_origin_drift")
    code, readback_exit = run_cli_keep_alive(config, config["roots"]["browser_use_home"], descriptor["port"], session, command, True)
    if code != 0:
        raise Blocker("browser_use_command_failed", str(code))
    if readback_exit != 0:
        raise Blocker("browser_use_readback_failed", str(readback_exit))
    validate_handoff_process_identity(config, descriptor, allow_missing=False)
    descriptor["status"] = "continued"
    descriptor["human_completion_signal"] = "one_time_untrusted_signal_consumed"
    descriptor["human_completion_at"] = iso(now_utc())
    descriptor["last_command"] = command[0]
    descriptor["readback_exit"] = readback_exit
    update_handoff(consumed_path, descriptor)
    print(json.dumps({"status": "continued", "descriptor": consumed_path, "run_id": run_id, "session": session, "human_completion_signal": "consumed_not_auth_proof", "finalized": False}, sort_keys=True))
    return 0


def finalize_handoff(args: argparse.Namespace) -> int:
    config = read_toml()
    versions = validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor_path = os.path.realpath(args.descriptor)
    base_path = _handoff_base_path(descriptor_path)
    candidate = _select_cleanup_candidate(base_path)
    if candidate is None and _read_cleanup_complete(base_path, run_id, session):
        marker = read_json_safe(_cleanup_complete_path(base_path))
        if marker.get("lifecycle") == TEMPORARY_LIFECYCLE:
            if not getattr(args, "task_id", None) or marker.get("task_id") != args.task_id:
                raise Blocker("browser_use_temporary_task_id_required")
        nonce = marker.get("nonce")
        if not isinstance(nonce, str) or not safe_id(nonce, "nonce"):
            raise Blocker("browser_use_cleanup_completion_binding_mismatch")
        receipt_path = os.path.join(config["roots"]["receipts"], run_id, f"{session}-{nonce}.json")
        if not os.path.lexists(receipt_path):
            raise Blocker("browser_use_cleanup_completion_receipt_missing")
        print(json.dumps({"status": "completed", "receipt": receipt_path, "exact_blocker": None, "quarantine": None, "finalized": True}, sort_keys=True))
        return 0
    if candidate is None:
        raise Blocker("browser_use_handoff_missing")
    descriptor = read_handoff(config, candidate, run_id, session, require_unexpired=False)
    require_temporary_task_id(args, descriptor)
    cleanup_only = bool(getattr(args, "cleanup_only", False))
    require_temporary_delete_approval(
        descriptor,
        delete_approved=delete_approval_signal(args),
        cleanup_only=cleanup_only,
    )
    if descriptor.get("lifecycle") == TEMPORARY_LIFECYCLE and delete_approval_signal(args):
        descriptor["completion_assessment"] = "ai_judged_complete"
        descriptor["retention_decision"] = "delete_approved"
        descriptor["task_completion_signal"] = "delete_approval_received"
        descriptor["delete_approval_at"] = iso(now_utc())
        update_handoff(candidate, descriptor)
    ctx: dict[str, Any] = {"mode": "authorized", "lifecycle": str(descriptor.get("lifecycle", "single-use")), "run_id": run_id, "requested_session": descriptor.get("requested_session", session), "session": session, "automation_id": descriptor["automation_id"], "task_id": descriptor.get("task_id"), "creation_binding": descriptor.get("creation_binding"), "authority_sha256": descriptor.get("authority_sha256"), "authority_scope": descriptor.get("authority_scope"), "nonce": descriptor["nonce"], "started_at": descriptor.get("started_at", iso(now_utc())), "lock_paths": descriptor["lock_paths"], "cleanup": {}, "profile": descriptor["profile"], "download_dir": descriptor["download_dir"], "port": descriptor["port"], "process": descriptor["process"], "profile_hash": descriptor["profile_hash"], "target_origins": descriptor.get("origins", [descriptor["origin"]]), "account_identity": descriptor.get("account_identity", "authorized"), "authority_summary": {"data_exposure": "authorized", "side_effect_scope": "bounded_by_authority", "approval": "approved"}, "readback_required": True, "config": config, "room_id": descriptor.get("room_id")}
    failure: str | None = None
    try:
        result = cleanup_abandoned_handoff(config, base_path, run_id, session, require_expired=False)
        ctx["cleanup"] = result
    except (Blocker, OSError, subprocess.SubprocessError, ValueError, json.JSONDecodeError) as exc:
        failure = exc.code if isinstance(exc, Blocker) else "browser_use_runtime_error"
        _record_context_cleanup_pending(ctx, failure)
    receipt_path = finalized_receipt(config, versions, ctx, failure)
    print(json.dumps({"status": "blocked" if failure else "completed", "receipt": receipt_path, "exact_blocker": failure, "quarantine": ctx.get("quarantine"), "finalized": not failure}, sort_keys=True))
    return 1 if failure else 0


def _cleanup_execute_failure(config: dict[str, Any], ctx: dict[str, Any], chrome_proc: subprocess.Popen[bytes] | None, lifecycle: str) -> str | None:
    # A recording started from a login handoff borrows the handoff's Chrome,
    # profile, download directory, and locks. Never quarantine or release
    # those shared resources on a recording-start failure; the handoff owner
    # remains responsible for their eventual cleanup.
    if ctx.get("owned_chrome") is False:
        ctx.setdefault("cleanup", {})["shared_handoff_preserved"] = True
        return None
    process_cleanup_ok = True
    cleanup_error: str | None = None
    home = ctx.get("home") or config["roots"]["browser_use_home"]
    session = ctx.get("session")
    port = ctx.get("port")
    if isinstance(session, str) and isinstance(port, int):
        daemon_closed, daemon_error = close_owned_daemon_if_active(config, home, port, session)
        if not daemon_closed:
            _record_context_cleanup_pending(ctx, daemon_error or "browser_use_daemon_cleanup_unverified")
            return daemon_error or "browser_use_daemon_cleanup_unverified"
    if chrome_proc is not None:
        try:
            process_cleanup_ok, cleanup_error = terminate_chrome(chrome_proc, ctx.get("process"), config["executables"]["chrome"]["canonical_path"], ctx.get("port", 0), ctx.get("profile", ""))
        except Exception as exc:
            process_cleanup_ok, cleanup_error = False, _cleanup_failure_code(exc)
        if cleanup_error:
            process_cleanup_ok = False
        if process_cleanup_ok:
            ctx["process_terminated"] = True
            ctx["listener_absent"] = True
    else:
        # The Chrome launch may have exited before returning an identity.  Do
        # not infer termination from the missing Popen object: prove absence
        # of the exact profile/port process and listener first.  If a matching
        # process remains, leave the lease retained for a lifecycle owner.
        try:
            verify_chrome_absent(
                config["executables"]["chrome"]["canonical_path"],
                int(ctx.get("port") or 0),
                str(ctx.get("profile") or ""),
            )
        except Exception as exc:
            process_cleanup_ok, cleanup_error = False, _cleanup_failure_code(exc)
        else:
            ctx["process_terminated"] = True
            ctx["listener_absent"] = True
    if not process_cleanup_ok:
        _record_context_cleanup_pending(ctx, cleanup_error or "browser_use_cleanup_uncertain")
        return cleanup_error or "browser_use_cleanup_uncertain"

    download_dir = ctx.get("download_dir")
    if isinstance(download_dir, str) and os.path.lexists(download_dir):
        try:
            removed = cleanup_empty_download_dir(download_dir, config["roots"]["downloads"])
        except Exception as exc:
            cleanup_error = _cleanup_failure_code(exc)
            _record_context_cleanup_pending(ctx, cleanup_error)
            return cleanup_error
        ctx.setdefault("cleanup", {})["download_dir_removed"] = removed
        if not removed:
            ctx["cleanup"]["download_dir_retained"] = "non_empty"

    quarantine_ok = True
    if lifecycle == "single-use" and ctx.get("profile") and os.path.lexists(ctx["profile"]):
        try:
            ctx["quarantine"] = quarantine_profile(config, ctx["profile"], ctx)
        except Exception as exc:
            cleanup_error = _cleanup_failure_code(exc)
            ctx["quarantine"] = "quarantine_pending"
            quarantine_ok = False
    elif lifecycle == TEMPORARY_LIFECYCLE:
        if ctx.get("profile") and os.path.lexists(ctx["profile"]):
            ctx.setdefault("cleanup", {})["temporary_profile_preserved"] = True
        elif ctx.get("profile"):
            cleanup_error = "browser_use_temporary_profile_missing_after_cleanup"
            quarantine_ok = False
    elif lifecycle != "scheduled":
        cleanup_error = "browser_use_lifecycle_invalid"
        quarantine_ok = False
    if not quarantine_ok:
        _record_context_cleanup_pending(ctx, cleanup_error or "browser_use_cleanup_uncertain")
        return cleanup_error or "browser_use_cleanup_uncertain"
    if ctx.get("cleanup", {}).get("state") == "uncertain":
        return str(ctx["cleanup"].get("exact_blocker") or "browser_use_cleanup_uncertain")
    released, release_error = _release_locks_after_verified_cleanup(ctx, ctx["run_id"], ctx["nonce"])
    if not released:
        return release_error or "browser_use_cleanup_uncertain"
    return None


def execute(args: argparse.Namespace) -> int:
    if args.lifecycle == TEMPORARY_LIFECYCLE and args.mode != "authorized":
        raise Blocker("browser_use_temporary_requires_authorized_mode")
    if args.lifecycle == TEMPORARY_LIFECYCLE and not getattr(args, "task_id", None):
        raise Blocker("browser_use_temporary_task_id_required")
    config = read_toml()
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    automation_id = safe_id(args.automation_id, "automation_id")
    nonce = uuid.uuid4().hex
    ctx: dict[str, Any] = {"mode": args.mode, "lifecycle": args.lifecycle, "run_id": run_id, "requested_session": requested_session, "session": session, "automation_id": automation_id, "nonce": nonce, "started_at": iso(now_utc()), "lock_paths": [], "cleanup": {}, "config": config}
    versions: dict[str, Any] = {}
    failure: str | None = None
    chrome_proc: subprocess.Popen[bytes] | None = None
    try:
        versions = validate_installation(config)
        configure_logging(config["roots"]["logs"])
        authority: dict[str, Any] | None = None
        if args.mode == "authorized":
            if not args.authority:
                raise Blocker("browser_use_authority_required")
            authority = parse_authority(args.authority, run_id, session, aliases=session_aliases(config, requested_session, session))
        if args.mode == "public" and args.lifecycle != "single-use":
            raise Blocker("browser_use_public_requires_single_use")
        allowed_origins = args.allowed_origin if args.mode == "public" else authority["allowed_origins"]
        if not allowed_origins:
            raise Blocker("browser_use_allowed_origins_required")
        if args.lifecycle == "scheduled" and args.automation_id == "manual":
            raise Blocker("browser_use_scheduled_automation_id_required")
        if args.lifecycle == "single-use" and args.port is not None and not (config["ports"]["single_use_start"] <= args.port <= config["ports"]["single_use_end"]):
            raise Blocker("browser_use_single_use_port_out_of_range")
        if args.lifecycle == "scheduled" and args.port is not None and not (config["ports"]["scheduled_start"] <= args.port <= config["ports"]["scheduled_end"]):
            raise Blocker("browser_use_scheduled_port_out_of_range")
        if args.lifecycle not in {"single-use", "scheduled", TEMPORARY_LIFECYCLE}:
            raise Blocker("browser_use_lifecycle_invalid")
        authority_scope = temporary_authority_scope(authority) if args.lifecycle == TEMPORARY_LIFECYCLE else None
        if args.lifecycle == TEMPORARY_LIFECYCLE:
            nonce = temporary_binding(mode=args.mode, lifecycle=args.lifecycle, automation_id=automation_id, task_id=args.task_id, run_id=run_id, authority_digest=sha256_file(args.authority), authority_scope=authority_scope or {}, account_identity=authority["account_identity"], origins=list(authority["allowed_origins"]))
            port = args.port
        else:
            port = args.port
        ctx["port"] = port
        ctx["task_id"] = getattr(args, "task_id", None)
        ctx["creation_binding"] = nonce if args.lifecycle == TEMPORARY_LIFECYCLE else None
        ctx["authority_scope"] = authority_scope
        ctx["account_identity"] = authority["account_identity"] if authority else "public"
        ctx["readback_required"] = bool(authority["readback_required"]) if authority else True
        ctx["authority_summary"] = {"data_exposure": authority["data_exposure"], "side_effect_scope": authority["side_effect_scope"], "approval": authority["approval"]} if authority else {"data_exposure": "public_read_only", "side_effect_scope": "none", "approval": "not_required"}
        ctx["home"] = config["roots"]["browser_use_home"]
        if args.lifecycle == TEMPORARY_LIFECYCLE:
            profile = temporary_profile_path(config, nonce)
            download_dir = os.path.join(config["roots"]["downloads"], f"temporary-{nonce[:32]}")
        else:
            profile_parent = config["roots"]["scheduled_profiles"] if args.lifecycle == "scheduled" else config["roots"]["single_use_profiles"]
            profile = os.path.join(profile_parent, automation_id if args.lifecycle == "scheduled" else f"{run_id}-{nonce}") if args.lifecycle == "scheduled" else None
            download_dir = os.path.join(config["roots"]["downloads"], f"{run_id}-{nonce}")
        ctx["profile"], ctx["download_dir"] = profile, download_dir
        ctx["profile_hash"] = profile_hash(profile, nonce) if profile else None
        command_args = list(args.command)
        if command_args and command_args[0] == "--":
            command_args = command_args[1:]
        command, origins, uploads = validate_command(command_args, args.mode, config, list(allowed_origins), download_dir)
        for upload in uploads:
            upload["destination"] = origins[0] if origins else "authorized_browser_origin"
        ctx["target_origins"], ctx["uploads"], ctx["preflight"] = origins, uploads, True
        post_commands: list[list[str]] = []
        if args.post_command_json:
            try:
                raw_post_commands = json.loads(args.post_command_json)
            except (TypeError, ValueError, json.JSONDecodeError) as exc:
                raise Blocker("browser_use_post_commands_json_invalid") from exc
            if not isinstance(raw_post_commands, list) or len(raw_post_commands) > 8:
                raise Blocker("browser_use_post_commands_invalid")
            artifact_dir = os.path.realpath(str(args.artifact_dir or ""))
            assert_directory(artifact_dir)
            for raw_post in raw_post_commands:
                if not isinstance(raw_post, list) or not raw_post or not isinstance(raw_post[0], str):
                    raise Blocker("browser_use_post_command_invalid")
                post_command, _, _ = validate_command([str(value) for value in raw_post], args.mode, config, list(allowed_origins), download_dir)
                if post_command[0] not in {"state", "screenshot", "get", "eval", "extract"}:
                    raise Blocker("browser_use_post_command_not_read_only")
                if post_command[0] == "eval":
                    if len(post_command) != 2 or post_command[1] not in {"location.href", "document.title"}:
                        raise Blocker("browser_use_post_eval_not_allowlisted")
                if post_command[0] == "screenshot":
                    if len(post_command) != 2:
                        raise Blocker("browser_use_post_screenshot_path_required")
                    post_command[1] = validate_capture_path(post_command[1], artifact_dir)
                post_commands.append(post_command)
            ctx["post_commands"] = [{"name": item[0], "argument_count": max(0, len(item) - 1)} for item in post_commands]
        room = room_registry_claim(
            config,
            lifecycle=args.lifecycle,
            run_id=run_id,
            profile=profile if args.lifecycle != "single-use" else None,
            port=port,
            task_id=getattr(args, "task_id", None),
            automation_id=automation_id,
            activity=f"execute-{command[0]}",
        )
        ctx["room_id"] = room["room_id"]
        profile, port = room["profile"], room["port"]
        ctx["profile"], ctx["port"] = profile, port
        ctx["profile_hash"] = profile_hash(profile, nonce)
        if args.lifecycle == TEMPORARY_LIFECYCLE:
            temp_info = prepare_temporary_profile(config, mode=args.mode, automation_id=automation_id, task_id=args.task_id, run_id=run_id, authority_digest=sha256_file(args.authority), authority_scope=authority_scope or {}, account_identity=authority["account_identity"], origins=list(authority["allowed_origins"]), download_dir=download_dir, requested_port=port)
            ctx["lock_paths"].append(temp_info["profile_lock"])
        else:
            prepare_profile(profile, args.lifecycle == "scheduled", automation_id, download_dir, run_id, nonce)
        if os.path.exists(download_dir):
            raise Blocker("browser_use_download_directory_collision")
        os.mkdir(download_dir, 0o700)
        assert_directory(download_dir)
        profile_lock_name = hashlib.sha256(os.path.realpath(profile).encode()).hexdigest()[:24]
        profile_lock = temporary_profile_lock_path(config, profile) if args.lifecycle == TEMPORARY_LIFECYCLE else os.path.join(config["roots"]["locks"], f"profile-{profile_lock_name}.lock")
        port_lock = os.path.join(config["roots"]["locks"], f"port-{port}.lock")
        payload = {"schema": "browser-use-lock.v1", "run_id": run_id, "nonce": nonce, "helper_pid": os.getpid(), "helper_start_time": psutil.Process(os.getpid()).create_time(), "automation_id": automation_id, "port": port, "canonical_profile": os.path.realpath(profile)}
        if args.lifecycle != TEMPORARY_LIFECYCLE:
            lock_file(profile_lock, payload)
            ctx["lock_paths"].append(profile_lock)
        lock_file(port_lock, payload)
        ctx["lock_paths"].append(port_lock)
        chrome_proc, process = launch_chrome(config, profile, port, download_dir, ctx["home"])
        ctx["process"] = process
        ctx["listener_verified"] = True
        ctx["process_identity_verified"] = True
        if post_commands:
            code, readback_exit, captured_readback = run_cli_with_post_commands(
                config,
                ctx["home"],
                port,
                session,
                command,
                ctx["readback_required"],
                post_commands,
            )
            ctx["captured_readback"] = captured_readback
        else:
            code, readback_exit = run_cli(config, ctx["home"], port, session, command, ctx["readback_required"])
        ctx["readback_exit"] = readback_exit
        ctx["downloads"] = scan_downloads(download_dir, config["limits"]["max_download_bytes"])
        if code != 0:
            raise Blocker("browser_use_command_failed", str(code))
        if ctx["readback_required"] and readback_exit != 0:
            raise Blocker("browser_use_readback_failed", str(readback_exit))
        ok, cleanup_error = terminate_chrome(chrome_proc, process, config["executables"]["chrome"]["canonical_path"], port, profile)
        chrome_proc = None
        if not ok or cleanup_error:
            raise Blocker(cleanup_error or "browser_use_chrome_cleanup_failed")
        ctx["process_terminated"] = True
        ctx["listener_absent"] = True
        if cleanup_empty_download_dir(download_dir, config["roots"]["downloads"]):
            ctx["cleanup"]["download_dir_removed"] = True
        else:
            ctx["cleanup"]["download_dir_retained"] = "non_empty"
        if args.lifecycle == "single-use":
            assert_owned_locks(ctx["lock_paths"], run_id, nonce)
            cleanup_exact_profile(profile, config["roots"]["single_use_profiles"], run_id, nonce)
            ctx["cleanup"]["profile_removed"] = True
        elif args.lifecycle == TEMPORARY_LIFECYCLE:
            if not os.path.lexists(profile):
                raise Blocker("browser_use_temporary_profile_missing_after_execute")
            ctx["cleanup"]["temporary_profile_preserved"] = True
        elif args.lifecycle != "scheduled":
            raise Blocker("browser_use_lifecycle_invalid")
        released, release_error = _release_locks_after_verified_cleanup(ctx, run_id, nonce)
        if not released:
            raise Blocker(release_error or "browser_use_cleanup_uncertain")
    except Blocker as exc:
        failure = exc.code
        logging.critical("browser_use_blocked code=%s", exc.code)
        cleanup_failure = _cleanup_execute_failure(config, ctx, chrome_proc, args.lifecycle)
        if cleanup_failure:
            failure = cleanup_failure
    except (OSError, subprocess.SubprocessError, ValueError, json.JSONDecodeError) as exc:
        failure = "browser_use_runtime_error"
        logging.critical("browser_use_runtime_error type=%s", type(exc).__name__)
        cleanup_failure = _cleanup_execute_failure(config, ctx, chrome_proc, args.lifecycle)
        if cleanup_failure:
            failure = cleanup_failure
    receipt_path = finalized_receipt(config, versions, ctx, failure)
    print(json.dumps({"status": "blocked" if failure else "completed", "receipt": receipt_path, "exact_blocker": failure, "finalized": failure is None, "captured_readback": ctx.get("captured_readback", {})}, sort_keys=True))
    return 1 if failure else 0


def janitor(config: dict[str, Any]) -> int:
    validate_installation(config)
    temporary_root = os.path.realpath(config["roots"]["temporary_profiles"])
    temporary_removed = 0
    skipped: list[dict[str, str]] = []
    for entry in pathlib.Path(temporary_root).iterdir():
        if entry.is_symlink() or not entry.is_dir() or os.path.realpath(entry.parent) != temporary_root:
            continue
        profile = os.path.realpath(str(entry))
        try:
            marker = read_json_safe(os.path.join(profile, ".browser-use-profile.json"))
            expected = {field: marker.get(field) for field in ("mode", "lifecycle", "automation_id", "task_id", "run_id", "creation_binding", "canonical_profile", "port", "authority_sha256", "authority_scope", "account_identity", "origins")}
            validate_temporary_marker(config, profile, expected, require_unexpired=False)
            if _parse_temporary_time(marker["expires_at"], "expires_at") > now_utc():
                continue
            port = int(marker["port"])
            if port_listener(port) or lsof_listener(port):
                skipped.append({"profile": profile, "reason": "browser_use_temporary_listener_active"})
                continue
            active = False
            if psutil is not None:
                for process in psutil.process_iter(["cmdline"]):
                    try:
                        command_line = process.info.get("cmdline") or []
                        if f"--user-data-dir={profile}" in command_line or f"--remote-debugging-port={port}" in command_line:
                            active = True
                            break
                    except (psutil.Error, OSError):
                        active = True
                        break
            if active:
                skipped.append({"profile": profile, "reason": "browser_use_temporary_process_active_or_unknown"})
                continue
            lock_paths = [os.path.realpath(marker["profile_lock_path"]), os.path.realpath(marker["port_lock_path"])]
            if any(os.path.lexists(path) for path in lock_paths):
                skipped.append({"profile": profile, "reason": "browser_use_temporary_lock_present"})
                continue
            payload = {"schema": "browser-use-lock.v1", "run_id": marker["run_id"], "nonce": marker["creation_binding"], "helper_pid": os.getpid(), "helper_start_time": psutil.Process(os.getpid()).create_time(), "automation_id": marker["automation_id"], "task_id": marker["task_id"], "port": port, "canonical_profile": profile, "lifecycle": TEMPORARY_LIFECYCLE, "janitor": True}
            acquired: list[str] = []
            try:
                for path in lock_paths:
                    lock_file(path, payload)
                    acquired.append(path)
                descriptor = {"mode": marker["mode"], "lifecycle": TEMPORARY_LIFECYCLE, "automation_id": marker["automation_id"], "task_id": marker["task_id"], "run_id": marker["run_id"], "creation_binding": marker["creation_binding"], "profile": profile, "port": port, "authority_sha256": marker["authority_sha256"], "authority_scope": marker["authority_scope"], "account_identity": marker["account_identity"], "origins": marker["origins"], "target_origins": marker["origins"], "nonce": marker["creation_binding"], "lock_paths": lock_paths, "cleanup_state": {}}
                cleanup_temporary_profile(config, descriptor, process_verified=True)
                temporary_removed += 1
            finally:
                for path in acquired:
                    try:
                        release_lock(path, marker["run_id"], marker["creation_binding"])
                    except Exception:
                        skipped.append({"profile": profile, "reason": "browser_use_temporary_janitor_lock_release_uncertain"})
        except (Blocker, KeyError, ValueError, OSError) as exc:
            skipped.append({"profile": profile, "reason": exc.code if isinstance(exc, Blocker) else "browser_use_temporary_profile_unverified"})

    root = config["roots"]["quarantine"]
    removed = 0
    for entry in pathlib.Path(root).iterdir():
        if entry.is_symlink() or not entry.is_dir() or os.path.realpath(entry.parent) != os.path.realpath(root):
            continue
        marker_path = entry / ".quarantine.json"
        try:
            marker = read_json_safe(str(marker_path))
            expires = dt.datetime.fromisoformat(str(marker["expires_at"]).replace("Z", "+00:00"))
            if expires > now_utc():
                continue
            if marker.get("owner_uid") != EUID or marker.get("quarantine_path") != os.path.realpath(str(entry)):
                continue
            canonical_profile = marker.get("canonical_profile")
            if not isinstance(canonical_profile, str) or not os.path.isabs(canonical_profile) or os.path.realpath(canonical_profile) != canonical_profile:
                continue
            profile_marker = read_json_safe(str(entry / ".browser-use-profile.json"))
            if profile_marker.get("run_id") != marker.get("run_id") or profile_marker.get("nonce") != marker.get("nonce"):
                continue
            pid = marker.get("related_pid")
            start = marker.get("related_start_time")
            if pid and psutil:
                try:
                    process = psutil.Process(int(pid))
                    if start and abs(process.create_time() - float(start)) < 0.5:
                        continue
                except psutil.NoSuchProcess:
                    pass
            if port_listener(int(marker.get("port", 0))) or lsof_listener(int(marker.get("port", 0))):
                continue
            lock_paths = marker.get("lock_paths", [])
            if any(os.path.exists(path) for path in lock_paths):
                continue
            assert_directory(str(entry))
            shutil.rmtree(entry)
            removed += 1
        except (Blocker, KeyError, ValueError, OSError):
            continue
    print(json.dumps({"status": "completed", "removed": removed, "temporary_removed": temporary_removed, "skipped": skipped, "finalized": True}, sort_keys=True))
    return 0


def reconcile_failed_startup(args: argparse.Namespace) -> int:
    """Reconcile one run-owned single-use launch that produced no descriptor.

    This is intentionally narrower than recording finalization: it accepts
    only the exact profile lock created by the failed run, proves the profile
    marker and lock binding, proves that the exact Chrome profile/port has no
    process or listener, then quarantines the profile and releases only locks
    positively owned by that run.  It never terminates a process and never
    touches a foreign port lock.
    """
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    profile = os.path.realpath(args.profile)
    profile_root = os.path.realpath(config["roots"]["single_use_profiles"])
    if not os.path.isabs(args.profile) or profile != args.profile or not profile.startswith(profile_root + os.sep):
        raise Blocker("browser_use_profile_cleanup_scope_mismatch")
    profile_lock = os.path.realpath(args.profile_lock)
    locks_root = os.path.realpath(config["roots"]["locks"])
    expected_profile_lock = os.path.join(locks_root, f"profile-{hashlib.sha256(profile.encode()).hexdigest()[:24]}.lock")
    if not os.path.isabs(args.profile_lock) or profile_lock != args.profile_lock or profile_lock != expected_profile_lock:
        raise Blocker("browser_use_lock_cleanup_scope_mismatch")
    if not isinstance(args.port, int) or not (config["ports"]["single_use_start"] <= args.port <= config["ports"]["single_use_end"]):
        raise Blocker("browser_use_recording_port_out_of_range")
    quarantine_path = os.path.join(os.path.realpath(config["roots"]["quarantine"]), os.path.basename(profile))
    if not os.path.lexists(profile_lock) and os.path.isdir(quarantine_path):
        quarantine_marker_path = os.path.join(quarantine_path, ".quarantine.json")
        assert_regular_file(quarantine_marker_path, mode=0o600)
        quarantine_marker = read_json_safe(quarantine_marker_path)
        if (
            quarantine_marker.get("schema") != "browser-use-quarantine.v1"
            or quarantine_marker.get("run_id") != run_id
            or quarantine_marker.get("canonical_profile") != profile
            or quarantine_marker.get("port") != args.port
        ):
            raise Blocker("browser_use_quarantine_binding_mismatch")
        nonce = safe_id(quarantine_marker.get("nonce"), "nonce")
        if not os.path.lexists(os.path.join(quarantine_path, ".browser-use-profile.json")):
            raise Blocker("browser_use_quarantine_profile_marker_missing")
        verify_chrome_absent(config["executables"]["chrome"]["canonical_path"], args.port, profile)
        receipt = {
            "schema": "browser-use-startup-reconciliation.v1",
            "status": "completed",
            "run_id": run_id,
            "nonce": nonce,
            "profile": profile,
            "quarantine_path": quarantine_path,
            "port": args.port,
            "process_absent": True,
            "listener_absent": True,
            "locks_removed": list(quarantine_marker.get("lock_paths") or []),
            "foreign_port_lock_retained": True,
            "recovery_reason": "already_quarantined",
        }
        receipt_path = os.path.join(config["roots"]["receipts"], f"{run_id}-startup-reconciliation-{nonce}.json")
        if os.path.lexists(receipt_path):
            existing = read_json_safe(receipt_path)
            if existing != receipt:
                raise Blocker("browser_use_receipt_binding_mismatch")
        else:
            json_atomic_no_replace(receipt_path, receipt)
        print(json.dumps({"status": "completed", "receipt": receipt_path, **receipt}, sort_keys=True))
        return 0
    assert_regular_file(profile_lock, mode=0o600)
    lock_value = read_json_safe(profile_lock)
    if lock_value.get("schema") != "browser-use-lock.v1" or lock_value.get("run_id") != run_id or lock_value.get("canonical_profile") != profile or int(lock_value.get("port", -1)) != args.port:
        raise Blocker("browser_use_lock_owner_recheck_failed")
    nonce = safe_id(lock_value.get("nonce"), "nonce")
    if not os.path.isdir(profile):
        raise Blocker("browser_use_profile_missing")
    marker_path = os.path.join(profile, ".browser-use-profile.json")
    assert_regular_file(marker_path, mode=0o600)
    marker = read_json_safe(marker_path)
    if marker.get("schema") != "browser-use-profile.v1" or marker.get("run_id") != run_id or marker.get("nonce") != nonce:
        raise Blocker("browser_use_profile_marker_binding_mismatch")
    port_lock = os.path.join(locks_root, f"port-{args.port}.lock")
    lock_paths = [profile_lock]
    foreign_port_lock = False
    if os.path.lexists(port_lock):
        assert_regular_file(port_lock, mode=0o600)
        port_value = read_json_safe(port_lock)
        if port_value.get("run_id") == run_id and port_value.get("nonce") == nonce and port_value.get("canonical_profile") == profile:
            lock_paths.append(port_lock)
        else:
            foreign_port_lock = True
    verify_chrome_absent(config["executables"]["chrome"]["canonical_path"], args.port, profile)
    ctx = {
        "run_id": run_id,
        "session": f"startup-reconcile-{run_id}",
        "nonce": nonce,
        "process": {},
        "port": args.port,
        "profile": profile,
        "lock_paths": lock_paths,
        "process_terminated": True,
        "listener_absent": True,
    }
    quarantine_path = quarantine_profile(config, profile, ctx)
    released_ok, release_error, released = _release_lock_set(lock_paths, run_id, nonce)
    if not released_ok:
        raise Blocker(release_error or "browser_use_cleanup_uncertain")
    receipt = {
        "schema": "browser-use-startup-reconciliation.v1",
        "status": "completed",
        "run_id": run_id,
        "nonce": nonce,
        "profile": profile,
        "quarantine_path": quarantine_path,
        "port": args.port,
        "process_absent": True,
        "listener_absent": True,
        "locks_removed": released,
        "foreign_port_lock_retained": foreign_port_lock,
    }
    receipt_path = os.path.join(config["roots"]["receipts"], f"{run_id}-startup-reconciliation-{nonce}.json")
    json_atomic_no_replace(receipt_path, receipt)
    print(json.dumps({"status": "completed", "receipt": receipt_path, **receipt}, sort_keys=True))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="codex-browser-use", description="Bounded Browser Use CLI runtime; no stdout/page body/cookies/tokens/CDP URLs are persisted.")
    sub = parser.add_subparsers(dest="action", required=True)
    handoff = sub.add_parser("login-handoff", help="open one authorized URL and leave a bounded human-login session")
    handoff.add_argument("--run-id", required=True)
    handoff.add_argument("--session", required=True)
    handoff.add_argument("--automation-id", default="manual")
    handoff.add_argument("--lifecycle", choices=("scheduled", "single-use", TEMPORARY_LIFECYCLE), default=None, help="defaults to temporary for authorized chat and single-use for public flows")
    handoff.add_argument("--task-id", help="optional in normal chat; a stable task id is derived for the temporary authorized lifecycle")
    handoff.add_argument("--port", type=int)
    handoff.add_argument("--authority", required=True, help="0600 authority JSON required for authorized mode")
    handoff.add_argument("--url", required=True)
    handoff.set_defaults(action="login-handoff")
    continuation = sub.add_parser("continue", help="consume one login handoff and run an existing authorized command")
    continuation.add_argument("--run-id", required=True)
    continuation.add_argument("--session", required=True)
    continuation.add_argument("--descriptor", required=True)
    continuation.add_argument("--authority", required=True, help="0600 authority JSON required for authorized mode")
    continuation.add_argument("--task-id", help="required when the handoff lifecycle is temporary")
    continuation.add_argument("--human-complete", action="store_true", help="one-time human signal; never used as authentication proof")
    continuation.add_argument("command", nargs=argparse.REMAINDER, help="Existing authorized Browser Use command after --")
    continuation.set_defaults(action="continue")
