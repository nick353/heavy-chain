def lifecycle_phase(*, observed: bool = False, requested: bool = False, executed: bool = False, completed: bool = False, blocked: bool = False, exact_blocker: str | None = None) -> dict[str, Any]:
    """Return the secret-free, explicit phase contract used by lifecycle evidence."""
    value = {
        "observed": bool(observed),
        "requested": bool(requested),
        "executed": bool(executed),
        "completed": bool(completed),
        "blocked": bool(blocked),
    }
    if exact_blocker:
        value["exact_blocker"] = str(exact_blocker)[:160]
    return value


class Blocker(RuntimeError):
    def __init__(self, code: str, detail: str = "") -> None:
        self.code = code
        self.detail = detail
        super().__init__(f"{code}: {detail}" if detail else code)


def authentication_next_action(state: str) -> str:
    """Project one unambiguous operator action from the auth state."""
    return {
        "waiting": "login in the existing Temporary room, then continue the same run",
        "authenticated": "continue the original same-run flow; authentication was verified",
    }.get(state, "read back the same-run authentication state before continuing")


def public_blocker_detail(value: Any) -> str:
    """Keep CLI diagnostics secret-free; exact blocker codes remain the proof."""
    detail = str(value or "")
    if not detail:
        return ""
    return "redacted"


def now_utc() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc)


def iso(value: dt.datetime) -> str:
    return value.astimezone(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def validate_id(value: str, field: str) -> str:
    if not isinstance(value, str) or not ID_RE.fullmatch(value):
        raise Blocker("browser_use_invalid_identifier", field)
    return value


def session_socket_path(home: str, session: str) -> str:
    return os.path.join(home, f"{session}.sock")


def session_socket_path_bytes(home: str, session: str) -> int:
    return len(os.fsencode(session_socket_path(home, session)))


def canonical_session_id(value: str, home: str) -> str:
    """Return a stable daemon-safe ID while preserving caller provenance."""
    raw = validate_id(value, "session")
    # The configured Browser Use home is canonical and bounded by the runtime
    # config. Preserve all normal IDs; only caller IDs that can make the daemon
    # socket path unsafe need rewriting.
    if len(raw) <= MAX_DAEMON_SESSION_ID_LENGTH:
        return raw

    digest = hashlib.sha256(raw.encode("utf-8")).hexdigest()[:10]
    prefix = raw[:24].rstrip("-_.") or "bu"
    candidate = f"{prefix}-{digest}"
    while session_socket_path_bytes(home, candidate) > MAX_UNIX_SOCKET_PATH_BYTES and len(prefix) > 3:
        prefix = prefix[:-1].rstrip("-_.") or "bu"
        candidate = f"{prefix}-{digest}"
    if session_socket_path_bytes(home, candidate) > MAX_UNIX_SOCKET_PATH_BYTES:
        candidate = f"bu-{digest}"
    if len(candidate) > MAX_DAEMON_SESSION_ID_LENGTH:
        candidate = f"bu-{digest}"
    return candidate


def safe_id(value: str, field: str) -> str:
    value = validate_id(value, field)
    if field == "session" and len(value) > MAX_DAEMON_SESSION_ID_LENGTH:
        raise Blocker("browser_use_session_identifier_too_long", str(len(value)))
    return value


def _owner_attestation_crypto() -> tuple[Any, Any, Any, Any]:
    try:
        from cryptography.hazmat.primitives import serialization
        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey, Ed25519PublicKey
        from cryptography.exceptions import InvalidSignature
    except Exception as exc:  # pragma: no cover - exercised by dependency smoke tests
        raise Blocker("browser_use_owner_attestation_crypto_unavailable") from exc
    return serialization, Ed25519PrivateKey, Ed25519PublicKey, InvalidSignature


def _owner_canonical_json(value: Any) -> bytes:
    return json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":")).encode("utf-8")


def _owner_attestation_private_key() -> Any:
    serialization, _, _, _ = _owner_attestation_crypto()
    try:
        assert_regular_file(OWNER_ATTESTATION_PRIVATE_KEY_PATH, mode=0o600)
        with open(OWNER_ATTESTATION_PRIVATE_KEY_PATH, "rb") as handle:
            private = serialization.load_pem_private_key(handle.read(16 * 1024), password=None)
        public_raw = private.public_key().public_bytes(serialization.Encoding.Raw, serialization.PublicFormat.Raw)
        if hashlib.sha256(public_raw).hexdigest() != OWNER_ATTESTATION_PUBLIC_KEY_SHA256:
            raise Blocker("browser_use_owner_attestation_key_mismatch")
        return private
    except Blocker:
        raise
    except Exception as exc:
        raise Blocker("browser_use_owner_attestation_key_unavailable") from exc


def _owner_attestation_public_key() -> Any:
    _, _, Ed25519PublicKey, _ = _owner_attestation_crypto()
    try:
        raw = base64.b64decode(OWNER_ATTESTATION_PUBLIC_KEY_B64, validate=True)
        if hashlib.sha256(raw).hexdigest() != OWNER_ATTESTATION_PUBLIC_KEY_SHA256:
            raise ValueError("public key digest mismatch")
        return Ed25519PublicKey.from_public_bytes(raw)
    except Exception as exc:
        raise Blocker("browser_use_owner_attestation_trust_anchor_invalid") from exc


def _owner_provider_path() -> str:
    selected = os.path.realpath(os.path.abspath(sys.argv[0]))
    assert_regular_file(selected)
    return selected


def _owner_safe_reference(value: str, field: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise Blocker("browser_use_owner_metadata_invalid", field)
    if len(value.encode("utf-8", errors="surrogatepass")) > MAX_OWNER_METADATA_VALUE_BYTES:
        raise Blocker("browser_use_owner_metadata_too_long", field)
    if any(unicodedata.category(char) == "Cc" or char in "\u2028\u2029" for char in value):
        raise Blocker("browser_use_owner_metadata_invalid", field)
    return value


def _owner_thread_transcript(thread_id: str) -> str:
    root = os.path.realpath(os.path.expanduser("~/.codex/sessions"))
    if not os.path.isdir(root):
        raise Blocker("browser_use_owner_context_provider_unavailable")
    suffix = f"-{thread_id}.jsonl"
    matches: list[str] = []
    pending = [root]
    scanned = 0
    while pending and scanned < 65536:
        directory = pending.pop()
        try:
            entries = os.scandir(directory)
        except OSError:
            continue
        with entries:
            for entry in entries:
                scanned += 1
                if scanned >= 65536:
                    break
                try:
                    if entry.is_symlink():
                        continue
                    if entry.is_dir(follow_symlinks=False):
                        pending.append(entry.path)
                    elif entry.name.endswith(suffix):
                        matches.append(os.path.realpath(entry.path))
                except OSError:
                    continue
    matches = sorted(set(matches))
    if len(matches) != 1:
        raise Blocker("browser_use_owner_context_provider_unavailable")
    transcript = matches[0]
    assert_regular_file(transcript)
    try:
        with open(transcript, "rb") as handle:
            line = handle.read(256 * 1024).splitlines()[0]
        record = json.loads(line.decode("utf-8"))
        payload = record.get("payload") if record.get("type") == "session_meta" else None
        if not isinstance(payload, dict) or (payload.get("id") or payload.get("session_id")) not in {thread_id, os.environ.get("CODEX_SESSION_ID", "")}:
            raise ValueError("thread binding mismatch")
        if payload.get("originator") != "Codex Desktop" or payload.get("source") != "vscode":
            raise ValueError("untrusted transcript source")
    except Exception as exc:
        raise Blocker("browser_use_owner_context_provider_unavailable") from exc
    return transcript


def _owner_host_identity(thread_id: str, transcript: str) -> tuple[str, str]:
    del thread_id, transcript
    cli_path = os.environ.get("CODEX_CLI_PATH", "")
    if not cli_path:
        raise Blocker("browser_use_owner_context_provider_unavailable")
    cli_path = os.path.realpath(os.path.abspath(cli_path))
    assert_regular_file(cli_path)
    cli_digest = sha256_file(cli_path)
    host_id = "codex-host-" + hashlib.sha256(f"{cli_path}:{cli_digest}".encode("utf-8")).hexdigest()[:32]
    return host_id, cli_digest


def _owner_expected_turn_id(thread_id: str, binding: dict[str, Any]) -> str:
    turn_seed = f"{thread_id}:{binding['run_id']}:{binding['requested_session']}"
    return f"browser-use-turn-{hashlib.sha256(turn_seed.encode()).hexdigest()[:32]}"


def _owner_record_start_binding(args: argparse.Namespace, *, command: list[str], recording_dir: str, allowed_origins: list[str], authority_digest: str | None) -> dict[str, Any]:
    return {
        "command": "record-start",
        "mode": str(args.mode),
        "lifecycle": str(args.lifecycle),
        "run_id": safe_id(args.run_id, "run_id"),
        "requested_session": validate_id(args.session, "session"),
        "automation_id": safe_id(args.automation_id, "automation_id"),
        "task_id": validate_id(args.task_id, "task_id") if args.task_id else "",
        "command_args": list(command),
        "allowed_origins": sorted(set(allowed_origins)),
        "authority_sha256": authority_digest or "",
        "recording_dir": os.path.realpath(recording_dir),
    }


def _owner_command_digest(binding: dict[str, Any]) -> str:
    return hashlib.sha256(_owner_canonical_json(binding)).hexdigest()


def _owner_write_packet(packet: dict[str, Any], nonce: str) -> str:
    os.makedirs(OWNER_ATTESTATION_STATE_ROOT, mode=0o700, exist_ok=True)
    os.chmod(OWNER_ATTESTATION_STATE_ROOT, 0o700)
    packet_dir = os.path.join(OWNER_ATTESTATION_STATE_ROOT, "packets")
    os.makedirs(packet_dir, mode=0o700, exist_ok=True)
    os.chmod(packet_dir, 0o700)
    path = os.path.join(packet_dir, f"{nonce}.json")
    data = _owner_canonical_json(packet) + b"\n"
    if len(data) > OWNER_ATTESTATION_MAX_PACKET_BYTES:
        raise Blocker("browser_use_owner_attestation_packet_too_large")
    try:
        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0), 0o600)
        try:
            os.write(fd, data)
            os.fsync(fd)
        finally:
            os.close(fd)
    except OSError as exc:
        raise Blocker("browser_use_owner_attestation_packet_write_failed") from exc
    os.chmod(path, 0o600)
    return path


def _issue_owner_attestation(binding: dict[str, Any]) -> str:
    private = _owner_attestation_private_key()
    public = _owner_attestation_public_key()
    serialization, _, _, _ = _owner_attestation_crypto()
    public_raw = public.public_bytes(serialization.Encoding.Raw, serialization.PublicFormat.Raw)
    thread_id = os.environ.get("CODEX_THREAD_ID", "").strip()
    if not thread_id:
        raise Blocker("browser_use_owner_context_provider_unavailable")
    validate_id(thread_id, "thread_id")
    transcript = _owner_thread_transcript(thread_id)
    host_id, cli_digest = _owner_host_identity(thread_id, transcript)
    turn_id = _owner_expected_turn_id(thread_id, binding)
    nonce = uuid.uuid4().hex
    issued = now_utc()
    body = {
        "schema": OWNER_ATTESTATION_SCHEMA,
        "issuer_id": OWNER_ATTESTATION_ISSUER_ID,
        "algorithm": OWNER_ATTESTATION_ALGORITHM,
        "provider_path": _owner_provider_path(),
        "provider_sha256": sha256_file(_owner_provider_path()),
        "public_key_sha256": hashlib.sha256(public_raw).hexdigest(),
        "binding": {**binding, "command_digest": _owner_command_digest(binding), "turn_id": turn_id, "session_id": binding["requested_session"]},
        "owner": {
            "thread_id": thread_id,
            "host_id": host_id,
            "source_handoff": "codex-thread:" + hashlib.sha256(f"{thread_id}:{transcript}".encode("utf-8")).hexdigest()[:32],
            "codex_cli_sha256": cli_digest,
        },
        "nonce": nonce,
        "issued_at": iso(issued),
        "expires_at": iso(issued + dt.timedelta(seconds=OWNER_ATTESTATION_TTL_SECONDS)),
    }
    signature = private.sign(_owner_canonical_json(body))
    body["signature_b64"] = base64.b64encode(signature).decode("ascii")
    return _owner_write_packet(body, nonce)


def _owner_consume_marker(packet: dict[str, Any]) -> None:
    os.makedirs(OWNER_ATTESTATION_CONSUMED_ROOT, mode=0o700, exist_ok=True)
    os.chmod(OWNER_ATTESTATION_CONSUMED_ROOT, 0o700)
    nonce = packet.get("nonce")
    marker = os.path.join(OWNER_ATTESTATION_CONSUMED_ROOT, f"{nonce}.json")
    payload = {"schema": "browser-use-owner-attestation-consumed.v1", "issuer_id": OWNER_ATTESTATION_ISSUER_ID, "nonce": nonce, "consumed_at": iso(now_utc()), "binding_digest": hashlib.sha256(_owner_canonical_json(packet["binding"])).hexdigest()}
    try:
        fd = os.open(marker, os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0), 0o600)
        try:
            os.write(fd, _owner_canonical_json(payload) + b"\n")
            os.fsync(fd)
        finally:
            os.close(fd)
    except FileExistsError as exc:
        raise Blocker("browser_use_owner_attestation_replay") from exc
    except OSError as exc:
        raise Blocker("browser_use_owner_attestation_replay_state_unavailable") from exc


def _validate_owner_attestation(packet_path: str, binding: dict[str, Any]) -> dict[str, str]:
    selected = os.path.realpath(os.path.abspath(packet_path))
    packet_root = os.path.realpath(os.path.join(OWNER_ATTESTATION_STATE_ROOT, "packets"))
    if not selected.startswith(packet_root + os.sep) or selected != os.path.abspath(packet_path):
        raise Blocker("browser_use_owner_attestation_path_invalid")
    assert_regular_file(selected, mode=0o600)
    try:
        fd = os.open(selected, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        try:
            stat_before = os.fstat(fd)
            raw = os.read(fd, OWNER_ATTESTATION_MAX_PACKET_BYTES + 1)
            stat_after = os.fstat(fd)
        finally:
            os.close(fd)
        if stat_before.st_ino != stat_after.st_ino or stat_before.st_dev != stat_after.st_dev or len(raw) > OWNER_ATTESTATION_MAX_PACKET_BYTES:
            raise ValueError("packet identity changed")
        packet = json.loads(raw.decode("utf-8"))
        if not isinstance(packet, dict) or set(packet) != {"schema", "issuer_id", "algorithm", "provider_path", "provider_sha256", "public_key_sha256", "binding", "owner", "nonce", "issued_at", "expires_at", "signature_b64"}:
            raise ValueError("packet schema")
        public = _owner_attestation_public_key()
        signature = base64.b64decode(packet["signature_b64"], validate=True)
        unsigned = dict(packet)
        unsigned.pop("signature_b64")
        public.verify(signature, _owner_canonical_json(unsigned))
        if packet["schema"] != OWNER_ATTESTATION_SCHEMA or packet["issuer_id"] != OWNER_ATTESTATION_ISSUER_ID or packet["algorithm"] != OWNER_ATTESTATION_ALGORITHM:
            raise ValueError("issuer")
        provider_path = _owner_provider_path()
        if packet["provider_path"] != provider_path or packet["provider_sha256"] != sha256_file(provider_path) or packet["public_key_sha256"] != OWNER_ATTESTATION_PUBLIC_KEY_SHA256:
            raise ValueError("provider trust")
        nonce = packet["nonce"]
        if not isinstance(nonce, str) or not re.fullmatch(r"[a-f0-9]{32}", nonce):
            raise ValueError("nonce")
        expires = dt.datetime.fromisoformat(str(packet["expires_at"]).replace("Z", "+00:00"))
        issued = dt.datetime.fromisoformat(str(packet["issued_at"]).replace("Z", "+00:00"))
        now = now_utc()
        if issued > now + dt.timedelta(seconds=OWNER_ATTESTATION_CLOCK_SKEW_SECONDS) or expires <= now or (expires - issued).total_seconds() > OWNER_ATTESTATION_TTL_SECONDS:
            raise ValueError("ttl")
        packet_binding = packet["binding"]
        if packet_binding != {**binding, "command_digest": _owner_command_digest(binding), "turn_id": packet_binding.get("turn_id"), "session_id": binding["requested_session"]}:
            raise ValueError("binding")
        owner = packet["owner"]
        if set(owner) != {"thread_id", "host_id", "source_handoff", "codex_cli_sha256"}:
            raise ValueError("owner")
        for key in ("thread_id", "host_id", "source_handoff"):
            _owner_safe_reference(owner[key], key)
        transcript = _owner_thread_transcript(owner["thread_id"])
        expected_host_id, expected_cli_digest = _owner_host_identity(owner["thread_id"], transcript)
        expected_source_handoff = "codex-thread:" + hashlib.sha256(f"{owner['thread_id']}:{transcript}".encode("utf-8")).hexdigest()[:32]
        if owner["host_id"] != expected_host_id or owner["source_handoff"] != expected_source_handoff or owner["codex_cli_sha256"] != expected_cli_digest:
            raise ValueError("owner runtime binding")
        if packet_binding["turn_id"] != _owner_expected_turn_id(owner["thread_id"], binding):
            raise ValueError("turn binding")
        _owner_consume_marker(packet)
        try:
            os.unlink(selected)
        except OSError as exc:
            raise Blocker("browser_use_owner_attestation_packet_cleanup_failed") from exc
        return {"thread_id": owner["thread_id"], "host_id": owner["host_id"], "source_handoff": owner["source_handoff"], "turn_id": packet_binding["turn_id"]}
    except Blocker:
        raise
    except Exception as exc:
        raise Blocker("browser_use_owner_attestation_invalid") from exc


def validate_record_start_owner_metadata(args: argparse.Namespace, *, binding: dict[str, Any] | None = None) -> dict[str, str]:
    """Require a signed owner packet and consume it before temporary launch.

    The legacy CLI/env fields are never authentication proof.  When no packet
    is supplied, the canonical helper issues one from the verified Codex
    transcript and official CLI identity, then immediately validates/consumes
    it.  This keeps normal continuation automatic without weakening the
    pre-launch boundary.
    """
    for field, env_name in OWNER_METADATA_ENV.items():
        if field != "thread_id" and (getattr(args, field, None) is not None or env_name in os.environ):
            raise Blocker("browser_use_owner_metadata_untrusted", field)
    if binding is None:
        raise Blocker("browser_use_owner_attestation_binding_required")
    packet_path = getattr(args, "owner_attestation", None)
    if packet_path:
        return _validate_owner_attestation(packet_path, binding)
    issued_path = _issue_owner_attestation(binding)
    try:
        return _validate_owner_attestation(issued_path, binding)
    finally:
        if os.path.exists(issued_path):
            try:
                os.unlink(issued_path)
            except OSError:
                pass


def session_aliases(config: dict[str, Any], requested: str, effective: str) -> list[str]:
    if requested == effective:
        return []
    if canonical_session_id(requested, config["roots"]["browser_use_home"]) != effective:
        raise Blocker("browser_use_session_binding_invalid")
    return [requested]


def lstat(path: str) -> os.stat_result:
    try:
        return os.lstat(path)
    except FileNotFoundError as exc:
        raise Blocker("browser_use_path_missing", path) from exc


def assert_regular_file(path: str, *, mode: int | None = None) -> os.stat_result:
    if not os.path.isabs(path) or os.path.realpath(path) != path:
        raise Blocker("browser_use_noncanonical_or_symlink_path", path)
    st = lstat(path)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        raise Blocker("browser_use_unsafe_file_type", path)
    if st.st_uid != EUID:
        raise Blocker("browser_use_file_owner_mismatch", path)
    if mode is not None and (st.st_mode & 0o777) != mode:
        raise Blocker("browser_use_file_mode_mismatch", path)
    return st


def assert_authority_file(path: str) -> str:
    """Admit one explicit authority path without collapsing a typo into a generic error.

    Authority files are security-bound inputs.  A missing path must therefore
    fail closed; it must never be silently replaced by a similarly named file.
    Descriptor/lease callers can avoid manual path entry by resolving their
    already-bound current authority before calling this helper.
    """
    if not isinstance(path, str) or not path or not os.path.isabs(path) or os.path.realpath(path) != path:
        raise Blocker("browser_use_authority_path_invalid")
    try:
        assert_regular_file(path, mode=0o600)
    except Blocker as exc:
        if exc.code == "browser_use_path_missing":
            raise Blocker("browser_use_authority_path_missing") from exc
        if exc.code == "browser_use_noncanonical_or_symlink_path":
            raise Blocker("browser_use_authority_path_invalid") from exc
        raise
    return path


def assert_directory(path: str, *, create: bool = False) -> None:
    if not os.path.isabs(path):
        raise Blocker("browser_use_nonabsolute_root", path)
    if not os.path.exists(path):
        if not create:
            raise Blocker("browser_use_root_missing", path)
        os.makedirs(path, mode=0o700, exist_ok=True)
    st = lstat(path)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        raise Blocker("browser_use_unsafe_root", path)
    if st.st_uid != EUID:
        raise Blocker("browser_use_root_owner_mismatch", path)
    os.chmod(path, 0o700)


def sha256_file(path: str) -> str:
    assert_regular_file(path)
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def build_audit_freshness(
    *,
    run_id: str | None,
    session: str | None,
    nonce: str | None = None,
    room_id: str | None = None,
    port: int | None = None,
    helper_sha256: str | None = None,
    generated_at: str | None = None,
) -> dict[str, Any]:
    """Bind an audit artifact to one run/resource observation.

    This is deliberately secret-free and does not claim that a local helper
    is published or synced to GitHub.  It only prevents a receipt from being
    mistaken for evidence from another run, session, room, or helper image.
    """
    payload = {
        "schema": AUDIT_FRESHNESS_SCHEMA,
        "run_id": run_id,
        "session": session,
        "nonce": nonce,
        "room_id": room_id,
        "port": port,
        "helper_sha256": helper_sha256,
        "generated_at": generated_at or iso(now_utc()),
    }
    binding = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return {**payload, "binding_hash": hashlib.sha256(binding).hexdigest()}


def sha256_trusted_executable(path: str) -> str:
    """Hash an installed executable after its bounded trust checks."""
    if not os.path.isabs(path) or os.path.realpath(path) != path:
        raise Blocker("browser_use_noncanonical_or_symlink_path", path)
    st = lstat(path)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        raise Blocker("browser_use_unsafe_file_type", path)
    if st.st_uid not in TRUSTED_EXECUTABLE_OWNER_UIDS:
        raise Blocker("browser_use_executable_owner_mismatch", path)
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def sha256_trusted_helper(path: str) -> str:
    """Hash the canonical helper only after its helper-specific mode check."""
    canonical = os.path.realpath(path)
    if not os.path.isabs(path) or canonical != path:
        raise Blocker("browser_use_recording_helper_canonical_path_invalid")
    st = lstat(canonical)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        raise Blocker("browser_use_recording_helper_file_type_invalid")
    if st.st_uid not in TRUSTED_EXECUTABLE_OWNER_UIDS:
        raise Blocker("browser_use_recording_helper_owner_mismatch")
    if (st.st_mode & 0o777) != 0o700:
        raise Blocker("browser_use_recording_helper_mode_mismatch")
    return sha256_file(canonical)


def canonical_helper_path() -> str:
    """Resolve this helper's file even when the module is loaded with ``python -c``."""
    argv_path = os.path.realpath(os.path.abspath(sys.argv[0]))
    if os.path.isfile(argv_path):
        return argv_path
    module_path = os.path.realpath(os.path.abspath(__file__))
    if os.path.isfile(module_path):
        return module_path
    return argv_path


def helper_snapshot_path(recording_dir: str) -> str:
    """Return the run-owned immutable helper path for a recording."""
    recording_root = os.path.realpath(recording_dir)
    if not os.path.isabs(recording_root) or os.path.realpath(recording_root) != recording_root:
        raise Blocker("browser_use_recording_dir_noncanonical")
    generation_dir = os.path.join(recording_root, ".helper-generation")
    return os.path.join(generation_dir, "codex-browser-use")


def helper_generation_snapshot_path(recording_dir: str, digest: str) -> str:
    """Return a new immutable path for an explicitly adopted helper generation."""
    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
        raise Blocker("browser_use_recording_helper_generation_digest_invalid")
    recording_root = os.path.realpath(recording_dir)
    if not os.path.isabs(recording_root) or os.path.realpath(recording_root) != recording_root:
        raise Blocker("browser_use_recording_dir_noncanonical")
    return os.path.join(recording_root, ".helper-generation", digest, "codex-browser-use")


def create_helper_snapshot(recording_dir: str, *, snapshot_path: str | None = None) -> tuple[str, str]:
    """Persist the exact helper generation that admitted a new recording.

    The snapshot is private to the run and is never replaced in-place. A
    later helper invocation may exec this snapshot when the installed helper
    changed, preserving one code generation for the whole recording.
    """
    source = canonical_helper_path()
    source_digest = sha256_trusted_helper(source)
    snapshot = os.path.realpath(snapshot_path or helper_snapshot_path(recording_dir))
    generation_dir = os.path.dirname(snapshot)
    recording_root = os.path.realpath(recording_dir)
    generation_root = os.path.join(recording_root, ".helper-generation")
    legacy_snapshot = helper_snapshot_path(recording_root)
    if snapshot != legacy_snapshot and not snapshot.startswith(generation_root + os.sep):
        raise Blocker("browser_use_recording_helper_snapshot_path_invalid")
    assert_directory(generation_dir, create=True)
    if os.path.lexists(snapshot):
        assert_regular_file(snapshot, mode=0o700)
        if sha256_file(snapshot) != source_digest:
            raise Blocker("browser_use_recording_helper_snapshot_conflict")
        return snapshot, source_digest
    temporary = os.path.join(generation_dir, f".codex-browser-use.{uuid.uuid4().hex}.tmp")
    fd = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o700)
    try:
        with open(source, "rb") as source_handle:
            while True:
                chunk = source_handle.read(1024 * 1024)
                if not chunk:
                    break
                offset = 0
                while offset < len(chunk):
                    written = os.write(fd, chunk[offset:])
                    if written <= 0:
                        raise OSError(errno.EIO, "helper snapshot write made no progress")
                    offset += written
        os.fsync(fd)
    finally:
        os.close(fd)
    try:
        os.chmod(temporary, 0o700)
        try:
            os.link(temporary, snapshot)
        except FileExistsError:
            os.unlink(temporary)
            assert_regular_file(snapshot, mode=0o700)
            if sha256_file(snapshot) != source_digest:
                raise Blocker("browser_use_recording_helper_snapshot_conflict")
            return snapshot, source_digest
        os.unlink(temporary)
        os.chmod(snapshot, 0o700)
    except Exception:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise
    assert_regular_file(snapshot, mode=0o700)
    if sha256_file(snapshot) != source_digest or sha256_trusted_helper(source) != source_digest:
        raise Blocker("browser_use_recording_helper_snapshot_digest_mismatch")
    return snapshot, source_digest


def validate_helper_snapshot(descriptor: dict[str, Any]) -> str | None:
    """Validate a run-pinned helper without accepting the current helper."""
    snapshot = descriptor.get("helper_snapshot_path")
    if snapshot is None:
        return None
    expected = helper_snapshot_path(descriptor["recording_dir"])
    recording_root = os.path.realpath(descriptor["recording_dir"])
    generation_root = os.path.join(recording_root, ".helper-generation")
    if not isinstance(snapshot, str) or os.path.realpath(snapshot) != snapshot or (
        snapshot != expected and not snapshot.startswith(generation_root + os.sep)
    ):
        raise Blocker("browser_use_recording_helper_snapshot_path_invalid")
    assert_regular_file(snapshot, mode=0o700)
    if sha256_file(snapshot) != descriptor.get("helper_sha256"):
        raise Blocker("browser_use_recording_helper_snapshot_digest_mismatch")
    if descriptor.get("helper_snapshot_owner_uid") is not None and descriptor["helper_snapshot_owner_uid"] != EUID:
        raise Blocker("browser_use_recording_helper_snapshot_owner_mismatch")
    if descriptor.get("helper_snapshot_mode") is not None and descriptor["helper_snapshot_mode"] != 0o700:
        raise Blocker("browser_use_recording_helper_snapshot_mode_mismatch")
    dependency_digest = descriptor.get("helper_dependency_digest")
    versions = descriptor.get("versions_hashes")
    if dependency_digest is not None:
        if not isinstance(versions, dict):
            raise Blocker("browser_use_recording_helper_dependency_identity_missing")
        expected = hashlib.sha256(json.dumps(versions, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
        if dependency_digest != expected:
            raise Blocker("browser_use_recording_helper_dependency_identity_mismatch")
    process = descriptor.get("process")
    if descriptor.get("helper_process_lineage_digest") is not None:
        if not isinstance(process, dict) or not isinstance(process.get("root_pid"), int) or not isinstance(process.get("root_start_time"), (int, float)):
            raise Blocker("browser_use_recording_helper_process_identity_missing")
        lineage = {
            "run_id": descriptor.get("run_id"),
            "session": descriptor.get("session"),
            "profile": descriptor.get("profile"),
            "port": descriptor.get("port"),
            "process": process,
            "helper_sha256": descriptor.get("helper_sha256"),
        }
        expected = hashlib.sha256(json.dumps(lineage, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
        if descriptor.get("helper_process_lineage_digest") != expected:
            raise Blocker("browser_use_recording_helper_process_identity_mismatch")
    return snapshot


def helper_process_lineage_digest(descriptor: dict[str, Any], helper_digest: str) -> str:
    """Bind a helper generation to the existing browser process identity."""
    process = descriptor.get("process")
    if not isinstance(process, dict) or not isinstance(process.get("root_pid"), int) or not isinstance(process.get("root_start_time"), (int, float)):
        raise Blocker("browser_use_recording_helper_process_identity_missing")
    lineage = {
        "run_id": descriptor.get("run_id"),
        "session": descriptor.get("session"),
        "profile": descriptor.get("profile"),
        "port": descriptor.get("port"),
        "process": process,
        "helper_sha256": helper_digest,
    }
    return hashlib.sha256(json.dumps(lineage, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def _sync_recording_room_helper_generation(config: dict[str, Any], descriptor: dict[str, Any], helper_digest: str) -> dict[str, Any] | None:
    """Keep the owner-bound room projection in the adopted descriptor generation."""
    room_id = descriptor.get("room_id")
    if not room_id:
        return None
    room = room_registry_lookup(config, str(room_id))
    if room is None:
        raise Blocker("browser_use_recording_helper_generation_room_missing")
    previous = str(room.get("helper_sha256") or "")
    if previous == helper_digest:
        return room
    return room_registry_adopt_helper_generation(
        config,
        str(room_id),
        run_id=str(descriptor["run_id"]),
        previous_helper_sha256=previous,
        helper_sha256=helper_digest,
        handoff_id=f"direct-refresh-{uuid.uuid4().hex}",
    )


def refresh_recording_helper_generation(config: dict[str, Any], descriptor: dict[str, Any], descriptor_path: str) -> dict[str, Any]:
    """Adopt the current canonical helper only after an explicit read-only request.

    The browser process, profile, port, locks, and pending operations remain
    unchanged.  The old snapshot is never replaced; a new digest-named
    snapshot is created and the descriptor is atomically updated only after
    the new generation has been verified.
    """
    current_helper = canonical_helper_path()
    current_digest = sha256_trusted_helper(current_helper)
    previous_digest = str(descriptor.get("helper_sha256") or "")
    if current_digest == previous_digest:
        # Older descriptors did not persist the per-recording generation on
        # initial start.  Repair that missing metadata only for a live
        # descriptor; finalized historical evidence keeps its original shape.
        generation = descriptor.get("helper_generation")
        if descriptor.get("status") in {"active", "continued"} and generation is None:
            repaired = dict(descriptor)
            repaired.update({
                "helper_generation": 1,
                "helper_generation_repaired_at": iso(now_utc()),
                "helper_generation_repair": "same-digest-live-entrypoint-sync",
            })
            _write_recording_descriptor(config, os.path.realpath(descriptor_path), repaired, replace=True)
            descriptor = repaired
        _sync_recording_room_helper_generation(config, descriptor, current_digest)
        return descriptor
    snapshot = helper_generation_snapshot_path(descriptor["recording_dir"], current_digest)
    snapshot_path, verified_digest = create_helper_snapshot(descriptor["recording_dir"], snapshot_path=snapshot)
    if verified_digest != current_digest:
        raise Blocker("browser_use_recording_helper_generation_digest_mismatch")
    refreshed = dict(descriptor)
    generation = refreshed.get("helper_generation", 1)
    if isinstance(generation, bool) or not isinstance(generation, int) or generation < 1:
        raise Blocker("browser_use_recording_helper_generation_invalid")
    refreshed.update({
        "helper_sha256": verified_digest,
        "helper_snapshot_path": snapshot_path,
        "helper_snapshot_owner_uid": EUID,
        "helper_snapshot_mode": 0o700,
        "helper_process_lineage_digest": helper_process_lineage_digest(refreshed, verified_digest),
        "helper_generation": generation + 1,
        "helper_refresh": {
            "previous_helper_sha256": previous_digest,
            "helper_sha256": verified_digest,
            "recorded_at": iso(now_utc()),
            "read_only": True,
        },
        "navigation_verified": False,
        "navigation_readback_operation_id": None,
        "navigation_readback_lineage_digest": None,
        "navigation_readback_helper_sha256": None,
    })
    try:
        _write_recording_descriptor(config, os.path.realpath(descriptor_path), refreshed, replace=True)
        adopted = read_recording_descriptor(
            config,
            os.path.realpath(descriptor_path),
            str(refreshed["run_id"]),
            str(refreshed["session"]),
            allow_helper_hash_mismatch=False,
            allow_pinned_helper_reexec=False,
        )
        _sync_recording_room_helper_generation(config, adopted, verified_digest)
        return adopted
    except Exception:
        # The old descriptor and snapshot remain authoritative if adoption
        # cannot be proven.  The new digest-named snapshot is harmless and is
        # intentionally left as run-owned evidence rather than touching the
        # active browser resources.
        raise


def ensure_current_helper_generation(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    descriptor_path: str,
    *,
    allow_historical: bool = False,
) -> dict[str, Any]:
    """Automatically align a live run before any continuation command.

    This is a no-page-command admission step.  A live owner-bound room may
    adopt the current canonical helper without a user-supplied refresh flag.
    Historical descriptors remain pinned to the helper that produced their
    evidence; callers can request a latest-generation projection separately.
    """
    current_digest = sha256_trusted_helper(canonical_helper_path())
    previous_digest = str(descriptor.get("helper_sha256") or "")
    status = descriptor.get("status")
    if current_digest == previous_digest:
        if status in {"active", "continued"} and descriptor.get("helper_generation") is None:
            return refresh_recording_helper_generation(config, descriptor, descriptor_path)
        room_id = descriptor.get("room_id")
        if room_id and status in {"active", "continued"}:
            room = room_registry_lookup(config, str(room_id))
            if room is None:
                raise Blocker("browser_use_recording_helper_generation_room_missing")
            if room.get("state") in ROOM_REGISTRY_ACTIVE_STATES and room.get("helper_sha256") != current_digest:
                if not _live_room_readback_confirmed(config, str(room_id)):
                    raise Blocker("browser_use_helper_generation_auto_sync_readback_required")
                return refresh_recording_helper_generation(config, descriptor, descriptor_path)
        return descriptor
    if status in {"active", "continued"}:
        room_id = descriptor.get("room_id")
        room = room_registry_lookup(config, str(room_id)) if room_id else None
        if isinstance(room, dict) and room.get("state") in ROOM_REGISTRY_ACTIVE_STATES:
            if not _live_room_readback_confirmed(config, str(room_id)):
                raise Blocker("browser_use_helper_generation_auto_sync_readback_required")
            return refresh_recording_helper_generation(config, descriptor, descriptor_path)
        if allow_historical:
            return descriptor
        raise Blocker("browser_use_recording_helper_generation_auto_sync_requires_live_room")
    if allow_historical:
        return descriptor
    raise Blocker("browser_use_recording_helper_generation_mismatch")


def read_toml() -> dict[str, Any]:
    assert_regular_file(CONFIG_PATH, mode=0o600)
    with open(CONFIG_PATH, "rb") as handle:
        config = tomllib.load(handle)
    if config.get("schema") != "browser-use-runtime.v1":
        raise Blocker("browser_use_runtime_schema_mismatch")
    return config


def executable_version(path: str, kind: str) -> str:
    if kind == "browser_use":
        try:
            return importlib.metadata.version("browser-use")
        except importlib.metadata.PackageNotFoundError as exc:
            raise Blocker("browser_use_package_version_unavailable") from exc
    if kind == "python":
        return sys.version.split()[0]
    if kind == "chrome":
        # On macOS, launching the Chrome executable with --version while an
        # existing Chrome instance owns the app singleton can block instead of
        # returning. Read the signed app bundle metadata without starting or
        # attaching to a browser process.
        bundle_info = pathlib.Path(path).resolve().parents[1] / "Info.plist"
        try:
            with bundle_info.open("rb") as handle:
                value = plistlib.load(handle).get("CFBundleShortVersionString")
            match = re.fullmatch(r"\d+\.\d+(?:\.\d+){1,2}", str(value or ""))
            if match:
                return match.group(0)
        except (OSError, plistlib.InvalidFileException, ValueError, TypeError):
            # Fall through to the bounded executable probe so the failure is
            # still classified as an installation validation blocker.
            pass
    try:
        result = subprocess.run([path, "--version"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
    except subprocess.TimeoutExpired as exc:
        raise Blocker("browser_use_executable_version_timeout", kind) from exc
    except OSError as exc:
        raise Blocker("browser_use_executable_version_unavailable", kind) from exc
    output = (result.stdout + " " + result.stderr).strip()
    match = re.search(r"(\d+\.\d+(?:\.\d+){1,2})", output)
    # ffmpeg/ffprobe print a valid version banner but return a non-zero
    # status when no media input is supplied.  The banner is sufficient for
    # the pinned executable/hash check; other executables remain strict.
    if (result.returncode != 0 and kind not in {"ffmpeg", "ffprobe"}) or not match:
        raise Blocker("browser_use_executable_version_unavailable", kind)
    return match.group(1)


def validate_executable(spec: dict[str, Any], kind: str) -> dict[str, str]:
    path = spec["path"]
    canonical = spec["canonical_path"]
    if not os.path.isabs(path) or not os.path.isabs(canonical) or os.path.realpath(path) != canonical:
        raise Blocker("browser_use_executable_canonical_path_mismatch", kind)
    st = lstat(path)
    if stat.S_ISLNK(st.st_mode):
        raise Blocker("browser_use_executable_symlink_mismatch", kind)
    if not stat.S_ISREG(os.stat(canonical).st_mode):
        raise Blocker("browser_use_executable_not_regular", kind)
    canonical_st = os.stat(canonical)
    if canonical_st.st_uid not in TRUSTED_EXECUTABLE_OWNER_UIDS:
        raise Blocker("browser_use_executable_owner_mismatch", kind)
    expected_mode = int(spec["mode"], 8)
    if (canonical_st.st_mode & 0o777) != expected_mode:
        raise Blocker("browser_use_executable_mode_mismatch", kind)
    digest = sha256_trusted_executable(canonical)
    if digest != spec["sha256"]:
        raise Blocker("browser_use_executable_hash_mismatch", kind)
    version = executable_version(canonical, kind)
    if version != spec["version"]:
        raise Blocker("browser_use_executable_version_mismatch", kind)
    return {"path": path, "canonical_path": canonical, "version": version, "sha256": digest}


def validate_installation(config: dict[str, Any]) -> dict[str, Any]:
    executables = config["executables"]
    # Keep the ordinary Browser Use lane independent from optional recording
    # tooling.  Recording commands validate ffmpeg/ffprobe explicitly below.
    required = ("browser_use", "chrome", "python")
    versions = {kind: validate_executable(executables[kind], kind) for kind in required}
    roots = config["roots"]
    validate_runtime_lifecycle_config(config)
    for path in roots.values():
        assert_directory(path, create=True)
    ports = config["ports"]
    if ports["scheduled_end"] - ports["scheduled_start"] + 1 != config["ports"]["max_parallel"]:
        raise Blocker("browser_use_scheduled_port_range_parallel_mismatch")
    if ports["single_use_end"] - ports["single_use_start"] + 1 != config["ports"]["max_parallel"]:
        raise Blocker("browser_use_single_use_port_range_parallel_mismatch")
    if psutil is None:
        raise Blocker("browser_use_psutil_unavailable")
    return versions


def runtime_readback(config: dict[str, Any]) -> int:
    """Read expected/current executable identity without launching Browser Use."""
    rows: list[dict[str, Any]] = []
    for kind in ("browser_use", "chrome", "python"):
        spec = (config.get("executables") or {}).get(kind)
        if not isinstance(spec, dict):
            rows.append({"kind": kind, "status": "mismatch", "exact_blocker": "browser_use_executable_spec_missing"})
            continue
        expected = {
            "path": spec.get("path"),
            "canonical_path": spec.get("canonical_path"),
            "version": spec.get("version"),
            "sha256": spec.get("sha256"),
            "mode": spec.get("mode"),
        }
        actual: dict[str, Any] = {"path": spec.get("canonical_path")}
        blocker: str | None = None
        try:
            canonical = spec.get("canonical_path")
            if not isinstance(canonical, str) or not os.path.isabs(canonical):
                raise Blocker("browser_use_executable_canonical_path_mismatch", kind)
            st = os.stat(canonical)
            actual.update({"canonical_path": os.path.realpath(canonical), "mode": format(st.st_mode & 0o777, "04o"), "owner_uid": st.st_uid})
            actual["sha256"] = sha256_trusted_executable(canonical)
            actual["version"] = executable_version(canonical, kind)
            validate_executable(spec, kind)
        except Blocker as exc:
            blocker = exc.code
        except (OSError, ValueError, TypeError) as exc:
            blocker = "browser_use_executable_readback_failed"
            actual["error_type"] = type(exc).__name__
        rows.append({"kind": kind, "status": "match" if blocker is None else "mismatch", "expected": expected, "actual": actual, "exact_blocker": blocker})
    drift = any(row.get("status") == "mismatch" for row in rows)
    print(json.dumps({
        "status": "completed",
        "inspection_status": "completed",
        "inspection_succeeded": True,
        "launch": False,
        "runtime_drift": drift,
        "exact_blocker": next((row.get("exact_blocker") for row in rows if row.get("exact_blocker")), None),
        "executables": rows,
        "finalized": False,
    }, sort_keys=True))
    return 0


def validate_runtime_lifecycle_config(config: dict[str, Any]) -> None:
    """Validate lifecycle roots, non-overlapping ranges, and fixed temporary TTL."""
    roots = config.get("roots") or {}
    temporary_root = roots.get("temporary_profiles")
    if temporary_root != TEMPORARY_PROFILE_ROOT or os.path.realpath(temporary_root) != TEMPORARY_PROFILE_ROOT:
        raise Blocker("browser_use_temporary_profile_root_invalid")
    ports = config.get("ports") or {}
    ranges = {
        "scheduled": (ports.get("scheduled_start"), ports.get("scheduled_end")),
        "single-use": (ports.get("single_use_start"), ports.get("single_use_end")),
        TEMPORARY_LIFECYCLE: (ports.get("temporary_start"), ports.get("temporary_end")),
    }
    normalized: dict[str, tuple[int, int]] = {}
    for lifecycle, pair in ranges.items():
        start, end = pair
        if not isinstance(start, int) or not isinstance(end, int) or start <= 0 or end < start:
            raise Blocker("browser_use_port_range_invalid", lifecycle)
        if lifecycle == TEMPORARY_LIFECYCLE and (start, end) != TEMPORARY_PORT_RANGE:
            raise Blocker("browser_use_temporary_port_range_invalid")
        if end - start + 1 != int(ports.get("max_parallel", 0)):
            raise Blocker("browser_use_port_range_parallel_mismatch", lifecycle)
        normalized[lifecycle] = (start, end)
    names = list(normalized)
    for index, left in enumerate(names):
        for right in names[index + 1:]:
            left_start, left_end = normalized[left]
            right_start, right_end = normalized[right]
            if max(left_start, right_start) <= min(left_end, right_end):
                raise Blocker("browser_use_port_ranges_overlap", f"{left}:{right}")
    ttl = ((config.get("limits") or {}).get("temporary_ttl_seconds"))
    if ttl != TEMPORARY_TTL_SECONDS:
        raise Blocker("browser_use_temporary_ttl_invalid")


def configure_logging(log_root: str) -> None:
    path = os.path.join(log_root, "critical.log")
    if not os.path.exists(path):
        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.close(fd)
    assert_regular_file(path, mode=0o600)
    logging.basicConfig(filename=path, level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")


def validate_recording_runtime(config: dict[str, Any]) -> dict[str, Any]:
    recording = config.get("recording")
    if not isinstance(recording, dict):
        raise Blocker("browser_use_recording_runtime_missing")
    runtime_dir = recording.get("runtime_dir")
    dependencies_dir = recording.get("dependencies_dir")
    site_packages_dir = recording.get("site_packages_dir")
    if not isinstance(runtime_dir, str) or not isinstance(dependencies_dir, str) or not isinstance(site_packages_dir, str):
        raise Blocker("browser_use_recording_runtime_invalid")
    assert_directory(runtime_dir)
    assert_directory(dependencies_dir)
    assert_directory(site_packages_dir)
    assert_regular_file(os.path.join(runtime_dir, "sitecustomize.py"), mode=0o600)
    try:
        framerate = int(recording.get("default_framerate", 12))
        max_commands = int(recording.get("max_commands", 128))
    except (TypeError, ValueError) as exc:
        raise Blocker("browser_use_recording_runtime_invalid") from exc
    if not 1 <= framerate <= 60 or not 1 <= max_commands <= 512:
        raise Blocker("browser_use_recording_runtime_invalid")
    return {"runtime_dir": runtime_dir, "dependencies_dir": dependencies_dir, "site_packages_dir": site_packages_dir, "default_framerate": framerate, "max_commands": max_commands}


def validate_recording_tools(config: dict[str, Any]) -> dict[str, str]:
    executables = config.get("executables") or {}
    tools: dict[str, str] = {}
    for kind in ("ffprobe", "ffmpeg"):
        spec = executables.get(kind)
        if not isinstance(spec, dict):
            raise Blocker("browser_use_recording_tool_missing", kind)
        tools[kind] = validate_executable(spec, kind)["canonical_path"]
    return tools


def validate_recording_output_dir(path: str) -> str:
    if not isinstance(path, str) or not os.path.isabs(path) or os.path.realpath(path) != path:
        raise Blocker("browser_use_recording_dir_noncanonical")
    parent = os.path.dirname(path)
    assert_directory(parent)
    if os.path.lexists(path):
        assert_directory(path)
        if any(pathlib.Path(path).iterdir()):
            raise Blocker("browser_use_recording_dir_not_empty")
    else:
        os.mkdir(path, 0o700)
    assert_directory(path)
    return path


def recording_status_path(recording_dir: str) -> str:
    return os.path.join(recording_dir, ".recording-status.json")


def recording_manifest_path(recording_dir: str) -> str:
    return os.path.join(recording_dir, "browser-use-recording-manifest.json")


def recording_cleanup_receipt_path(config: dict[str, Any], descriptor: dict[str, Any]) -> str:
    """Return the immutable receipt path for stale-recording cleanup."""
    run_id = safe_id(str(descriptor["run_id"]), "run_id")
    session = safe_id(str(descriptor["session"]), "session")
    nonce = safe_id(str(descriptor["nonce"]), "nonce")
    run_root = os.path.join(config["roots"]["receipts"], run_id)
    return os.path.join(run_root, f"{session}-{nonce}-cleanup.json")


def recording_cleanup_capability_path(recording_dir: str) -> str:
    recording_dir = os.path.realpath(str(recording_dir))
    if not os.path.isabs(recording_dir) or os.path.realpath(recording_dir) != recording_dir:
        raise Blocker("browser_use_recording_cleanup_capability_scope_invalid")
    return os.path.join(recording_dir, ".recording-cleanup-capability.json")


def recording_cleanup_capability_binding_digest(value: dict[str, Any]) -> str:
    binding = {
        key: value.get(key)
        for key in ("schema", "version", "run_id", "requested_session", "session", "mode", "lifecycle", "automation_id", "task_id", "nonce", "recording_dir", "authority_sha256", "authority_scope")
    }
    return hashlib.sha256(json.dumps(binding, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def write_recording_cleanup_capability(
    recording_dir: str,
    *,
    run_id: str,
    requested_session: str,
    session: str,
    mode: str,
    lifecycle: str,
    automation_id: str,
    task_id: str | None,
    nonce: str,
    authority: dict[str, Any] | None,
    authority_digest: str | None,
) -> tuple[str, str]:
    """Persist a narrow owner-bound terminal cleanup capability before mutation.

    This artifact intentionally contains authority scope metadata only.  It is
    not a copy of the caller's authority file and never carries credentials,
    cookies, tokens, or page data.  Cleanup can validate this capability
    directly, so it does not need to rebuild authority from a digest.
    """
    path = recording_cleanup_capability_path(recording_dir)
    payload = {
        "schema": RECORDING_CLEANUP_CAPABILITY_SCHEMA,
        "version": 1,
        "run_id": safe_id(run_id, "run_id"),
        "requested_session": validate_id(requested_session, "session"),
        "session": validate_id(session, "session"),
        "mode": mode,
        "lifecycle": lifecycle,
        "automation_id": safe_id(automation_id, "automation_id"),
        "task_id": safe_id(task_id, "task_id") if task_id else None,
        "nonce": safe_id(nonce, "nonce"),
        "recording_dir": os.path.realpath(recording_dir),
        "authority_sha256": authority_digest,
        "authority_scope": {
            "account_identity": authority.get("account_identity") if authority else "public",
            "allowed_origins": sorted({normalize_origin(item) for item in (authority or {}).get("allowed_origins", [])}),
            "data_exposure": authority.get("data_exposure") if authority else "public_read_only",
            "side_effect_scope": authority.get("side_effect_scope") if authority else "none",
            "approval": authority.get("approval") if authority else "not_required",
            "readback_required": authority.get("readback_required", True) if authority else True,
            "expires_at": authority.get("expires_at") if authority else None,
            "authority_lineage_expires_at": authority.get("authority_lineage_expires_at") if authority else None,
        },
        "phase": lifecycle_phase(observed=True),
        "cleanup_phase": lifecycle_phase(),
        "exact_blocker": None,
        "updated_at": iso(now_utc()),
    }
    payload["binding_sha256"] = recording_cleanup_capability_binding_digest(payload)
    assert_directory(recording_dir)
    if os.path.lexists(path):
        existing = read_json_safe(path)
        for key in ("schema", "run_id", "requested_session", "session", "mode", "lifecycle", "automation_id", "task_id", "nonce", "recording_dir", "authority_sha256"):
            if existing.get(key) != payload.get(key):
                raise Blocker("browser_use_recording_cleanup_capability_binding_mismatch")
        if existing.get("binding_sha256") != recording_cleanup_capability_binding_digest(existing):
            raise Blocker("browser_use_recording_cleanup_capability_changed")
        return path, str(existing["binding_sha256"])
    json_atomic_no_replace(path, payload)
    return path, str(payload["binding_sha256"])


def update_recording_cleanup_capability(
    path: str,
    *,
    expected_run_id: str,
    expected_session: str,
    expected_nonce: str,
    cleanup_phase: dict[str, Any],
    phase: dict[str, Any] | None = None,
    exact_blocker: str | None = None,
    resource_binding: dict[str, Any] | None = None,
) -> str:
    """Atomically advance the run-owned cleanup capability phase."""
    path = os.path.realpath(str(path))
    value = read_json_safe(path)
    if value.get("schema") != RECORDING_CLEANUP_CAPABILITY_SCHEMA or value.get("run_id") != expected_run_id or value.get("session") != expected_session or value.get("nonce") != expected_nonce:
        raise Blocker("browser_use_recording_cleanup_capability_binding_mismatch")
    updated = dict(value)
    updated["cleanup_phase"] = dict(cleanup_phase)
    if phase is not None:
        updated["phase"] = dict(phase)
    updated["exact_blocker"] = str(exact_blocker)[:160] if exact_blocker else None
    if resource_binding is not None:
        # Keep only bounded owner/resource identity; never persist raw command
        # output or authority material in this recovery artifact.
        updated["resource_binding"] = {
            key: resource_binding[key]
            for key in ("room_id", "port", "profile")
            if key in resource_binding and resource_binding[key] is not None
        }
    updated["updated_at"] = iso(now_utc())
    json_atomic_replace(path, updated)
    if updated.get("binding_sha256") != recording_cleanup_capability_binding_digest(updated):
        raise Blocker("browser_use_recording_cleanup_capability_changed")
    return str(updated["binding_sha256"])


def read_recording_cleanup_capability(config: dict[str, Any], descriptor: dict[str, Any]) -> dict[str, Any]:
    """Read and bind the local cleanup capability without authority rehydration."""
    recording_dir = os.path.realpath(str(descriptor.get("recording_dir") or ""))
    path = os.path.realpath(str(descriptor.get("cleanup_capability_path") or ""))
    if path != recording_cleanup_capability_path(recording_dir):
        raise Blocker("browser_use_recording_cleanup_capability_scope_invalid")
    value = read_json_safe(path)
    if value.get("schema") != RECORDING_CLEANUP_CAPABILITY_SCHEMA or value.get("run_id") != descriptor.get("run_id") or value.get("session") != descriptor.get("session") or value.get("nonce") != descriptor.get("nonce"):
        raise Blocker("browser_use_recording_cleanup_capability_binding_mismatch")
    for key in ("requested_session", "mode", "lifecycle", "automation_id", "task_id"):
        if value.get(key) != descriptor.get(key):
            raise Blocker("browser_use_recording_cleanup_capability_owner_mismatch")
    if value.get("recording_dir") != recording_dir:
        raise Blocker("browser_use_recording_cleanup_capability_binding_mismatch")
    expected_digest = descriptor.get("cleanup_capability_sha256")
    if expected_digest and value.get("binding_sha256") != expected_digest:
        raise Blocker("browser_use_recording_cleanup_capability_changed")
    if value.get("binding_sha256") != recording_cleanup_capability_binding_digest(value):
        raise Blocker("browser_use_recording_cleanup_capability_changed")
    scope = value.get("authority_scope")
    if not isinstance(scope, dict) or not isinstance(scope.get("allowed_origins"), list):
        raise Blocker("browser_use_recording_cleanup_capability_invalid")
    return value


def write_recording_manifest(path: str, manifest: dict[str, Any]) -> None:
    try:
        json_atomic_no_replace(path, manifest)
    except Blocker as exc:
        if exc.code != "browser_use_receipt_already_exists":
            raise
        existing = read_json_safe(path)
        expected_video = (manifest.get("video") or {}).get("sha256")
        actual_video = (existing.get("video") or {}).get("sha256")
        if existing.get("schema") != RECORDING_SCHEMA or existing.get("status") not in {"completed", "blocked"} or existing.get("run_id") != manifest.get("run_id") or existing.get("session") != manifest.get("session") or actual_video != expected_video:
            raise Blocker("browser_use_recording_manifest_binding_mismatch")
        # Same run/video: atomically refresh derived evidence such as the
        # representative frame selected from the finalized stream.
        json_atomic_replace(path, manifest)


def recording_descriptor_root(config: dict[str, Any]) -> str:
    root = config["roots"]["recordings"]
    assert_directory(root, create=True)
    return root


def assert_recording_descriptor_path(config: dict[str, Any], path: str) -> None:
    root = os.path.realpath(recording_descriptor_root(config))
    if not os.path.isabs(path) or os.path.realpath(path) != path or not path.startswith(root + os.sep):
        raise Blocker("browser_use_recording_descriptor_scope_mismatch")
    if not path.endswith(".json"):
        raise Blocker("browser_use_recording_descriptor_path_invalid")


def recording_env(
    config: dict[str, Any],
    recording_dir: str,
    status_path: str,
    framerate: int,
    *,
    run_id: str | None = None,
    session: str | None = None,
) -> dict[str, Any]:
    runtime = validate_recording_runtime(config)
    value = {
        "runtime_dir": runtime["runtime_dir"],
        "dependencies_dir": runtime["dependencies_dir"],
        "site_packages_dir": runtime["site_packages_dir"],
        "recording_dir": recording_dir,
        "status_path": status_path,
        "framerate": framerate,
    }
    if browser_harness_cli_enabled():
        parent = pathlib.Path(recording_dir).parent
        if parent.name != "recordings":
            raise Blocker("browser_use_recording_dir_not_harness_scoped")
        value.update({
            "harness_workspace": str(parent.parent),
            "recording_name": pathlib.Path(recording_dir).name,
            "recording_source_dir": recording_dir,
            "tab_inventory_path": os.path.join(recording_dir, "tab-inventory.json"),
        })
    if run_id is not None:
        value["run_id"] = run_id
    if session is not None:
        value["session"] = session
    return value


TAB_INVENTORY_SCHEMA = "browser-use-recording-tabs.v1"
TAB_INVENTORY_ROLES = {"working", "baseline", "auxiliary"}
TAB_INVENTORY_MAX_AUXILIARY = 16


def _validate_recording_tab_inventory_value(value: dict[str, Any]) -> dict[str, Any]:
    """Validate recording tab identity metadata without reading page content."""
    required = {"schema", "working_target_id", "tabs", "baseline_target_ids", "auxiliary_target_ids"}
    if value.get("schema") != TAB_INVENTORY_SCHEMA or not required.issubset(value):
        raise Blocker("browser_use_recording_tab_inventory_invalid")
    if not isinstance(value["working_target_id"], str) or not value["working_target_id"]:
        raise Blocker("browser_use_recording_tab_inventory_working_tab_invalid")
    if not isinstance(value["tabs"], list):
        raise Blocker("browser_use_recording_tab_inventory_tabs_invalid")
    for tab in value["tabs"]:
        if not isinstance(tab, dict):
            raise Blocker("browser_use_recording_tab_inventory_tab_invalid")
        allowed = {"target_id", "role", "url_length", "url_sha256", "title_length", "title_sha256"}
        if set(tab) != allowed or tab.get("role") not in TAB_INVENTORY_ROLES:
            raise Blocker("browser_use_recording_tab_inventory_tab_metadata_invalid")
        if not isinstance(tab.get("target_id"), str) or not tab["target_id"] or len(tab["target_id"]) > 256:
            raise Blocker("browser_use_recording_tab_inventory_target_id_invalid")
        if not isinstance(tab.get("url_length"), int) or tab["url_length"] < 0:
            raise Blocker("browser_use_recording_tab_inventory_url_metadata_invalid")
        if not isinstance(tab.get("title_length"), int) or tab["title_length"] < 0:
            raise Blocker("browser_use_recording_tab_inventory_title_metadata_invalid")
        for field in ("url_sha256", "title_sha256"):
            if not isinstance(tab.get(field), str) or not re.fullmatch(r"[0-9a-f]{64}", tab[field]):
                raise Blocker("browser_use_recording_tab_inventory_hash_invalid", field)
    target_ids = {tab["target_id"] for tab in value["tabs"]}
    if value["working_target_id"] not in target_ids:
        raise Blocker("browser_use_recording_tab_inventory_working_tab_missing")
    if not isinstance(value["baseline_target_ids"], list) or not all(isinstance(item, str) for item in value["baseline_target_ids"]):
        raise Blocker("browser_use_recording_tab_inventory_baseline_invalid")
    if not isinstance(value["auxiliary_target_ids"], list) or not all(isinstance(item, str) for item in value["auxiliary_target_ids"]):
        raise Blocker("browser_use_recording_tab_inventory_auxiliary_invalid")
    if len(value["auxiliary_target_ids"]) > TAB_INVENTORY_MAX_AUXILIARY:
        raise Blocker("browser_use_recording_auxiliary_tab_limit_exceeded")
    value.setdefault("active_target_id", value["working_target_id"])
    if not isinstance(value["active_target_id"], str) or not value["active_target_id"]:
        raise Blocker("browser_use_recording_tab_inventory_active_tab_invalid")
    tab_ids = [tab["target_id"] for tab in value["tabs"]]
    if len(tab_ids) != len(set(tab_ids)):
        raise Blocker("browser_use_recording_tab_inventory_duplicate_target_id")
    baseline_ids = list(value["baseline_target_ids"])
    auxiliary_ids = list(value["auxiliary_target_ids"])
    if len(baseline_ids) != len(set(baseline_ids)) or len(auxiliary_ids) != len(set(auxiliary_ids)):
        raise Blocker("browser_use_recording_tab_inventory_duplicate_role_id")
    if set(baseline_ids) & set(auxiliary_ids) or value["working_target_id"] in set(baseline_ids) | set(auxiliary_ids):
        raise Blocker("browser_use_recording_tab_inventory_role_overlap")
    roles = {tab["target_id"]: tab["role"] for tab in value["tabs"]}
    expected_baseline = {target_id for target_id, role in roles.items() if role == "baseline"}
    expected_auxiliary = {target_id for target_id, role in roles.items() if role == "auxiliary"}
    if roles.get(value["working_target_id"]) != "working":
        raise Blocker("browser_use_recording_tab_inventory_working_role_invalid")
    if set(baseline_ids) != expected_baseline or set(auxiliary_ids) != expected_auxiliary:
        raise Blocker("browser_use_recording_tab_inventory_role_index_mismatch")
    if value["active_target_id"] not in roles or roles[value["active_target_id"]] == "baseline":
        raise Blocker("browser_use_recording_tab_inventory_active_role_invalid")
    return value


def read_recording_tab_inventory(path: str) -> dict[str, Any]:
    """Read only the recording tab identity metadata; never page content."""
    return _validate_recording_tab_inventory_value(read_json_safe(path))


def read_recording_tab_inventory_for_terminal_cleanup(path: str) -> dict[str, Any]:
    """Repair only closed auxiliary IDs while finalizing a dead run.

    Active recording commands remain strict.  A terminal cleanup may see an
    older inventory whose auxiliary index still contains a tab that has
    already disappeared.  That is safe to normalize only when the tab list
    still contains every live auxiliary tab, the working/baseline roles are
    exact, and the normal validator accepts the normalized value.
    """
    value = read_json_safe(path)
    try:
        return _validate_recording_tab_inventory_value(value)
    except Blocker as exc:
        if exc.code != "browser_use_recording_tab_inventory_role_index_mismatch":
            raise
    if (
        value.get("schema") != TAB_INVENTORY_SCHEMA
        or not isinstance(value.get("tabs"), list)
        or not isinstance(value.get("working_target_id"), str)
        or not isinstance(value.get("baseline_target_ids"), list)
        or not isinstance(value.get("auxiliary_target_ids"), list)
    ):
        raise Blocker("browser_use_recording_tab_inventory_role_index_mismatch")
    tabs = value["tabs"]
    tab_ids = {tab.get("target_id") for tab in tabs if isinstance(tab, dict)}
    roles = {tab.get("target_id"): tab.get("role") for tab in tabs if isinstance(tab, dict)}
    working_id = value["working_target_id"]
    baseline_ids = value["baseline_target_ids"]
    auxiliary_ids = value["auxiliary_target_ids"]
    if (
        not tab_ids
        or working_id not in tab_ids
        or roles.get(working_id) != "working"
        or len(baseline_ids) != len(set(baseline_ids))
        or len(auxiliary_ids) != len(set(auxiliary_ids))
        or set(baseline_ids) & set(auxiliary_ids)
        or working_id in set(baseline_ids) | set(auxiliary_ids)
    ):
        raise Blocker("browser_use_recording_tab_inventory_role_index_mismatch")
    expected_baseline = {target_id for target_id, role in roles.items() if role == "baseline"}
    expected_auxiliary = {target_id for target_id, role in roles.items() if role == "auxiliary"}
    if set(baseline_ids) != expected_baseline or not expected_auxiliary.issubset(set(auxiliary_ids)):
        raise Blocker("browser_use_recording_tab_inventory_role_index_mismatch")
    stale_auxiliary_ids = set(auxiliary_ids) - tab_ids
    if not stale_auxiliary_ids:
        raise Blocker("browser_use_recording_tab_inventory_role_index_mismatch")
    normalized = dict(value)
    normalized["auxiliary_target_ids"] = [target_id for target_id in auxiliary_ids if target_id in tab_ids]
    return _validate_recording_tab_inventory_value(normalized)


def write_harness_recording_status(
    path: str,
    recording: dict[str, Any],
    *,
    active: bool,
    finalized: bool,
    media_finalized: bool | None = None,
    state: str | None = None,
    reason: str | None = None,
) -> None:
    """Persist the helper-owned status contract for Browser Harness recordings."""
    source = pathlib.Path(recording["recording_source_dir"])
    frames = sorted(p for p in source.glob("*.jpg") if p.stem.isdigit()) if source.is_dir() else []
    existing: dict[str, Any] = {}
    if os.path.lexists(path):
        existing = read_json_safe(path)
    value = {
        "schema": RECORDING_STATUS_SCHEMA,
        "recorder_configured": True,
        "recorder_active": active,
        "finalized": finalized,
        "recording_dir": str(source),
        "recording_backend": "browser-harness",
        "frame_count": len(frames),
    }
    # Bind newly-written status to the descriptor's run/session. Later
    # lifecycle writes rebuild the recording environment with fewer fields, so
    # preserve an existing binding instead of dropping provenance.
    for field in ("run_id", "session"):
        bound = recording.get(field) or existing.get(field)
        if bound is not None:
            value[field] = bound
    if media_finalized is not None:
        value["media_finalized"] = media_finalized
    if state is not None:
        value["state"] = state
        value["durable_state"] = state
    if reason is not None:
        value["state_reason"] = str(reason)[:160]
        value["state_updated_at"] = iso(now_utc())
    if os.path.lexists(path):
        json_atomic_replace(path, value)
    else:
        json_atomic_no_replace(path, value)


def next_recording_frame_paths(source_dir: str) -> tuple[str, str]:
    """Allocate one run-owned frame path and a unique temporary capture path.

    The recorder command lease prevents concurrent allocations for one
    descriptor, but a prior interrupted screenshot can leave its temporary
    ``.capture`` file behind.  A stale temporary path must not turn a later,
    already-proven browser action into an unknown external effect.
    """
    source_root = os.path.realpath(source_dir)
    frame_numbers = []
    for candidate in pathlib.Path(source_root).glob("*.jpg"):
        if candidate.stem.isdigit():
            frame_numbers.append(int(candidate.stem))
    next_number = max(frame_numbers, default=0) + 1
    while os.path.lexists(os.path.join(source_root, f"{next_number:04d}.jpg")):
        next_number += 1
    frame_path = os.path.join(source_root, f"{next_number:04d}.jpg")
    capture_path = os.path.join(source_root, f".capture-{next_number:04d}-{uuid.uuid4().hex}.png")
    return frame_path, capture_path


def capture_recording_frame(
    config: dict[str, Any],
    home: str,
    port: int,
    session: str,
    recording: dict[str, Any],
) -> str | None:
    """Append one visual frame without changing the Browser Use target.

    Browser Harness owns the recorder, while Browser Use CLI owns the page
    actions.  Browser Use 0.13.x does not call Harness ``observe()`` after
    its actions, so the start frame was previously the only numeric frame in
    the final MP4.  Ask the same Harness session to capture the already
    verified working tab into the next numeric frame path.  This is
    read-only and keeps the existing flow lease/session/tab binding intact.
    """
    if not browser_harness_cli_enabled():
        return None
    source_dir = os.path.realpath(str(recording.get("recording_source_dir") or ""))
    if not source_dir or not os.path.isdir(source_dir):
        raise Blocker("browser_use_recording_source_dir_missing")
    transport = _RECORD_BATCH_TRANSPORT
    if transport is not None:
        frames = transport.get("frame_queue")
        if not isinstance(frames, list) or not frames:
            raise Blocker("browser_use_record_batch_frame_queue_exhausted")
        frame = frames.pop(0)
        if not isinstance(frame, dict):
            raise Blocker("browser_use_record_batch_frame_result_invalid")
        frame_path = os.path.realpath(str(frame.get("frame_path") or ""))
        capture_path = os.path.realpath(str(frame.get("capture_path") or ""))
        if not frame_path.startswith(source_dir + os.sep) or not capture_path.startswith(source_dir + os.sep):
            raise Blocker("browser_use_record_batch_frame_scope_invalid")
        return _persist_recording_frame_capture(recording, frame_path, capture_path)
    frame_path, capture_path = next_recording_frame_paths(source_dir)
    code, readback_exit = run_cli_keep_alive(
        config,
        home,
        port,
        session,
        ["screenshot", capture_path],
        False,
        recording=recording,
    )
    if code != 0:
        raise Blocker("browser_use_recording_frame_capture_failed", _LAST_RECORDING_CLI_FAILURE or str(code))
    if readback_exit not in (None, 0):
        raise Blocker("browser_use_recording_frame_capture_readback_failed", str(readback_exit))
    return _persist_recording_frame_capture(recording, frame_path, capture_path)


def _persist_recording_frame_capture(recording: dict[str, Any], frame_path: str, capture_path: str) -> str:
    """Convert a verified temporary screenshot into the next recording frame."""
    try:
        stat = os.stat(capture_path)
    except OSError as exc:
        raise Blocker("browser_use_recording_frame_missing") from exc
    if not stat.st_mode or stat.st_size <= 0:
        raise Blocker("browser_use_recording_frame_empty")
    try:
        from PIL import Image

        with Image.open(capture_path) as image:
            converted = image.convert("RGB")
            converted.save(frame_path, format="JPEG", quality=90, optimize=True)
    except Exception as exc:
        raise Blocker("browser_use_recording_frame_jpeg_conversion_failed") from exc
    finally:
        try:
            os.unlink(capture_path)
        except FileNotFoundError:
            pass
        except OSError as exc:
            raise Blocker("browser_use_recording_capture_cleanup_failed") from exc
    try:
        frame_stat = os.stat(frame_path)
    except OSError as exc:
        raise Blocker("browser_use_recording_frame_missing") from exc
    if frame_stat.st_size <= 0:
        raise Blocker("browser_use_recording_frame_empty")
    write_harness_recording_status(recording["status_path"], recording, active=True, finalized=False)
    return frame_path


def final_visual_readback_from_stop_capture(
    recording: dict[str, Any],
    captured: str,
) -> dict[str, Any]:
    """Build a secret-free readback for the frame captured by record-stop.

    The recorder and the semantic state probe used to be separate lifecycle
    calls.  A user could change the page between them, leaving a valid-looking
    video beside a stale semantic readback.  ``record-stop`` now captures the
    final page metadata and DOM state immediately before flushing its final
    frame; this function binds those transient values to hashed evidence only.
    """
    parsed = _parse_cli_json(captured)
    data = parsed.get("data") if isinstance(parsed, dict) else None
    if not isinstance(data, dict):
        raise Blocker("browser_use_recording_final_visual_readback_shape_invalid")
    page = data.get("final_page")
    state = data.get("final_state")
    if not isinstance(page, dict) or not isinstance(state, str):
        raise Blocker("browser_use_recording_final_visual_readback_missing")
    url = str(page.get("url") or "")
    title = str(page.get("title") or "")
    if not url or not title:
        raise Blocker("browser_use_recording_final_visual_readback_identity_missing")
    source_dir = pathlib.Path(str(recording["recording_source_dir"]))
    frames = sorted(p for p in source_dir.glob("*.jpg") if p.stem.isdigit())
    if not frames:
        raise Blocker("browser_use_recording_final_visual_frame_missing")
    frame = frames[-1]
    inventory = None
    inventory_path = recording.get("tab_inventory_path")
    if isinstance(inventory_path, str) and os.path.lexists(inventory_path):
        inventory = read_recording_tab_inventory(inventory_path)
    if not isinstance(inventory, dict) or not inventory.get("working_target_id"):
        raise Blocker("browser_use_recording_final_visual_surface_binding_missing")
    working_target_id = str(inventory["working_target_id"])
    active_target_id = str(inventory.get("active_target_id") or working_target_id)
    return {
        "schema": "browser-use-final-visual-readback.v1",
        "url_length": len(url),
        "url_sha256": hashlib.sha256(url.encode("utf-8")).hexdigest(),
        "title_length": len(title),
        "title_sha256": hashlib.sha256(title.encode("utf-8")).hexdigest(),
        "state_length": len(state),
        "state_sha256": hashlib.sha256(state.encode("utf-8")).hexdigest(),
        "frame_path": str(frame),
        "frame_sha256": sha256_file(str(frame)),
        "target_id": working_target_id,
        "surface_role": "working",
        "active_target_id": active_target_id,
        "tab_inventory_sha256": hashlib.sha256(
            json.dumps(inventory or {}, sort_keys=True, separators=(",", ":")).encode("utf-8")
        ).hexdigest(),
    }


def bind_final_visual_readback_to_video(
    readback: dict[str, Any],
    video: dict[str, Any],
) -> dict[str, Any]:
    """Bind visual readback to a frame decoded from the finalized video.

    The stop capture is the source of truth for page identity, but its raw JPG
    is not itself the rendered movie.  Replacing that path with the decoded
    final video frame prevents a semantic readback from being paired with a
    frame from a different surface or a pre-encode artifact.
    """
    if not isinstance(readback, dict) or readback.get("schema") != "browser-use-final-visual-readback.v1":
        raise Blocker("browser_use_recording_final_visual_readback_shape_invalid")
    if not isinstance(video, dict):
        raise Blocker("browser_use_recording_final_video_binding_missing")
    frame_path = video.get("final_frame_path")
    frame_sha256 = video.get("final_frame_sha256")
    video_sha256 = video.get("sha256")
    frame_time = video.get("final_frame_time_seconds")
    if not isinstance(frame_path, str) or not frame_path or not isinstance(frame_sha256, str) or len(frame_sha256) != 64:
        raise Blocker("browser_use_recording_final_video_frame_missing")
    if not isinstance(video_sha256, str) or len(video_sha256) != 64:
        raise Blocker("browser_use_recording_final_video_binding_missing")
    if not isinstance(frame_time, (int, float)) or frame_time < 0:
        raise Blocker("browser_use_recording_final_video_frame_time_invalid")
    bound = dict(readback)
    bound.update(
        {
            "frame_path": frame_path,
            "frame_sha256": frame_sha256,
            "video_frame_path": frame_path,
            "video_frame_sha256": frame_sha256,
            "video_frame_time_seconds": frame_time,
            "video_sha256": video_sha256,
        }
    )
    return bound


def safe_semantic_readback_for_storage(value: dict[str, Any]) -> dict[str, Any] | None:
    """Persist only semantic identity hashes and bounded metadata.

    The live command result may contain a URL so the stage adapter can validate
    it.  Durable recording artifacts must not retain a query string, page
    state, or other content that could contain a credential-shaped value.
    """
    if not isinstance(value, dict) or value.get("schema") != "browser_use_semantic_readback.v1":
        return None
    kind = value.get("kind")
    if kind == "state" and isinstance(value.get("state"), dict):
        state = value["state"]
        url = str(state.get("url") or "")
        safe_state = {
            key: state[key]
            for key in (
                "ready_state",
                "origin",
                "redirect_count",
                "dns_revalidation",
                "dns_private_address_count",
                "dns_link_local_address_count",
                "dns_loopback_address_count",
            )
            if key in state
        }
        safe_state.update({
            "url_length": len(url),
            "url_sha256": hashlib.sha256(url.encode("utf-8")).hexdigest(),
        })
        return {
            "schema": value["schema"],
            "kind": kind,
            "state": safe_state,
            "state_sha256": value.get("state_sha256"),
        }
    if kind == "url":
        url = str(value.get("url") or "")
        return {
            "schema": value["schema"],
            "kind": kind,
            "url_length": len(url),
            "url_sha256": value.get("url_sha256") or hashlib.sha256(url.encode("utf-8")).hexdigest(),
            "origin": value.get("origin"),
            "origin_sha256": value.get("origin_sha256"),
            "redirect_count": value.get("redirect_count"),
            "redirect_hops_count": len(value.get("redirect_hops") or []),
            "final_dns_resolution": value.get("final_dns_resolution"),
        }
    if kind == "title":
        return {
            "schema": value["schema"],
            "kind": kind,
            "title_length": value.get("title_length"),
            "title_sha256": value.get("title_sha256"),
        }
    return None


def semantic_readback_bundle(descriptor: dict[str, Any]) -> dict[str, Any] | None:
    parts = descriptor.get("semantic_readback_parts")
    if not isinstance(parts, dict) or not all(kind in parts for kind in ("state", "title", "url")):
        return None
    inventory = descriptor.get("tab_inventory")
    target_id = inventory.get("working_target_id") if isinstance(inventory, dict) else None
    if not isinstance(target_id, str) or not target_id:
        return None
    return {
        "schema": "browser-use-semantic-readback-bundle.v1",
        "target_id": target_id,
        "surface_role": "working",
        "parts": {kind: parts[kind] for kind in ("state", "title", "url")},
    }


def read_recording_status(path: str, *, require_active: bool | None = None) -> dict[str, Any]:
    value = read_json_safe(path)
    if value.get("schema") != RECORDING_STATUS_SCHEMA:
        raise Blocker("browser_use_recording_status_schema_invalid")
    if not isinstance(value.get("recorder_configured"), bool) or not isinstance(value.get("recorder_active"), bool):
        raise Blocker("browser_use_recording_status_invalid")
    if "media_finalized" in value and not isinstance(value.get("media_finalized"), bool):
        raise Blocker("browser_use_recording_status_invalid")
    if require_active is True and value.get("recorder_active") is not True:
        raise Blocker("browser_use_recording_not_active")
    if require_active is False and value.get("recorder_active") is not False:
        raise Blocker("browser_use_recording_not_finalized")
    return value


def mark_recording_abandoned(path: str, *, reason: str) -> dict[str, Any]:
    """Persist an honest stopped/abandoned recorder state without finalizing video."""
    value = read_recording_status(path, require_active=None)
    if value.get("finalized") is True:
        raise Blocker("browser_use_recording_already_finalized")
    value.update(
        {
            "recorder_active": False,
            "finalized": False,
            "media_finalized": False,
            "state": "abandoned",
            "durable_state": "abandoned",
            "state_reason": str(reason)[:160],
            "state_updated_at": iso(now_utc()),
        }
    )
    json_atomic_replace(path, value)
    return value


def require_recording_continuable(descriptor: dict[str, Any]) -> None:
    """Reject descriptor markers that are no longer live recording leases."""
    if descriptor.get("status") not in {"active", "continued"}:
        raise Blocker("browser_use_recording_descriptor_not_live", str(descriptor.get("status", "missing")))


def _recording_descriptor_paths(config: dict[str, Any]) -> list[str]:
    root = pathlib.Path(recording_descriptor_root(config))
    paths: list[str] = []
    for path in sorted(root.rglob("*.json")):
        if path.is_symlink() or not path.is_file():
            continue
        try:
            value = read_json_safe(str(path))
        except Blocker:
            continue
        descriptor_fields = {"status", "run_id", "session", "status_path", "process", "owned_chrome", "profile", "lock_paths"}
        if value.get("schema") == RECORDING_SCHEMA and value.get("status") in RECORDING_STATUSES and descriptor_fields.issubset(value):
            paths.append(os.path.realpath(str(path)))
    return paths


def helper_generation_projection_path(config: dict[str, Any]) -> str:
    """Return the append-safe latest-helper projection index."""
    root = os.path.realpath(str(config["roots"]["browser_use_home"]))
    if not os.path.isabs(root) or os.path.realpath(root) != root:
        raise Blocker("browser_use_helper_generation_projection_root_invalid")
    assert_directory(root, create=True)
    return os.path.join(root, HELPER_GENERATION_PROJECTION_FILENAME)


def _helper_generation_projection_binding(value: dict[str, Any]) -> str:
    binding = {
        key: value.get(key)
        for key in (
            "descriptor", "run_id", "session", "task_id", "room_id",
            "historical_helper_sha256", "historical_helper_generation",
            "latest_helper_sha256", "alignment",
        )
    }
    return hashlib.sha256(json.dumps(binding, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def _live_room_readback_confirmed(config: dict[str, Any], room_id: str) -> bool:
    observations = [
        item for item in room_registry_observations(config)
        if isinstance(item, dict) and item.get("room_id") == room_id
    ]
    return len(observations) == 1 and all(
        observations[0].get(key) is True
        for key in ("process_observed", "listener_observed", "daemon_observed")
    )


def _project_room_helper_generation(config: dict[str, Any], current_digest: str) -> dict[str, Any]:
    """Add a derived latest-generation view without changing recorded bindings."""
    now = iso(now_utc())

    def mutate(registry: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any]]:
        counts = {"current_bound": 0, "historical_projection_only": 0}
        for room in registry["rooms"]:
            recorded = room.get("helper_sha256")
            alignment = "current_bound" if recorded == current_digest else "historical_projection_only"
            counts[alignment] += 1
            room["helper_generation_projection"] = {
                "schema": HELPER_GENERATION_PROJECTION_SCHEMA,
                "latest_helper_sha256": current_digest,
                "recorded_helper_sha256": recorded,
                "alignment": alignment,
                "historical_binding_preserved": True,
                "updated_at": now,
            }
        registry["updated_at"] = now
        return registry, counts

    return _room_registry_transaction(config, mutate)


def helper_generation_sync_all(config: dict[str, Any]) -> dict[str, Any]:
    """Project every session and automatically rebind positively-live rooms.

    This is intentionally bounded and idempotent.  Finalized/stale sessions
    retain their recorded helper hash and receive a latest-generation
    projection.  Only a positively observed owner-bound live room may be
    rebound, and that rebind never dispatches a browser command.
    """
    current_digest = sha256_trusted_helper(canonical_helper_path())
    paths = _recording_descriptor_paths(config)
    rooms = {str(room.get("room_id")): room for room in room_registry_list(config) if room.get("room_id")}
    entries: list[dict[str, Any]] = []
    counts = {
        "total": len(paths),
        "current_bound": 0,
        "auto_rebound_live": 0,
        "latest_projection_only": 0,
        "deferred_command_in_progress": 0,
        "live_sync_blocked": 0,
    }
    for path in paths:
        value = read_json_safe(path)
        original_helper = value.get("helper_sha256")
        original_generation = value.get("helper_generation")
        action = "latest_projection_only"
        blocker = None
        lock_path = None
        lock_token = None
        try:
            room_id = value.get("room_id")
            room = rooms.get(str(room_id)) if room_id else None
            if value.get("status") in {"active", "continued"} and isinstance(room, dict) and room.get("state") in ROOM_REGISTRY_ACTIVE_STATES:
                already_bound = (
                    original_helper == current_digest
                    and isinstance(original_generation, int)
                    and room.get("helper_sha256") == current_digest
                )
                if already_bound:
                    # A read-only parity check does not need to contend with
                    # an in-flight browser command lease.
                    action = "current_bound"
                else:
                    lock_path, lock_token = acquire_recording_command_lock(value)
                    try:
                        if (
                            original_helper != current_digest
                            and isinstance(room, dict)
                            and room.get("state") in ROOM_REGISTRY_ACTIVE_STATES
                            and not _live_room_readback_confirmed(config, str(room_id))
                        ):
                            raise Blocker("browser_use_helper_generation_auto_sync_readback_required")
                        refreshed = ensure_current_helper_generation(config, value, path, allow_historical=True)
                        value = refreshed
                        if value.get("helper_sha256") == current_digest and isinstance(value.get("helper_generation"), int):
                            action = "auto_rebound_live" if original_helper != current_digest else "current_bound"
                        else:
                            action = "latest_projection_only"
                    finally:
                        release_lock(lock_path, lock_token, lock_token)
        except Blocker as exc:
            blocker = exc.code
            action = "live_sync_blocked" if value.get("status") in {"active", "continued"} else "latest_projection_only"
        historical = {
            "descriptor": os.path.realpath(path),
            "descriptor_sha256": sha256_file(path),
            "run_id": value.get("run_id"),
            "session": value.get("session"),
            "task_id": value.get("task_id"),
            "room_id": value.get("room_id"),
            "status": value.get("status"),
            "historical_helper_sha256": original_helper,
            "historical_helper_generation": original_generation,
            "latest_helper_sha256": current_digest,
            "latest_helper_generation_sha256": current_digest,
            "alignment": "current_bound" if action in {"current_bound", "auto_rebound_live"} else "latest_projection_only",
            "action": action,
            "blocker": blocker,
            "historical_binding_preserved": True,
            "recorded_at": iso(now_utc()),
        }
        historical["binding_sha256"] = _helper_generation_projection_binding(historical)
        entries.append(historical)
        if action == "current_bound":
            counts["current_bound"] += 1
        elif action == "auto_rebound_live":
            counts["auto_rebound_live"] += 1
        elif action == "live_sync_blocked":
            counts["live_sync_blocked"] += 1
        elif action == "deferred_command_in_progress":
            counts["deferred_command_in_progress"] += 1
        else:
            counts["latest_projection_only"] += 1

    room_counts = _project_room_helper_generation(config, current_digest)
    projection = {
        "schema": HELPER_GENERATION_PROJECTION_SCHEMA,
        "version": 1,
        "latest_helper_sha256": current_digest,
        "latest_helper_generation_sha256": current_digest,
        "generated_at": iso(now_utc()),
        "historical_bindings_preserved": True,
        "entries": entries,
        "counts": {**counts, "rooms": room_counts},
    }
    projection_path = helper_generation_projection_path(config)
    if os.path.lexists(projection_path):
        assert_regular_file(projection_path, mode=0o600)
    json_atomic_replace(projection_path, projection)
    return {"status": "completed", "projection": projection_path, "latest_helper_sha256": current_digest, "counts": projection["counts"], "finalized": False}


def helper_generation_owner_lane_admission(
    config: dict[str, Any],
    *,
    automation_id: str,
    lifecycle: str,
    port: int | None,
) -> dict[str, Any]:
    """Admit one scheduled owner lane without rebinding foreign rooms."""
    current_digest = sha256_trusted_helper(canonical_helper_path())
    active_states = ROOM_REGISTRY_ACTIVE_STATES | {"cleanup_pending"}
    rooms = [
        room
        for room in room_registry_list(config)
        if isinstance(room, dict)
        and room.get("state") in active_states
        and isinstance(room.get("owner"), dict)
        and room["owner"].get("id") == automation_id
    ]
    blockers = []
    for room in rooms:
        if room.get("state") == "held":
            try:
                _room_registry_owner_reuse_absence_readback(config, room)
                continue
            except Blocker as exc:
                blocker = exc.code
        else:
            blocker = "browser_use_owner_lane_active_room"
        if room.get("helper_sha256") != current_digest and room.get("state") != "held":
            blocker = "browser_use_owner_lane_helper_generation_conflict"
        blockers.append({
            "exact_blocker": blocker,
            "room_id": room.get("room_id"),
            "owner": room.get("owner"),
            "automation_id": room.get("automation_id"),
            "lifecycle": room.get("lifecycle"),
            "port": room.get("port"),
            "state": room.get("state"),
            "current_activity": room.get("current_activity"),
            "helper_sha256": room.get("helper_sha256"),
        })
    return {
        "scope": "owner-lane",
        "automation_id": automation_id,
        "lifecycle": lifecycle,
        "requested_port": port,
        "current_helper_sha256": current_digest,
        "counts": {
            "total": len(rooms),
            "current_bound": 0,
            "auto_rebound_live": 0,
            "latest_projection_only": 0,
            "deferred_command_in_progress": 0,
            "live_sync_blocked": len(blockers),
        },
        "blocking_rooms": blockers,
        "foreign_rooms_ignored": True,
        "read_only": True,
    }


def require_cross_run_reconciliation_clear(
    config: dict[str, Any],
    *,
    run_id: str,
    automation_id: str,
    account_identity: str,
    target_origins: list[str] | None = None,
) -> None:
    """Prevent a fresh run from bypassing an unresolved prior effect.

    The generic helper has no business-resource key, so the scope is the
    workflow automation plus account identity and overlapping target origin.
    Missing origin metadata remains conservative and blocks. A workflow-owned
    source-of-truth reconciliation must clear a same-origin prior descriptor;
    this helper never invents that proof.
    """
    current_origins = {normalize_origin(item) for item in (target_origins or [])}
    for path in _recording_descriptor_paths(config):
        try:
            value = read_json_safe(path)
        except Blocker as exc:
            raise Blocker("browser_use_external_effect_reconciliation_required", exc.code) from exc
        if value.get("run_id") == run_id or value.get("status") not in {"active", "continued", "cleanup_pending", "stale"}:
            continue
        if value.get("automation_id") != automation_id or value.get("account_identity") != account_identity:
            continue
        prior_origins = value.get("target_origins")
        if current_origins and isinstance(prior_origins, list) and prior_origins:
            if not current_origins.intersection({normalize_origin(item) for item in prior_origins}):
                continue
        try:
            pending = _operation_ledger_reconciliation(value)
        except Blocker as exc:
            raise Blocker("browser_use_external_effect_reconciliation_required", f"{os.path.basename(path)}:{exc.code}") from exc
        if pending:
            ids = ",".join(entry["operation_id"] for entry in pending[:12])
            raise Blocker("browser_use_external_effect_reconciliation_required", f"prior_run={value.get('run_id')}:{ids}")


def _diagnostic_process_liveness(config: dict[str, Any], value: dict[str, Any]) -> tuple[bool | None, str | None]:
    """Probe the descriptor-bound process for status display only.

    This intentionally reuses the exact handoff identity checks but never
    changes descriptor admission, kills a process, releases a lock, or marks a
    run finalized.  A handoff-owned browser is reported as unknown because its
    owner is the handoff lifecycle, not the recording descriptor.
    """
    if value.get("owned_chrome") is not True:
        return None, None
    try:
        validate_handoff_process_identity(
            config,
            {"process": value["process"], "port": value["port"], "profile": value["profile"]},
            allow_missing=False,
        )
        return True, None
    except (KeyError, Blocker) as exc:
        return False, exc.code if isinstance(exc, Blocker) else "browser_use_recording_process_identity_invalid"


def _recording_media_proof(value: dict[str, Any]) -> tuple[bool, str | None]:
    """Read-only validation of the media proof already recorded for a run.

    This intentionally does not call ffprobe or generate frames: status
    inspection must not mutate historical recordings.  It catches legacy
    descriptors that claimed finalization without a usable manifest/video,
    including zero-byte MP4s.
    """
    recording_dir = value.get("recording_dir")
    if not isinstance(recording_dir, str) or not os.path.isabs(recording_dir):
        return False, "browser_use_recording_media_recording_dir_missing"
    manifest_path = value.get("manifest_path")
    if not isinstance(manifest_path, str) or not manifest_path:
        manifest_path = recording_manifest_path(recording_dir)
    manifest: dict[str, Any] | None = None
    if os.path.lexists(manifest_path):
        try:
            manifest = read_json_safe(manifest_path)
        except (Blocker, OSError, ValueError, json.JSONDecodeError):
            return False, "browser_use_recording_media_manifest_invalid"
        if manifest.get("schema") != RECORDING_SCHEMA or manifest.get("status") not in {"completed", "blocked"}:
            return False, "browser_use_recording_media_manifest_invalid"
    elif value.get("manifest_path"):
        return False, "browser_use_recording_media_manifest_missing"

    video = manifest.get("video") if manifest is not None else value.get("video")
    if not isinstance(video, dict):
        fallback_video = os.path.join(recording_dir, "browser-recording.mp4")
        try:
            if os.path.isfile(fallback_video) and os.path.getsize(fallback_video) <= 0:
                return False, "browser_use_recording_video_empty"
        except OSError:
            pass
        return False, "browser_use_recording_media_proof_missing"
    try:
        frames = int(video.get("frames") or 0)
        duration = float(video.get("duration_seconds") or 0)
    except (TypeError, ValueError):
        return False, "browser_use_recording_media_proof_invalid"
    if frames <= 0 or duration <= 0:
        return False, "browser_use_recording_media_empty"
    video_path = video.get("video_path")
    if not isinstance(video_path, str) or not video_path:
        video_path = os.path.join(recording_dir, "browser-recording.mp4")
    try:
        canonical_video = os.path.realpath(video_path)
        canonical_dir = os.path.realpath(recording_dir)
        if os.path.dirname(canonical_video) != canonical_dir or os.path.islink(video_path) or not os.path.isfile(video_path):
            return False, "browser_use_recording_media_video_path_invalid"
        if os.path.getsize(video_path) <= 0:
            return False, "browser_use_recording_video_empty"
    except OSError:
        return False, "browser_use_recording_media_video_missing"
    return True, None


def _classify_recording_descriptor(config: dict[str, Any], path: str, value: dict[str, Any]) -> dict[str, Any]:
    """Return bounded liveness metadata without page content or cleanup side effects."""
    process = value.get("process") if isinstance(value.get("process"), dict) else {}
    entry: dict[str, Any] = {
        "descriptor": os.path.realpath(path),
        "run_id": value.get("run_id"),
        "session": value.get("session"),
        "lifecycle": value.get("lifecycle"),
        "status": value.get("status"),
        "liveness": "unknown",
        "process_live": None,
        "process_live_blocker": None,
        # The helper PID owns the lock file, while this process identity owns
        # the browser listener.  Expose both lineages so a dead helper does
        # not get mistaken for a dead Chrome process during recovery.
        "process_pid": process.get("pid"),
        "process_start_time": process.get("start_time"),
        "process_root_pid": process.get("root_pid"),
        "process_root_start_time": process.get("root_start_time"),
        "recorder_active": None,
        "recorder_finalized": None,
        "media_finalized": None,
        "recording_status_binding": "unknown",
        "recording_status_run_id": None,
        "recording_status_session": None,
        "recording_finalized": value.get("recording_finalized"),
        "cleanup_completed": value.get("cleanup_completed"),
        "completion_status": value.get("completion_status"),
        "completion_blocker": value.get("completion_blocker") or value.get("finalize_failure"),
        "phases": value.get("phases") or {},
        "cleanup_capability_path": value.get("cleanup_capability_path"),
        "media_proof": None,
        "media_proof_blocker": None,
        "authentication_state": value.get("authentication_state"),
        "authentication_wait_blocker": (value.get("authentication_wait") or {}).get("exact_blocker"),
    }
    try:
        status = read_recording_status(str(value["status_path"]), require_active=None)
        entry["recorder_active"] = status["recorder_active"]
        entry["recorder_finalized"] = status["finalized"]
        entry["media_finalized"] = status.get("media_finalized")
        entry["recording_status_run_id"] = status.get("run_id")
        entry["recording_status_session"] = status.get("session")
        if status.get("run_id") is None and status.get("session") is None:
            entry["recording_status_binding"] = "legacy_missing"
        elif status.get("run_id") == value.get("run_id") and status.get("session") == value.get("session"):
            entry["recording_status_binding"] = "bound"
        else:
            entry["recording_status_binding"] = "mismatch"
            entry["liveness"] = "stale"
            entry["exact_blocker"] = "browser_use_recording_status_binding_mismatch"
            return entry
    except (KeyError, Blocker) as exc:
        entry["liveness"] = "stale"
        entry["exact_blocker"] = exc.code if isinstance(exc, Blocker) else "browser_use_recording_status_missing"
        return entry

    # A descriptor can look live while its append-only operation ledger still
    # contains an unresolved effect. Surface that gate during read-only
    # inspection so callers cannot mistake a live browser for a resumable one.
    if value.get("operation_ledger_path") or value.get("recording_dir"):
        try:
            pending_effects = pending_operation_reconciliation_ids(value)
        except (Blocker, KeyError, TypeError, ValueError) as exc:
            pending_effects = []
            entry["reconciliation_readback_blocker"] = exc.code if isinstance(exc, Blocker) else "browser_use_operation_ledger_readback_invalid"
            entry["reconciliation_required"] = True
        else:
            if pending_effects:
                entry["reconciliation_required"] = True
                entry["pending_reconciliation"] = pending_effects[:12]
    if entry.get("reconciliation_required"):
        entry["exact_blocker"] = "browser_use_external_effect_reconciliation_required"

    # The recorder's internal stop marker is not the descriptor's terminal
    # proof.  A continued/active descriptor with a stopped recorder is stale,
    # not a newly-created finalized debt item.
    if entry["recorder_finalized"] is True and value.get("status") != "finalized":
        entry["liveness"] = "stale"
        entry["exact_blocker"] = "browser_use_recording_descriptor_status_not_finalized"
        return entry

    if value.get("status") == "finalized" or entry["recorder_finalized"] is True:
        media_ok, media_blocker = _recording_media_proof(value)
        entry["media_proof"] = media_ok
        entry["media_proof_blocker"] = media_blocker
        blocked = bool(entry.get("completion_blocker")) or entry.get("completion_status") == "blocked" or value.get("external_effects") == "unknown" or entry.get("media_finalized") is False or entry.get("recording_finalized") is False or not media_ok or entry.get("reconciliation_required") is True
        entry["liveness"] = "finalized_blocked" if blocked else ("finalized" if value.get("status") == "finalized" else "stale")
        if blocked:
            entry["exact_blocker"] = entry.get("completion_blocker") or ("browser_use_external_effect_reconciliation_required" if entry.get("reconciliation_required") else "browser_use_recording_media_not_finalized" if entry.get("media_finalized") is False or entry.get("recording_finalized") is False else media_blocker or "browser_use_external_effects_unknown")
        elif entry["liveness"] == "stale":
            entry["exact_blocker"] = "browser_use_recording_descriptor_status_not_finalized"
        return entry
    if value.get("status") not in {"active", "continued"}:
        entry["liveness"] = str(value.get("status") or "unknown")
        return entry

    process_live, process_blocker = _diagnostic_process_liveness(config, value)
    entry["process_live"] = process_live
    entry["process_live_blocker"] = process_blocker

    try:
        run_id = safe_id(str(value["run_id"]), "run_id")
        session = validate_id(str(value["session"]), "session")
        descriptor = read_recording_descriptor(config, path, run_id, session)
        validate_recording_process(config, descriptor)
        if entry["recorder_active"] is not True:
            raise Blocker("browser_use_recording_not_active")
    except (KeyError, Blocker) as exc:
        entry["liveness"] = "stale"
        if not entry.get("reconciliation_required"):
            entry["exact_blocker"] = exc.code if isinstance(exc, Blocker) else "browser_use_recording_descriptor_fields_missing"
        if isinstance(exc, Blocker) and exc.code == "browser_use_recording_helper_hash_mismatch":
            try:
                pinned = validate_helper_snapshot(value)
            except Blocker:
                pinned = None
            if pinned:
                entry["liveness"] = "recoverable"
                entry["recovery_available"] = True
                entry["recovery_action"] = "same-run command/resume/recover/finalize will exec the pinned helper generation"
        return entry
    entry["liveness"] = "live"
    return entry


def _cleanup_pending_resource_transferred_to_current_owner(config: dict[str, Any], value: dict[str, Any]) -> bool:
    """Prove that a shared profile/port was released and claimed by a new owner.

    A cleanup-pending descriptor keeps the lock *paths* it used.  Those paths
    can legitimately exist again after the profile is handed to a later
    session, so path existence alone must not keep the old descriptor in the
    current-unresolved set.  Require both the old released lease and the new
    owner-bound lease/readback before treating the old cleanup as terminal.
    """
    lease_path_value = value.get("shared_profile_lease_path")
    if not isinstance(lease_path_value, str) or not lease_path_value:
        return False
    try:
        lease_path = os.path.realpath(lease_path_value)
        lease_root = os.path.realpath(shared_profile_lease_root(config, create=False))
    except (Blocker, OSError, TypeError, ValueError):
        return False
    if lease_path != lease_path_value or not lease_path.startswith(lease_root + os.sep):
        return False
    try:
        released_lease = read_json_safe(lease_path)
    except (Blocker, OSError, TypeError, ValueError, json.JSONDecodeError):
        return False
    if (
        released_lease.get("schema") != SHARED_PROFILE_LEASE_SCHEMA
        or released_lease.get("state") != "released"
        or released_lease.get("run_id") != value.get("run_id")
        or released_lease.get("session") != value.get("session")
        or released_lease.get("task_id") != value.get("task_id")
        or released_lease.get("nonce") != value.get("nonce")
    ):
        return False
    profile = os.path.realpath(str(value.get("profile") or ""))
    try:
        port = int(value.get("port", -1))
    except (TypeError, ValueError):
        return False
    if (
        not profile
        or os.path.realpath(str(released_lease.get("profile") or "")) != profile
        or int(released_lease.get("port", -1)) != port
    ):
        return False
    expected_lock_paths = {os.path.realpath(str(path)) for path in value.get("lock_paths", []) if isinstance(path, str)}
    released_lock_paths = {os.path.realpath(str(path)) for path in released_lease.get("lock_paths", []) if isinstance(path, str)}
    if not expected_lock_paths or expected_lock_paths != released_lock_paths:
        return False
    try:
        active_leases = _shared_profile_lease_records(config, create=False)
    except (Blocker, OSError, TypeError, ValueError):
        return False
    for current_lease in active_leases:
        if current_lease.get("state") not in {"claimed", "releasing"}:
            continue
        current_lease_id = current_lease.get("lease_id")
        if not isinstance(current_lease_id, str):
            current_lease_id = os.path.splitext(os.path.basename(str(current_lease.get("_path") or "")))[0]
        if (
            current_lease_id == os.path.splitext(os.path.basename(lease_path))[0]
            or os.path.realpath(str(current_lease.get("profile") or "")) != profile
            or int(current_lease.get("port", -1)) != port
        ):
            continue
        room_id = current_lease.get("room_id")
        try:
            room = room_registry_lookup(config, str(room_id or ""))
        except (Blocker, OSError, TypeError, ValueError):
            continue
        if (
            not isinstance(room, dict)
            or room.get("state") not in ROOM_REGISTRY_ACTIVE_STATES
            or os.path.realpath(str(room.get("profile") or "")) != profile
            or int(room.get("port", -1)) != port
        ):
            continue
        current_lock_paths = {os.path.realpath(str(path)) for path in current_lease.get("lock_paths", []) if isinstance(path, str)}
        if current_lock_paths != expected_lock_paths:
            continue
        try:
            lock_values = [read_json_safe(path) for path in sorted(expected_lock_paths)]
        except (Blocker, OSError, TypeError, ValueError, json.JSONDecodeError):
            continue
        if all(
            lock.get("schema") == "browser-use-lock.v1"
            and lock.get("run_id") == current_lease.get("run_id")
            and lock.get("nonce") == current_lease.get("nonce")
            and lock.get("canonical_profile") == profile
            and int(lock.get("port", -1)) == port
            and lock.get("shared_profile_lease_id") == current_lease_id
            for lock in lock_values
        ):
            return True
    return False


def _cleanup_pending_is_terminal_resource_free(config: dict[str, Any], value: dict[str, Any]) -> bool:
    """Classify a cleanup-pending descriptor with no remaining runtime resource."""
    if value.get("status") != "cleanup_pending":
        return False
    cleanup = value.get("cleanup_state") or {}
    if cleanup.get("status") != "cleaned":
        return False
    if cleanup.get("process_terminated") is not True or cleanup.get("listener_absent") is not True:
        return False
    if cleanup.get("daemon_close") != "closed" and cleanup.get("daemon_absent") is not True:
        return False
    if cleanup.get("locks_retained"):
        return False
    if any(os.path.lexists(path) for path in value.get("lock_paths", []) if isinstance(path, str)) and not _cleanup_pending_resource_transferred_to_current_owner(config, value):
        return False
    room_id = value.get("room_id")
    if room_id:
        try:
            room = room_registry_lookup(config, str(room_id))
        except (Blocker, OSError, ValueError, KeyError):
            return False
        if room is None or room.get("state") != "released":
            return False
    return True


def recording_status(args: argparse.Namespace) -> int:
    """Classify descriptors using fresh process/listener/recorder evidence."""
    config = read_toml()
    validate_installation(config)
    shared_inventory = shared_profile_inventory(config)
    if args.descriptor:
        path = os.path.realpath(args.descriptor)
        assert_recording_descriptor_path(config, path)
        paths = [path]
    else:
        paths = _recording_descriptor_paths(config)
    entries: list[dict[str, Any]] = []
    marked_stale = 0
    room_by_id: dict[str, dict[str, Any]] = {}
    observation_by_room: dict[str, dict[str, Any]] = {}
    try:
        room_by_id = {
            str(room.get("room_id")): room
            for room in room_registry_list(config)
            if isinstance(room, dict) and room.get("room_id")
        }
        observation_by_room = {
            str(observation.get("room_id")): observation
            for observation in room_registry_observations(config)
            if isinstance(observation, dict) and observation.get("room_id")
        }
    except (Blocker, OSError, TypeError, ValueError):
        # Descriptor status remains useful if the room registry itself cannot
        # be read, but never claim a clean current scope from a failed room
        # observation.
        room_by_id = {}
        observation_by_room = {}
    for path in paths:
        try:
            value = read_json_safe(path)
        except Blocker:
            continue
        if value.get("schema") != RECORDING_SCHEMA:
            continue
        entry = _classify_recording_descriptor(config, path, value)
        entry["cleanup_resource_free"] = _cleanup_pending_is_terminal_resource_free(config, value)
        room_id = value.get("room_id")
        room = room_by_id.get(str(room_id)) if room_id else None
        observation = observation_by_room.get(str(room_id)) if room_id else None
        room_state = room.get("state") if isinstance(room, dict) else None
        room_resource_pending = bool(
            room_state in ROOM_REGISTRY_ACTIVE_STATES
            or (
                isinstance(observation, dict)
                and any(observation.get(key) is True for key in ("process_observed", "listener_observed", "daemon_observed"))
            )
        )
        entry["room_state"] = room_state
        entry["room_observation"] = {
            key: observation.get(key)
            for key in ("process_observed", "listener_observed", "daemon_observed", "reclaim_allowed", "observed_at")
        } if isinstance(observation, dict) else None
        entry["room_resource_pending"] = room_resource_pending
        if room_resource_pending:
            entry["cleanup_resource_free"] = False
            entry["room_resource_blocker"] = "browser_use_room_or_daemon_cleanup_pending"
        if args.mark_stale and entry["liveness"] == "stale" and value.get("status") in {"active", "continued"}:
            value["status"] = "stale"
            stale_reason = entry.get("exact_blocker", "browser_use_recording_descriptor_stale")
            value["stale_state"] = {
                "state": "uncertain",
                "uncertain": True,
                "exact_blocker": stale_reason,
                "updated_at": iso(now_utc()),
            }
            json_atomic_replace(path, value)
            try:
                mark_recording_abandoned(str(value["status_path"]), reason=stale_reason)
            except Blocker as exc:
                if exc.code != "browser_use_recording_already_finalized":
                    raise
            entry["status"] = "stale"
            entry["marked_stale"] = True
            marked_stale += 1
        entries.append(entry)
    live = sum(entry["liveness"] == "live" for entry in entries)
    stale = sum(entry["liveness"] == "stale" for entry in entries)
    recoverable = sum(entry["liveness"] == "recoverable" for entry in entries)
    recoverable_live = sum(entry["liveness"] == "recoverable" and entry.get("process_live") is True for entry in entries)
    process_live_count = sum(entry.get("process_live") is True for entry in entries)
    cleanup_pending = sum(entry.get("status") == "cleanup_pending" and entry.get("cleanup_resource_free") is not True for entry in entries)
    historical_cleanup_pending = sum(entry.get("status") == "cleanup_pending" and entry.get("cleanup_resource_free") is True for entry in entries)
    finalized_blocked = sum(entry["liveness"] == "finalized_blocked" for entry in entries)
    finalized_count = sum(entry["liveness"] == "finalized" for entry in entries)
    # Active runtime requires fresh positive process/listener evidence.  A
    # recoverable entry without that evidence is pending historical
    # reconciliation, not an active runtime.
    active_runtime_count = sum(
        entry["liveness"] == "live"
        or (entry["liveness"] == "recoverable" and entry.get("process_live") is True)
        for entry in entries
    )
    recoverable_pending_count = sum(
        entry["liveness"] == "recoverable" and entry.get("process_live") is not True
        for entry in entries
    )
    active_runtime_process_live_count = active_runtime_count
    room_resource_pending_count = sum(entry.get("room_resource_pending") is True for entry in entries)
    historical_debt_count = sum(
        not entry.get("room_resource_pending")
        and (
            entry["liveness"] in {"stale", "finalized_blocked"}
            or (entry.get("status") == "cleanup_pending" and entry.get("cleanup_resource_free") is True)
        )
        for entry in entries
    )
    # This is current work still pending runtime/cleanup completion. Resource-
    # less recoverables remain visible as historical reconciliation work, but
    # must not make a fresh/current run look blocked.
    current_entries = [
        entry for entry in entries
        if entry.get("liveness") == "live"
        or (entry.get("liveness") == "recoverable" and entry.get("process_live") is True)
        or (entry.get("status") == "cleanup_pending" and entry.get("cleanup_resource_free") is not True)
        or entry.get("room_resource_pending") is True
    ]
    # A single run can be both live and room-pending. Count current work by
    # unique entry rather than summing overlapping dimensions.
    recording_completion_pending_count = len(current_entries)
    historical_entries = [
        entry for entry in entries
        if not entry.get("room_resource_pending")
        and (
            entry.get("liveness") in {"stale", "finalized_blocked"}
            or (entry.get("liveness") == "recoverable" and entry.get("process_live") is not True)
            or (entry.get("status") == "cleanup_pending" and entry.get("cleanup_resource_free") is True)
        )
    ]

    def blocker_bucket(entry: dict[str, Any]) -> str:
        value = entry.get("exact_blocker") or entry.get("completion_blocker") or entry.get("media_proof_blocker")
        return str(value or entry.get("liveness") or "unknown")

    current_by_blocker: dict[str, int] = {}
    for entry in current_entries:
        key = blocker_bucket(entry)
        current_by_blocker[key] = current_by_blocker.get(key, 0) + 1
    historical_by_blocker: dict[str, int] = {}
    for entry in historical_entries:
        key = blocker_bucket(entry)
        historical_by_blocker[key] = historical_by_blocker.get(key, 0) + 1
    current_completion_status = "pending" if current_entries else "completed"
    # Public completion fields describe only work that can still affect the
    # current run.  Finalized-but-incomplete media and stale descriptors are
    # reported separately as historical debt, so they cannot make a fresh run
    # look currently blocked.
    recording_completion_status = "pending" if recording_completion_pending_count else "completed"
    historical_completion_status = "debt" if historical_entries else "none"
    unresolved = len(current_entries)
    legacy_unresolved = live + recoverable + cleanup_pending + finalized_blocked
    overall_completion = "blocked" if current_entries else "completed"
    current_terminal = not current_entries
    historical_debt_present = bool(historical_entries)
    if not current_terminal:
        operator_next_action = "owner-bound current cleanup or same-generation readback"
    elif historical_debt_present:
        operator_next_action = "current runtime is terminal; reconcile historical debt read-only before any affected retry"
    else:
        operator_next_action = "ready for fresh admission"
    print(json.dumps({
        "status": "completed",
        "status_scope": "inspection",
        "inspection_status": "completed",
        "inspection_succeeded": True,
        "inspection_command_succeeded": True,
        "entries": entries,
        "shared_profile_inventory": shared_inventory,
        "shareable_profile_count": shared_inventory["profile_count"],
        "shareable_profile_available_count": shared_inventory["available_count"],
        "shareable_profile_leased_count": shared_inventory["leased_count"],
        "shareable_profile_busy_count": shared_inventory["busy_count"],
        "live_count": live,
        "literal_live_descriptor_count": live,
        "live_count_semantics": "literal live descriptors only; use active_runtime_count for current live runtime including recoverable entries",
        "stale_count": stale,
        "recoverable_count": recoverable,
        "recoverable_live_count": recoverable_live,
        "process_live_count": process_live_count,
        "active_runtime_count": active_runtime_count,
        "active_runtime_process_live_count": active_runtime_process_live_count,
        "room_resource_pending_count": room_resource_pending_count,
        "recoverable_pending_count": recoverable_pending_count,
        "historical_recoverable_pending_count": recoverable_pending_count,
        "historical_debt_count": historical_debt_count,
        "cleanup_pending_count": cleanup_pending,
        "historical_cleanup_pending_count": historical_cleanup_pending,
        "finalized_count": finalized_count,
        "finalized_blocked_count": finalized_blocked,
        "recording_completion_count": finalized_count,
        "recording_completion_pending_count": recording_completion_pending_count,
        "recording_completion_status": recording_completion_status,
        "completion_scope": "current_runtime_and_cleanup_only",
        "current_unresolved_count": len(current_entries),
        "current_unresolved_by_blocker": dict(sorted(current_by_blocker.items())),
        "current_completion_status": current_completion_status,
        "current_runtime_status": current_completion_status,
        "current_terminal": current_terminal,
        "current_terminal_status": "terminal" if current_terminal else "non_terminal",
        "current_pending_unique_count": len(current_entries),
        "historical_completion_status": historical_completion_status,
        "historical_debt_present": historical_debt_present,
        "historical_debt_count": len(historical_entries),
        "historical_reconciliation_required_count": len(historical_entries),
        "historical_work_policy": "owner_bound_readback_only_no_replay",
        "current_work_policy": "owner_bound_terminal_cleanup_or_same_generation_readback",
        "operator_next_action": operator_next_action,
        "finalized_semantics": "aggregate finalized is true only when current scope is terminal and historical debt is empty; descriptor/media finalization is reported per entry",
        "historical_debt_by_blocker": dict(sorted(historical_by_blocker.items())),
        "historical_debt_status": "present" if historical_entries else "none",
        "finalized_current_scope": not current_entries,
        "unresolved_count": unresolved,
        "legacy_unresolved_count": legacy_unresolved,
        "overall_completion": overall_completion,
        "task_status": overall_completion,
        "marked_stale_count": marked_stale,
        "finalized": overall_completion == "completed" and not historical_entries,
    }, sort_keys=True))
    return 0


def wait_for_recording_stop(path: str, timeout_seconds: float = 15.0) -> dict[str, Any]:
    deadline = time.monotonic() + timeout_seconds
    last_error: Blocker | None = None
    while time.monotonic() < deadline:
        try:
            value = read_recording_status(path, require_active=False)
            if value.get("finalized") is True:
                return value
        except Blocker as exc:
            last_error = exc
        time.sleep(0.25)
    if last_error is not None:
        raise last_error
    raise Blocker("browser_use_recording_stop_readback_timeout")


def probe_recording_video(config: dict[str, Any], recording_dir: str) -> dict[str, Any]:
    ffprobe = config["executables"]["ffprobe"]["canonical_path"]
    ffmpeg = config["executables"]["ffmpeg"]["canonical_path"]
    videos = sorted(pathlib.Path(recording_dir).glob("*.mp4"))
    if len(videos) != 1:
        raise Blocker("browser_use_recording_video_count_invalid")
    video = videos[0]
    if video.is_symlink() or not video.is_file() or video.parent.resolve() != pathlib.Path(recording_dir):
        raise Blocker("browser_use_recording_video_path_invalid")
    os.chmod(video, 0o600)
    probe = subprocess.run(
        [ffprobe, "-v", "error", "-count_frames", "-select_streams", "v:0", "-show_entries", "stream=codec_name,width,height,r_frame_rate,nb_read_frames", "-show_entries", "format=duration", "-of", "json", str(video)],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=30,
    )
    if probe.returncode != 0:
        raise Blocker("browser_use_recording_video_probe_failed")
    try:
        value = json.loads(probe.stdout)
        stream = (value.get("streams") or [])[0]
        frames = int(stream.get("nb_read_frames") or 0)
        duration = float((value.get("format") or {}).get("duration") or 0)
    except (IndexError, TypeError, ValueError, json.JSONDecodeError) as exc:
        raise Blocker("browser_use_recording_video_probe_invalid") from exc
    if frames <= 0 or duration <= 0:
        raise Blocker("browser_use_recording_video_empty")
    representative = pathlib.Path(recording_dir) / "representative-frame.jpg"
    representative_time = max(0.0, min(duration / 2.0, max(duration - 0.1, 0.0)))
    frame = subprocess.run(
        [ffmpeg, "-v", "error", "-y", "-ss", f"{representative_time:.3f}", "-i", str(video), "-frames:v", "1", "-q:v", "2", str(representative)],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=30,
    )
    if frame.returncode != 0 or not representative.exists():
        raise Blocker("browser_use_recording_representative_frame_failed")
    os.chmod(representative, 0o600)
    try:
        numerator, denominator = str(stream.get("r_frame_rate") or "").split("/", 1)
        frame_rate = float(numerator) / float(denominator)
    except (TypeError, ValueError, ZeroDivisionError) as exc:
        raise Blocker("browser_use_recording_video_frame_rate_invalid") from exc
    if frame_rate <= 0:
        raise Blocker("browser_use_recording_video_frame_rate_invalid")
    # Seek one and a half frame intervals before the nominal end.  A seek at
    # duration - 0.5 frame can land after the last decodable PTS while ffmpeg
    # still returns zero without creating an output image.
    final_frame_time = max(0.0, duration - (1.5 / frame_rate))
    final_frame = pathlib.Path(recording_dir) / "video-final-frame.jpg"
    final_frame_result = subprocess.run(
        [ffmpeg, "-v", "error", "-y", "-ss", f"{final_frame_time:.3f}", "-i", str(video), "-frames:v", "1", "-q:v", "2", str(final_frame)],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=30,
    )
    if final_frame_result.returncode != 0 or not final_frame.exists():
        raise Blocker("browser_use_recording_final_video_frame_failed")
    os.chmod(final_frame, 0o600)
    return {
        "video_path": str(video),
        "codec": stream.get("codec_name"),
        "width": stream.get("width"),
        "height": stream.get("height"),
        "framerate": stream.get("r_frame_rate"),
        "frames": frames,
        "duration_seconds": duration,
        "representative_time_seconds": representative_time,
        "sha256": sha256_file(str(video)),
        "representative_frame_path": str(representative),
        "representative_frame_sha256": sha256_file(str(representative)),
        "final_frame_path": str(final_frame),
        "final_frame_sha256": sha256_file(str(final_frame)),
        "final_frame_time_seconds": final_frame_time,
    }


def json_atomic_no_replace(path: str, value: dict[str, Any]) -> None:
    parent = os.path.dirname(path)
    assert_directory(parent, create=True)
    payload = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
    temp = os.path.join(parent, f".{os.path.basename(path)}.{uuid.uuid4().hex}.tmp")
    fd = os.open(temp, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    try:
        os.write(fd, payload)
        os.fsync(fd)
    finally:
        os.close(fd)
    try:
        os.link(temp, path)
        os.unlink(temp)
    except FileExistsError as exc:
        try:
            os.unlink(temp)
        except FileNotFoundError:
            pass
        raise Blocker("browser_use_receipt_already_exists", path) from exc
    os.chmod(path, 0o600)
    directory_fd = os.open(parent, os.O_RDONLY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def json_atomic_replace(path: str, value: dict[str, Any]) -> None:
    parent = os.path.dirname(path)
    assert_directory(parent, create=True)
    temp = os.path.join(parent, f".{os.path.basename(path)}.{uuid.uuid4().hex}.tmp")
    fd = os.open(temp, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    try:
        os.write(fd, (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(temp, path)
    os.chmod(path, 0o600)


def _authority_issue_text(value: Any, field: str) -> str:
    normalized = value.lower() if isinstance(value, str) else ""
    invalid = (
        not isinstance(value, str)
        or not value
        or value != value.strip()
        or not AUTHORITY_LABEL_RE.fullmatch(value)
        or any(marker in normalized for marker in AUTHORITY_SENSITIVE_LABEL_MARKERS)
        or normalized.startswith("eyj")
    )
    if invalid:
        raise Blocker("browser_use_authority_issue_field_invalid", field)
    return value


def issue_authority(args: argparse.Namespace) -> int:
    """Issue one fresh, temporary authorized authority without mutating old state."""
    run_id = safe_id(args.run_id, "run_id")
    session = safe_id(args.session, "session")
    output = args.output
    if (
        not isinstance(output, str)
        or not os.path.isabs(output)
        or os.path.realpath(output) != output
        or os.path.basename(output) in {"", ".", ".."}
    ):
        raise Blocker("browser_use_authority_issue_output_path_invalid")
    if os.path.lexists(output):
        raise Blocker("browser_use_authority_output_already_exists")
    if isinstance(args.ttl_seconds, bool) or not isinstance(args.ttl_seconds, int):
        raise Blocker("browser_use_authority_issue_ttl_invalid")
    ttl_seconds = args.ttl_seconds
    if ttl_seconds < AUTHORITY_MIN_TTL_SECONDS or ttl_seconds > AUTHORITY_MAX_TTL_SECONDS:
        raise Blocker("browser_use_authority_issue_ttl_invalid")
    if args.approval != "approved":
        raise Blocker("browser_use_authority_issue_approval_required")
    raw_origins = args.allowed_origin
    if not isinstance(raw_origins, list) or not raw_origins:
        raise Blocker("browser_use_authority_issue_origins_required")
    try:
        allowed_origins = sorted({normalize_origin(origin) for origin in raw_origins})
    except (Blocker, TypeError, ValueError) as exc:
        raise Blocker("browser_use_authority_issue_origin_invalid") from exc
    account_identity = _authority_issue_text(args.account_identity, "account_identity")
    data_exposure = _authority_issue_text(args.data_exposure, "data_exposure")
    side_effect_scope = _authority_issue_text(args.side_effect_scope, "side_effect_scope")
    issued_at = now_utc()
    expires_at = iso(issued_at + dt.timedelta(seconds=ttl_seconds))
    lineage_expires_at = iso(issued_at + dt.timedelta(seconds=AUTHORITY_LINEAGE_MAX_SECONDS))
    authority = {
        "browser_surface": "browser_use_cli",
        "run_id": run_id,
        "session": session,
        "authority_issued_at": iso(issued_at),
        "authority_lineage_expires_at": lineage_expires_at,
        "expires_at": expires_at,
        "allowed_origins": allowed_origins,
        "account_identity": account_identity,
        "data_exposure": data_exposure,
        "side_effect_scope": side_effect_scope,
        "approval": "approved",
        "readback_required": True,
        "issuer_id": AUTHORITY_ISSUER_ID,
    }
    parent = os.path.dirname(output)
    assert_directory(parent, create=True)
    try:
        json_atomic_no_replace(output, authority)
    except Blocker as exc:
        if exc.code == "browser_use_receipt_already_exists":
            raise Blocker("browser_use_authority_output_already_exists") from exc
        raise
    authority_sha256 = sha256_file(output)
    receipt = {
        "schema": AUTHORITY_ISSUER_RECEIPT_SCHEMA,
        "run_id": run_id,
        "session": session,
        "authority_sha256": authority_sha256,
        "expires_at": expires_at,
        "issuer_id": AUTHORITY_ISSUER_ID,
        "output": output,
        "finalized": True,
    }
    print(json.dumps(receipt, sort_keys=True))
    return 0


def renew_authority(args: argparse.Namespace) -> int:
    """Issue one append-only renewal for an existing descriptor lineage.

    The old authority and descriptor are read-only inputs.  This path exists
    for crash recovery where the task-owned profile may still contain the
    authenticated session; it never edits the old authority or descriptor.
    """
    config = read_toml()
    descriptor_path = args.descriptor
    if not isinstance(descriptor_path, str) or not os.path.isabs(descriptor_path) or os.path.realpath(descriptor_path) != descriptor_path:
        raise Blocker("browser_use_authority_renewal_descriptor_path_invalid")
    descriptor = read_json_safe(descriptor_path)
    if descriptor.get("schema") != RECORDING_SCHEMA or descriptor.get("mode") != "authorized":
        raise Blocker("browser_use_authority_renewal_descriptor_invalid")
    run_id = safe_id(str(descriptor.get("run_id") or ""), "run_id")
    session = validate_id(str(descriptor.get("session") or ""), "session")
    if descriptor.get("status") not in RECORDING_STATUSES - {"finalized", "stale"}:
        raise Blocker("browser_use_authority_renewal_descriptor_not_continuable")
    authority_candidate = args.authority or descriptor.get("authority_current_path") or descriptor.get("authority_path")
    if not authority_candidate:
        raise Blocker("browser_use_authority_required")
    authority_path = assert_authority_file(str(authority_candidate))
    current_digest = sha256_file(authority_path)
    if current_digest != descriptor.get("authority_sha256"):
        raise Blocker("browser_use_authority_renewal_lineage_mismatch")
    current = parse_authority(
        authority_path,
        run_id,
        session,
        aliases=session_aliases(config, descriptor.get("requested_session", session), session),
        require_unexpired=False,
    )
    if descriptor.get("authority_current_path") and os.path.realpath(str(descriptor["authority_current_path"])) != os.path.realpath(authority_path):
        raise Blocker("browser_use_authority_renewal_lineage_mismatch")
    try:
        generation = int(descriptor.get("authority_generation", 1)) + 1
        ttl_seconds = int(args.ttl_seconds)
    except (TypeError, ValueError) as exc:
        raise Blocker("browser_use_authority_renewal_input_invalid") from exc
    if ttl_seconds < AUTHORITY_MIN_TTL_SECONDS or ttl_seconds > AUTHORITY_MAX_TTL_SECONDS:
        raise Blocker("browser_use_authority_renewal_ttl_invalid")
    if args.approval != "approved":
        raise Blocker("browser_use_authority_renewal_approval_required")
    output = args.output
    if not isinstance(output, str) or not os.path.isabs(output) or os.path.realpath(output) != output or os.path.lexists(output):
        raise Blocker("browser_use_authority_renewal_output_invalid")
    lineage_expires_at = _authority_lineage_expiry(current, descriptor)
    lineage_expires_at = dt.datetime.fromisoformat(iso(lineage_expires_at).replace("Z", "+00:00"))
    renewal_expires_at = min(
        now_utc() + dt.timedelta(seconds=ttl_seconds),
        lineage_expires_at,
    )
    if renewal_expires_at <= now_utc() + dt.timedelta(seconds=AUTHORITY_CLOCK_SKEW_SECONDS):
        raise Blocker("browser_use_authority_renewal_lineage_exhausted")
    authority = {
        "schema": AUTHORITY_RENEWAL_SCHEMA,
        "browser_surface": "browser_use_cli",
        "run_id": run_id,
        "session": session,
        "authority_issued_at": current.get("authority_issued_at"),
        "authority_lineage_expires_at": iso(lineage_expires_at),
        "expires_at": iso(renewal_expires_at),
        "allowed_origins": sorted({normalize_origin(item) for item in current["allowed_origins"]}),
        "account_identity": current["account_identity"],
        "data_exposure": current["data_exposure"],
        "side_effect_scope": current["side_effect_scope"],
        "approval": "approved",
        "readback_required": True,
        "previous_authority_sha256": current_digest,
        "authority_generation": generation,
        "issuer_id": AUTHORITY_ISSUER_ID,
    }
    for key in ("automation_id", "stage_id", "mode", "not_before", "authority_id", "authority_schema", "authority_version"):
        if key in current:
            authority[key] = current[key]
    assert_directory(os.path.dirname(output), create=True)
    json_atomic_no_replace(output, authority)
    descriptor.update({
        "authority_sha256": sha256_file(output),
        "authority_issued_at": authority.get("authority_issued_at") or descriptor.get("authority_issued_at"),
        "authority_lineage_expires_at": authority.get("authority_lineage_expires_at"),
        "authority_generation": generation,
        "authority_issuer_id": authority["issuer_id"],
        "authority_expires_at": authority["expires_at"],
        "authority_current_path": os.path.realpath(output),
    })
    json_atomic_replace(descriptor_path, descriptor)
    receipt = {
        "schema": AUTHORITY_ISSUER_RECEIPT_SCHEMA,
        "run_id": run_id,
        "session": session,
        "authority_sha256": sha256_file(output),
        "expires_at": authority["expires_at"],
        "issuer_id": AUTHORITY_ISSUER_ID,
        "output": output,
        "previous_authority_sha256": current_digest,
        "authority_generation": generation,
        "finalized": True,
    }
    print(json.dumps(receipt, sort_keys=True))
    return 0


def _ledger_public_command(command: list[str]) -> dict[str, Any]:
    """Return command metadata safe for durable state.

    Arguments are represented by shape only. Hashing arbitrary arguments is
    not a privacy boundary because URLs, target labels, and form values may
    still be sensitive even when the original text is not persisted.
    """
    name = str(command[0]) if command else ""
    return {
        "name": name,
        "argument_count": max(0, len(command) - 1),
        "read_only": is_read_only_command(command),
        "argument_shapes": [
            "url" if str(arg).startswith(("http://", "https://")) else
            "path" if os.path.isabs(str(arg)) else
            "scalar"
            for arg in command[1:]
        ],
    }


def _effect_origin_digest(descriptor: dict[str, Any]) -> str:
    """Digest approved origins without persisting URL or page data."""
    origins = []
    for value in descriptor.get("target_origins") or descriptor.get("origins") or []:
        try:
            origins.append(normalize_origin(str(value)))
        except Exception:
            continue
    return hashlib.sha256(json.dumps(sorted(set(origins)), separators=(",", ":")).encode("utf-8")).hexdigest()


def _effect_frame_binding(descriptor: dict[str, Any]) -> tuple[str, str]:
    """Return a stable, secret-free binding for the run-owned working target."""
    inventory = descriptor.get("tab_inventory")
    target_id = inventory.get("working_target_id") if isinstance(inventory, dict) else None
    target_id = str(target_id or descriptor.get("session") or "")
    if not target_id:
        raise Blocker("browser_use_effect_frame_binding_missing")
    return "working-target", hashlib.sha256(target_id.encode("utf-8")).hexdigest()


def _effect_binding(
    descriptor: dict[str, Any],
    operation_id: str,
    command: list[str],
    *,
    target_text: str = "",
) -> dict[str, Any]:
    """Create the immutable action binding used before and after dispatch."""
    if not re.fullmatch(r"[a-f0-9]{32}", str(operation_id)):
        raise Blocker("browser_use_effect_action_id_invalid")
    frame_kind, frame_id = _effect_frame_binding(descriptor)
    public_command = _ledger_public_command(command)
    target_digest = hashlib.sha256(str(target_text or "").encode("utf-8")).hexdigest() if target_text else ""
    node_fingerprint = hashlib.sha256(
        json.dumps({"command": public_command, "target": target_digest}, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    binding = {
        "run_id": str(descriptor.get("run_id") or ""),
        "frame_kind": frame_kind,
        "frame_id": frame_id,
        "origin_digest": _effect_origin_digest(descriptor),
        "navigation_epoch": int(descriptor.get("navigation_epoch") or 0),
        "node_fingerprint": node_fingerprint,
        "action_hash": hashlib.sha256(json.dumps(public_command, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest(),
    }
    if not binding["run_id"]:
        raise Blocker("browser_use_effect_run_binding_missing")
    binding["dispatch_id"] = hashlib.sha256(
        json.dumps({"operation_id": operation_id, **binding}, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    return binding


def _effect_evidence_entry(
    descriptor: dict[str, Any],
    operation_id: str,
    command: list[str],
    *,
    phase: str,
    effect_state: str,
    target_text: str = "",
    ack_status: str = "",
    error_code: str = "",
) -> dict[str, Any]:
    if phase not in EFFECT_EVIDENCE_PHASES or effect_state not in EFFECT_EVIDENCE_STATES:
        raise Blocker("browser_use_effect_evidence_phase_invalid")
    binding = _effect_binding(descriptor, operation_id, command, target_text=target_text)
    entry = {
        "schema": EFFECT_EVIDENCE_SCHEMA,
        "run_id": binding["run_id"],
        "action_id": str(operation_id),
        "dispatch_id": binding["dispatch_id"],
        "phase": phase,
        "action_type": str(command[0])[:64],
        "frame_kind": binding["frame_kind"],
        "frame_id": binding["frame_id"],
        "origin_digest": binding["origin_digest"],
        "navigation_epoch": binding["navigation_epoch"],
        "node_fingerprint": binding["node_fingerprint"],
        "action_hash": binding["action_hash"],
        "effect_state": effect_state,
        "ack_status": str(ack_status or "")[:64],
        "error_code": str(error_code or "")[:160],
        "recorded_at": iso(now_utc()),
    }
    if set(entry) != EFFECT_EVIDENCE_ALLOWED_FIELDS:
        raise Blocker("browser_use_effect_evidence_allowlist_invalid")
    return entry


def persist_effect_evidence(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    descriptor_path: str,
    operation_id: str,
    command: list[str],
    *,
    phase: str,
    effect_state: str,
    target_text: str = "",
    ack_status: str = "",
    error_code: str = "",
) -> dict[str, Any]:
    """Persist one irreversible effect phase before continuing."""
    evidence = _effect_evidence_entry(
        descriptor,
        operation_id,
        command,
        phase=phase,
        effect_state=effect_state,
        target_text=target_text,
        ack_status=ack_status,
        error_code=error_code,
    )
    prior = descriptor.setdefault("effect_evidence", [])
    if not isinstance(prior, list):
        raise Blocker("browser_use_effect_evidence_state_invalid")
    state_by_operation = descriptor.setdefault("effect_states", {})
    if not isinstance(state_by_operation, dict):
        raise Blocker("browser_use_effect_state_index_invalid")
    current = str((state_by_operation.get(operation_id) or {}).get("effect_state") or "pre-dispatch")
    if phase == "dispatch_started" and current != "pre-dispatch":
        raise Blocker("browser_use_effect_dispatch_start_replay")
    if phase == "acknowledged" and current != "dispatch-started":
        raise Blocker("browser_use_effect_ack_without_dispatch")
    if phase == "unknown_effect" and current != "dispatch-started":
        raise Blocker("browser_use_effect_unknown_without_dispatch")
    allowed = EFFECT_EVIDENCE_TRANSITIONS.get(current)
    if allowed is None or effect_state not in allowed:
        raise Blocker("browser_use_effect_state_transition_invalid")
    if phase == "intent_recorded" and current != "pre-dispatch":
        raise Blocker("browser_use_effect_intent_replay")
    if phase == "blocked" and current != "pre-dispatch":
        raise Blocker("browser_use_effect_blocked_after_dispatch")
    if phase == "acknowledged":
        started = state_by_operation.get(operation_id) or {}
        started_binding = started.get("binding") if isinstance(started, dict) else None
        if not isinstance(started_binding, dict) or any(
            started_binding.get(key) != evidence.get(key)
            for key in ("dispatch_id", "frame_id", "origin_digest", "navigation_epoch", "node_fingerprint", "action_hash")
        ):
            raise Blocker("browser_use_effect_ack_binding_mismatch")
    prior.append(evidence)
    descriptor["effect_evidence"] = prior[-256:]
    state_by_operation[operation_id] = {
        "effect_state": effect_state,
        "dispatch_id": evidence["dispatch_id"],
        "action_hash": evidence["action_hash"],
        "binding": {
            key: evidence[key]
            for key in ("dispatch_id", "frame_id", "origin_digest", "navigation_epoch", "node_fingerprint", "action_hash")
        },
        "updated_at": evidence["recorded_at"],
    }
    try:
        _write_recording_descriptor(config, os.path.realpath(descriptor_path), descriptor, replace=True)
    except Exception as exc:
        raise Blocker("browser_use_effect_evidence_write_failed", type(exc).__name__) from exc
    return evidence


def effect_evidence_binding_matches(
    descriptor: dict[str, Any],
    operation_id: str,
    command: list[str],
    *,
    target_text: str = "",
) -> bool:
    """Validate the immutable binding again without dispatching anything."""
    state = (descriptor.get("effect_states") or {}).get(operation_id)
    if not isinstance(state, dict) or state.get("effect_state") != "dispatch-started":
        return False
    binding = _effect_binding(descriptor, operation_id, command, target_text=target_text)
    return state.get("dispatch_id") == binding["dispatch_id"] and state.get("action_hash") == binding["action_hash"]


def operation_ledger_path(descriptor: dict[str, Any]) -> str:
    value = descriptor.get("operation_ledger_path") or os.path.join(descriptor["recording_dir"], "operation-ledger.jsonl")
    if not os.path.isabs(value) or os.path.realpath(value) != value:
        raise Blocker("browser_use_operation_ledger_path_invalid")
    if os.path.dirname(value) != os.path.realpath(descriptor["recording_dir"]):
        raise Blocker("browser_use_operation_ledger_scope_invalid")
    return value


def operation_ledger_lock_path(descriptor: dict[str, Any]) -> str:
    return f"{operation_ledger_path(descriptor)}.lock"


def recording_command_lock_path(descriptor: dict[str, Any]) -> str:
    """Return the exclusive same-run command lease path.

    The operation-ledger lock only serializes individual append operations. It
    cannot protect the browser session, descriptor read/modify/write, or
    recording-frame allocation across two CLI processes. Keep that wider
    command lease run-owned and beside the immutable operation ledger.
    """
    recording_dir = os.path.realpath(str(descriptor.get("recording_dir") or ""))
    if not recording_dir or not os.path.isabs(recording_dir) or not os.path.isdir(recording_dir):
        raise Blocker("browser_use_recording_command_lock_scope_invalid")
    path = os.path.join(recording_dir, ".recording-command.lock")
    if os.path.realpath(path) != path or os.path.dirname(path) != recording_dir:
        raise Blocker("browser_use_recording_command_lock_scope_invalid")
    return path


def acquire_recording_command_lock(descriptor: dict[str, Any]) -> tuple[str, str]:
    """Claim one exclusive command lease for the active recording session."""
    path = recording_command_lock_path(descriptor)
    token = f"recording-command-{os.getpid()}-{uuid.uuid4().hex}"
    payload = {
        "schema": "browser-use-recording-command-lock.v1",
        "run_id": token,
        "nonce": token,
        "recording_run_id": descriptor.get("run_id"),
        "recording_session": descriptor.get("session"),
        "recording_nonce": descriptor.get("nonce"),
        "lock_pid": os.getpid(),
        "lock_start_time": psutil.Process(os.getpid()).create_time() if psutil is not None else 0.0,
    }
    try:
        lock_file(path, payload)
    except Blocker as exc:
        if exc.code == "browser_use_lock_already_held":
            raise Blocker("browser_use_recording_command_in_progress", path) from exc
        raise
    return path, token


def recording_command_exclusive(function):
    """Serialize all browser/recording commands bound to one descriptor."""
    @functools.wraps(function)
    def wrapped(args):
        config = read_toml()
        validate_installation(config)
        run_id = safe_id(args.run_id, "run_id")
        requested_session = validate_id(args.session, "session")
        session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
        descriptor = read_recording_descriptor(
            config,
            args.descriptor,
            run_id,
            session,
            # Helper generation adoption is an automatic, no-page-command
            # admission step.  The legacy flag remains accepted for callers,
            # but is no longer required to keep a live run aligned.
            allow_helper_hash_mismatch=True,
            allow_pinned_helper_reexec=False,
        )
        lock_path, lock_token = acquire_recording_command_lock(descriptor)
        try:
            descriptor = ensure_current_helper_generation(config, descriptor, os.path.realpath(args.descriptor))
            return function(args)
        finally:
            release_lock(lock_path, lock_token, lock_token)
    return wrapped


def operation_lineage_digest(descriptor: dict[str, Any]) -> str:
    """Bind new ledger rows to the run-owned browser resource lineage."""
    lineage = {
        "run_id": descriptor.get("run_id"),
        "session": descriptor.get("session"),
        "nonce": descriptor.get("nonce"),
        "profile": descriptor.get("profile"),
        "port": descriptor.get("port"),
        "authority_lineage_root_sha256": descriptor.get("authority_lineage_root_sha256"),
    }
    return hashlib.sha256(json.dumps(lineage, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()


def mark_navigation_readback_verified(descriptor: dict[str, Any], operation_id: str) -> None:
    """Persist the exact operation/lineage that established navigation proof."""
    if not re.fullmatch(r"[a-f0-9]{32}", str(operation_id)):
        raise Blocker("browser_use_navigation_readback_operation_id_invalid")
    lineage = descriptor.get("operation_lineage_digest") or operation_lineage_digest(descriptor)
    descriptor["navigation_verified"] = True
    descriptor["navigation_readback_operation_id"] = str(operation_id)
    descriptor["navigation_readback_lineage_digest"] = lineage
    descriptor["navigation_readback_helper_sha256"] = descriptor.get("helper_sha256")


def require_navigation_readback_binding(descriptor: dict[str, Any]) -> None:
    """Reject a stale boolean navigation flag without same-run ledger proof."""
    if descriptor.get("navigation_verified") is not True:
        raise Blocker("browser_use_target_requires_navigation_readback")
    operation_id = descriptor.get("navigation_readback_operation_id")
    lineage = descriptor.get("operation_lineage_digest") or operation_lineage_digest(descriptor)
    if (
        not isinstance(operation_id, str)
        or not re.fullmatch(r"[a-f0-9]{32}", operation_id)
        or descriptor.get("navigation_readback_lineage_digest") != lineage
        or descriptor.get("navigation_readback_helper_sha256") != descriptor.get("helper_sha256")
    ):
        raise Blocker("browser_use_navigation_readback_lineage_binding_invalid")
    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    matching = [row for row in rows if row.get("operation_id") == operation_id]
    if not matching or any(
        row.get("recording_run_id") != descriptor.get("run_id")
        or row.get("session") != descriptor.get("session")
        or row.get("recording_lineage_digest") != lineage
        for row in matching
    ):
        raise Blocker("browser_use_navigation_readback_lineage_binding_invalid")
    phases = {row.get("phase") for row in matching}
    if "intent" not in phases or "outcome" not in phases:
        raise Blocker("browser_use_navigation_readback_operation_incomplete")


def reconcile_operation_ledger_lock(descriptor: dict[str, Any]) -> None:
    """Recover only a dead, descriptor-bound append lock."""
    path = operation_ledger_lock_path(descriptor)
    if not os.path.lexists(path):
        return
    value = read_json_safe(path)
    if value.get("schema") != "browser-use-operation-ledger-lock.v1" or value.get("recording_run_id") != descriptor.get("run_id") or value.get("recording_nonce") != descriptor.get("nonce"):
        raise Blocker("browser_use_operation_ledger_lock_owner_unknown")
    pid = value.get("lock_pid")
    start_time = value.get("lock_start_time")
    if not isinstance(pid, int) or pid <= 0 or not isinstance(start_time, (int, float)):
        raise Blocker("browser_use_operation_ledger_lock_identity_invalid")
    alive = False
    try:
        process = psutil.Process(pid) if psutil is not None else None
        if process is not None:
            alive = process.is_running() and abs(float(process.create_time()) - float(start_time)) < 2.0
        else:
            os.kill(pid, 0)
            alive = True
    except (OSError, psutil.Error if psutil is not None else OSError):
        alive = False
    if alive:
        raise Blocker("browser_use_operation_ledger_lock_active")
    release_lock(path, str(value["run_id"]), str(value["nonce"]))


def _operation_ledger_rows(path: str) -> list[dict[str, Any]]:
    if not os.path.lexists(path):
        return []
    assert_regular_file(path, mode=0o600)
    rows: list[dict[str, Any]] = []
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            if not line.strip():
                continue
            try:
                row = json.loads(line)
            except json.JSONDecodeError as exc:
                raise Blocker("browser_use_operation_ledger_invalid") from exc
            if not isinstance(row, dict) or row.get("schema") != OPERATION_LEDGER_SCHEMA:
                raise Blocker("browser_use_operation_ledger_invalid")
            rows.append(row)
    previous = "0" * 64
    for expected_sequence, row in enumerate(rows, 1):
        if row.get("sequence") != expected_sequence or row.get("previous_chain_digest") != previous:
            raise Blocker("browser_use_operation_ledger_sequence_invalid")
        body = dict(row)
        chain = body.pop("chain_digest", None)
        expected_chain = hashlib.sha256((previous + json.dumps(body, sort_keys=True, separators=(",", ":"))).encode("utf-8")).hexdigest()
        if chain != expected_chain:
            raise Blocker("browser_use_operation_ledger_chain_invalid")
        previous = chain
    return rows


def _operation_ledger_reconciliation(descriptor: dict[str, Any]) -> list[dict[str, str]]:
    """Return the monotonic set of operations that still need reconciliation.

    Missing outcome proof is never interpreted as ``none``.  This function is
    intentionally derived from the append-only ledger and the bounded failure
    records so a later command cannot accidentally reopen an ambiguous effect.
    """
    try:
        rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    except Blocker as exc:
        # An unreadable, torn, foreign, or otherwise unsafe ledger is not an
        # empty ledger.  Effectful admission must stop until a workflow-owned
        # reconciliation restores trustworthy evidence.
        raise Blocker("browser_use_external_effect_reconciliation_required", exc.code) from exc

    intents: dict[str, dict[str, Any]] = {}
    outcomes: dict[str, dict[str, Any]] = {}
    reconciliations: dict[str, dict[str, Any]] = {}
    descriptor_reconciliations: set[str] = set()
    for item in descriptor.get("reconciliations", []):
        if not isinstance(item, dict) or item.get("resolution") not in {"none", "executed"}:
            continue
        for operation_id in item.get("operation_ids", []):
            if isinstance(operation_id, str):
                descriptor_reconciliations.add(operation_id)
    for row in rows:
        if row.get("recording_run_id") != descriptor.get("run_id") or row.get("session") != descriptor.get("session"):
            raise Blocker("browser_use_external_effect_reconciliation_required", "browser_use_operation_ledger_binding_invalid")
        operation_id = str(row.get("operation_id", ""))
        if row.get("phase") == "intent":
            intents[operation_id] = row
        elif row.get("phase") == "outcome":
            outcomes[operation_id] = row
        elif row.get("phase") == "reconciliation":
            reconciliations[operation_id] = row

    pending: list[dict[str, str]] = []
    for operation_id, intent in intents.items():
        outcome = outcomes.get(operation_id)
        reconciliation = reconciliations.get(operation_id)
        if operation_id in descriptor_reconciliations or (reconciliation is not None and str(reconciliation.get("external_effects")) in {"none", "executed"}):
            continue
        if outcome is None:
            pending.append({"operation_id": operation_id, "reason": "orphan_intent", "external_effects": "unknown"})
        elif str(outcome.get("external_effects")) == "unknown":
            pending.append({"operation_id": operation_id, "reason": "unknown_external_effect", "external_effects": "unknown"})

    for item in descriptor.get("failed_operations", []):
        if not isinstance(item, dict) or not item.get("external_action_possible"):
            continue
        operation_id = str(item.get("operation_id") or "failed-operation")
        reconciliation = reconciliations.get(operation_id)
        if operation_id in descriptor_reconciliations or (reconciliation is not None and str(reconciliation.get("external_effects")) in {"none", "executed"}):
            continue
        if not any(entry["operation_id"] == operation_id for entry in pending):
            pending.append({"operation_id": operation_id, "reason": "failed_external_action_possible", "external_effects": "unknown"})
    return pending


def pending_operation_reconciliation_ids(descriptor: dict[str, Any]) -> list[str]:
    return [entry["operation_id"] for entry in _operation_ledger_reconciliation(descriptor)]


def update_reconciliation_summary(descriptor: dict[str, Any], *, completed_blocker: str = "browser_use_reconciliation_completed") -> list[str]:
    """Persist an aggregate view that cannot claim completion with work pending."""
    pending = pending_operation_reconciliation_ids(descriptor)
    descriptor["pending_reconciliation"] = pending
    if pending:
        descriptor["reconciliation_state"] = "pending"
        descriptor["reconciliation_exact_blocker"] = "browser_use_external_effect_reconciliation_required"
    else:
        descriptor["reconciliation_state"] = "completed"
        descriptor["reconciliation_exact_blocker"] = completed_blocker
        # A prior dispatch/readback failure may have put the descriptor into
        # readback_pending.  Once the immutable ledger has an explicit
        # reconciliation result, leave that transient recovery state behind;
        # otherwise later status reads keep looking blocked even though there
        # is no operation left to reconcile.
        if descriptor.get("recovery_state") == "readback_pending":
            descriptor["recovery_state"] = "reconciled"
            descriptor["reconciliation_recovery_state"] = "reconciled"
            if "effectful_retry_allowed" in descriptor:
                descriptor["effectful_retry_allowed"] = True
    return pending


def require_no_pending_effect_reconciliation(descriptor: dict[str, Any], *, effectful: bool) -> None:
    """Deny a new external-effect operation while proof is incomplete."""
    if not effectful:
        return
    pending = pending_operation_reconciliation_ids(descriptor)
    if pending:
        raise Blocker("browser_use_external_effect_reconciliation_required", ",".join(pending[:12]))


def record_reconcile_operation_history(args: argparse.Namespace) -> int:
    """Close one old unknown-effect operation from owner-bound evidence only.

    This path never opens a browser, dispatches a command, changes a room, or
    removes a profile.  It exists for terminal recordings whose runtime has
    already been cleaned but whose historical operation still blocks a fresh
    run.  The evidence artifact must be produced by the owning workflow or
    another explicitly named source of truth; the helper never infers a
    ``none`` result from process absence.
    """
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    operation_id = str(args.operation_id)
    if not re.fullmatch(r"[a-f0-9]{32}", operation_id):
        raise Blocker("browser_use_history_reconciliation_operation_id_invalid")
    if args.resolution not in {"none", "executed"}:
        raise Blocker("browser_use_operation_reconciliation_resolution_invalid")
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_finalized=True,
        allow_helper_hash_mismatch=True,
        allow_expired_temporary=True,
        allow_stale_runtime_recovery=True,
        allow_history_reconciliation=True,
    )
    require_temporary_task_id(args, descriptor)
    recording_authority(config, descriptor, args.authority, cleanup_only=True)
    _require_history_terminal_readback(config, descriptor)
    pending = pending_operation_reconciliation_ids(descriptor)
    reconciled = {
        operation_id_item
        for item in descriptor.get("reconciliations", [])
        if isinstance(item, dict) and item.get("resolution") in {"none", "executed"}
        for operation_id_item in item.get("operation_ids", [])
        if isinstance(operation_id_item, str)
    }
    if operation_id not in pending:
        if operation_id in reconciled:
            print(json.dumps({
                "status": "recording_history_reconciliation_already_completed",
                "descriptor": os.path.realpath(args.descriptor),
                "run_id": run_id,
                "session": descriptor["session"],
                "operation_id": operation_id,
                "resolution": args.resolution,
                "pending_reconciliation": pending,
                "fresh_run_admission_allowed": not pending,
                "effectful_resume_allowed": not pending,
                "finalized": False,
            }, sort_keys=True))
            return 0
        raise Blocker("browser_use_history_reconciliation_operation_not_pending")

    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    operation_rows = [row for row in rows if row.get("operation_id") == operation_id]
    if not any(row.get("phase") == "intent" for row in operation_rows):
        raise Blocker("browser_use_history_reconciliation_operation_not_pending")
    outcome = next((row for row in operation_rows if row.get("phase") == "outcome"), None)
    if outcome is None or outcome.get("external_effects") != "unknown":
        raise Blocker("browser_use_history_reconciliation_outcome_not_unknown")
    evidence, evidence_sha256 = _read_history_reconciliation_evidence(
        config,
        descriptor,
        args.evidence_file,
        operation_id,
        args.resolution,
    )
    append_operation_reconciliation_durable(
        descriptor,
        operation_id=operation_id,
        external_effects=args.resolution,
        outcome="history_source_of_truth_reconciled",
    )
    descriptor.setdefault("reconciliations", []).append({
        "schema": HISTORY_RECONCILIATION_SCHEMA,
        "operation_ids": [operation_id],
        "resolution": args.resolution,
        "basis": "owner_bound_history_evidence",
        "evidence_path": os.path.realpath(args.evidence_file),
        "evidence_sha256": evidence_sha256,
        "source_system": evidence["source_system"],
        "source_ref_sha256": evidence["source_ref_sha256"],
        "recorded_at": iso(now_utc()),
    })
    remaining = update_reconciliation_summary(
        descriptor,
        completed_blocker="browser_use_history_reconciliation_completed",
    )
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_history_reconciliation_completed",
        next_action="fresh authority and fresh run after historical reconciliation",
        operation_id=operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    print(json.dumps({
        "status": "recording_history_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_id": operation_id,
        "resolution": args.resolution,
        "evidence_sha256": evidence_sha256,
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "effectful_resume_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_reconcile_read_only_orphan(args: argparse.Namespace) -> int:
    """Close one missing outcome whose durable intent was explicitly read-only.

    A missing outcome for an effectful command remains unknown.  Navigation
    and inspection commands are different: their durable intent already says
    ``external_effects=none`` and the ledger command shape is allowlisted as
    read-only.  This terminal, owner-bound path records that fact without
    replaying the browser command or changing runtime resources.
    """
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    operation_id = str(args.operation_id)
    if not re.fullmatch(r"[a-f0-9]{32}", operation_id):
        raise Blocker("browser_use_read_only_orphan_operation_id_invalid")
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_finalized=True,
        allow_helper_hash_mismatch=True,
        allow_expired_temporary=True,
        allow_stale_runtime_recovery=True,
        allow_history_reconciliation=True,
    )
    require_temporary_task_id(args, descriptor)
    recording_authority(config, descriptor, args.authority, cleanup_only=True)
    _require_history_terminal_readback(config, descriptor)
    pending = pending_operation_reconciliation_ids(descriptor)
    reconciled = {
        operation_id_item
        for item in descriptor.get("reconciliations", [])
        if isinstance(item, dict) and item.get("resolution") in {"none", "executed"}
        for operation_id_item in item.get("operation_ids", [])
        if isinstance(operation_id_item, str)
    }
    if operation_id not in pending:
        if operation_id in reconciled:
            print(json.dumps({
                "status": "recording_read_only_orphan_reconciliation_already_completed",
                "descriptor": os.path.realpath(args.descriptor),
                "run_id": run_id,
                "session": descriptor["session"],
                "operation_id": operation_id,
                "resolution": "none",
                "pending_reconciliation": pending,
                "fresh_run_admission_allowed": not pending,
                "effectful_resume_allowed": not pending,
                "finalized": False,
            }, sort_keys=True))
            return 0
        raise Blocker("browser_use_read_only_orphan_operation_not_pending")

    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    matching = [row for row in rows if row.get("operation_id") == operation_id]
    intent = next((row for row in matching if row.get("phase") == "intent"), None)
    outcome = next((row for row in matching if row.get("phase") == "outcome"), None)
    command = intent.get("command") if isinstance(intent, dict) else None
    if outcome is not None:
        raise Blocker("browser_use_read_only_orphan_outcome_already_present")
    if not isinstance(intent, dict) or intent.get("external_effects") != "none":
        raise Blocker("browser_use_read_only_orphan_original_effect_not_none")
    if not _durable_read_only_intent(intent):
        raise Blocker("browser_use_read_only_orphan_command_not_allowlisted")
    append_operation_outcome_durable(
        descriptor,
        operation_id=operation_id,
        command=["recovery-read-only"],
        external_effects="none",
        outcome="read_only_orphan_closed_by_owner_reconcile",
    )
    descriptor.setdefault("reconciliations", []).append({
        "schema": "browser-use-operation-reconciliation.v1",
        "operation_ids": [operation_id],
        "resolution": "none",
        "basis": "durable_read_only_intent_classification",
        "recorded_at": iso(now_utc()),
    })
    remaining = update_reconciliation_summary(
        descriptor,
        completed_blocker="browser_use_read_only_orphan_reconciliation_completed",
    )
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_read_only_orphan_reconciliation_completed",
        next_action="fresh authority and fresh run after read-only orphan reconciliation",
        operation_id=operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    print(json.dumps({
        "status": "recording_read_only_orphan_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_id": operation_id,
        "resolution": "none",
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "effectful_resume_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def _read_history_reconciliation_evidence(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    path: str,
    operation_id: str,
    resolution: str,
) -> tuple[dict[str, Any], str]:
    """Read an owner-bound source-of-truth receipt without browser dispatch.

    History reconciliation is intentionally stricter than same-run readback:
    absence of a browser process is not proof that an old click had no effect.
    The caller must provide an immutable, secret-free evidence artifact bound
    to this exact run/session/operation and to the selected resolution.
    """
    canonical = os.path.realpath(path)
    recording_root = os.path.realpath(str(descriptor["recording_dir"]))
    receipts_root = os.path.realpath(str(config["roots"]["receipts"]))
    if not (
        canonical.startswith(recording_root + os.sep)
        or canonical.startswith(receipts_root + os.sep)
    ):
        raise Blocker("browser_use_history_reconciliation_evidence_scope_mismatch")
    assert_regular_file(canonical, mode=0o600)
    evidence = read_json_safe(canonical)
    if evidence.get("schema") != HISTORY_RECONCILIATION_SCHEMA:
        raise Blocker("browser_use_history_reconciliation_evidence_schema_invalid")
    if evidence.get("run_id") != descriptor.get("run_id") or evidence.get("session") != descriptor.get("session"):
        raise Blocker("browser_use_history_reconciliation_evidence_binding_mismatch")
    if evidence.get("operation_id") != operation_id or evidence.get("resolution") != resolution:
        raise Blocker("browser_use_history_reconciliation_evidence_operation_mismatch")
    if evidence.get("external_effects") != resolution or resolution not in {"none", "executed"}:
        raise Blocker("browser_use_history_reconciliation_evidence_effect_mismatch")
    source_system = evidence.get("source_system")
    source_ref_sha256 = evidence.get("source_ref_sha256")
    if not isinstance(source_system, str) or not re.fullmatch(r"[A-Za-z][A-Za-z0-9_.:-]{1,127}", source_system):
        raise Blocker("browser_use_history_reconciliation_evidence_source_invalid")
    if not isinstance(source_ref_sha256, str) or not re.fullmatch(r"[0-9a-f]{64}", source_ref_sha256):
        raise Blocker("browser_use_history_reconciliation_evidence_source_invalid")
    return evidence, sha256_file(canonical)


def _require_history_terminal_readback(config: dict[str, Any], descriptor: dict[str, Any]) -> None:
    """Prove the old runtime is terminal before allowing ledger-only repair."""
    if descriptor.get("status") in {"active", "continued"}:
        raise Blocker("browser_use_history_reconciliation_requires_terminal_state")
    if descriptor.get("owned_chrome") is True:
        process_live, process_blocker = _diagnostic_process_liveness(config, descriptor)
        if process_live is True:
            raise Blocker("browser_use_history_reconciliation_process_live")
        if process_blocker and process_live is not False:
            raise Blocker("browser_use_history_reconciliation_process_readback_uncertain", process_blocker)
        assert_debug_listener_absent(int(descriptor["port"]))
    if any(os.path.lexists(path) for path in descriptor.get("lock_paths", [])):
        raise Blocker("browser_use_history_reconciliation_locks_remain")
    room_id = descriptor.get("room_id")
    if room_id:
        room = room_registry_lookup(config, room_id)
        if room is None or room.get("state") != "released":
            raise Blocker("browser_use_history_reconciliation_room_not_released")


def append_operation_intent_durable(descriptor: dict[str, Any], *, operation_id: str, command: list[str], external_effects: str, outcome: str) -> dict[str, Any]:
    """Append and reread an intent before any browser dispatch."""
    row = append_operation_ledger(
        descriptor,
        operation_id=operation_id,
        phase="intent",
        command=command,
        external_effects=external_effects,
        outcome=outcome,
    )
    try:
        rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    except Blocker as exc:
        try:
            write_recovery_checkpoint(
                descriptor,
                exact_blocker="browser_use_operation_intent_durability_unverified",
                next_action="same-run ledger reconciliation before any dispatch",
                operation_id=operation_id,
            )
        except Exception:
            pass
        raise Blocker("browser_use_operation_intent_durability_unverified", exc.code) from exc
    if not any(item.get("operation_id") == operation_id and item.get("phase") == "intent" for item in rows):
        raise Blocker("browser_use_operation_intent_durability_unverified")
    return row


def append_operation_outcome_durable(descriptor: dict[str, Any], *, operation_id: str, command: list[str], external_effects: str, outcome: str) -> dict[str, Any] | None:
    """Append one outcome and prove it is visible, retrying only the append.

    The retry never dispatches the browser command again.  If the outcome still
    cannot be proven, the checkpoint keeps the run in reconciliation-required
    state and the caller must stop.
    """
    last_error: Blocker | None = None
    for _attempt in range(2):
        try:
            rows = _operation_ledger_rows(operation_ledger_path(descriptor))
            existing = next((item for item in rows if item.get("operation_id") == operation_id and item.get("phase") == "outcome"), None)
            if existing is not None:
                return existing
            append_operation_ledger(
                descriptor,
                operation_id=operation_id,
                phase="outcome",
                command=command,
                external_effects=external_effects,
                outcome=outcome,
            )
            rows = _operation_ledger_rows(operation_ledger_path(descriptor))
            existing = next((item for item in rows if item.get("operation_id") == operation_id and item.get("phase") == "outcome"), None)
            if existing is not None:
                return existing
        except Blocker as exc:
            last_error = exc
    try:
        write_recovery_checkpoint(
            descriptor,
            exact_blocker="browser_use_operation_outcome_append_failed",
            next_action="same-run ledger reconciliation before any retry",
            operation_id=operation_id,
        )
    except Exception:
        pass
    detail = last_error.code if last_error is not None else "outcome_not_visible"
    raise Blocker("browser_use_operation_outcome_append_failed", detail)


def append_operation_reconciliation_durable(descriptor: dict[str, Any], *, operation_id: str, external_effects: str, outcome: str) -> dict[str, Any] | None:
    """Append one explicit reconciliation without rewriting the original outcome."""
    if external_effects not in {"none", "executed"}:
        raise Blocker("browser_use_operation_reconciliation_resolution_invalid")
    path = operation_ledger_path(descriptor)
    for _attempt in range(2):
        try:
            rows = _operation_ledger_rows(path)
            existing = next((item for item in rows if item.get("operation_id") == operation_id and item.get("phase") == "reconciliation"), None)
            if existing is not None:
                return existing
            append_operation_ledger(
                descriptor,
                operation_id=operation_id,
                phase="reconciliation",
                command=["reconciliation"],
                external_effects=external_effects,
                outcome=outcome,
            )
            rows = _operation_ledger_rows(path)
            existing = next((item for item in rows if item.get("operation_id") == operation_id and item.get("phase") == "reconciliation"), None)
            if existing is not None:
                return existing
        except Blocker:
            continue
    raise Blocker("browser_use_operation_reconciliation_append_failed")


def _durable_read_only_intent(intent: dict[str, Any] | None) -> bool:
    """Recognize current and legacy ledger shapes for navigation-only intents."""
    if not isinstance(intent, dict) or intent.get("external_effects") != "none":
        return False
    command = intent.get("command")
    if not isinstance(command, dict):
        return False
    if command.get("read_only") is True:
        return True
    name = command.get("name")
    argument_count = command.get("argument_count")
    argument_shapes = command.get("argument_shapes")
    return (
        (name == "open" and argument_count == 1 and argument_shapes == ["url"])
        or (name == "back" and argument_count == 0 and argument_shapes == [])
        or (name == "switch" and argument_count == 1 and argument_shapes == ["scalar"])
    )


def close_orphan_operation_intents(descriptor: dict[str, Any]) -> list[str]:
    """Close only provably read-only orphan intents without creating a loop.

    A recovery probe is itself allowed to be interrupted, but a missing
    outcome for a ``none`` operation is not an unknown external effect. Keep
    the conservative unknown gate for every effectful or otherwise ambiguous
    intent while making read-only recovery idempotent.
    """
    pending = _operation_ledger_reconciliation(descriptor)
    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    intents = {
        str(row.get("operation_id")): row
        for row in rows
        if row.get("phase") == "intent"
    }
    for entry in pending:
        if entry["reason"] != "orphan_intent":
            continue
        operation_id = entry["operation_id"]
        intent = intents.get(operation_id) or {}
        command = intent.get("command") if isinstance(intent, dict) else None
        read_only_orphan = _durable_read_only_intent(intent)
        append_operation_outcome_durable(
            descriptor,
            operation_id=operation_id,
            command=["recovery-read-only" if read_only_orphan else "recovery"],
            external_effects="none" if read_only_orphan else "unknown",
            outcome="read_only_orphan_closed_by_recover" if read_only_orphan else "orphan_intent_closed_by_recover",
        )
    return pending_operation_reconciliation_ids(descriptor)


def _navigation_reconciliation_candidate(rows: list[dict[str, Any]], operation_id: str, *, expected_lineage_digest: str | None = None) -> tuple[dict[str, Any], dict[str, Any]]:
    """Validate the narrow, read-only navigation intent eligible for reconciliation.

    The ledger intentionally stores command shape rather than URL text.  This
    helper therefore admits only an original ``open`` intent that was already
    classified as having no external effect, followed by the bounded recovery
    outcome that left the effect state unknown.  It must never be used to
    reinterpret a click, form submission, upload, or other effectful command.
    """
    if not re.fullmatch(r"[a-f0-9]{32}", str(operation_id)):
        raise Blocker("browser_use_navigation_reconciliation_operation_id_invalid")
    intents = {
        str(row.get("operation_id")): row
        for row in rows
        if row.get("phase") == "intent"
    }
    outcomes = {
        str(row.get("operation_id")): row
        for row in rows
        if row.get("phase") == "outcome"
    }
    intent = intents.get(operation_id)
    outcome = outcomes.get(operation_id)
    if intent is None or outcome is None:
        raise Blocker("browser_use_navigation_reconciliation_operation_missing")
    if expected_lineage_digest is not None and (
        intent.get("recording_lineage_digest") != expected_lineage_digest
        or outcome.get("recording_lineage_digest") != expected_lineage_digest
    ):
        raise Blocker("browser_use_navigation_reconciliation_lineage_binding_invalid")
    command = intent.get("command")
    if not isinstance(command, dict) or command.get("name") != "open":
        raise Blocker("browser_use_navigation_reconciliation_operation_not_open")
    if command.get("argument_count") != 1 or command.get("argument_shapes") != ["url"]:
        raise Blocker("browser_use_navigation_reconciliation_open_shape_invalid")
    if intent.get("external_effects") != "none":
        raise Blocker("browser_use_navigation_reconciliation_original_effect_not_none")
    if outcome.get("external_effects") != "unknown" or outcome.get("outcome") not in {
        "orphan_intent_closed_by_recover",
        "navigation_readback_failed",
    }:
        raise Blocker("browser_use_navigation_reconciliation_outcome_mismatch")
    return intent, outcome


def _target_click_reconciliation_candidate(rows: list[dict[str, Any]], operation_id: str) -> tuple[dict[str, Any], dict[str, Any]]:
    """Validate the helper-rejected target click eligible for live reconciliation."""
    if not re.fullmatch(r"[a-f0-9]{32}", str(operation_id)):
        raise Blocker("browser_use_target_reconciliation_operation_id_invalid")
    intents = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "intent"}
    outcomes = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "outcome"}
    intent = intents.get(operation_id)
    outcome = outcomes.get(operation_id)
    if intent is None or outcome is None:
        raise Blocker("browser_use_target_reconciliation_operation_missing")
    command = intent.get("command")
    if not isinstance(command, dict) or command.get("name") != "target-click":
        raise Blocker("browser_use_target_reconciliation_operation_not_target_click")
    if intent.get("external_effects") != "unknown":
        raise Blocker("browser_use_target_reconciliation_original_effect_not_unknown")
    if outcome.get("external_effects") != "unknown" or outcome.get("outcome") != "browser_use_target_click_failed":
        raise Blocker("browser_use_target_reconciliation_outcome_mismatch")
    return intent, outcome


def _coordinate_click_reconciliation_candidate(rows: list[dict[str, Any]], operation_id: str) -> tuple[dict[str, Any], dict[str, Any]]:
    """Validate an effectful click whose readback was late.

    Target clicks use the same bounded live URL/state proof as coordinate
    clicks when the Browser Use semantic post-click payload is unavailable.
    The reconciliation path never replays the original click.
    """
    if not re.fullmatch(r"[a-f0-9]{32}", str(operation_id)):
        raise Blocker("browser_use_click_reconciliation_operation_id_invalid")
    intents = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "intent"}
    outcomes = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "outcome"}
    intent = intents.get(operation_id)
    outcome = outcomes.get(operation_id)
    if intent is None or outcome is None:
        raise Blocker("browser_use_click_reconciliation_operation_missing")
    command = intent.get("command")
    if not isinstance(command, dict):
        raise Blocker("browser_use_click_reconciliation_operation_not_coordinate_click")
    if command.get("name") == "target-click":
        if outcome.get("outcome") not in {
            "browser_use_semantic_readback_json_missing",
            "browser_use_target_click_readback_failed",
            "browser_use_target_post_click_readback_failed",
        }:
            raise Blocker("browser_use_click_reconciliation_outcome_mismatch")
        return intent, outcome
    if command.get("name") != "click" or command.get("argument_count") not in {1, 2} or command.get("argument_shapes") not in (["scalar"], ["scalar", "scalar"]):
        raise Blocker("browser_use_click_reconciliation_operation_not_coordinate_click")
    if intent.get("external_effects") != "unknown":
        raise Blocker("browser_use_click_reconciliation_original_effect_not_unknown")
    if outcome.get("external_effects") != "unknown" or outcome.get("outcome") not in {
        "post_dispatch_navigation_readback_failed",
        # A coordinate click can fail before the Browser Use CLI returns its
        # post-dispatch readback.  Keep the effect unknown, but allow the
        # same strict URL/state proof path to reconcile that late outcome.
        "dispatch_failed",
    }:
        raise Blocker("browser_use_click_reconciliation_outcome_mismatch")
    return intent, outcome


def _no_dispatch_reconciliation_candidate(rows: list[dict[str, Any]], operation_id: str) -> tuple[dict[str, Any], dict[str, Any]]:
    """Validate a click/upload that failed before its input dispatch."""
    if not re.fullmatch(r"[a-f0-9]{32}", str(operation_id)):
        raise Blocker("browser_use_no_dispatch_reconciliation_operation_id_invalid")
    intents = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "intent"}
    outcomes = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "outcome"}
    intent = intents.get(operation_id)
    outcome = outcomes.get(operation_id)
    if intent is None or outcome is None:
        raise Blocker("browser_use_no_dispatch_reconciliation_operation_missing")
    command = intent.get("command")
    if not isinstance(command, dict) or command.get("name") not in NO_DISPATCH_PROOF_COMMANDS:
        raise Blocker("browser_use_no_dispatch_reconciliation_command_unsupported")
    if intent.get("external_effects") != "unknown":
        raise Blocker("browser_use_no_dispatch_reconciliation_original_effect_not_unknown")
    if outcome.get("external_effects") != "unknown" or outcome.get("outcome") != "dispatch_failed":
        raise Blocker("browser_use_no_dispatch_reconciliation_outcome_mismatch")
    return intent, outcome


def _eval_syntax_error_reconciliation_candidate(rows: list[dict[str, Any]], operation_id: str) -> tuple[dict[str, Any], dict[str, Any]]:
    """Validate an eval that failed in the Browser Use CLI parser before page dispatch.

    This is intentionally narrower than a general eval reconciliation.  It
    accepts only the one-argument eval shape and the exact dispatch-failed
    ledger outcome produced by the old helper.  The caller must also provide
    the CLI's syntax-error evidence code and a fresh same-run page readback.
    """
    if not re.fullmatch(r"[a-f0-9]{32}", str(operation_id)):
        raise Blocker("browser_use_eval_reconciliation_operation_id_invalid")
    intents = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "intent"}
    outcomes = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "outcome"}
    intent = intents.get(operation_id)
    outcome = outcomes.get(operation_id)
    if intent is None or outcome is None:
        raise Blocker("browser_use_eval_reconciliation_operation_missing")
    command = intent.get("command")
    if not isinstance(command, dict) or command.get("name") != "eval":
        raise Blocker("browser_use_eval_reconciliation_operation_not_eval")
    if command.get("argument_count") != 1 or command.get("argument_shapes") != ["scalar"]:
        raise Blocker("browser_use_eval_reconciliation_eval_shape_invalid")
    if intent.get("external_effects") != "unknown":
        raise Blocker("browser_use_eval_reconciliation_original_effect_not_unknown")
    if outcome.get("external_effects") != "unknown" or outcome.get("outcome") != "dispatch_failed":
        raise Blocker("browser_use_eval_reconciliation_outcome_mismatch")
    return intent, outcome


def append_operation_ledger(descriptor: dict[str, Any], *, operation_id: str, phase: str, command: list[str], external_effects: str, outcome: str = "") -> dict[str, Any]:
    """Append one fsynced, secret-free intent/outcome row before/after dispatch."""
    if not re.fullmatch(r"[a-f0-9]{32}", str(operation_id)):
        raise Blocker("browser_use_operation_id_invalid")
    if phase not in {"intent", "outcome", "reconciliation"} or external_effects not in OPERATION_EFFECT_STATES:
        raise Blocker("browser_use_operation_ledger_entry_invalid")
    if not isinstance(command, list) or not command or not isinstance(command[0], str):
        raise Blocker("browser_use_operation_ledger_command_invalid")
    path = operation_ledger_path(descriptor)
    parent = os.path.dirname(path)
    assert_directory(parent, create=True)
    lock_path = operation_ledger_lock_path(descriptor)
    reconcile_operation_ledger_lock(descriptor)
    lock_token = f"operation-ledger-{os.getpid()}-{uuid.uuid4().hex}"
    lock_file(lock_path, {"schema": "browser-use-operation-ledger-lock.v1", "run_id": lock_token, "nonce": lock_token, "recording_run_id": descriptor.get("run_id"), "recording_nonce": descriptor.get("nonce"), "lock_pid": os.getpid(), "lock_start_time": psutil.Process(os.getpid()).create_time() if psutil is not None else 0.0})
    try:
        rows = _operation_ledger_rows(path)
        lineage_digest = operation_lineage_digest(descriptor)
        if descriptor.get("operation_lineage_digest") and descriptor["operation_lineage_digest"] != lineage_digest:
            raise Blocker("browser_use_operation_ledger_lineage_binding_invalid")
        for row in rows:
            if row.get("recording_run_id") != descriptor.get("run_id") or row.get("session") != descriptor.get("session"):
                raise Blocker("browser_use_operation_ledger_binding_invalid")
            if descriptor.get("operation_lineage_digest") and row.get("recording_lineage_digest") != descriptor["operation_lineage_digest"]:
                raise Blocker("browser_use_operation_ledger_lineage_binding_invalid")
        matching = [row for row in rows if row.get("operation_id") == operation_id]
        if phase == "intent" and matching:
            raise Blocker("browser_use_operation_id_replay")
        if phase == "outcome" and not any(row.get("phase") == "intent" for row in matching):
            raise Blocker("browser_use_operation_intent_missing")
        if phase == "outcome" and any(row.get("phase") == "outcome" for row in matching):
            raise Blocker("browser_use_operation_outcome_replay")
        if phase == "reconciliation" and any(row.get("phase") == "reconciliation" for row in matching):
            raise Blocker("browser_use_operation_reconciliation_replay")
        if phase == "reconciliation" and not matching:
            failed_operation = next(
                (
                    item
                    for item in descriptor.get("failed_operations", [])
                    if isinstance(item, dict) and str(item.get("operation_id") or "failed-operation") == operation_id
                ),
                None,
            )
            if failed_operation is None:
                raise Blocker("browser_use_operation_reconciliation_target_missing")
        previous = rows[-1].get("chain_digest", "0" * 64) if rows else "0" * 64
        body = {
            "schema": OPERATION_LEDGER_SCHEMA,
            "sequence": len(rows) + 1,
            "event_id": uuid.uuid4().hex,
            "operation_id": operation_id,
            "phase": phase,
            "command": _ledger_public_command(command),
            "external_effects": external_effects,
            "outcome": str(outcome or "")[:160],
            "recorded_at": iso(now_utc()),
            "previous_chain_digest": previous,
            "recording_run_id": str(descriptor.get("run_id", "")),
            "session": str(descriptor.get("session", "")),
            "recording_lineage_digest": descriptor.get("operation_lineage_digest") or lineage_digest,
        }
        body["chain_digest"] = hashlib.sha256((previous + json.dumps(body, sort_keys=True, separators=(",", ":"))).encode("utf-8")).hexdigest()
        fd = os.open(path, os.O_CREAT | os.O_APPEND | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0), 0o600)
        try:
            os.write(fd, (json.dumps(body, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8"))
            os.fsync(fd)
        finally:
            os.close(fd)
        os.chmod(path, 0o600)
        return body
    finally:
        release_lock(lock_path, lock_token, lock_token)


def operation_effect_summary(descriptor: dict[str, Any]) -> str:
    """Reduce the durable operation trail without treating missing proof as none."""
    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    if not rows:
        if any(bool(item.get("external_action_possible")) for item in descriptor.get("failed_operations", []) if isinstance(item, dict)):
            return "unknown"
        return "none"
    outcomes: dict[str, str] = {}
    for row in rows:
        if row.get("recording_run_id") != descriptor.get("run_id") or row.get("session") != descriptor.get("session"):
            raise Blocker("browser_use_operation_ledger_binding_invalid")
        if row.get("phase") == "outcome":
            outcomes[str(row["operation_id"])] = str(row.get("external_effects"))
        elif row.get("phase") == "reconciliation":
            outcomes[str(row["operation_id"])] = str(row.get("external_effects"))
    for item in descriptor.get("reconciliations", []):
        if not isinstance(item, dict) or item.get("resolution") not in {"none", "executed"}:
            continue
        for operation_id in item.get("operation_ids", []):
            if isinstance(operation_id, str):
                outcomes[operation_id] = "executed" if item.get("resolution") == "executed" else "none"
    intent_ids = {str(row["operation_id"]) for row in rows if row.get("phase") == "intent"}
    if intent_ids - set(outcomes):
        return "unknown"
    values = set(outcomes.values())
    if "unknown" in values:
        return "unknown"
    if "executed" in values:
        return "executed"
    return "none"


def write_recovery_checkpoint(descriptor: dict[str, Any], *, exact_blocker: str, next_action: str, operation_id: str | None = None) -> str:
    """Persist a non-authoritative, secret-free restart hint for the next run."""
    path = os.path.join(os.path.realpath(descriptor["recording_dir"]), "recovery-checkpoint.json")
    ledger_readback_blocker: str | None = None
    try:
        rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    except Blocker as exc:
        # Preserve the checkpoint even when the ledger itself is damaged.  The
        # checkpoint is not a proof of completion; it only records that the
        # next operation must perform workflow-owned reconciliation.
        rows = []
        ledger_readback_blocker = exc.code
    payload = {
        "schema": "browser-use-recovery-checkpoint.v1",
        "run_id": descriptor.get("run_id"),
        "session": descriptor.get("session"),
        "stage": "recovering",
        "operation_id": operation_id,
        "exact_blocker": str(exact_blocker)[:160],
        "next_action": str(next_action)[:160],
        "retry_count": int(descriptor.get("recovery_retry_count", 0)),
        "ledger_tail_digest": rows[-1].get("chain_digest") if rows else "0" * 64,
        "ledger_readback_blocker": ledger_readback_blocker,
        "updated_at": iso(now_utc()),
    }
    json_atomic_replace(path, payload)
    descriptor["checkpoint_path"] = path
    return path


def read_json_safe(path: str) -> dict[str, Any]:
    assert_regular_file(path, mode=0o600)
    with open(path, "rb") as handle:
        value = json.load(handle)
    if not isinstance(value, dict):
        raise Blocker("browser_use_json_object_required", path)
    return value


def task_resume_root(config: dict[str, Any]) -> str:
    """Return the private, task-scoped resume index root."""
    root = os.path.join(config["roots"]["browser_use_home"], "task-resume")
    assert_directory(root, create=True)
    return root


def task_resume_path(config: dict[str, Any], task_id: str) -> str:
    task_id = safe_id(task_id, "task_id")
    return os.path.join(task_resume_root(config), f"{task_id}.json")


def _resume_safe_path(config: dict[str, Any], value: Any) -> str | None:
    """Keep only canonical paths inside helper-owned roots in the index."""
    if not isinstance(value, str) or not value or not os.path.isabs(value):
        return None
    path = os.path.realpath(value)
    root_values = config.get("roots", {})
    allowed_roots = [
        root_values.get(name)
        for name in (
            "browser_use_home",
            "temporary_profiles",
            "single_use_profiles",
            "scheduled_profiles",
            "recordings",
            "receipts",
            "downloads",
        )
        if isinstance(root_values.get(name), str)
    ]
    if any(path == os.path.realpath(root) or path.startswith(os.path.realpath(root) + os.sep) for root in allowed_roots):
        return path
    return None


def _resume_optional_id(value: Any) -> str | None:
    if not isinstance(value, str) or not value.strip():
        return None
    try:
        return safe_id(value.strip(), "resume_id")
    except Blocker:
        return None


def _resume_safe_hint(value: Any, *, field: str) -> str | None:
    """Project only bounded, secret-free diagnostic hints into the index."""
    if not isinstance(value, str) or not value.strip():
        return None
    text = value.strip()[:160]
    if field == "exact_blocker":
        return text if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,159}", text) else None
    if re.search(
        r"(?:password|passwd|token|cookie|secret|bearer|authorization|api[_-]?key|jwt)\s*[:=]"
        r"|https?://[^\s?]+\?[^\s]*",
        text,
        re.IGNORECASE,
    ):
        return "redacted"
    return text


def _resume_source_thread_id(descriptor: dict[str, Any]) -> str | None:
    owner = descriptor.get("owner_metadata")
    candidates = [
        descriptor.get("source_thread_id"),
        owner.get("thread_id") if isinstance(owner, dict) else None,
        os.environ.get("CODEX_THREAD_ID"),
    ]
    for candidate in candidates:
        value = _resume_optional_id(candidate)
        if value:
            return value
    return None


def owner_completion_receipt(
    descriptor: dict[str, Any],
    *,
    command: list[str],
    readback_exit: int | None,
    consumed_at: str | None = None,
) -> dict[str, Any]:
    """Create durable, owner-bound handoff completion metadata.

    The receipt records that the one-time human signal was consumed after a
    successful same-session command/readback.  It is explicitly not an auth
    proof and never sends a signal to another thread or service.
    """
    command_digest = hashlib.sha256(
        json.dumps(command, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    owner_metadata = descriptor.get("owner_metadata") if isinstance(descriptor.get("owner_metadata"), dict) else {}
    return {
        "schema": OWNER_COMPLETION_RECEIPT_SCHEMA,
        "run_id": descriptor.get("run_id"),
        "session": descriptor.get("session"),
        "nonce": descriptor.get("nonce"),
        "task_id": descriptor.get("task_id"),
        "source_thread_id": _resume_source_thread_id(descriptor),
        "owner_thread_id": owner_metadata.get("thread_id"),
        "owner_host_id": owner_metadata.get("host_id"),
        "signal_kind": "human_completion",
        "state": "consumed_not_auth_proof",
        "auth_proof": False,
        "external_signal_sent": False,
        "command_digest": command_digest,
        "readback_exit": readback_exit,
        "consumed_at": consumed_at or iso(now_utc()),
    }


def _resume_checkpoint_state(descriptor: dict[str, Any]) -> str:
    if descriptor.get("authentication_state") == "waiting":
        return "waiting_auth"
    status = str(descriptor.get("status") or "unknown")
    if status in {"active", "claimed", "continued", "stale", "cleanup_pending", "finalized"}:
        return status
    return "unknown"


def _resume_checkpoint_from_descriptor(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    descriptor_path: str,
    *,
    state: str | None = None,
    exact_blocker: str | None = None,
    next_action: str | None = None,
    restart_point: str | None = None,
) -> dict[str, Any] | None:
    task_id = descriptor.get("task_id")
    if not isinstance(task_id, str) or not task_id:
        return None
    task_id = safe_id(task_id, "task_id")
    existing: dict[str, Any] = {}
    checkpoint_path = task_resume_path(config, task_id)
    if os.path.lexists(checkpoint_path):
        try:
            existing = read_json_safe(checkpoint_path)
        except (Blocker, OSError, ValueError, json.JSONDecodeError):
            existing = {}
    origins = descriptor.get("target_origins") or descriptor.get("origins") or []
    safe_origins = sorted({normalize_origin(item) for item in origins if isinstance(item, str)})
    account_identity = descriptor.get("account_identity")
    account_digest = hashlib.sha256(str(account_identity).encode("utf-8")).hexdigest() if account_identity else existing.get("account_identity_sha256")
    current_state = state or _resume_checkpoint_state(descriptor)
    profile = _resume_safe_path(config, descriptor.get("profile"))
    source_descriptor = _resume_safe_path(config, descriptor_path)
    source_thread_id = _resume_source_thread_id(descriptor) or existing.get("source_thread_id")
    created_at = existing.get("created_at") if isinstance(existing.get("created_at"), str) else iso(now_utc())
    authentication_wait = descriptor.get("authentication_wait")
    authentication_wait = authentication_wait if isinstance(authentication_wait, dict) else {}
    authentication_state = descriptor.get("authentication_state")
    auth_waiting = authentication_state == "waiting" or authentication_wait.get("state") == "waiting"
    exact_candidates = (
        [exact_blocker] if exact_blocker is not None else []
    ) + (
        [authentication_wait.get("exact_blocker")] if auth_waiting else []
    ) + [descriptor.get("exact_blocker"), existing.get("exact_blocker")]
    next_candidates = (
        [next_action] if next_action is not None else []
    ) + (
        [authentication_wait.get("next_action")] if auth_waiting else []
    ) + [descriptor.get("next_action"), existing.get("next_action")]
    restart_candidates = [restart_point, existing.get("restart_point")]
    projected_exact_blocker = next(
        (hint for candidate in exact_candidates if (hint := _resume_safe_hint(candidate, field="exact_blocker"))),
        None,
    )
    projected_next_action = next(
        (hint for candidate in next_candidates if (hint := _resume_safe_hint(candidate, field="next_action"))),
        None,
    )
    projected_restart_point = next(
        (hint for candidate in restart_candidates if (hint := _resume_safe_hint(candidate, field="restart_point"))),
        None,
    )
    current_state = current_state if current_state in {"active", "claimed", "continued", "stale", "cleanup_pending", "finalized", "waiting_auth"} else "unknown"
    projected_authentication_state = authentication_state if authentication_state in {"waiting", "authenticated"} else (
        authentication_wait.get("state") if authentication_wait.get("state") in {"waiting", "authenticated"} else None
    )
    if projected_authentication_state is not None:
        # State is authoritative. Do not let a stale descriptor/checkpoint
        # next_action ask for login again after authentication was verified.
        projected_next_action = authentication_next_action(projected_authentication_state)
    return {
        "schema": TASK_RESUME_CHECKPOINT_SCHEMA,
        "version": TASK_RESUME_CHECKPOINT_VERSION,
        "task_id": task_id,
        "automation_id": descriptor.get("automation_id") if isinstance(descriptor.get("automation_id"), str) else "manual",
        "mode": descriptor.get("mode") if isinstance(descriptor.get("mode"), str) else "authorized",
        "lifecycle": descriptor.get("lifecycle") if isinstance(descriptor.get("lifecycle"), str) else TEMPORARY_LIFECYCLE,
        "target_origins": safe_origins,
        "account_identity_sha256": account_digest,
        "source_thread_id": source_thread_id,
        "run_id": descriptor.get("run_id") if isinstance(descriptor.get("run_id"), str) else None,
        "requested_session": descriptor.get("requested_session") if isinstance(descriptor.get("requested_session"), str) else None,
        "session": descriptor.get("session") if isinstance(descriptor.get("session"), str) else None,
        "descriptor_path": source_descriptor,
        "recording_dir": _resume_safe_path(config, descriptor.get("recording_dir")),
        "profile": profile,
        "port": descriptor.get("port") if isinstance(descriptor.get("port"), int) else None,
        "room_id": descriptor.get("room_id") if isinstance(descriptor.get("room_id"), str) else None,
        "recording_finalized": descriptor.get("recording_finalized"),
        "cleanup_completed": descriptor.get("cleanup_completed"),
        "completion_status": descriptor.get("completion_status"),
        "completion_blocker": descriptor.get("completion_blocker") or descriptor.get("finalize_failure"),
        "owner_completion": descriptor.get("owner_completion_receipt") if isinstance(descriptor.get("owner_completion_receipt"), dict) else None,
        "state": current_state,
        "authentication_state": projected_authentication_state,
        "exact_blocker": projected_exact_blocker,
        "next_action": projected_next_action,
        "restart_point": projected_restart_point or (
            "same descriptor/room; fresh process, authority, and readback checks required"
            if current_state in {"active", "claimed", "continued", "waiting_auth"}
            else "new authorized handoff for the same task_id; prior cookies/profile are not assumed"
        ),
        "created_at": created_at,
        "updated_at": iso(now_utc()),
    }


def write_task_resume_checkpoint(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    descriptor_path: str,
    *,
    state: str | None = None,
    exact_blocker: str | None = None,
    next_action: str | None = None,
    restart_point: str | None = None,
) -> str | None:
    """Persist a secret-free locator so a later task can find the same work."""
    if descriptor.get("mode") != "authorized" or descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE:
        return None
    payload = _resume_checkpoint_from_descriptor(
        config,
        descriptor,
        descriptor_path,
        state=state,
        exact_blocker=exact_blocker,
        next_action=next_action,
        restart_point=restart_point,
    )
    if payload is None:
        return None
    path = task_resume_path(config, payload["task_id"])
    json_atomic_replace(path, payload)
    return path


def _resume_checkpoint_matches(value: dict[str, Any], *, task_id: str | None, source_thread_id: str | None, run_id: str | None = None) -> bool:
    if value.get("schema") != TASK_RESUME_CHECKPOINT_SCHEMA or value.get("version") != TASK_RESUME_CHECKPOINT_VERSION:
        return False
    if task_id and value.get("task_id") != task_id:
        return False
    if source_thread_id and value.get("source_thread_id") != source_thread_id:
        return False
    if run_id and value.get("run_id") != run_id:
        return False
    return True


def _resume_current_descriptor(value: dict[str, Any], descriptor: dict[str, Any] | None = None) -> dict[str, Any]:
    if descriptor is None:
        return {"same_descriptor": False, "readback": "cleanup_complete_or_missing"}
    return {
        "task_id": value.get("task_id"),
        "run_id": value.get("run_id"),
        "status": descriptor.get("status"),
        "authentication_state": descriptor.get("authentication_state"),
        "recovery_state": descriptor.get("recovery_state"),
        "room_id": descriptor.get("room_id"),
        "port": descriptor.get("port"),
        "same_descriptor": True,
    }


def _resume_refresh_match(config: dict[str, Any], value: dict[str, Any]) -> dict[str, Any]:
    """Refresh one locator from its current descriptor without persisting it."""
    descriptor_path = value.get("descriptor_path")
    if not isinstance(descriptor_path, str):
        return value
    canonical_path = _resume_safe_path(config, descriptor_path)
    if canonical_path != os.path.realpath(descriptor_path) or not os.path.lexists(descriptor_path):
        return value
    try:
        descriptor = read_json_safe(canonical_path)
        refreshed = _resume_checkpoint_from_descriptor(config, descriptor, canonical_path)
    except (Blocker, OSError, ValueError, json.JSONDecodeError):
        return value
    return refreshed if refreshed is not None else value


def task_resume(args: argparse.Namespace) -> int:
    """Read the common task-level resume index without attaching or dispatching."""
    config = read_toml()
    validate_installation(config)
    task_id = _resume_optional_id(getattr(args, "task_id", None))
    source_thread_id = _resume_optional_id(getattr(args, "thread_id", None))
    run_id = _resume_optional_id(getattr(args, "run_id", None))
    if getattr(args, "task_id", None) and not task_id:
        raise Blocker("browser_use_task_resume_task_id_invalid")
    if getattr(args, "thread_id", None) and not source_thread_id:
        raise Blocker("browser_use_task_resume_thread_id_invalid")
    if getattr(args, "run_id", None) and not run_id:
        raise Blocker("browser_use_task_resume_run_id_invalid")
    root = task_resume_root(config)
    matches: list[dict[str, Any]] = []
    for path in sorted(pathlib.Path(root).glob("*.json")):
        try:
            value = read_json_safe(str(path))
        except (Blocker, OSError, ValueError, json.JSONDecodeError):
            continue
        if _resume_checkpoint_matches(value, task_id=task_id, source_thread_id=source_thread_id, run_id=run_id):
            matches.append(_resume_refresh_match(config, value))
    matches.sort(key=lambda item: str(item.get("updated_at") or ""), reverse=True)
    if not matches:
        print(json.dumps({
            "status": "not_found",
            "exact_blocker": "browser_use_task_resume_checkpoint_missing",
            "next_action": "create or locate the task-scoped temporary handoff before continuing",
            "restart_point": "new authorized handoff; never infer the prior profile or login state",
            "finalized": False,
        }, sort_keys=True))
        return 1
    output: dict[str, Any] = {"status": "resume_locator_found", "count": len(matches), "matches": matches, "finalized": False}
    current_candidates = [
        value for value in matches
        if value.get("state") in {"active", "continued", "waiting_auth"}
    ]
    explicitly_selected = bool(task_id or run_id)
    if len(current_candidates) > 1 and not explicitly_selected:
        print(json.dumps({
            **output,
            "status": "resume_locator_ambiguous",
            "exact_blocker": "browser_use_task_resume_multiple_current_candidates",
            "next_action": "select the intended task-scoped handoff with --task-id or --run-id",
            "restart_point": "resume locator only; no descriptor, room, profile, or process was selected",
        }, sort_keys=True))
        return 1
    if len(matches) == 1 or explicitly_selected or len(current_candidates) == 1:
        value = current_candidates[0] if len(current_candidates) == 1 and not explicitly_selected else matches[0]
        descriptor_path = value.get("descriptor_path")
        if isinstance(descriptor_path, str) and os.path.lexists(descriptor_path):
            try:
                descriptor = read_json_safe(descriptor_path)
                output["current_descriptor"] = _resume_current_descriptor(value, descriptor)
            except (Blocker, OSError, ValueError, json.JSONDecodeError):
                output["current_descriptor"] = {"same_descriptor": False, "readback": "unavailable"}
        else:
            output["current_descriptor"] = {"same_descriptor": False, "readback": "cleanup_complete_or_missing"}
    print(json.dumps(output, sort_keys=True))
    return 0


def handoff_root(config: dict[str, Any]) -> str:
    root = os.path.join(config["roots"]["browser_use_home"], "handoffs")
    assert_directory(root, create=True)
    return root


def assert_handoff_path(path: str, root: str) -> None:
    if not os.path.isabs(path) or os.path.realpath(path) != path:
        raise Blocker("browser_use_handoff_path_noncanonical")
    canonical_root = os.path.realpath(root)
    parent = os.path.realpath(os.path.dirname(path))
    if parent != canonical_root and not parent.startswith(canonical_root + os.sep):
        raise Blocker("browser_use_handoff_path_scope_mismatch")
    if not os.path.basename(path).endswith((".json", ".json.consumed", ".json.abandoned")):
        raise Blocker("browser_use_handoff_path_invalid")


def handoff_lock_paths(config: dict[str, Any], value: dict[str, Any], *, allow_released: bool = False) -> list[str]:
    paths = value.get("lock_paths")
    if not isinstance(paths, list) or len(paths) != 2 or not all(isinstance(item, str) for item in paths):
        raise Blocker("browser_use_handoff_lease_invalid")
    locks_root = os.path.realpath(config["roots"]["locks"])
    for path in paths:
        if not os.path.isabs(path) or os.path.realpath(path) != path or os.path.dirname(path) != locks_root:
            raise Blocker("browser_use_handoff_lease_scope_mismatch")
        if allow_released and not os.path.lexists(path):
            continue
        assert_regular_file(path, mode=0o600)
    return paths


def read_handoff(config: dict[str, Any], path: str, run_id: str, session: str, *, require_unexpired: bool) -> dict[str, Any]:
    root = handoff_root(config)
    assert_handoff_path(path, root)
    value = read_json_safe(path)
    required = {"schema", "status", "run_id", "session", "automation_id", "nonce", "authority_sha256", "origin", "profile", "profile_hash", "profile_marker_sha256", "port", "daemon_session", "process", "lock_paths", "lease_path", "download_dir"}
    missing = sorted(required - value.keys())
    if missing:
        raise Blocker("browser_use_handoff_fields_missing", ",".join(missing))
    if value["schema"] != HANDOFF_SCHEMA or value["status"] not in HANDOFF_STATUSES:
        raise Blocker("browser_use_handoff_schema_or_status_invalid")
    if value["run_id"] != run_id or value["session"] != session or value["daemon_session"] != session:
        raise Blocker("browser_use_handoff_binding_mismatch")
    requested_session = value.get("requested_session")
    if requested_session is not None:
        validate_id(requested_session, "session")
        if canonical_session_id(requested_session, config["roots"]["browser_use_home"]) != session:
            raise Blocker("browser_use_session_binding_invalid")
    safe_id(value["automation_id"], "automation_id")
    safe_id(value["nonce"], "nonce")
    lifecycle = str(value.get("lifecycle", "single-use"))
    if lifecycle not in {"single-use", "scheduled", TEMPORARY_LIFECYCLE}:
        raise Blocker("browser_use_handoff_lifecycle_invalid")
    if lifecycle == TEMPORARY_LIFECYCLE:
        for field in ("task_id", "creation_binding", "authority_scope"):
            if field not in value:
                raise Blocker("browser_use_temporary_handoff_fields_missing", field)
        safe_id(value["task_id"], "task_id")
        if value.get("mode", "authorized") != "authorized":
            raise Blocker("browser_use_temporary_requires_authorized_mode")
    expected_lease = os.path.realpath(path)
    legacy_claim_lease = _handoff_base_path(path) if path.endswith((HANDOFF_CLAIM_SUFFIX, HANDOFF_CONSUMED_SUFFIX)) else None
    if value["lease_path"] != expected_lease and value["lease_path"] != legacy_claim_lease:
        raise Blocker("browser_use_handoff_lease_binding_mismatch")
    if not isinstance(value["authority_sha256"], str) or not re.fullmatch(r"[0-9a-f]{64}", value["authority_sha256"]):
        raise Blocker("browser_use_handoff_authority_binding_invalid")
    origin = normalize_origin(value["origin"])
    if not isinstance(value["profile_hash"], str) or not re.fullmatch(r"[0-9a-f]{64}", value["profile_hash"]):
        raise Blocker("browser_use_handoff_profile_binding_invalid")
    if not isinstance(value["profile_marker_sha256"], str) or not re.fullmatch(r"[0-9a-f]{64}", value["profile_marker_sha256"]):
        raise Blocker("browser_use_handoff_profile_marker_binding_invalid")
    try:
        port = int(value["port"])
    except (TypeError, ValueError) as exc:
        raise Blocker("browser_use_handoff_port_invalid") from exc
    ports = config["ports"]
    if lifecycle == "scheduled":
        port_start, port_end = ports["scheduled_start"], ports["scheduled_end"]
    elif lifecycle == "single-use":
        port_start, port_end = ports["single_use_start"], ports["single_use_end"]
    else:
        port_start, port_end = ports["temporary_start"], ports["temporary_end"]
    if not port_start <= port <= port_end:
        raise Blocker("browser_use_handoff_port_out_of_range")
    profile = value["profile"]
    # A recording bound to a login handoff intentionally points at the
    # handoff-owned profile. Validate that profile against the source
    # handoff's lifecycle, not the destination recording's lifecycle. The
    # start path rejects a mismatch before recording begins; this branch also
    # lets terminal cleanup close a previously started mismatched recording
    # without deleting the shared handoff profile.
    profile_lifecycle = lifecycle
    if value.get("source_handoff_descriptor"):
        source_path = os.path.realpath(str(value["source_handoff_descriptor"]))
        source_run_id = safe_id(value.get("source_run_id"), "run_id")
        source_session = validate_id(value.get("source_session"), "session")
        source = read_handoff(config, source_path, source_run_id, source_session, require_unexpired=False)
        profile_lifecycle = str(source.get("lifecycle", lifecycle))
    profile_root = os.path.realpath(config["roots"]["scheduled_profiles"] if profile_lifecycle == "scheduled" else config["roots"]["single_use_profiles"] if profile_lifecycle == "single-use" else config["roots"]["temporary_profiles"])
    if not isinstance(profile, str) or not os.path.isabs(profile) or os.path.realpath(profile) != profile or not profile.startswith(profile_root + os.sep):
        raise Blocker("browser_use_handoff_profile_scope_mismatch")
    if lifecycle == "scheduled" and os.path.realpath(profile) != os.path.join(profile_root, value["automation_id"]):
        raise Blocker("browser_use_handoff_scheduled_profile_binding_mismatch")
    if lifecycle == TEMPORARY_LIFECYCLE:
        expected = temporary_profile_path(config, value["creation_binding"])
        if os.path.realpath(profile) != expected:
            raise Blocker("browser_use_temporary_handoff_binding_mismatch")
        room_id = value.get("room_id")
        if room_id:
            room = room_registry_lookup(config, room_id)
            if room is None or room.get("profile") != os.path.realpath(profile) or int(room.get("port", -1)) != int(value["port"]):
                raise Blocker("browser_use_temporary_handoff_binding_mismatch")
        elif int(value["port"]) != temporary_port(config, value["creation_binding"]):
            raise Blocker("browser_use_temporary_handoff_binding_mismatch")
    download_dir = value["download_dir"]
    downloads_root = os.path.realpath(config["roots"]["downloads"])
    if not isinstance(download_dir, str) or not os.path.isabs(download_dir) or os.path.realpath(download_dir) != download_dir or not download_dir.startswith(downloads_root + os.sep):
        raise Blocker("browser_use_handoff_download_scope_mismatch")
    process = value["process"]
    if not isinstance(process, dict) or not isinstance(process.get("root_pid"), int) or not isinstance(process.get("root_start_time"), (int, float)):
        raise Blocker("browser_use_handoff_process_identity_invalid")
    if require_unexpired:
        expires = handoff_expiry(value)
        if expires.tzinfo is None or expires <= now_utc():
            raise Blocker("browser_use_handoff_expired")
    cleanup_state = value.get("cleanup_state") or {}
    allow_released_locks = cleanup_state.get("recording_stale_cleanup") is True and cleanup_state.get("locks_released") is True
    handoff_lock_paths(config, value, allow_released=allow_released_locks)
    value["origin"] = origin
    value["port"] = port
    return value


def handoff_expiry(descriptor: dict[str, Any]) -> dt.datetime:
    try:
        expires = dt.datetime.fromisoformat(str(descriptor["expires_at"]).replace("Z", "+00:00"))
    except (KeyError, TypeError, ValueError) as exc:
        raise Blocker("browser_use_handoff_expiry_invalid") from exc
    if expires.tzinfo is None:
        raise Blocker("browser_use_handoff_expiry_invalid")
    return expires.astimezone(dt.timezone.utc)


def authority_for_handoff(path: str, run_id: str, session: str, descriptor: dict[str, Any], config: dict[str, Any] | None = None) -> dict[str, Any]:
    requested_session = descriptor.get("requested_session")
    # A same-session authority drift check must not be masked by an unrelated
    # missing global config.  Only load config when a requested/effective
    # session alias is actually needed.
    aliases = []
    if isinstance(requested_session, str) and requested_session != session:
        config = config or read_toml()
        aliases = session_aliases(config, requested_session, session)
    authority = parse_authority(path, run_id, session, aliases=aliases)
    digest = sha256_file(path)
    if digest != descriptor["authority_sha256"]:
        raise Blocker("browser_use_handoff_authority_changed")
    if descriptor["origin"] not in {normalize_origin(item) for item in authority["allowed_origins"]}:
        raise Blocker("browser_use_handoff_origin_not_authorized")
    return authority


def _handoff_authority_needs_renewal(descriptor: dict[str, Any]) -> bool:
    expiry = handoff_expiry(descriptor)
    return expiry <= now_utc() + dt.timedelta(
        seconds=AUTHORITY_READBACK_BUDGET_SECONDS + AUTHORITY_CLOCK_SKEW_SECONDS
    )


def renew_handoff_authority(config: dict[str, Any], descriptor_path: str, descriptor: dict[str, Any]) -> dict[str, Any]:
    """Renew only the same handoff authority, without replacing its profile.

    Login may take longer than the short command authority supplied by the
    caller.  The browser, room, locks, and profile remain untouched; only an
    append-only authority file and the owner-bound descriptor lease are
    advanced, and only until the original lineage boundary.
    """
    current_path = os.path.realpath(str(descriptor.get("authority_current_path") or ""))
    if not current_path or not os.path.isabs(current_path) or os.path.realpath(os.path.dirname(current_path)) != os.path.realpath(os.path.dirname(descriptor_path)):
        raise Blocker("browser_use_handoff_authority_path_scope_mismatch")
    current = parse_authority(
        current_path,
        descriptor["run_id"],
        descriptor["session"],
        aliases=session_aliases(config, descriptor.get("requested_session", descriptor["session"]), descriptor["session"]),
        require_unexpired=False,
    )
    current_digest = sha256_file(current_path)
    if current_digest != descriptor.get("authority_sha256"):
        raise Blocker("browser_use_handoff_authority_changed")
    lineage_expires_at = _authority_lineage_expiry(current, descriptor)
    descriptor["authority_lineage_expires_at"] = iso(lineage_expires_at)
    now = now_utc()
    expires_at = min(now + dt.timedelta(seconds=AUTHORITY_MAX_TTL_SECONDS), lineage_expires_at)
    if expires_at <= now + dt.timedelta(seconds=AUTHORITY_READBACK_BUDGET_SECONDS + AUTHORITY_CLOCK_SKEW_SECONDS):
        raise Blocker("browser_use_authority_renewal_lineage_exhausted")
    try:
        generation = int(descriptor.get("authority_generation", 1)) + 1
    except (TypeError, ValueError) as exc:
        raise Blocker("browser_use_authority_generation_invalid") from exc
    output = os.path.join(os.path.dirname(descriptor_path), f"{os.path.basename(descriptor_path)}.authority-generation-{generation}.json")
    authority = {
        "schema": AUTHORITY_RENEWAL_SCHEMA,
        "browser_surface": "browser_use_cli",
        "run_id": descriptor["run_id"],
        "session": descriptor["session"],
        "authority_issued_at": current.get("authority_issued_at") or descriptor.get("authority_issued_at"),
        "authority_lineage_expires_at": iso(lineage_expires_at),
        "expires_at": iso(expires_at),
        "allowed_origins": sorted({normalize_origin(item) for item in current["allowed_origins"]}),
        "account_identity": current["account_identity"],
        "data_exposure": current["data_exposure"],
        "side_effect_scope": current["side_effect_scope"],
        "approval": "approved",
        "readback_required": True,
        "previous_authority_sha256": current_digest,
        "authority_generation": generation,
        "issuer_id": AUTHORITY_ISSUER_ID,
    }
    for key in ("automation_id", "stage_id", "mode", "not_before", "authority_id", "authority_schema", "authority_version"):
        if key in current:
            authority[key] = current[key]
    adopted = authority
    if os.path.lexists(output):
        existing = parse_authority(output, descriptor["run_id"], descriptor["session"], aliases=session_aliases(config, descriptor.get("requested_session", descriptor["session"]), descriptor["session"]), require_unexpired=False)
        bound_keys = (
            "browser_surface", "run_id", "session", "authority_issued_at",
            "authority_lineage_expires_at", "allowed_origins", "account_identity",
            "data_exposure", "side_effect_scope", "approval", "readback_required",
            "previous_authority_sha256", "authority_generation", "issuer_id",
            "automation_id", "stage_id", "mode", "not_before", "authority_id",
            "authority_schema", "authority_version",
        )
        if any(existing.get(key) != authority.get(key) for key in bound_keys):
            raise Blocker("browser_use_handoff_authority_renewal_collision")
        if _authority_expiry(existing) > lineage_expires_at:
            raise Blocker("browser_use_authority_renewal_expiry_unbounded")
        if _authority_expiry(existing) <= now_utc() + dt.timedelta(seconds=AUTHORITY_READBACK_BUDGET_SECONDS + AUTHORITY_CLOCK_SKEW_SECONDS):
            raise Blocker("browser_use_authority_renewal_expiry_insufficient")
        adopted = existing
    else:
        json_atomic_no_replace(output, authority)
    descriptor.update({
        "authority_sha256": sha256_file(output),
        "authority_issued_at": adopted.get("authority_issued_at"),
        "authority_lineage_expires_at": adopted.get("authority_lineage_expires_at"),
        "authority_generation": generation,
        "authority_current_path": os.path.realpath(output),
        "expires_at": adopted["expires_at"],
        "watchdog_expires_at": iso(lineage_expires_at),
    })
    update_handoff(descriptor_path, descriptor)
    return adopted


def validate_handoff_resources(config: dict[str, Any], descriptor: dict[str, Any]) -> None:
    profile = descriptor["profile"]
    assert_directory(profile)
    marker = os.path.join(profile, ".browser-use-profile.json")
    assert_regular_file(marker, mode=0o600)
    if sha256_file(marker) != descriptor["profile_marker_sha256"]:
        raise Blocker("browser_use_handoff_profile_marker_changed")
    marker_value = read_json_safe(marker)
    lifecycle = str(descriptor.get("lifecycle", "single-use"))
    if lifecycle == TEMPORARY_LIFECYCLE:
        expected = {
            "mode": "authorized",
            "lifecycle": TEMPORARY_LIFECYCLE,
            "automation_id": descriptor["automation_id"],
            "task_id": descriptor["task_id"],
            "run_id": descriptor["run_id"],
            "creation_binding": descriptor["creation_binding"],
            "canonical_profile": os.path.realpath(profile),
            "port": descriptor["port"],
            "authority_sha256": descriptor["authority_sha256"],
            "authority_scope": descriptor["authority_scope"],
            "account_identity": descriptor["account_identity"],
            "origins": sorted(descriptor.get("origins") or [descriptor["origin"]]),
        }
        marker_value = validate_temporary_marker(config, profile, expected)
        if profile_hash(profile, descriptor["nonce"]) != descriptor["profile_hash"]:
            raise Blocker("browser_use_handoff_profile_hash_mismatch")
        assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
        return
    expected_run_id = "persistent" if lifecycle == "scheduled" else descriptor["run_id"]
    expected_nonce = "persistent" if lifecycle == "scheduled" else descriptor["nonce"]
    if marker_value.get("schema") != "browser-use-profile.v1" or marker_value.get("run_id") != expected_run_id or marker_value.get("nonce") != expected_nonce or marker_value.get("automation_id") != descriptor["automation_id"]:
        raise Blocker("browser_use_handoff_profile_marker_binding_mismatch")
    if profile_hash(profile, descriptor["nonce"]) != descriptor["profile_hash"]:
        raise Blocker("browser_use_handoff_profile_hash_mismatch")
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])


def validate_handoff_process_identity(config: dict[str, Any], descriptor: dict[str, Any], *, allow_missing: bool) -> bool:
    profile = descriptor["profile"]
    chrome_path = config["executables"]["chrome"]["canonical_path"]
    try:
        process = psutil.Process(descriptor["process"]["root_pid"])
        if abs(process.create_time() - descriptor["process"]["root_start_time"]) > 0.5 or not process_matches(process, chrome_path, descriptor["port"], profile):
            raise Blocker("browser_use_handoff_chrome_identity_drift")
    except psutil.NoSuchProcess as exc:
        if allow_missing:
            assert_debug_listener_absent(descriptor["port"])
            return False
        raise Blocker("browser_use_handoff_chrome_missing") from exc
    except psutil.Error as exc:
        raise Blocker("browser_use_handoff_process_identity_recheck_failed") from exc
    if not port_listener(descriptor["port"]) or not lsof_listener(descriptor["port"]):
        raise Blocker("browser_use_handoff_listener_missing")
    return True


def _close_stale_recording_daemon_if_present(config: dict[str, Any], descriptor: dict[str, Any]) -> None:
    """Gracefully close only the daemon bound to a dead recording session.

    Chrome may disappear before the recorder reaches its normal finalize path.
    The daemon is still safe to close when the caller has already proven the
    descriptor-bound Chrome identity is absent, the exact debug listener is
    absent, and the Harness runtime is rooted at this session.  Never fall
    back to a signal or process kill: the existing reload path must close the
    owned daemon and its runtime markers must disappear before recovery can
    continue.
    """
    runtime = os.path.join(browser_harness_root(str(descriptor["session"])), "runtime")
    daemon_paths = [os.path.join(runtime, name) for name in ("bu.sock", "bu.pid", "bu.port")]
    if not any(os.path.lexists(path) for path in daemon_paths):
        return
    assert_debug_listener_absent(int(descriptor["port"]))
    closed, blocker = close_owned_daemon_if_active(
        config,
        config["roots"]["browser_use_home"],
        int(descriptor["port"]),
        str(descriptor["session"]),
    )
    if not closed:
        raise Blocker(blocker or "browser_use_daemon_cleanup_unverified")
    if any(os.path.lexists(path) for path in daemon_paths):
        raise Blocker("browser_use_daemon_cleanup_unverified")


def validate_handoff_identity(config: dict[str, Any], descriptor: dict[str, Any]) -> None:
    validate_handoff_resources(config, descriptor)
    validate_handoff_process_identity(config, descriptor, allow_missing=False)


def assert_handoff_keep_alive(config: dict[str, Any], process_identity: dict[str, Any], port: int, profile: str) -> None:
    """Require the headed Chrome handoff to survive the Browser Use readback."""
    validate_handoff_process_identity(
        config,
        {"process": process_identity, "port": port, "profile": profile},
        allow_missing=False,
    )


def consume_handoff(config: dict[str, Any], path: str, run_id: str, session: str) -> str:
    requested = os.path.realpath(path)
    path = _handoff_base_path(requested)
    consumed = path + HANDOFF_CONSUMED_SUFFIX
    abandoned = path + HANDOFF_CLAIM_SUFFIX
    # A caller that retries with a claimed/consumed path is a replay loser, not
    # a new lease.  Normalize all handoff aliases before checking the claim.
    if requested != path or os.path.lexists(consumed) or os.path.lexists(abandoned):
        raise Blocker("browser_use_handoff_replay_rejected")
    try:
        # A hard link is a same-filesystem, no-replace claim.  The destination
        # cannot overwrite a concurrent claimant.
        os.link(path, consumed)
    except FileExistsError as exc:
        raise Blocker("browser_use_handoff_replay_rejected") from exc
    except FileNotFoundError as exc:
        if os.path.lexists(consumed) or os.path.lexists(abandoned):
            raise Blocker("browser_use_handoff_replay_rejected") from exc
        raise Blocker("browser_use_handoff_missing") from exc

    try:
        # Never read the source after the claim.  If this process crashes before
        # unlinking the source, the claimed descriptor remains the sole usable
        # lease and future consumers are rejected by the destination check.
        descriptor = read_handoff(config, consumed, run_id, session, require_unexpired=False)
        if descriptor["status"] != "active":
            raise Blocker("browser_use_handoff_replay_rejected")
        descriptor["status"] = "claimed"
        descriptor["lease_path"] = os.path.realpath(consumed)
        update_handoff(consumed, descriptor)
        os.unlink(path)
    except (Blocker, OSError, ValueError, json.JSONDecodeError):
        # Keep both files on any post-claim uncertainty.  In particular, do not
        # restore/replace the source and do not allow a second consumer.
        raise
    return consumed


def update_handoff(path: str, descriptor: dict[str, Any]) -> None:
    json_atomic_replace(path, descriptor)


def launch_handoff_watchdog(config: dict[str, Any], descriptor_path: str, run_id: str, session: str) -> int:
    helper_path = os.path.realpath(__file__)
    assert_regular_file(helper_path, mode=0o700)
    assert_handoff_path(descriptor_path, handoff_root(config))
    try:
        process = subprocess.Popen(
            [sys.executable, helper_path, "handoff-watchdog", "--run-id", run_id, "--session", session, "--descriptor", descriptor_path],
            cwd=config["roots"]["browser_use_home"],
            env=make_env(config["roots"]["browser_use_home"]),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            start_new_session=True,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise Blocker("browser_use_handoff_watchdog_start_failed") from exc
    return process.pid


def make_env(home: str, recording: dict[str, Any] | None = None) -> dict[str, str]:
    env = dict(os.environ)
    for key in list(env):
        upper = key.upper()
        if key in {"PYTHONPATH", "PYTHONHOME", "BROWSER_USE_API_KEY", "OPENAI_API_KEY", "ANTHROPIC_API_KEY"}:
            env.pop(key, None)
        elif any(fragment in upper for fragment in ("PASSWORD", "SECRET", "TOKEN", "API_KEY", "COOKIE")):
            env.pop(key, None)
    env["BROWSER_USE_HOME"] = home
    if recording is not None:
        env["PYTHONPATH"] = os.pathsep.join((recording["runtime_dir"], recording["dependencies_dir"], recording["site_packages_dir"]))
        env["BROWSER_USE_RECORD_VIDEO_DIR"] = recording["recording_dir"]
        env["BROWSER_USE_RECORD_VIDEO_FRAMERATE"] = str(recording["framerate"])
        env["BROWSER_USE_RECORDING_STATUS_PATH"] = recording["status_path"]
        if recording.get("tab_inventory_path"):
            env["BH_RECORDING_TAB_INVENTORY_PATH"] = recording["tab_inventory_path"]
    return env


def browser_harness_cli_enabled() -> bool:
    """Require the pinned Browser Use/Harness CLI; never use the legacy CLI."""
    try:
        raw = importlib.metadata.version("browser-use")
    except importlib.metadata.PackageNotFoundError as exc:
        raise Blocker("browser_use_pinned_package_missing") from exc
    if raw != PINNED_BROWSER_USE_VERSION:
        raise Blocker("browser_use_legacy_or_unpinned_version_rejected", raw)
    return True


def browser_harness_root(session: str) -> str:
    """Use a short, per-session private root so Harness sockets stay bounded."""
    digest = hashlib.sha256(session.encode("utf-8")).hexdigest()[:16]
    return os.path.join("/tmp", f"codex-browser-use-{digest}")


def browser_harness_env(home: str, port: int, session: str, recording: dict[str, Any] | None = None) -> dict[str, str]:
    """Build an isolated CLI 3.0 environment without inheriting credentials."""
    root = browser_harness_root(session)
    env = make_env(home, recording)
    env.update(
        {
            "BU_NAME": session,
            "BU_CDP_URL": f"http://127.0.0.1:{port}",
            "BH_HOME": os.path.join(root, "home"),
            "BH_RUNTIME_DIR": os.path.join(root, "runtime"),
            "BH_TMP_DIR": os.path.join(root, "tmp"),
            "BH_AGENT_WORKSPACE": recording.get("harness_workspace", os.path.join(root, "workspace")) if recording else os.path.join(root, "workspace"),
            "BH_RECORD": "1" if recording else "0",
            "BH_TELEMETRY": "0",
        }
    )
    env.pop("BU_CDP_WS", None)
    return env


_BROWSER_HARNESS_STATE_JS = r"""(()=>{
  const nodes = Array.from(document.querySelectorAll('body *')).slice(0, 1000);
  const esc = (value) => String(value ?? '').replace(/[\\\n\r]/g, ' ').replace(/[<>]/g, '');
  const depth = (element) => {
    let current = element, count = 0;
    while (current && current.parentElement && current.parentElement !== document.body) {
      count += 1; current = current.parentElement;
    }
    return Math.min(count, 20);
  };
  return nodes.map((element, index) => {
    const attrs = Array.from(element.attributes || [])
      .filter((attr) => ['id', 'class', 'role', 'type', 'tabindex', 'href', 'aria-label', 'name'].includes(attr.name))
      .map((attr) => `${attr.name}=\"${esc(attr.value)}\"`).join(' ');
    const isFormControl = ['INPUT', 'TEXTAREA', 'SELECT'].includes(element.tagName);
    const isEditable = element.isContentEditable === true;
    const ownText = element.children.length ? '' : (isFormControl || isEditable)
      ? '[入力値は非表示]'
      : (element.innerText || '').trim().replace(/\\s+/g, ' ').slice(0, 300);
    return `${' '.repeat(depth(element) * 2)}[${index}]<${element.tagName.toLowerCase()}${attrs ? ` ${attrs}` : ''}>${ownText ? ` ${esc(ownText)}` : ''}`;
  }).join('\n');
})()"""


_BROWSER_HARNESS_TAB_GUARD = r'''
from browser_harness.helpers import (
    cdp, current_tab, goto_url, list_tabs, switch_tab, ensure_real_tab,
    page_info, js, wait, wait_for_load, new_tab, close_tab, type_text,
    press_key, capture_screenshot, scroll, click_at_xy,
)
from urllib.parse import urlparse

_TAB_INVENTORY_SCHEMA = "browser-use-recording-tabs.v1"
_TAB_INVENTORY_MAX_AUXILIARY = 16
_TAB_INVENTORY_WORKING_COMMANDS = {
    "open", "state", "get", "extract", "eval", "screenshot", "viewport", "upload",
    "click", "dblclick", "rightclick", "type", "input", "keys", "scroll",
    "back", "wait", "hover", "ax-inspect", "ax-click",
}

def _tab_inventory_path():
    return os.environ.get("BH_RECORDING_TAB_INVENTORY_PATH")

def _tab_metadata(tab, role):
    target_id = str(tab.get("targetId") or tab.get("target_id") or "")
    url = str(tab.get("url") or "")
    title = str(tab.get("title") or "")
    return {
        "target_id": target_id,
        "role": role,
        "url_length": len(url),
        "url_sha256": hashlib.sha256(url.encode("utf-8")).hexdigest(),
        "title_length": len(title),
        "title_sha256": hashlib.sha256(title.encode("utf-8")).hexdigest(),
    }

def _tab_id(tab):
    return str(tab.get("targetId") or tab.get("target_id") or "")

def _target_infos():
    result = cdp("Target.getTargets")
    return {
        str(info.get("targetId")): info
        for info in result.get("targetInfos", [])
        if info.get("type") == "page" and info.get("targetId")
    }

def _select_new_working_tab(value, tabs, new_ids):
    """Follow the tab actually opened by the command's current interaction."""
    if not new_ids:
        return value
    source_id = str(value.get("command_target_id") or value.get("active_target_id") or "")
    attached_id = _current_target_id()
    infos = _target_infos()
    candidates = []
    for position, tab in enumerate(tabs):
        target_id = _tab_id(tab)
        if target_id not in new_ids:
            continue
        info = infos.get(target_id, {})
        opener_id = str(info.get("openerId") or "")
        # A daemon/session handoff is the strongest signal, followed by the
        # opener relationship. Only then use a single newly-created page.
        # A new tab is eligible for automatic promotion only when the browser
        # proves it was opened by the current run command.  An attached/active
        # tab alone is not enough: it may be a user or foreign tab.
        opened_by_command = bool(source_id) and opener_id == source_id
        signal = 3 if target_id == attached_id and opened_by_command else 2 if opened_by_command else 0
        candidates.append((signal, position, target_id))
    if not candidates:
        return value
    strongest = max(signal for signal, _, _ in candidates)
    if strongest == 0 and len(candidates) != 1:
        return value
    _, _, target_id = max(candidates)
    previous_working_id = str(value.get("working_target_id") or "")
    baseline_ids = set(value.get("baseline_target_ids", []))

    # A page can legitimately open its next work surface in a new target even
    # though the command was issued against the current working tab.  Merely
    # changing active_target_id leaves screenshots/readbacks bound to the old
    # tab on the next command.  Promote the strongly identified new target to
    # working and demote only the former run-owned working tab to auxiliary.
    # Baseline/user tabs are never reclassified or closed here.
    value["working_target_id"] = target_id
    value["active_target_id"] = target_id
    auxiliary = set(value.get("auxiliary_target_ids", []))
    auxiliary.discard(target_id)
    if previous_working_id and previous_working_id != target_id and previous_working_id not in baseline_ids:
        auxiliary.add(previous_working_id)
    value["auxiliary_target_ids"] = sorted(auxiliary)
    for tab in value.get("tabs", []):
        tab_id = str(tab.get("target_id") or "")
        if tab_id == target_id:
            tab["role"] = "working"
        elif tab_id == previous_working_id and tab.get("role") == "working":
            tab["role"] = "auxiliary"
    return value

def _current_target_id():
    return _tab_id(current_tab())

def _write_tab_inventory(value):
    path = _tab_inventory_path()
    if not path:
        return value
    parent = os.path.dirname(path)
    os.makedirs(parent, mode=0o700, exist_ok=True)
    temp = f"{path}.{os.getpid()}.tmp"
    with open(temp, "w", encoding="utf-8") as handle:
        json.dump(value, handle, sort_keys=True, separators=(",", ":"))
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temp, 0o600)
    os.replace(temp, path)
    return value

def _read_tab_inventory():
    path = _tab_inventory_path()
    if not path:
        return None
    try:
        with open(path, "r", encoding="utf-8") as handle:
            value = json.load(handle)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        raise RuntimeError("browser_use_recording_tab_inventory_invalid") from exc
    if not isinstance(value, dict) or value.get("schema") != _TAB_INVENTORY_SCHEMA:
        raise RuntimeError("browser_use_recording_tab_inventory_invalid")
    return value

def _tab_inventory_by_id(value):
    return {str(tab.get("target_id")): tab for tab in value.get("tabs", []) if isinstance(tab, dict)}

def _tab_snapshot(value, tabs):
    known = _tab_inventory_by_id(value)
    current_ids = {_tab_id(tab) for tab in tabs}
    if value.get("working_target_id") not in current_ids:
        raise RuntimeError("browser_use_recording_working_tab_missing")
    active_target_id = str(value.get("active_target_id") or value["working_target_id"])
    if active_target_id not in current_ids:
        if active_target_id != value["working_target_id"]:
            active_target_id = value["working_target_id"]
        else:
            raise RuntimeError("browser_use_recording_working_tab_missing")
    # After a command promotes a newly opened run-owned tab, subsequent
    # background readbacks must follow that working tab even if an older
    # auxiliary tab was the last persisted active target.  Keep this
    # background-only; do not activate Chrome or take keyboard focus.
    if known.get(active_target_id, {}).get("role") == "auxiliary":
        active_target_id = value["working_target_id"]
    # The OS-visible tab may be a user/baseline tab while the run-owned tab
    # remains in the background. Never route a recording command or a
    # screenshot to that foreign tab.
    if known.get(active_target_id, {}).get("role") == "baseline":
        active_target_id = value["working_target_id"]
    value["active_target_id"] = active_target_id
    command_target_id = str(value.get("command_target_id") or "")
    if known.get(command_target_id, {}).get("role") == "baseline":
        value["command_target_id"] = None
    new_ids = current_ids - set(known)
    if new_ids:
        # Reconcile a tab opened by the immediately preceding run command only
        # when every new target has an explicit opener relationship to that
        # command's target.  Otherwise preserve the fail-closed foreign-tab
        # guard and require a fresh run/handoff.
        if len(set(value.get("auxiliary_target_ids", [])) | new_ids) > _TAB_INVENTORY_MAX_AUXILIARY:
            raise RuntimeError("browser_use_recording_auxiliary_tab_limit_exceeded")
        source_id = str(value.get("command_target_id") or value.get("active_target_id") or "")
        infos = _target_infos()
        if not source_id or any(str(infos.get(target_id, {}).get("openerId") or "") != source_id for target_id in new_ids):
            raise RuntimeError("browser_use_recording_untracked_tab_increase")
        for target_id in sorted(new_ids):
            tab = next((item for item in tabs if _tab_id(item) == target_id), None)
            if tab is None:
                raise RuntimeError("browser_use_recording_untracked_tab_increase")
            value.setdefault("tabs", []).append(_tab_metadata(tab, "auxiliary"))
            value.setdefault("auxiliary_target_ids", []).append(target_id)
        value = _select_new_working_tab(value, tabs, new_ids)
        known = _tab_inventory_by_id(value)
        # Re-read the promoted target after reconciliation.  The initial
        # active_target_id may still point at the former working tab because
        # it was computed before the opener-bound promotion above.
        active_target_id = str(value.get("active_target_id") or value["working_target_id"])
        if active_target_id not in current_ids or known.get(active_target_id, {}).get("role") == "baseline":
            active_target_id = value["working_target_id"]
    return {
        "schema": _TAB_INVENTORY_SCHEMA,
        "working_target_id": value["working_target_id"],
        "active_target_id": active_target_id,
        "command_target_id": value.get("command_target_id"),
        "baseline_target_ids": list(value.get("baseline_target_ids", [])),
        "auxiliary_target_ids": list(value.get("auxiliary_target_ids", [])),
        "tabs": [_tab_metadata(tab, known[_tab_id(tab)]["role"]) for tab in tabs],
        "updated_at": round(time.time(), 3),
    }

def _initialize_tab_inventory():
    if not _tab_inventory_path():
        return None
    tabs = list_tabs(include_chrome=True)
    if not tabs:
        raise RuntimeError("browser_use_recording_working_tab_missing")
    working = ensure_real_tab()
    if not working:
        working = current_tab()
    working_id = _tab_id(working)
    if not working_id or working_id not in {_tab_id(tab) for tab in tabs}:
        raise RuntimeError("browser_use_recording_working_tab_missing")
    value = {
        "schema": _TAB_INVENTORY_SCHEMA,
        "working_target_id": working_id,
        "active_target_id": working_id,
        "command_target_id": None,
        "baseline_target_ids": [
            _tab_id(tab) for tab in tabs if _tab_id(tab) != working_id
        ],
        "auxiliary_target_ids": [],
        "tabs": [
            _tab_metadata(tab, "working" if _tab_id(tab) == working_id else "baseline")
            for tab in tabs
        ],
        "updated_at": round(time.time(), 3),
    }
    return _write_tab_inventory(value)

def _prepare_recording_command(name, command):
    value = _read_tab_inventory()
    if value is None:
        return None
    tabs = list_tabs(include_chrome=True)
    value = _tab_snapshot(value, tabs)
    by_id = _tab_inventory_by_id(value)
    if name == "switch":
        if len(command) < 2 or str(command[1]) not in by_id:
            raise RuntimeError("browser_use_recording_switch_tab_untracked")
        if str(command[1]) not in {_tab_id(tab) for tab in tabs}:
            raise RuntimeError("browser_use_recording_switch_tab_missing")
        if by_id[str(command[1])].get("role") == "baseline":
            raise RuntimeError("browser_use_recording_foreign_tab_switch_rejected")
        value["active_target_id"] = str(command[1])
    elif name == "close-tab":
        target_id = str(command[1]) if len(command) > 1 and command[1] else _current_target_id()
        role = by_id.get(target_id, {}).get("role")
        if role == "baseline":
            raise RuntimeError("browser_use_recording_foreign_tab_close_rejected")
        if target_id == value["working_target_id"]:
            raise RuntimeError("browser_use_recording_working_tab_close_rejected")
        if target_id == value.get("active_target_id"):
            value["active_target_id"] = value["working_target_id"]
    elif name in _TAB_INVENTORY_WORKING_COMMANDS:
        target_id = value["working_target_id"] if name == "open" else str(value.get("active_target_id") or value["working_target_id"])
        value["command_target_id"] = target_id
        # Bind every command to the target's CDP session without activating
        # the tab.  `switch_tab()` calls Target.activateTarget, which brings
        # Chrome to the foreground on macOS and can steal the user's
        # keyboard focus.  Input.dispatch* and Page.navigate work against an
        # attached background target session, so foreground activation is not
        # required for recording commands.  An explicit `switch` command
        # remains the only operation that intentionally changes tab focus.
        attach_recording_target(target_id, activate=False)
    return _write_tab_inventory(value)

def _finish_recording_command():
    value = _read_tab_inventory()
    if value is None:
        return None
    tabs = list_tabs(include_chrome=True)
    known = _tab_inventory_by_id(value)
    current_ids = {_tab_id(tab) for tab in tabs}
    if value.get("working_target_id") not in current_ids:
        raise RuntimeError("browser_use_recording_working_tab_missing")
    active_target_id = str(value.get("active_target_id") or value["working_target_id"])
    if active_target_id not in current_ids:
        active_target_id = value["working_target_id"]
    if known.get(active_target_id, {}).get("role") == "baseline":
        active_target_id = value["working_target_id"]
    new_ids = current_ids - set(known)
    # A run-owned auxiliary page may be closed intentionally.  Remove closed
    # auxiliary IDs before rebuilding the role index; retaining one in the
    # ID list while omitting it from `tabs` makes the next command fail with a
    # role-index mismatch even though the working tab is still healthy.
    auxiliary = [
        target_id
        for target_id in value.get("auxiliary_target_ids", [])
        if target_id in current_ids
    ]
    if len(set(auxiliary) | new_ids) > _TAB_INVENTORY_MAX_AUXILIARY:
        raise RuntimeError("browser_use_recording_auxiliary_tab_limit_exceeded")
    for target_id in sorted(new_ids):
        auxiliary.append(target_id)
        known[target_id] = {"role": "auxiliary"}
    value = {
        "schema": _TAB_INVENTORY_SCHEMA,
        "working_target_id": value["working_target_id"],
        "active_target_id": active_target_id,
        "command_target_id": value.get("command_target_id"),
        "baseline_target_ids": list(value.get("baseline_target_ids", [])),
        "auxiliary_target_ids": sorted(set(auxiliary)),
        "tabs": [_tab_metadata(tab, known[_tab_id(tab)]["role"]) for tab in tabs],
        "updated_at": round(time.time(), 3),
    }
    value = _select_new_working_tab(value, tabs, new_ids)
    value["command_target_id"] = None
    return _write_tab_inventory(value)
'''


def browser_harness_script(command: list[str]) -> str:
    """Translate the helper's bounded command vocabulary to Harness helpers."""
    command_literal = json.dumps(command, ensure_ascii=True)
    state_expression = json.dumps(_BROWSER_HARNESS_STATE_JS, ensure_ascii=True)
    return f'''import hashlib, json, os, time
from browser_harness import helpers as _browser_helpers
from browser_harness.recorder import recording_dir, start_recording, stop_recording
{_BROWSER_HARNESS_TAB_GUARD}

cmd = {command_literal}
name = cmd[0]

def emit(value):
    if _tab_inventory_path() and name not in {{"record-start", "record-stop"}}:
        inventory = _finish_recording_command()
        if isinstance(value, dict) and isinstance(value.get("data"), dict):
            value["data"]["tab_inventory"] = inventory
    print(json.dumps(value, ensure_ascii=True, separators=(",", ":")))

def info():
    return page_info()

def state_text():
    return js({state_expression})

def element_bbox(index):
    # Numeric targets are resolved from a fresh DOM snapshot.  Scroll the
    # resolved element into the viewport before reading its box so controls
    # below the fold cannot produce an unusable off-screen click coordinate.
    return js("(()=>{{const e=Array.from(document.querySelectorAll('body *'))[%d];if(!e)return null;try{{e.scrollIntoView({{block:'center',inline:'nearest',behavior:'instant'}});}}catch(_){{try{{e.scrollIntoView({{block:'center',inline:'nearest'}});}}catch(__){{}}}}const r=e.getBoundingClientRect();return {{x:r.x,y:r.y,width:r.width,height:r.height}};}})()" % int(index))

def attach_recording_target(target_id, activate=False):
    """Bind the daemon to the run target without stealing the OS focus.

    Read-only checkpoints (especially screenshots) must be safe while the
    user is working in another tab or application. Target.activateTarget is
    intentionally reserved for commands that actually interact with the
    target; screenshots and readbacks can attach to a background target.
    """
    target_id = str(target_id)
    if activate:
        switch_tab(target_id)
        return
    # Every Browser Harness CLI invocation may inherit a daemon whose target
    # id is unchanged but whose CDP session is stale.  Do not trust the
    # daemon's current_tab/session pair; verify the target still exists and
    # create a fresh background attachment for every command.  This keeps the
    # working tab in the background and therefore does not steal keyboard
    # focus from the user.
    tabs = list_tabs(include_chrome=True)
    known_ids = {{
        str(tab.get("targetId") or tab.get("target_id") or "")
        for tab in tabs
    }}
    if target_id not in known_ids:
        raise RuntimeError("browser_use_recording_working_tab_missing")
    attached = cdp("Target.attachToTarget", targetId=target_id, flatten=True)
    session_id = attached.get("sessionId")
    if not session_id:
        raise RuntimeError("browser_use_recording_background_attach_failed")
    _browser_helpers._send({{"meta": "set_session", "session_id": session_id, "target_id": target_id}})

if name == "record-start":
    expected = cmd[2]
    actual = start_recording(cmd[1], title=cmd[3] if len(cmd) > 3 else None)
    if os.path.realpath(actual) != os.path.realpath(expected):
        raise RuntimeError("recording path mismatch")
    inventory = _initialize_tab_inventory()
    emit({{"success": True, "data": {{"recording_dir": actual, "recording_active": True, "page": info(), "tab_inventory": inventory}}}})
elif name == "record-stop":
    expected = cmd[1]
    # Bind the final semantic snapshot to the same target/session immediately
    # before stop_recording() flushes its final frame.  The parent helper keeps
    # only hashes/lengths from this payload, never the DOM body.
    _prepare_recording_command("state", ["state"])
    final_page = info()
    final_state = state_text()
    actual = stop_recording()
    if not actual or os.path.realpath(actual) != os.path.realpath(expected):
        raise RuntimeError("recording stop path mismatch")
    emit({{"success": True, "data": {{"recording_dir": actual, "recording_active": False, "final_page": final_page, "final_state": final_state}}}})
elif name == "open":
    _prepare_recording_command(name, cmd)
    if _tab_inventory_path():
        goto_url(cmd[1])
    else:
        new_tab(cmd[1])
    wait_for_load(15)
    emit({{"success": True, "data": info()}})
elif name == "state":
    _prepare_recording_command(name, cmd)
    current = info()
    emit({{"success": True, "data": {{"url": current.get("url", ""), "title": current.get("title", ""), "state": state_text()}}}})
elif name == "viewport":
    _prepare_recording_command(name, cmd)
    if len(cmd) != 3:
        raise RuntimeError("viewport requires <width> <height>")
    width, height = int(cmd[1]), int(cmd[2])
    window = cdp("Browser.getWindowForTarget", targetId=_current_target_id())
    window_id = window.get("windowId")
    if window_id is None:
        raise RuntimeError("browser_window_id_missing")
    cdp("Browser.setWindowBounds", windowId=int(window_id), bounds={{"width": width, "height": height, "windowState": "normal"}})
    cdp("Emulation.setDeviceMetricsOverride", width=width, height=height, deviceScaleFactor=1, mobile=True)
    wait(0.2)
    current = info()
    emit({{"success": True, "data": {{"width": width, "height": height, "url": current.get("url", ""), "title": current.get("title", "")}}}})
elif name == "get":
    _prepare_recording_command(name, cmd)
    current = info()
    if len(cmd) >= 2 and cmd[1] == "title":
        emit({{"success": True, "data": {{"title": current.get("title", "")}}}})
    elif len(cmd) >= 2 and cmd[1] == "url":
        emit({{"success": True, "data": {{"url": current.get("url", "")}}}})
    elif len(cmd) >= 3 and cmd[1] == "attributes":
        index = int(cmd[2])
        attrs = js("(()=>{{const e=Array.from(document.querySelectorAll('body *'))[%d];if(!e)return null;return Object.fromEntries(Array.from(e.attributes).map(a=>[a.name,a.value]));}})()" % index)
        emit({{"success": True, "data": {{"index": index, "attributes": attrs or {{}}}}}})
    elif len(cmd) >= 3 and cmd[1] == "bbox":
        index = int(cmd[2])
        emit({{"success": True, "data": {{"index": index, "bbox": element_bbox(index)}}}})
    else:
        raise RuntimeError("unsupported get field")
elif name == "extract":
    _prepare_recording_command(name, cmd)
    emit({{"success": True, "data": {{"text": js("document.body.innerText")}}}})
elif name == "eval":
    _prepare_recording_command(name, cmd)
    emit({{"success": True, "data": {{"result": js(cmd[1])}}}})
elif name == "screenshot":
    _prepare_recording_command(name, cmd)
    emit({{"success": True, "data": {{"path": capture_screenshot(cmd[1])}}}})
elif name == "upload":
    _prepare_recording_command(name, cmd)
    # Upload is authorized-only and preflight-validated by the parent helper.
    # Resolve the file input from the current DOM at execution time; callers
    # must not persist an element index across state changes.
    if len(cmd) == 2:
        input_index = 0
        file_path = cmd[1]
    elif len(cmd) == 3 and str(cmd[1]).isdigit():
        input_index = int(cmd[1])
        file_path = cmd[2]
    else:
        raise RuntimeError("upload requires <path> or <file-input-index> <path>")
    # Some authorized application forms render the file input inside a
    # shadow-root or a same-origin child frame after the upload control is
    # clicked.  Ask CDP for the pierced DOM and retain a bounded node walk as
    # a fallback because DOM.querySelectorAll does not pierce every returned
    # subtree consistently across Chrome versions.
    document = cdp("DOM.getDocument", depth=-1, pierce=True)
    main_session_id = _browser_helpers._send({{"meta": "session"}}).get("session_id")
    main_target_id = _current_target_id()
    if not main_session_id:
        raise RuntimeError("upload_main_session_missing")
    root_node = (document.get("root") or {{}}).get("nodeId")
    if root_node is None:
        raise RuntimeError("upload_document_root_missing")
    def collect_file_inputs(node):
        if not isinstance(node, dict):
            return []
        attrs = node.get("attributes") or []
        attr_map = dict(zip(attrs[::2], attrs[1::2]))
        node_name = str(node.get("nodeName") or "").lower()
        found = []
        if node_name == "input" and str(attr_map.get("type") or "").lower() == "file":
            ref = {{
                key: int(node[key])
                for key in ("nodeId", "backendNodeId")
                if node.get(key) is not None
            }}
            if ref:
                found.append(ref)
        for child_key in ("children", "shadowRoots", "templateContent"):
            for child in node.get(child_key) or []:
                found.extend(collect_file_inputs(child))
        content_document = node.get("contentDocument")
        if content_document:
            found.extend(collect_file_inputs(content_document))
        return found

    def bind_refs(refs, session_id, target_id):
        return [
            {{**ref, "session_id": session_id, "target_id": target_id}}
            for ref in refs
            if isinstance(ref, dict)
        ]

    def discover_oopif_file_inputs():
        # Browser Use's native uploader resolves the CDP session belonging to
        # the element's frame.  The main-page DOM can expose an OOPIF as an
        # iframe placeholder, but DOM.setFileInputFiles must be sent to that
        # iframe's own session.  Inspect only current-run iframe targets and
        # retain no frame URL or page content.
        refs = []
        try:
            target_infos = cdp("Target.getTargets").get("targetInfos") or []
        except Exception:
            return refs
        for target_info in target_infos:
            if not isinstance(target_info, dict) or target_info.get("type") != "iframe":
                continue
            target_id = str(target_info.get("targetId") or "")
            if not target_id or target_id == main_target_id:
                continue
            frame_session_id = None
            try:
                attached = cdp("Target.attachToTarget", targetId=target_id, flatten=True)
                frame_session_id = attached.get("sessionId")
                if not frame_session_id:
                    continue
                frame_document = cdp("DOM.getDocument", session_id=frame_session_id, depth=-1, pierce=True)
                frame_root = (frame_document.get("root") or {{}}).get("nodeId")
                if frame_root is None:
                    continue
                frame_refs = [
                    {{"nodeId": int(node_id)}}
                    for node_id in cdp(
                        "DOM.querySelectorAll",
                        session_id=frame_session_id,
                        nodeId=int(frame_root),
                        selector="input[type=file]",
                    ).get("nodeIds", [])
                ]
                if not frame_refs:
                    frame_refs = collect_file_inputs(frame_document.get("root") or {{}})
                refs.extend(bind_refs(frame_refs, frame_session_id, target_id))
            except Exception:
                # A stale/closed OOPIF is a read-only discovery miss; the
                # main target and the next candidate remain authoritative.
                continue
        return refs

    def discover_file_inputs():
        current_document = cdp("DOM.getDocument", depth=-1, pierce=True)
        current_root = (current_document.get("root") or {{}}).get("nodeId")
        if current_root is None:
            raise RuntimeError("upload_document_root_missing")
        refs = bind_refs(
            [{{"nodeId": int(node_id)}} for node_id in cdp("DOM.querySelectorAll", nodeId=int(current_root), selector="input[type=file]").get("nodeIds", [])],
            main_session_id,
            main_target_id,
        )
        # Do not stop at the first main-document match.  Provider forms often
        # leave a hidden placeholder input in the top document while the live
        # control is inside a shadow tree or an OOPIF.  All candidates below
        # are still same-run, frame-bound discovery; dispatch remains a
        # separate single attempt.
        refs.extend(bind_refs(collect_file_inputs(current_document.get("root") or {{}}), main_session_id, main_target_id))
        # DOM.getDocument can still omit a provider-rendered input when the
        # form is nested under a shadow tree or frame. CDP's flattened
        # document is the same-run fallback for that case.
        try:
            flattened = cdp("DOM.getFlattenedDocument", depth=-1, pierce=True)
        except Exception:
            flattened = {{}}
        for node in flattened.get("nodes") or []:
            if not isinstance(node, dict):
                continue
            attrs = node.get("attributes") or []
            attr_map = dict(zip(attrs[::2], attrs[1::2]))
            if str(node.get("nodeName") or "").lower() != "input" or str(attr_map.get("type") or "").lower() != "file":
                continue
            ref = {{
                key: int(node[key])
                for key in ("nodeId", "backendNodeId")
                if node.get(key) is not None
            }}
            if ref:
                refs.extend(bind_refs([ref], main_session_id, main_target_id))
        # Some application widgets expose the file input only through a live
        # shadow tree or a same-origin frame. Ask the page runtime for the
        # first matching DOM object, then convert it back to a CDP node
        # without retaining page content.  Keep this as another candidate,
        # not an early return, so OOPIF discovery is never skipped.
        if not refs:
            expression = """(() => {{
                const visit = (root) => {{
                    if (!root) return null;
                    const files = root.querySelectorAll ? root.querySelectorAll('input[type=file]') : [];
                    if (files.length) return files[0];
                    const elements = root.querySelectorAll ? root.querySelectorAll('*') : [];
                    for (const element of elements) {{
                        if (element.shadowRoot) {{
                            const shadowMatch = visit(element.shadowRoot);
                            if (shadowMatch) return shadowMatch;
                        }}
                        if (element.tagName === 'IFRAME') {{
                            try {{
                                const frameMatch = visit(element.contentDocument);
                                if (frameMatch) return frameMatch;
                            }} catch (error) {{}}
                        }}
                    }}
                    return null;
                }};
                return visit(document);
            }})()"""
            evaluated = cdp("Runtime.evaluate", expression=expression, returnByValue=False, awaitPromise=False)
            object_id = (evaluated.get("result") or {{}}).get("objectId")
            if object_id:
                requested = cdp("DOM.requestNode", objectId=object_id)
                node_id = (requested or {{}}).get("nodeId")
                if node_id is not None:
                    refs.append({{"nodeId": int(node_id), "session_id": main_session_id, "target_id": main_target_id}})
        refs.extend(discover_oopif_file_inputs())
        unique = []
        seen = set()
        for ref in refs:
            key = (
                str(ref.get("session_id") or main_session_id),
                str(ref.get("target_id") or main_target_id),
                str(ref.get("backendNodeId") or ""),
                str(ref.get("nodeId") or ""),
            )
            if key in seen:
                continue
            seen.add(key)
            unique.append(ref)
        return unique

    file_refs = []
    last_discovery_error = None
    # The upload trigger can insert the file input asynchronously. Retry
    # bounded read-only DOM discovery before treating the upload as failed.
    for discovery_index in range(5):
        try:
            file_refs = discover_file_inputs()
            last_discovery_error = None
        except Exception as error:
            last_discovery_error = error
            file_refs = []
        if file_refs:
            break
        if discovery_index < 4:
            time.sleep(0.5)
    if input_index < 0 or input_index >= len(file_refs):
        if last_discovery_error is not None and not file_refs:
            raise last_discovery_error
        raise RuntimeError("upload_file_input_not_found")
    file_ref = file_refs[input_index]
    dispatch_error = None
    attached = False
    # LinkedIn can repaint the application modal between the target click and
    # this command.  In that case the first nodeId is stale even though a live
    # file input is present.  Try the already-discovered node once, then
    # rebind its backend node, and finally reacquire the live DOM object once
    # through Runtime.evaluate/DOM.requestNode.  The file selection itself is
    # dispatched at most once; all other attempts are read-only rebinding.
    candidates = [file_ref, *file_refs[input_index + 1:]]
    for candidate in candidates:
        candidate_session_id = candidate.get("session_id") or main_session_id
        try:
            if candidate.get("nodeId") is not None:
                try:
                    cdp("DOM.setFileInputFiles", session_id=candidate_session_id, nodeId=int(candidate["nodeId"]), files=[file_path])
                    attached = True
                    break
                except Exception as error:
                    dispatch_error = error
                described = cdp("DOM.describeNode", session_id=candidate_session_id, nodeId=int(candidate["nodeId"]))
                described_node = (described or {{}}).get("node") or {{}}
                backend_node_id = described_node.get("backendNodeId")
                if backend_node_id is not None:
                    cdp("DOM.setFileInputFiles", session_id=candidate_session_id, backendNodeId=int(backend_node_id), files=[file_path])
                    attached = True
                    break
            elif candidate.get("backendNodeId") is not None:
                cdp("DOM.setFileInputFiles", session_id=candidate_session_id, backendNodeId=int(candidate["backendNodeId"]), files=[file_path])
                attached = True
                break
        except Exception as error:
            dispatch_error = error

    if not attached:
        # Reacquire the current live element after any modal repaint.  Do not
        # retain the JS object or page content beyond this command.
        expression = """(() => {{
            const visit = (root) => {{
                if (!root) return null;
                const direct = root.querySelectorAll ? root.querySelectorAll('input[type=file]') : [];
                if (direct.length) return direct[0];
                const elements = root.querySelectorAll ? root.querySelectorAll('*') : [];
                for (const element of elements) {{
                    if (element.shadowRoot) {{
                        const shadowMatch = visit(element.shadowRoot);
                        if (shadowMatch) return shadowMatch;
                    }}
                    if (element.tagName === 'IFRAME') {{
                        try {{
                            const frameMatch = visit(element.contentDocument);
                            if (frameMatch) return frameMatch;
                        }} catch (error) {{}}
                    }}
                }}
                return null;
            }};
            return visit(document);
        }})()"""
        try:
            evaluated = cdp("Runtime.evaluate", session_id=main_session_id, expression=expression, returnByValue=False, awaitPromise=False)
            object_id = (evaluated.get("result") or {{}}).get("objectId")
            if object_id:
                requested = cdp("DOM.requestNode", session_id=main_session_id, objectId=object_id)
                node_id = (requested or {{}}).get("nodeId")
                if node_id is not None:
                    cdp("DOM.setFileInputFiles", session_id=main_session_id, nodeId=int(node_id), files=[file_path])
                    attached = True
        except Exception as error:
            dispatch_error = error
    if not attached:
        if dispatch_error is not None:
            raise RuntimeError("upload_file_input_dispatch_failed") from dispatch_error
        raise RuntimeError("upload_file_input_not_found")
    emit({{"success": True, "data": {{"input_index": input_index, "file_attached": True}}}})
elif name == "click":
    _prepare_recording_command(name, cmd)
    if len(cmd) == 2:
        bbox = element_bbox(int(cmd[1]))
        if not bbox or bbox["width"] <= 0 or bbox["height"] <= 0:
            raise RuntimeError("element has no visible bounding box")
        click_at_xy(bbox["x"] + bbox["width"] / 2, bbox["y"] + bbox["height"] / 2)
    else:
        click_at_xy(float(cmd[1]), float(cmd[2]))
    emit({{"success": True, "data": {{}}}})
elif name in {{"dblclick", "rightclick"}}:
    _prepare_recording_command(name, cmd)
    button = "right" if name == "rightclick" else "left"
    click_at_xy(float(cmd[1]), float(cmd[2]), button=button, clicks=2 if name == "dblclick" else 1)
    emit({{"success": True, "data": {{}}}})
elif name in {{"type", "input"}}:
    _prepare_recording_command(name, cmd)
    type_text(cmd[-1])
    emit({{"success": True, "data": {{}}}})
elif name == "keys":
    _prepare_recording_command(name, cmd)
    for key in cmd[1:]:
        press_key(key)
    emit({{"success": True, "data": {{}}}})
elif name == "scroll":
    _prepare_recording_command(name, cmd)
    if len(cmd) == 2:
        scroll(0, 0, dy=float(cmd[1]))
    elif len(cmd) >= 3:
        scroll(float(cmd[1]), float(cmd[2]), dy=float(cmd[3]) if len(cmd) > 3 else -300, dx=float(cmd[4]) if len(cmd) > 4 else 0)
    emit({{"success": True, "data": {{}}}})
elif name == "back":
    _prepare_recording_command(name, cmd)
    cdp("Page.goBack")
    wait_for_load(15)
    emit({{"success": True, "data": {{}}}})
elif name == "wait":
    _prepare_recording_command(name, cmd)
    wait(float(cmd[1]) if len(cmd) > 1 else 1.0)
    emit({{"success": True, "data": {{}}}})
elif name == "switch":
    _prepare_recording_command(name, cmd)
    switch_tab(cmd[1])
    emit({{"success": True, "data": {{}}}})
elif name == "close-tab":
    _prepare_recording_command(name, cmd)
    close_tab(cmd[1] if len(cmd) > 1 else None)
    emit({{"success": True, "data": {{}}}})
elif name == "hover":
    _prepare_recording_command(name, cmd)
    cdp("Input.dispatchMouseEvent", type="mouseMoved", x=float(cmd[1]), y=float(cmd[2]))
    emit({{"success": True, "data": {{}}}})
else:
    raise RuntimeError(f"unsupported Browser Harness command: {{name}}")
'''


def browser_harness_batch_script(commands: list[list[str]], frame_capture_paths: list[str]) -> str:
    """Build one bounded Browser Use process for read-only actions and proof.

    Browser Use exposes a script-per-process CLI rather than a persistent stdin
    protocol.  The batch transport therefore composes the already-pinned
    helper scripts into one process.  Each logical action is followed by a
    state probe and a run-owned visual frame; navigation actions also receive
    the same URL/readiness probes used by the individual command path.
    """
    if len(commands) != len(frame_capture_paths) or not commands:
        raise ValueError("browser_use_record_batch_transport_shape_invalid")
    jobs: list[dict[str, Any]] = []

    def add_job(kind: str, index: int, command: list[str], *, path: str | None = None) -> None:
        builder = browser_harness_ax_script if command and command[0] in {"ax-inspect", "ax-click"} else browser_harness_script
        jobs.append({
            "kind": kind,
            "index": index,
            "name": command[0] if command else "",
            "command_digest": hashlib.sha256(json.dumps(command, ensure_ascii=True, separators=(",", ":")).encode("utf-8")).hexdigest(),
            "path": os.path.realpath(path) if path else None,
            "source": builder(command),
        })

    for index, command in enumerate(commands):
        add_job("command", index, command)
        if command != ["state"]:
            add_job("post-state", index, ["state"])
        if command and command[0] in {"open", "back", "switch"}:
            add_job("navigation-url", index, ["get", "url"])
            add_job("navigation-probe", index, ["eval", "JSON.stringify({url:location.href,ready_state:document.readyState})"])
        add_job("frame", index, ["screenshot", frame_capture_paths[index]], path=frame_capture_paths[index])

    # This is embedded in a Python program executed by ``browser-use``;
    # JSON's ``null`` is not valid Python.  ``repr`` is safe here because the
    # jobs contain only helper-generated strings, bounded integers, and None.
    jobs_literal = repr(jobs)
    return f'''import contextlib, io, json

_BATCH_JOBS = {jobs_literal}

def _last_json_line(text):
    for line in reversed(str(text or "").splitlines()):
        value = line.strip()
        if not value:
            continue
        try:
            parsed = json.loads(value)
        except (TypeError, ValueError, json.JSONDecodeError):
            continue
        if isinstance(parsed, dict):
            return parsed
    return None

_BATCH_RESULTS = []
for _job in _BATCH_JOBS:
    _buffer = io.StringIO()
    try:
        with contextlib.redirect_stdout(_buffer):
            exec(_job["source"], globals(), globals())
        _parsed = _last_json_line(_buffer.getvalue())
        if not isinstance(_parsed, dict) or _parsed.get("success") is not True:
            raise RuntimeError("browser_use_record_batch_child_result_invalid")
        _entry = {{
            "kind": _job["kind"],
            "index": _job["index"],
            "name": _job["name"],
            "command_digest": _job["command_digest"],
        }}
        if _job["kind"] in {{"command", "navigation-url", "navigation-probe"}}:
            # Keep only the final JSON envelope needed by the parent parser.
            # The page payload remains transient in the child/parent pipe and
            # is never written into the durable descriptor by this transport.
            _entry["stdout"] = json.dumps(_parsed, ensure_ascii=True, separators=(",", ":"))
        if _job["kind"] == "frame":
            _entry["capture_path"] = _job["path"]
        _BATCH_RESULTS.append(_entry)
    except BaseException:
        print(json.dumps({{
            "status": "blocked",
            "batch": True,
            "exact_blocker": "browser_use_record_batch_transport_child_failed",
            "completed_jobs": len(_BATCH_RESULTS),
            "results": _BATCH_RESULTS,
        }}, ensure_ascii=True, separators=(",", ":")))
        raise RuntimeError("browser_use_record_batch_transport_child_failed")

print(json.dumps({{
    "status": "completed",
    "batch": True,
    "transport": "single_browser_use_process",
    "results": _BATCH_RESULTS,
}}, ensure_ascii=True, separators=(",", ":")))
'''


def browser_harness_ax_script(command: list[str]) -> str:
    """Build a fresh AX Tree target resolver for Browser Harness 0.13.7."""
    command_literal = json.dumps(command, ensure_ascii=True)
    target_literal = json.dumps(command[1] if len(command) > 1 else "", ensure_ascii=True)
    return """import hashlib, json, os, time
import re
from browser_harness import helpers as _browser_helpers
from browser_harness.recorder import recording_dir
__TAB_GUARD__

cmd = __COMMAND_LITERAL__
name = cmd[0]
target = cmd[1] if len(cmd) > 1 else ""

def emit(value):
    if _tab_inventory_path():
        inventory = _finish_recording_command()
        if isinstance(value, dict) and isinstance(value.get("data"), dict):
            value["data"]["tab_inventory"] = inventory
    print(json.dumps(value, ensure_ascii=True, separators=(",", ":")))

def text_value(value):
    if isinstance(value, dict):
        return str(value.get("value", ""))
    return str(value or "")

def normalized(value):
    return " ".join(str(value).split()).casefold()

def page_summary():
    current = page_info()
    url = str(current.get("url", ""))
    title = str(current.get("title", ""))
    return {
        "url_length": len(url),
        "url_sha256": hashlib.sha256(url.encode("utf-8")).hexdigest(),
        "title_length": len(title),
        "title_sha256": hashlib.sha256(title.encode("utf-8")).hexdigest(),
    }

def attach_recording_target(target_id, activate=False):
    # AX inspection must use the same fresh background attachment as normal
    # recording commands, without activating Chrome or stealing keyboard focus.
    target_id = str(target_id)
    if activate:
        switch_tab(target_id)
        return
    tabs = list_tabs(include_chrome=True)
    known_ids = {
        str(tab.get("targetId") or tab.get("target_id") or "")
        for tab in tabs
    }
    if target_id not in known_ids:
        raise RuntimeError("browser_use_recording_working_tab_missing")
    attached = cdp("Target.attachToTarget", targetId=target_id, flatten=True)
    session_id = attached.get("sessionId")
    if not session_id:
        raise RuntimeError("browser_use_recording_background_attach_failed")
    _browser_helpers._send({"meta": "set_session", "session_id": session_id, "target_id": target_id})

def resolve_state_target():
    candidate = _browser_helpers.js('''(()=>{
      const normalize = value => String(value ?? '').trim().toLocaleLowerCase().split(' ').filter(Boolean).join(' ');
      const targetNorm = normalize(__TARGET_LITERAL__);
      const interactiveTags = new Set(['a','button','input','select','textarea','summary']);
      const interactiveRoles = new Set(['button','checkbox','combobox','link','menuitem','option','radio','searchbox','slider','spinbutton','switch','tab','textbox','listbox','treeitem','gridcell']);
      const matches = Array.from(document.querySelectorAll('body *')).slice(0, 1000).map((element, index) => {
        const text = String(element.innerText || element.textContent || '').trim();
        const rect = element.getBoundingClientRect();
        if (!(rect.width > 0 && rect.height > 0)) return null;
        const tag = element.tagName.toLocaleLowerCase();
        const role = String(element.getAttribute('role') || '').toLocaleLowerCase();
        const attributes = {};
        const semanticNames = ['role','tabindex','aria-label','title','value','name','placeholder','data-testid'];
        for (const name of semanticNames) {
          const value = element.getAttribute(name);
          if (value !== null) attributes[name] = String(value);
        }
        const semanticText = [text, ...semanticNames.map(name => attributes[name] || '')].filter(Boolean).join(' ');
        const normalizedText = normalize(semanticText);
        if (!targetNorm || !normalizedText.includes(targetNorm)) return null;
        const hasInlineHandler = ['onclick','onmousedown','onpointerdown'].some(name =>
          element.getAttribute(name) !== null || typeof element[name] === 'function'
        );
        const interactiveScore = tag === 'button'
          ? 4
          : tag === 'a' || interactiveRoles.has(role)
            ? 3
            : hasInlineHandler || ((attributes.tabindex ?? '').trim() !== '' && Number(attributes.tabindex) >= 0)
              ? 2
              : 0;
        return {
          index, tag, text_length: semanticText.length,
          interactive: interactiveScore > 0,
          interactive_score: interactiveScore,
          hasInlineHandler,
          attributes,
          bbox: {x: rect.x, y: rect.y, width: rect.width, height: rect.height},
          exact_name: normalizedText === targetNorm,
        };
      }).filter(Boolean).sort((left, right) =>
        Number(right.exact_name) - Number(left.exact_name) ||
        Number(right.interactive_score) - Number(left.interactive_score) ||
        left.text_length - right.text_length || left.index - right.index
      );
      if (!matches.length) return null;
      const best = matches[0];
      const rank = [best.exact_name, best.interactive_score, best.text_length];
      if (matches.filter(item => item.exact_name === rank[0] && item.interactive_score === rank[1] && item.text_length === rank[2]).length > 1) {
        return {__browser_use_error: 'ax_target_ambiguous'};
      }
      return best;
    })()''')
    if not isinstance(candidate, dict):
        raise RuntimeError("ax_target_not_found")
    if candidate.get("__browser_use_error"):
        raise RuntimeError(str(candidate["__browser_use_error"]))
    candidate = dict(candidate)
    candidate.pop("exact_name", None)
    candidate.pop("interactive_score", None)
    candidate["match_text_sha256"] = hashlib.sha256(str(target).encode("utf-8")).hexdigest()
    return candidate

def resolve_target():
    target_norm = normalized(target)
    if not target_norm:
        raise RuntimeError("ax_target_text_missing")
    interactive_roles = {
        "button", "checkbox", "combobox", "link", "menuitem", "option",
        "radio", "searchbox", "slider", "spinbutton", "switch", "tab",
        "textbox", "listbox", "treeitem", "gridcell"
    }
    matches = []
    try:
        nodes = cdp("Accessibility.getFullAXTree").get("nodes", [])
    except Exception:
        # Some pages or daemon sessions do not expose the Accessibility
        # domain.  The state resolver below is the safe fallback and keeps
        # target inspection usable without foreground activation.
        nodes = []
    for node in nodes:
        if node.get("ignored"):
            continue
        role = text_value(node.get("role"))
        accessible_name = text_value(node.get("name"))
        name_norm = normalized(accessible_name)
        if not accessible_name or target_norm not in name_norm:
            continue
        backend = node.get("backendDOMNodeId")
        if backend is None:
            continue
        try:
            # AX nodes may be semantically correct while still being below
            # the current viewport.  Make the same fresh target visible
            # before taking its box model; otherwise ax-click can dispatch to
            # an off-screen or stale coordinate (notably upload/submit
            # controls rendered after a long form).
            cdp("DOM.scrollIntoViewIfNeeded", backendNodeId=int(backend))
            wait(0.05)
            model = cdp("DOM.getBoxModel", backendNodeId=int(backend)).get("model", {})
        except Exception:
            continue
        content = model.get("content") or []
        if len(content) < 8:
            continue
        try:
            xs = [float(value) for value in content[0::2]]
            ys = [float(value) for value in content[1::2]]
        except (TypeError, ValueError):
            continue
        bbox = {
            "x": min(xs), "y": min(ys),
            "width": max(xs) - min(xs), "height": max(ys) - min(ys)
        }
        if bbox["width"] <= 0 or bbox["height"] <= 0:
            continue
        interactive = role.casefold() in interactive_roles
        exact = name_norm == target_norm
        matches.append({
            "role": role,
            "name_length": len(accessible_name),
            "name_sha256": hashlib.sha256(accessible_name.encode("utf-8")).hexdigest(),
            "backend_present": True,
            "interactive": interactive,
            "exact_name": exact,
            "bbox": bbox,
            "backend": int(backend),
        })
    if not matches:
        return resolve_state_target()
    interactive_matches = [item for item in matches if item["interactive"]]
    if not interactive_matches:
        # The AX tree may expose only a static text node even when its
        # semantic parent is the actual button.  Re-resolve through the fresh
        # DOM state so a button/role/tabindex parent can win; never click the
        # static AX text as a coordinate fallback.
        return resolve_state_target()
    matches = interactive_matches
    matches.sort(key=lambda item: (
        not item["exact_name"], not item["interactive"],
        item["name_length"], item["role"], item["backend"]
    ))
    best = matches[0]
    rank = (best["exact_name"], best["interactive"], best["name_length"])
    tied = [
        item for item in matches
        if (item["exact_name"], item["interactive"], item["name_length"]) == rank
    ]
    if len(tied) > 1:
        # Accessibility trees can expose duplicate nodes for one visible
        # provider control. Re-resolve from the same fresh DOM snapshot so a
        # unique visible interactive parent may win; the DOM resolver still
        # fails closed when distinct equal-best controls remain.
        return resolve_state_target()
    best = dict(best)
    best.pop("exact_name", None)
    best.pop("backend", None)
    return best

_prepare_recording_command(name, cmd)
before = page_summary()
dispatch_started = False
if name == "ax-inspect":
    try:
        candidate = resolve_target()
    except RuntimeError as exc:
        # A missing localized alias is a normal read-only probe result. Return
        # a bounded empty candidate so the caller can inspect the next alias;
        # ambiguous or transport failures still stop the operation.
        if str(exc) != "ax_target_not_found":
            raise
        candidate = None
    emit({"success": True, "data": {"candidate": candidate, "before": before}})
elif name == "ax-click":
    candidate = resolve_target()
    if candidate.get("interactive") is not True:
        raise RuntimeError("browser_use_target_not_interactive")
    bbox = candidate["bbox"]
    dispatch_started = True
    click_at_xy(bbox["x"] + bbox["width"] / 2, bbox["y"] + bbox["height"] / 2)
    wait(0.6)
    after = page_summary()
    emit({"success": True, "data": {
        "candidate": candidate, "before": before, "after": after,
        "state_changed": before != after, "dispatch_started": dispatch_started
    }})
else:
    raise RuntimeError("unsupported AX target command")
""".replace("__COMMAND_LITERAL__", command_literal).replace("__TARGET_LITERAL__", target_literal).replace("__TAB_GUARD__", _BROWSER_HARNESS_TAB_GUARD)



def run_browser_harness_reload(config: dict[str, Any], home: str, port: int, session: str) -> subprocess.CompletedProcess[str]:
    browser = config["executables"]["browser_use"]["canonical_path"]
    return subprocess.run(
        [browser, "--reload"],
        cwd=home,
        env=browser_harness_env(home, port, session),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=60,
    )


def cleanup_browser_harness_root(session: str) -> bool:
    """Remove only the exact per-session Harness root after daemon shutdown."""
    root = browser_harness_root(session)
    runtime = os.path.join(root, "runtime")
    if any(os.path.lexists(os.path.join(runtime, name)) for name in ("bu.sock", "bu.pid", "bu.port")):
        return False
    if os.path.lexists(root):
        if not os.path.isdir(root) or os.path.islink(root):
            return False
        shutil.rmtree(root)
    return not os.path.lexists(root)


def recording_cli_failure_marker(stderr: str) -> str:
    # Browser Harness resolves a numeric element target and checks its fresh
    # bounding box before sending any input event.  Preserve that exact
    # pre-dispatch fact instead of collapsing it into the generic
    # ``runtime_error`` marker, so the bounded no-dispatch proof can be
    # reconciled without replaying the click.
    if "element has no visible bounding box" in str(stderr or ""):
        return "runtime_error_browser_use_element_no_visible_bounding_box"
    name_match = re.search(r"NameError: name '([A-Za-z_][A-Za-z0-9_]*)' is not defined", str(stderr or ""))
    if name_match:
        return f"name_error_{name_match.group(1)}"
    runtime_match = re.search(r"RuntimeError: ([A-Za-z_][A-Za-z0-9_]*)", str(stderr or ""))
    if runtime_match:
        code = runtime_match.group(1)
        if code.startswith(("ax_", "browser_use_", "recording_", "upload")):
            return f"runtime_error_{code}"
    allowlisted = (
        ("missing_python_module", ("ModuleNotFoundError", "No module named")),
        ("import_error", ("ImportError",)),
        ("type_error", ("TypeError",)),
        ("attribute_error", ("AttributeError",)),
        ("key_error", ("KeyError",)),
        ("name_error", ("NameError",)),
        ("syntax_error", ("SyntaxError",)),
        ("value_error", ("ValueError",)),
        ("index_error", ("IndexError",)),
        ("assertion_error", ("AssertionError",)),
        ("runtime_error", ("RuntimeError",)),
        ("connection_error", ("ConnectionError", "Connection refused", "ERR_CONNECTION_REFUSED", "Could not connect")),
        ("timeout_error", ("TimeoutError", "timed out")),
        ("file_not_found", ("FileNotFoundError",)),
        ("daemon_no_response", ("No response from daemon",)),
        ("daemon_start_failed", ("Failed to start daemon",)),
        ("daemon_config_mismatch", ("already running with different config",)),
        ("browser_session_missing", ("No active browser session", "No browser session")),
        ("target_closed", ("Target closed", "page has been closed")),
        ("navigation_failed", ("Navigation", "navigation", "navigate")),
        ("cdp_connection_failed", ("CDP", "WebSocket", "websocket")),
        ("python_traceback", ("Traceback",)),
    )
    for marker, needles in allowlisted:
        if any(needle in stderr for needle in needles):
            return marker
    # Keep unknown diagnostics reproducible without retaining stderr, page
    # content, URLs, credentials, cookies, or tokens.
    encoded = stderr.encode("utf-8", errors="replace")
    fingerprint = hashlib.sha256(encoded).hexdigest()[:16]
    return f"cli_error_fingerprint_{fingerprint}_bytes_{len(encoded)}"


def target_resolution_failed_before_dispatch(marker: str) -> bool:
    """Classify resolver failures that occur before any click coordinates are sent."""
    return str(marker) in NO_DISPATCH_FAILURE_MARKERS


def parse_authority(path: str, run_id: str, session: str, *, aliases: list[str] | None = None, require_unexpired: bool = True) -> dict[str, Any]:
    path = assert_authority_file(path)
    value = read_json_safe(path)
    required = {"browser_surface", "run_id", "session", "expires_at", "allowed_origins", "account_identity", "data_exposure", "side_effect_scope", "approval", "readback_required"}
    missing = sorted(required - value.keys())
    if missing:
        raise Blocker("browser_use_authority_fields_missing", ",".join(missing))
    accepted_sessions = {session, *(aliases or [])}
    if value["browser_surface"] != "browser_use_cli" or value["run_id"] != run_id or value["session"] not in accepted_sessions:
        raise Blocker("browser_use_authority_binding_mismatch")
    try:
        expires = dt.datetime.fromisoformat(str(value["expires_at"]).replace("Z", "+00:00"))
    except ValueError as exc:
        raise Blocker("browser_use_authority_expiry_invalid") from exc
    if expires.tzinfo is None or (require_unexpired and expires <= now_utc()):
        raise Blocker("browser_use_authority_expired")
    if not isinstance(value["allowed_origins"], list) or not value["allowed_origins"]:
        raise Blocker("browser_use_authority_allowed_origins_missing")
    for origin in value["allowed_origins"]:
        normalize_origin(origin)
    if not isinstance(value["account_identity"], str) or not value["account_identity"]:
        raise Blocker("browser_use_authority_account_identity_missing")
    for field in ("data_exposure", "side_effect_scope"):
        if not isinstance(value[field], str) or not value[field].strip():
            raise Blocker("browser_use_authority_scope_missing", field)
    if value["approval"] not in {True, "approved", "APPROVED"}:
        raise Blocker("browser_use_authority_approval_missing")
    if value["readback_required"] is not True:
        raise Blocker("browser_use_authority_readback_required")
    return value


def _authority_expiry(authority: dict[str, Any]) -> dt.datetime:
    try:
        expires = dt.datetime.fromisoformat(str(authority["expires_at"]).replace("Z", "+00:00"))
    except (KeyError, TypeError, ValueError) as exc:
        raise Blocker("browser_use_authority_expiry_invalid") from exc
    if expires.tzinfo is None:
        raise Blocker("browser_use_authority_expiry_invalid")
    return expires.astimezone(dt.timezone.utc)


def _authority_lineage_expiry(authority: dict[str, Any], descriptor: dict[str, Any] | None = None) -> dt.datetime:
    """Return the immutable end of an authority lineage.

    New authorities carry this boundary explicitly.  Older run-owned
    descriptors are upgraded once from their recorded start/issue time (or,
    when that evidence is unavailable, from this read), then the boundary is
    persisted on the next renewal.  A renewal can never move the boundary.
    """
    raw = authority.get("authority_lineage_expires_at")
    if raw is None and isinstance(descriptor, dict):
        raw = descriptor.get("authority_lineage_expires_at")
    if raw is not None:
        try:
            value = dt.datetime.fromisoformat(str(raw).replace("Z", "+00:00"))
        except ValueError as exc:
            raise Blocker("browser_use_authority_lineage_expiry_invalid") from exc
        if value.tzinfo is None:
            raise Blocker("browser_use_authority_lineage_expiry_invalid")
        return value.astimezone(dt.timezone.utc)
    anchor = authority.get("authority_issued_at") or authority.get("issued_at")
    if anchor is None and isinstance(descriptor, dict):
        anchor = descriptor.get("authority_issued_at") or descriptor.get("started_at")
    if anchor is not None:
        try:
            issued = dt.datetime.fromisoformat(str(anchor).replace("Z", "+00:00"))
        except ValueError as exc:
            raise Blocker("browser_use_authority_lineage_expiry_invalid") from exc
        if issued.tzinfo is None:
            raise Blocker("browser_use_authority_lineage_expiry_invalid")
        return issued.astimezone(dt.timezone.utc) + dt.timedelta(seconds=AUTHORITY_LINEAGE_MAX_SECONDS)
    # Legacy fixtures and pre-lineage authorities have no immutable issue
    # timestamp.  Give that lineage one bounded upgrade window; every later
    # renewal carries the explicit boundary and cannot extend it.
    return now_utc() + dt.timedelta(seconds=AUTHORITY_LINEAGE_MAX_SECONDS)


def authority_scope_digest(authority: dict[str, Any]) -> str:
    scope = {
        "data_exposure": authority.get("data_exposure"),
        "side_effect_scope": authority.get("side_effect_scope"),
        "approval": authority.get("approval"),
        "readback_required": authority.get("readback_required"),
    }
    return hashlib.sha256(json.dumps(scope, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def authority_budget(command_class: str) -> dict[str, int]:
    if not isinstance(command_class, str) or not command_class.strip():
        raise Blocker("browser_use_authority_command_class_invalid")
    dispatch = AUTHORITY_COMMAND_BUDGETS.get(command_class, AUTHORITY_READBACK_BUDGET_SECONDS)
    return {
        "dispatch_seconds": dispatch,
        "readback_seconds": AUTHORITY_READBACK_BUDGET_SECONDS,
        "checkpoint_seconds": AUTHORITY_CHECKPOINT_BUDGET_SECONDS,
        "clock_skew_seconds": AUTHORITY_CLOCK_SKEW_SECONDS,
        "required_seconds": dispatch + AUTHORITY_READBACK_BUDGET_SECONDS + AUTHORITY_CHECKPOINT_BUDGET_SECONDS + AUTHORITY_CLOCK_SKEW_SECONDS,
    }


def remaining_authority_budget(authority: dict[str, Any], command_class: str, *, now: dt.datetime | None = None) -> dict[str, Any]:
    now = (now or now_utc()).astimezone(dt.timezone.utc)
    expiry = _authority_expiry(authority)
    budget = authority_budget(command_class)
    remaining = (expiry - now).total_seconds()
    return {
        "command_class": command_class,
        "expires_at": iso(expiry),
        "remaining_seconds": max(0.0, remaining),
        "sufficient": remaining >= budget["required_seconds"],
        **budget,
    }


def write_authority_renewal_checkpoint(descriptor: dict[str, Any], *, command_class: str, budget: dict[str, Any], exact_blocker: str = "browser_use_authority_renewal_required") -> str:
    """Write only bounded, non-secret admission evidence before dispatch."""
    recording_dir = os.path.realpath(str(descriptor.get("recording_dir") or ""))
    if not recording_dir or not os.path.isabs(recording_dir):
        raise Blocker("browser_use_authority_checkpoint_scope_invalid")
    assert_directory(recording_dir, create=True)
    path = os.path.join(recording_dir, "authority-renewal-checkpoint.json")
    payload = {
        "schema": "browser-use-authority-renewal-checkpoint.v1",
        "run_id": descriptor.get("run_id"),
        "session": descriptor.get("session"),
        "command_class": command_class,
        "authority_generation": descriptor.get("authority_generation", 1),
        "authority_sha256": descriptor.get("authority_sha256"),
        "exact_blocker": exact_blocker,
        "remaining_seconds": budget.get("remaining_seconds"),
        "required_seconds": budget.get("required_seconds"),
        "readback_seconds": budget.get("readback_seconds"),
        "checkpoint_seconds": budget.get("checkpoint_seconds"),
        "clock_skew_seconds": budget.get("clock_skew_seconds"),
        "updated_at": iso(now_utc()),
    }
    json_atomic_replace(path, payload)
    descriptor["authority_checkpoint_path"] = path
    return path


def _authority_history_path(descriptor: dict[str, Any], name: str) -> str:
    recording_dir = os.path.realpath(str(descriptor.get("recording_dir") or ""))
    if not recording_dir or not os.path.isabs(recording_dir):
        raise Blocker("browser_use_authority_history_scope_invalid")
    path = os.path.join(recording_dir, name)
    if os.path.realpath(os.path.dirname(path)) != recording_dir:
        raise Blocker("browser_use_authority_history_scope_invalid")
    return path


def _read_jsonl_chain(path: str, schema: str, code_prefix: str) -> list[dict[str, Any]]:
    if not os.path.lexists(path):
        return []
    assert_regular_file(path, mode=0o600)
    rows: list[dict[str, Any]] = []
    previous = "0" * 64
    with open(path, encoding="utf-8") as handle:
        for sequence, line in enumerate(handle, 1):
            try:
                row = json.loads(line)
            except json.JSONDecodeError as exc:
                raise Blocker(f"{code_prefix}_invalid") from exc
            if not isinstance(row, dict) or row.get("schema") != schema or row.get("sequence") != sequence or row.get("previous_chain_digest") != previous:
                raise Blocker(f"{code_prefix}_sequence_invalid")
            body = dict(row)
            chain = body.pop("chain_digest", None)
            expected = hashlib.sha256((previous + json.dumps(body, sort_keys=True, separators=(",", ":"))).encode()).hexdigest()
            if chain != expected:
                raise Blocker(f"{code_prefix}_chain_invalid")
            rows.append(row)
            previous = chain
    return rows


def _append_jsonl_chain(path: str, schema: str, row: dict[str, Any], code_prefix: str) -> dict[str, Any]:
    parent = os.path.dirname(path)
    assert_directory(parent, create=True)
    if os.path.lexists(path):
        assert_regular_file(path, mode=0o600)
    else:
        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.close(fd)
    rows = _read_jsonl_chain(path, schema, code_prefix)
    value = {"schema": schema, "sequence": len(rows) + 1, "previous_chain_digest": rows[-1].get("chain_digest", "0" * 64) if rows else "0" * 64, **row}
    value["chain_digest"] = hashlib.sha256((value["previous_chain_digest"] + json.dumps(value, sort_keys=True, separators=(",", ":"))).encode()).hexdigest()
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n")
        handle.flush()
        os.fsync(handle.fileno())
    if _read_jsonl_chain(path, schema, code_prefix)[-1] != value:
        raise Blocker(f"{code_prefix}_readback_failed")
    return value


def _authority_history_row(descriptor: dict[str, Any], authority: dict[str, Any], *, digest: str, generation: int, previous_digest: str | None, issuer_id: str) -> dict[str, Any]:
    return {
        "run_id": descriptor.get("run_id"),
        "session": descriptor.get("session"),
        "authority_generation": generation,
        "authority_sha256": digest,
        "previous_authority_sha256": previous_digest,
        "issuer_id": issuer_id,
        "authority_issued_at": authority.get("authority_issued_at"),
        "authority_lineage_expires_at": authority.get("authority_lineage_expires_at"),
        "expires_at": authority.get("expires_at"),
        "account_identity": authority.get("account_identity"),
        "allowed_origins": sorted({normalize_origin(item) for item in authority.get("allowed_origins", [])}),
        "authority_scope_digest": authority_scope_digest(authority),
    }


def append_authority_generation(descriptor: dict[str, Any], authority: dict[str, Any], *, digest: str, generation: int, previous_digest: str | None, issuer_id: str) -> None:
    ledger = _authority_history_path(descriptor, "authority-generation-ledger.jsonl")
    rows = _read_jsonl_chain(ledger, AUTHORITY_LEDGER_SCHEMA, "browser_use_authority_ledger")
    if rows and generation != int(rows[-1]["authority_generation"]) + 1:
        raise Blocker("browser_use_authority_generation_lineage_mismatch")
    if not rows and generation != 1:
        raise Blocker("browser_use_authority_generation_lineage_mismatch")
    if rows and previous_digest != rows[-1].get("authority_sha256"):
        raise Blocker("browser_use_authority_previous_digest_mismatch")
    row = _authority_history_row(descriptor, authority, digest=digest, generation=generation, previous_digest=previous_digest, issuer_id=issuer_id)
    _append_jsonl_chain(ledger, AUTHORITY_LEDGER_SCHEMA, row, "browser_use_authority_ledger")
    history = _authority_history_path(descriptor, "authority-descriptor-history.jsonl")
    lineage = {
        "profile": descriptor.get("profile"),
        "port": descriptor.get("port"),
        "process": descriptor.get("process"),
        "session": descriptor.get("session"),
        "helper_sha256": descriptor.get("helper_sha256"),
    }
    _append_jsonl_chain(history, AUTHORITY_HISTORY_SCHEMA, {**row, "resource_lineage_digest": hashlib.sha256(json.dumps(lineage, sort_keys=True, separators=(",", ":")).encode()).hexdigest()}, "browser_use_authority_history")
    descriptor["authority_ledger_path"] = ledger
    descriptor["authority_history_path"] = history


def authority_lineage_lock_path(descriptor: dict[str, Any]) -> str:
    recording_dir = os.path.realpath(str(descriptor.get("recording_dir") or ""))
    if not recording_dir or not os.path.isabs(recording_dir):
        raise Blocker("browser_use_authority_lineage_lock_scope_invalid")
    path = os.path.join(recording_dir, "authority-lineage.lock")
    if os.path.realpath(os.path.dirname(path)) != recording_dir:
        raise Blocker("browser_use_authority_lineage_lock_scope_invalid")
    return path


def reconcile_authority_lineage_lock(descriptor: dict[str, Any]) -> None:
    """Release only a dead lock positively owned by this recording lineage."""
    path = authority_lineage_lock_path(descriptor)
    if not os.path.lexists(path):
        return
    value = read_json_safe(path)
    if (
        value.get("schema") != "browser-use-authority-lineage-lock.v1"
        or value.get("recording_run_id") != descriptor.get("run_id")
        or value.get("recording_nonce") != descriptor.get("nonce")
    ):
        raise Blocker("browser_use_authority_lineage_lock_owner_unknown")
    pid = value.get("lock_pid")
    start_time = value.get("lock_start_time")
    if not isinstance(pid, int) or pid <= 0 or not isinstance(start_time, (int, float)):
        raise Blocker("browser_use_authority_lineage_lock_identity_invalid")
    alive = False
    try:
        process = psutil.Process(pid) if psutil is not None else None
        if process is not None:
            alive = process.is_running() and abs(float(process.create_time()) - float(start_time)) < 0.5
        else:
            os.kill(pid, 0)
            alive = True
    except (OSError, psutil.Error if psutil is not None else OSError):
        alive = False
    if alive:
        raise Blocker("browser_use_authority_lineage_lock_active")
    release_lock(path, str(value["run_id"]), str(value["nonce"]))


def _validate_renewal_contract(config: dict[str, Any], descriptor: dict[str, Any], current: dict[str, Any], current_digest: str, renewal_path: str) -> tuple[dict[str, Any], str, int, str]:
    if not os.path.isabs(renewal_path) or os.path.realpath(renewal_path) != renewal_path:
        raise Blocker("browser_use_authority_renewal_path_invalid")
    assert_regular_file(renewal_path, mode=0o600)
    value = read_json_safe(renewal_path)
    if set(value) - AUTHORITY_RENEWAL_ALLOWED_KEYS or value.get("schema") != AUTHORITY_RENEWAL_SCHEMA:
        raise Blocker("browser_use_authority_renewal_schema_invalid")
    optional_bindings = {"automation_id", "stage_id", "mode", "not_before", "authority_id", "authority_schema", "authority_version"}
    lineage_optional = {"authority_issued_at", "authority_lineage_expires_at"}
    missing = sorted((AUTHORITY_RENEWAL_ALLOWED_KEYS - optional_bindings - lineage_optional) - set(value))
    if missing:
        raise Blocker("browser_use_authority_renewal_fields_missing", ",".join(missing))
    authority = parse_authority(renewal_path, descriptor["run_id"], descriptor["session"], aliases=session_aliases(config, descriptor.get("requested_session", descriptor["session"]), descriptor["session"]))
    if value.get("previous_authority_sha256") != current_digest:
        raise Blocker("browser_use_authority_previous_digest_mismatch")
    try:
        generation = int(value["authority_generation"])
    except (TypeError, ValueError) as exc:
        raise Blocker("browser_use_authority_generation_invalid") from exc
    expected_generation = int(descriptor.get("authority_generation", 1)) + 1
    if generation != expected_generation:
        raise Blocker("browser_use_authority_generation_lineage_mismatch")
    issuer_id = value.get("issuer_id")
    if not isinstance(issuer_id, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}", issuer_id):
        raise Blocker("browser_use_authority_issuer_id_invalid")
    if authority["account_identity"] != current["account_identity"]:
        raise Blocker("browser_use_authority_renewal_account_mismatch")
    if sorted({normalize_origin(item) for item in authority["allowed_origins"]}) != sorted({normalize_origin(item) for item in current["allowed_origins"]}):
        raise Blocker("browser_use_authority_renewal_origins_mismatch")
    if authority_scope_digest(authority) != authority_scope_digest(current):
        raise Blocker("browser_use_authority_renewal_scope_mismatch")
    lineage_expires_at = _authority_lineage_expiry(current, descriptor)
    lineage_expires_at = dt.datetime.fromisoformat(iso(lineage_expires_at).replace("Z", "+00:00"))
    if authority.get("authority_lineage_expires_at") is None:
        authority["authority_lineage_expires_at"] = iso(lineage_expires_at)
    renewal_lineage = _authority_lineage_expiry(authority, descriptor)
    if renewal_lineage != lineage_expires_at:
        raise Blocker("browser_use_authority_renewal_lineage_mismatch")
    if _authority_expiry(authority) > lineage_expires_at:
        raise Blocker("browser_use_authority_renewal_expiry_unbounded")
    if _authority_expiry(authority) <= now_utc() + dt.timedelta(seconds=AUTHORITY_CLOCK_SKEW_SECONDS):
        raise Blocker("browser_use_authority_renewal_expiry_insufficient")
    descriptor.setdefault("authority_lineage_expires_at", iso(lineage_expires_at))
    return authority, sha256_file(renewal_path), generation, issuer_id


def renew_recording_authority(config: dict[str, Any], descriptor: dict[str, Any], current_path: str, renewal_path: str) -> dict[str, Any]:
    reconcile_authority_lineage_lock(descriptor)
    lock_path = authority_lineage_lock_path(descriptor)
    lock_token = f"authority-lineage-{os.getpid()}-{uuid.uuid4().hex}"
    lock_file(
        lock_path,
        {
            "schema": "browser-use-authority-lineage-lock.v1",
            "run_id": lock_token,
            "nonce": lock_token,
            "recording_run_id": descriptor.get("run_id"),
            "recording_nonce": descriptor.get("nonce"),
            "lock_pid": os.getpid(),
            "lock_start_time": psutil.Process(os.getpid()).create_time() if psutil is not None else 0.0,
        },
    )
    try:
        current_path = os.path.realpath(current_path)
        if descriptor.get("authority_current_path"):
            current_path = os.path.realpath(str(descriptor["authority_current_path"]))
        current = parse_authority(current_path, descriptor["run_id"], descriptor["session"], aliases=session_aliases(config, descriptor.get("requested_session", descriptor["session"]), descriptor["session"]), require_unexpired=False)
        current_digest = sha256_file(current_path)
        if current_digest != descriptor.get("authority_sha256"):
            raise Blocker("browser_use_recording_authority_changed")
        authority, digest, generation, issuer_id = _validate_renewal_contract(config, descriptor, current, current_digest, renewal_path)
        ledger = _authority_history_path(descriptor, "authority-generation-ledger.jsonl")
        rows = _read_jsonl_chain(ledger, AUTHORITY_LEDGER_SCHEMA, "browser_use_authority_ledger")
        descriptor_generation = int(descriptor.get("authority_generation", 1))
        if not rows:
            if descriptor_generation != 1:
                raise Blocker("browser_use_authority_generation_lineage_mismatch")
            append_authority_generation(
                descriptor,
                current,
                digest=current_digest,
                generation=descriptor_generation,
                previous_digest=None,
                issuer_id=str(descriptor.get("authority_issuer_id") or "initial"),
            )
            rows = _read_jsonl_chain(ledger, AUTHORITY_LEDGER_SCHEMA, "browser_use_authority_ledger")

        last_generation = int(rows[-1].get("authority_generation"))
        if last_generation == generation:
            if rows[-1].get("authority_sha256") != digest or rows[-1].get("previous_authority_sha256") != current_digest:
                raise Blocker("browser_use_authority_generation_lineage_mismatch")
            descriptor.update({
                "authority_sha256": digest,
                "authority_generation": generation,
                "authority_issuer_id": issuer_id,
                "authority_issued_at": authority.get("authority_issued_at") or descriptor.get("authority_issued_at"),
                "authority_lineage_expires_at": authority.get("authority_lineage_expires_at") or descriptor.get("authority_lineage_expires_at"),
                "authority_expires_at": authority["expires_at"],
                "authority_current_path": os.path.realpath(renewal_path),
            })
            return authority

        # A descriptor may have been durably advanced to the current
        # authority generation before the append-only ledger row was written
        # (for example, after a process interruption).  Repair exactly one
        # missing current-generation row from owner-bound evidence, then append
        # the requested renewal.  Never skip multiple generations or infer a
        # missing predecessor from an unrelated digest.
        if last_generation == descriptor_generation - 1:
            try:
                current_generation = int(current.get("authority_generation", descriptor_generation))
            except (TypeError, ValueError) as exc:
                raise Blocker("browser_use_authority_generation_invalid") from exc
            if current_generation != descriptor_generation:
                raise Blocker("browser_use_authority_generation_lineage_mismatch")
            if current.get("previous_authority_sha256") != rows[-1].get("authority_sha256"):
                raise Blocker("browser_use_authority_previous_digest_mismatch")
            append_authority_generation(
                descriptor,
                current,
                digest=current_digest,
                generation=descriptor_generation,
                previous_digest=rows[-1].get("authority_sha256"),
                issuer_id=str(descriptor.get("authority_issuer_id") or "initial"),
            )
            rows = _read_jsonl_chain(ledger, AUTHORITY_LEDGER_SCHEMA, "browser_use_authority_ledger")
        if not rows or int(rows[-1].get("authority_generation")) != descriptor_generation or rows[-1].get("authority_sha256") != current_digest:
            raise Blocker("browser_use_authority_generation_lineage_mismatch")
        if generation != descriptor_generation + 1:
            raise Blocker("browser_use_authority_generation_lineage_mismatch")
        append_authority_generation(descriptor, authority, digest=digest, generation=generation, previous_digest=current_digest, issuer_id=issuer_id)
        descriptor.update({
            "authority_sha256": digest,
            "authority_generation": generation,
            "authority_issuer_id": issuer_id,
            "authority_issued_at": authority.get("authority_issued_at") or descriptor.get("authority_issued_at"),
            "authority_lineage_expires_at": authority.get("authority_lineage_expires_at") or descriptor.get("authority_lineage_expires_at"),
            "authority_expires_at": authority["expires_at"],
            "authority_current_path": os.path.realpath(renewal_path),
        })
        return authority
    finally:
        release_lock(lock_path, lock_token, lock_token)


def admit_authority_budget(config: dict[str, Any], descriptor: dict[str, Any], authority: dict[str, Any], command_class: str, *, renewal_path: str | None = None) -> dict[str, Any]:
    if renewal_path:
        authority = renew_recording_authority(config, descriptor, str(descriptor.get("authority_current_path") or descriptor.get("authority_path") or ""), renewal_path)
    budget = remaining_authority_budget(authority, command_class)
    if not budget["sufficient"]:
        try:
            write_authority_renewal_checkpoint(descriptor, command_class=command_class, budget=budget)
        except Blocker:
            pass
        raise Blocker("browser_use_authority_renewal_required")
    return budget


def automatic_authority_renewal_path(config: dict[str, Any], descriptor: dict[str, Any], current_path: str, command_class: str, budget: dict[str, Any]) -> str:
    """Create one bounded append-only renewal when admission is short on time.

    This is intentionally limited to the existing descriptor lineage and to a
    single generation.  It copies only the already-authorized scope; it never
    broadens origins, identity, or side-effect scope, and it never overwrites
    an existing authority file.
    """
    recording_dir = os.path.realpath(str(descriptor.get("recording_dir") or ""))
    if not recording_dir or not os.path.isabs(recording_dir):
        raise Blocker("browser_use_authority_automatic_renewal_scope_invalid")
    current_path = os.path.realpath(current_path)
    current = parse_authority(
        current_path,
        descriptor["run_id"],
        descriptor["session"],
        aliases=session_aliases(config, descriptor.get("requested_session", descriptor["session"]), descriptor["session"]),
        require_unexpired=False,
    )
    try:
        generation = int(descriptor.get("authority_generation", 1)) + 1
    except (TypeError, ValueError) as exc:
        raise Blocker("browser_use_authority_generation_invalid") from exc
    path = os.path.join(recording_dir, f"authority-renewal-generation-{generation}.json")
    if os.path.lexists(path):
        assert_regular_file(path, mode=0o600)
        reusable = False
        try:
            existing = read_json_safe(path)
            reusable = (
                int(existing.get("authority_generation")) == generation
                and existing.get("previous_authority_sha256") == sha256_file(current_path)
                and _authority_expiry(existing) > now_utc() + dt.timedelta(seconds=int(budget.get("required_seconds", 0)) + AUTHORITY_CLOCK_SKEW_SECONDS)
            )
        except (Blocker, TypeError, ValueError):
            reusable = False
        if reusable:
            return path
        # Never overwrite an immutable renewal that is expired or bound to a
        # different predecessor.  Issue a bounded reissue beside it so a
        # stale artifact cannot block the current run indefinitely.
        path = os.path.join(recording_dir, f"authority-renewal-generation-{generation}-reissue-{uuid.uuid4().hex}.json")
    required_seconds = int(budget.get("required_seconds", 0))
    ttl_seconds = max(
        AUTHORITY_MIN_TTL_SECONDS,
        required_seconds + 60,
        AUTHORITY_AUTOMATIC_RENEWAL_HORIZON_SECONDS,
    )
    lineage_expires_at = _authority_lineage_expiry(current, descriptor)
    renewal_expires_at = min(
        now_utc() + dt.timedelta(seconds=ttl_seconds),
        lineage_expires_at,
    )
    if renewal_expires_at <= now_utc() + dt.timedelta(seconds=int(budget.get("required_seconds", 0)) + AUTHORITY_CLOCK_SKEW_SECONDS):
        raise Blocker("browser_use_authority_renewal_lineage_exhausted")
    descriptor.setdefault("authority_lineage_expires_at", iso(lineage_expires_at))
    authority = {
        "schema": AUTHORITY_RENEWAL_SCHEMA,
        "browser_surface": "browser_use_cli",
        "run_id": descriptor["run_id"],
        "session": descriptor["session"],
        "authority_issued_at": current.get("authority_issued_at"),
        "authority_lineage_expires_at": iso(lineage_expires_at),
        "expires_at": iso(renewal_expires_at),
        "allowed_origins": sorted({normalize_origin(item) for item in current["allowed_origins"]}),
        "account_identity": current["account_identity"],
        "data_exposure": current["data_exposure"],
        "side_effect_scope": current["side_effect_scope"],
        "approval": "approved",
        "readback_required": True,
        "previous_authority_sha256": sha256_file(current_path),
        "authority_generation": generation,
        "issuer_id": AUTHORITY_ISSUER_ID,
    }
    for key in ("automation_id", "stage_id", "mode", "not_before", "authority_id", "authority_schema", "authority_version"):
        if key in current:
            authority[key] = current[key]
    json_atomic_no_replace(path, authority)
    assert_regular_file(path, mode=0o600)
    return path


def normalize_origin(value: str) -> str:
    parsed = urllib.parse.urlparse(value)
    if parsed.scheme not in {"http", "https"} or parsed.username or parsed.password or not parsed.hostname or parsed.path not in {"", "/"} or parsed.query or parsed.fragment:
        raise Blocker("browser_use_allowed_origin_invalid")
    host = parsed.hostname.lower().rstrip(".")
    port = parsed.port
    if (parsed.scheme == "http" and port == 80) or (parsed.scheme == "https" and port == 443):
        port = None
    port_suffix = f":{port}" if port else ""
    return f"{parsed.scheme}://{host}{port_suffix}"


def is_forbidden_ip(host: str) -> bool:
    try:
        address = ipaddress.ip_address(host)
    except ValueError:
        return host.lower() in {"localhost", "localhost.localdomain", "metadata.google.internal", "instance-data.ec2.internal"} or host.lower().endswith(".local")
    return address.is_private or address.is_loopback or address.is_link_local or address.is_reserved or address.is_multicast or address.is_unspecified or address.is_loopback


def preflight_url(url: str, allowed_origins: list[str], unsafe_fragments: list[str]) -> str:
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in {"http", "https"} or parsed.username or parsed.password or not parsed.hostname:
        raise Blocker("browser_use_url_preflight_rejected")
    if any(fragment in parsed.path.lower() for fragment in unsafe_fragments):
        raise Blocker("browser_use_unsafe_url_path")
    host = parsed.hostname.lower().rstrip(".")
    if is_forbidden_ip(host):
        raise Blocker("browser_use_private_or_metadata_url")
    try:
        addresses = {item[4][0] for item in socket.getaddrinfo(host, parsed.port or (443 if parsed.scheme == "https" else 80), type=socket.SOCK_STREAM)}
    except OSError as exc:
        raise Blocker("browser_use_url_dns_preflight_failed", host) from exc
    if any(is_forbidden_ip(address) for address in addresses):
        raise Blocker("browser_use_private_or_metadata_url")
    origin_port_suffix = f":{parsed.port}" if parsed.port else ""
    origin = normalize_origin(f"{parsed.scheme}://{host}{origin_port_suffix}")
    if origin not in {normalize_origin(item) for item in allowed_origins}:
        raise Blocker("browser_use_origin_not_allowed", origin)
    return origin


def validate_upload(path: str, maximum: int) -> dict[str, Any]:
    if not os.path.isabs(path) or os.path.realpath(path) != path:
        raise Blocker("browser_use_upload_noncanonical_or_symlink")
    st = lstat(path)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode) or stat.S_ISFIFO(st.st_mode) or stat.S_ISCHR(st.st_mode) or stat.S_ISBLK(st.st_mode) or stat.S_ISDIR(st.st_mode):
        raise Blocker("browser_use_upload_file_type_rejected")
    if st.st_uid != EUID or st.st_size > maximum:
        raise Blocker("browser_use_upload_owner_or_size_rejected")
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except OSError as exc:
        raise Blocker("browser_use_upload_open_failed") from exc
    try:
        opened = os.fstat(fd)
        if opened.st_dev != st.st_dev or opened.st_ino != st.st_ino or opened.st_size != st.st_size or opened.st_mtime_ns != st.st_mtime_ns:
            raise Blocker("browser_use_upload_changed_after_validation")
        digest = hashlib.sha256()
        for chunk in iter(lambda: os.read(fd, 1024 * 1024), b""):
            digest.update(chunk)
    finally:
        os.close(fd)
    mime = mimetypes.guess_type(path)[0] or "application/octet-stream"
    classification = "image" if mime.startswith("image/") else "document" if mime.startswith(("text/", "application/pdf", "application/msword", "application/vnd.")) else "binary"
    return {"sha256": digest.hexdigest(), "size": st.st_size, "classification": classification, "destination": "authorized_browser_origin"}


def validate_command(command: list[str], mode: str, config: dict[str, Any], allowed_origins: list[str], download_dir: str) -> tuple[list[str], list[str], list[dict[str, Any]]]:
    if not command or command[0].startswith("-"):
        raise Blocker("browser_use_command_missing")
    name = command[0]
    allowed = set(config["commands"][mode])
    if name not in allowed:
        if mode == "public" and name in set(config["commands"]["authorized"]):
            raise Blocker("browser_use_public_requires_authorized_mode", "forms/submission/JS/upload/download require authorized mode")
        raise Blocker("browser_use_command_not_allowed", name)
    for arg in command[1:]:
        if arg in BLOCKED_GLOBAL_FLAGS or arg.startswith("--cdp-url=") or arg.startswith("--profile=") or arg.startswith("--session="):
            raise Blocker("browser_use_helper_owned_flag_rejected", arg.split("=", 1)[0])
    origins: list[str] = []
    # Only an explicit navigation command carries a destination URL.  Other
    # commands may legitimately contain URL-shaped user data (for example a
    # LinkedIn/GitHub profile field supplied to ``type``); treating those
    # values as navigation would incorrectly reject a safe form input because
    # its data origin is outside the current page authority.
    if name == "open":
        for arg in command[1:]:
            if arg.startswith(("http://", "https://")):
                origins.append(preflight_url(arg, allowed_origins, config["policy"]["unsafe_path_fragments"]))
    if name == "open" and not origins:
        raise Blocker("browser_use_open_url_required")
    uploads: list[dict[str, Any]] = []
    if name == "screenshot" and len(command) != 2:
        raise Blocker("browser_use_screenshot_path_required")
    if name == "viewport":
        if mode != "authorized":
            raise Blocker("browser_use_viewport_requires_authorized_mode")
        if len(command) != 3:
            raise Blocker("browser_use_viewport_dimensions_required")
        try:
            width, height = int(command[1]), int(command[2])
        except (TypeError, ValueError) as exc:
            raise Blocker("browser_use_viewport_dimensions_invalid") from exc
        if not (320 <= width <= 2400 and 320 <= height <= 1800):
            raise Blocker("browser_use_viewport_dimensions_out_of_range")
    if name == "upload":
        candidates = [arg for arg in command[1:] if not arg.startswith("-")]
        if not candidates:
            raise Blocker("browser_use_upload_path_required")
        uploads.append(validate_upload(candidates[-1], config["limits"]["max_upload_bytes"]))
    if mode == "public" and name in {"type", "input", "click", "select", "eval", "upload", "download", "python", "cookies"}:
        raise Blocker("browser_use_public_requires_authorized_mode")
    return command, sorted(set(origins)), uploads


def validate_capture_path(path: str, artifact_dir: str) -> str:
    """Validate a one-run capture path without allowing arbitrary overwrite."""
    if not isinstance(path, str) or not os.path.isabs(path) or os.path.realpath(path) != path:
        raise Blocker("browser_use_capture_path_noncanonical")
    if not isinstance(artifact_dir, str) or not os.path.isabs(artifact_dir) or os.path.realpath(artifact_dir) != artifact_dir:
        raise Blocker("browser_use_capture_artifact_dir_noncanonical")
    assert_directory(artifact_dir)
    relative = os.path.relpath(path, artifact_dir)
    if relative == os.pardir or relative.startswith(os.pardir + os.sep) or os.path.isabs(relative):
        raise Blocker("browser_use_capture_path_out_of_artifact_scope")
    parent = os.path.dirname(path)
    assert_directory(parent)
    if os.path.lexists(path):
        raise Blocker("browser_use_capture_path_already_exists")
    return path


def port_listener(port: int) -> bool:
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(0.2)
    try:
        result = sock.connect_ex(("127.0.0.1", port))
        if result == 0:
            return True
        if result == errno.ECONNREFUSED:
            return False
        raise Blocker("browser_use_listener_recheck_failed", str(result))
    except OSError as exc:
        raise Blocker("browser_use_listener_recheck_failed") from exc
    finally:
        sock.close()


def lsof_listener(port: int) -> bool:
    try:
        result = subprocess.run(["/usr/sbin/lsof", "-nP", "-a", f"-iTCP:{port}", "-sTCP:LISTEN", "-Fpct"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        raise Blocker("browser_use_listener_recheck_failed")
    if result.returncode not in {0, 1}:
        raise Blocker("browser_use_listener_recheck_failed")
    return result.returncode == 0 and bool(result.stdout.strip())


LEGACY_LOCK_AUDIT_SCHEMA = "browser-use-legacy-lock-audit.v1"
LEGACY_LOCK_CLASSES = {"active", "stale_confirmed", "ambiguous", "quarantined"}


def _legacy_lock_process_state(payload: dict[str, Any]) -> str:
    """Read-only process observation for one lock; never signals a process."""
    if psutil is None:
        return "ambiguous"
    process = payload.get("process") if isinstance(payload.get("process"), dict) else {}
    pid = process.get("root_pid") or process.get("pid") or payload.get("helper_pid")
    if not isinstance(pid, int) or pid <= 0:
        return "ambiguous"
    expected_start = process.get("root_start_time") or payload.get("helper_start_time")
    try:
        current = psutil.Process(pid)
        if isinstance(expected_start, (int, float)) and abs(float(current.create_time()) - float(expected_start)) > 30:
            return "absent"
        return "active"
    except psutil.NoSuchProcess:
        return "absent"
    except (psutil.AccessDenied, psutil.ZombieProcess, OSError):
        return "ambiguous"


def classify_legacy_lock(lock_path: str | os.PathLike[str], *, listener_probe: Any = None) -> dict[str, Any]:
    """Classify one legacy lock without changing it or touching its process."""
    path = os.path.realpath(os.fspath(lock_path))
    legacy_root = os.path.realpath(_LEGACY_STATE_ROOT)
    in_legacy_root = path == legacy_root or path.startswith(legacy_root + os.sep)
    if not in_legacy_root:
        raise Blocker("browser_use_legacy_lock_path_outside_root")
    try:
        file_stat = os.lstat(path)
    except FileNotFoundError:
        raise Blocker("browser_use_legacy_lock_missing") from None
    if stat.S_ISLNK(file_stat.st_mode) or not stat.S_ISREG(file_stat.st_mode):
        raise Blocker("browser_use_legacy_lock_unsafe_type")
    quarantined = f"{os.sep}quarantine{os.sep}" in path
    payload: dict[str, Any] = {}
    parse_state = "unreadable"
    try:
        with open(path, "r", encoding="utf-8") as handle:
            raw = json.load(handle)
        if isinstance(raw, dict):
            payload = raw
            parse_state = "parsed"
        else:
            parse_state = "invalid"
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        parse_state = "unreadable"
    process_state = _legacy_lock_process_state(payload) if payload else "ambiguous"
    port = payload.get("port") if isinstance(payload.get("port"), int) else None
    listener_state = "unknown"
    if port is not None:
        try:
            probe = listener_probe or port_listener
            listener_state = "active" if bool(probe(port)) else "absent"
        except (Blocker, OSError, ValueError):
            listener_state = "unknown"
    if quarantined:
        classification = "quarantined"
    elif process_state == "active" or listener_state == "active":
        classification = "active"
    elif process_state == "absent" and listener_state in {"absent", "unknown"} and parse_state == "parsed":
        classification = "stale_confirmed" if listener_state == "absent" else "ambiguous"
    else:
        classification = "ambiguous"
    return {
        "path": path,
        "classification": classification,
        "process_state": process_state,
        "listener_state": listener_state,
        "parse_state": parse_state,
        "port": port,
        "read_only": True,
        "process_action": "untouched",
        "lock_action": "untouched",
    }


def audit_legacy_locks(root: str | os.PathLike[str] | None = None, *, include_quarantine: bool = True, listener_probe: Any = None) -> dict[str, Any]:
    """Return a bounded, read-only audit of legacy ``*.lock`` files."""
    selected_root = os.path.realpath(os.fspath(root or _LEGACY_STATE_ROOT))
    if selected_root != os.path.realpath(_LEGACY_STATE_ROOT):
        raise Blocker("browser_use_legacy_lock_audit_root_invalid")
    locks_root = os.path.join(selected_root, "locks")
    paths: list[str] = []
    if os.path.isdir(locks_root):
        paths.extend(
            os.path.join(directory, name)
            for directory, _dirs, names in os.walk(locks_root, followlinks=False)
            for name in names
            if name.endswith(".lock")
        )
    if include_quarantine and os.path.isdir(os.path.join(selected_root, "quarantine")):
        paths.extend(
            os.path.join(directory, name)
            for directory, _dirs, names in os.walk(os.path.join(selected_root, "quarantine"), followlinks=False)
            for name in names
            if name.endswith(".lock")
        )
    records = [classify_legacy_lock(path, listener_probe=listener_probe) for path in sorted(paths)]
    counts = {name: sum(record["classification"] == name for record in records) for name in sorted(LEGACY_LOCK_CLASSES)}
    return {
        "schema": LEGACY_LOCK_AUDIT_SCHEMA,
        "legacy_root": selected_root,
        "primary_root": os.path.realpath(_PORTABLE_STATE_ROOT),
        "records": records,
        "counts": counts,
        "total": len(records),
        "read_only": True,
        "deleted": [],
        "moved": [],
        "processes_killed": [],
    }


def assert_debug_listener_absent(port: int) -> None:
    """Require two independent local listener checks to report absence."""
    socket_listener = port_listener(port)
    lsof_listener_present = lsof_listener(port)
    if socket_listener or lsof_listener_present:
        raise Blocker("browser_use_listener_remains_after_cleanup")


def lock_file(path: str, payload: dict[str, Any]) -> None:
    parent = os.path.dirname(path)
    assert_directory(parent, create=True)
    try:
        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0), 0o600)
    except FileExistsError as exc:
        raise Blocker("browser_use_lock_already_held", path) from exc
    try:
        os.write(fd, (json.dumps(payload, sort_keys=True) + "\n").encode())
        os.fsync(fd)
    finally:
        os.close(fd)


def release_lock(path: str, run_id: str, nonce: str) -> bool:
    if not os.path.lexists(path):
        # A completed cleanup may be retried after the lock was already
        # released.  Missing is idempotent; malformed or foreign is not.
        return True
    try:
        value = read_json_safe(path)
    except (Blocker, json.JSONDecodeError) as exc:
        raise Blocker("browser_use_lock_release_recheck_failed", path) from exc
    if value.get("run_id") != run_id or value.get("nonce") != nonce:
        raise Blocker("browser_use_lock_owner_recheck_failed", path)
    try:
        os.unlink(path)
    except OSError as exc:
        raise Blocker("browser_use_lock_release_failed", path) from exc
    if os.path.lexists(path):
        raise Blocker("browser_use_lock_cleanup_readback_failed", path)
    return True


ROOM_REGISTRY_SCHEMA = "browser-use-room-registry.v1"
ROOM_REGISTRY_FILENAME = "room-registry.json"
ROOM_REGISTRY_LOCK_FILENAME = "room-registry.lock"
ROOM_REGISTRY_LIFECYCLES = {"temporary", "single-use", "scheduled"}
ROOM_REGISTRY_STATES = {"active", "starting", "held", "released", "rollback", "stale"}
ROOM_REGISTRY_ACTIVE_STATES = {"active", "starting", "held"}
ROOM_REGISTRY_ACTIVITY_RE = re.compile(r"^[a-z][a-z0-9_.:-]{0,47}$")


def room_registry_paths(config: dict[str, Any], *, create: bool = True) -> tuple[str, str]:
    """Return the helper-owned ledger and its short-lived exclusive lock."""
    state_root = (config.get("roots") or {}).get("browser_use_home")
    if not isinstance(state_root, str) or not os.path.isabs(state_root) or os.path.realpath(state_root) != state_root:
        raise Blocker("browser_use_room_registry_state_root_invalid")
    if create:
        assert_directory(state_root, create=True)
    return os.path.join(state_root, ROOM_REGISTRY_FILENAME), os.path.join(state_root, ROOM_REGISTRY_LOCK_FILENAME)


def _empty_room_registry() -> dict[str, Any]:
    timestamp = iso(now_utc())
    return {"schema": ROOM_REGISTRY_SCHEMA, "version": 1, "rooms": [], "created_at": timestamp, "updated_at": timestamp}


def _validate_room_registry(value: dict[str, Any]) -> dict[str, Any]:
    if value.get("schema") != ROOM_REGISTRY_SCHEMA or value.get("version") != 1 or not isinstance(value.get("rooms"), list):
        raise Blocker("browser_use_room_registry_schema_invalid")
    for room in value["rooms"]:
        if not isinstance(room, dict) or not isinstance(room.get("room_id"), str) or room.get("lifecycle") not in ROOM_REGISTRY_LIFECYCLES:
            raise Blocker("browser_use_room_registry_entry_invalid")
        if room.get("state") not in ROOM_REGISTRY_STATES:
            raise Blocker("browser_use_room_registry_state_invalid")
        if not isinstance(room.get("profile"), str) or not isinstance(room.get("port"), int):
            raise Blocker("browser_use_room_registry_resource_invalid")
        if not isinstance(room.get("activity"), list) or not all(isinstance(item, dict) for item in room["activity"]):
            raise Blocker("browser_use_room_registry_activity_invalid")
    return value


def room_registry_read(config: dict[str, Any], *, create: bool = True) -> dict[str, Any]:
    ledger_path, _ = room_registry_paths(config, create=create)
    if not os.path.lexists(ledger_path):
        return _empty_room_registry()
    return _validate_room_registry(read_json_safe(ledger_path))


def _room_registry_transaction(config: dict[str, Any], mutator: Any) -> Any:
    """Run one bounded read/modify/write under an exclusive 0600 lock."""
    ledger_path, lock_path = room_registry_paths(config)
    token = f"registry-{os.getpid()}-{uuid.uuid4().hex}"
    payload = {"schema": "browser-use-room-registry-lock.v1", "owner_pid": os.getpid(), "owner_token": token, "acquired_at": iso(now_utc())}
    try:
        lock_file(lock_path, {"run_id": token, "nonce": token, **payload})
    except Blocker as exc:
        if exc.code == "browser_use_lock_already_held":
            raise Blocker("browser_use_room_registry_lock_conflict") from exc
        raise
    try:
        current = room_registry_read(config, create=True)
        updated, result = mutator(current)
        _validate_room_registry(updated)
        json_atomic_replace(ledger_path, updated)
        return result
    finally:
        release_lock(lock_path, token, token)


def _room_registry_owner(lifecycle: str, task_id: str | None, automation_id: str | None, run_id: str) -> tuple[str, str]:
    if lifecycle == TEMPORARY_LIFECYCLE:
        return "task", safe_id(task_id or "", "task_id")
    if lifecycle == "scheduled":
        return "automation", safe_id(automation_id or "", "automation_id")
    return "task", safe_id(task_id or run_id, "task_id")


def _room_registry_room_id(lifecycle: str, owner_type: str, owner_id: str) -> str:
    if lifecycle == "single-use":
        return f"room-{uuid.uuid4().hex}"
    digest = hashlib.sha256(f"{lifecycle}\0{owner_type}\0{owner_id}".encode()).hexdigest()[:32]
    return f"room-{digest}"


def _room_registry_profile_roots(config: dict[str, Any]) -> list[str]:
    roots = config.get("roots") or {}
    return [os.path.realpath(str(roots[name])) for name in ("scheduled_profiles", "single_use_profiles", "temporary_profiles") if isinstance(roots.get(name), str)]


def _room_registry_profile(config: dict[str, Any], lifecycle: str, room_id: str, profile: str | None, automation_id: str | None) -> str:
    if profile is None:
        if lifecycle == "scheduled":
            profile = os.path.join(config["roots"]["scheduled_profiles"], safe_id(automation_id or "", "automation_id"))
        else:
            root_name = "temporary_profiles" if lifecycle == TEMPORARY_LIFECYCLE else "single_use_profiles"
            profile = os.path.join(config["roots"][root_name], room_id)
    if not isinstance(profile, str) or not os.path.isabs(profile) or os.path.realpath(profile) != profile:
        raise Blocker("browser_use_room_registry_profile_invalid")
    if not any(profile == root or profile.startswith(root + os.sep) for root in _room_registry_profile_roots(config)):
        raise Blocker("browser_use_room_registry_profile_scope_mismatch")
    return profile


def _room_registry_port_range(config: dict[str, Any], lifecycle: str) -> tuple[int, int]:
    ports = config.get("ports") or {}
    if lifecycle == "scheduled":
        return int(ports["scheduled_start"]), int(ports["scheduled_end"])
    if lifecycle == "single-use":
        return int(ports["single_use_start"]), int(ports["single_use_end"])
    return int(ports["temporary_start"]), int(ports["temporary_end"])


def _room_registry_active_ports(registry: dict[str, Any]) -> set[int]:
    return {int(room["port"]) for room in registry["rooms"] if room.get("state") in ROOM_REGISTRY_ACTIVE_STATES}


def _room_registry_activity(value: Any) -> str:
    """Persist only a short event kind, never caller text, URL, or command."""
    first = str(value or "").split(maxsplit=1)[0].lower()
    return first if ROOM_REGISTRY_ACTIVITY_RE.fullmatch(first) else "activity"


def _room_registry_public(room: dict[str, Any]) -> dict[str, Any]:
    result = {key: room.get(key) for key in ("room_id", "lifecycle", "owner", "task_id", "automation_id", "profile", "port", "state", "created_at", "updated_at", "last_activity_at", "current_activity", "activity", "helper_sha256", "helper_generation_projection") if key in room}
    return result


def room_registry_sync_admission(
    rooms: list[dict[str, Any]],
    *,
    source_helper_sha256: str,
    installed_helper_sha256: str,
) -> dict[str, Any]:
    """Decide whether a shared-helper sync can cross the current room boundary.

    Replacing the installed entrypoint is safe while an active room is using
    the same source generation.  Legacy or older-generation rooms remain a
    hard stop because a later command could otherwise execute a different
    helper generation inside that run.
    """
    for field, value in (("source_helper_sha256", source_helper_sha256), ("installed_helper_sha256", installed_helper_sha256)):
        if not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{64}", value):
            raise Blocker("browser_use_sync_helper_digest_invalid", field)
    active_states = ROOM_REGISTRY_ACTIVE_STATES | {"cleanup_pending"}
    active = [room for room in rooms if isinstance(room, dict) and room.get("state") in active_states]
    base = {
        "source_helper_sha256": source_helper_sha256,
        "installed_helper_sha256": installed_helper_sha256,
        "active_room_count": len(active),
        "active_rooms": [
            {
                key: room.get(key)
                for key in ("room_id", "owner", "task_id", "automation_id", "port", "state", "current_activity", "helper_sha256")
                if key in room
            }
            for room in active
        ],
    }
    if source_helper_sha256 == installed_helper_sha256:
        return {**base, "ready": True, "reason": "parity_already_true"}
    blockers: list[dict[str, Any]] = []
    for room in active:
        helper_sha256 = room.get("helper_sha256")
        if not isinstance(helper_sha256, str):
            code = "browser_use_cli_live_room_helper_identity_missing"
        elif helper_sha256 != source_helper_sha256:
            code = "browser_use_cli_live_room_helper_generation_conflict"
        else:
            continue
        blockers.append({
            "exact_blocker": code,
            "room_id": room.get("room_id"),
            "owner": room.get("owner"),
            "task_id": room.get("task_id"),
            "automation_id": room.get("automation_id"),
            "port": room.get("port"),
            "state": room.get("state"),
            "current_activity": room.get("current_activity"),
            "helper_sha256": helper_sha256,
        })
    if blockers:
        return {
            **base,
            "ready": False,
            "exact_blocker": "browser_use_cli_live_rooms_active",
            "blocking_rooms": blockers,
            "next_action": "owner_bound_cleanup_or_same_generation_readback",
            "restart_point": "fresh_readback_after_blocking_rooms_release_or_match_source_generation",
        }
    return {**base, "ready": True, "reason": "all_active_rooms_source_generation_bound"}


def _helper_generation_handoff_root(config: dict[str, Any]) -> str:
    root = os.path.join(config["roots"]["browser_use_home"], "helper-generation-handoffs")
    assert_directory(root, create=True)
    return root


def _helper_generation_handoff_binding(descriptor: dict[str, Any], helper_sha256: str) -> str:
    process = descriptor.get("process") if isinstance(descriptor.get("process"), dict) else {}
    payload = {
        "run_id": descriptor.get("run_id"),
        "session": descriptor.get("session"),
        "task_id": descriptor.get("task_id"),
        "room_id": descriptor.get("room_id"),
        "profile": descriptor.get("profile"),
        "port": descriptor.get("port"),
        "process": {"root_pid": process.get("root_pid"), "root_start_time": process.get("root_start_time")},
        "helper_sha256": helper_sha256,
    }
    return hashlib.sha256(json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()


def room_registry_adopt_helper_generation(
    config: dict[str, Any],
    room_id: str,
    *,
    run_id: str,
    previous_helper_sha256: str,
    helper_sha256: str,
    handoff_id: str,
) -> dict[str, Any]:
    """Atomically rebind one live owner room to a verified helper generation."""
    run_id = safe_id(run_id, "run_id")
    if not isinstance(room_id, str) or not room_id.startswith("room-"):
        raise Blocker("browser_use_room_registry_room_id_invalid")
    for field, value in (("previous_helper_sha256", previous_helper_sha256), ("helper_sha256", helper_sha256)):
        if not isinstance(value, str) or not re.fullmatch(r"[0-9a-f]{64}", value):
            raise Blocker("browser_use_helper_generation_handoff_digest_invalid", field)
    handoff_id = safe_id(handoff_id, "handoff_id")
    lease_digest = hashlib.sha256(run_id.encode("utf-8")).hexdigest()

    def mutate(registry: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any]]:
        room = next((item for item in registry["rooms"] if item.get("room_id") == room_id), None)
        if room is None:
            raise Blocker("browser_use_room_registry_room_missing")
        if room.get("lease_digest") != lease_digest:
            raise Blocker("browser_use_room_registry_owner_conflict")
        if room.get("state") not in ROOM_REGISTRY_ACTIVE_STATES:
            raise Blocker("browser_use_helper_generation_handoff_room_not_live")
        current = room.get("helper_sha256")
        if current not in {previous_helper_sha256, helper_sha256}:
            raise Blocker("browser_use_helper_generation_handoff_generation_mismatch")
        now = iso(now_utc())
        room["helper_sha256"] = helper_sha256
        room["helper_generation_handoff_id"] = handoff_id
        room["helper_generation_previous_sha256"] = previous_helper_sha256
        room["updated_at"] = now
        room["last_activity_at"] = now
        room["current_activity"] = "helper-generation-handoff"
        room["activity"] = (room.get("activity") or [])[-7:] + [{"at": now, "kind": "helper-generation-handoff"}]
        registry["updated_at"] = now
        return registry, _room_registry_public(room)

    return _room_registry_transaction(config, mutate)


def _helper_generation_handoff_live_binding(
    config: dict[str, Any],
    *,
    source_helper_sha256: str,
    installed_helper_sha256: str,
) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:
    admission = room_registry_sync_admission(
        room_registry_list(config),
        source_helper_sha256=source_helper_sha256,
        installed_helper_sha256=installed_helper_sha256,
    )
    if admission.get("ready") is True:
        raise Blocker("browser_use_helper_generation_handoff_not_required")
    blockers = admission.get("blocking_rooms") or []
    if len(blockers) != 1:
        raise Blocker("browser_use_helper_generation_handoff_ambiguous")
    blocker = blockers[0]
    room_id = blocker.get("room_id")
    observations = [item for item in room_registry_observations(config) if item.get("room_id") == room_id]
    if len(observations) != 1:
        raise Blocker("browser_use_helper_generation_handoff_observation_missing")
    observation = observations[0]
    if any(observation.get(key) is not True for key in ("listener_observed", "process_observed", "daemon_observed")):
        raise Blocker("browser_use_helper_generation_handoff_runtime_readback_failed")
    room = next((item for item in room_registry_list(config) if item.get("room_id") == room_id), None)
    if room is None:
        raise Blocker("browser_use_helper_generation_handoff_room_missing")
    descriptor_path = observation.get("descriptor")
    run_id = observation.get("run_id")
    session = observation.get("session")
    task_id = room.get("task_id")
    if not all(isinstance(value, str) and value for value in (descriptor_path, run_id, session, task_id)):
        raise Blocker("browser_use_helper_generation_handoff_owner_metadata_missing")
    descriptor = read_recording_descriptor(
        config,
        descriptor_path,
        run_id,
        canonical_session_id(session, config["roots"]["browser_use_home"]),
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
    )
    if (
        descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE
        or descriptor.get("owned_chrome") is not True
        or descriptor.get("status") not in {"active", "continued"}
        or descriptor.get("run_id") != run_id
        or descriptor.get("session") != session
        or descriptor.get("task_id") != task_id
        or descriptor.get("room_id") != room_id
        or descriptor.get("profile") != room.get("profile")
        or int(descriptor.get("port", -1)) != int(room.get("port", -2))
        or descriptor.get("helper_sha256") != installed_helper_sha256
    ):
        raise Blocker("browser_use_helper_generation_handoff_binding_mismatch")
    recording_status = read_recording_status(descriptor["status_path"], require_active=True)
    if recording_status.get("recorder_active") is not True:
        raise Blocker("browser_use_helper_generation_handoff_recording_inactive")
    recording_dir = descriptor.get("recording_dir")
    if isinstance(recording_dir, str) and os.path.isdir(recording_dir):
        command_lease = os.path.join(os.path.realpath(recording_dir), ".recording-command.lock")
        if os.path.lexists(command_lease):
            raise Blocker("browser_use_recording_command_in_progress", command_lease)
    validate_recording_process(config, descriptor)
    return room, descriptor, {
        "descriptor": os.path.realpath(descriptor_path),
        "recording_status": {
            "recorder_active": True,
            "state": recording_status.get("state") or recording_status.get("durable_state"),
        },
        "observation": {
            key: observation.get(key)
            for key in ("room_id", "run_id", "session", "port", "profile", "process_start_time")
        },
    }


def helper_generation_handoff_command(config: dict[str, Any], args: argparse.Namespace) -> int:
    source_helper_sha256 = getattr(args, "source_helper_sha256", None)
    installed_helper_sha256 = getattr(args, "installed_helper_sha256", None)
    phase = args.phase
    if phase == "prepare":
        if not isinstance(source_helper_sha256, str) or not isinstance(installed_helper_sha256, str):
            raise Blocker("browser_use_helper_generation_handoff_digest_missing")
        room, descriptor, readback = _helper_generation_handoff_live_binding(
            config,
            source_helper_sha256=source_helper_sha256,
            installed_helper_sha256=installed_helper_sha256,
        )
        handoff_id = uuid.uuid4().hex
        payload = {
            "schema": HELPER_GENERATION_HANDOFF_SCHEMA,
            "state": "prepared",
            "handoff_id": handoff_id,
            "source_helper_sha256": source_helper_sha256,
            "installed_helper_sha256": installed_helper_sha256,
            "run_id": descriptor["run_id"],
            "session": descriptor["session"],
            "task_id": descriptor["task_id"],
            "room_id": descriptor["room_id"],
            "descriptor": readback["descriptor"],
            "profile": room["profile"],
            "port": room["port"],
            "binding_sha256": _helper_generation_handoff_binding(descriptor, installed_helper_sha256),
            "readback": readback,
            "prepared_at": iso(now_utc()),
        }
        handoff_path = os.path.join(_helper_generation_handoff_root(config), f"{handoff_id}.json")
        json_atomic_no_replace(handoff_path, payload)
        print(json.dumps({"status": "helper_generation_handoff_prepared", "handoff": handoff_path, "handoff_id": handoff_id, "room_id": room["room_id"], "run_id": descriptor["run_id"], "session": descriptor["session"], "previous_helper_sha256": installed_helper_sha256, "next_helper_sha256": source_helper_sha256, "readback": readback}, sort_keys=True))
        return 0
    handoff_path = os.path.realpath(str(getattr(args, "handoff", "")))
    root = os.path.realpath(_helper_generation_handoff_root(config))
    if not handoff_path.startswith(root + os.sep):
        raise Blocker("browser_use_helper_generation_handoff_path_invalid")
    token = read_json_safe(handoff_path)
    if token.get("schema") != HELPER_GENERATION_HANDOFF_SCHEMA or token.get("state") not in {"prepared", "committed"}:
        raise Blocker("browser_use_helper_generation_handoff_token_invalid")
    current_helper_sha256 = sha256_trusted_helper(canonical_helper_path())
    if token.get("source_helper_sha256") != current_helper_sha256:
        raise Blocker("browser_use_helper_generation_handoff_current_helper_mismatch")
    if source_helper_sha256 is not None and source_helper_sha256 != current_helper_sha256:
        raise Blocker("browser_use_helper_generation_handoff_source_digest_mismatch")
    if installed_helper_sha256 is not None and token.get("installed_helper_sha256") != installed_helper_sha256:
        raise Blocker("browser_use_helper_generation_handoff_previous_digest_mismatch")
    room, descriptor, readback = _helper_generation_handoff_live_binding(
        config,
        source_helper_sha256=current_helper_sha256,
        installed_helper_sha256=str(token["installed_helper_sha256"]),
    )
    if descriptor["run_id"] != token.get("run_id") or descriptor["session"] != token.get("session") or descriptor["task_id"] != token.get("task_id") or descriptor["room_id"] != token.get("room_id"):
        raise Blocker("browser_use_helper_generation_handoff_token_binding_mismatch")
    if _helper_generation_handoff_binding(descriptor, str(token["installed_helper_sha256"])) != token.get("binding_sha256"):
        raise Blocker("browser_use_helper_generation_handoff_binding_digest_mismatch")
    descriptor_path = os.path.realpath(str(token["descriptor"]))
    previous_descriptor_helper_sha256 = str(descriptor.get("helper_sha256") or "")
    descriptor = refresh_recording_helper_generation(config, descriptor, descriptor_path)
    if (
        descriptor.get("run_id") != token.get("run_id")
        or descriptor.get("session") != token.get("session")
        or descriptor.get("task_id") != token.get("task_id")
        or descriptor.get("room_id") != token.get("room_id")
        or descriptor.get("helper_sha256") != current_helper_sha256
    ):
        raise Blocker("browser_use_helper_generation_handoff_descriptor_adoption_mismatch")
    adopted = room_registry_adopt_helper_generation(
        config,
        room["room_id"],
        run_id=descriptor["run_id"],
        previous_helper_sha256=str(token["installed_helper_sha256"]),
        helper_sha256=current_helper_sha256,
        handoff_id=str(token["handoff_id"]),
    )
    token.update({
        "state": "committed",
        "committed_at": iso(now_utc()),
        "room": adopted,
        "readback_after_commit": readback,
        "descriptor_generation_adoption": {
            "previous_helper_sha256": previous_descriptor_helper_sha256,
            "helper_sha256": descriptor["helper_sha256"],
            "helper_snapshot_path": descriptor.get("helper_snapshot_path"),
            "helper_generation": descriptor.get("helper_generation"),
        },
    })
    json_atomic_replace(handoff_path, token)
    print(json.dumps({"status": "helper_generation_handoff_committed", "handoff": handoff_path, "handoff_id": token["handoff_id"], "room": adopted, "run_id": descriptor["run_id"], "session": descriptor["session"], "helper_sha256": current_helper_sha256, "readback": readback}, sort_keys=True))
    return 0


def _room_registry_owner_reuse_absence_readback(config: dict[str, Any], room: dict[str, Any]) -> None:
    """Prove an owner-bound held room is reusable without touching resources."""
    profile = os.path.realpath(str(room.get("profile") or ""))
    try:
        port = int(room.get("port"))
    except (TypeError, ValueError) as exc:
        raise Blocker("browser_use_room_owner_reuse_readback_failed") from exc
    if not profile or not os.path.isabs(profile) or os.path.realpath(profile) != profile:
        raise Blocker("browser_use_room_owner_reuse_readback_failed")
    port_arg = f"--remote-debugging-port={port}"
    profile_arg = f"--user-data-dir={profile}"
    previous: tuple[bool, bool, bool] | None = None
    for attempt in range(2):
        try:
            listener = bool(port_listener(port) or lsof_listener(port))
            process_live = False
            if psutil is not None:
                for process in psutil.process_iter(["cmdline"]):
                    try:
                        command_line = process.info.get("cmdline") or []
                        if not isinstance(command_line, list):
                            raise Blocker("browser_use_room_owner_reuse_readback_failed")
                        tokens = {str(item) for item in command_line}
                        if port_arg in tokens or profile_arg in tokens:
                            process_live = True
                            break
                    except (psutil.Error, OSError) as exc:
                        raise Blocker("browser_use_room_owner_reuse_readback_failed") from exc
            else:
                try:
                    result = subprocess.run(["/bin/ps", "-axo", "command="], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5)
                except (OSError, subprocess.SubprocessError) as exc:
                    raise Blocker("browser_use_room_owner_reuse_readback_failed") from exc
                if result.returncode != 0:
                    raise Blocker("browser_use_room_owner_reuse_readback_failed")
                process_live = any(port_arg in line or profile_arg in line for line in result.stdout.splitlines())
            daemon_live = False
            for marker in pathlib.Path("/tmp").glob("codex-browser-use-*/runtime/bu.port"):
                try:
                    if marker.is_symlink() or not marker.is_file():
                        raise Blocker("browser_use_room_owner_reuse_readback_failed")
                    if marker.read_text(encoding="utf-8").strip() == str(port):
                        daemon_live = True
                        break
                except (OSError, UnicodeError) as exc:
                    raise Blocker("browser_use_room_owner_reuse_readback_failed") from exc
        except Blocker:
            raise
        except (OSError, ValueError, TypeError) as exc:
            raise Blocker("browser_use_room_owner_reuse_readback_failed") from exc
        observation = (listener, process_live, daemon_live)
        if listener:
            raise Blocker("browser_use_room_owner_reuse_listener_live")
        if process_live:
            raise Blocker("browser_use_room_owner_reuse_process_live")
        if daemon_live:
            raise Blocker("browser_use_room_owner_reuse_daemon_live")
        if previous is not None and observation != previous:
            raise Blocker("browser_use_room_owner_reuse_readback_changed")
        previous = observation
        if attempt == 0:
            time.sleep(0.05)


def room_registry_claim(
    config: dict[str, Any],
    *,
    lifecycle: str,
    run_id: str,
    profile: str | None = None,
    port: int | None = None,
    task_id: str | None = None,
    automation_id: str | None = None,
    activity: str = "claim",
) -> dict[str, Any]:
    """Claim or reuse one room without replacing resource/authority locks."""
    if lifecycle not in ROOM_REGISTRY_LIFECYCLES:
        raise Blocker("browser_use_room_registry_lifecycle_invalid")
    run_id = safe_id(run_id, "run_id")
    owner_type, owner_id = _room_registry_owner(lifecycle, task_id, automation_id, run_id)
    if lifecycle == "scheduled" and owner_id == "manual":
        raise Blocker("browser_use_scheduled_automation_id_required")
    deterministic_id = _room_registry_room_id(lifecycle, owner_type, owner_id)
    lease_digest = hashlib.sha256(run_id.encode("utf-8")).hexdigest()
    helper_sha256 = sha256_trusted_helper(os.path.realpath(__file__))

    def mutate(registry: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any]]:
        now = iso(now_utc())
        existing = next((room for room in registry["rooms"] if room.get("room_id") == deterministic_id), None)
        if existing is not None and lifecycle != "single-use" and port is not None and int(port) != int(existing.get("port", -1)):
            raise Blocker("browser_use_room_allocation_mismatch", owner_id)
        same_owner = bool(existing is not None and existing.get("owner") == {"kind": owner_type, "id": owner_id})
        owner_reuse = False
        if existing is not None and lifecycle == "scheduled" and existing.get("state") in ROOM_REGISTRY_ACTIVE_STATES and existing.get("lease_digest") != lease_digest:
            if same_owner and existing.get("state") == "held":
                _room_registry_owner_reuse_absence_readback(config, existing)
                owner_reuse = True
            else:
                raise Blocker("browser_use_room_scheduled_duplicate", owner_id)
        if existing is not None and lifecycle == TEMPORARY_LIFECYCLE and existing.get("state") in ROOM_REGISTRY_ACTIVE_STATES and existing.get("lease_digest") != lease_digest:
            if same_owner and existing.get("state") == "held":
                _room_registry_owner_reuse_absence_readback(config, existing)
                owner_reuse = True
            else:
                raise Blocker("browser_use_room_temporary_duplicate", owner_id)
        if existing is not None and lifecycle != "single-use" and existing.get("state") in ROOM_REGISTRY_ACTIVE_STATES and existing.get("lease_digest") == lease_digest:
            existing["updated_at"] = now
            existing["last_activity_at"] = now
            event = _room_registry_activity(activity)
            existing["current_activity"] = event
            existing["activity"].append({"at": now, "kind": event})
            existing["activity"] = existing["activity"][-8:]
            registry["updated_at"] = now
            return registry, _room_registry_public(existing)
        if existing is not None and lifecycle == "scheduled" and existing.get("state") == "released":
            if port is not None and int(port) != int(existing["port"]):
                raise Blocker("browser_use_room_scheduled_allocation_mismatch")
            if profile is not None and os.path.realpath(profile) != existing["profile"]:
                raise Blocker("browser_use_room_scheduled_allocation_mismatch")
        room_id = deterministic_id if lifecycle != "single-use" else _room_registry_room_id(lifecycle, owner_type, owner_id)
        if existing is not None and lifecycle != "single-use":
            room_id = existing["room_id"]
        selected_port = int(port) if port is not None else None
        start, end = _room_registry_port_range(config, lifecycle)
        active_ports = _room_registry_active_ports(registry)
        if selected_port is None and existing is not None:
            selected_port = int(existing["port"])
        if selected_port is None:
            offset = int(hashlib.sha256(owner_id.encode("utf-8")).hexdigest(), 16) % (end - start + 1)
            for index in range(end - start + 1):
                candidate = start + ((offset + index) % (end - start + 1))
                if candidate not in active_ports and not port_listener(candidate) and not lsof_listener(candidate):
                    selected_port = candidate
                    break
        if selected_port is None or not start <= selected_port <= end:
            raise Blocker("browser_use_room_registry_no_free_room", lifecycle)
        if selected_port in active_ports and (existing is None or int(existing.get("port", -1)) != selected_port):
            raise Blocker("browser_use_room_registry_port_conflict", str(selected_port))
        if (existing is None or existing.get("state") not in ROOM_REGISTRY_ACTIVE_STATES) and (port_listener(selected_port) or lsof_listener(selected_port)):
            raise Blocker("browser_use_room_registry_listener_conflict", str(selected_port))
        selected_profile = _room_registry_profile(config, lifecycle, room_id, profile if profile is not None else (existing.get("profile") if existing else None), automation_id)
        if existing is not None and lifecycle == "scheduled" and selected_profile != existing["profile"]:
            raise Blocker("browser_use_room_scheduled_allocation_mismatch")
        event = _room_registry_activity(activity)
        room = {
            "room_id": room_id,
            "lifecycle": lifecycle,
            "owner": {"kind": owner_type, "id": owner_id},
            "task_id": owner_id if owner_type == "task" else None,
            "automation_id": owner_id if owner_type == "automation" else None,
            "profile": selected_profile,
            "port": selected_port,
            "state": "active",
            "created_at": existing.get("created_at", now) if existing else now,
            "updated_at": now,
            "last_activity_at": now,
            "current_activity": event if not owner_reuse else "owner-reuse",
            "activity": (existing.get("activity", []) if existing else [])[-7:] + [{"at": now, "kind": event}],
            "lease_digest": lease_digest,
            "helper_sha256": helper_sha256,
        }
        if existing is not None:
            index = registry["rooms"].index(existing)
            registry["rooms"][index] = room
        else:
            registry["rooms"].append(room)
        registry["updated_at"] = now
        return registry, _room_registry_public(room)

    return _room_registry_transaction(config, mutate)


def room_registry_update(config: dict[str, Any], room_id: str, *, run_id: str, state: str = "active", activity: str = "update") -> dict[str, Any]:
    if not isinstance(room_id, str) or not room_id.startswith("room-"):
        raise Blocker("browser_use_room_registry_room_id_invalid")
    if state not in ROOM_REGISTRY_STATES:
        raise Blocker("browser_use_room_registry_state_invalid")
    lease_digest = hashlib.sha256(safe_id(run_id, "run_id").encode("utf-8")).hexdigest()

    def mutate(registry: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any]]:
        room = next((item for item in registry["rooms"] if item.get("room_id") == room_id), None)
        if room is None:
            raise Blocker("browser_use_room_registry_room_missing")
        if room.get("lease_digest") != lease_digest and not (room.get("state") == "released" and state == "released"):
            raise Blocker("browser_use_room_registry_owner_conflict")
        now = iso(now_utc())
        room["state"] = state
        room["updated_at"] = now
        room["last_activity_at"] = now
        event = _room_registry_activity(activity)
        # Keep the last useful operation visible while a temporary or
        # scheduled room is merely held between browser commands.
        if not (state == "held" and event == "held"):
            room["current_activity"] = event
        room["activity"] = (room.get("activity") or [])[-7:] + [{"at": now, "kind": event}]
        registry["updated_at"] = now
        return registry, _room_registry_public(room)

    return _room_registry_transaction(config, mutate)


def room_registry_release(config: dict[str, Any], room_id: str, *, run_id: str, activity: str = "release") -> dict[str, Any]:
    ledger = room_registry_read(config)
    room = next((item for item in ledger["rooms"] if item.get("room_id") == room_id), None)
    if room is None:
        return {"room_id": room_id, "state": "released"}
    if room.get("state") == "released":
        return _room_registry_public(room)
    return room_registry_update(config, room_id, run_id=run_id, state="released", activity=activity)


def room_registry_release_stale(config: dict[str, Any], room_id: str, *, run_id: str, activity: str = "stale-room-release") -> dict[str, Any]:
    """Release one owner-matching stale room after positive absence readback.

    This is intentionally separate from normal release because a scheduled
    room can retain an old lease digest after its owner process has already
    disappeared.  The owner id, profile, port, process, listener, daemon,
    exact lock paths, and (for temporary rooms) the shared-profile lease are
    all checked before the terminal state change.  Closing the room and its
    shared lease together prevents a stale room repair from leaving a claimed
    lease behind for a later session.
    """
    if not isinstance(room_id, str) or not room_id.startswith("room-"):
        raise Blocker("browser_use_room_registry_room_id_invalid")
    run_id = safe_id(run_id, "run_id")
    room = room_registry_lookup(config, room_id)
    if room is None:
        raise Blocker("browser_use_room_registry_room_missing")
    if room.get("state") == "released":
        return room
    owner = room.get("owner") if isinstance(room.get("owner"), dict) else {}
    if owner.get("id") != run_id:
        raise Blocker("browser_use_room_registry_owner_conflict")
    if room.get("state") not in ROOM_REGISTRY_ACTIVE_STATES | {"stale"}:
        raise Blocker("browser_use_room_registry_state_invalid")
    observations = room_registry_observations(config)
    matching = [
        item for item in observations
        if item.get("room_id") == room_id
        and item.get("profile") == room.get("profile")
        and int(item.get("port", -1)) == int(room.get("port", -2))
    ]
    if not matching:
        raise Blocker("browser_use_room_registry_stale_release_observation_missing")
    if any(
        item.get("listener_observed") is not False
        or item.get("process_observed") is not False
        or item.get("daemon_observed") is not False
        for item in matching
    ):
        raise Blocker("browser_use_room_registry_stale_release_runtime_present")
    profile = os.path.realpath(str(room.get("profile")))
    port = int(room.get("port", -1))
    shared_lease: dict[str, Any] | None = None
    if room.get("lifecycle") == TEMPORARY_LIFECYCLE:
        shared_leases = [
            lease
            for lease in _shared_profile_lease_records(config, create=False)
            if lease.get("room_id") == room_id
        ]
        if len(shared_leases) > 1:
            raise Blocker("browser_use_room_registry_shared_lease_ambiguous")
        if shared_leases:
            shared_lease = shared_leases[0]
            if shared_lease.get("task_id") != run_id:
                raise Blocker("browser_use_room_registry_owner_conflict")
            if (
                os.path.realpath(str(shared_lease.get("profile") or "")) != profile
                or int(shared_lease.get("port", -1)) != port
            ):
                raise Blocker("browser_use_room_registry_shared_lease_binding_invalid")
            lock_paths = [
                os.path.realpath(str(path))
                for path in shared_lease.get("lock_paths", [])
                if isinstance(path, str)
            ]
            expected_lock_paths = {
                os.path.realpath(temporary_profile_lock_path(config, profile)),
                os.path.realpath(temporary_port_lock_path(config, port)),
            }
            if set(lock_paths) != expected_lock_paths or len(lock_paths) != len(expected_lock_paths):
                raise Blocker("browser_use_room_registry_shared_lease_lock_binding_invalid")
        else:
            lock_paths = [
                os.path.realpath(temporary_port_lock_path(config, port)),
                os.path.realpath(temporary_profile_lock_path(config, profile)),
            ]
    else:
        lock_paths = [
            os.path.realpath(os.path.join(config["roots"]["locks"], f"port-{port}.lock")),
            os.path.realpath(os.path.join(config["roots"]["locks"], f"profile-{hashlib.sha256(profile.encode()).hexdigest()[:24]}.lock")),
        ]
    stale_locks: list[tuple[str, dict[str, Any]]] = []
    for path in lock_paths:
        if not os.path.lexists(path):
            continue
        payload = read_json_safe(path)
        if (
            payload.get("schema") != "browser-use-lock.v1"
            or payload.get("canonical_profile") != profile
            or int(payload.get("port", -1)) != port
        ):
            raise Blocker("browser_use_room_registry_stale_release_lock_binding_invalid")
        if shared_lease is not None and (
            payload.get("run_id") != shared_lease.get("run_id")
            or payload.get("nonce") != shared_lease.get("nonce")
            or payload.get("task_id") != shared_lease.get("task_id")
            or payload.get("shared_profile_lease_id") != shared_lease.get("lease_id")
        ):
            raise Blocker("browser_use_room_registry_stale_release_lock_owner_conflict")
        helper_pid = payload.get("helper_pid")
        helper_start_time = payload.get("helper_start_time")
        if not isinstance(helper_pid, int) or helper_pid <= 0 or not isinstance(helper_start_time, (int, float)):
            raise Blocker("browser_use_room_registry_stale_release_lock_identity_invalid")
        if psutil is None:
            raise Blocker("browser_use_room_registry_stale_release_lock_process_readback_unavailable")
        try:
            helper_process = psutil.Process(helper_pid)
            if not helper_process.is_running() or abs(float(helper_process.create_time()) - float(helper_start_time)) >= 2.0:
                pass
            else:
                raise Blocker("browser_use_room_registry_stale_release_lock_process_live")
        except psutil.NoSuchProcess:
            pass
        except (psutil.AccessDenied, psutil.ZombieProcess, OSError) as exc:
            raise Blocker("browser_use_room_registry_stale_release_lock_process_readback_uncertain") from exc
        stale_locks.append((path, payload))
    for path, payload in stale_locks:
        release_lock(path, str(payload["run_id"]), str(payload["nonce"]))
        if os.path.lexists(path):
            raise Blocker("browser_use_room_registry_stale_release_lock_cleanup_readback_failed")

    def mutate(registry: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any]]:
        current = next((item for item in registry["rooms"] if item.get("room_id") == room_id), None)
        if current is None:
            raise Blocker("browser_use_room_registry_room_missing")
        current_owner = current.get("owner") if isinstance(current.get("owner"), dict) else {}
        if current_owner.get("id") != run_id:
            raise Blocker("browser_use_room_registry_owner_conflict")
        now = iso(now_utc())
        current["state"] = "released"
        current["updated_at"] = now
        current["last_activity_at"] = now
        current["current_activity"] = _room_registry_activity(activity)
        current["activity"] = (current.get("activity") or [])[-7:] + [{"at": now, "kind": _room_registry_activity(activity)}]
        registry["updated_at"] = now
        public = _room_registry_public(current)
        public["locks_removed"] = [path for path, _payload in stale_locks]
        return registry, public

    released = _room_registry_transaction(config, mutate)
    if shared_lease is not None:
        mark_shared_profile_lease_released(
            config,
            os.path.realpath(str(shared_lease["_path"])),
            run_id=str(shared_lease["run_id"]),
            session=str(shared_lease["session"]),
            task_id=str(shared_lease["task_id"]),
            room=released,
        )
        released["shared_profile_lease_released"] = True
    return released


def room_registry_admin_release(config: dict[str, Any], room_id: str, *, owner_id: str, delete_approved: bool, delete_profile: bool, activity: str = "admin-release") -> dict[str, Any]:
    """Release one dead room after explicit operator-approved cleanup.

    This is a recovery lane for rooms whose historical lease run ID is no
    longer recoverable. It never kills a process and never accepts a foreign
    owner: the current room owner, exact profile scope, two-pass runtime
    absence readback, and explicit deletion approval are all required.
    """
    if not delete_approved:
        raise Blocker("browser_use_room_admin_delete_approval_required")
    if not isinstance(room_id, str) or not room_id.startswith("room-"):
        raise Blocker("browser_use_room_registry_room_id_invalid")
    owner_id = safe_id(owner_id, "owner_id")
    room = room_registry_lookup(config, room_id)
    if room is None:
        raise Blocker("browser_use_room_registry_room_missing")
    owner = room.get("owner") if isinstance(room.get("owner"), dict) else {}
    if owner.get("id") != owner_id:
        raise Blocker("browser_use_room_registry_owner_conflict")
    if room.get("state") == "released":
        return {**room, "profile_deleted": False, "already_released": True}
    _room_registry_owner_reuse_absence_readback(config, room)
    lifecycle = str(room.get("lifecycle") or "")
    profile_roots = {
        "scheduled": config["roots"]["scheduled_profiles"],
        TEMPORARY_LIFECYCLE: config["roots"]["temporary_profiles"],
        "single-use": config["roots"]["single_use_profiles"],
    }
    profile = os.path.realpath(str(room.get("profile") or ""))
    profile_root = os.path.realpath(str(profile_roots.get(lifecycle) or ""))
    if not profile or not profile_root or os.path.dirname(profile) != profile_root:
        raise Blocker("browser_use_room_admin_profile_scope_invalid")
    lock_paths = [
        os.path.realpath(os.path.join(config["roots"]["locks"], f"port-{int(room.get('port'))}.lock")),
        os.path.realpath(os.path.join(config["roots"]["locks"], f"profile-{hashlib.sha256(profile.encode()).hexdigest()[:24]}.lock")),
    ]
    if any(os.path.lexists(path) for path in lock_paths):
        raise Blocker("browser_use_room_admin_lock_present")
    if delete_profile and os.path.lexists(profile):
        if os.path.islink(profile) or not os.path.isdir(profile):
            raise Blocker("browser_use_room_admin_profile_type_invalid")
        shutil.rmtree(profile)
        if os.path.lexists(profile):
            raise Blocker("browser_use_room_admin_profile_delete_readback_failed")

    def mutate(registry: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any]]:
        current = next((item for item in registry["rooms"] if item.get("room_id") == room_id), None)
        if current is None:
            raise Blocker("browser_use_room_registry_room_missing")
        current_owner = current.get("owner") if isinstance(current.get("owner"), dict) else {}
        if current_owner.get("id") != owner_id:
            raise Blocker("browser_use_room_registry_owner_conflict")
        now = iso(now_utc())
        current["state"] = "released"
        current["updated_at"] = now
        current["last_activity_at"] = now
        current["current_activity"] = _room_registry_activity(activity)
        current["activity"] = (current.get("activity") or [])[-7:] + [{"at": now, "kind": _room_registry_activity(activity)}]
        registry["updated_at"] = now
        public = _room_registry_public(current)
        public["profile_deleted"] = bool(delete_profile)
        public["already_released"] = False
        return registry, public

    return _room_registry_transaction(config, mutate)


def room_registry_list(config: dict[str, Any]) -> list[dict[str, Any]]:
    return [_room_registry_public(room) for room in room_registry_read(config, create=False)["rooms"]]


def room_registry_observations(config: dict[str, Any]) -> list[dict[str, Any]]:
    """Observe descriptor-backed runs without claiming ownership of resources."""
    registry = room_registry_read(config, create=False)
    active_room_ids = {
        str(room.get("room_id"))
        for room in registry["rooms"]
        if room.get("state") in ROOM_REGISTRY_ACTIVE_STATES | {"stale"} and room.get("room_id")
    }
    # A released-only registry is the normal post-cleanup state.  Avoid
    # scanning historical descriptors and probing unrelated PIDs/listeners
    # when there is no helper-owned room that can be observed.
    if not active_room_ids:
        return []
    observations: list[dict[str, Any]] = []
    for path in _recording_descriptor_paths(config):
        try:
            descriptor = read_json_safe(path)
            room_id = descriptor.get("room_id")
            # Historical descriptors are common after a busy day of public and
            # temporary runs.  Do not probe their processes/listeners: only a
            # descriptor bound to a currently active registry room can affect
            # stale-room reconciliation or live-helper replacement.
            if not room_id or str(room_id) not in active_room_ids:
                continue
            process = descriptor.get("process") or {}
            port = int(descriptor.get("port"))
            listener = bool(port_listener(port) or lsof_listener(port))
            try:
                process_observed = bool(validate_handoff_process_identity(
                    config,
                    {"process": process, "port": port, "profile": descriptor.get("profile")},
                    allow_missing=True,
                ))
            except Blocker as exc:
                if exc.code in {"browser_use_handoff_chrome_missing", "browser_use_handoff_chrome_identity_drift"}:
                    # A reused PID is positive evidence that the descriptor's
                    # Chrome is gone, provided the independent listener check
                    # above is also false. Treat it as stale absence so the
                    # owner-approved stale-release path can remove only the
                    # exact dead lock; never infer liveness from the reused PID.
                    process_observed = False
                else:
                    process_observed = None
            runtime = os.path.join(browser_harness_root(str(descriptor.get("session") or "")), "runtime")
            daemon_observed = any(os.path.lexists(os.path.join(runtime, name)) for name in ("bu.sock", "bu.pid", "bu.port"))
        except (Blocker, OSError, TypeError, ValueError):
            listener = None
            process_observed = None
            daemon_observed = None
            descriptor = {}
            room_id = None
        if not room_id:
            continue
        observations.append({
            "room_id": str(room_id),
            "descriptor": os.path.realpath(path),
            "run_id": descriptor.get("run_id"),
            "session": descriptor.get("session"),
            "lifecycle": descriptor.get("lifecycle"),
            "state": descriptor.get("status"),
            "port": descriptor.get("port"),
            "profile": descriptor.get("profile"),
            "listener_observed": listener,
            "process_observed": process_observed,
            "daemon_observed": daemon_observed,
            "process_start_time": process.get("root_start_time"),
            "ownership": "descriptor_bound_observation",
            "reclaim_allowed": bool(listener is False and process_observed is False and daemon_observed is False),
            "observed_at": iso(now_utc()),
        })
    return observations


def room_registry_reconcile_stale(config: dict[str, Any], observations: list[dict[str, Any]] | None = None) -> list[dict[str, Any]]:
    """Mark only positively dead descriptor-backed rooms as stale.

    This does not delete profiles, remove locks, or terminate processes.  A
    later claim/recovery must still recheck the exact process and listener
    identity before reusing the room.
    """
    observations = observations if observations is not None else room_registry_observations(config)
    by_room = {str(item.get("room_id")): item for item in observations if isinstance(item, dict) and item.get("room_id")}

    def mutate(registry: dict[str, Any]) -> tuple[dict[str, Any], list[dict[str, Any]]]:
        now = iso(now_utc())
        changed: list[dict[str, Any]] = []
        for room in registry["rooms"]:
            if room.get("state") not in ROOM_REGISTRY_ACTIVE_STATES:
                continue
            observation = by_room.get(str(room.get("room_id")))
            if not observation or observation.get("profile") != room.get("profile") or observation.get("port") != room.get("port"):
                continue
            if observation.get("reclaim_allowed") is not True:
                continue
            room["state"] = "stale"
            room["updated_at"] = now
            room["last_activity_at"] = now
            room["current_activity"] = "reconcile-stale"
            room["activity"] = (room.get("activity") or [])[-7:] + [{"at": now, "kind": "reconcile-stale"}]
            changed.append(_room_registry_public(room))
        registry["updated_at"] = now
        return registry, changed

    return _room_registry_transaction(config, mutate)


def room_registry_lookup(config: dict[str, Any], room_id: str) -> dict[str, Any] | None:
    if not isinstance(room_id, str) or not room_id.startswith("room-"):
        return None
    return next((room for room in room_registry_list(config) if room.get("room_id") == room_id), None)


def room_registry_table(rooms: list[dict[str, Any]]) -> str:
    headers = ("LIFECYCLE", "OWNER", "PROFILE", "PORT", "STATE", "CURRENT", "CREATED", "UPDATED")
    rows = []
    for room in rooms:
        owner = room.get("owner") or {}
        owner_text = f"{owner.get('kind', 'owner')}:{owner.get('id', '')}"
        rows.append((str(room.get("lifecycle", "")), owner_text, str(room.get("profile", "")), str(room.get("port", "")), str(room.get("state", "")), str(room.get("current_activity", "")), str(room.get("created_at", "")), str(room.get("updated_at", ""))))
    widths = [max(len(headers[index]), *(len(row[index]) for row in rows)) for index in range(len(headers))]
    lines = ["  ".join(headers[index].ljust(widths[index]) for index in range(len(headers)))]
    lines.append("  ".join("-" * width for width in widths))
    lines.extend("  ".join(row[index].ljust(widths[index]) for index in range(len(headers))) for row in rows)
    return "\n".join(lines)


def room_registry_command(config: dict[str, Any], args: argparse.Namespace) -> int:
    observations = room_registry_observations(config)
    changed = room_registry_reconcile_stale(config, observations) if getattr(args, "reconcile_stale", False) else []
    rooms = room_registry_list(config)
    reconciliation = "stale_rooms_marked" if getattr(args, "reconcile_stale", False) else "observation_only"
    sync_admission = None
    source_helper_sha256 = getattr(args, "sync_admission_source_sha256", None)
    installed_helper_sha256 = getattr(args, "sync_admission_installed_sha256", None)
    if source_helper_sha256 is not None or installed_helper_sha256 is not None:
        sync_admission = room_registry_sync_admission(
            rooms,
            source_helper_sha256=source_helper_sha256,
            installed_helper_sha256=installed_helper_sha256,
        )
    if getattr(args, "json_output", False):
        payload = {"schema": ROOM_REGISTRY_SCHEMA, "rooms": rooms, "observations": observations, "reconciliation": reconciliation, "changed": changed}
        if sync_admission is not None:
            payload["sync_admission"] = sync_admission
        print(json.dumps(payload, sort_keys=True))
    else:
        print(room_registry_table(rooms))
        if observations:
            print(json.dumps({"observations": observations, "reconciliation": reconciliation, "changed": changed}, sort_keys=True))
    return 0


def assert_owned_locks(paths: list[str], run_id: str, nonce: str) -> None:
    for path in paths:
        value = read_json_safe(path)
        if value.get("run_id") != run_id or value.get("nonce") != nonce:
            raise Blocker("browser_use_lock_owner_recheck_failed")


def annotate_lock_process_identity(paths: list[str], run_id: str, nonce: str, process_identity: dict[str, Any]) -> None:
    """Bind the lock to the actual Chrome lineage after launch.

    A helper process can exit while its owned Chrome remains valid.  The
    original lock metadata only recorded the helper PID, which made status
    output look contradictory.  Keep the existing ownership fields and add a
    descriptor-matching Chrome identity atomically after launch.
    """
    if not isinstance(process_identity, dict):
        raise Blocker("browser_use_process_identity_unavailable")
    required = ("root_pid", "root_start_time")
    if any(key not in process_identity for key in required):
        raise Blocker("browser_use_process_identity_unavailable")
    for path in paths:
        value = read_json_safe(path)
        if value.get("run_id") != run_id or value.get("nonce") != nonce:
            raise Blocker("browser_use_lock_owner_recheck_failed")
        value["process_identity_source"] = "descriptor_process"
        value["chrome_process"] = {
            "pid": process_identity.get("pid"),
            "start_time": process_identity.get("start_time"),
            "root_pid": process_identity["root_pid"],
            "root_start_time": process_identity["root_start_time"],
        }
        json_atomic_replace(path, value)


def choose_port(config: dict[str, Any], lifecycle: str, automation_id: str) -> int:
    ports = config["ports"]
    if lifecycle == "scheduled":
        start, end = ports["scheduled_start"], ports["scheduled_end"]
    elif lifecycle == "single-use":
        start, end = ports["single_use_start"], ports["single_use_end"]
    else:
        raise Blocker("browser_use_port_selection_lifecycle_invalid", lifecycle)
    offset = int(hashlib.sha256(automation_id.encode()).hexdigest(), 16) % (end - start + 1)
    for index in range(end - start + 1):
        port = start + ((offset + index) % (end - start + 1))
        if not port_listener(port) and not lsof_listener(port):
            return port
    raise Blocker("browser_use_no_free_port", lifecycle)


def profile_hash(profile: str, nonce: str) -> str:
    return hashlib.sha256(f"{os.path.realpath(profile)}\0{nonce}".encode()).hexdigest()


def temporary_authority_scope(authority: dict[str, Any]) -> dict[str, Any]:
    return {
        "data_exposure": authority["data_exposure"],
        "side_effect_scope": authority["side_effect_scope"],
        "approval": authority["approval"],
        "readback_required": authority["readback_required"],
    }


def default_chat_task_id(requested_session: str) -> str:
    digest = hashlib.sha256(str(requested_session).encode("utf-8")).hexdigest()[:32]
    return f"chat-{digest}"


def resolve_default_lifecycle(mode: str, requested_lifecycle: str | None) -> str:
    if requested_lifecycle:
        return str(requested_lifecycle)
    return TEMPORARY_LIFECYCLE if mode == "authorized" else "single-use"


def ensure_temporary_task_id(args: argparse.Namespace, requested_session: str) -> None:
    if getattr(args, "lifecycle", None) == TEMPORARY_LIFECYCLE and not getattr(args, "task_id", None):
        args.task_id = default_chat_task_id(requested_session)


def delete_approval_signal(args: argparse.Namespace) -> bool:
    # --user-ok remains a compatibility alias for callers from the previous
    # contract; new callers should use the semantically explicit flag.
    return bool(getattr(args, "delete_approved", False) or getattr(args, "user_ok", False))


def require_temporary_delete_approval(
    descriptor: dict[str, Any],
    *,
    delete_approved: bool = False,
    cleanup_only: bool = False,
    preserve_temporary: bool = False,
) -> None:
    if descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE:
        return
    if cleanup_only:
        if descriptor.get("status") in TEMPORARY_CLEANUP_STATUSES:
            return
        if (
            preserve_temporary
            and descriptor.get("status") in {"active", "continued"}
            and descriptor.get("owned_chrome") is True
            and operation_effect_summary(descriptor) == "unknown"
        ):
            # An explicit owner-bound preserve-temporary stop is terminal
            # resource cleanup, not external-effect resolution. Keep the
            # unknown effect and pending reconciliation intact while stopping
            # only this run's recorder, daemon, Chrome, and locks. Older
            # descriptors may not persist page authentication state, so this
            # cleanup lane must not depend on that incidental field.
            return
        raise Blocker("browser_use_temporary_cleanup_only_requires_terminal_state")
    if delete_approved and preserve_temporary:
        raise Blocker("browser_use_temporary_retention_choice_conflict")
    if delete_approved or preserve_temporary:
        return
    raise Blocker("browser_use_temporary_delete_approval_required")


def promote_verified_terminal_cleanup(
    config: dict[str, Any],
    descriptor: dict[str, Any],
) -> bool:
    """Promote a stopped, resource-free recording for cleanup-only retry.

    A finalize retry may have stopped media and released the shared lease
    before a later idempotency check failed.  The descriptor remains
    ``continued`` in that case, but cleanup-only must not guess.  Promote only
    when the recorder, process, locks, room, and shared lease all positively
    prove terminal state.
    """
    if descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE or descriptor.get("status") not in {"active", "continued"}:
        return False
    try:
        status = read_recording_status(descriptor["status_path"], require_active=False)
    except Blocker as exc:
        # An active authentication-wait recorder is not terminal evidence,
        # but that is a normal negative result for this probe. Let the
        # bounded preserve-temporary recovery path inspect the live recorder
        # instead of turning the probe itself into the cleanup blocker.
        if exc.code == "browser_use_recording_not_finalized":
            return False
        raise
    if status.get("finalized") is not True or status.get("media_finalized") is not True:
        return False
    if not _recording_runtime_is_stale(config, descriptor):
        return False
    if any(os.path.lexists(path) for path in descriptor.get("lock_paths", [])):
        return False
    room_id = descriptor.get("room_id")
    if room_id:
        room = room_registry_lookup(config, str(room_id))
        if room is None or room.get("state") != "released":
            return False
    lease_path = descriptor.get("shared_profile_lease_path")
    if lease_path:
        lease = read_json_safe(str(lease_path))
        if (
            lease.get("schema") != SHARED_PROFILE_LEASE_SCHEMA
            or lease.get("state") != "released"
            or lease.get("run_id") != descriptor.get("run_id")
            or lease.get("session") != descriptor.get("session")
            or lease.get("task_id") != descriptor.get("task_id")
        ):
            return False
    descriptor.update({
        "status": "cleanup_pending",
        "recovery_state": "cleanup_pending",
        "recording_finalized": True,
        "cleanup_terminal_proof": {
            "recorder_finalized": True,
            "media_finalized": True,
            "process_absent": True,
            "locks_absent": True,
            "room_released": True,
            "shared_lease_released": True,
            "basis": "same-run terminal readback after partial cleanup retry",
        },
    })
    return True


def require_temporary_user_ok(
    descriptor: dict[str, Any],
    *,
    user_ok: bool = False,
    cleanup_only: bool = False,
) -> None:
    """Compatibility wrapper for the prior --user-ok contract."""
    require_temporary_delete_approval(
        descriptor,
        delete_approved=user_ok,
        cleanup_only=cleanup_only,
    )


def temporary_binding(
    *,
    mode: str,
    lifecycle: str,
    automation_id: str,
    task_id: str,
    run_id: str,
    authority_digest: str,
    authority_scope: dict[str, Any],
    account_identity: str,
    origins: list[str],
) -> str:
    if mode != "authorized" or lifecycle != TEMPORARY_LIFECYCLE:
        raise Blocker("browser_use_temporary_binding_invalid")
    safe_id(automation_id, "automation_id")
    safe_id(task_id, "task_id")
    safe_id(run_id, "run_id")
    if not re.fullmatch(r"[0-9a-f]{64}", authority_digest):
        raise Blocker("browser_use_temporary_authority_digest_invalid")
    value = {
        "mode": mode,
        "lifecycle": lifecycle,
        "automation_id": automation_id,
        "task_id": task_id,
        # The room/profile identity is task-scoped.  run_id and the current
        # authority digest are fresh-run attestation fields, not room keys;
        # including them would create a new temporary profile on every turn.
        "authority_scope": authority_scope,
        "account_identity": account_identity,
        "origins": sorted({normalize_origin(item) for item in origins}),
        "origin": sorted({normalize_origin(item) for item in origins})[0],
    }
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def temporary_profile_path(config: dict[str, Any], binding: str) -> str:
    root = os.path.realpath(config["roots"]["temporary_profiles"])
    if not re.fullmatch(r"[0-9a-f]{64}", binding):
        raise Blocker("browser_use_temporary_binding_invalid")
    return os.path.join(root, binding)


def temporary_port(config: dict[str, Any], binding: str) -> int:
    start = int(config["ports"]["temporary_start"])
    end = int(config["ports"]["temporary_end"])
    return start + (int(binding[:16], 16) % (end - start + 1))


def temporary_profile_lock_path(config: dict[str, Any], profile: str) -> str:
    return os.path.join(config["roots"]["locks"], f"temporary-profile-{hashlib.sha256(os.path.realpath(profile).encode()).hexdigest()[:24]}.lock")


def temporary_port_lock_path(config: dict[str, Any], port: int) -> str:
    return os.path.join(config["roots"]["locks"], f"port-{port}.lock")


def temporary_marker_value(
    config: dict[str, Any],
    *,
    profile: str,
    mode: str,
    automation_id: str,
    task_id: str,
    run_id: str,
    binding: str,
    port: int,
    authority_digest: str,
    authority_scope: dict[str, Any],
    account_identity: str,
    origins: list[str],
    created_at: str,
) -> dict[str, Any]:
    created = dt.datetime.fromisoformat(created_at.replace("Z", "+00:00"))
    expires_at = iso(created + dt.timedelta(seconds=TEMPORARY_TTL_SECONDS))
    return {
        "schema": TEMPORARY_PROFILE_MARKER_SCHEMA,
        "version": 2,
        "mode": mode,
        "lifecycle": TEMPORARY_LIFECYCLE,
        "automation_id": automation_id,
        "task_id": task_id,
        "run_id": run_id,
        "creation_binding": binding,
        "canonical_profile": os.path.realpath(profile),
        "created_at": created_at,
        "expires_at": expires_at,
        "retention_mode": TEMPORARY_RETENTION_RUN_TTL,
        "port": port,
        "authority_sha256": authority_digest,
        "authority_scope": authority_scope,
        "account_identity": account_identity,
        "origins": sorted({normalize_origin(item) for item in origins}),
        "origin": sorted({normalize_origin(item) for item in origins})[0],
        "profile_lock_path": os.path.realpath(temporary_profile_lock_path(config, profile)),
        "port_lock_path": os.path.realpath(temporary_port_lock_path(config, port)),
        "owner_uid": EUID,
    }


def _parse_temporary_time(value: Any, field: str) -> dt.datetime:
    try:
        parsed = dt.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except (TypeError, ValueError) as exc:
        raise Blocker("browser_use_temporary_marker_time_invalid", field) from exc
    if parsed.tzinfo is None:
        raise Blocker("browser_use_temporary_marker_time_invalid", field)
    return parsed.astimezone(dt.timezone.utc)


def validate_temporary_marker(
    config: dict[str, Any],
    profile: str,
    expected: dict[str, Any],
    *,
    require_unexpired: bool = True,
) -> dict[str, Any]:
    root = os.path.realpath(config["roots"]["temporary_profiles"])
    if os.path.realpath(profile) != profile or not profile.startswith(root + os.sep):
        raise Blocker("browser_use_temporary_profile_scope_mismatch")
    assert_directory(profile)
    marker_path = os.path.join(profile, ".browser-use-profile.json")
    assert_regular_file(marker_path, mode=0o600)
    marker = read_json_safe(marker_path)
    required = {"schema", "version", "mode", "lifecycle", "automation_id", "task_id", "run_id", "creation_binding", "canonical_profile", "created_at", "expires_at", "port", "authority_sha256", "authority_scope", "account_identity", "origins", "origin", "profile_lock_path", "port_lock_path", "owner_uid"}
    if marker.get("schema") != TEMPORARY_PROFILE_MARKER_SCHEMA or marker.get("version") != 2 or not required.issubset(marker):
        raise Blocker("browser_use_temporary_marker_invalid")
    immutable_fields = ("mode", "lifecycle", "automation_id", "task_id", "creation_binding", "canonical_profile", "port", "authority_scope", "account_identity", "origins")
    for field in immutable_fields:
        if marker.get(field) != expected.get(field):
            raise Blocker("browser_use_temporary_binding_mismatch", field)
    if marker.get("canonical_profile") != profile or marker.get("owner_uid") != EUID:
        raise Blocker("browser_use_temporary_marker_binding_invalid")
    if not isinstance(marker.get("origins"), list) or not marker["origins"] or marker.get("origin") != sorted(marker["origins"])[0]:
        raise Blocker("browser_use_temporary_origin_binding_invalid")
    if marker.get("profile_lock_path") != os.path.realpath(temporary_profile_lock_path(config, profile)) or marker.get("port_lock_path") != os.path.realpath(temporary_port_lock_path(config, int(marker["port"]))):
        raise Blocker("browser_use_temporary_lock_binding_invalid")
    created = _parse_temporary_time(marker.get("created_at"), "created_at")
    retention_mode = marker.get("retention_mode", TEMPORARY_RETENTION_RUN_TTL)
    if retention_mode not in TEMPORARY_RETENTION_MODES:
        raise Blocker("browser_use_temporary_retention_mode_invalid")
    if retention_mode == TEMPORARY_RETENTION_MANUAL:
        if marker.get("expires_at") is not None:
            raise Blocker("browser_use_temporary_manual_retention_expiry_invalid")
    else:
        expires = _parse_temporary_time(marker.get("expires_at"), "expires_at")
        if expires != created + dt.timedelta(seconds=TEMPORARY_TTL_SECONDS):
            raise Blocker("browser_use_temporary_ttl_immutable_violation")
        if require_unexpired and expires <= now_utc():
            raise Blocker("browser_use_temporary_profile_expired")
    return marker


def shared_profile_lease_root(config: dict[str, Any], *, create: bool = True) -> str:
    """Return the private index for cross-session authenticated-profile leases."""
    root = os.path.join(config["roots"]["browser_use_home"], SHARED_PROFILE_LEASE_ROOT_NAME)
    if create:
        assert_directory(root, create=True)
    return root


def shared_profile_lease_path(config: dict[str, Any], lease_id: str) -> str:
    lease_id = safe_id(lease_id, "shared_profile_lease_id")
    return os.path.join(shared_profile_lease_root(config), f"{lease_id}.json")


def shared_profile_availability_path(profile: str) -> str:
    profile = os.path.realpath(profile)
    return os.path.join(profile, SHARED_PROFILE_AVAILABILITY_FILENAME)


def shared_profile_match_digest(account_identity: str, origins: list[str]) -> str:
    """Hash the matching tuple without persisting the account identity itself."""
    normalized = sorted({normalize_origin(item) for item in origins})
    if not account_identity or not normalized:
        raise Blocker("browser_use_shared_profile_match_invalid")
    payload = {"account_identity": account_identity, "origins": normalized}
    return hashlib.sha256(json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()


def _shared_profile_marker_expected(marker: dict[str, Any]) -> dict[str, Any]:
    fields = (
        "mode", "lifecycle", "automation_id", "task_id", "run_id",
        "creation_binding", "canonical_profile", "port", "authority_sha256",
        "authority_scope", "account_identity", "origins",
    )
    return {field: marker.get(field) for field in fields}


def _shared_profile_lease_records(config: dict[str, Any], *, create: bool = False) -> list[dict[str, Any]]:
    records: list[dict[str, Any]] = []
    root = shared_profile_lease_root(config, create=create)
    if not os.path.isdir(root):
        return records
    for path in sorted(pathlib.Path(root).glob("*.json")):
        try:
            value = read_json_safe(str(path))
        except (Blocker, OSError, ValueError, json.JSONDecodeError):
            continue
        value["_path"] = os.path.realpath(str(path))
        if value.get("schema") == SHARED_PROFILE_LEASE_SCHEMA and value.get("state") in SHARED_PROFILE_LEASE_STATES:
            records.append(value)
    return records


def _shared_profile_is_busy(config: dict[str, Any], profile: str, port: int) -> bool:
    for lease in _shared_profile_lease_records(config):
        if lease.get("state") in {"claimed", "releasing"} and (
            os.path.realpath(str(lease.get("profile") or "")) == profile
            or int(lease.get("port", -1)) == port
        ):
            return True
    registry = room_registry_read(config, create=False)
    for room in registry["rooms"]:
        if room.get("state") != "released" and (
            os.path.realpath(str(room.get("profile") or "")) == profile
            or int(room.get("port", -1)) == port
        ):
            return True
    try:
        _room_registry_owner_reuse_absence_readback(config, {"profile": profile, "port": port})
    except Blocker:
        return True
    return False


def list_shared_temporary_profiles(config: dict[str, Any]) -> list[dict[str, Any]]:
    """Read the central shared-profile pool without claiming or attaching.

    The returned records are internal candidates. Callers that cross a
    session boundary must use ``shared_profile_inventory`` so raw account
    identities and canonical profile paths never enter the shared readback.
    """
    candidates: list[dict[str, Any]] = []
    root = os.path.realpath(config["roots"]["temporary_profiles"])
    for entry in sorted(pathlib.Path(root).iterdir()):
        if entry.is_symlink() or not entry.is_dir() or os.path.realpath(str(entry.parent)) != root:
            continue
        profile = os.path.realpath(str(entry))
        marker_path = os.path.join(profile, ".browser-use-profile.json")
        try:
            marker = read_json_safe(marker_path)
            if marker.get("mode") != "authorized" or marker.get("lifecycle") != TEMPORARY_LIFECYCLE:
                continue
            availability_path = shared_profile_availability_path(profile)
            availability = read_json_safe(availability_path)
            retention_mode = marker.get("retention_mode", TEMPORARY_RETENTION_RUN_TTL)
            if (
                availability.get("schema") != SHARED_PROFILE_AVAILABILITY_SCHEMA
                or availability.get("status") != "available"
                or availability.get("canonical_profile") != profile
                or availability.get("profile_marker_sha256") != sha256_file(marker_path)
                or availability.get("expires_at") != marker.get("expires_at")
                or availability.get("retention_mode", TEMPORARY_RETENTION_RUN_TTL) != retention_mode
            ):
                continue
            marker = validate_temporary_marker(config, profile, _shared_profile_marker_expected(marker), require_unexpired=True)
            marker_origins = sorted({normalize_origin(item) for item in marker.get("origins", [])})
            account_identity = marker.get("account_identity")
            if not isinstance(account_identity, str) or not marker_origins:
                continue
            port = int(marker["port"])
            leases = _shared_profile_lease_records(config, create=False)
            leased = any(
                lease.get("state") in {"claimed", "releasing"}
                and (os.path.realpath(str(lease.get("profile") or "")) == profile or int(lease.get("port", -1)) == port)
                for lease in leases
            )
            busy = _shared_profile_is_busy(config, profile, port)
            candidates.append({
                "profile": profile,
                "profile_id": marker.get("creation_binding"),
                "port": port,
                "marker": marker,
                "account_identity": account_identity,
                "account_identity_sha256": hashlib.sha256(account_identity.encode("utf-8")).hexdigest(),
                "origins": marker_origins,
                "match_digest": shared_profile_match_digest(account_identity, marker_origins),
                "availability_marker_sha256": sha256_file(availability_path),
                "enabled_at": availability.get("enabled_at"),
                "retention_mode": retention_mode,
                "status": "leased" if leased else "busy" if busy else "available",
            })
        except (Blocker, OSError, ValueError, KeyError, json.JSONDecodeError):
            continue
    return candidates


def shared_profile_inventory(config: dict[str, Any]) -> dict[str, Any]:
    """Return the safe cross-session inventory projection."""
    candidates = list_shared_temporary_profiles(config)

    def safe_inventory_id(value: Any, field: str) -> str | None:
        if not isinstance(value, str):
            return None
        try:
            return safe_id(value, field)
        except Blocker:
            return None

    profiles = [
        {
            # This is a display-only handle. It is deliberately unrelated to
            # the creation binding and is never accepted by claim/release.
            "inventory_id": hashlib.sha256(("browser-use-inventory:" + candidate["availability_marker_sha256"]).encode("utf-8")).hexdigest()[:16],
            "status": candidate["status"],
            "retention_mode": candidate["retention_mode"],
            # Cross-session callers need to identify the intended account
            # without receiving the raw identity or the canonical profile.
            "account_identity_sha256": candidate["account_identity_sha256"],
            "origins": list(candidate["origins"]),
            "match_digest": candidate["match_digest"],
            "port": candidate["port"],
            "expires_at": candidate["marker"].get("expires_at"),
            # Bounded workflow labels let another session choose the intended
            # profile without exposing raw identity, cookies, or profile path.
            "owner_bound": True,
            "purpose": "authenticated_temporary_profile",
            "owner_automation_id": safe_inventory_id(candidate["marker"].get("automation_id"), "automation_id"),
            "source_task_id": safe_inventory_id(candidate["marker"].get("task_id"), "task_id"),
            "source_run_id": safe_inventory_id(candidate["marker"].get("run_id"), "run_id"),
            "claimability": "claimable" if candidate["status"] == "available" else "owner_bound_read_only",
            "operation_policy": "claim_requires_exact_account_and_origin_authority",
        }
        for candidate in candidates
    ]
    return {
        "schema": "browser-use-shared-profile-inventory.v1",
        "status": "completed",
        "profiles": profiles,
        "profile_count": len(profiles),
        "available_count": sum(item["status"] == "available" for item in profiles),
        "leased_count": sum(item["status"] == "leased" for item in profiles),
        "busy_count": sum(item["status"] == "busy" for item in profiles),
        "external_effects": "none",
        "launch": False,
    }


def temporary_share_list(config: dict[str, Any]) -> int:
    """Print the display-only shared-profile inventory; never mutates state."""
    print(json.dumps(shared_profile_inventory(config), sort_keys=True))
    return 0


def find_shared_temporary_profiles(
    config: dict[str, Any],
    *,
    account_identity: str,
    allowed_origins: list[str],
    requested_origin: str | None = None,
    source_run_id: str | None = None,
    source_task_id: str | None = None,
) -> list[dict[str, Any]]:
    """Find idle logged-in temporary profiles; never launches or attaches."""
    origins = sorted({normalize_origin(item) for item in allowed_origins})
    if requested_origin:
        requested_origin = normalize_origin(requested_origin)
        if requested_origin not in origins:
            raise Blocker("browser_use_shared_profile_origin_not_authorized")
    candidates: list[dict[str, Any]] = []
    for candidate in list_shared_temporary_profiles(config):
        if candidate["status"] != "available":
            continue
        marker = candidate["marker"]
        marker_origins = candidate["origins"]
        marker_origin = normalize_origin(marker.get("origin")) if marker.get("origin") else (marker_origins[0] if len(marker_origins) == 1 else "")
        if candidate["account_identity"] != account_identity:
            continue
        if not set(marker_origins).issubset(set(origins)):
            continue
        if requested_origin and marker_origin != requested_origin:
            continue
        # A shared account/origin can legitimately have more than one
        # retained profile.  A cross-session continuation must therefore bind
        # the exact source run and task instead of guessing from pool order.
        if source_run_id and marker.get("run_id") != source_run_id:
            continue
        if source_task_id and marker.get("task_id") != source_task_id:
            continue
        candidates.append(candidate)
    return candidates


def read_shared_profile_lease(
    config: dict[str, Any],
    path: str,
    *,
    run_id: str,
    session: str,
    task_id: str,
    authority: dict[str, Any],
    allow_releasing: bool = False,
) -> dict[str, Any]:
    lease_path = os.path.realpath(path)
    root = os.path.realpath(shared_profile_lease_root(config))
    if lease_path != path or not lease_path.startswith(root + os.sep):
        raise Blocker("browser_use_shared_profile_lease_scope_mismatch")
    lease = read_json_safe(lease_path)
    allowed_states = {"claimed", "releasing"} if allow_releasing else {"claimed"}
    if lease.get("schema") != SHARED_PROFILE_LEASE_SCHEMA or lease.get("state") not in allowed_states:
        raise Blocker("browser_use_shared_profile_lease_state_invalid")
    if lease.get("run_id") != run_id or lease.get("session") != session or lease.get("task_id") != task_id:
        raise Blocker("browser_use_shared_profile_lease_owner_mismatch")
    profile = os.path.realpath(str(lease.get("profile") or ""))
    if not profile.startswith(os.path.realpath(config["roots"]["temporary_profiles"]) + os.sep):
        raise Blocker("browser_use_shared_profile_lease_profile_scope_mismatch")
    if not isinstance(lease.get("creation_binding"), str) or profile != temporary_profile_path(config, lease["creation_binding"]):
        raise Blocker("browser_use_shared_profile_lease_binding_mismatch")
    marker = read_json_safe(os.path.join(profile, ".browser-use-profile.json"))
    validate_temporary_marker(config, profile, _shared_profile_marker_expected(marker), require_unexpired=True)
    availability_path = shared_profile_availability_path(profile)
    availability = read_json_safe(availability_path)
    if (
        availability.get("schema") != SHARED_PROFILE_AVAILABILITY_SCHEMA
        or availability.get("status") != "available"
        or availability.get("canonical_profile") != profile
        or availability.get("profile_marker_sha256") != sha256_file(os.path.join(profile, ".browser-use-profile.json"))
        or availability.get("expires_at") != marker.get("expires_at")
        or availability.get("retention_mode", TEMPORARY_RETENTION_RUN_TTL) != marker.get("retention_mode", TEMPORARY_RETENTION_RUN_TTL)
    ):
        raise Blocker("browser_use_shared_profile_availability_binding_mismatch")
    if marker.get("account_identity") != authority.get("account_identity"):
        raise Blocker("browser_use_shared_profile_account_identity_mismatch")
    marker_origins = sorted({normalize_origin(item) for item in marker.get("origins", [])})
    if not set(marker_origins).issubset({normalize_origin(item) for item in authority.get("allowed_origins", [])}):
        raise Blocker("browser_use_shared_profile_origin_not_authorized")
    expected_digest = shared_profile_match_digest(str(authority["account_identity"]), marker_origins)
    if lease.get("match_digest") != expected_digest:
        raise Blocker("browser_use_shared_profile_match_binding_mismatch")
    if lease.get("availability_marker_sha256") != sha256_file(availability_path):
        raise Blocker("browser_use_shared_profile_availability_changed")
    expected_profile_lock = os.path.realpath(temporary_profile_lock_path(config, profile))
    expected_port_lock = os.path.realpath(temporary_port_lock_path(config, int(lease.get("port", -1))))
    if {os.path.realpath(str(item)) for item in lease.get("lock_paths", [])} != {expected_profile_lock, expected_port_lock}:
        raise Blocker("browser_use_shared_profile_lease_lock_binding_invalid")
    for lock_path in (expected_profile_lock, expected_port_lock):
        if os.path.lexists(lock_path):
            lock = read_json_safe(lock_path)
            if lock.get("run_id") != run_id or lock.get("nonce") != lease.get("nonce") or lock.get("canonical_profile") != profile or int(lock.get("port", -1)) != int(lease.get("port", -1)):
                raise Blocker("browser_use_shared_profile_lease_lock_owner_mismatch")
        elif not allow_releasing:
            raise Blocker("browser_use_shared_profile_lease_lock_missing")
    room = room_registry_lookup(config, str(lease.get("room_id") or ""))
    if room is None or room.get("profile") != profile or int(room.get("port", -1)) != int(lease.get("port", -1)):
        raise Blocker("browser_use_shared_profile_lease_room_binding_mismatch")
    if not allow_releasing and room.get("state") not in ROOM_REGISTRY_ACTIVE_STATES:
        raise Blocker("browser_use_shared_profile_lease_room_not_active")
    lease["_path"] = lease_path
    lease["marker"] = marker
    return lease


def claim_shared_temporary_profile(args: argparse.Namespace) -> int:
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    task_id = safe_id(args.task_id, "task_id")
    authority = parse_authority(args.authority, run_id, session, aliases=session_aliases(config, requested_session, session))
    # parse_authority already performed the canonical 0600 admission.  Keep
    # the exact path in the lease so release can resolve it without retyping.
    authority_path = os.path.realpath(str(args.authority))
    authority_digest = sha256_file(authority_path) if os.path.lexists(authority_path) else None
    requested_source_run_id = getattr(args, "source_run_id", None)
    requested_source_task_id = getattr(args, "source_task_id", None)
    source_run_id = safe_id(requested_source_run_id, "source_run_id") if requested_source_run_id else None
    source_task_id = safe_id(requested_source_task_id, "source_task_id") if requested_source_task_id else None
    if (source_run_id is None) != (source_task_id is None):
        raise Blocker("browser_use_shared_profile_source_binding_incomplete")
    candidates = find_shared_temporary_profiles(
        config,
        account_identity=authority["account_identity"],
        allowed_origins=list(authority["allowed_origins"]),
        requested_origin=getattr(args, "origin", None),
        source_run_id=source_run_id,
        source_task_id=source_task_id,
    )
    if not candidates:
        raise Blocker("browser_use_shared_profile_unavailable")
    if len(candidates) != 1:
        raise Blocker("browser_use_shared_profile_ambiguous")
    candidate = candidates[0]
    profile = candidate["profile"]
    port = int(candidate["port"])
    marker = candidate["marker"]
    lease_id = uuid.uuid4().hex
    nonce = lease_id
    profile_lock = os.path.realpath(temporary_profile_lock_path(config, profile))
    port_lock = os.path.realpath(temporary_port_lock_path(config, port))
    payload = {"schema": "browser-use-lock.v1", "run_id": run_id, "nonce": nonce, "helper_pid": os.getpid(), "helper_start_time": psutil.Process(os.getpid()).create_time(), "automation_id": safe_id(args.automation_id, "automation_id"), "task_id": task_id, "port": port, "canonical_profile": profile, "lifecycle": TEMPORARY_LIFECYCLE, "shared_profile_lease_id": lease_id}
    room: dict[str, Any] | None = None
    try:
        lock_file(profile_lock, payload)
        lock_file(port_lock, payload)
        room = room_registry_claim(config, lifecycle=TEMPORARY_LIFECYCLE, run_id=run_id, profile=profile, port=port, task_id=task_id, automation_id=args.automation_id, activity="shared-claim")
        lease = {
            "schema": SHARED_PROFILE_LEASE_SCHEMA,
            "version": 1,
            "state": "claimed",
            "lease_id": lease_id,
            "run_id": run_id,
            "session": session,
            "task_id": task_id,
            "source_task_id": marker.get("task_id"),
            "creation_binding": marker.get("creation_binding"),
            "profile": profile,
            "port": port,
            "room_id": room["room_id"],
            "lock_paths": [profile_lock, port_lock],
            "nonce": nonce,
            "match_digest": candidate["match_digest"],
            "availability_marker_sha256": candidate["availability_marker_sha256"],
            "authority_path": authority_path,
            "authority_sha256": authority_digest,
            "account_identity_sha256": hashlib.sha256(str(authority["account_identity"]).encode("utf-8")).hexdigest(),
            "profile_owner_automation_id": marker.get("automation_id"),
            "profile_owner_run_id": marker.get("run_id"),
            "profile_owner_authority_sha256": marker.get("authority_sha256"),
            "origins": sorted({normalize_origin(item) for item in marker.get("origins", [])}),
            "profile_owner_authority_scope": marker.get("authority_scope"),
            "profile_marker_sha256": sha256_file(os.path.join(profile, ".browser-use-profile.json")),
            "profile_expires_at": marker.get("expires_at"),
            "issued_at": iso(now_utc()),
            "profile_preserved": True,
            "external_effects": "none",
        }
        lease_path = shared_profile_lease_path(config, lease_id)
        json_atomic_no_replace(lease_path, lease)
    except Exception:
        for lock_path in (port_lock, profile_lock):
            try:
                release_lock(lock_path, run_id, nonce)
            except Exception:
                pass
        if room is not None:
            try:
                room_registry_release(config, room["room_id"], run_id=run_id, activity="shared-claim-rollback")
            except Exception:
                pass
        raise
    print(json.dumps({"status": "shared_profile_claimed", "lease": lease_path, "run_id": run_id, "session": session, "task_id": task_id, "profile": profile, "port": port, "room_id": room["room_id"], "profile_expires_at": marker.get("expires_at"), "profile_preserved": True, "external_effects": "none", "finalized": False}, sort_keys=True))
    return 0


def release_shared_temporary_profile(args: argparse.Namespace) -> int:
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    task_id = safe_id(args.task_id, "task_id")
    lease_hint = read_json_safe(args.lease)
    explicit_authority = bool(args.authority)
    authority_path = args.authority or lease_hint.get("authority_path")
    if not authority_path:
        raise Blocker("browser_use_authority_required")
    if explicit_authority:
        # parse_authority performs the canonical 0600 admission.  Keep this
        # branch compatible with callers that inject a parsed authority in
        # unit tests while preserving production fail-closed behavior.
        authority_path = os.path.realpath(str(authority_path))
    else:
        authority_path = assert_authority_file(str(authority_path))
    authority = parse_authority(authority_path, run_id, session, aliases=session_aliases(config, requested_session, session), require_unexpired=False)
    if lease_hint.get("authority_sha256") and sha256_file(authority_path) != lease_hint["authority_sha256"]:
        raise Blocker("browser_use_shared_profile_authority_changed")
    lease = read_shared_profile_lease(config, args.lease, run_id=run_id, session=session, task_id=task_id, authority=authority, allow_releasing=True)
    paths = [os.path.realpath(str(item)) for item in lease["lock_paths"]]
    released_ok, blocker, released = _release_lock_set(paths, run_id, lease["nonce"])
    if not released_ok:
        raise Blocker(blocker or "browser_use_shared_profile_release_uncertain")
    room = room_registry_release(config, lease["room_id"], run_id=run_id, activity="shared-release")
    lease.pop("_path", None)
    lease.pop("marker", None)
    lease.update({"state": "released", "released_at": iso(now_utc()), "released_locks": released, "room": room, "profile_preserved": True, "external_effects": "none"})
    json_atomic_replace(args.lease, lease)
    print(json.dumps({"status": "shared_profile_released", "lease": os.path.realpath(args.lease), "room": room, "locks_removed": released, "profile_preserved": True, "external_effects": "none", "finalized": True}, sort_keys=True))
    return 0


def publish_retained_temporary_profile(args: argparse.Namespace) -> int:
    """Publish one owner-bound cleanup-complete profile to the shared pool.

    This is a terminal, no-browser-command repair for the handoff path.  It
    exists because retaining a profile and publishing it as claimable are
    separate lifecycle transitions.  The command never copies cookies or
    credentials and refuses unless the exact descriptor proves cleanup,
    effect-free state, owner binding, and an idle room/runtime.
    """
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    task_id = safe_id(args.task_id, "task_id")
    descriptor_path = os.path.realpath(args.descriptor)
    descriptor = read_recording_descriptor(
        config,
        descriptor_path,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_expired_temporary=False,
        allow_stale_runtime_recovery=True,
        allow_history_reconciliation=True,
    )
    require_temporary_task_id(args, descriptor)
    if descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE or descriptor.get("mode") != "authorized":
        raise Blocker("browser_use_temporary_profile_publish_requires_authorized_temporary")
    if descriptor.get("status") not in {"stale", "cleanup_pending", "finalized"} or descriptor.get("cleanup_completed") is not True:
        raise Blocker("browser_use_temporary_profile_publish_requires_cleanup_complete")
    cleanup = descriptor.get("cleanup_state") if isinstance(descriptor.get("cleanup_state"), dict) else {}
    if cleanup.get("profile_preserved") is not True:
        raise Blocker("browser_use_temporary_profile_publish_requires_profile_preserved")
    if cleanup.get("external_effects") not in {None, "none"}:
        raise Blocker("browser_use_temporary_profile_publish_external_effects_not_none")
    if operation_effect_summary(descriptor) != "none":
        raise Blocker("browser_use_temporary_profile_publish_operation_effects_not_none")
    if any(os.path.lexists(path) for path in descriptor.get("lock_paths", [])):
        raise Blocker("browser_use_temporary_profile_publish_locks_remain")
    if cleanup.get("process_absent") is not True or cleanup.get("listener_absent") is not True or cleanup.get("daemon_absent") is not True:
        raise Blocker("browser_use_temporary_profile_publish_runtime_absence_unverified")
    room_id = descriptor.get("room_id")
    room = room_registry_lookup(config, room_id) if room_id else None
    if room is not None and room.get("state") in ROOM_REGISTRY_ACTIVE_STATES:
        raise Blocker("browser_use_temporary_profile_publish_room_not_idle")
    mark_temporary_profile_shareable(config, descriptor)
    print(json.dumps({
        "status": "shared_profile_published",
        "profile_preserved": True,
        "shared_profile_available": True,
        "external_effects": "none",
        "finalized": False,
        "source_run_id": descriptor.get("run_id"),
        "source_task_id": descriptor.get("task_id"),
        "room_state": room.get("state") if room else "absent",
    }, sort_keys=True))
    return 0


def mark_shared_profile_lease_released(config: dict[str, Any], path: str, *, run_id: str, session: str, task_id: str, room: dict[str, Any] | None = None) -> None:
    """Close a shared lease after its process, locks, and room are terminal."""
    lease_path = os.path.realpath(path)
    root = os.path.realpath(shared_profile_lease_root(config))
    if lease_path != path or not lease_path.startswith(root + os.sep):
        raise Blocker("browser_use_shared_profile_lease_scope_mismatch")
    lease = read_json_safe(lease_path)
    if lease.get("schema") != SHARED_PROFILE_LEASE_SCHEMA or lease.get("run_id") != run_id or lease.get("session") != session or lease.get("task_id") != task_id:
        raise Blocker("browser_use_shared_profile_lease_owner_mismatch")
    if lease.get("state") == "released":
        return
    if lease.get("state") not in {"claimed", "releasing"}:
        raise Blocker("browser_use_shared_profile_lease_state_invalid")
    if any(os.path.lexists(str(item)) for item in lease.get("lock_paths", [])):
        raise Blocker("browser_use_shared_profile_lease_locks_remain")
    lease.update({"state": "released", "released_at": iso(now_utc()), "room": room, "profile_preserved": True, "external_effects": "none"})
    json_atomic_replace(lease_path, lease)


def mark_temporary_profile_shareable(config: dict[str, Any], descriptor: dict[str, Any]) -> str:
    """Publish an explicit retained-profile availability marker.

    A temporary profile is not shareable merely because it still exists.  Only
    the explicit stop-preserve lane may publish this marker after runtime and
    lock cleanup, preventing an unauthenticated probe or interrupted launch
    from entering the cross-session pool.
    """
    profile = os.path.realpath(str(descriptor.get("profile") or ""))
    temporary_root = os.path.realpath(config["roots"]["temporary_profiles"])
    if not profile.startswith(temporary_root + os.sep) or not os.path.isdir(profile):
        raise Blocker("browser_use_shared_profile_availability_profile_invalid")
    marker_path = os.path.join(profile, ".browser-use-profile.json")
    marker = read_json_safe(marker_path)
    validate_temporary_marker(config, profile, _shared_profile_marker_expected(marker), require_unexpired=True)
    # Publishing a profile for cross-session borrowing is an explicit
    # retention decision. Convert the short run TTL into manual retention only
    # after the caller has already stopped the owned browser and released its
    # runtime locks. The marker mutation makes the choice durable and keeps
    # the janitor from silently deleting a logged-in profile later.
    if any(os.path.lexists(path) for path in (marker.get("profile_lock_path"), marker.get("port_lock_path"))):
        raise Blocker("browser_use_shared_profile_availability_runtime_not_idle")
    if port_listener(int(marker["port"])) or lsof_listener(int(marker["port"])):
        raise Blocker("browser_use_shared_profile_availability_runtime_not_idle")
    if marker.get("retention_mode", TEMPORARY_RETENTION_RUN_TTL) != TEMPORARY_RETENTION_MANUAL:
        retained = dict(marker)
        retained["retention_mode"] = TEMPORARY_RETENTION_MANUAL
        retained["expires_at"] = None
        json_atomic_replace(marker_path, retained)
        marker = read_json_safe(marker_path)
        validate_temporary_marker(config, profile, _shared_profile_marker_expected(marker), require_unexpired=True)
    availability_path = shared_profile_availability_path(profile)
    value = {
        "schema": SHARED_PROFILE_AVAILABILITY_SCHEMA,
        "version": 1,
        "status": "available",
        "canonical_profile": profile,
        "creation_binding": marker.get("creation_binding"),
        "port": marker.get("port"),
        "source_task_id": marker.get("task_id"),
        "account_identity_sha256": hashlib.sha256(str(marker.get("account_identity")).encode("utf-8")).hexdigest(),
        "origins": sorted({normalize_origin(item) for item in marker.get("origins", [])}),
        "profile_marker_sha256": sha256_file(marker_path),
        "expires_at": marker.get("expires_at"),
        "retention_mode": marker.get("retention_mode", TEMPORARY_RETENTION_RUN_TTL),
        "enabled_at": iso(now_utc()),
        "external_effects": "none",
    }
    if os.path.lexists(availability_path):
        existing = read_json_safe(availability_path)
        immutable_fields = {key for key in value if key != "enabled_at"}
        if any(existing.get(key) != value.get(key) for key in immutable_fields):
            raise Blocker("browser_use_shared_profile_availability_binding_mismatch")
        # Publishing the same retained profile again is an idempotent
        # lifecycle retry.  Preserve the first publication timestamp instead
        # of treating a harmless clock change as a binding conflict.
        value = existing
    else:
        json_atomic_no_replace(availability_path, value)
    return availability_path


def prepare_temporary_profile(
    config: dict[str, Any],
    *,
    mode: str,
    automation_id: str,
    task_id: str,
    run_id: str,
    authority_digest: str,
    authority_scope: dict[str, Any],
    account_identity: str,
    origins: list[str],
    download_dir: str,
    requested_port: int | None = None,
) -> dict[str, Any]:
    if mode != "authorized":
        raise Blocker("browser_use_temporary_requires_authorized_mode")
    task_id = safe_id(task_id, "task_id")
    binding = temporary_binding(mode=mode, lifecycle=TEMPORARY_LIFECYCLE, automation_id=automation_id, task_id=task_id, run_id=run_id, authority_digest=authority_digest, authority_scope=authority_scope, account_identity=account_identity, origins=origins)
    profile = temporary_profile_path(config, binding)
    port = requested_port if requested_port is not None else temporary_port(config, binding)
    if requested_port is not None and requested_port != port:
        raise Blocker("browser_use_temporary_fixed_port_mismatch")
    profile_lock = temporary_profile_lock_path(config, profile)
    payload = {"schema": "browser-use-lock.v1", "run_id": run_id, "nonce": binding, "helper_pid": os.getpid(), "helper_start_time": psutil.Process(os.getpid()).create_time(), "automation_id": automation_id, "task_id": task_id, "port": port, "canonical_profile": profile, "lifecycle": TEMPORARY_LIFECYCLE}
    lock_file(profile_lock, payload)
    try:
        assert_directory(os.path.dirname(profile), create=True)
        if os.path.lexists(profile):
            if os.path.islink(profile):
                raise Blocker("browser_use_temporary_profile_symlink")
            expected = temporary_marker_value(config, profile=profile, mode=mode, automation_id=automation_id, task_id=task_id, run_id=run_id, binding=binding, port=port, authority_digest=authority_digest, authority_scope=authority_scope, account_identity=account_identity, origins=origins, created_at="1970-01-01T00:00:00Z")
            marker_path = os.path.join(profile, ".browser-use-profile.json")
            existing = read_json_safe(marker_path) if os.path.lexists(marker_path) else {}
            expected.update({"created_at": existing.get("created_at"), "expires_at": existing.get("expires_at")})
            validate_temporary_marker(config, profile, expected)
        else:
            os.mkdir(profile, 0o700)
            created_at = iso(now_utc())
            marker = temporary_marker_value(config, profile=profile, mode=mode, automation_id=automation_id, task_id=task_id, run_id=run_id, binding=binding, port=port, authority_digest=authority_digest, authority_scope=authority_scope, account_identity=account_identity, origins=origins, created_at=created_at)
            json_atomic_no_replace(os.path.join(profile, ".browser-use-profile.json"), marker)
            assert_directory(os.path.join(profile, "Default"), create=True)
            json_atomic_no_replace(os.path.join(profile, "Default", "Preferences"), {"download": {"default_directory": download_dir, "prompt_for_download": False, "directory_upgrade": True}})
        marker = validate_temporary_marker(config, profile, temporary_marker_value(config, profile=profile, mode=mode, automation_id=automation_id, task_id=task_id, run_id=run_id, binding=binding, port=port, authority_digest=authority_digest, authority_scope=authority_scope, account_identity=account_identity, origins=origins, created_at=read_json_safe(os.path.join(profile, ".browser-use-profile.json"))["created_at"]))
        return {"profile": profile, "binding": binding, "port": port, "profile_lock": profile_lock, "marker": marker}
    except Exception:
        try:
            release_lock(profile_lock, run_id, binding)
        except Exception:
            pass
        raise


def prepare_profile(profile: str, scheduled: bool, automation_id: str, download_dir: str, run_id: str, nonce: str) -> None:
    parent = os.path.dirname(profile)
    assert_directory(parent, create=True)
    if not scheduled and os.path.lexists(profile):
        raise Blocker("browser_use_single_use_profile_already_exists")
    if scheduled and os.path.lexists(profile):
        if os.path.islink(profile):
            raise Blocker("browser_use_profile_symlink")
        assert_directory(profile)
    else:
        try:
            os.mkdir(profile, 0o700)
        except FileExistsError as exc:
            raise Blocker("browser_use_single_use_profile_already_exists") from exc
    assert_directory(profile)
    default_dir = os.path.join(profile, "Default")
    assert_directory(default_dir, create=True)
    marker = os.path.join(profile, ".browser-use-profile.json")
    marker_value = {"schema": "browser-use-profile.v1", "automation_id": automation_id, "run_id": run_id if not scheduled else "persistent", "nonce": nonce if not scheduled else "persistent"}
    if os.path.exists(marker):
        existing = read_json_safe(marker)
        if existing.get("automation_id") != automation_id:
            raise Blocker("browser_use_profile_automation_mismatch")
    else:
        json_atomic_no_replace(marker, marker_value)
    preferences = os.path.join(default_dir, "Preferences")
    if not os.path.exists(preferences):
        json_atomic_no_replace(preferences, {"download": {"default_directory": download_dir, "prompt_for_download": False, "directory_upgrade": True}})
    else:
        assert_regular_file(preferences, mode=0o600)


def process_matches(process: Any, chrome_path: str, port: int, profile: str) -> bool:
    try:
        if not process.is_running():
            return False
        command_line = process.cmdline()
        required = {
            "--remote-debugging-address=127.0.0.1",
            f"--remote-debugging-port={port}",
            f"--user-data-dir={profile}",
            "--profile-directory=Default",
        }
        return chrome_path in command_line and required.issubset(set(command_line))
    except (psutil.Error, OSError):
        return False


def launch_chrome(config: dict[str, Any], profile: str, port: int, download_dir: str, home: str) -> tuple[subprocess.Popen[bytes], dict[str, Any]]:
    chrome = config["executables"]["chrome"]["canonical_path"]
    if port_listener(port) or lsof_listener(port):
        raise Blocker("browser_use_port_already_listening", str(port))
    args = [chrome, "--remote-debugging-address=127.0.0.1", f"--remote-debugging-port={port}", f"--user-data-dir={profile}", "--profile-directory=Default", f"--download-default-directory={download_dir}", "--no-first-run", "--no-default-browser-check"]
    started_at = time.time()
    proc = subprocess.Popen(
        args,
        cwd=home,
        env=make_env(home),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        close_fds=True,
        start_new_session=True,
    )
    root_start = psutil.Process(proc.pid).create_time()
    deadline = time.monotonic() + 30
    matched: Any = None
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            raise Blocker("browser_use_chrome_exited_before_attach")
        if port_listener(port) and lsof_listener(port):
            try:
                root = psutil.Process(proc.pid)
                candidates = [root] + root.children(recursive=True)
                matched = next((candidate for candidate in candidates if process_matches(candidate, chrome, port, profile) and candidate.create_time() >= started_at - 1), None)
            except psutil.Error:
                matched = None
            if matched is not None:
                return proc, {"pid": matched.pid, "start_time": matched.create_time(), "root_pid": proc.pid, "root_start_time": root_start}
        time.sleep(0.25)
    raise Blocker("browser_use_chrome_process_identity_unverified")


def terminate_chrome(proc: subprocess.Popen[bytes] | None, identity: dict[str, Any] | None, chrome_path: str, port: int, profile: str) -> tuple[bool, str | None]:
    if identity is None:
        return False, "browser_use_process_identity_unavailable"
    try:
        candidate = psutil.Process(identity["root_pid"])
        if abs(candidate.create_time() - identity["root_start_time"]) > 0.5 or not process_matches(candidate, chrome_path, port, profile):
            return False, "browser_use_unknown_process_not_killed"
        candidate.terminate()
        try:
            candidate.wait(timeout=10)
        except psutil.TimeoutExpired:
            # Chrome may keep the remote-debugging process alive after a
            # graceful SIGTERM.  Escalate only after revalidating the exact
            # PID, start time, executable, port, and profile binding; an
            # unknown or replaced process remains fail-closed.
            try:
                rechecked = psutil.Process(identity["root_pid"])
                if abs(rechecked.create_time() - identity["root_start_time"]) > 0.5 or not process_matches(rechecked, chrome_path, port, profile):
                    return False, "browser_use_unknown_process_not_killed"
                rechecked.kill()
                rechecked.wait(timeout=10)
            except psutil.TimeoutExpired:
                return False, "browser_use_chrome_did_not_exit"
            except psutil.NoSuchProcess:
                pass
            except psutil.Error:
                return False, "browser_use_process_identity_recheck_failed"
    except psutil.NoSuchProcess:
        pass
    except psutil.Error:
        return False, "browser_use_process_identity_recheck_failed"
    try:
        assert_debug_listener_absent(port)
    except Blocker as exc:
        return False, exc.code
    return True, None


def verify_chrome_absent(chrome_path: str, port: int, profile: str) -> None:
    """Prove that a failed launch left no matching process or listener.

    A launch can fail before ``launch_chrome`` returns its process identity.
    In that case there is no verified process object that this helper may
    terminate.  We may still complete cleanup when two independent checks
    prove that the exact run-owned profile/port has no matching Chrome
    process and no listener.  A matching process is never killed here; it is
    reported as uncertain for the lifecycle owner to resolve.
    """
    if psutil is None:
        raise Blocker("browser_use_process_identity_recheck_failed")
    try:
        candidates = psutil.process_iter()
        for candidate in candidates:
            try:
                if process_matches(candidate, chrome_path, port, profile):
                    raise Blocker("browser_use_chrome_process_cleanup_unverified")
            except psutil.NoSuchProcess:
                continue
            except psutil.AccessDenied as exc:
                raise Blocker("browser_use_process_identity_recheck_failed") from exc
            except psutil.Error as exc:
                raise Blocker("browser_use_process_identity_recheck_failed") from exc
    except Blocker:
        raise
    except psutil.Error as exc:
        raise Blocker("browser_use_process_identity_recheck_failed") from exc
    assert_debug_listener_absent(port)


def close_owned_daemon_if_active(config: dict[str, Any], home: str, port: int, session: str) -> tuple[bool, str | None]:
    """Close only the daemon proven to belong to this helper session.

    Browser Use stores a pid and Unix socket under its dedicated home. On an
    error path, Chrome can be cleaned up while the daemon remains alive. Never
    kill an unverified process; ask the matching daemon to close and verify its
    markers disappear instead.
    """
    if browser_harness_cli_enabled():
        try:
            result = run_browser_harness_reload(config, home, port, session)
        except (OSError, subprocess.SubprocessError):
            return False, "browser_use_daemon_close_failed"
        if result.returncode != 0:
            return False, "browser_use_daemon_close_failed"
        runtime = os.path.join(browser_harness_root(session), "runtime")
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            if not any(os.path.lexists(os.path.join(runtime, name)) for name in ("bu.sock", "bu.pid", "bu.port")):
                return (True, None) if cleanup_browser_harness_root(session) else (False, "browser_use_harness_root_cleanup_unverified")
            time.sleep(0.1)
        return False, "browser_use_daemon_cleanup_unverified"

    raise Blocker("browser_use_legacy_cli_protocol_rejected")


RECORDING_STATE_READBACK_RETRY_DELAYS_SECONDS = (0.25, 0.5, 1.0)


def _recording_state_readback_with_retry(browser: str, env: dict[str, str], cwd: str, *, capture_stderr: bool, command_name: str) -> tuple[int, str]:
    """Retry only the read-only state probe after a command dispatch.

    Upload and other effectful commands are dispatched exactly once by the
    caller.  The Browser Harness can briefly reject the immediate follow-up
    state probe while the page is processing the input; retrying this probe
    does not replay or infer the original effect.
    """
    last_stderr = ""
    attempts = len(RECORDING_STATE_READBACK_RETRY_DELAYS_SECONDS) + 1
    for attempt in range(attempts):
        if attempt:
            time.sleep(RECORDING_STATE_READBACK_RETRY_DELAYS_SECONDS[attempt - 1])
        try:
            check = subprocess.run(
                [browser],
                input=browser_harness_script(["state"]),
                cwd=cwd,
                env=env,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE if capture_stderr else subprocess.DEVNULL,
                text=True,
                timeout=120,
            )
        except (OSError, subprocess.SubprocessError):
            check = None
        if check is None:
            last_stderr = ""
            logging.critical("browser_use_cli3_readback_failed command=%s attempt=%s/%s", command_name, attempt + 1, attempts)
            continue
        last_stderr = check.stderr or ""
        if check.returncode == 0:
            return 0, last_stderr
        logging.critical(
            "browser_use_cli3_readback_failed command=%s returncode=%s attempt=%s/%s marker=%s",
            command_name,
            check.returncode,
            attempt + 1,
            attempts,
            recording_cli_failure_marker(last_stderr),
        )
    return 1, last_stderr


def run_cli3_session(config: dict[str, Any], home: str, port: int, session: str, command: list[str], readback: bool, *, close_after: bool, recording: dict[str, Any] | None = None, diagnostic: bool = False) -> tuple[int, int | None]:
    global _LAST_RECORDING_CLI_FAILURE, _LAST_CLI_FAILURE
    if recording is not None:
        _LAST_RECORDING_CLI_FAILURE = ""
    if diagnostic:
        _LAST_CLI_FAILURE = ""
    if command[0] == "close":
        close_result = run_browser_harness_reload(config, home, port, session)
        if close_result.returncode == 0 and not cleanup_browser_harness_root(session):
            close_result.returncode = 1
        return close_result.returncode, None
    browser = config["executables"]["browser_use"]["canonical_path"]
    capture = recording is not None or diagnostic
    try:
        result = subprocess.run(
            [browser],
            input=browser_harness_script(command),
            cwd=home,
            env=browser_harness_env(home, port, session, recording),
            stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
            stderr=subprocess.PIPE if capture else subprocess.DEVNULL,
            text=True,
            timeout=180,
        )
    except (OSError, subprocess.SubprocessError):
        if recording is not None:
            _LAST_RECORDING_CLI_FAILURE = "browser_use_cli3_launch_failed"
        if diagnostic:
            _LAST_CLI_FAILURE = "browser_use_cli3_launch_failed"
        return 1, 1 if readback else None
    if result.returncode != 0:
        marker = recording_cli_failure_marker(result.stderr or "")
        logging.critical("browser_use_cli3_failed command=%s returncode=%s marker=%s", command[0], result.returncode, marker)
        if recording is not None:
            _LAST_RECORDING_CLI_FAILURE = marker
        if diagnostic:
            _LAST_CLI_FAILURE = marker
    readback_exit: int | None = None
    # ``state`` is itself the required post-command readback.  Running a
    # second identical state command only adds one Browser Harness process
    # startup to every state probe and cannot provide fresher evidence than
    # the command that just returned successfully.  Keep the command's
    # dispatch result as its readback result so callers do not interpret the
    # intentionally skipped second probe (None) as a failure.
    if command == ["state"]:
        readback_exit = result.returncode
    elif readback and command[0] not in {"close", "close-tab"}:
        readback_exit, readback_stderr = _recording_state_readback_with_retry(
            browser,
            browser_harness_env(home, port, session, recording),
            home,
            capture_stderr=capture,
            command_name=command[0],
        )
        if readback_exit != 0 and diagnostic and not _LAST_CLI_FAILURE:
            _LAST_CLI_FAILURE = recording_cli_failure_marker(readback_stderr) or "browser_use_cli3_readback_failed"
    if close_after:
        close_result = run_browser_harness_reload(config, home, port, session)
        if result.returncode == 0 and close_result.returncode != 0:
            result.returncode = close_result.returncode
        if result.returncode == 0 and close_result.returncode == 0 and not cleanup_browser_harness_root(session):
            result.returncode = 1
    return result.returncode, readback_exit


def run_cli_session(config: dict[str, Any], home: str, port: int, session: str, command: list[str], readback: bool, *, close_after: bool, recording: dict[str, Any] | None = None, diagnostic: bool = False) -> tuple[int, int | None]:
    browser_harness_cli_enabled()
    return run_cli3_session(config, home, port, session, command, readback, close_after=close_after, recording=recording, diagnostic=diagnostic)


def run_cli(config: dict[str, Any], home: str, port: int, session: str, command: list[str], readback: bool, *, recording: dict[str, Any] | None = None, diagnostic: bool = False) -> tuple[int, int | None]:
    return run_cli_session(config, home, port, session, command, readback, close_after=True, recording=recording, diagnostic=diagnostic)


def run_cli3_with_post_commands(config: dict[str, Any], home: str, port: int, session: str, command: list[str], readback: bool, post_commands: list[list[str]], *, recording: dict[str, Any] | None = None) -> tuple[int, int | None, dict[str, str]]:
    browser = config["executables"]["browser_use"]["canonical_path"]
    env = browser_harness_env(home, port, session, recording)
    result = subprocess.run(
        [browser],
        input=browser_harness_script(command),
        cwd=home,
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=180,
    )
    if result.returncode != 0:
        logging.critical("browser_use_cli3_post_command_failed command=%s returncode=%s marker=%s", command[0], result.returncode, recording_cli_failure_marker(result.stderr or ""))
    captured: dict[str, str] = {}
    if result.returncode == 0:
        for index, post_command in enumerate(post_commands):
            post_result = subprocess.run(
                [browser],
                input=browser_harness_script(post_command),
                cwd=home,
                env=env,
                stdout=subprocess.PIPE if post_command[0] in {"state", "get", "eval", "extract"} else subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=120,
            )
            if post_command[0] in {"state", "get", "eval", "extract"}:
                captured[str(index)] = (post_result.stdout or "")[-65536:]
            if post_result.returncode != 0:
                logging.critical("browser_use_cli3_post_readback_failed command=%s returncode=%s marker=%s", post_command[0], post_result.returncode, recording_cli_failure_marker(post_result.stderr or ""))
                result.returncode = post_result.returncode
                break
    readback_exit: int | None = None
    if readback and command[0] not in {"close", "close-tab"} and command != ["state"]:
        check = subprocess.run(
            [browser],
            input=browser_harness_script(["state"]),
            cwd=home,
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=120,
        )
        readback_exit = check.returncode
        if check.returncode != 0:
            logging.critical("browser_use_cli3_post_state_failed command=%s returncode=%s marker=%s", command[0], check.returncode, recording_cli_failure_marker(check.stderr or ""))
    close_result = run_browser_harness_reload(config, home, port, session)
    if result.returncode == 0 and close_result.returncode != 0:
        result.returncode = close_result.returncode
    if result.returncode == 0 and close_result.returncode == 0 and not cleanup_browser_harness_root(session):
        result.returncode = 1
    return result.returncode, readback_exit, captured


def run_cli_with_post_commands(config: dict[str, Any], home: str, port: int, session: str, command: list[str], readback: bool, post_commands: list[list[str]], *, recording: dict[str, Any] | None = None) -> tuple[int, int | None, dict[str, str]]:
    browser_harness_cli_enabled()
    return run_cli3_with_post_commands(config, home, port, session, command, readback, post_commands, recording=recording)


def run_cli_keep_alive(config: dict[str, Any], home: str, port: int, session: str, command: list[str], readback: bool, *, recording: dict[str, Any] | None = None, diagnostic: bool = False) -> tuple[int, int | None]:
    return run_cli_session(config, home, port, session, command, readback, close_after=False, recording=recording, diagnostic=diagnostic)


def _record_batch_frame_paths(source_dir: str, count: int) -> list[dict[str, str]]:
    source_root = os.path.realpath(source_dir)
    if not source_root or not os.path.isdir(source_root) or count < 1 or count > 8:
        raise Blocker("browser_use_record_batch_frame_scope_invalid")
    existing = [int(path.stem) for path in pathlib.Path(source_root).glob("*.jpg") if path.stem.isdigit()]
    next_number = max(existing, default=0) + 1
    result: list[dict[str, str]] = []
    for _index in range(count):
        while os.path.lexists(os.path.join(source_root, f"{next_number:04d}.jpg")):
            next_number += 1
        result.append({
            "frame_path": os.path.join(source_root, f"{next_number:04d}.jpg"),
            "capture_path": os.path.join(source_root, f".batch-capture-{next_number:04d}-{uuid.uuid4().hex}.png"),
        })
        next_number += 1
    return result


def _cleanup_record_batch_transport_paths(source_dir: str) -> dict[str, Any]:
    """Remove only hidden temporary files owned by this batch transport.

    A failed child process can leave the PNGs allocated for the batch behind.
    The cleanup is deliberately name- and directory-scoped: logical requested
    screenshots and numeric recording frames remain available for diagnosis.
    """
    root = os.path.realpath(str(source_dir or ""))
    if not root or not os.path.isdir(root):
        return {"removed": [], "failed": []}
    prefixes = (".batch-capture-", ".batch-command-capture-")
    removed: list[str] = []
    failed: list[str] = []
    for candidate in sorted(pathlib.Path(root).iterdir()):
        path = os.path.realpath(str(candidate))
        if path != str(candidate) or not path.startswith(root + os.sep) or not candidate.is_file():
            continue
        if not candidate.name.startswith(prefixes):
            continue
        try:
            os.unlink(path)
            removed.append(path)
        except FileNotFoundError:
            pass
        except OSError:
            failed.append(path)
    if failed:
        raise Blocker("browser_use_record_batch_transport_cleanup_failed", str(len(failed)))
    return {"removed": removed, "failed": failed}


def run_cli3_record_batch_transport(
    config: dict[str, Any],
    home: str,
    port: int,
    session: str,
    commands: list[list[str]],
    *,
    recording: dict[str, Any],
) -> dict[str, Any]:
    """Execute the bounded read-only batch in exactly one Browser Use process."""
    global _LAST_RECORDING_CLI_FAILURE
    _LAST_RECORDING_CLI_FAILURE = ""
    source_dir = os.path.realpath(str(recording.get("recording_source_dir") or ""))
    frame_paths = _record_batch_frame_paths(source_dir, len(commands))
    execution_commands: list[list[str]] = []
    screenshot_bindings: dict[str, dict[str, str]] = {}
    for command in commands:
        if command and command[0] == "screenshot":
            source_path = os.path.join(source_dir, f".batch-command-capture-{uuid.uuid4().hex}.png")
            execution_command = ["screenshot", source_path]
            logical_digest = hashlib.sha256(json.dumps(command, ensure_ascii=True, separators=(",", ":")).encode("utf-8")).hexdigest()
            screenshot_bindings[logical_digest] = {"source_path": source_path, "target_path": os.path.realpath(command[1])}
            execution_commands.append(execution_command)
        else:
            execution_commands.append(list(command))
    browser = config["executables"]["browser_use"]["canonical_path"]
    env = browser_harness_env(home, port, session, recording)
    try:
        result = subprocess.run(
            [browser],
            input=browser_harness_batch_script(execution_commands, [item["capture_path"] for item in frame_paths]),
            cwd=home,
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=max(180, 30 * len(commands) + 60),
        )
    except (OSError, subprocess.SubprocessError) as exc:
        _LAST_RECORDING_CLI_FAILURE = "browser_use_record_batch_transport_launch_failed"
        raise Blocker(_LAST_RECORDING_CLI_FAILURE) from exc
    payload = _last_json_object(result.stdout or "")
    if result.returncode != 0:
        _LAST_RECORDING_CLI_FAILURE = recording_cli_failure_marker(result.stderr or "") or "browser_use_record_batch_transport_failed"
        raise Blocker("browser_use_record_batch_transport_failed", _LAST_RECORDING_CLI_FAILURE)
    if not isinstance(payload, dict) or payload.get("status") != "completed" or payload.get("transport") != "single_browser_use_process":
        raise Blocker("browser_use_record_batch_transport_result_invalid")
    results = payload.get("results")
    if not isinstance(results, list):
        raise Blocker("browser_use_record_batch_transport_result_invalid")
    expected: list[tuple[str, int, list[str], list[str], str | None]] = []
    for index, command in enumerate(commands):
        expected.append(("command", index, command, execution_commands[index], None))
        if command != ["state"]:
            expected.append(("post-state", index, ["state"], ["state"], None))
        if command and command[0] in {"open", "back", "switch"}:
            expected.append(("navigation-url", index, ["get", "url"], ["get", "url"], None))
            expected.append(("navigation-probe", index, ["eval", "JSON.stringify({url:location.href,ready_state:document.readyState})"], ["eval", "JSON.stringify({url:location.href,ready_state:document.readyState})"], None))
        frame_command = ["screenshot", frame_paths[index]["capture_path"]]
        expected.append(("frame", index, frame_command, frame_command, frame_paths[index]["capture_path"]))
    if len(results) != len(expected):
        raise Blocker("browser_use_record_batch_transport_result_count_invalid")
    capture_queue: list[dict[str, Any]] = []
    frame_queue: list[dict[str, str]] = []
    for entry, (kind, index, logical_command, execution_command, capture_path) in zip(results, expected):
        if not isinstance(entry, dict) or entry.get("kind") != kind or int(entry.get("index", -1)) != index:
            raise Blocker("browser_use_record_batch_transport_result_order_invalid")
        execution_digest = hashlib.sha256(json.dumps(execution_command, ensure_ascii=True, separators=(",", ":")).encode("utf-8")).hexdigest()
        if entry.get("command_digest") != execution_digest:
            raise Blocker("browser_use_record_batch_transport_result_binding_invalid")
        if kind in {"command", "navigation-url", "navigation-probe"}:
            stdout = entry.get("stdout")
            if not isinstance(stdout, str) or not stdout:
                raise Blocker("browser_use_record_batch_transport_capture_missing")
            logical_digest = hashlib.sha256(json.dumps(logical_command, ensure_ascii=True, separators=(",", ":")).encode("utf-8")).hexdigest()
            queue_item: dict[str, Any] = {"command_digest": logical_digest, "code": 0, "readback_exit": 0, "stdout": stdout}
            if kind == "command" and logical_digest in screenshot_bindings:
                queue_item.update(screenshot_bindings[logical_digest])
            capture_queue.append(queue_item)
        elif kind == "frame":
            if capture_path != entry.get("capture_path"):
                raise Blocker("browser_use_record_batch_transport_frame_binding_invalid")
            frame_queue.append({"frame_path": frame_paths[index]["frame_path"], "capture_path": frame_paths[index]["capture_path"]})
    return {
        "capture_queue": capture_queue,
        "frame_queue": frame_queue,
        "transport": "single_browser_use_process",
        "browser_process_count": 1,
        "job_count": len(expected),
        "logical_command_count": len(commands),
    }


def run_cli3_keep_alive_capture(config: dict[str, Any], home: str, port: int, session: str, command: list[str], *, recording: dict[str, Any] | None = None) -> tuple[int, int | None, str]:
    global _LAST_RECORDING_CLI_FAILURE
    transport = _RECORD_BATCH_TRANSPORT
    if transport is not None:
        queue = transport.get("capture_queue")
        if not isinstance(queue, list) or not queue:
            _LAST_RECORDING_CLI_FAILURE = "browser_use_record_batch_capture_queue_exhausted"
            return 1, 1, ""
        item = queue.pop(0)
        expected = hashlib.sha256(json.dumps(command, ensure_ascii=True, separators=(",", ":")).encode("utf-8")).hexdigest()
        if not isinstance(item, dict) or item.get("command_digest") != expected:
            _LAST_RECORDING_CLI_FAILURE = "browser_use_record_batch_capture_binding_invalid"
            return 1, 1, ""
        source_path = item.get("source_path")
        target_path = item.get("target_path")
        stdout = str(item.get("stdout") or "")
        if command and command[0] == "screenshot" and source_path and target_path:
            source_real = os.path.realpath(str(source_path))
            target_real = os.path.realpath(str(target_path))
            if source_real != source_path or target_real != target_path or not target_real.startswith(os.path.realpath(str(recording.get("recording_dir") or "")) + os.sep):
                _LAST_RECORDING_CLI_FAILURE = "browser_use_record_batch_screenshot_scope_invalid"
                return 1, 1, ""
            if os.path.lexists(target_real):
                _LAST_RECORDING_CLI_FAILURE = "browser_use_capture_path_already_exists"
                return 1, 1, ""
            if not os.path.lexists(source_real):
                _LAST_RECORDING_CLI_FAILURE = "browser_use_record_batch_screenshot_capture_missing"
                return 1, 1, ""
            try:
                os.replace(source_real, target_real)
            except OSError:
                _LAST_RECORDING_CLI_FAILURE = "browser_use_record_batch_screenshot_move_failed"
                return 1, 1, ""
            stdout = stdout.replace(source_real, target_real)
        _LAST_RECORDING_CLI_FAILURE = ""
        return int(item.get("code", 1)), int(item.get("readback_exit", 1)), stdout
    _LAST_RECORDING_CLI_FAILURE = ""
    browser = config["executables"]["browser_use"]["canonical_path"]
    env = browser_harness_env(home, port, session, recording)
    script_builder = browser_harness_ax_script if command and command[0] in {"ax-inspect", "ax-click"} else browser_harness_script
    try:
        result = subprocess.run(
            [browser],
            input=script_builder(command),
            cwd=home,
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=180,
        )
    except (OSError, subprocess.SubprocessError):
        _LAST_RECORDING_CLI_FAILURE = "browser_use_cli3_capture_failed"
        return 1, 1, ""
    if result.returncode != 0:
        _LAST_RECORDING_CLI_FAILURE = recording_cli_failure_marker(result.stderr or "")
    if command == ["state"]:
        readback_exit = result.returncode
    else:
        readback_exit, readback_stderr = _recording_state_readback_with_retry(
            browser,
            env,
            cwd=home,
            capture_stderr=True,
            command_name=command[0],
        )
        if readback_exit != 0 and not _LAST_RECORDING_CLI_FAILURE:
            _LAST_RECORDING_CLI_FAILURE = recording_cli_failure_marker(readback_stderr) or "browser_use_cli3_capture_readback_failed"
    # CLI 3.0 state is a fresh DOM snapshot. Keep enough transient output to
    # parse the JSON envelope without persisting it; the caller still emits
    # only hashed/non-secret target metadata into durable receipts.
    return result.returncode, readback_exit, (result.stdout or "")[-524288:]


def run_cli_keep_alive_capture(config: dict[str, Any], home: str, port: int, session: str, command: list[str], *, recording: dict[str, Any] | None = None) -> tuple[int, int | None, str]:
    browser_harness_cli_enabled()
    return run_cli3_keep_alive_capture(config, home, port, session, command, recording=recording)


def _plain_capture_response(command: list[str], stdout: str) -> dict[str, Any]:
    """Normalize safe non-JSON CLI output for the existing readback parsers."""
    text = str(stdout or "")
    if command == ["state"]:
        return {"success": True, "data": {"_raw_text": text}}
    if len(command) == 3 and command[0] == "get" and command[1] in {"attributes", "bbox"}:
        field = command[1]
        match = re.search(rf"(?m)^{re.escape(field)}:\s*(.+)$", text)
        if match:
            try:
                value = ast.literal_eval(match.group(1).strip())
            except (SyntaxError, ValueError):
                value = None
            if isinstance(value, dict):
                return {"success": True, "data": {"index": int(command[2]), field: value}}
    return {"success": True, "data": {"_raw_text": text}}


P5_PUBLIC_ORIGIN = "https://example.com"
P5_PUBLIC_URL = "https://example.com/"
P5_PUBLIC_TITLE = "Example Domain"
P5_PUBLIC_TITLE_SHA256 = hashlib.sha256(P5_PUBLIC_TITLE.encode("utf-8")).hexdigest()


def _json_values(value: Any):
    yield value
    if isinstance(value, dict):
        for child in value.values():
            yield from _json_values(child)
    elif isinstance(value, list):
        for child in value:
            yield from _json_values(child)


def _first_field(value: Any, names: set[str]) -> Any:
    for child in _json_values(value):
        if isinstance(child, dict):
            for key, item in child.items():
                if str(key).lower() in names:
                    return item
    return None


def _parse_cli_json(stdout: str) -> Any:
    candidates: list[Any] = []
    for line in str(stdout or "").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            candidates.append(json.loads(line))
        except (TypeError, ValueError, json.JSONDecodeError):
            continue
    if not candidates:
        raise Blocker("browser_use_semantic_readback_json_missing")
    return candidates[-1]


# Target resolution is intentionally implemented at the canonical helper
# boundary.  Browser Use element indexes are fresh-state scoped, so callers
# must never persist or replay an index from an earlier state snapshot.
_STATE_ELEMENT_RE = re.compile(
    r"^(?P<indent>\s*)\[(?P<index>\d+)\]<(?P<tag>[A-Za-z][A-Za-z0-9:_-]*)"
    r"(?P<attrs>[^>]*)>?(?P<inline>.*)$"
)
_STATE_ATTRIBUTE_RE = re.compile(
    r"(?P<name>[A-Za-z_:][A-Za-z0-9_.:-]*)"
    r"(?:\s*=\s*(?:\"(?P<double>[^\"]*)\"|'(?P<single>[^']*)'|(?P<bare>[^\s>]+)))?"
)
_INTERACTIVE_TAGS = {"a", "button", "input", "select", "textarea", "summary"}
_INTERACTIVE_ROLES = {
    "button",
    "checkbox",
    "combobox",
    "link",
    "menuitem",
    "option",
    "radio",
    "switch",
    "tab",
    "textbox",
}


def _state_text_from_cli(parsed: Any) -> str:
    """Extract only the transient state text needed for target resolution."""
    for value in _json_values(parsed):
        if isinstance(value, str) and re.search(r"\[\d+\]<[A-Za-z]", value):
            return value
    raise Blocker("browser_use_target_state_shape_invalid")


def _state_attr_map(raw: str) -> dict[str, str]:
    attrs: dict[str, str] = {}
    for match in _STATE_ATTRIBUTE_RE.finditer(raw or ""):
        name = match.group("name").lower()
        value = match.group("double")
        if value is None:
            value = match.group("single")
        if value is None:
            value = match.group("bare")
        attrs[name] = "" if value is None else value
    return attrs


def _state_candidates(state_text: str, target_text: str) -> list[dict[str, Any]]:
    """Return fresh candidates without retaining page text in durable state."""
    normalized_target = " ".join(str(target_text).split()).casefold()
    if not normalized_target:
        raise Blocker("browser_use_target_text_missing")
    semantic_query: tuple[str, str] | None = None
    if normalized_target.startswith("__semantic__:"):
        query = normalized_target[len("__semantic__:"):]
        if "=" not in query:
            raise Blocker("browser_use_target_semantic_query_invalid")
        attribute, expected = (part.strip() for part in query.split("=", 1))
        if attribute not in {"tag", "role", "type"} or not expected:
            raise Blocker("browser_use_target_semantic_query_invalid")
        semantic_query = (attribute, expected)
    lines = str(state_text).splitlines()
    elements: list[dict[str, Any]] = []
    for line_no, line in enumerate(lines):
        match = _STATE_ELEMENT_RE.match(line)
        if not match:
            continue
        indent = len(match.group("indent").replace("\t", "    "))
        inline = match.group("inline").strip()
        elements.append(
            {
                "line_no": line_no,
                "indent": indent,
                "index": int(match.group("index")),
                "tag": match.group("tag").lower(),
                "attributes": _state_attr_map(match.group("attrs")),
                "inline": inline,
            }
        )
    matches: list[dict[str, Any]] = []
    for position, candidate in enumerate(elements):
        end = len(lines)
        for following in elements[position + 1 :]:
            if following["indent"] <= candidate["indent"]:
                end = following["line_no"]
                break
        text_parts = [candidate["inline"]] if candidate["inline"] else []
        for line in lines[candidate["line_no"] + 1 : end]:
            stripped = line.strip()
            if stripped.startswith("|scroll element|"):
                break
            line_indent = len(line[: len(line) - len(line.lstrip(" \t"))].replace("\t", "    "))
            # Browser Use state can emit page/scroll markers at the same or a
            # shallower indentation than the preceding element.  They are
            # structural text, not descendants of that element; associating
            # them with the previous image/avatar is an unsafe false match.
            if stripped and line_indent > candidate["indent"] and not _STATE_ELEMENT_RE.match(line):
                text_parts.append(stripped)
        # Browser Use state exposes some submit controls as inputs whose
        # actionable label lives in an attribute (for example
        # value="Submit") rather than as descendant text. Include only
        # semantic label attributes in the transient matching surface; the
        # raw values are never persisted in target evidence.
        semantic_attributes = [
            value
            for key, value in candidate["attributes"].items()
            if key in {"aria-label", "title", "value", "name", "placeholder", "data-testid"}
            and value
        ]
        candidate_text = " ".join(" ".join(text_parts + semantic_attributes).split())
        if semantic_query:
            attribute, expected = semantic_query
            actual = candidate["tag"] if attribute == "tag" else candidate["attributes"].get(attribute, "")
            if str(actual).strip().casefold() != expected:
                continue
        elif normalized_target not in candidate_text.casefold():
            continue
        matches.append(
            {
                "index": candidate["index"],
                "tag": candidate["tag"],
                "indent": candidate["indent"],
                "attributes": candidate["attributes"],
                "text_length": len(candidate_text),
                "match_text_sha256": hashlib.sha256(candidate_text.encode("utf-8")).hexdigest(),
            }
        )
    if semantic_query and len(matches) != 1:
        raise Blocker("browser_use_target_ambiguous" if matches else "browser_use_target_not_found")
    # Prefer an element that is semantically interactive over a deeper static
    # text child. Provider UIs commonly render the label in a span nested in
    # a button; choosing the deepest node made the probe report
    # interactive=false even though its parent was the safe click target.
    def interactive_score(item: dict[str, Any]) -> int:
        attrs = {str(key).lower(): str(value).lower() for key, value in item.get("attributes", {}).items()}
        tag = str(item.get("tag") or "").lower()
        role = attrs.get("role", "")
        input_type = attrs.get("type", "")
        tabindex = attrs.get("tabindex", "")
        return int(
            tag in _INTERACTIVE_TAGS
            or role in _INTERACTIVE_ROLES
            or input_type in {"button", "submit", "reset", "checkbox", "radio"}
            or (tabindex.lstrip("-").isdigit() and int(tabindex) >= 0)
        )

    if not matches:
        raise Blocker("browser_use_target_not_found")
    matches.sort(key=lambda item: (-interactive_score(item), -int(item["indent"]), int(item["index"])))
    best_score = interactive_score(matches[0])
    deepest = int(matches[0]["indent"])
    selected = [item for item in matches if interactive_score(item) == best_score and int(item["indent"]) == deepest]
    if len({int(item["index"]) for item in selected}) != 1:
        raise Blocker("browser_use_target_ambiguous")
    return matches


def _attributes_from_cli(parsed: Any) -> dict[str, str]:
    value = _first_field(parsed, {"attributes", "attrs"})
    if isinstance(value, dict):
        return {str(key).lower(): str(item) for key, item in value.items() if isinstance(key, str)}
    if isinstance(value, str):
        return _state_attr_map(value)
    return {}


def _bbox_from_cli(parsed: Any) -> dict[str, float]:
    for value in _json_values(parsed):
        if not isinstance(value, dict):
            continue
        lowered = {str(key).lower(): item for key, item in value.items()}
        try:
            if {"x", "y", "width", "height"}.issubset(lowered):
                bbox = {key: float(lowered[key]) for key in ("x", "y", "width", "height")}
            elif {"left", "top", "right", "bottom"}.issubset(lowered):
                bbox = {
                    "x": float(lowered["left"]),
                    "y": float(lowered["top"]),
                    "width": float(lowered["right"]) - float(lowered["left"]),
                    "height": float(lowered["bottom"]) - float(lowered["top"]),
                }
            else:
                continue
        except (TypeError, ValueError):
            continue
        if all(math.isfinite(item) for item in bbox.values()) and bbox["width"] > 0 and bbox["height"] > 0:
            return bbox
    raise Blocker("browser_use_target_bbox_invalid")


def _cli_coordinate(value: float) -> str:
    """Use Browser Use CLI's integer coordinate form when exact."""
    if float(value).is_integer():
        return str(int(value))
    return f"{value:.2f}".rstrip("0").rstrip(".")


def _target_is_interactive(candidate: dict[str, Any], attributes: dict[str, str]) -> bool:
    merged = {str(key).lower(): str(value) for key, value in candidate.get("attributes", {}).items()}
    merged.update({str(key).lower(): str(value) for key, value in attributes.items()})
    tag = str(candidate.get("tag") or "").lower()
    role = merged.get("role", "").lower()
    input_type = merged.get("type", "").lower()
    tabindex = merged.get("tabindex", "")
    return (
        tag in _INTERACTIVE_TAGS
        or role in _INTERACTIVE_ROLES
        or input_type in {"button", "submit", "reset", "checkbox", "radio"}
        or (tabindex.lstrip("-").isdigit() and int(tabindex) >= 0)
        or candidate.get("hasInlineHandler") is True
        or any(merged.get(name, "").strip() for name in ("onclick", "onmousedown", "onpointerdown"))
    )


def _target_state_summary(parsed: Any, raw_state: str) -> dict[str, Any]:
    """Return non-secret evidence, never the raw page state."""
    return {
        "state_sha256": hashlib.sha256(raw_state.encode("utf-8")).hexdigest(),
        "state_length": len(raw_state),
        "url_sha256": hashlib.sha256(str(_first_field(parsed, {"url", "href"}) or "").encode("utf-8")).hexdigest(),
        "title_sha256": hashlib.sha256(str(_first_field(parsed, {"title"}) or "").encode("utf-8")).hexdigest(),
    }


def _safe_directory_observation(path: str) -> dict[str, Any]:
    """Hash a bounded directory listing without persisting names or content."""
    real = os.path.realpath(path)
    if not os.path.isdir(real) or os.path.islink(path):
        return {"exists": False, "entries": 0, "sha256": hashlib.sha256(b"missing").hexdigest()}
    entries: list[dict[str, Any]] = []
    try:
        for name in sorted(os.listdir(real)):
            child = os.path.join(real, name)
            try:
                kind = "dir" if os.path.isdir(child) else "file" if os.path.isfile(child) else "other"
                size = os.path.getsize(child) if kind == "file" else 0
            except OSError as exc:
                raise Blocker("browser_use_no_dispatch_download_observation_failed") from exc
            entries.append({
                "kind": kind,
                "name_sha256": hashlib.sha256(name.encode("utf-8")).hexdigest(),
                "size": int(size),
            })
    except OSError as exc:
        raise Blocker("browser_use_no_dispatch_download_observation_failed") from exc
    encoded = json.dumps(entries, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return {"exists": True, "entries": len(entries), "sha256": hashlib.sha256(encoded).hexdigest()}


def _safe_tab_inventory_observation(recording: dict[str, Any]) -> dict[str, Any]:
    path = recording.get("tab_inventory_path")
    if not isinstance(path, str) or not path:
        raise Blocker("browser_use_no_dispatch_tab_observation_unavailable")
    inventory = read_recording_tab_inventory(path)
    encoded = json.dumps(inventory, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return {"sha256": hashlib.sha256(encoded).hexdigest(), "tab_count": len(inventory.get("tabs", []))}


def _safe_state_observation(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    recording: dict[str, Any],
) -> dict[str, Any]:
    """Capture only hashes needed for an explicit no-dispatch proof."""
    code, readback_exit, stdout = run_cli_keep_alive_capture(
        config,
        config["roots"]["browser_use_home"],
        descriptor["port"],
        descriptor["session"],
        ["state"],
        recording=recording,
    )
    if code != 0 or readback_exit != 0:
        raise Blocker("browser_use_no_dispatch_state_readback_failed")
    parsed = _parse_cli_json(stdout)
    raw_state = _state_text_from_cli(parsed)
    return {
        "state_sha256": hashlib.sha256(raw_state.encode("utf-8")).hexdigest(),
        "state_length": len(raw_state),
        "tab_inventory": _safe_tab_inventory_observation(recording),
        "downloads": _safe_directory_observation(descriptor["download_dir"]),
        "readback_exit": 0,
        "observed_at": iso(now_utc()),
    }


def should_capture_dispatch_proof(command: list[str], explicitly_requested: bool = False) -> bool:
    """Capture a bounded pre-dispatch observation for supported effects.

    The explicit flag remains accepted for compatibility, but making this the
    default closes the gap where a helper-rejected click or upload had no
    same-run pre-state to compare against.  The proof is still fail-closed:
    only an allowlisted pre-dispatch failure marker plus unchanged observations
    can produce a no-dispatch receipt.
    """
    return bool(explicitly_requested) or (bool(command) and command[0] in NO_DISPATCH_PROOF_COMMANDS)


def _dispatch_proof_public_command(command: list[str]) -> list[str]:
    """Return a secret/path-free command shape for a persisted proof."""
    if not command or command[0] not in NO_DISPATCH_PROOF_COMMANDS:
        raise Blocker("browser_use_no_dispatch_command_unsupported")
    if command[0] == "click":
        if len(command) not in {2, 3}:
            raise Blocker("browser_use_no_dispatch_click_shape_invalid")
        return list(command)
    if len(command) == 2:
        if command[1] == "path":
            return list(command)
        return ["upload", "path"]
    if len(command) == 3 and str(command[1]).isdigit():
        return ["upload", "file-input-index", "path"]
    if command[1:] == ["file-input-index", "path"]:
        return list(command)
    raise Blocker("browser_use_no_dispatch_upload_shape_invalid")


def _no_dispatch_command_fingerprint(command: list[str]) -> str:
    """Fingerprint a supported effect command without storing its arguments."""
    _dispatch_proof_public_command(command)
    return hashlib.sha256(json.dumps(command, ensure_ascii=True, separators=(",", ":")).encode("utf-8")).hexdigest()


def _no_dispatch_binding_digest(descriptor: dict[str, Any], operation_id: str, command_fingerprint: str) -> str:
    binding = {
        "run_id": descriptor.get("run_id"),
        "session": descriptor.get("session"),
        "nonce": descriptor.get("nonce"),
        "profile": descriptor.get("profile"),
        "port": descriptor.get("port"),
        "operation_lineage_digest": descriptor.get("operation_lineage_digest") or operation_lineage_digest(descriptor),
        "authority_sha256": descriptor.get("authority_sha256"),
        "operation_id": operation_id,
        "command_fingerprint": command_fingerprint,
    }
    return hashlib.sha256(json.dumps(binding, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()


def _no_dispatch_receipt_dir(descriptor: dict[str, Any]) -> str:
    root = os.path.join(os.path.realpath(descriptor["recording_dir"]), "no-dispatch-receipts")
    assert_directory(root, create=True)
    return root


def _no_dispatch_receipt_path(descriptor: dict[str, Any], operation_id: str) -> str:
    if not re.fullmatch(r"[a-f0-9]{32}", str(operation_id)):
        raise Blocker("browser_use_no_dispatch_operation_id_invalid")
    return os.path.join(_no_dispatch_receipt_dir(descriptor), f"{operation_id}.json")


def _no_dispatch_terminal_receipt_path(descriptor: dict[str, Any], operation_id: str) -> str:
    if not re.fullmatch(r"[a-f0-9]{32}", str(operation_id)):
        raise Blocker("browser_use_no_dispatch_operation_id_invalid")
    return os.path.join(_no_dispatch_receipt_dir(descriptor), f"{operation_id}.confirmed-not-executed.json")


def _read_no_dispatch_receipt(descriptor: dict[str, Any], operation_id: str) -> dict[str, Any]:
    path = _no_dispatch_receipt_path(descriptor, operation_id)
    if not os.path.lexists(path):
        raise Blocker("browser_use_no_dispatch_receipt_missing")
    value = read_json_safe(path)
    if value.get("schema") != NO_DISPATCH_RECEIPT_SCHEMA:
        raise Blocker("browser_use_no_dispatch_receipt_schema_invalid")
    if value.get("operation_id") != operation_id:
        raise Blocker("browser_use_no_dispatch_receipt_operation_binding_invalid")
    return value


def _persist_no_dispatch_receipt(descriptor: dict[str, Any], receipt: dict[str, Any]) -> str:
    path = _no_dispatch_receipt_path(descriptor, str(receipt.get("operation_id")))
    try:
        json_atomic_no_replace(path, receipt)
    except Blocker as exc:
        if exc.code != "browser_use_receipt_already_exists":
            raise
        existing = _read_no_dispatch_receipt(descriptor, str(receipt.get("operation_id")))
        if existing != receipt:
            raise Blocker("browser_use_no_dispatch_receipt_replay")
    return path


def _validate_no_dispatch_receipt(descriptor: dict[str, Any], operation_id: str, receipt: dict[str, Any], *, terminal: bool = False) -> None:
    if receipt.get("schema") != NO_DISPATCH_RECEIPT_SCHEMA:
        raise Blocker("browser_use_no_dispatch_receipt_schema_invalid")
    if receipt.get("operation_id") != operation_id or receipt.get("run_id") != descriptor.get("run_id") or receipt.get("session") != descriptor.get("session"):
        raise Blocker("browser_use_no_dispatch_receipt_run_binding_invalid")
    if receipt.get("authority_sha256") != descriptor.get("authority_sha256"):
        raise Blocker("browser_use_no_dispatch_receipt_authority_binding_invalid")
    expected_lineage = descriptor.get("operation_lineage_digest") or operation_lineage_digest(descriptor)
    if receipt.get("operation_lineage_digest") != expected_lineage:
        raise Blocker("browser_use_no_dispatch_receipt_lineage_binding_invalid")
    command_name = receipt.get("command_name")
    if command_name not in NO_DISPATCH_PROOF_COMMANDS or receipt.get("dispatch_phase") != "not_started":
        raise Blocker("browser_use_no_dispatch_receipt_dispatch_phase_invalid")
    if receipt.get("failure_marker") not in NO_DISPATCH_FAILURE_MARKERS:
        raise Blocker("browser_use_no_dispatch_receipt_failure_marker_invalid")
    if receipt.get("dispatch_exit") != 1 or receipt.get("readback_exit") != 0:
        raise Blocker("browser_use_no_dispatch_receipt_exit_evidence_invalid")
    pre = receipt.get("pre_observation")
    post = receipt.get("post_observation")
    if not isinstance(pre, dict) or not isinstance(post, dict):
        raise Blocker("browser_use_no_dispatch_receipt_observation_missing")
    if pre.get("readback_exit") != 0 or post.get("readback_exit") != 0:
        raise Blocker("browser_use_no_dispatch_receipt_observation_exit_invalid")
    if pre.get("state_sha256") != post.get("state_sha256") or pre.get("tab_inventory") != post.get("tab_inventory") or pre.get("downloads") != post.get("downloads"):
        raise Blocker("browser_use_no_dispatch_receipt_observation_changed")
    try:
        pre_time = dt.datetime.fromisoformat(str(pre["observed_at"]).replace("Z", "+00:00"))
        post_time = dt.datetime.fromisoformat(str(post["observed_at"]).replace("Z", "+00:00"))
    except (KeyError, TypeError, ValueError) as exc:
        raise Blocker("browser_use_no_dispatch_receipt_observation_time_invalid") from exc
    if post_time < pre_time or (post_time - pre_time).total_seconds() > NO_DISPATCH_PROOF_MAX_WINDOW_SECONDS:
        raise Blocker("browser_use_no_dispatch_receipt_observation_window_invalid")
    effects = receipt.get("effect_observation")
    if not isinstance(effects, dict) or effects.get("state_unchanged") is not True or effects.get("tab_inventory_unchanged") is not True or effects.get("downloads_unchanged") is not True or effects.get("network_dispatch_started") is not False:
        raise Blocker("browser_use_no_dispatch_receipt_effect_observation_invalid")
    command = receipt.get("command", [])
    public_command = _dispatch_proof_public_command(command)
    if public_command != command or command_name != command[0]:
        raise Blocker("browser_use_no_dispatch_receipt_command_binding_invalid")
    expected_fingerprint = descriptor.get("dispatch_proof_target_fingerprint")
    if command_name == "click":
        expected_from_receipt = _no_dispatch_command_fingerprint(command)
        if isinstance(expected_fingerprint, str) and re.fullmatch(r"[0-9a-f]{64}", expected_fingerprint) and expected_fingerprint != expected_from_receipt:
            raise Blocker("browser_use_no_dispatch_receipt_target_binding_invalid")
        expected_fingerprint = expected_from_receipt
    elif not isinstance(expected_fingerprint, str) or not re.fullmatch(r"[0-9a-f]{64}", expected_fingerprint):
        raise Blocker("browser_use_no_dispatch_receipt_target_binding_invalid")
    if receipt.get("target_fingerprint") != expected_fingerprint:
        raise Blocker("browser_use_no_dispatch_receipt_target_binding_invalid")
    if receipt.get("descriptor_binding_sha256") != _no_dispatch_binding_digest(descriptor, operation_id, str(receipt.get("target_fingerprint"))):
        raise Blocker("browser_use_no_dispatch_receipt_descriptor_binding_invalid")
    if receipt.get("last_recovery_trigger_operation_id") != operation_id or receipt.get("recovery_status") != "verified":
        raise Blocker("browser_use_no_dispatch_receipt_recovery_binding_invalid")
    if terminal and receipt.get("terminal_state") != "confirmed_not_executed":
        raise Blocker("browser_use_no_dispatch_receipt_terminal_state_invalid")


def _target_capture(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    recording: dict[str, Any],
    target_text: str,
) -> tuple[dict[str, Any], dict[str, Any]]:
    """Resolve a target from one fresh state and collect fresh metadata."""
    home = config["roots"]["browser_use_home"]
    port = descriptor["port"]
    session = descriptor["session"]

    def capture(command: list[str]) -> Any:
        if browser_harness_cli_enabled() and command and command[0] in {"ax-inspect", "ax-click"}:
            # A stale Browser Harness attachment can break a read-only AX
            # probe even when the run-owned Chrome and page are healthy. One
            # reload/rebind is safe for inspect; never retry a click because
            # its dispatch result can be ambiguous.
            max_attempts = 2 if command[0] == "ax-inspect" else 1
            code = 1
            readback_exit = 1
            stdout = ""
            for attempt in range(max_attempts):
                code, readback_exit, stdout = run_cli_keep_alive_capture(config, home, port, session, command, recording=recording)
                if code == 0 and readback_exit == 0:
                    break
                if attempt + 1 < max_attempts:
                    try:
                        refresh_exit = run_browser_harness_reload(config, home, port, session)
                    except (OSError, subprocess.SubprocessError):
                        refresh_exit = 1
                    if refresh_exit != 0:
                        break
            if code != 0:
                raise Blocker("browser_use_target_command_failed", _LAST_RECORDING_CLI_FAILURE or command[0])
            if readback_exit != 0:
                raise Blocker("browser_use_target_readback_failed", str(readback_exit))
            return _parse_cli_json(stdout)
        validate_command(command, descriptor["mode"], config, list(descriptor["target_origins"]), descriptor["download_dir"])
        code, readback_exit, stdout = run_cli_keep_alive_capture(config, home, port, session, command, recording=recording)
        if code != 0:
            raise Blocker("browser_use_target_command_failed", _LAST_RECORDING_CLI_FAILURE or command[0])
        if readback_exit != 0:
            raise Blocker("browser_use_target_readback_failed", str(readback_exit))
        return _parse_cli_json(stdout)

    if browser_harness_cli_enabled():
        parsed = capture(["ax-inspect", target_text])
        data = parsed.get("data") if isinstance(parsed, dict) else None
        candidate = data.get("candidate") if isinstance(data, dict) else None
        before = data.get("before") if isinstance(data, dict) else None
        if candidate is not None and not isinstance(candidate, dict):
            raise Blocker("browser_use_ax_target_readback_shape_invalid")
        if not isinstance(before, dict):
            raise Blocker("browser_use_ax_target_readback_shape_invalid")
        if candidate is None:
            candidate = {
                "backend_present": False,
                "interactive": False,
                "match_status": "not_found",
                "match_text_sha256": hashlib.sha256(str(target_text).encode("utf-8")).hexdigest(),
            }
        return candidate, before

    state_parsed = capture(["state"])
    state_raw = _state_text_from_cli(state_parsed)
    candidates = _state_candidates(state_raw, target_text)
    candidate = candidates[0]
    index = str(candidate["index"])
    attrs_parsed = capture(["get", "attributes", index])
    attributes = _attributes_from_cli(attrs_parsed)
    merged_attributes = dict(candidate.get("attributes") or {})
    merged_attributes.update(attributes)
    bbox_parsed = capture(["get", "bbox", index])
    bbox = _bbox_from_cli(bbox_parsed)
    candidate = {
        "index": int(candidate["index"]),
        "tag": candidate["tag"],
        "text_length": candidate["text_length"],
        "match_text_sha256": candidate["match_text_sha256"],
        "interactive": _target_is_interactive(candidate, merged_attributes),
        "attributes": {
            key: merged_attributes[key]
            for key in sorted(merged_attributes)
            if key in {"role", "type", "tabindex", "href", "aria-label", "data-testid"}
        },
        "bbox": bbox,
    }
    return candidate, _target_state_summary(state_parsed, state_raw)


AUTHENTICATION_PATH_SEGMENTS = {
    "auth", "challenge", "login", "mfa", "oauth", "saml", "signin", "sign-in", "sso", "2fa", "verify", "verification",
}
AUTHENTICATION_QUERY_KEYS = {
    "auth", "challenge", "code", "continue", "login", "next", "oauth", "redirect", "return", "returnto", "saml", "signin", "sso",
}


def _url_has_authentication_evidence(parsed_url: urllib.parse.ParseResult) -> bool:
    """Classify common auth/SSO/challenge redirects without persisting URL text."""
    if re.search(r"%(?![0-9a-fA-F]{2})", f"{parsed_url.path}?{parsed_url.query}"):
        return True
    decoded_path = urllib.parse.unquote(urllib.parse.unquote(parsed_url.path or "/"))
    normalized_path = re.sub(r"/+", "/", decoded_path).lower()
    segments = {segment for segment in normalized_path.split("/") if segment}
    if segments.intersection(AUTHENTICATION_PATH_SEGMENTS):
        return True
    try:
        query_pairs = urllib.parse.parse_qsl(parsed_url.query, keep_blank_values=True, strict_parsing=True)
    except ValueError:
        return True
    for raw_key, raw_value in query_pairs:
        key = urllib.parse.unquote_plus(raw_key).lower().replace("-", "").replace("_", "")
        value = urllib.parse.unquote_plus(raw_value).lower()
        if key not in AUTHENTICATION_QUERY_KEYS:
            continue
        if key in {"redirect", "return", "returnto", "continue", "next"}:
            decoded_value = urllib.parse.unquote(urllib.parse.unquote(value))
            if any(token in decoded_value for token in ("/login", "/signin", "/sso", "/oauth", "/saml", "challenge", "mfa", "verify")):
                return True
            if normalized_path in {"", "/"}:
                return True
        else:
            return True
    return False


def _navigation_binding_for_url(url: str) -> dict[str, Any]:
    """Return secret-free URL binding fields for a deferred auth readback."""
    parsed = urllib.parse.urlparse(str(url or ""))
    if parsed.scheme not in {"http", "https"} or not parsed.hostname:
        raise Blocker("browser_use_navigation_url_invalid")
    host = parsed.hostname.lower().rstrip(".")
    port = parsed.port
    port_suffix = f":{port}" if port and not ((parsed.scheme == "http" and port == 80) or (parsed.scheme == "https" and port == 443)) else ""
    origin = normalize_origin(f"{parsed.scheme}://{host}{port_suffix}")
    path = parsed.path or "/"
    query = parsed.query or ""
    fragment = parsed.fragment or ""
    return {
        "origin": origin,
        "path_sha256": hashlib.sha256(path.encode("utf-8")).hexdigest(),
        "path_length": len(path),
        "query_sha256": hashlib.sha256(query.encode("utf-8")).hexdigest(),
        "query_length": len(query),
        "fragment_sha256": hashlib.sha256(fragment.encode("utf-8")).hexdigest(),
        "fragment_length": len(fragment),
    }


def _navigation_binding_matches(evidence: dict[str, Any], expected: dict[str, Any]) -> bool:
    """Compare only hashed URL components; never persist or print URL text."""
    if not isinstance(evidence, dict) or not isinstance(expected, dict):
        return False
    fields = ("origin", "path_sha256", "path_length", "query_sha256", "query_length", "fragment_sha256", "fragment_length")
    return all(evidence.get(field) == expected.get(field) for field in fields)


def _linkedin_search_path(path: str) -> bool:
    return (path or "/").rstrip("/") in {"/jobs/search", "/jobs/search-results"}


def _linkedin_search_query_matches(expected_query: str, actual_query: str) -> bool:
    expected_pairs = urllib.parse.parse_qsl(expected_query, keep_blank_values=True)
    actual_pairs = urllib.parse.parse_qsl(actual_query, keep_blank_values=True)
    remaining = list(actual_pairs)
    for pair in expected_pairs:
        try:
            remaining.remove(pair)
        except ValueError:
            return False
    return all(key == "currentJobId" and re.fullmatch(r"\d+", value or "") for key, value in remaining)


def _navigation_exact_url_matches(expected: urllib.parse.ParseResult, actual: urllib.parse.ParseResult) -> bool:
    """Accept only documented provider canonicalization after a safe navigation.

    X currently normalizes ``/home`` to ``/`` while keeping the same origin.
    LinkedIn jobs search may canonicalize ``/jobs/search/`` to
    ``/jobs/search-results/``, add a numeric ``currentJobId``, and reorder
    query pairs while retaining the requested search filters. Keep the
    exception narrow: only that documented same-origin search route and
    numeric selected-job parameter are accepted; arbitrary redirects are not.
    """
    if (
        expected.scheme != actual.scheme
        or (expected.hostname or "").lower().rstrip(".") != (actual.hostname or "").lower().rstrip(".")
        or expected.fragment != actual.fragment
    ):
        return False
    expected_path = expected.path or "/"
    actual_path = actual.path or "/"
    if expected_path == actual_path:
        if expected.query == actual.query:
            return True
        host = (expected.hostname or "").lower().rstrip(".")
        if host != "www.linkedin.com" or not _linkedin_search_path(expected_path) or not _linkedin_search_path(actual_path):
            return False
        return _linkedin_search_query_matches(expected.query, actual.query)
    host = (expected.hostname or "").lower().rstrip(".")
    if host == "www.linkedin.com" and expected_path.rstrip("/") == "/jobs/search" and actual_path.rstrip("/") == "/jobs/search-results":
        return _linkedin_search_query_matches(expected.query, actual.query)
    return host == "x.com" and expected_path == "/home" and actual_path == "/" and not expected.query and not expected.fragment


def _navigation_ready_state_is_allowed(url: str, ready_state: str) -> bool:
    """Allow one bounded SPA readiness exception for the read-only Job lane."""
    if ready_state == "complete":
        return True
    if ready_state != "interactive":
        return False
    parsed = urllib.parse.urlparse(str(url or ""))
    return (
        parsed.scheme == "https"
        and (parsed.hostname or "").lower().rstrip(".") == "www.linkedin.com"
        and _linkedin_search_path(parsed.path)
    )


def _verified_current_origin(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    recording: dict[str, Any],
    *,
    expected_origins: list[str] | None = None,
    expected_url: str | None = None,
    return_evidence: bool = False,
) -> str | dict[str, Any]:
    """Read the current URL in-flow and prove it is an authorized origin."""
    code, readback_exit, stdout = run_cli_keep_alive_capture(
        config,
        config["roots"]["browser_use_home"],
        descriptor["port"],
        descriptor["session"],
        ["get", "url"],
        recording=recording,
    )
    if code != 0:
        raise Blocker("browser_use_navigation_url_readback_failed", _LAST_RECORDING_CLI_FAILURE or str(code))
    if readback_exit != 0:
        raise Blocker("browser_use_navigation_url_readback_failed", str(readback_exit))
    try:
        parsed = _parse_cli_json(stdout)
        current_url = _first_field(parsed, {"url", "href"})
        parsed_url = urllib.parse.urlparse(str(current_url or ""))
        if parsed_url.scheme not in {"http", "https"} or parsed_url.username or parsed_url.password or not parsed_url.hostname:
            raise Blocker("browser_use_navigation_url_invalid")
        host = parsed_url.hostname.lower().rstrip(".")
        port = parsed_url.port
        port_suffix = f":{port}" if port and not ((parsed_url.scheme == "http" and port == 80) or (parsed_url.scheme == "https" and port == 443)) else ""
        current_origin = normalize_origin(f"{parsed_url.scheme}://{host}{port_suffix}")
        if descriptor.get("mode") == "authorized" and _url_has_authentication_evidence(parsed_url):
            raise Blocker("browser_use_authentication_required")
        if expected_url:
            expected = urllib.parse.urlparse(str(expected_url))
            expected_host = (expected.hostname or "").lower().rstrip(".")
            expected_port = expected.port
            expected_origin = normalize_origin(f"{expected.scheme}://{expected_host}{f':{expected_port}' if expected_port and not ((expected.scheme == 'http' and expected_port == 80) or (expected.scheme == 'https' and expected_port == 443)) else ''}")
            if current_origin != expected_origin or not _navigation_exact_url_matches(expected, parsed_url):
                raise Blocker("browser_use_navigation_exact_url_mismatch")
    except Blocker as exc:
        if exc.code in {"browser_use_navigation_exact_url_mismatch", "browser_use_authentication_required"}:
            raise
        raise Blocker("browser_use_navigation_url_invalid") from exc
    allowed = expected_origins if expected_origins is not None else descriptor["target_origins"]
    try:
        allowed_origins = {normalize_origin(item) for item in allowed}
    except Blocker as exc:
        raise Blocker("browser_use_navigation_origin_policy_invalid") from exc
    if current_origin not in allowed_origins:
        raise Blocker("browser_use_navigation_origin_mismatch")
    evidence = {
        "schema": "browser-use-navigation-readback.v1",
        "origin": current_origin,
        "path_sha256": hashlib.sha256((parsed_url.path or "/").encode("utf-8")).hexdigest(),
        "path_length": len(parsed_url.path or "/"),
        "query_sha256": hashlib.sha256((parsed_url.query or "").encode("utf-8")).hexdigest(),
        "query_length": len(parsed_url.query or ""),
        "fragment_sha256": hashlib.sha256((parsed_url.fragment or "").encode("utf-8")).hexdigest(),
        "fragment_length": len(parsed_url.fragment or ""),
        "path_representation": "sha256_only",
        "verified_at": iso(now_utc()),
    }
    return evidence if return_evidence else current_origin


def _verified_navigation_with_checkpoint(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    recording: dict[str, Any],
    descriptor_path: str,
    *,
    expected_origins: list[str] | None = None,
    expected_url: str | None = None,
    operation_id: str | None = None,
) -> str | dict[str, Any]:
    try:
        evidence = _verified_current_origin(
            config,
            descriptor,
            recording,
            expected_origins=expected_origins,
            expected_url=expected_url,
            return_evidence=True,
        )
        if browser_harness_cli_enabled():
            # URL/origin proof alone can succeed while the document is still
            # transitioning.  The fixed probe returns only URL and
            # readyState; its raw URL is never persisted.
            probe_url = ""
            ready_state = ""
            # Browser Harness returns after navigation dispatch, while a
            # provider SPA can still be finishing its document transition.
            # Re-read only the fixed URL/readyState probe for a short bounded
            # window; never replay the navigation command.
            for probe_attempt in range(48):
                probe_url, ready_state = _fixed_url_state_probe(
                    config,
                    config["roots"]["browser_use_home"],
                    descriptor["port"],
                    descriptor["session"],
                    recording,
                )
                if _navigation_ready_state_is_allowed(probe_url, ready_state):
                    break
                if probe_attempt < 47:
                    time.sleep(0.25)
            if not _navigation_ready_state_is_allowed(probe_url, ready_state):
                raise Blocker("browser_use_navigation_ready_state_unverified")
            parsed_probe = urllib.parse.urlparse(probe_url)
            probe_origin = normalize_origin(
                f"{parsed_probe.scheme}://{parsed_probe.hostname.lower().rstrip('.')}{f':{parsed_probe.port}' if parsed_probe.port and not ((parsed_probe.scheme == 'http' and parsed_probe.port == 80) or (parsed_probe.scheme == 'https' and parsed_probe.port == 443)) else ''}"
            )
            if not isinstance(evidence, dict) or probe_origin != evidence.get("origin"):
                raise Blocker("browser_use_navigation_origin_reconciliation_failed")
            probe_path = parsed_probe.path or "/"
            if evidence.get("path_sha256") != hashlib.sha256(probe_path.encode("utf-8")).hexdigest() or evidence.get("path_length") != len(probe_path):
                raise Blocker("browser_use_navigation_path_reconciliation_failed")
            evidence["ready_state"] = ready_state
            evidence["ready_state_verified"] = ready_state == "complete"
            evidence["provider_ready_state_exception"] = ready_state == "interactive"
        return evidence
    except Exception as exc:
        descriptor["navigation_verified"] = False
        blocker = exc.code if isinstance(exc, Blocker) else "browser_use_navigation_readback_failed"
        try:
            write_recovery_checkpoint(
                descriptor,
                exact_blocker=blocker,
                next_action="same-run navigation readback and tab reconciliation",
                operation_id=operation_id,
            )
            _write_recording_descriptor(config, os.path.realpath(descriptor_path), descriptor, replace=True)
        except Exception:
            pass
        raise


def _authentication_wait_deadline(descriptor: dict[str, Any], timeout_seconds: float) -> dt.datetime:
    """Bound an auth wait by its caller timeout and immutable run lifetimes."""
    if not isinstance(timeout_seconds, (int, float)) or timeout_seconds < 0:
        raise Blocker("browser_use_authentication_wait_timeout_invalid")
    now = now_utc()
    deadline = now + dt.timedelta(seconds=float(timeout_seconds))
    candidates: list[dt.datetime] = []
    for field in ("authority_expires_at",):
        value = descriptor.get(field)
        if value:
            try:
                candidates.append(dt.datetime.fromisoformat(str(value).replace("Z", "+00:00")).astimezone(dt.timezone.utc))
            except (TypeError, ValueError) as exc:
                raise Blocker("browser_use_authentication_wait_expiry_invalid", field) from exc
    profile = descriptor.get("profile")
    if isinstance(profile, str) and os.path.lexists(os.path.join(profile, ".browser-use-profile.json")):
        marker = read_json_safe(os.path.join(profile, ".browser-use-profile.json"))
        retention_mode = marker.get("retention_mode", TEMPORARY_RETENTION_RUN_TTL)
        # Explicitly retained Temporary profiles have no expiry by contract.
        # They still require fresh authority/lease admission, but an auth wait
        # must not reinterpret their deliberate null expiry as malformed time.
        if not (retention_mode == TEMPORARY_RETENTION_MANUAL and marker.get("expires_at") is None):
            try:
                candidates.append(_parse_temporary_time(marker.get("expires_at"), "expires_at"))
            except Blocker:
                raise
    for candidate in candidates:
        if candidate <= now:
            raise Blocker("browser_use_authentication_wait_expired")
        # Leave a small margin so a command never crosses an authority or
        # temporary-profile boundary while a poll is in flight.
        deadline = min(deadline, candidate - dt.timedelta(seconds=1))
    return deadline


def _authentication_wait_state(
    descriptor: dict[str, Any],
    *,
    state: str,
    exact_blocker: str,
    operation_id: str | None,
    expected_navigation: dict[str, Any] | None,
    started_at: str,
    deadline_at: dt.datetime,
    attempts: int,
) -> dict[str, Any]:
    return {
        "schema": AUTHENTICATION_WAIT_SCHEMA,
        "state": state,
        "same_run": True,
        "same_room": True,
        "room_id": descriptor.get("room_id"),
        "port": descriptor.get("port"),
        "task_id": descriptor.get("task_id"),
        "operation_id": operation_id,
        "exact_blocker": str(exact_blocker)[:160],
        "expected_navigation": expected_navigation,
        "started_at": started_at,
        "deadline_at": iso(deadline_at),
        "attempts": int(attempts),
        "next_action": authentication_next_action(state),
        "updated_at": iso(now_utc()),
    }


def _supabase_authenticated_landing_readback(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    recording: dict[str, Any],
    evidence: dict[str, Any],
) -> dict[str, Any] | None:
    """Accept Supabase's authenticated organization landing after login.

    Supabase redirects ``/dashboard`` to ``/dashboard/organizations`` for an
    authenticated account.  The login handoff originally bound the expected
    navigation to the pre-login path, so a valid session was left waiting
    forever.  Keep this exception narrow: same-origin Supabase only, and
    require a fresh, non-secret state readback containing the authenticated
    organization/project navigation surface.  Never persist the state text.
    """
    try:
        origins = {normalize_origin(item) for item in descriptor.get("target_origins", [])}
    except Blocker:
        return None
    if origins != {"https://supabase.com"}:
        return None
    code, readback_exit, stdout = run_cli_keep_alive_capture(
        config,
        config["roots"]["browser_use_home"],
        descriptor["port"],
        descriptor["session"],
        ["state"],
        recording=recording,
    )
    if code != 0 or readback_exit != 0:
        return None
    try:
        parsed = _parse_cli_json(stdout)
        raw_state = _state_text_from_cli(parsed)
    except Blocker:
        return None
    authenticated_surface = (
        re.search(r'href=["\']/dashboard/(?:org|project)/', raw_state, re.IGNORECASE) is not None
        and re.search(r"(?:Organizations|Your Organizations|Projects)", raw_state, re.IGNORECASE) is not None
    )
    if not authenticated_surface:
        return None
    return {
        **evidence,
        "authentication_readback": "supabase_authenticated_dashboard_landing",
        "state_sha256": hashlib.sha256(raw_state.encode("utf-8")).hexdigest(),
        "state_length": len(raw_state),
    }


def _persist_authentication_wait(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    descriptor_path: str,
    *,
    state: str,
    exact_blocker: str,
    operation_id: str | None,
    expected_navigation: dict[str, Any] | None,
    started_at: str,
    deadline_at: dt.datetime,
    attempts: int,
    recording: dict[str, Any] | None = None,
) -> dict[str, Any]:
    wait_state = _authentication_wait_state(
        descriptor,
        state=state,
        exact_blocker=exact_blocker,
        operation_id=operation_id,
        expected_navigation=expected_navigation,
        started_at=started_at,
        deadline_at=deadline_at,
        attempts=attempts,
    )
    descriptor["authentication_state"] = state
    descriptor["authentication_wait"] = wait_state
    if state == "waiting":
        descriptor["recovery_state"] = "authentication_pending"
        descriptor["effectful_retry_allowed"] = False
        if descriptor.get("room_id"):
            room_registry_update(
                config,
                descriptor["room_id"],
                run_id=descriptor["run_id"],
                state="held",
                activity="authentication-required",
            )
        if recording is not None and browser_harness_cli_enabled():
            write_harness_recording_status(
                recording["status_path"],
                recording,
                active=True,
                finalized=False,
                state="authentication_required",
                reason="browser_use_authentication_required",
            )
    elif state == "authenticated":
        if descriptor.get("room_id"):
            room_registry_update(
                config,
                descriptor["room_id"],
                run_id=descriptor["run_id"],
                state="active",
                activity="authentication-resumed",
            )
        if recording is not None and browser_harness_cli_enabled():
            write_harness_recording_status(
                recording["status_path"],
                recording,
                active=True,
                finalized=False,
                state="active",
                reason="authentication-resumed",
            )
    _write_recording_descriptor(config, os.path.realpath(descriptor_path), descriptor, replace=True)
    return wait_state


def _same_origin_post_login_navigation_readback(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    recording: dict[str, Any],
    descriptor_path: str,
    *,
    expected_origins: list[str],
    operation_id: str | None,
) -> dict[str, Any] | None:
    """Accept a verified same-origin route after a human login redirect.

    The initial login URL is intentionally bound exactly.  Once that URL has
    been shown to require authentication, the provider is allowed to land on
    a different route after the user completes login.  Re-read the current
    route without an exact-path binding; the normal origin, auth-path, and
    ready-state checks still apply, and no URL text is persisted.
    """
    try:
        evidence = _verified_navigation_with_checkpoint(
            config,
            descriptor,
            recording,
            os.path.realpath(descriptor_path),
            expected_origins=expected_origins,
            expected_url=None,
            operation_id=operation_id,
        )
    except Blocker:
        return None
    if not isinstance(evidence, dict):
        return None
    return {
        **evidence,
        "authentication_readback": "same_origin_post_login_navigation",
    }


def _wait_for_authentication(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    descriptor_path: str,
    recording: dict[str, Any],
    *,
    expected_origins: list[str],
    expected_url: str | None,
    operation_id: str | None,
    timeout_seconds: float = AUTHENTICATION_WAIT_TIMEOUT_SECONDS,
    poll_interval_seconds: float = AUTHENTICATION_WAIT_POLL_SECONDS,
) -> dict[str, Any]:
    """Wait on the exact live room for human login, never entering credentials."""
    if not isinstance(poll_interval_seconds, (int, float)) or poll_interval_seconds <= 0:
        raise Blocker("browser_use_authentication_wait_poll_invalid")
    if float(poll_interval_seconds) > 60:
        raise Blocker("browser_use_authentication_wait_poll_too_long")
    deadline = _authentication_wait_deadline(descriptor, timeout_seconds)
    started_at = iso(now_utc())
    expected_navigation = _navigation_binding_for_url(expected_url) if expected_url else (descriptor.get("authentication_wait") or {}).get("expected_navigation")
    attempts = 0
    _persist_authentication_wait(
        config,
        descriptor,
        descriptor_path,
        state="waiting",
        exact_blocker="browser_use_authentication_required",
        operation_id=operation_id or (descriptor.get("authentication_wait") or {}).get("operation_id"),
        expected_navigation=expected_navigation if isinstance(expected_navigation, dict) else None,
        started_at=started_at,
        deadline_at=deadline,
        attempts=attempts,
        recording=recording,
    )
    while True:
        attempts += 1
        post_login_evidence: dict[str, Any] | None = None
        try:
            evidence = _verified_navigation_with_checkpoint(
                config,
                descriptor,
                recording,
                os.path.realpath(descriptor_path),
                expected_origins=expected_origins,
                expected_url=expected_url,
                operation_id=operation_id,
            )
            if expected_url is None and isinstance(expected_navigation, dict) and not _navigation_binding_matches(evidence, expected_navigation):
                reconciled = _supabase_authenticated_landing_readback(config, descriptor, recording, evidence)
                if reconciled is None:
                    reconciled = {
                        **evidence,
                        "authentication_readback": "same_origin_post_login_navigation",
                    }
                evidence = reconciled
        except Blocker as exc:
            if exc.code == "browser_use_navigation_exact_url_mismatch" and expected_url:
                post_login_evidence = _same_origin_post_login_navigation_readback(
                    config,
                    descriptor,
                    recording,
                    descriptor_path,
                    expected_origins=expected_origins,
                    operation_id=operation_id,
                )
                if post_login_evidence is None:
                    _persist_authentication_wait(
                        config,
                        descriptor,
                        descriptor_path,
                        state="waiting",
                        exact_blocker=exc.code,
                        operation_id=operation_id,
                        expected_navigation=expected_navigation if isinstance(expected_navigation, dict) else None,
                        started_at=started_at,
                        deadline_at=deadline,
                        attempts=attempts,
                        recording=recording,
                    )
                    return {"status": "waiting", "exact_blocker": exc.code, "attempts": attempts}
            elif exc.code not in {"browser_use_authentication_required", "browser_use_authentication_navigation_readback_pending"}:
                raise
            if post_login_evidence is None:
                now = now_utc()
                if now >= deadline:
                    wait_state = _persist_authentication_wait(
                        config,
                        descriptor,
                        descriptor_path,
                        state="waiting",
                        exact_blocker=exc.code,
                        operation_id=operation_id,
                        expected_navigation=expected_navigation if isinstance(expected_navigation, dict) else None,
                        started_at=started_at,
                        deadline_at=deadline,
                        attempts=attempts,
                        recording=recording,
                    )
                    return {"status": "waiting", "exact_blocker": exc.code, "attempts": attempts, "wait": wait_state}
                _persist_authentication_wait(
                    config,
                    descriptor,
                    descriptor_path,
                    state="waiting",
                    exact_blocker=exc.code,
                    operation_id=operation_id,
                    expected_navigation=expected_navigation if isinstance(expected_navigation, dict) else None,
                    started_at=started_at,
                    deadline_at=deadline,
                    attempts=attempts,
                    recording=None,
                )
                time.sleep(min(float(poll_interval_seconds), max(0.01, (deadline - now).total_seconds())))
                continue
            evidence = post_login_evidence
        wait_state = _persist_authentication_wait(
            config,
            descriptor,
            descriptor_path,
            state="authenticated",
            exact_blocker="authentication_readback_verified",
            operation_id=operation_id,
            expected_navigation=expected_navigation if isinstance(expected_navigation, dict) else None,
            started_at=started_at,
            deadline_at=deadline,
            attempts=attempts,
            recording=recording,
        )
        return {"status": "authenticated", "evidence": evidence, "attempts": attempts, "wait": wait_state}


def _recording_target_context(config: dict[str, Any], args: argparse.Namespace, operation: str) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(config, args.descriptor, run_id, session, allow_pinned_helper_reexec=False)
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    authority = recording_authority(
        config,
        descriptor,
        args.authority,
        command_class="target-click" if operation == "target-click" else "target-inspect",
        renewal_path=getattr(args, "authority_renewal", None),
        auto_renew=bool(getattr(args, "auto_renew", False)),
    )
    if getattr(args, "authority_renewal", None) or getattr(args, "auto_renew", False):
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    validate_recording_process(config, descriptor)
    if operation == "target-click" and descriptor["mode"] != "authorized":
        raise Blocker("browser_use_target_click_requires_authorized_mode")
    require_no_pending_effect_reconciliation(descriptor, effectful=operation == "target-click")
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])
    require_navigation_readback_binding(descriptor)
    try:
        _verified_navigation_with_checkpoint(config, descriptor, recording, os.path.realpath(args.descriptor))
    except Blocker as exc:
        if exc.code != "browser_use_authentication_required":
            raise
        auth_result = _wait_for_authentication(
            config,
            descriptor,
            os.path.realpath(args.descriptor),
            recording,
            expected_origins=list(descriptor["target_origins"]),
            expected_url=None,
            operation_id=None,
            timeout_seconds=AUTHENTICATION_WAIT_TIMEOUT_SECONDS,
            poll_interval_seconds=AUTHENTICATION_WAIT_POLL_SECONDS,
        )
        if auth_result.get("status") != "authenticated":
            raise Blocker("browser_use_authentication_waiting")
    return descriptor, authority or {}, recording


def _record_target_operation_failure(
    config: dict[str, Any],
    descriptor_path: str,
    descriptor: dict[str, Any],
    *,
    operation: str,
    target_text: str,
    blocker: str,
    external_action_possible: bool,
    operation_id: str | None = None,
) -> None:
    """Persist bounded evidence when a target operation stops before success.

    A failed target command is still useful evidence for the next repair run,
    but target text and helper details must not be copied into durable state.
    Keep only the target digest, operation, exact blocker, and whether the
    click dispatch had already been attempted.
    """
    text = str(target_text or "")
    entry = {
        "operation": str(operation),
        "operation_id": str(operation_id) if operation_id else None,
        "status": "failed",
        "target_text_sha256": hashlib.sha256(text.encode("utf-8")).hexdigest(),
        "target_text_length": len(text),
        "exact_blocker": str(blocker)[:160],
        "external_action_possible": bool(external_action_possible),
        "external_effects": "unknown" if external_action_possible else "none",
        "recorded_at": iso(now_utc()),
    }
    descriptor.setdefault("failed_operations", []).append(entry)
    try:
        write_recovery_checkpoint(
            descriptor,
            exact_blocker=str(blocker),
            next_action="same-surface outcome reconciliation before any retry",
            operation_id=operation_id,
        )
    except Exception:
        pass
    if descriptor.get("recording_dir") or descriptor.get("operation_ledger_path"):
        update_reconciliation_summary(descriptor)
    _write_recording_descriptor(config, os.path.realpath(descriptor_path), descriptor, replace=True)


def _target_click_failure_outcome(
    *,
    dispatch_attempted: bool,
    effect_proof_committed: bool,
    blocker: str,
) -> dict[str, str] | None:
    """Return a ledger outcome only when the click effect is not already proven.

    A target click commits its executed/readback outcome before capturing the
    post-action video frame.  If only that capture fails, appending an
    ``unknown`` outcome would contradict the durable executed proof and create
    a false reconciliation debt.
    """
    if effect_proof_committed:
        return None
    return {
        "external_effects": "unknown" if dispatch_attempted else "none",
        "outcome": str(blocker),
    }


@recording_command_exclusive
def record_target_inspect(args: argparse.Namespace) -> int:
    config = read_toml()
    validate_installation(config)
    descriptor, _authority, recording = _recording_target_context(config, args, "target-inspect")
    try:
        candidate, before = _target_capture(config, descriptor, recording, args.target_text)
        capture_recording_frame(
            config,
            config["roots"]["browser_use_home"],
            descriptor["port"],
            descriptor["session"],
            recording,
        )
        if descriptor.get("tab_inventory_path"):
            descriptor["tab_inventory"] = read_recording_tab_inventory(descriptor["tab_inventory_path"])
        descriptor["status"] = "continued"
        descriptor["operations"].append("target-inspect")
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
        print(json.dumps({"status": "recording_continued", "operation": "target-inspect", "descriptor": os.path.realpath(args.descriptor), "candidate": candidate, "before_state": before, "authority_sha256": descriptor.get("authority_sha256"), "authority_generation": descriptor.get("authority_generation"), "authority_current_path": descriptor.get("authority_current_path"), "authority_expires_at": descriptor.get("authority_expires_at"), "finalized": False}, sort_keys=True))
        return 0
    except Exception as exc:
        _record_target_operation_failure(
            config,
            args.descriptor,
            descriptor,
            operation="target-inspect",
            target_text=args.target_text,
            blocker=exc.code if isinstance(exc, Blocker) else "browser_use_target_inspect_failed",
            external_action_possible=False,
        )
        raise


@recording_command_exclusive
def record_target_click(args: argparse.Namespace) -> int:
    config = read_toml()
    validate_installation(config)
    descriptor, authority, recording = _recording_target_context(config, args, "target-click")
    if not authority:
        raise Blocker("browser_use_authority_required")
    dispatch_attempted = False
    effect_proof_committed = False
    operation_id = uuid.uuid4().hex
    append_operation_intent_durable(
        descriptor,
        operation_id=operation_id,
        command=["target-click"],
        external_effects="unknown",
        outcome="dispatch_intent_durable",
    )
    persist_effect_evidence(
        config,
        descriptor,
        os.path.realpath(args.descriptor),
        operation_id,
        ["target-click"],
        phase="intent_recorded",
        effect_state="pre-dispatch",
        target_text=args.target_text,
    )
    try:
        if browser_harness_cli_enabled():
            persist_effect_evidence(
                config,
                descriptor,
                os.path.realpath(args.descriptor),
                operation_id,
                ["target-click"],
                phase="dispatch_started",
                effect_state="dispatch-started",
                target_text=args.target_text,
                ack_status="pending",
            )
            code, readback_exit, stdout = run_cli_keep_alive_capture(
                config,
                config["roots"]["browser_use_home"],
                descriptor["port"],
                descriptor["session"],
                ["ax-click", args.target_text],
                recording=recording,
            )
            if code != 0:
                failure_marker = _LAST_RECORDING_CLI_FAILURE or str(code)
                dispatch_attempted = not target_resolution_failed_before_dispatch(failure_marker)
                raise Blocker("browser_use_target_click_failed", failure_marker)
            if readback_exit != 0:
                raise Blocker("browser_use_target_click_readback_failed", str(readback_exit))
            parsed = _parse_cli_json(stdout)
            data = parsed.get("data") if isinstance(parsed, dict) else None
            candidate = data.get("candidate") if isinstance(data, dict) else None
            before = data.get("before") if isinstance(data, dict) else None
            after_page = data.get("after") if isinstance(data, dict) else None
            dispatch_attempted = data.get("dispatch_started") is True if isinstance(data, dict) else False
            if not dispatch_attempted:
                raise Blocker("browser_use_target_click_dispatch_marker_missing")
            if not isinstance(candidate, dict) or not isinstance(before, dict) or not isinstance(after_page, dict):
                raise Blocker("browser_use_ax_target_click_readback_shape_invalid")
            if candidate.get("interactive") is not True:
                raise Blocker("browser_use_target_not_interactive")
            code, readback_exit, post_stdout = run_cli_keep_alive_capture(
                config,
                config["roots"]["browser_use_home"],
                descriptor["port"],
                descriptor["session"],
                ["state"],
                recording=recording,
            )
            if code != 0 or readback_exit != 0:
                raise Blocker("browser_use_target_post_click_readback_failed", str(readback_exit if readback_exit != 0 else code))
            post_parsed = _parse_cli_json(post_stdout)
            post_raw = _state_text_from_cli(post_parsed)
            _verified_navigation_with_checkpoint(config, descriptor, recording, os.path.realpath(args.descriptor))
            after_state = _target_state_summary(post_parsed, post_raw)
            descriptor["status"] = "continued"
            descriptor["operations"].append("target-click")
            descriptor["business_effect_proof"] = "workflow_source_of_truth_required"
            if not effect_evidence_binding_matches(descriptor, operation_id, ["target-click"], target_text=args.target_text):
                persist_effect_evidence(
                    config,
                    descriptor,
                    os.path.realpath(args.descriptor),
                    operation_id,
                    ["target-click"],
                    phase="unknown_effect",
                    effect_state="unknown-effect",
                    target_text=args.target_text,
                    ack_status="mismatch",
                    error_code="browser_use_effect_ack_binding_mismatch",
                )
                raise Blocker("browser_use_effect_ack_binding_mismatch")
            persist_effect_evidence(
                config,
                descriptor,
                os.path.realpath(args.descriptor),
                operation_id,
                ["target-click"],
                phase="acknowledged",
                effect_state="acknowledged",
                target_text=args.target_text,
                ack_status="validated_same_run_readback",
            )
            append_operation_outcome_durable(
                descriptor,
                operation_id=operation_id,
                command=["target-click"],
                external_effects="executed",
                outcome="post_click_readback_verified",
            )
            effect_proof_committed = True
            _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
            capture_recording_frame(
                config,
                config["roots"]["browser_use_home"],
                descriptor["port"],
                descriptor["session"],
                recording,
            )
            if descriptor.get("tab_inventory_path"):
                descriptor["tab_inventory"] = read_recording_tab_inventory(descriptor["tab_inventory_path"])
            _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
            print(json.dumps({
                "status": "recording_continued", "operation": "target-click",
                "descriptor": os.path.realpath(args.descriptor),
                "click_mode": "ax_backend_box_center", "candidate": candidate,
                "before_state": before, "after_page": after_page,
                "after_state": after_state,
                "state_changed": bool(data.get("state_changed")) or before != after_page,
                "external_effects": "executed", "business_effect_proof": "workflow_source_of_truth_required", "operation_id": operation_id,
                "authority_sha256": descriptor.get("authority_sha256"), "authority_generation": descriptor.get("authority_generation"), "authority_current_path": descriptor.get("authority_current_path"), "authority_expires_at": descriptor.get("authority_expires_at"),
                "finalized": False,
            }, sort_keys=True))
            return 0

        candidate, before = _target_capture(config, descriptor, recording, args.target_text)
        if candidate["interactive"]:
            click_command = ["click", str(candidate["index"])]
            click_mode = "fresh_index"
        else:
            if not args.allow_coordinate_fallback:
                raise Blocker("browser_use_target_coordinate_fallback_requires_explicit_opt_in")
            bbox = candidate["bbox"]
            x = round(float(bbox["x"]) + float(bbox["width"]) / 2, 2)
            y = round(float(bbox["y"]) + float(bbox["height"]) / 2, 2)
            click_command = ["click", _cli_coordinate(x), _cli_coordinate(y)]
            click_mode = "fresh_bbox_coordinate"
        validate_command(click_command, descriptor["mode"], config, list(descriptor["target_origins"]), descriptor["download_dir"])
        persist_effect_evidence(
            config,
            descriptor,
            os.path.realpath(args.descriptor),
            operation_id,
            ["target-click"],
            phase="dispatch_started",
            effect_state="dispatch-started",
            target_text=args.target_text,
            ack_status="pending",
        )
        dispatch_attempted = True
        code, readback_exit, _ = run_cli_keep_alive_capture(config, config["roots"]["browser_use_home"], descriptor["port"], descriptor["session"], click_command, recording=recording)
        if code != 0:
            raise Blocker("browser_use_target_click_failed", _LAST_RECORDING_CLI_FAILURE or str(code))
        if readback_exit != 0:
            raise Blocker("browser_use_target_click_readback_failed", str(readback_exit))
        code, readback_exit, post_stdout = run_cli_keep_alive_capture(config, config["roots"]["browser_use_home"], descriptor["port"], descriptor["session"], ["state"], recording=recording)
        if code != 0 or readback_exit != 0:
            raise Blocker("browser_use_target_post_click_readback_failed", str(readback_exit if readback_exit != 0 else code))
        post_parsed = _parse_cli_json(post_stdout)
        post_raw = _state_text_from_cli(post_parsed)
        _verified_navigation_with_checkpoint(config, descriptor, recording, os.path.realpath(args.descriptor))
        descriptor["status"] = "continued"
        descriptor["operations"].append("target-click")
        descriptor["business_effect_proof"] = "workflow_source_of_truth_required"
        if not effect_evidence_binding_matches(descriptor, operation_id, ["target-click"], target_text=args.target_text):
            persist_effect_evidence(
                config,
                descriptor,
                os.path.realpath(args.descriptor),
                operation_id,
                ["target-click"],
                phase="unknown_effect",
                effect_state="unknown-effect",
                target_text=args.target_text,
                ack_status="mismatch",
                error_code="browser_use_effect_ack_binding_mismatch",
            )
            raise Blocker("browser_use_effect_ack_binding_mismatch")
        persist_effect_evidence(
            config,
            descriptor,
            os.path.realpath(args.descriptor),
            operation_id,
            ["target-click"],
            phase="acknowledged",
            effect_state="acknowledged",
            target_text=args.target_text,
            ack_status="validated_same_run_readback",
        )
        append_operation_outcome_durable(
            descriptor,
            operation_id=operation_id,
            command=["target-click"],
            external_effects="executed",
            outcome="post_click_readback_verified",
        )
        effect_proof_committed = True
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
        capture_recording_frame(
            config,
            config["roots"]["browser_use_home"],
            descriptor["port"],
            descriptor["session"],
            recording,
        )
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
        print(json.dumps({"status": "recording_continued", "operation": "target-click", "descriptor": os.path.realpath(args.descriptor), "click_mode": click_mode, "candidate": candidate, "before_state": before, "after_state": _target_state_summary(post_parsed, post_raw), "state_changed": before["state_sha256"] != hashlib.sha256(post_raw.encode("utf-8")).hexdigest(), "external_effects": "executed", "business_effect_proof": "workflow_source_of_truth_required", "operation_id": operation_id, "authority_sha256": descriptor.get("authority_sha256"), "authority_generation": descriptor.get("authority_generation"), "authority_current_path": descriptor.get("authority_current_path"), "authority_expires_at": descriptor.get("authority_expires_at"), "finalized": False}, sort_keys=True))
        return 0
    except Exception as exc:
        current_effect_state = str((descriptor.get("effect_states") or {}).get(operation_id, {}).get("effect_state") or "pre-dispatch")
        if current_effect_state == "dispatch-started":
            persist_effect_evidence(
                config,
                descriptor,
                os.path.realpath(args.descriptor),
                operation_id,
                ["target-click"],
                phase="unknown_effect",
                effect_state="unknown-effect",
                target_text=args.target_text,
                ack_status="missing",
                error_code=exc.code if isinstance(exc, Blocker) else "target_click_exception",
            )
        elif current_effect_state == "pre-dispatch":
            persist_effect_evidence(
                config,
                descriptor,
                os.path.realpath(args.descriptor),
                operation_id,
                ["target-click"],
                phase="blocked",
                effect_state="pre-dispatch",
                target_text=args.target_text,
                ack_status="not_started",
                error_code=exc.code if isinstance(exc, Blocker) else "target_click_pre_dispatch_failed",
            )
        _record_target_operation_failure(
            config,
            args.descriptor,
            descriptor,
            operation="target-click",
            target_text=args.target_text,
            blocker=exc.code if isinstance(exc, Blocker) else "browser_use_target_click_failed",
            external_action_possible=dispatch_attempted and not effect_proof_committed,
            operation_id=operation_id,
        )
        failure_outcome = _target_click_failure_outcome(
            dispatch_attempted=dispatch_attempted,
            effect_proof_committed=effect_proof_committed,
            blocker=exc.code if isinstance(exc, Blocker) else "target_click_failed",
        )
        if failure_outcome is None:
            # The click's post-readback outcome is already durable.  Preserve
            # that proof and surface only the recording artifact failure.
            raise
        try:
            append_operation_outcome_durable(
                descriptor,
                operation_id=operation_id,
                command=["target-click"],
                external_effects=failure_outcome["external_effects"],
                outcome=failure_outcome["outcome"],
            )
            update_reconciliation_summary(descriptor)
            _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
        except Blocker as outcome_exc:
            # Do not report only the click failure when the ledger outcome is
            # itself unverifiable; the run is now blocked on reconciliation.
            raise outcome_exc from exc
        raise


def _parse_fixed_url_state_probe(stdout: str) -> tuple[str, str]:
    """Parse only the fixed URL/readyState probe; never retain page text."""
    parsed = _parse_cli_json(stdout)
    data = parsed.get("data") if isinstance(parsed, dict) else None
    result = data.get("result") if isinstance(data, dict) else None
    if not isinstance(result, str):
        raise Blocker("browser_use_semantic_readback_probe_shape_invalid")
    try:
        probe = json.loads(result)
    except (TypeError, ValueError, json.JSONDecodeError) as exc:
        raise Blocker("browser_use_semantic_readback_probe_json_invalid") from exc
    if not isinstance(probe, dict) or set(probe) != {"url", "ready_state"}:
        raise Blocker("browser_use_semantic_readback_probe_shape_invalid")
    url = probe.get("url")
    ready_state = probe.get("ready_state")
    if not isinstance(url, str) or not isinstance(ready_state, str):
        raise Blocker("browser_use_semantic_readback_probe_shape_invalid")
    return url, ready_state


def _fixed_url_state_probe(config: dict[str, Any], home: str, port: int, session: str, recording: dict[str, str]) -> tuple[str, str]:
    """Use the pinned Harness command path for a fixed URL/readiness probe.

    The probe is read-only, but the Harness attachment can briefly reject the
    first eval immediately after an upload or click dispatch. Retry only this
    bounded probe; never retry the effectful command that preceded it.
    """
    browser_harness_cli_enabled()
    expression = "JSON.stringify({url:location.href,ready_state:document.readyState})"
    retry_delays = (0.25, 0.5, 1.0)
    last_error: Exception | None = None
    for attempt in range(len(retry_delays) + 1):
        if attempt:
            time.sleep(retry_delays[attempt - 1])
        try:
            result_code, readback_exit, stdout = run_cli3_keep_alive_capture(
                config, home, port, session, ["eval", expression], recording=recording
            )
            if result_code != 0 or readback_exit != 0:
                last_error = Blocker("browser_use_semantic_readback_probe_command_failed")
                continue
            return _parse_fixed_url_state_probe(stdout)
        except Exception as exc:
            last_error = exc
    raise Blocker("browser_use_semantic_readback_probe_command_failed") from last_error


def _public_dns_proof(url: str) -> dict[str, Any]:
    parsed = urllib.parse.urlparse(url)
    host = parsed.hostname or ""
    try:
        addresses = sorted({item[4][0] for item in socket.getaddrinfo(host, parsed.port or 443, type=socket.SOCK_STREAM)})
    except OSError as exc:
        raise Blocker("browser_use_semantic_readback_dns_revalidation_failed", host) from exc
    private = [address for address in addresses if is_forbidden_ip(address)]
    return {
        "public_only": len(private) == 0 and len(addresses) > 0,
        "private_address_count": sum(1 for address in addresses if ipaddress.ip_address(address).is_private),
        "link_local_address_count": sum(1 for address in addresses if ipaddress.ip_address(address).is_link_local),
        "loopback_address_count": sum(1 for address in addresses if ipaddress.ip_address(address).is_loopback),
        "address_count": len(addresses),
    }


def _public_semantic_tuple(descriptor: dict[str, Any], command: list[str]) -> list[str]:
    origins = descriptor.get("target_origins")
    if descriptor.get("mode") != "public" or descriptor.get("lifecycle") != "single-use" or not isinstance(origins, list) or len(origins) != 1 or not isinstance(origins[0], str) or not origins[0]:
        raise Blocker("browser_use_semantic_readback_tuple_invalid")
    if command not in (["state"], ["get", "title"], ["get", "url"]):
        raise Blocker("browser_use_semantic_readback_command_not_allowlisted")
    return origins


def run_cli_semantic_readback(config: dict[str, Any], home: str, port: int, session: str, command: list[str], descriptor: dict[str, Any], recording: dict[str, str]) -> tuple[int, int | None, dict[str, Any]]:
    """Capture bounded semantic identity for one public working surface."""
    allowed_origins = _public_semantic_tuple(descriptor, command)
    browser_harness_cli_enabled()
    if command in (["state"], ["get", "url"]):
        state_url, ready = _fixed_url_state_probe(config, home, port, session, recording)
        if command == ["get", "url"]:
            url = state_url
            origin = preflight_url(url, allowed_origins, config["policy"]["unsafe_path_fragments"])
            dns = _public_dns_proof(url)
            if not dns["public_only"] or any(dns[key] != 0 for key in ("private_address_count", "link_local_address_count", "loopback_address_count")):
                raise Blocker("browser_use_semantic_readback_private_dns")
            return 0, 0, {"schema": "browser_use_semantic_readback.v1", "kind": "url", "url": url, "url_sha256": hashlib.sha256(url.encode("utf-8")).hexdigest(), "origin": origin, "origin_sha256": hashlib.sha256(origin.encode("utf-8")).hexdigest(), "redirect_hops": [], "redirect_count": 0, "final_dns_resolution": dns}
        if ready != "complete":
            raise Blocker("browser_use_semantic_readback_state_mismatch")
        origin = preflight_url(state_url, allowed_origins, config["policy"]["unsafe_path_fragments"])
        dns = _public_dns_proof(state_url)
        if not dns["public_only"] or any(dns[key] != 0 for key in ("private_address_count", "link_local_address_count", "loopback_address_count")):
            raise Blocker("browser_use_semantic_readback_private_dns")
        sanitized = {"ready_state": "complete", "url": state_url, "origin": origin, "redirect_count": 0, "dns_revalidation": True, "dns_private_address_count": dns["private_address_count"], "dns_link_local_address_count": dns["link_local_address_count"], "dns_loopback_address_count": dns["loopback_address_count"]}
        return 0, 0, {"schema": "browser_use_semantic_readback.v1", "kind": "state", "state": sanitized, "state_sha256": hashlib.sha256(json.dumps(sanitized, sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()}
    result_code, readback_exit, stdout = run_cli3_keep_alive_capture(
        config, home, port, session, command, recording=recording
    )
    if result_code != 0 or readback_exit != 0:
        failure_code = result_code if result_code != 0 else (readback_exit or 1)
        return failure_code, failure_code, {"schema": "browser_use_semantic_readback.v1", "exact_blocker": "browser_use_semantic_readback_command_failed"}
    parsed = _parse_cli_json(stdout)
    if command == ["get", "title"]:
        title = _first_field(parsed, {"title", "value", "result"})
        if not isinstance(title, str) or not title:
            raise Blocker("browser_use_semantic_readback_title_mismatch")
        return result_code, 0, {"schema": "browser_use_semantic_readback.v1", "kind": "title", "title_sha256": hashlib.sha256(title.encode("utf-8")).hexdigest(), "title_length": len(title)}
    raise Blocker("browser_use_semantic_readback_command_not_allowlisted")


def recording_descriptor_path(config: dict[str, Any], run_id: str, session: str, nonce: str) -> str:
    run_root = os.path.join(recording_descriptor_root(config), run_id)
    assert_directory(run_root, create=True)
    return os.path.join(run_root, f"{session}-{nonce}.json")


def read_recording_descriptor(config: dict[str, Any], path: str, run_id: str, session: str, *, allow_finalized: bool = False, allow_helper_hash_mismatch: bool = False, allow_pinned_helper_reexec: bool = False, allow_expired_temporary: bool = False, allow_stale_runtime_recovery: bool = False, allow_history_reconciliation: bool = False) -> dict[str, Any]:
    path = os.path.realpath(path)
    assert_recording_descriptor_path(config, path)
    value = read_json_safe(path)
    required = {"schema", "status", "mode", "lifecycle", "run_id", "session", "automation_id", "nonce", "helper_sha256", "recording_dir", "status_path", "recording_framerate", "port", "process", "owned_chrome", "profile", "download_dir", "lock_paths", "target_origins", "authority_sha256", "account_identity", "operations"}
    missing = sorted(required - value.keys())
    if missing:
        raise Blocker("browser_use_recording_descriptor_fields_missing", ",".join(missing))
    allowed_statuses = set(RECORDING_STATUSES) | ({"finalized"} if allow_finalized else set())
    if value["schema"] != RECORDING_SCHEMA or value["status"] not in allowed_statuses:
        raise Blocker("browser_use_recording_descriptor_schema_or_status_invalid")
    if value["run_id"] != run_id or value["session"] != session:
        raise Blocker("browser_use_recording_descriptor_binding_mismatch")
    if not isinstance(value["helper_sha256"], str) or not re.fullmatch(r"[0-9a-f]{64}", value["helper_sha256"]):
        raise Blocker("browser_use_recording_helper_hash_invalid")
    recording_dir = value["recording_dir"]
    if not isinstance(recording_dir, str) or not os.path.isabs(recording_dir) or os.path.realpath(recording_dir) != recording_dir:
        raise Blocker("browser_use_recording_dir_noncanonical")
    assert_directory(recording_dir)
    current_helper = canonical_helper_path()
    current_helper_matches = value["helper_sha256"] == sha256_trusted_helper(current_helper)
    if value.get("helper_snapshot_path"):
        validate_helper_snapshot(value)
    if not current_helper_matches and not allow_helper_hash_mismatch:
        pinned_helper = validate_helper_snapshot(value)
        if allow_pinned_helper_reexec and pinned_helper and current_helper != pinned_helper:
            try:
                os.execve(pinned_helper, [pinned_helper, *sys.argv[1:]], os.environ.copy())
            except OSError as exc:
                raise Blocker("browser_use_recording_pinned_helper_reexec_failed", type(exc).__name__) from exc
            raise Blocker("browser_use_recording_pinned_helper_reexec_unavailable")
        raise Blocker("browser_use_recording_helper_hash_mismatch")
    requested_session = value.get("requested_session")
    if requested_session is not None:
        validate_id(requested_session, "session")
        if canonical_session_id(requested_session, config["roots"]["browser_use_home"]) != session:
            raise Blocker("browser_use_session_binding_invalid")
    safe_id(value["automation_id"], "automation_id")
    safe_id(value["nonce"], "nonce")
    if value["mode"] not in {"public", "authorized"} or value["lifecycle"] not in {"single-use", "scheduled", TEMPORARY_LIFECYCLE}:
        raise Blocker("browser_use_recording_descriptor_mode_invalid")
    lifecycle = str(value["lifecycle"])
    if lifecycle == TEMPORARY_LIFECYCLE:
        for field in ("task_id", "creation_binding", "authority_scope"):
            if field not in value:
                raise Blocker("browser_use_temporary_recording_fields_missing", field)
        if value["mode"] != "authorized":
            raise Blocker("browser_use_temporary_requires_authorized_mode")
    # A recording bound to a login handoff intentionally points at the
    # handoff-owned profile. Validate that profile against the source
    # handoff's lifecycle, not the destination recording's lifecycle. The
    # start path rejects a mismatch before recording begins; this branch also
    # lets terminal cleanup close a previously started mismatched recording
    # without deleting the shared handoff profile.
    profile_lifecycle = lifecycle
    source_profile_removed = False
    if value.get("source_handoff_descriptor"):
        source_path = os.path.realpath(str(value["source_handoff_descriptor"]))
        source_run_id = safe_id(value.get("source_run_id"), "run_id")
        source_session = validate_id(value.get("source_session"), "session")
        if os.path.lexists(source_path):
            source = read_handoff(config, source_path, source_run_id, source_session, require_unexpired=False)
            profile_lifecycle = str(source.get("lifecycle", lifecycle))
            source_profile_removed = (
                source.get("profile") == value.get("profile")
                and isinstance(source.get("cleanup_state"), dict)
                and source["cleanup_state"].get("profile_removed") is True
                and source["cleanup_state"].get("temporary_profile_removed") is True
            )
        elif (
            (
                allow_stale_runtime_recovery
                and value["status"] in {"continued", "cleanup_pending"}
            )
            or (
                allow_history_reconciliation
                and value["status"] in {"stale", "cleanup_pending", "finalized"}
            )
        ) and _recording_source_cleanup_marker(config, value) is not None:
            # A completed stale-handoff cleanup intentionally replaces the
            # consumed source descriptor with an immutable completion marker.
            # Allow only that exact run-bound marker to satisfy the read-only
            # descriptor binding; live/normal paths still require the handoff.
            marker = _recording_source_cleanup_marker(config, value)
            if marker is None:
                read_handoff(config, source_path, source_run_id, source_session, require_unexpired=False)
            profile_lifecycle = lifecycle
        else:
            source = read_handoff(config, source_path, source_run_id, source_session, require_unexpired=False)
            profile_lifecycle = str(source.get("lifecycle", lifecycle))
    profile_root = os.path.realpath(config["roots"]["scheduled_profiles"] if profile_lifecycle == "scheduled" else config["roots"]["single_use_profiles"] if profile_lifecycle == "single-use" else config["roots"]["temporary_profiles"])
    if not isinstance(value["profile"], str) or os.path.realpath(value["profile"]) != value["profile"] or not value["profile"].startswith(profile_root + os.sep):
        raise Blocker("browser_use_recording_profile_scope_mismatch")
    if lifecycle == "scheduled" and not value.get("source_handoff_descriptor") and os.path.realpath(value["profile"]) != os.path.join(profile_root, value["automation_id"]):
        raise Blocker("browser_use_recording_scheduled_profile_binding_mismatch")
    if lifecycle == TEMPORARY_LIFECYCLE:
        if os.path.realpath(value["profile"]) != temporary_profile_path(config, value["creation_binding"]):
            raise Blocker("browser_use_temporary_recording_profile_binding_mismatch")
        room_id = value.get("room_id")
        if room_id:
            room = room_registry_lookup(config, room_id)
            if room is None or room.get("profile") != os.path.realpath(value["profile"]) or int(room.get("port", -1)) != int(value["port"]):
                raise Blocker("browser_use_temporary_recording_room_binding_mismatch")
        elif int(value["port"]) != temporary_port(config, value["creation_binding"]):
            raise Blocker("browser_use_temporary_fixed_port_mismatch")
        if os.path.lexists(value["profile"]):
            profile_owner_automation_id = value.get("profile_owner_automation_id") or value["automation_id"]
            profile_owner_task_id = value.get("profile_owner_task_id") or value["task_id"]
            profile_owner_run_id = value.get("profile_owner_run_id") or value["run_id"]
            profile_owner_authority_sha256 = value.get("profile_owner_authority_sha256") or value["authority_sha256"]
            profile_owner_authority_scope = value.get("profile_owner_authority_scope") or value["authority_scope"]
            profile_owner_origins = value.get("profile_owner_origins") or value["target_origins"]
            # Older shared-profile descriptors predate the explicit owner-run
            # and owner-authority fields.  Reconstruct those immutable fields
            # only from the exact, still-bound lease and marker; never trust a
            # current run value for the retained profile's marker.
            shared_lease_path = value.get("shared_profile_lease_path")
            if shared_lease_path and (not value.get("profile_owner_run_id") or not value.get("profile_owner_authority_sha256")):
                shared_lease_path = os.path.realpath(str(shared_lease_path))
                shared_root = os.path.realpath(shared_profile_lease_root(config, create=False))
                if shared_lease_path != value.get("shared_profile_lease_path") or not shared_lease_path.startswith(shared_root + os.sep):
                    raise Blocker("browser_use_shared_profile_lease_scope_mismatch")
                assert_regular_file(shared_lease_path, mode=0o600)
                shared_lease = read_json_safe(shared_lease_path)
                if (
                    shared_lease.get("schema") != SHARED_PROFILE_LEASE_SCHEMA
                    or shared_lease.get("state") not in {"claimed", "releasing"}
                    or shared_lease.get("run_id") != value["run_id"]
                    or shared_lease.get("session") != value["session"]
                    or shared_lease.get("task_id") != value["task_id"]
                    or os.path.realpath(str(shared_lease.get("profile") or "")) != os.path.realpath(value["profile"])
                    or shared_lease.get("creation_binding") != value["creation_binding"]
                    or shared_lease.get("profile_marker_sha256") != value.get("shared_profile_marker_sha256")
                ):
                    raise Blocker("browser_use_shared_profile_lease_binding_mismatch")
                marker_path = os.path.join(value["profile"], ".browser-use-profile.json")
                assert_regular_file(marker_path, mode=0o600)
                if sha256_file(marker_path) != value.get("shared_profile_marker_sha256"):
                    raise Blocker("browser_use_shared_profile_marker_changed")
                shared_marker = read_json_safe(marker_path)
                profile_owner_automation_id = shared_marker.get("automation_id") or profile_owner_automation_id
                profile_owner_task_id = shared_marker.get("task_id") or profile_owner_task_id
                profile_owner_run_id = shared_marker.get("run_id") or profile_owner_run_id
                profile_owner_authority_sha256 = shared_marker.get("authority_sha256") or profile_owner_authority_sha256
                profile_owner_authority_scope = shared_marker.get("authority_scope") or profile_owner_authority_scope
                profile_owner_origins = shared_marker.get("origins") or profile_owner_origins
                value.update({
                    "profile_owner_automation_id": profile_owner_automation_id,
                    "profile_owner_task_id": profile_owner_task_id,
                    "profile_owner_run_id": profile_owner_run_id,
                    "profile_owner_authority_sha256": profile_owner_authority_sha256,
                    "profile_owner_authority_scope": profile_owner_authority_scope,
                    "profile_owner_origins": profile_owner_origins,
                })
            validate_temporary_marker(config, value["profile"], {
                "mode": value["mode"], "lifecycle": lifecycle, "automation_id": profile_owner_automation_id, "task_id": profile_owner_task_id, "run_id": profile_owner_run_id, "creation_binding": value["creation_binding"], "canonical_profile": value["profile"], "port": value["port"], "authority_sha256": profile_owner_authority_sha256, "authority_scope": profile_owner_authority_scope, "account_identity": value["account_identity"], "origins": profile_owner_origins,
            }, require_unexpired=(not allow_expired_temporary) and value["status"] not in {"finalized", "cleanup_pending"})
            if value["status"] not in {"finalized", "cleanup_pending"} and not allow_stale_runtime_recovery:
                assert_owned_locks(value["lock_paths"], value["run_id"], value["nonce"])
        elif value["status"] != "finalized" and not (
            (value.get("cleanup_state") or {}).get("profile_removed")
            or source_profile_removed
        ):
            if allow_history_reconciliation and value["status"] in {"stale", "cleanup_pending", "finalized"} and (
                value["status"] in {"stale", "finalized"}
                or (value.get("cleanup_state") or {}).get("profile_removed") is True
                or (value.get("cleanup_state") or {}).get("temporary_profile_removed") is True
            ):
                pass
            elif not (
                allow_stale_runtime_recovery
                and value["status"] in {"continued", "cleanup_pending"}
                and _recording_source_cleanup_marker(config, value) is not None
            ):
                raise Blocker("browser_use_temporary_profile_missing")
    if value["status_path"] != recording_status_path(recording_dir):
        raise Blocker("browser_use_recording_status_path_binding_mismatch")
    if "helper_snapshot_path" in value and not allow_helper_hash_mismatch:
        validate_helper_snapshot(value)
    tab_inventory_path = value.get("tab_inventory_path")
    if tab_inventory_path is not None:
        expected_tab_inventory_path = os.path.join(recording_dir, "tab-inventory.json")
        if tab_inventory_path != expected_tab_inventory_path or not os.path.isabs(tab_inventory_path) or os.path.realpath(tab_inventory_path) != tab_inventory_path:
            raise Blocker("browser_use_recording_tab_inventory_path_binding_invalid")
    if not isinstance(value["recording_framerate"], int) or not 1 <= value["recording_framerate"] <= 60:
        raise Blocker("browser_use_recording_framerate_invalid")
    if not isinstance(value["target_origins"], list) or not value["target_origins"]:
        raise Blocker("browser_use_recording_origins_missing")
    if value["owned_chrome"] not in {True, False}:
        raise Blocker("browser_use_recording_process_binding_invalid")
    process = value["process"]
    if not isinstance(process, dict) or not isinstance(process.get("root_pid"), int) or not isinstance(process.get("root_start_time"), (int, float)):
        raise Blocker("browser_use_recording_process_identity_invalid")
    if not isinstance(value["lock_paths"], list) or not all(isinstance(item, str) for item in value["lock_paths"]):
        raise Blocker("browser_use_recording_lock_binding_invalid")
    if not isinstance(value["operations"], list):
        raise Blocker("browser_use_recording_operations_invalid")
    if "operation_ledger_path" in value:
        operation_ledger_path(value)
    if "checkpoint_path" in value:
        checkpoint = value["checkpoint_path"]
        if not isinstance(checkpoint, str) or os.path.realpath(os.path.dirname(checkpoint)) != os.path.realpath(recording_dir):
            raise Blocker("browser_use_recording_checkpoint_scope_invalid")
    if value.get("cleanup_capability_path"):
        read_recording_cleanup_capability(config, value)
    return value


def recording_authority(config: dict[str, Any], descriptor: dict[str, Any], authority_path: str | None, *, cleanup_only: bool = False, command_class: str | None = None, renewal_path: str | None = None, auto_renew: bool = False) -> dict[str, Any] | None:
    if descriptor["mode"] == "public":
        return None
    capability: dict[str, Any] | None = None
    if cleanup_only and descriptor.get("cleanup_capability_path"):
        capability = read_recording_cleanup_capability(config, descriptor)
    if not authority_path and capability is None:
        # A descriptor is the current-run authority source of truth.  Normal
        # continuation/finalize callers must not retype this path.
        authority_path = descriptor.get("authority_current_path") or descriptor.get("authority_path")
        if not authority_path:
            raise Blocker("browser_use_authority_required")
    requested_session = descriptor.get("requested_session")
    aliases = session_aliases(config, requested_session, descriptor["session"]) if isinstance(requested_session, str) else []
    current_path: str | None = None
    if capability is not None and not authority_path:
        scope = capability["authority_scope"]
        authority = {
            "browser_surface": "browser_use_cli",
            "run_id": descriptor["run_id"],
            "session": descriptor["session"],
            "expires_at": scope.get("expires_at"),
            "authority_lineage_expires_at": scope.get("authority_lineage_expires_at"),
            "allowed_origins": list(scope.get("allowed_origins", [])),
            "account_identity": scope.get("account_identity"),
            "data_exposure": scope.get("data_exposure"),
            "side_effect_scope": scope.get("side_effect_scope"),
            "approval": scope.get("approval"),
            "readback_required": scope.get("readback_required"),
        }
        if not authority["account_identity"] or authority["readback_required"] is not True:
            raise Blocker("browser_use_recording_cleanup_capability_invalid")
    else:
        supplied_path = assert_authority_file(str(authority_path))
        current_path = assert_authority_file(str(descriptor.get("authority_current_path") or supplied_path))
        if descriptor.get("authority_current_path") and sha256_file(current_path) != descriptor["authority_sha256"]:
            raise Blocker("browser_use_authority_generation_lineage_mismatch")
        supplied_digest = sha256_file(supplied_path)
        if supplied_digest != descriptor["authority_sha256"]:
            # An old path may be supplied after a successful renewal.  Continue only
            # with the descriptor's immutable current generation; never reinterpret
            # the old file as current authority.
            if current_path == supplied_path:
                raise Blocker("browser_use_recording_authority_changed")
            if renewal_path is None and not os.path.lexists(current_path):
                raise Blocker("browser_use_authority_generation_lineage_mismatch")
        authority = parse_authority(
            current_path,
            descriptor["run_id"],
            descriptor["session"],
            aliases=aliases,
            require_unexpired=not cleanup_only and renewal_path is None and not auto_renew,
        )
    if command_class and auto_renew and renewal_path is None and not cleanup_only:
        budget = remaining_authority_budget(authority, command_class)
        if not budget["sufficient"]:
            renewal_path = automatic_authority_renewal_path(config, descriptor, current_path, command_class, budget)
    if renewal_path:
        if current_path is None:
            raise Blocker("browser_use_authority_renewal_requires_authority_file")
        authority = renew_recording_authority(config, descriptor, current_path, renewal_path)
        current_path = os.path.realpath(renewal_path)
    elif current_path is not None and sha256_file(current_path) != descriptor["authority_sha256"]:
        raise Blocker("browser_use_recording_authority_changed")
    if descriptor["account_identity"] != authority["account_identity"]:
        raise Blocker("browser_use_recording_account_identity_mismatch")
    if not set(descriptor["target_origins"]).issubset({normalize_origin(item) for item in authority["allowed_origins"]}):
        raise Blocker("browser_use_recording_origin_not_authorized")
    if command_class and not cleanup_only:
        admit_authority_budget(config, descriptor, authority, command_class)
    return authority


def validate_recording_process(config: dict[str, Any], descriptor: dict[str, Any], *, allow_cleanup_complete: bool = False) -> None:
    if descriptor.get("source_handoff_descriptor"):
        source_path = descriptor["source_handoff_descriptor"]
        try:
            source = read_handoff(config, source_path, descriptor["source_run_id"], descriptor["source_session"], require_unexpired=True)
        except Blocker as exc:
            if allow_cleanup_complete and exc.code == "browser_use_path_missing" and _recording_source_cleanup_marker(config, descriptor) is not None:
                assert_debug_listener_absent(int(descriptor["port"]))
                return
            raise
        validate_handoff_identity(config, source)
        return
    validate_handoff_process_identity(
        config,
        {"process": descriptor["process"], "port": descriptor["port"], "profile": descriptor["profile"]},
        allow_missing=False,
    )


def _recording_runtime_is_stale(config: dict[str, Any], descriptor: dict[str, Any]) -> bool:
    """Freshly distinguish a dead owned runtime from a live normal path."""
    if descriptor.get("owned_chrome") is not True:
        return False
    try:
        process_present = validate_handoff_process_identity(
            config,
            {"process": descriptor["process"], "port": descriptor["port"], "profile": descriptor["profile"]},
            allow_missing=True,
        )
        if process_present is False:
            _close_stale_recording_daemon_if_present(config, descriptor)
            return True
    except Blocker as exc:
        if exc.code == "browser_use_handoff_chrome_missing":
            _close_stale_recording_daemon_if_present(config, descriptor)
            return True
        raise
    return False


def _stale_runtime_lock_paths(config: dict[str, Any], descriptor: dict[str, Any]) -> list[str]:
    """Return only the two exact locks that a temporary recording can own."""
    if descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE or descriptor.get("owned_chrome") is not True:
        raise Blocker("browser_use_recording_stale_runtime_unsupported")
    expected = {
        os.path.realpath(temporary_profile_lock_path(config, descriptor["profile"])),
        os.path.realpath(temporary_port_lock_path(config, int(descriptor["port"]))),
    }
    actual = descriptor.get("lock_paths")
    if not isinstance(actual, list) or {os.path.realpath(str(path)) for path in actual} != expected or len(actual) != len(expected):
        raise Blocker("browser_use_recording_recovery_lock_binding_invalid")
    return sorted(expected)


def _release_stale_runtime_locks(config: dict[str, Any], descriptor: dict[str, Any]) -> list[str]:
    """Preflight every exact lock, then release only locks owned by this run."""
    paths = _stale_runtime_lock_paths(config, descriptor)
    for path in paths:
        if not os.path.lexists(path):
            continue
        value = read_json_safe(path)
        if value.get("run_id") != descriptor["run_id"] or value.get("nonce") != descriptor["nonce"]:
            raise Blocker("browser_use_recording_recovery_foreign_lock", path)
        if value.get("canonical_profile") != os.path.realpath(descriptor["profile"]):
            raise Blocker("browser_use_recording_recovery_lock_binding_invalid", path)
        if int(value.get("port", -1)) != int(descriptor["port"]):
            raise Blocker("browser_use_recording_recovery_lock_binding_invalid", path)
    for path in paths:
        release_lock(path, descriptor["run_id"], descriptor["nonce"])
    if any(os.path.lexists(path) for path in paths):
        raise Blocker("browser_use_recording_recovery_lock_release_readback_failed")
    return paths


def _acquire_stale_cleanup_locks(config: dict[str, Any], descriptor: dict[str, Any]) -> list[str]:
    """Reclaim the exact temporary locks as an atomic deletion guard.

    A restartable recovery may have released both locks before the user asks
    for profile deletion.  Reclaiming them with ``O_EXCL`` closes the window
    between absence readback and profile deletion; a foreign claimant fails
    closed and no profile is touched.
    """
    paths = _stale_runtime_lock_paths(config, descriptor)
    profile = os.path.realpath(str(descriptor["profile"]))
    payload = {
        "schema": "browser-use-lock.v1",
        "run_id": descriptor["run_id"],
        "nonce": descriptor["nonce"],
        "helper_pid": os.getpid(),
        "helper_start_time": psutil.Process(os.getpid()).create_time() if psutil is not None else 0.0,
        "automation_id": descriptor.get("automation_id"),
        "task_id": descriptor.get("task_id"),
        "port": int(descriptor["port"]),
        "canonical_profile": profile,
        "lifecycle": TEMPORARY_LIFECYCLE,
        "cleanup_guard": True,
    }
    created: list[str] = []
    try:
        for path in paths:
            if os.path.lexists(path):
                value = read_json_safe(path)
                if (
                    value.get("run_id") != descriptor["run_id"]
                    or value.get("nonce") != descriptor["nonce"]
                    or value.get("canonical_profile") != profile
                    or int(value.get("port", -1)) != int(descriptor["port"])
                ):
                    raise Blocker("browser_use_recording_recovery_foreign_lock", path)
        for path in paths:
            if not os.path.lexists(path):
                lock_file(path, payload)
                created.append(path)
        assert_owned_locks(paths, descriptor["run_id"], descriptor["nonce"])
        return paths
    except Exception:
        for path in created:
            try:
                release_lock(path, descriptor["run_id"], descriptor["nonce"])
            except Exception:
                pass
        raise


def reconcile_stale_recording_runtime(config: dict[str, Any], descriptor: dict[str, Any], descriptor_path: str, *, max_attempts: int) -> dict[str, Any]:
    """Make a dead temporary recording restartable without touching its profile or effects."""
    current_state = str(descriptor.get("recovery_state") or "")
    paths = _stale_runtime_lock_paths(config, descriptor)
    room_id = descriptor.get("room_id")
    room = room_registry_lookup(config, room_id) if room_id else None
    if current_state == "restartable" and all(not os.path.lexists(path) for path in paths) and room and room.get("state") == "held":
        pending = pending_operation_reconciliation_ids(descriptor)
        return {
            "status": "recording_recovered",
            "descriptor": os.path.realpath(descriptor_path),
            "run_id": descriptor["run_id"],
            "session": descriptor["session"],
            "recovery_state": "restartable",
            "recording_status": "abandoned",
            "pending_reconciliation": pending,
            "effectful_resume_allowed": not pending,
            "idempotent": True,
            "finalized": False,
        }
    try:
        max_attempts = max(1, min(int(max_attempts), MAX_RECORDING_RECOVERY_ATTEMPTS))
    except (TypeError, ValueError) as exc:
        raise Blocker("browser_use_recording_recovery_attempts_invalid") from exc
    descriptor_max = int(descriptor.get("recovery_max_attempts", max_attempts))
    descriptor_max = max(1, min(descriptor_max, MAX_RECORDING_RECOVERY_ATTEMPTS))
    prior_attempts = int(descriptor.get("recovery_retry_count", 0))
    if prior_attempts >= descriptor_max:
        raise Blocker("browser_use_recording_recovery_attempt_limit", "fresh same-task record-start after reconciliation")

    pending = close_orphan_operation_intents(descriptor)
    if room_id:
        if room is None:
            raise Blocker("browser_use_recording_recovery_room_missing")
        room_registry_update(config, room_id, run_id=descriptor["run_id"], state="held", activity="record-recover")
    _release_stale_runtime_locks(config, descriptor)
    mark_recording_abandoned(descriptor["status_path"], reason="owned Chrome process and both listeners absent")
    descriptor.update(
        {
            "status": "stale",
            "recovery_state": "restartable",
            "recovery_max_attempts": descriptor_max,
            "recovery_retry_count": prior_attempts + 1,
            "stale_state": {
                "state": "abandoned",
                "uncertain": True,
                "exact_blocker": "browser_use_recording_stale_runtime_reconciled",
                "updated_at": iso(now_utc()),
            },
            "recording_status_state": "abandoned",
        }
    )
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_recording_stale_runtime_reconciled",
        next_action="fresh same-task record-start with the bound profile/port/room; reconcile unknown external effects before effectful retry",
    )
    _write_recording_descriptor(config, os.path.realpath(descriptor_path), descriptor, replace=True)
    pending_after = pending_operation_reconciliation_ids(descriptor)
    return {
        "status": "recording_recovered",
        "descriptor": os.path.realpath(descriptor_path),
        "run_id": descriptor["run_id"],
        "session": descriptor["session"],
        "recovery_state": "restartable",
        "recording_status": "abandoned",
        "pending_reconciliation": pending_after,
        "effectful_resume_allowed": not pending_after,
        "attempts": 1,
        "checkpoint": checkpoint,
        "finalized": False,
    }


def _read_stale_handoff_recording_source(config: dict[str, Any], descriptor: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    """Read and bind the exact handoff borrowed by a stale recording."""
    source_path_value = descriptor.get("source_handoff_descriptor")
    if not isinstance(source_path_value, str) or not source_path_value:
        raise Blocker("browser_use_recording_handoff_source_missing")
    source_path = os.path.realpath(source_path_value)
    source_run_id = safe_id(descriptor.get("source_run_id"), "run_id")
    source_session = validate_id(descriptor.get("source_session"), "session")
    source = read_handoff(config, source_path, source_run_id, source_session, require_unexpired=False)
    if (
        source.get("profile") != descriptor.get("profile")
        or int(source.get("port", -1)) != int(descriptor.get("port", -2))
        or source.get("room_id") != descriptor.get("room_id")
        or source.get("run_id") != descriptor.get("run_id")
        or source.get("session") != descriptor.get("session")
    ):
        raise Blocker("browser_use_recording_handoff_binding_mismatch")
    source_process = source.get("process") or {}
    recording_process = descriptor.get("process") or {}
    if (
        source_process.get("root_pid") != recording_process.get("root_pid")
        or float(source_process.get("root_start_time", -1)) != float(recording_process.get("root_start_time", -2))
    ):
        raise Blocker("browser_use_recording_handoff_process_binding_mismatch")
    if not os.path.lexists(source["profile"]):
        raise Blocker("browser_use_recording_handoff_profile_missing")
    return source_path, source


def _verify_stale_handoff_recording_runtime_absent(config: dict[str, Any], descriptor: dict[str, Any], source: dict[str, Any]) -> dict[str, Any]:
    """Close only this session's Harness daemon and prove the borrowed runtime is gone."""
    try:
        process_present = validate_handoff_process_identity(config, source, allow_missing=True)
    except Blocker as exc:
        if exc.code == "browser_use_handoff_chrome_missing":
            process_present = False
        else:
            raise
    if process_present:
        raise Blocker("browser_use_recording_cleanup_process_still_live")
    assert_debug_listener_absent(int(source["port"]))
    runtime = os.path.join(browser_harness_root(descriptor["session"]), "runtime")
    daemon_paths = [os.path.join(runtime, name) for name in ("bu.sock", "bu.pid", "bu.port")]
    daemon_present = any(os.path.lexists(path) for path in daemon_paths)
    if daemon_present:
        closed, blocker = close_owned_daemon_if_active(
            config,
            config["roots"]["browser_use_home"],
            int(source["port"]),
            descriptor["session"],
        )
        if not closed:
            raise Blocker(blocker or "browser_use_daemon_cleanup_unverified")
    elif os.path.lexists(browser_harness_root(descriptor["session"])) and not cleanup_browser_harness_root(descriptor["session"]):
        raise Blocker("browser_use_harness_root_cleanup_unverified")
    if any(os.path.lexists(path) for path in daemon_paths):
        raise Blocker("browser_use_daemon_cleanup_unverified")
    assert_debug_listener_absent(int(source["port"]))
    return {
        "process_absent": True,
        "listener_absent": True,
        "daemon_absent": True,
        "profile_preserved": True,
        "download_dir_preserved": True,
    }


def _read_borrowed_handoff_recording_source(config: dict[str, Any], descriptor: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    """Read the exact source lease for cleanup-only borrowed recordings."""
    if descriptor.get("status") not in {"continued", "cleanup_pending"} or descriptor.get("owned_chrome") is not False:
        raise Blocker("browser_use_recording_borrowed_handoff_cleanup_unsupported")
    source_value = descriptor.get("source_handoff_descriptor")
    if not isinstance(source_value, str) or not source_value:
        raise Blocker("browser_use_recording_handoff_source_missing")
    source_path = os.path.realpath(source_value)
    if not os.path.lexists(source_path):
        raise Blocker("browser_use_recording_handoff_source_missing")
    source_run_id = safe_id(descriptor.get("source_run_id") or descriptor.get("run_id"), "run_id")
    source_session = validate_id(descriptor.get("source_session") or descriptor.get("session"), "session")
    source = read_handoff(config, source_path, source_run_id, source_session, require_unexpired=False)
    if source.get("lifecycle") != TEMPORARY_LIFECYCLE or source.get("mode") != "authorized":
        raise Blocker("browser_use_recording_handoff_binding_mismatch")
    if source.get("lease_path") not in {source_path, _handoff_base_path(source_path)}:
        raise Blocker("browser_use_recording_handoff_binding_mismatch")
    _borrowed_handoff_profile_state(source)
    return source_path, source


def _borrowed_handoff_profile_state(source: dict[str, Any]) -> dict[str, Any]:
    """Classify an exact handoff profile without recreating or deleting it."""
    profile = source.get("profile")
    if not isinstance(profile, str) or not os.path.isabs(profile) or os.path.realpath(profile) != profile:
        raise Blocker("browser_use_recording_handoff_profile_binding_mismatch")
    if os.path.lexists(profile):
        return {"profile_preserved": True, "profile_removed": False, "profile_missing": False}
    cleanup_state = source.get("cleanup_state") if isinstance(source.get("cleanup_state"), dict) else {}
    if cleanup_state.get("profile_removed") is True and cleanup_state.get("temporary_profile_removed") is True:
        return {"profile_preserved": False, "profile_removed": True, "profile_missing": True}
    raise Blocker("browser_use_recording_handoff_profile_missing")


def _rebind_borrowed_handoff_recording_descriptor(config: dict[str, Any], descriptor: dict[str, Any]) -> tuple[str, dict[str, Any]]:
    """Rebind cleanup identity to the source handoff before any release."""
    source_path, source = _read_borrowed_handoff_recording_source(config, descriptor)
    for key in ("run_id", "session", "task_id", "room_id", "profile", "port", "process"):
        descriptor[key] = source.get(key)
    descriptor["source_run_id"] = source["run_id"]
    descriptor["source_session"] = source["session"]
    descriptor["source_nonce"] = source["nonce"]
    descriptor["lock_paths"] = list(source["lock_paths"])
    descriptor["status"] = "cleanup_pending"
    return source_path, source


def _borrowed_handoff_lock_paths(config: dict[str, Any], source: dict[str, Any]) -> list[str]:
    """Require the source descriptor's two exact temporary lock paths."""
    paths = handoff_lock_paths(config, source, allow_released=True)
    expected = {
        os.path.realpath(temporary_profile_lock_path(config, source["profile"])),
        os.path.realpath(temporary_port_lock_path(config, int(source["port"]))),
    }
    if {os.path.realpath(path) for path in paths} != expected or len(paths) != len(expected):
        raise Blocker("browser_use_recording_handoff_lock_binding_mismatch")
    return sorted(expected)


def _release_borrowed_handoff_locks(config: dict[str, Any], source: dict[str, Any]) -> list[str]:
    """Release only source-owned locks after a complete foreign-owner preflight."""
    paths = _borrowed_handoff_lock_paths(config, source)
    for path in paths:
        if not os.path.lexists(path):
            continue
        value = read_json_safe(path)
        if (
            value.get("schema") != "browser-use-lock.v1"
            or value.get("run_id") != source["run_id"]
            or value.get("nonce") != source["nonce"]
            or value.get("canonical_profile") != os.path.realpath(source["profile"])
            or int(value.get("port", -1)) != int(source["port"])
        ):
            raise Blocker("browser_use_recording_recovery_foreign_lock", path)
    released_ok, release_error, released = _release_lock_set(paths, source["run_id"], source["nonce"])
    if not released_ok:
        raise Blocker(release_error or "browser_use_handoff_lock_cleanup_uncertain")
    return released


def _verify_borrowed_handoff_runtime_absent(config: dict[str, Any], descriptor: dict[str, Any], source: dict[str, Any]) -> dict[str, Any]:
    """Freshly prove the borrowed Chrome, listener, and Harness runtime are gone."""
    try:
        process_present = validate_handoff_process_identity(config, source, allow_missing=True)
    except Blocker as exc:
        if exc.code == "browser_use_handoff_chrome_missing":
            process_present = False
        else:
            raise
    if process_present:
        raise Blocker("browser_use_recording_cleanup_process_still_live")
    assert_debug_listener_absent(int(source["port"]))
    runtime = os.path.join(browser_harness_root(source["session"]), "runtime")
    daemon_paths = [os.path.join(runtime, name) for name in ("bu.sock", "bu.pid", "bu.port")]
    if any(os.path.lexists(path) for path in daemon_paths):
        raise Blocker("browser_use_recording_daemon_still_present")
    return {
        "process_absent": True,
        "listener_absent": True,
        "daemon_absent": True,
        **_borrowed_handoff_profile_state(source),
        "download_dir_preserved": True,
    }


def cleanup_borrowed_handoff_recording_descriptor(
    config: dict[str, Any],
    versions: dict[str, Any],
    descriptor: dict[str, Any],
    descriptor_path: str,
) -> dict[str, Any]:
    """Clean a dead continued handoff recording without deleting its profile."""
    source_path, source = _rebind_borrowed_handoff_recording_descriptor(config, descriptor)
    descriptor_path = os.path.realpath(descriptor_path)
    cleanup_receipt = recording_cleanup_receipt_path(config, descriptor)
    binding = {
        "descriptor": descriptor_path,
        "source_handoff_descriptor": source_path,
        "run_id": source["run_id"],
        "session": source["session"],
        "task_id": source["task_id"],
        "room_id": source.get("room_id"),
        "profile": source["profile"],
        "port": int(source["port"]),
        "process": source["process"],
        "source_nonce": source["nonce"],
    }
    existing_receipt: dict[str, Any] | None = None
    if os.path.lexists(cleanup_receipt):
        existing_receipt = read_json_safe(cleanup_receipt)
        if (
            existing_receipt.get("schema") != RECORDING_CLEANUP_RECEIPT_SCHEMA
            or existing_receipt.get("kind") != "continued_handoff_recording_cleanup"
            or any(existing_receipt.get(key) != value for key, value in binding.items())
            or existing_receipt.get("nonce") != descriptor["nonce"]
            or existing_receipt.get("process_absent") is not True
            or existing_receipt.get("listener_absent") is not True
            or existing_receipt.get("daemon_absent") is not True
        ):
            raise Blocker("browser_use_recording_cleanup_receipt_binding_mismatch")

    runtime_evidence = _verify_borrowed_handoff_runtime_absent(config, descriptor, source)
    lock_paths = _borrowed_handoff_lock_paths(config, source)
    room_id = source.get("room_id")
    room: dict[str, Any] | None = None
    if room_id:
        # Public room projections intentionally omit the lease digest. Use
        # the internal registry record for this owner-binding check without
        # widening `rooms --json` or exposing lease identity metadata.
        room = next((item for item in room_registry_read(config)["rooms"] if item.get("room_id") == room_id), None)
        expected_lease = hashlib.sha256(source["run_id"].encode("utf-8")).hexdigest()
        owner = room.get("owner") if isinstance(room, dict) and isinstance(room.get("owner"), dict) else {}
        if (
            room is None
            or room.get("lifecycle") != TEMPORARY_LIFECYCLE
            or room.get("profile") != source["profile"]
            or int(room.get("port", -1)) != int(source["port"])
            or room.get("task_id") != source["task_id"]
            or owner.get("kind") != "task"
            or owner.get("id") != source["task_id"]
            or room.get("lease_digest") != expected_lease
        ):
            raise Blocker("browser_use_recording_handoff_room_binding_mismatch")
    released = _release_borrowed_handoff_locks(config, source)
    source_cleanup = dict(source.get("cleanup_state") or {})
    source_cleanup.update({
        "recording_borrowed_cleanup": True,
        "locks_released": True,
        "locks_removed": released,
        "profile_preserved": runtime_evidence["profile_preserved"],
        "profile_removed": runtime_evidence["profile_removed"],
        "profile_missing": runtime_evidence["profile_missing"],
        "process_absent": True,
        "listener_absent": True,
        "daemon_absent": True,
        "updated_at": iso(now_utc()),
    })
    source["cleanup_state"] = source_cleanup
    update_handoff(source_path, source)
    _write_cleanup_complete(_handoff_base_path(source_path), source)

    room_result: dict[str, Any] | None = None
    if room_id:
        room_result = room_registry_release(config, room_id, run_id=source["run_id"], activity="continued-handoff-recording-cleanup")

    try:
        mark_recording_abandoned(
            descriptor["status_path"],
            reason="continued handoff recording cleanup: borrowed Chrome, listener, and Harness runtime absent",
        )
    except Blocker as exc:
        if exc.code != "browser_use_recording_already_finalized":
            raise
    pending = pending_operation_reconciliation_ids(descriptor)
    effect_state = operation_effect_summary(descriptor)
    blocker = "browser_use_external_effects_unknown" if effect_state == "unknown" else None
    cleanup = {
        "status": "cleaned",
        "kind": "continued_handoff_recording_cleanup",
        "recording_finalized": False,
        "cleanup_completed": True,
        "completion_status": "cleanup_complete_recording_unfinalized",
        "completion_blocker": blocker,
        **runtime_evidence,
        "locks_removed": released,
        "locks_retained": [path for path in lock_paths if os.path.lexists(path)],
        "room": room_result or {"room_id": room_id, "state": "not_bound"},
        "pending_reconciliation_count": len(pending),
        "external_effects": effect_state,
        "completed_at": iso(now_utc()),
    }
    receipt_payload = {
        "schema": RECORDING_CLEANUP_RECEIPT_SCHEMA,
        "kind": "continued_handoff_recording_cleanup",
        "status": "completed",
        **binding,
        "nonce": descriptor["nonce"],
        "lifecycle": descriptor["lifecycle"],
        "recording_finalized": False,
        "cleanup_completed": True,
        "completion_status": "cleanup_complete_recording_unfinalized",
        "completion_blocker": blocker,
        **runtime_evidence,
        "external_effects": effect_state,
        "pending_reconciliation_count": len(pending),
        "exact_blocker": blocker,
        "cleanup": cleanup,
        "versions_hashes": versions,
    }
    if existing_receipt is None:
        assert_directory(os.path.dirname(cleanup_receipt), create=True)
        try:
            json_atomic_no_replace(cleanup_receipt, receipt_payload)
        except Blocker as exc:
            if exc.code != "browser_use_receipt_already_exists":
                raise
            existing_receipt = read_json_safe(cleanup_receipt)
            if existing_receipt.get("schema") != RECORDING_CLEANUP_RECEIPT_SCHEMA or existing_receipt.get("kind") != "continued_handoff_recording_cleanup" or any(existing_receipt.get(key) != value for key, value in binding.items()):
                raise Blocker("browser_use_recording_cleanup_receipt_binding_mismatch")

    descriptor.update({
        "status": "stale",
        "recovery_state": "cleanup_complete",
        "recording_status_state": "abandoned",
        "cleanup_state": cleanup,
        "cleanup_receipt_path": cleanup_receipt,
        "external_effects": effect_state,
        "recording_finalized": False,
        "cleanup_completed": True,
        "completion_status": "cleanup_complete_recording_unfinalized",
        "completion_blocker": blocker,
    })
    _write_recording_descriptor(config, descriptor_path, descriptor, replace=True)
    return {
        "status": "recording_cleanup_completed",
        "descriptor": descriptor_path,
        "run_id": descriptor["run_id"],
        "session": descriptor["session"],
        "cleanup_receipt": cleanup_receipt,
        "cleanup": cleanup,
        "pending_reconciliation": pending,
        "external_effects": effect_state,
        "exact_blocker": blocker,
        "recording_finalized": False,
        "cleanup_completed": True,
        "completion_status": "cleanup_complete_recording_unfinalized",
        "completion_blocker": blocker,
        "finalized": False,
    }


def cleanup_stale_handoff_recording_descriptor(
    config: dict[str, Any],
    versions: dict[str, Any],
    descriptor: dict[str, Any],
    descriptor_path: str,
) -> dict[str, Any]:
    """Release a dead handoff-backed recording without deleting shared data.

    The recording borrows the handoff's Chrome, locks, profile, and download
    directory.  Once the exact Chrome and Harness session are absent, release
    only the source handoff's locks/room and leave the authenticated profile
    and downloads for the next explicitly bound run.  No browser command is
    replayed and unresolved effects remain unknown.
    """
    descriptor_path = os.path.realpath(descriptor_path)
    source_path, source = _read_stale_handoff_recording_source(config, descriptor)
    cleanup_receipt = recording_cleanup_receipt_path(config, descriptor)
    existing_receipt: dict[str, Any] | None = None
    if os.path.lexists(cleanup_receipt):
        existing_receipt = read_json_safe(cleanup_receipt)
        if (
            existing_receipt.get("schema") != RECORDING_CLEANUP_RECEIPT_SCHEMA
            or existing_receipt.get("kind") not in {"stale_handoff_recording_cleanup", "continued_handoff_recording_cleanup"}
            or existing_receipt.get("run_id") != descriptor["run_id"]
            or existing_receipt.get("session") != descriptor["session"]
            or existing_receipt.get("nonce") != descriptor["nonce"]
            or existing_receipt.get("descriptor") != descriptor_path
            or existing_receipt.get("process_absent") is not True
            or existing_receipt.get("listener_absent") is not True
            or existing_receipt.get("daemon_absent") is not True
        ):
            raise Blocker("browser_use_recording_cleanup_receipt_binding_mismatch")
        if existing_receipt.get("kind") == "continued_handoff_recording_cleanup":
            for key in ("source_handoff_descriptor", "task_id", "room_id", "profile", "port", "process", "source_nonce"):
                expected = descriptor.get("source_handoff_descriptor") if key == "source_handoff_descriptor" else descriptor.get(key)
                if existing_receipt.get(key) != expected:
                    raise Blocker("browser_use_recording_cleanup_receipt_binding_mismatch")

    runtime_evidence = _verify_stale_handoff_recording_runtime_absent(config, descriptor, source)
    source_lock_paths = handoff_lock_paths(config, source, allow_released=True)
    if existing_receipt is None or any(os.path.lexists(path) for path in source_lock_paths):
        source_cleanup = dict(source.get("cleanup_state") or {})
        source_cleanup.update({
            "recording_stale_cleanup": True,
            "locks_release_started": True,
            "profile_preserved": True,
            "download_dir_preserved": True,
            "process_absent": True,
            "listener_absent": True,
            "daemon_absent": True,
            "updated_at": iso(now_utc()),
        })
        source["cleanup_state"] = source_cleanup
        update_handoff(source_path, source)
        released_ok, release_error, released = _release_lock_set(source_lock_paths, source["run_id"], source["nonce"])
        if not released_ok:
            raise Blocker(release_error or "browser_use_handoff_lock_cleanup_uncertain")
        source_cleanup.update({"locks_released": True, "locks_removed": released, "updated_at": iso(now_utc())})
        source["cleanup_state"] = source_cleanup
        update_handoff(source_path, source)
        _write_cleanup_complete(_handoff_base_path(source_path), source)
    else:
        released = []

    room_result: dict[str, Any] | None = None
    if source.get("room_id"):
        room_result = room_registry_release(
            config,
            source["room_id"],
            run_id=source["run_id"],
            activity="stale-handoff-recording-cleanup",
        )
    try:
        mark_recording_abandoned(
            descriptor["status_path"],
            reason="stale handoff recording terminal cleanup: borrowed Chrome and Harness runtime absent",
        )
    except Blocker as exc:
        if exc.code != "browser_use_recording_already_finalized":
            raise
    pending = pending_operation_reconciliation_ids(descriptor)
    effect_state = operation_effect_summary(descriptor)
    blocker = "browser_use_external_effects_unknown" if effect_state == "unknown" else None
    cleanup = {
        "status": "cleaned",
        "kind": "stale_handoff_recording_cleanup",
        "recording_finalized": False,
        "cleanup_completed": True,
        "completion_status": "cleanup_complete_recording_unfinalized",
        "completion_blocker": blocker,
        **runtime_evidence,
        "locks_removed": released,
        "locks_retained": [path for path in source_lock_paths if os.path.lexists(path)],
        "room": room_result or {"room_id": source.get("room_id"), "state": "not_bound"},
        "source_handoff_descriptor": source_path,
        "pending_reconciliation_count": len(pending),
        "external_effects": effect_state,
        "completed_at": iso(now_utc()),
    }
    receipt_payload = {
        "schema": RECORDING_CLEANUP_RECEIPT_SCHEMA,
        "kind": "stale_handoff_recording_cleanup",
        "status": "completed",
        "descriptor": descriptor_path,
        "source_handoff_descriptor": source_path,
        "run_id": descriptor["run_id"],
        "session": descriptor["session"],
        "nonce": descriptor["nonce"],
        "lifecycle": descriptor["lifecycle"],
        "recording_finalized": False,
        "cleanup_completed": True,
        "completion_status": "cleanup_complete_recording_unfinalized",
        "completion_blocker": blocker,
        **runtime_evidence,
        "external_effects": effect_state,
        "pending_reconciliation_count": len(pending),
        "exact_blocker": blocker,
        "cleanup": cleanup,
        "versions_hashes": versions,
    }
    if existing_receipt is None:
        assert_directory(os.path.dirname(cleanup_receipt), create=True)
        try:
            json_atomic_no_replace(cleanup_receipt, receipt_payload)
        except Blocker as exc:
            if exc.code != "browser_use_receipt_already_exists":
                raise
            existing_receipt = read_json_safe(cleanup_receipt)
            if existing_receipt.get("schema") != RECORDING_CLEANUP_RECEIPT_SCHEMA or existing_receipt.get("kind") != "stale_handoff_recording_cleanup" or existing_receipt.get("run_id") != descriptor["run_id"] or existing_receipt.get("session") != descriptor["session"] or existing_receipt.get("nonce") != descriptor["nonce"]:
                raise Blocker("browser_use_recording_cleanup_receipt_binding_mismatch")

    descriptor.update({
        "status": "stale",
        "recovery_state": "cleanup_complete",
        "recording_status_state": "abandoned",
        "cleanup_state": cleanup,
        "cleanup_receipt_path": cleanup_receipt,
        "external_effects": effect_state,
        "recording_finalized": False,
        "cleanup_completed": True,
        "completion_status": "cleanup_complete_recording_unfinalized",
        "completion_blocker": blocker,
    })
    _write_recording_descriptor(config, descriptor_path, descriptor, replace=True)
    return {
        "status": "recording_cleanup_completed",
        "descriptor": descriptor_path,
        "run_id": descriptor["run_id"],
        "session": descriptor["session"],
        "cleanup_receipt": cleanup_receipt,
        "cleanup": cleanup,
        "pending_reconciliation": pending,
        "external_effects": effect_state,
        "exact_blocker": blocker,
        "recording_finalized": False,
        "cleanup_completed": True,
        "completion_status": "cleanup_complete_recording_unfinalized",
        "completion_blocker": blocker,
        "finalized": False,
    }


def reconcile_cleanup_complete_source_recording(
    config: dict[str, Any],
    versions: dict[str, Any],
    descriptor: dict[str, Any],
    descriptor_path: str,
) -> dict[str, Any]:
    """Close a recording whose borrowed handoff already left a completion marker.

    Older cleanup runs removed the consumed handoff after writing its
    completion marker. The recording descriptor stayed cleanup-pending, so a
    later cleanup-only retry incorrectly failed on the missing source path.
    Reconcile only the exact marker and local absence proofs; do not replay a
    browser command, delete a profile, or infer video finalization.
    """
    if descriptor.get("status") not in {"continued", "cleanup_pending"} or descriptor.get("owned_chrome") is not False:
        raise Blocker("browser_use_recording_cleanup_marker_reconciliation_unsupported")
    if descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE:
        raise Blocker("browser_use_recording_cleanup_marker_reconciliation_unsupported")
    marker = _recording_source_cleanup_marker(config, descriptor)
    if marker is None:
        raise Blocker("browser_use_recording_handoff_source_missing")
    assert_debug_listener_absent(int(descriptor["port"]))
    runtime = os.path.join(browser_harness_root(descriptor["session"]), "runtime")
    if any(os.path.lexists(os.path.join(runtime, name)) for name in ("bu.sock", "bu.pid", "bu.port")):
        raise Blocker("browser_use_recording_daemon_still_present")
    if any(os.path.lexists(path) for path in descriptor.get("lock_paths", [])):
        raise Blocker("browser_use_recording_cleanup_locks_remain")

    descriptor_path = os.path.realpath(descriptor_path)
    cleanup_receipt = recording_cleanup_receipt_path(config, descriptor)
    existing_receipt: dict[str, Any] | None = None
    if os.path.lexists(cleanup_receipt):
        existing_receipt = read_json_safe(cleanup_receipt)
        if (
            existing_receipt.get("schema") != RECORDING_CLEANUP_RECEIPT_SCHEMA
            or existing_receipt.get("kind") != "source_handoff_cleanup_marker_reconciliation"
            or existing_receipt.get("descriptor") != descriptor_path
            or existing_receipt.get("run_id") != descriptor["run_id"]
            or existing_receipt.get("session") != descriptor["session"]
            or existing_receipt.get("nonce") != descriptor["nonce"]
            or existing_receipt.get("process_absent") is not True
            or existing_receipt.get("listener_absent") is not True
            or existing_receipt.get("daemon_absent") is not True
        ):
            raise Blocker("browser_use_recording_cleanup_receipt_binding_mismatch")

    try:
        mark_recording_abandoned(
            descriptor["status_path"],
            reason="source handoff cleanup marker reconciled; recording was not finalized",
        )
    except Blocker as exc:
        if exc.code != "browser_use_recording_already_finalized":
            raise

    pending = pending_operation_reconciliation_ids(descriptor)
    effect_state = operation_effect_summary(descriptor)
    blocker = "browser_use_external_effects_unknown" if effect_state == "unknown" else None
    cleanup = {
        "status": "cleaned",
        "kind": "source_handoff_cleanup_marker_reconciliation",
        "recording_finalized": False,
        "cleanup_completed": True,
        "completion_status": "cleanup_complete_recording_unfinalized",
        "completion_blocker": blocker,
        "process_absent": True,
        "listener_absent": True,
        "daemon_absent": True,
        "profile_preserved": True,
        "download_dir_preserved": True,
        "locks_removed": [],
        "locks_retained": [],
        "source_cleanup_marker": marker,
        "pending_reconciliation_count": len(pending),
        "external_effects": effect_state,
        "completed_at": iso(now_utc()),
    }
    receipt_payload = {
        "schema": RECORDING_CLEANUP_RECEIPT_SCHEMA,
        "kind": "source_handoff_cleanup_marker_reconciliation",
        "status": "completed",
        "descriptor": descriptor_path,
        "source_handoff_descriptor": descriptor.get("source_handoff_descriptor"),
        "run_id": descriptor["run_id"],
        "session": descriptor["session"],
        "nonce": descriptor["nonce"],
        "lifecycle": descriptor["lifecycle"],
        "recording_finalized": False,
        "cleanup_completed": True,
        "completion_status": "cleanup_complete_recording_unfinalized",
        "completion_blocker": blocker,
        "process_absent": True,
        "listener_absent": True,
        "daemon_absent": True,
        "external_effects": effect_state,
        "pending_reconciliation_count": len(pending),
        "exact_blocker": blocker,
        "cleanup": cleanup,
        "versions_hashes": versions,
    }
    if existing_receipt is None:
        assert_directory(os.path.dirname(cleanup_receipt), create=True)
        try:
            json_atomic_no_replace(cleanup_receipt, receipt_payload)
        except Blocker as exc:
            if exc.code != "browser_use_receipt_already_exists":
                raise
            existing_receipt = read_json_safe(cleanup_receipt)
            if (
                existing_receipt.get("schema") != RECORDING_CLEANUP_RECEIPT_SCHEMA
                or existing_receipt.get("kind") != "source_handoff_cleanup_marker_reconciliation"
                or existing_receipt.get("run_id") != descriptor["run_id"]
                or existing_receipt.get("session") != descriptor["session"]
                or existing_receipt.get("nonce") != descriptor["nonce"]
            ):
                raise Blocker("browser_use_recording_cleanup_receipt_binding_mismatch")

    descriptor.update(
        {
            "status": "stale",
            "recovery_state": "cleanup_complete",
            "recording_status_state": "abandoned",
            "cleanup_state": cleanup,
            "cleanup_receipt_path": cleanup_receipt,
            "external_effects": effect_state,
            "recording_finalized": False,
            "cleanup_completed": True,
            "completion_status": "cleanup_complete_recording_unfinalized",
            "completion_blocker": blocker,
        }
    )
    _write_recording_descriptor(config, descriptor_path, descriptor, replace=True)
    return {
        "status": "recording_cleanup_completed",
        "descriptor": descriptor_path,
        "run_id": descriptor["run_id"],
        "session": descriptor["session"],
        "cleanup_receipt": cleanup_receipt,
        "cleanup": cleanup,
        "pending_reconciliation": pending,
        "external_effects": effect_state,
        "exact_blocker": blocker,
        "recording_finalized": False,
        "cleanup_completed": True,
        "completion_status": "cleanup_complete_recording_unfinalized",
        "completion_blocker": blocker,
        "finalized": False,
    }


def cleanup_stale_recording_descriptor(
    config: dict[str, Any],
    versions: dict[str, Any],
    descriptor: dict[str, Any],
    descriptor_path: str,
    *,
    delete_approved: bool = False,
) -> dict[str, Any]:
    """Terminally clean one dead recording without replaying browser work.

    ``finalize`` owns login handoffs, while ``record-finalize`` owns recording
    descriptors.  A stale recording must never enter the handoff cleanup
    path: it has a different descriptor root, lock contract, and proof model.
    This path only accepts a temporary, helper-owned recording whose exact
    Chrome identity, debug listener, and Browser Harness runtime are absent.
    It preserves unresolved operation effects and is intentionally idempotent.
    """
    if descriptor.get("status") != "stale":
        raise Blocker("browser_use_recording_stale_cleanup_requires_stale_descriptor")
    if descriptor.get("owned_chrome") is False:
        if descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE:
            raise Blocker("browser_use_recording_stale_cleanup_unsupported")
        return cleanup_stale_handoff_recording_descriptor(config, versions, descriptor, descriptor_path)
    if descriptor.get("owned_chrome") is not True or descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE:
        raise Blocker("browser_use_recording_stale_cleanup_unsupported")

    descriptor_path = os.path.realpath(descriptor_path)
    cleanup_receipt = recording_cleanup_receipt_path(config, descriptor)
    existing_receipt: dict[str, Any] | None = None
    if os.path.lexists(cleanup_receipt):
        existing_receipt = read_json_safe(cleanup_receipt)
        if (
            existing_receipt.get("schema") != RECORDING_CLEANUP_RECEIPT_SCHEMA
            or existing_receipt.get("run_id") != descriptor["run_id"]
            or existing_receipt.get("session") != descriptor["session"]
            or existing_receipt.get("nonce") != descriptor["nonce"]
            or existing_receipt.get("descriptor") != descriptor_path
            or existing_receipt.get("process_absent") is not True
            or existing_receipt.get("listener_absent") is not True
            or existing_receipt.get("daemon_absent") is not True
        ):
            raise Blocker("browser_use_recording_cleanup_receipt_binding_mismatch")

    # Even an idempotent retry must freshly prove that the exact old runtime
    # is still gone.  It never terminates or attaches to an unknown process.
    if not _recording_runtime_is_stale(config, descriptor):
        raise Blocker("browser_use_recording_cleanup_process_still_live")
    assert_debug_listener_absent(int(descriptor["port"]))
    runtime = os.path.join(browser_harness_root(descriptor["session"]), "runtime")
    daemon_paths = [os.path.join(runtime, name) for name in ("bu.sock", "bu.pid", "bu.port")]
    if any(os.path.lexists(path) for path in daemon_paths):
        raise Blocker("browser_use_recording_daemon_still_present")

    lock_paths = _stale_runtime_lock_paths(config, descriptor)
    if existing_receipt is not None and not any(os.path.lexists(path) for path in lock_paths):
        return {
            "status": "recording_cleanup_completed",
            "descriptor": descriptor_path,
            "run_id": descriptor["run_id"],
            "session": descriptor["session"],
            "cleanup_receipt": cleanup_receipt,
            "cleanup": existing_receipt.get("cleanup") or {},
            "pending_reconciliation": pending_operation_reconciliation_ids(descriptor),
            "external_effects": existing_receipt.get("external_effects", operation_effect_summary(descriptor)),
            "idempotent": True,
            "finalized": False,
        }

    download_dir = descriptor.get("download_dir")
    downloads_root = os.path.realpath(config["roots"]["downloads"])
    if (
        not isinstance(download_dir, str)
        or not os.path.isabs(download_dir)
        or os.path.realpath(download_dir) != download_dir
        or not download_dir.startswith(downloads_root + os.sep)
    ):
        raise Blocker("browser_use_download_cleanup_scope_mismatch")

    profile_removed = False
    profile_preserved = False
    if os.path.lexists(descriptor["profile"]):
        if descriptor.get("shared_profile_lease_path"):
            marker_path = os.path.join(descriptor["profile"], ".browser-use-profile.json")
            assert_regular_file(marker_path, mode=0o600)
            expected_marker = descriptor.get("shared_profile_marker_sha256")
            if expected_marker and sha256_file(marker_path) != expected_marker:
                raise Blocker("browser_use_shared_profile_marker_changed")
            profile_preserved = True
        elif delete_approved:
            # Deletion is optional and normally happens before the owned locks
            # are released.  A restartable stale recovery is the one
            # owner-bound exception: record-recover may already have released
            # both exact locks after proving the runtime absent.
            cleanup_temporary_profile(
                config,
                descriptor,
                process_verified=True,
                allow_released_locks=(
                    descriptor.get("status") == "stale"
                    and descriptor.get("recovery_state") == "restartable"
                ),
            )
            profile_removed = not os.path.lexists(descriptor["profile"])
        else:
            profile_preserved = True
    else:
        profile_removed = (descriptor.get("cleanup_state") or {}).get("profile_removed") is True
        if not profile_removed:
            raise Blocker("browser_use_temporary_profile_missing")

    download_dir_removed = not os.path.lexists(download_dir)
    download_dir_retained = False
    if not download_dir_removed:
        download_dir_removed = cleanup_empty_download_dir(download_dir, downloads_root)
        download_dir_retained = not download_dir_removed

    released = _release_stale_runtime_locks(config, descriptor)
    room_result: dict[str, Any] | None = None
    room_id = descriptor.get("room_id")
    if room_id:
        # Temporary rooms are task-owned; scheduled rooms are automation-owned.
        # Passing the recording run id here can leave a valid owner room held.
        room_owner_id = (
            descriptor.get("task_id")
            if descriptor.get("lifecycle") in {TEMPORARY_LIFECYCLE, "single-use"}
            else descriptor.get("automation_id")
            if descriptor.get("lifecycle") == "scheduled"
            else descriptor["run_id"]
        )
        room_result = room_registry_release(
            config,
            room_id,
            run_id=str(room_owner_id or descriptor["run_id"]),
            activity="stale-recording-cleanup",
        )
    if descriptor.get("shared_profile_lease_path"):
        mark_shared_profile_lease_released(
            config,
            os.path.realpath(str(descriptor["shared_profile_lease_path"])),
            run_id=descriptor["run_id"],
            session=descriptor["session"],
            task_id=str(descriptor.get("task_id") or ""),
            room=room_result,
        )

    try:
        mark_recording_abandoned(
            descriptor["status_path"],
            reason="stale recording terminal cleanup: owned Chrome, listeners, and daemon absent",
        )
    except Blocker as exc:
        if exc.code != "browser_use_recording_already_finalized":
            raise

    pending = pending_operation_reconciliation_ids(descriptor)
    effect_state = operation_effect_summary(descriptor)
    blocker = "browser_use_external_effects_unknown" if effect_state == "unknown" else None
    cleanup = {
        "status": "cleaned",
        "kind": "stale_recording_terminal_cleanup",
        "recording_finalized": False,
        "cleanup_completed": True,
        "completion_status": "cleanup_complete_recording_unfinalized",
        "completion_blocker": blocker,
        "process_absent": True,
        "listener_absent": True,
        "daemon_absent": True,
        "profile_removed": profile_removed,
        "profile_preserved": profile_preserved,
        "download_dir_removed": download_dir_removed,
        "download_dir_retained": download_dir_retained,
        "locks_removed": released,
        "locks_retained": [path for path in lock_paths if os.path.lexists(path)],
        "room": room_result or {"room_id": room_id, "state": "not_bound"},
        "pending_reconciliation_count": len(pending),
        "external_effects": effect_state,
        "completed_at": iso(now_utc()),
    }
    receipt_payload = {
        "schema": RECORDING_CLEANUP_RECEIPT_SCHEMA,
        "status": "completed",
        "descriptor": descriptor_path,
        "run_id": descriptor["run_id"],
        "session": descriptor["session"],
        "nonce": descriptor["nonce"],
        "lifecycle": descriptor["lifecycle"],
        "recording_finalized": False,
        "cleanup_completed": True,
        "completion_status": "cleanup_complete_recording_unfinalized",
        "completion_blocker": blocker,
        "process_absent": True,
        "listener_absent": True,
        "daemon_absent": True,
        "external_effects": effect_state,
        "pending_reconciliation_count": len(pending),
        "exact_blocker": blocker,
        "cleanup": cleanup,
        "versions_hashes": versions,
    }
    if existing_receipt is None:
        assert_directory(os.path.dirname(cleanup_receipt), create=True)
        try:
            json_atomic_no_replace(cleanup_receipt, receipt_payload)
        except Blocker as exc:
            if exc.code != "browser_use_receipt_already_exists":
                raise
            existing_receipt = read_json_safe(cleanup_receipt)
            if existing_receipt.get("schema") != RECORDING_CLEANUP_RECEIPT_SCHEMA or existing_receipt.get("run_id") != descriptor["run_id"] or existing_receipt.get("session") != descriptor["session"] or existing_receipt.get("nonce") != descriptor["nonce"]:
                raise Blocker("browser_use_recording_cleanup_receipt_binding_mismatch")

    descriptor.update(
        {
            "status": "stale",
            "recovery_state": "cleanup_complete",
            "recording_status_state": "abandoned",
            "cleanup_state": cleanup,
            "cleanup_receipt_path": cleanup_receipt,
            "external_effects": effect_state,
            "recording_finalized": False,
            "cleanup_completed": True,
            "completion_status": "cleanup_complete_recording_unfinalized",
            "completion_blocker": blocker,
        }
    )
    _write_recording_descriptor(config, descriptor_path, descriptor, replace=True)
    return {
        "status": "recording_cleanup_completed",
        "descriptor": descriptor_path,
        "run_id": descriptor["run_id"],
        "session": descriptor["session"],
        "cleanup_receipt": cleanup_receipt,
        "cleanup": cleanup,
        "pending_reconciliation": pending,
        "external_effects": effect_state,
        "exact_blocker": blocker,
        "recording_finalized": False,
        "cleanup_completed": True,
        "completion_status": "cleanup_complete_recording_unfinalized",
        "completion_blocker": blocker,
        "finalized": False,
    }


def load_recording_commands(config: dict[str, Any], path: str, mode: str, allowed_origins: list[str], download_dir: str) -> list[list[str]]:
    assert_regular_file(path, mode=0o600)
    try:
        value = json.loads(pathlib.Path(path).read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise Blocker("browser_use_recording_commands_file_invalid") from exc
    if not isinstance(value, list) or not value or len(value) > int(config["recording"]["max_commands"]):
        raise Blocker("browser_use_recording_commands_invalid")
    commands: list[list[str]] = []
    for item in value:
        if not isinstance(item, list) or not all(isinstance(arg, str) for arg in item):
            raise Blocker("browser_use_recording_command_entry_invalid")
        command, _, _ = validate_command(item, mode, config, allowed_origins, download_dir)
        if command[0] == "close":
            raise Blocker("browser_use_recording_close_is_helper_owned")
        commands.append(command)
    return commands


def _recording_context(config: dict[str, Any], descriptor: dict[str, Any]) -> dict[str, Any]:
    return {
        "mode": descriptor["mode"],
        "lifecycle": descriptor["lifecycle"],
        "run_id": descriptor["run_id"],
        "session": descriptor["session"],
        "requested_session": descriptor.get("requested_session", descriptor["session"]),
        "automation_id": descriptor["automation_id"],
        "nonce": descriptor["nonce"],
        "helper_sha256": descriptor.get("helper_sha256"),
        "task_id": descriptor.get("task_id"),
        "started_at": descriptor.get("started_at"),
        "lock_paths": list(descriptor["lock_paths"]),
        "process": descriptor["process"],
        "port": descriptor["port"],
        "profile": descriptor["profile"],
        "download_dir": descriptor["download_dir"],
        "cleanup": {},
        "room_terminal_cleanup": True,
        "config": config,
        "room_id": descriptor.get("room_id"),
        "shared_profile_lease_path": descriptor.get("shared_profile_lease_path"),
        "profile_owner_task_id": descriptor.get("profile_owner_task_id"),
        "recording_finalized": descriptor.get("recording_finalized"),
        "cleanup_completed": descriptor.get("cleanup_completed"),
        "completion_status": descriptor.get("completion_status"),
        "completion_blocker": descriptor.get("completion_blocker") or descriptor.get("finalize_failure"),
        "reconciliation_state": descriptor.get("reconciliation_state"),
        "pending_reconciliation": list(descriptor.get("pending_reconciliation") or []),
        "cleanup_capability_path": descriptor.get("cleanup_capability_path"),
        "cleanup_capability_sha256": descriptor.get("cleanup_capability_sha256"),
        "phases": descriptor.get("phases") or {"record_start": lifecycle_phase(), "terminal_cleanup": lifecycle_phase()},
    }


def require_temporary_task_id(args: argparse.Namespace, descriptor: dict[str, Any]) -> None:
    if descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE:
        return
    task_id = getattr(args, "task_id", None)
    if not task_id:
        raise Blocker("browser_use_temporary_task_id_required")
    safe_id(task_id, "task_id")
    if task_id != descriptor.get("task_id"):
        raise Blocker("browser_use_temporary_task_binding_mismatch")


def _cleanup_recording_owned_session(config: dict[str, Any], descriptor: dict[str, Any], *, require_video_session_closed: bool = True, preserve_temporary: bool = False) -> tuple[bool, str | None]:
    if not descriptor.get("owned_chrome"):
        return True, None
    ctx = _recording_context(config, descriptor)
    ok, blocker = terminate_chrome(None, descriptor["process"], config["executables"]["chrome"]["canonical_path"], descriptor["port"], descriptor["profile"])
    if not ok:
        _record_context_cleanup_pending(ctx, blocker or "browser_use_cleanup_uncertain")
        return False, blocker or "browser_use_cleanup_uncertain"
    ctx["process_terminated"] = True
    ctx["listener_absent"] = True
    try:
        if descriptor.get("lifecycle") == "single-use" and os.path.lexists(descriptor["profile"]):
            cleanup_exact_profile(descriptor["profile"], config["roots"]["single_use_profiles"], descriptor["run_id"], descriptor["nonce"])
        elif descriptor.get("lifecycle") == TEMPORARY_LIFECYCLE and os.path.lexists(descriptor["profile"]):
            if descriptor.get("shared_profile_lease_path"):
                marker_path = os.path.join(descriptor["profile"], ".browser-use-profile.json")
                assert_regular_file(marker_path, mode=0o600)
                expected_marker = descriptor.get("shared_profile_marker_sha256")
                if expected_marker and sha256_file(marker_path) != expected_marker:
                    raise Blocker("browser_use_shared_profile_marker_changed")
                ctx.setdefault("cleanup", {})["profile_preserved"] = True
            elif preserve_temporary:
                assert_regular_file(os.path.join(descriptor["profile"], ".browser-use-profile.json"), mode=0o600)
                ctx.setdefault("cleanup", {})["profile_preserved"] = True
            else:
                cleanup_temporary_profile(config, descriptor, process_verified=True)
        elif descriptor.get("lifecycle") == "scheduled" and not os.path.lexists(descriptor["profile"]):
            return False, "browser_use_scheduled_profile_missing_after_cleanup"
        elif descriptor.get("lifecycle") not in {"single-use", "scheduled", TEMPORARY_LIFECYCLE}:
            return False, "browser_use_recording_lifecycle_invalid"
        if os.path.lexists(descriptor["download_dir"]):
            cleanup_exact_download_dir(descriptor["download_dir"], config["roots"]["downloads"])
        if os.path.lexists(descriptor["download_dir"]):
            raise Blocker("browser_use_download_cleanup_readback_failed")
        released, release_error = _release_locks_after_verified_cleanup(ctx, descriptor["run_id"], descriptor["nonce"])
        if not released:
            return False, release_error or "browser_use_cleanup_uncertain"
    except Exception as exc:
        return False, _cleanup_failure_code(exc)
    return True, None


def _recording_finalize_cleanup_after_media_failure(
    config: dict[str, Any],
    versions: dict[str, Any],
    descriptor: dict[str, Any],
    descriptor_path: str,
    failure: str,
    *,
    failure_phase: str,
    preserve_temporary: bool = False,
) -> tuple[str | None, str]:
    """Close only this recording's resources after media finalization failed.

    A failed Browser Harness stop/render/probe is not evidence that the video
    finalized.  It is, however, a terminal boundary for the recording flow:
    leaving the run-owned Chrome and locks alive makes every later cleanup
    attempt less reliable.  Preserve the failure, attempt the normal daemon
    close, and then use the existing identity-checked Chrome cleanup.  The
    returned receipt is always blocked; this helper never creates a completed
    recording manifest.
    """
    ctx = _recording_context(config, descriptor)
    ctx.update(
        {
            "recording_finalized": False,
            "cleanup_completed": False,
            "completion_status": "blocked",
            "completion_blocker": failure,
            "account_identity": descriptor.get("account_identity", "authorized"),
            "authority_summary": {
                "data_exposure": "authorized_recording" if descriptor.get("mode") == "authorized" else "public_read_only",
                "side_effect_scope": "bounded_recording",
                "approval": "approved" if descriptor.get("mode") == "authorized" else "not_required",
            },
            "preflight": True,
            "listener_verified": True,
            "process_identity_verified": True,
            "readback_exit": 0,
            "readback_required": True,
        }
    )
    cleanup: dict[str, Any] = {
        "status": "cleanup_pending",
        "recording_finalize": "blocked",
        "recording_finalized": False,
        "cleanup_completed": False,
        "completion_status": "blocked",
        "completion_blocker": failure,
        failure_phase: "failed",
        f"{failure_phase}_blocker": failure,
        "daemon_close_attempted": False,
    }

    daemon_error: str | None = None
    if browser_harness_cli_enabled():
        cleanup["daemon_close_attempted"] = True
        try:
            daemon_closed, daemon_error = close_owned_daemon_if_active(
                config,
                config["roots"]["browser_use_home"],
                int(descriptor["port"]),
                descriptor["session"],
            )
        except Exception as exc:
            daemon_closed = False
            daemon_error = _cleanup_failure_code(exc, "browser_use_daemon_close_failed")
        cleanup["daemon_close"] = "closed" if daemon_closed else "failed"
        if daemon_error:
            cleanup["daemon_close_blocker"] = daemon_error

    cleanup_blocker: str | None = None
    if descriptor.get("owned_chrome"):
        try:
            cleaned, cleanup_blocker = _cleanup_recording_owned_session(
                config,
                descriptor,
                preserve_temporary=preserve_temporary,
            )
        except Exception as exc:
            cleaned = False
            cleanup_blocker = _cleanup_failure_code(exc)
        if cleaned:
            try:
                recording = recording_env(
                    config,
                    descriptor["recording_dir"],
                    descriptor["status_path"],
                    descriptor["recording_framerate"],
                )
                write_harness_recording_status(descriptor["status_path"], recording, active=False, finalized=False)
            except Exception as exc:
                cleaned = False
                cleanup_blocker = _cleanup_failure_code(exc, "browser_use_recording_status_cleanup_readback_failed")
        if cleaned:
            cleanup.update(
                {
                    "status": "cleaned",
                    "cleanup_completed": True,
                    "process_terminated": True,
                    "listener_absent": True,
                    "profile_preserved": bool(preserve_temporary) or str(descriptor.get("lifecycle")) == "scheduled" or bool(descriptor.get("shared_profile_lease_path")),
                    "shared_profile_preserved": bool(descriptor.get("shared_profile_lease_path")),
                    "temporary_profile_preserved": str(descriptor.get("lifecycle")) == TEMPORARY_LIFECYCLE and bool(preserve_temporary),
                    "temporary_profile_removed": str(descriptor.get("lifecycle")) == TEMPORARY_LIFECYCLE and not (bool(preserve_temporary) or bool(descriptor.get("shared_profile_lease_path"))),
                    "download_dir_removed": not os.path.lexists(descriptor["download_dir"]),
                    "locks_removed": [path for path in descriptor.get("lock_paths", []) if not os.path.lexists(path)],
                    "locks_retained": [path for path in descriptor.get("lock_paths", []) if os.path.lexists(path)],
                }
            )
        else:
            cleanup["status"] = "cleanup_pending"
            cleanup["state"] = "uncertain"
            cleanup["uncertain"] = True
            cleanup["exact_blocker"] = cleanup_blocker or "browser_use_cleanup_uncertain"
            cleanup["locks_retained"] = list(descriptor.get("lock_paths", []))
    else:
        # A recording attached to a login handoff does not own the source
        # browser.  Preserve it for the handoff owner instead of closing it.
        cleanup.update({"status": "source_handoff_preserved", "shared_handoff_preserved": True})

    # The borrowed browser remains the handoff owner's responsibility, but
    # the recording status is still owned by this recording descriptor.  If
    # cleanup did not already write the terminal status, clear the recorder
    # finalized marker so descriptor and status cannot disagree on failure.
    if browser_harness_cli_enabled() and not (
        descriptor.get("owned_chrome") and cleanup.get("status") == "cleaned"
    ):
        try:
            recording = recording_env(
                config,
                descriptor["recording_dir"],
                descriptor["status_path"],
                descriptor["recording_framerate"],
            )
            write_harness_recording_status(descriptor["status_path"], recording, active=False, finalized=False)
        except Exception as exc:
            cleanup["status_cleanup_blocker"] = _cleanup_failure_code(
                exc,
                "browser_use_recording_status_cleanup_readback_failed",
            )
            cleanup["status"] = "cleanup_pending"

    ctx["cleanup"] = cleanup
    descriptor["status"] = "cleanup_pending"
    descriptor["finalize_failure"] = failure
    descriptor["recording_finalized"] = False
    descriptor["cleanup_completed"] = cleanup.get("status") == "cleaned"
    descriptor["completion_status"] = "blocked"
    descriptor["completion_blocker"] = failure
    descriptor["cleanup_state"] = cleanup
    persistence_failure: str | None = None
    try:
        _write_recording_descriptor(config, os.path.realpath(descriptor_path), descriptor, replace=True)
    except Exception as exc:
        persistence_failure = _cleanup_failure_code(exc, "browser_use_cleanup_pending_persistence_failed")
        cleanup["status"] = "cleanup_pending"
        cleanup["state"] = "uncertain"
        cleanup["uncertain"] = True
        cleanup["exact_blocker"] = persistence_failure
        ctx["cleanup"] = cleanup

    receipt_failure = persistence_failure or cleanup_blocker or failure
    receipt_path: str | None = None
    try:
        receipt_path = finalized_receipt(config, versions, ctx, receipt_failure)
    except Exception:
        # The original stop failure remains the stable user-facing blocker;
        # the descriptor/cleanup state is the durable retry evidence.
        receipt_path = None
    return receipt_path, receipt_failure


def _recording_finalize_cleanup_after_stop_failure(
    config: dict[str, Any],
    versions: dict[str, Any],
    descriptor: dict[str, Any],
    descriptor_path: str,
    failure: str,
    *,
    preserve_temporary: bool = False,
) -> tuple[str | None, str]:
    return _recording_finalize_cleanup_after_media_failure(
        config,
        versions,
        descriptor,
        descriptor_path,
        failure,
        failure_phase="record_stop",
        preserve_temporary=preserve_temporary,
    )


def _recording_cleanup_only_preserve_recovery_eligible(
    descriptor: dict[str, Any],
    recording_status: dict[str, Any],
    *,
    cleanup_only: bool,
    preserve_temporary: bool,
) -> bool:
    """Allow only the bounded active-auth-wait cleanup recovery.

    This path never resolves an unknown operation.  It only closes the
    already-owned recorder/browser resources while retaining the temporary
    profile and preserving the unknown-effect blocker in the receipt.
    """
    if not (cleanup_only and preserve_temporary):
        return False
    if descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE or descriptor.get("owned_chrome") is not True:
        return False
    if operation_effect_summary(descriptor) != "unknown":
        return False
    if recording_status.get("recorder_active") is not True:
        return False
    state = recording_status.get("state") or recording_status.get("durable_state")
    return state == "authentication_required"


def _recording_failure_cleanup(config: dict[str, Any], ctx: dict[str, Any], chrome_proc: subprocess.Popen[bytes] | None, lifecycle: str, descriptor_path: str | None = None) -> str | None:
    failure = _cleanup_execute_failure(config, ctx, chrome_proc, lifecycle)
    start_phase = lifecycle_phase(
        observed=True,
        requested=True,
        executed=bool(ctx.get("room_id") or ctx.get("launch_attempted") or ctx.get("process")),
        completed=False,
        blocked=True,
        exact_blocker=failure or "browser_use_recording_start_failed",
    )
    cleanup_phase = lifecycle_phase(
        observed=True,
        requested=True,
        executed=bool(ctx.get("room_id") or ctx.get("launch_attempted") or ctx.get("lock_paths")),
        completed=failure is None,
        blocked=failure is not None,
        exact_blocker=failure,
    )
    phases = dict(ctx.get("phases") or {})
    phases["record_start"] = start_phase
    phases["terminal_cleanup"] = cleanup_phase
    ctx["phases"] = phases
    capability_path = ctx.get("cleanup_capability_path")
    if isinstance(capability_path, str):
        try:
            update_recording_cleanup_capability(
                capability_path,
                expected_run_id=str(ctx["run_id"]),
                expected_session=str(ctx["session"]),
                expected_nonce=str(ctx["nonce"]),
                cleanup_phase=cleanup_phase,
                phase=start_phase,
                exact_blocker=failure,
                resource_binding={"room_id": ctx.get("room_id"), "port": ctx.get("port"), "profile": ctx.get("profile")},
            )
        except Exception as exc:
            capability_failure = _cleanup_failure_code(exc, "browser_use_recording_cleanup_capability_persistence_failed")
            if failure is None:
                failure = capability_failure
                cleanup_phase = lifecycle_phase(observed=True, requested=True, executed=True, blocked=True, exact_blocker=failure)
                phases["terminal_cleanup"] = cleanup_phase
                ctx["phases"] = phases
            else:
                ctx.setdefault("cleanup", {})["capability_blocker"] = capability_failure
    if failure and descriptor_path:
        try:
            if os.path.lexists(descriptor_path):
                descriptor = read_json_safe(descriptor_path)
                descriptor["status"] = "cleanup_pending"
                descriptor["cleanup_state"] = dict(ctx.get("cleanup") or {})
                descriptor["phases"] = dict(ctx.get("phases") or {})
                descriptor["completion_status"] = "blocked"
                descriptor["completion_blocker"] = failure
                json_atomic_replace(descriptor_path, descriptor)
        except Exception:
            return "browser_use_recording_cleanup_pending_persistence_failed"
    return failure


def _write_recording_descriptor(config: dict[str, Any], path: str, descriptor: dict[str, Any], *, replace: bool) -> None:
    assert_recording_descriptor_path(config, path)
    if replace:
        json_atomic_replace(path, descriptor)
    else:
        json_atomic_no_replace(path, descriptor)
    write_task_resume_checkpoint(config, descriptor, path)


def validate_shared_profile_record_start(
    config: dict[str, Any],
    shared_lease: dict[str, Any],
    *,
    profile: str,
    port: int,
    run_id: str,
    room_id: str,
) -> dict[str, Any]:
    """Revalidate a claimed profile without treating it as a new profile.

    ``temporary-share-claim`` already owns the exact room and runtime locks
    for this run. Record-start must validate and reuse those bindings, never
    call the new-profile initializer or claim a second room.
    """
    room = room_registry_lookup(config, str(room_id or ""))
    room_owner = room.get("owner") if isinstance(room, dict) and isinstance(room.get("owner"), dict) else {}
    if (
        not isinstance(room, dict)
        or room.get("state") not in ROOM_REGISTRY_ACTIVE_STATES
        or os.path.realpath(str(room.get("profile") or "")) != os.path.realpath(profile)
        or int(room.get("port", -1)) != int(port)
        or room_owner.get("id") != shared_lease.get("task_id")
    ):
        raise Blocker("browser_use_shared_profile_lease_room_binding_mismatch")
    marker_path = os.path.join(os.path.realpath(profile), ".browser-use-profile.json")
    assert_regular_file(marker_path, mode=0o600)
    marker = read_json_safe(marker_path)
    validate_temporary_marker(config, profile, _shared_profile_marker_expected(marker), require_unexpired=True)
    if sha256_file(marker_path) != shared_lease.get("profile_marker_sha256"):
        raise Blocker("browser_use_shared_profile_marker_changed")
    return room


def record_start(args: argparse.Namespace) -> int:
    config = read_toml()
    args.lifecycle = resolve_default_lifecycle(args.mode, getattr(args, "lifecycle", None))
    if args.lifecycle == TEMPORARY_LIFECYCLE and args.mode != "authorized":
        raise Blocker("browser_use_temporary_requires_authorized_mode")
    versions = validate_installation(config)
    recording_tools = validate_recording_tools(config)
    recording_runtime = validate_recording_runtime(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    ensure_temporary_task_id(args, requested_session)
    automation_id = safe_id(args.automation_id, "automation_id")
    if args.lifecycle not in {"single-use", "scheduled", TEMPORARY_LIFECYCLE}:
        raise Blocker("browser_use_recording_lifecycle_invalid")
    if args.lifecycle == TEMPORARY_LIFECYCLE:
        if args.mode != "authorized":
            raise Blocker("browser_use_temporary_requires_authorized_mode")
        if not args.task_id:
            raise Blocker("browser_use_temporary_task_id_required")
        safe_id(args.task_id, "task_id")
    recording_roots = config.get("roots") if isinstance(config, dict) else None
    helper_sync = None
    if isinstance(recording_roots, dict) and isinstance(recording_roots.get("recordings"), str):
        if getattr(args, "helper_generation_scope", "global") == "owner-lane":
            helper_sync = helper_generation_owner_lane_admission(
                config,
                automation_id=automation_id,
                lifecycle=args.lifecycle,
                port=args.port,
            )
        else:
            helper_sync = helper_generation_sync_all(config)
        if helper_sync["counts"].get("live_sync_blocked", 0):
            blocker = "browser_use_owner_lane_admission_blocked" if helper_sync.get("scope") == "owner-lane" else "browser_use_helper_generation_auto_sync_blocked"
            raise Blocker(blocker, str(helper_sync["counts"]["live_sync_blocked"]))
    if args.handoff_descriptor and args.mode != "authorized":
        raise Blocker("browser_use_recording_handoff_requires_authorized_mode")
    if args.mode == "authorized":
        if not args.authority:
            raise Blocker("browser_use_authority_required")
        authority = parse_authority(args.authority, run_id, session, aliases=session_aliases(config, requested_session, session))
        allowed_origins = list(authority["allowed_origins"])
        authority_digest = sha256_file(args.authority)
        account_identity = authority["account_identity"]
    else:
        authority = None
        allowed_origins = [normalize_origin(item) for item in args.allowed_origin]
        if not allowed_origins:
            raise Blocker("browser_use_allowed_origins_required")
        authority_digest = None
        account_identity = "public"
    owner_metadata: dict[str, str] | None = None
    shared_lease: dict[str, Any] | None = None
    shared_lease_path: str | None = None
    recording_dir = validate_recording_output_dir(args.recording_dir)
    if authority is not None:
        start_budget = remaining_authority_budget(authority, "record-start")
        if not start_budget["sufficient"]:
            try:
                write_authority_renewal_checkpoint(
                    {"recording_dir": recording_dir, "run_id": run_id, "session": session, "authority_generation": 1, "authority_sha256": authority_digest},
                    command_class="record-start",
                    budget=start_budget,
                )
            except Blocker:
                pass
            raise Blocker("browser_use_authority_renewal_required")
    try:
        framerate = int(args.framerate or recording_runtime["default_framerate"])
    except (TypeError, ValueError) as exc:
        raise Blocker("browser_use_recording_framerate_invalid") from exc
    if not 1 <= framerate <= 60:
        raise Blocker("browser_use_recording_framerate_invalid")
    command = list(args.command)
    if command and command[0] == "--":
        command = command[1:]
    # record-start is a lifecycle boundary, not a navigation boundary. The
    # Browser Harness start command only creates the recorder and ensures a
    # real tab; an "open URL" supplied here would otherwise be reflected in
    # descriptor.operations while the page remains on the new-tab page.
    # Navigation must be issued through record-command in the same flow.
    if command and command != ["state"]:
        raise Blocker("browser_use_recording_start_target_command_rejected")
    # P6 flow start is deliberately non-navigating, while the underlying
    # Browser Use daemon still requires one bounded command to initialize the
    # recording session.  A read-only state probe preserves that contract;
    # navigation is issued later through record-command with its own sequence
    # and nonce.
    if not command:
        command = ["state"]
    temp_binding_value = None
    shared_lease_arg = getattr(args, "shared_lease", None)
    if shared_lease_arg and args.handoff_descriptor:
        raise Blocker("browser_use_shared_profile_handoff_combination_invalid")
    if shared_lease_arg and (args.lifecycle != TEMPORARY_LIFECYCLE or args.mode != "authorized"):
        raise Blocker("browser_use_shared_profile_requires_authorized_temporary")
    if shared_lease_arg:
        shared_lease_path = os.path.realpath(shared_lease_arg)
        shared_lease = read_shared_profile_lease(
            config,
            shared_lease_path,
            run_id=run_id,
            session=session,
            task_id=args.task_id,
            authority=authority,
        )
    if args.handoff_descriptor:
        source_path = os.path.realpath(args.handoff_descriptor)
        source_run_id = safe_id(args.source_run_id, "run_id")
        source_requested_session = validate_id(args.source_session, "session")
        source_session = canonical_session_id(source_requested_session, config["roots"]["browser_use_home"])
        source = read_handoff(config, source_path, source_run_id, source_session, require_unexpired=True)
        validate_handoff_identity(config, source)
        if str(source.get("lifecycle", "")) != str(args.lifecycle):
            raise Blocker("browser_use_recording_handoff_lifecycle_mismatch")
        if source["origin"] not in set(allowed_origins) or source["account_identity"] != account_identity:
            raise Blocker("browser_use_recording_source_handoff_binding_mismatch")
        if args.lifecycle == TEMPORARY_LIFECYCLE and source.get("authority_sha256") != authority_digest:
            raise Blocker("browser_use_temporary_authority_binding_mismatch")
            if args.lifecycle == TEMPORARY_LIFECYCLE:
                if source.get("lifecycle") != TEMPORARY_LIFECYCLE or source.get("task_id") != args.task_id:
                    raise Blocker("browser_use_temporary_task_binding_mismatch")
            temp_binding_value = source["creation_binding"]
        port = source["port"]
        profile = source["profile"]
        download_dir = source["download_dir"]
        process_identity = source["process"]
        owned_chrome = False
        lock_paths: list[str] = []
    elif shared_lease is not None:
        temp_binding_value = str(shared_lease["creation_binding"])
        profile = os.path.realpath(str(shared_lease["profile"]))
        port = int(shared_lease["port"])
        download_dir = os.path.join(config["roots"]["downloads"], f"temporary-{temp_binding_value[:32]}")
        process_identity = None
        owned_chrome = True
        lock_paths = [os.path.realpath(str(item)) for item in shared_lease["lock_paths"]]
    else:
        if args.lifecycle == TEMPORARY_LIFECYCLE:
            temp_binding_value = temporary_binding(mode=args.mode, lifecycle=args.lifecycle, automation_id=automation_id, task_id=args.task_id, run_id=run_id, authority_digest=authority_digest or "", authority_scope=temporary_authority_scope(authority or {}), account_identity=account_identity, origins=allowed_origins)
            profile = temporary_profile_path(config, temp_binding_value)
            download_dir = os.path.join(config["roots"]["downloads"], f"temporary-{temp_binding_value[:32]}")
        else:
            profile_root = config["roots"]["scheduled_profiles"] if args.lifecycle == "scheduled" else config["roots"]["single_use_profiles"]
            profile = os.path.join(profile_root, automation_id) if args.lifecycle == "scheduled" else None
            download_dir = os.path.join(config["roots"]["downloads"], f"{run_id}-{uuid.uuid4().hex}")
        if args.mode == "public" and automation_id == "automation-os-iab" and args.port != 19980:
            raise Blocker("browser_use_p5_public_port_required")
        if args.lifecycle == "scheduled":
            port_start, port_end = config["ports"]["scheduled_start"], config["ports"]["scheduled_end"]
        elif args.lifecycle == "single-use":
            port_start, port_end = config["ports"]["single_use_start"], config["ports"]["single_use_end"]
        else:
            port_start, port_end = config["ports"]["temporary_start"], config["ports"]["temporary_end"]
        if args.port is not None and not (port_start <= args.port <= port_end):
            raise Blocker("browser_use_recording_port_out_of_range")
        if args.lifecycle == "scheduled" and automation_id == "manual":
            raise Blocker("browser_use_scheduled_automation_id_required")
        port = args.port
        process_identity = None
        owned_chrome = True
        lock_paths = []
    command, origins, uploads = validate_command(command, args.mode, config, allowed_origins, download_dir)
    if args.handoff_descriptor and origins and source["origin"] not in origins:
        raise Blocker("browser_use_recording_source_origin_drift")
    if args.mode == "authorized" and args.lifecycle == TEMPORARY_LIFECYCLE and not args.handoff_descriptor:
        binding = _owner_record_start_binding(
            args,
            command=command,
            recording_dir=recording_dir,
            allowed_origins=allowed_origins,
            authority_digest=authority_digest,
        )
        owner_metadata = validate_record_start_owner_metadata(args, binding=binding)
    require_cross_run_reconciliation_clear(
        config,
        run_id=run_id,
        automation_id=automation_id,
        account_identity=account_identity,
        target_origins=origins or allowed_origins,
    )
    ctx: dict[str, Any] = {"mode": args.mode, "lifecycle": args.lifecycle, "run_id": run_id, "session": session, "requested_session": requested_session, "automation_id": automation_id, "nonce": shared_lease.get("nonce") if shared_lease is not None else (temp_binding_value if args.lifecycle == TEMPORARY_LIFECYCLE and temp_binding_value else uuid.uuid4().hex), "task_id": getattr(args, "task_id", None), "started_at": iso(now_utc()), "lock_paths": lock_paths, "cleanup": {}, "port": port, "profile": profile, "profile_created": False, "launch_attempted": False, "download_dir": download_dir, "owned_chrome": owned_chrome, "config": config, "room_id": source.get("room_id") if args.handoff_descriptor else (shared_lease.get("room_id") if shared_lease is not None else None), "shared_profile_lease_path": shared_lease_path, "profile_owner_automation_id": shared_lease.get("profile_owner_automation_id") if shared_lease is not None else None, "profile_owner_task_id": shared_lease.get("source_task_id") if shared_lease is not None else None, "profile_owner_run_id": shared_lease.get("profile_owner_run_id") if shared_lease is not None else None, "profile_owner_authority_sha256": shared_lease.get("profile_owner_authority_sha256") if shared_lease is not None else None, "profile_owner_authority_scope": shared_lease.get("profile_owner_authority_scope") if shared_lease is not None else None}
    if args.lifecycle == TEMPORARY_LIFECYCLE:
        ctx["creation_binding"] = temp_binding_value or source["creation_binding"]
        ctx["authority_scope"] = temporary_authority_scope(authority or {}) if authority else source["authority_scope"]
        # A failed record-start has no resumable descriptor. Its temporary
        # room is therefore a startup lease, not a retained task room, and
        # must be released after exact process/lock absence readback. A
        # successful start is finalized later from the descriptor, whose
        # recording context is terminal.
        ctx["room_terminal_cleanup"] = True
    ctx["phases"] = {
        "record_start": lifecycle_phase(observed=True, requested=True),
        "terminal_cleanup": lifecycle_phase(),
    }
    chrome_proc: subprocess.Popen[bytes] | None = None
    descriptor_path: str | None = None
    try:
        capability_authority = authority or {
            "allowed_origins": allowed_origins,
            "data_exposure": "public_read_only",
            "side_effect_scope": "none",
            "approval": "not_required",
            "readback_required": True,
        }
        capability_path, capability_binding = write_recording_cleanup_capability(
            recording_dir,
            run_id=run_id,
            requested_session=requested_session,
            session=session,
            mode=args.mode,
            lifecycle=args.lifecycle,
            automation_id=automation_id,
            task_id=getattr(args, "task_id", None),
            nonce=ctx["nonce"],
            authority=capability_authority,
            authority_digest=authority_digest,
        )
        ctx["cleanup_capability_path"] = capability_path
        ctx["cleanup_capability_sha256"] = capability_binding
        if owned_chrome:
            if shared_lease is not None:
                # A shared lease already owns the exact room, profile, and
                # runtime locks for this run.  Re-claiming the room would
                # widen ownership, and prepare_profile() would misclassify
                # the retained temporary profile as a single-use collision.
                room = validate_shared_profile_record_start(
                    config,
                    shared_lease,
                    profile=profile,
                    port=port,
                    run_id=run_id,
                    room_id=str(ctx.get("room_id") or ""),
                )
            else:
                room = room_registry_claim(
                    config,
                    lifecycle=args.lifecycle,
                    run_id=run_id,
                    profile=profile if args.lifecycle != "single-use" else None,
                    port=port,
                    task_id=getattr(args, "task_id", None),
                    automation_id=automation_id,
                    activity="record-start",
                )
                ctx["room_id"] = room["room_id"]
                profile, port = room["profile"], room["port"]
                ctx["profile"], ctx["port"] = profile, port
            if args.lifecycle == TEMPORARY_LIFECYCLE and shared_lease is None:
                temp_info = prepare_temporary_profile(config, mode=args.mode, automation_id=automation_id, task_id=args.task_id, run_id=run_id, authority_digest=authority_digest or "", authority_scope=ctx["authority_scope"], account_identity=account_identity, origins=allowed_origins, download_dir=download_dir, requested_port=port)
                profile = temp_info["profile"]
                ctx["profile"] = profile
                ctx["profile_created"] = True
                ctx["lock_paths"].append(temp_info["profile_lock"])
            elif shared_lease is not None:
                # The immutable marker check is performed above; no profile
                # mutation or new-profile initialization is allowed here.
                pass
            else:
                prepare_profile(profile, args.lifecycle == "scheduled", automation_id, download_dir, run_id, ctx["nonce"])
            if os.path.exists(download_dir):
                raise Blocker("browser_use_download_directory_collision")
            os.mkdir(download_dir, 0o700)
            profile_lock = temporary_profile_lock_path(config, profile) if args.lifecycle == TEMPORARY_LIFECYCLE else os.path.join(config["roots"]["locks"], f"profile-{hashlib.sha256(os.path.realpath(profile).encode()).hexdigest()[:24]}.lock")
            port_lock = os.path.join(config["roots"]["locks"], f"port-{port}.lock")
            payload = {"schema": "browser-use-lock.v1", "run_id": run_id, "nonce": ctx["nonce"], "helper_pid": os.getpid(), "helper_start_time": psutil.Process(os.getpid()).create_time(), "automation_id": automation_id, "port": port, "canonical_profile": os.path.realpath(profile)}
            if args.lifecycle != TEMPORARY_LIFECYCLE:
                lock_file(profile_lock, payload)
                ctx["lock_paths"].append(profile_lock)
            elif shared_lease is None:
                lock_file(port_lock, payload)
                ctx["lock_paths"].append(port_lock)
            ctx["launch_attempted"] = True
            chrome_proc, process_identity = launch_chrome(config, profile, port, download_dir, config["roots"]["browser_use_home"])
            annotate_lock_process_identity(ctx["lock_paths"], run_id, ctx["nonce"], process_identity)
            ctx["process"] = process_identity
        else:
            ctx["process"] = process_identity
        ctx["listener_verified"] = True
        ctx["process_identity_verified"] = True
        recording = recording_env(
            config,
            recording_dir,
            recording_status_path(recording_dir),
            framerate,
            run_id=run_id,
            session=session,
        )
        if browser_harness_cli_enabled():
            start_command = ["record-start", recording["recording_name"], recording["recording_source_dir"], f"{run_id} browser recording"]
            code, readback_exit = run_cli_keep_alive(config, config["roots"]["browser_use_home"], port, session, start_command, True, recording=recording)
        else:
            code, readback_exit = run_cli_keep_alive(config, config["roots"]["browser_use_home"], port, session, command, True, recording=recording)
        if code != 0:
            raise Blocker("browser_use_recording_start_command_failed", _LAST_RECORDING_CLI_FAILURE or str(code))
        if readback_exit != 0:
            raise Blocker("browser_use_recording_start_readback_failed", str(readback_exit))
        if browser_harness_cli_enabled():
            write_harness_recording_status(recording["status_path"], recording, active=True, finalized=False)
        else:
            read_recording_status(recording["status_path"], require_active=True)
        tab_inventory = read_recording_tab_inventory(recording["tab_inventory_path"]) if browser_harness_cli_enabled() else None
        descriptor_path = recording_descriptor_path(config, run_id, session, ctx["nonce"])
        helper_snapshot, helper_digest = create_helper_snapshot(recording_dir)
        versions_hashes = {**versions, "recording_tools": {kind: {"canonical_path": path} for kind, path in recording_tools.items()}}
        dependency_digest = hashlib.sha256(json.dumps(versions_hashes, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
        process_lineage = {"run_id": run_id, "session": session, "profile": profile, "port": port, "process": process_identity, "helper_sha256": helper_digest}
        process_lineage_digest = hashlib.sha256(json.dumps(process_lineage, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
        ctx["phases"]["record_start"] = lifecycle_phase(observed=True, requested=True, executed=True, completed=True)
        descriptor = {"schema": RECORDING_SCHEMA, "status": "active", "mode": args.mode, "lifecycle": args.lifecycle, "completion_policy": TEMPORARY_COMPLETION_POLICY if args.lifecycle == TEMPORARY_LIFECYCLE else None, "completion_assessment": "not_assessed" if args.lifecycle == TEMPORARY_LIFECYCLE else None, "retention_decision": "retain_until_ai_assessment" if args.lifecycle == TEMPORARY_LIFECYCLE else None, "task_completion_signal": "not_received" if args.lifecycle == TEMPORARY_LIFECYCLE else None, "run_id": run_id, "session": session, "requested_session": requested_session, "automation_id": automation_id, "task_id": ctx.get("task_id"), "creation_binding": ctx.get("creation_binding"), "authority_scope": ctx.get("authority_scope"), "nonce": ctx["nonce"], "helper_sha256": helper_digest, "helper_generation": 1, "helper_snapshot_path": helper_snapshot, "helper_snapshot_owner_uid": EUID, "helper_snapshot_mode": 0o700, "helper_dependency_digest": dependency_digest, "helper_process_lineage_digest": process_lineage_digest, "started_at": ctx["started_at"], "authority_sha256": authority_digest, "authority_lineage_root_sha256": authority_digest, "authority_generation": 1 if authority_digest else None, "authority_issuer_id": str(authority.get("issuer_id") if authority and authority.get("issuer_id") else "initial"), "authority_issued_at": authority.get("authority_issued_at") if authority else None, "authority_lineage_expires_at": authority.get("authority_lineage_expires_at") if authority else None, "authority_expires_at": authority.get("expires_at") if authority else None, "authority_current_path": os.path.realpath(args.authority) if authority and args.authority else None, "authority_ledger_path": os.path.join(recording_dir, "authority-generation-ledger.jsonl") if authority_digest else None, "authority_history_path": os.path.join(recording_dir, "authority-descriptor-history.jsonl") if authority_digest else None, "account_identity": account_identity, "target_origins": sorted(set(origins or allowed_origins)), "recording_dir": recording_dir, "status_path": recording["status_path"], "operation_ledger_path": os.path.join(recording_dir, "operation-ledger.jsonl"), "recording_framerate": framerate, "port": port, "process": process_identity, "owned_chrome": owned_chrome, "profile": profile, "download_dir": download_dir, "lock_paths": list(ctx["lock_paths"]), "room_id": ctx.get("room_id"), "cleanup_capability_path": ctx["cleanup_capability_path"], "cleanup_capability_sha256": ctx["cleanup_capability_sha256"], "phases": ctx["phases"], "operations": [command[0]], "failed_operations": [], "navigation_verified": False, "navigation_readback_operation_id": None, "navigation_readback_lineage_digest": None, "navigation_readback_helper_sha256": None, "business_effect_proof": "not_applicable", "source_handoff_descriptor": os.path.realpath(args.handoff_descriptor) if args.handoff_descriptor else None, "source_run_id": source_run_id if args.handoff_descriptor else None, "source_session": source_session if args.handoff_descriptor else None, "shared_profile_lease_path": shared_lease_path, "shared_profile_marker_sha256": shared_lease.get("profile_marker_sha256") if shared_lease is not None else None, "profile_owner_task_id": ctx.get("profile_owner_task_id"), "profile_owner_run_id": ctx.get("profile_owner_run_id"), "profile_owner_authority_sha256": ctx.get("profile_owner_authority_sha256"), "profile_owner_authority_scope": ctx.get("profile_owner_authority_scope"), "profile_owner_origins": shared_lease.get("origins") if shared_lease is not None else None, "versions_hashes": versions_hashes, "uploads": uploads, "recording_backend": "browser-harness" if browser_harness_cli_enabled() else "legacy", "recording_source_dir": recording.get("recording_source_dir", recording_dir), "harness_workspace": recording.get("harness_workspace"), "tab_inventory_path": recording.get("tab_inventory_path"), "tab_inventory": tab_inventory}
        if shared_lease is not None:
            descriptor["profile_owner_automation_id"] = ctx.get("profile_owner_automation_id")
        if owner_metadata is not None:
            descriptor["owner_metadata"] = owner_metadata
        descriptor["operation_lineage_digest"] = operation_lineage_digest(descriptor)
        if authority is not None:
            append_authority_generation(descriptor, authority, digest=authority_digest, generation=1, previous_digest=None, issuer_id=descriptor["authority_issuer_id"])
        _write_recording_descriptor(config, descriptor_path, descriptor, replace=False)
        update_recording_cleanup_capability(
            ctx["cleanup_capability_path"],
            expected_run_id=run_id,
            expected_session=session,
            expected_nonce=ctx["nonce"],
            cleanup_phase=lifecycle_phase(),
            phase=ctx["phases"]["record_start"],
            resource_binding={"room_id": ctx.get("room_id"), "port": ctx.get("port"), "profile": ctx.get("profile")},
        )
        print(json.dumps({"status": "recording_ready", "descriptor": descriptor_path, "run_id": run_id, "requested_session": requested_session, "session": session, "session_socket_path_bytes": session_socket_path_bytes(config["roots"]["browser_use_home"], session), "recording_dir": recording_dir, "recording_status": "active", "phases": ctx["phases"], "finalized": False}, sort_keys=True))
        return 0
    except (Blocker, OSError, subprocess.SubprocessError, ValueError, json.JSONDecodeError) as exc:
        failure = exc.code if isinstance(exc, Blocker) else "browser_use_recording_runtime_error"
        cleanup_failure = _recording_failure_cleanup(config, ctx, chrome_proc, args.lifecycle, descriptor_path)
        if cleanup_failure:
            failure = cleanup_failure
        print(json.dumps({"status": "blocked", "exact_blocker": failure, "cleanup": ctx.get("cleanup", {}), "phases": ctx.get("phases", {}), "cleanup_capability_path": ctx.get("cleanup_capability_path"), "finalized": False}, sort_keys=True))
        return 1


def automatic_effectful_recovery_readback(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    descriptor_path: str,
    recording: dict[str, Any],
    trigger_operation_id: str,
    trigger_blocker: str,
    *,
    pre_dispatch_observation: dict[str, Any] | None = None,
    dispatch_failure_marker: str | None = None,
) -> dict[str, Any]:
    """Take one bounded, read-only same-resource snapshot after an unknown effect.

    This is deliberately advisory: a successful ``state`` probe never clears
    the pending external-effect reconciliation and never authorizes replay.
    It only leaves fresh evidence so the next continuation can start from a
    known recovery point without requiring the user to manually issue the
    first safe probe.
    """
    recovery_operation_id = uuid.uuid4().hex
    result: dict[str, Any] = {
        "status": "not_attempted",
        "trigger_operation_id": trigger_operation_id,
        "operation_id": recovery_operation_id,
        "trigger_blocker": str(trigger_blocker)[:160],
        "command": ["state"],
        "observed_at": iso(now_utc()),
        "external_effects": "none",
    }
    try:
        append_operation_intent_durable(
            descriptor,
            operation_id=recovery_operation_id,
            command=["state"],
            external_effects="none",
            outcome="automatic_recovery_readback_intent",
        )
    except Exception as exc:
        result["status"] = "blocked"
        result["exact_blocker"] = exc.code if isinstance(exc, Blocker) else "browser_use_recovery_readback_intent_persist_failed"
    else:
        try:
            if pre_dispatch_observation is not None:
                post_dispatch_observation = _safe_state_observation(config, descriptor, recording)
                code = 0
                readback_exit = post_dispatch_observation.get("readback_exit", 1)
            else:
                code, readback_exit = run_cli_keep_alive(
                    config,
                    config["roots"]["browser_use_home"],
                    descriptor["port"],
                    descriptor["session"],
                    ["state"],
                    True,
                    recording=recording,
                )
                post_dispatch_observation = None
            result["dispatch_exit"] = code
            result["readback_exit"] = readback_exit
            if code == 0 and readback_exit == 0:
                result["status"] = "verified"
                outcome = "automatic_recovery_readback_verified"
            else:
                result["status"] = "blocked"
                result["exact_blocker"] = "browser_use_recording_recovery_readback_failed"
                outcome = "automatic_recovery_readback_failed"
        except Exception as exc:
            result["status"] = "blocked"
            result["exact_blocker"] = exc.code if isinstance(exc, Blocker) else "browser_use_recording_recovery_readback_failed"
            outcome = "automatic_recovery_readback_failed"
            post_dispatch_observation = None
        try:
            append_operation_outcome_durable(
                descriptor,
                operation_id=recovery_operation_id,
                command=["state"],
                external_effects="none",
                outcome=outcome,
            )
        except Exception as exc:
            result["status"] = "blocked"
            result["exact_blocker"] = exc.code if isinstance(exc, Blocker) else "browser_use_recovery_readback_outcome_persist_failed"

    descriptor["last_recovery_readback"] = result
    if (
        pre_dispatch_observation is not None
        and result.get("status") == "verified"
        and dispatch_failure_marker in NO_DISPATCH_FAILURE_MARKERS
        and isinstance(post_dispatch_observation, dict)
        and pre_dispatch_observation.get("state_sha256") == post_dispatch_observation.get("state_sha256")
        and pre_dispatch_observation.get("tab_inventory") == post_dispatch_observation.get("tab_inventory")
        and pre_dispatch_observation.get("downloads") == post_dispatch_observation.get("downloads")
    ):
        target_fingerprint = str(descriptor.get("dispatch_proof_target_fingerprint") or "")
        if target_fingerprint:
            receipt = {
                "schema": NO_DISPATCH_RECEIPT_SCHEMA,
                "status": "ready_for_reconciliation",
                "run_id": descriptor.get("run_id"),
                "session": descriptor.get("session"),
                "operation_id": trigger_operation_id,
                "recovery_operation_id": recovery_operation_id,
                "last_recovery_trigger_operation_id": trigger_operation_id,
                "recovery_status": "verified",
                "authority_sha256": descriptor.get("authority_sha256"),
                "operation_lineage_digest": descriptor.get("operation_lineage_digest") or operation_lineage_digest(descriptor),
                "descriptor_binding_sha256": _no_dispatch_binding_digest(descriptor, trigger_operation_id, target_fingerprint),
                "command_name": str((descriptor.get("dispatch_proof_command_public") or descriptor.get("dispatch_proof_command", [""]))[0]),
                "command": descriptor.get("dispatch_proof_command_public") or _dispatch_proof_public_command(descriptor.get("dispatch_proof_command", [])),
                "target_fingerprint": target_fingerprint,
                "failure_marker": dispatch_failure_marker,
                "dispatch_phase": "not_started",
                "dispatch_exit": 1,
                "readback_exit": 0,
                "pre_observation": pre_dispatch_observation,
                "post_observation": post_dispatch_observation,
                "effect_observation": {
                    "state_unchanged": True,
                    "tab_inventory_unchanged": True,
                    "downloads_unchanged": True,
                    "network_dispatch_started": False,
                },
                "observed_at": iso(now_utc()),
            }
            try:
                result["no_dispatch_receipt"] = _persist_no_dispatch_receipt(descriptor, receipt)
                result["no_dispatch_receipt_status"] = receipt["status"]
            except Exception as exc:
                result["no_dispatch_receipt_error"] = exc.code if isinstance(exc, Blocker) else "browser_use_no_dispatch_receipt_persist_failed"
    # Do not recompute or clear the reconciliation summary here.  The
    # original operation remains unknown until a workflow-owned reconcile
    # command proves its outcome; this helper is evidence collection only.
    try:
        _write_recording_descriptor(config, descriptor_path, descriptor, replace=True)
    except Exception:
        result["descriptor_persisted"] = False
    else:
        result["descriptor_persisted"] = True
    return result


@recording_command_exclusive
def record_command(args: argparse.Namespace) -> int:
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    refresh_helper = bool(getattr(args, "refresh_helper", False))
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        # The command lease wrapper already performs the no-page-command
        # automatic generation admission.  Re-read permissively so the
        # refreshed descriptor can be validated against the current helper.
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
    )
    descriptor = ensure_current_helper_generation(config, descriptor, os.path.realpath(args.descriptor))
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    authority = recording_authority(
        config,
        descriptor,
        args.authority,
        command_class="record-command",
        renewal_path=getattr(args, "authority_renewal", None),
        auto_renew=bool(getattr(args, "auto_renew", False)),
    )
    if getattr(args, "authority_renewal", None) or getattr(args, "auto_renew", False):
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    validate_recording_process(config, descriptor)
    command = list(args.command)
    if command and command[0] == "--":
        command = command[1:]
    command, origins, _ = validate_command(command, descriptor["mode"], config, list(descriptor["target_origins"]), descriptor["download_dir"])
    if command[0] == "screenshot":
        command[1] = validate_capture_path(command[1], os.path.realpath(descriptor["recording_dir"]))
    if command[0] == "close":
        raise Blocker("browser_use_recording_close_is_helper_owned")
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])
    semantic_readback: dict[str, Any] | None = None
    operation_id = uuid.uuid4().hex
    operation_effect = "none" if is_read_only_command(command) else "unknown"
    pre_dispatch_observation: dict[str, Any] | None = None
    if should_capture_dispatch_proof(command, bool(getattr(args, "capture_dispatch_proof", False))):
        if command[0] not in NO_DISPATCH_PROOF_COMMANDS or operation_effect != "unknown":
            raise Blocker("browser_use_no_dispatch_proof_command_unsupported")
        pre_dispatch_observation = _safe_state_observation(config, descriptor, recording)
        descriptor["dispatch_proof_target_fingerprint"] = _no_dispatch_command_fingerprint(command)
        descriptor["dispatch_proof_command"] = list(command)
        descriptor["dispatch_proof_command_public"] = _dispatch_proof_public_command(command)
    if descriptor.get("authentication_state") == "waiting" and command[0] not in READ_ONLY_OPERATION_COMMANDS:
        raise Blocker("browser_use_authentication_wait_required")
    wait_for_auth = not bool(getattr(args, "no_wait_for_auth", False))
    auth_wait_timeout = float(getattr(args, "auth_wait_timeout_seconds", AUTHENTICATION_WAIT_TIMEOUT_SECONDS))
    auth_wait_poll = float(getattr(args, "auth_wait_poll_seconds", AUTHENTICATION_WAIT_POLL_SECONDS))
    require_no_pending_effect_reconciliation(descriptor, effectful=operation_effect == "unknown")
    append_operation_intent_durable(descriptor, operation_id=operation_id, command=command, external_effects=operation_effect, outcome="dispatch_intent_durable")
    if operation_effect == "unknown":
        # The durable pre-dispatch phase is the last safe point at which a
        # dispatch may still be prevented.  The second phase is written
        # immediately before the Browser Harness transport below; failures
        # after that point are never replayed automatically.
        persist_effect_evidence(
            config,
            descriptor,
            os.path.realpath(args.descriptor),
            operation_id,
            command,
            phase="intent_recorded",
            effect_state="pre-dispatch",
        )
        persist_effect_evidence(
            config,
            descriptor,
            os.path.realpath(args.descriptor),
            operation_id,
            command,
            phase="dispatch_started",
            effect_state="dispatch-started",
            ack_status="pending",
        )
    semantic_readback_command = descriptor.get("mode") == "public" and descriptor.get("lifecycle") == "single-use" and isinstance(descriptor.get("target_origins"), list) and len(descriptor.get("target_origins")) == 1 and command in (["state"], ["get", "title"], ["get", "url"])
    captured_readback = ""
    try:
        if getattr(args, "capture_readback", False):
            code, readback_exit, captured_readback = run_cli_keep_alive_capture(config, config["roots"]["browser_use_home"], descriptor["port"], descriptor["session"], command, recording=recording)
        elif semantic_readback_command:
            code, readback_exit, semantic_readback = run_cli_semantic_readback(config, config["roots"]["browser_use_home"], descriptor["port"], descriptor["session"], command, descriptor, recording)
        else:
            code, readback_exit = run_cli_keep_alive(config, config["roots"]["browser_use_home"], descriptor["port"], descriptor["session"], command, True, recording=recording)
    except Exception as exc:
        if operation_effect == "unknown":
            persist_effect_evidence(
                config,
                descriptor,
                os.path.realpath(args.descriptor),
                operation_id,
                command,
                phase="unknown_effect",
                effect_state="unknown-effect",
                ack_status="missing",
                error_code=exc.code if isinstance(exc, Blocker) else "dispatch_exception",
            )
        append_operation_outcome_durable(descriptor, operation_id=operation_id, command=command, external_effects="unknown" if operation_effect == "unknown" else "none", outcome=exc.code if isinstance(exc, Blocker) else "dispatch_exception")
        if operation_effect in OPERATION_EFFECT_STATES:
            descriptor["recovery_state"] = "readback_pending"
            descriptor["effectful_retry_allowed"] = False
            try:
                write_recovery_checkpoint(
                    descriptor,
                    exact_blocker=exc.code if isinstance(exc, Blocker) else "browser_use_recording_dispatch_exception",
                    next_action="fresh authority admission, then same-resource read-only reconcile; never replay the effectful command",
                    operation_id=operation_id,
                )
                _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
            except Exception:
                pass
            if operation_effect == "unknown":
                automatic_effectful_recovery_readback(
                    config,
                    descriptor,
                    os.path.realpath(args.descriptor),
                    recording,
                    operation_id,
                    exc.code if isinstance(exc, Blocker) else "browser_use_recording_dispatch_exception",
                    pre_dispatch_observation=pre_dispatch_observation,
                    dispatch_failure_marker=_LAST_RECORDING_CLI_FAILURE,
                )
        raise
    if code != 0:
        parser_syntax_error = command[0] == "eval" and str(_LAST_RECORDING_CLI_FAILURE).strip() == "syntax_error"
        failure_marker = _LAST_RECORDING_CLI_FAILURE or "browser_use_recording_command_failed"
        if operation_effect == "unknown":
            persist_effect_evidence(
                config,
                descriptor,
                os.path.realpath(args.descriptor),
                operation_id,
                command,
                phase="unknown_effect",
                effect_state="unknown-effect",
                ack_status="missing",
                error_code=failure_marker,
            )
        append_operation_outcome_durable(descriptor, operation_id=operation_id, command=command, external_effects="unknown" if operation_effect == "unknown" else "none", outcome="dispatch_failed")
        if operation_effect in OPERATION_EFFECT_STATES:
            descriptor["recovery_state"] = "readback_pending"
            descriptor["effectful_retry_allowed"] = False
            try:
                write_recovery_checkpoint(
                    descriptor,
                    exact_blocker="browser_use_recording_command_failed",
                    next_action="fresh authority admission, then same-resource read-only reconcile; never replay the effectful command",
                    operation_id=operation_id,
                )
                _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
            except Exception:
                pass
        if operation_effect == "unknown" and not parser_syntax_error:
            automatic_effectful_recovery_readback(
                config,
                descriptor,
                os.path.realpath(args.descriptor),
                recording,
                operation_id,
                "browser_use_recording_command_failed",
                pre_dispatch_observation=pre_dispatch_observation,
                dispatch_failure_marker=_LAST_RECORDING_CLI_FAILURE,
            )
        if parser_syntax_error:
            # Browser Use rejected the expression before page dispatch.  Keep
            # the command blocked, but do not manufacture an unknown external
            # effect that would prevent an otherwise safe continuation.
            # The immutable ledger keeps the original dispatch_failed row;
            # the explicit reconciliation row records the safe resolution.
            append_operation_reconciliation_durable(
                descriptor,
                operation_id=operation_id,
                external_effects="none",
                outcome="syntax_error_before_page_dispatch",
            )
        # Preserve the sanitized, command-specific failure marker emitted by
        # the Browser Harness (for example, an upload pre-dispatch marker).
        # The generic code hid whether the failure happened before file
        # selection dispatch, which made the same-run reconciliation point
        # unnecessarily ambiguous.  recording_cli_failure_marker() removes
        # stderr/page data before this value reaches the receipt.
        raise Blocker(_LAST_RECORDING_CLI_FAILURE or "browser_use_recording_command_failed", _LAST_RECORDING_CLI_FAILURE or str(code))
    if readback_exit != 0:
        append_operation_outcome_durable(descriptor, operation_id=operation_id, command=command, external_effects="unknown" if operation_effect == "unknown" else "none", outcome="readback_failed")
        if operation_effect == "unknown":
            persist_effect_evidence(
                config,
                descriptor,
                os.path.realpath(args.descriptor),
                operation_id,
                command,
                phase="unknown_effect",
                effect_state="unknown-effect",
                ack_status="missing",
                error_code="browser_use_recording_readback_failed",
            )
        if operation_effect in OPERATION_EFFECT_STATES:
            descriptor["recovery_state"] = "readback_pending"
            descriptor["effectful_retry_allowed"] = False
            try:
                write_recovery_checkpoint(
                    descriptor,
                    exact_blocker="browser_use_recording_readback_failed",
                    next_action="fresh authority admission, then same-resource read-only reconcile; never replay the effectful command",
                    operation_id=operation_id,
                )
                _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
            except Exception:
                pass
        if operation_effect == "unknown":
            automatic_effectful_recovery_readback(
                config,
                descriptor,
                os.path.realpath(args.descriptor),
                recording,
                operation_id,
                "browser_use_recording_readback_failed",
                pre_dispatch_observation=pre_dispatch_observation,
                dispatch_failure_marker=_LAST_RECORDING_CLI_FAILURE,
            )
        raise Blocker("browser_use_recording_readback_failed", str(readback_exit))
    read_recording_status(descriptor["status_path"], require_active=True)
    if descriptor.get("tab_inventory_path"):
        descriptor["tab_inventory"] = read_recording_tab_inventory(descriptor["tab_inventory_path"])
    navigation_evidence: dict[str, Any] | None = None
    if command[0] in {"open", "back", "switch"}:
        descriptor["navigation_verified"] = False
        descriptor["navigation_readback_operation_id"] = None
        descriptor["navigation_readback_lineage_digest"] = None
        descriptor["navigation_readback_helper_sha256"] = None
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    if command[0] in {"open", "back", "switch"}:
        try:
            if command[0] == "open":
                navigation_evidence = _verified_navigation_with_checkpoint(
                    config,
                    descriptor,
                    recording,
                    os.path.realpath(args.descriptor),
                    expected_origins=origins,
                    expected_url=command[1],
                    operation_id=operation_id,
                )
                current_origin = str(navigation_evidence["origin"])
                if current_origin not in set(origins):
                    raise Blocker("browser_use_open_readback_origin_mismatch")
            else:
                navigation_evidence = _verified_navigation_with_checkpoint(
                    config,
                    descriptor,
                    recording,
                    os.path.realpath(args.descriptor),
                    operation_id=operation_id,
                )
            mark_navigation_readback_verified(descriptor, operation_id)
        except Exception as exc:
            if isinstance(exc, Blocker) and exc.code == "browser_use_authentication_required" and wait_for_auth:
                auth_result = _wait_for_authentication(
                    config,
                    descriptor,
                    os.path.realpath(args.descriptor),
                    recording,
                    expected_origins=origins if command[0] == "open" else list(descriptor["target_origins"]),
                    expected_url=command[1] if command[0] == "open" else None,
                    operation_id=operation_id,
                    timeout_seconds=auth_wait_timeout,
                    poll_interval_seconds=auth_wait_poll,
                )
                if auth_result.get("status") == "authenticated":
                    navigation_evidence = auth_result["evidence"]
                    mark_navigation_readback_verified(descriptor, operation_id)
                else:
                    external_effects = "none" if operation_effect == "none" else "unknown"
                    append_operation_outcome_durable(
                        descriptor,
                        operation_id=operation_id,
                        command=command,
                        external_effects=external_effects,
                        outcome="authentication_waiting",
                    )
                    descriptor["status"] = "continued"
                    if external_effects == "unknown":
                        descriptor["recovery_state"] = "readback_pending"
                        descriptor["effectful_retry_allowed"] = False
                    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
                    print(json.dumps({
                        "status": "authentication_waiting",
                        "descriptor": os.path.realpath(args.descriptor),
                        "run_id": descriptor["run_id"],
                        "session": descriptor["session"],
                        "room_id": descriptor.get("room_id"),
                        "port": descriptor.get("port"),
                        "same_profile": True,
                        "exact_blocker": auth_result.get("exact_blocker", "browser_use_authentication_required"),
                        "attempts": auth_result.get("attempts", 0),
                        "resume_command": "record-auth-wait",
                        "finalized": False,
                    }, sort_keys=True))
                    return 1
            elif isinstance(exc, Blocker) and exc.code == "browser_use_authentication_required" and not wait_for_auth:
                _persist_authentication_wait(
                    config,
                    descriptor,
                    os.path.realpath(args.descriptor),
                    state="waiting",
                    exact_blocker=exc.code,
                    operation_id=operation_id,
                    expected_navigation=_navigation_binding_for_url(command[1]) if command[0] == "open" else None,
                    started_at=iso(now_utc()),
                    deadline_at=now_utc(),
                    attempts=0,
                    recording=recording,
                )
                append_operation_outcome_durable(
                    descriptor,
                    operation_id=operation_id,
                    command=command,
                    external_effects="none" if operation_effect == "none" else "unknown",
                    outcome="authentication_waiting",
                )
                descriptor["status"] = "continued"
                _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
                raise
            else:
                external_effects = "none" if operation_effect == "none" else "unknown"
                append_operation_outcome_durable(
                    descriptor,
                    operation_id=operation_id,
                    command=command,
                    external_effects=external_effects,
                    outcome="navigation_readback_failed",
                )
                if external_effects == "unknown":
                    descriptor["recovery_state"] = "readback_pending"
                    descriptor["effectful_retry_allowed"] = False
                    try:
                        write_recovery_checkpoint(
                            descriptor,
                            exact_blocker=exc.code if isinstance(exc, Blocker) else "browser_use_navigation_readback_failed",
                            next_action="same-run navigation reconciliation by operation_id; do not replay navigation",
                            operation_id=operation_id,
                        )
                        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
                    except Exception:
                        pass
                    automatic_effectful_recovery_readback(
                        config,
                        descriptor,
                        os.path.realpath(args.descriptor),
                        recording,
                        operation_id,
                        exc.code if isinstance(exc, Blocker) else "browser_use_navigation_readback_failed",
                    )
                raise
    elif command[0] == "close-tab":
        descriptor["navigation_verified"] = False
        descriptor["navigation_readback_operation_id"] = None
        descriptor["navigation_readback_lineage_digest"] = None
        descriptor["navigation_readback_helper_sha256"] = None
    elif operation_effect == "unknown":
        # A successful command exit is not enough proof after a potentially
        # effectful dispatch.  Refresh the same-run origin/readiness proof
        # before any success outcome is written.  A failed probe is itself an
        # unknown external effect and therefore blocks every later retry.
        try:
            navigation_evidence = _verified_navigation_with_checkpoint(config, descriptor, recording, os.path.realpath(args.descriptor), operation_id=operation_id)
            mark_navigation_readback_verified(descriptor, operation_id)
        except Exception as exc:
            if isinstance(exc, Blocker) and exc.code == "browser_use_authentication_required" and wait_for_auth:
                auth_result = _wait_for_authentication(
                    config,
                    descriptor,
                    os.path.realpath(args.descriptor),
                    recording,
                    expected_origins=list(descriptor["target_origins"]),
                    expected_url=None,
                    operation_id=operation_id,
                    timeout_seconds=auth_wait_timeout,
                    poll_interval_seconds=auth_wait_poll,
                )
                outcome = "authentication_resumed_external_effect_unknown" if auth_result.get("status") == "authenticated" else "authentication_waiting"
                append_operation_outcome_durable(
                    descriptor,
                    operation_id=operation_id,
                    command=command,
                    external_effects="unknown",
                    outcome=outcome,
                )
                descriptor["recovery_state"] = "readback_pending"
                descriptor["effectful_retry_allowed"] = False
                _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
                print(json.dumps({
                    "status": "authentication_resumed_reconciliation_required" if auth_result.get("status") == "authenticated" else "authentication_waiting",
                    "descriptor": os.path.realpath(args.descriptor),
                    "run_id": descriptor["run_id"],
                    "session": descriptor["session"],
                    "room_id": descriptor.get("room_id"),
                    "port": descriptor.get("port"),
                    "same_profile": True,
                    "exact_blocker": "browser_use_external_effect_reconciliation_required" if auth_result.get("status") == "authenticated" else auth_result.get("exact_blocker", "browser_use_authentication_required"),
                    "pending_reconciliation": pending_operation_reconciliation_ids(descriptor),
                    "finalized": False,
                }, sort_keys=True))
                return 1
            if isinstance(exc, Blocker) and exc.code == "browser_use_authentication_required" and not wait_for_auth:
                _persist_authentication_wait(
                    config,
                    descriptor,
                    os.path.realpath(args.descriptor),
                    state="waiting",
                    exact_blocker=exc.code,
                    operation_id=operation_id,
                    expected_navigation=None,
                    started_at=iso(now_utc()),
                    deadline_at=now_utc(),
                    attempts=0,
                    recording=recording,
                )
            append_operation_outcome_durable(
                descriptor,
                operation_id=operation_id,
                command=command,
                external_effects="unknown",
                outcome="post_dispatch_navigation_readback_failed",
            )
            raise Blocker(
                "browser_use_navigation_readback_failed",
                exc.code if isinstance(exc, Blocker) else type(exc).__name__,
            ) from exc
    descriptor["status"] = "continued"
    descriptor["operations"].append(command[0])
    if operation_effect == "unknown":
        descriptor["business_effect_proof"] = "workflow_source_of_truth_required"
    append_operation_outcome_durable(
        descriptor,
        operation_id=operation_id,
        command=command,
        external_effects="executed" if operation_effect == "unknown" else operation_effect,
        outcome="dispatch_completed",
    )
    if descriptor.get("authentication_state") == "authenticated" and operation_effect == "none":
        descriptor["recovery_state"] = "reconciled"
        descriptor["effectful_retry_allowed"] = True
    if navigation_evidence is not None:
        descriptor["last_navigation_readback"] = navigation_evidence
    if origins:
        descriptor["target_origins"] = sorted(set(descriptor["target_origins"]) | set(origins))
    if semantic_readback is not None:
        stored_semantic_readback = safe_semantic_readback_for_storage(semantic_readback)
        if stored_semantic_readback is not None:
            descriptor.setdefault("semantic_readback_parts", {})[str(stored_semantic_readback["kind"])] = stored_semantic_readback
    if operation_effect == "unknown":
        if not effect_evidence_binding_matches(descriptor, operation_id, command):
            persist_effect_evidence(
                config,
                descriptor,
                os.path.realpath(args.descriptor),
                operation_id,
                command,
                phase="unknown_effect",
                effect_state="unknown-effect",
                ack_status="mismatch",
                error_code="browser_use_effect_ack_binding_mismatch",
            )
            raise Blocker("browser_use_effect_ack_binding_mismatch")
        persist_effect_evidence(
            config,
            descriptor,
            os.path.realpath(args.descriptor),
            operation_id,
            command,
            phase="acknowledged",
            effect_state="acknowledged",
            ack_status="validated_same_run_readback",
        )
    if descriptor.get("owned_chrome") and descriptor.get("room_id"):
        room_registry_update(
            config,
            descriptor["room_id"],
            run_id=descriptor["run_id"],
            state="active",
            activity=f"record-command-{command[0]}",
        )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    try:
        capture_recording_frame(
            config,
            config["roots"]["browser_use_home"],
            descriptor["port"],
            descriptor["session"],
            recording,
        )
    except Exception as exc:
        try:
            write_recovery_checkpoint(
                descriptor,
                exact_blocker=exc.code if isinstance(exc, Blocker) else "browser_use_recording_capture_failed",
                next_action="repair the recording artifact path, then same-run readback; do not replay the already-proven command",
                operation_id=operation_id,
            )
            _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
        except Exception:
            pass
        raise
    output = {"status": "recording_continued", "descriptor": os.path.realpath(args.descriptor), "session": descriptor["session"], "recording_status": "active", "external_effects": "executed" if operation_effect == "unknown" else operation_effect, "business_effect_proof": "workflow_source_of_truth_required" if operation_effect == "unknown" else "not_applicable", "operation_id": operation_id, "navigation_readback": navigation_evidence, "authority_sha256": descriptor.get("authority_sha256"), "authority_generation": descriptor.get("authority_generation"), "authority_current_path": descriptor.get("authority_current_path"), "authority_expires_at": descriptor.get("authority_expires_at"), "finalized": False}
    if captured_readback:
        # Keep the helper envelope below the bounded parent-process stdout
        # limit.  The raw page snapshot is transient only; callers persist
        # hashes/lengths, never this body.  Preserve the beginning because
        # login/error markers appear before the result list on most pages.
        output["captured_readback"] = captured_readback[:MAX_CAPTURED_READBACK_CHARS]
        if len(captured_readback) > MAX_CAPTURED_READBACK_CHARS:
            output["captured_readback"] += "\n[truncated]"
    if semantic_readback is not None:
        output["readback"] = semantic_readback
    print(json.dumps(output, sort_keys=True))
    return 0


def _last_json_object(text: str) -> dict[str, Any] | None:
    for line in reversed(str(text or "").splitlines()):
        value = line.strip()
        if not value:
            continue
        try:
            parsed = json.loads(value)
        except (TypeError, ValueError, json.JSONDecodeError):
            continue
        if isinstance(parsed, dict):
            return parsed
    return None


def _validate_record_batch_action_metadata(raw: str, count: int) -> list[dict[str, Any]]:
    if not raw:
        return [{"index": index, "sequence": index + 1} for index in range(count)]
    try:
        parsed = json.loads(raw)
    except (TypeError, ValueError, json.JSONDecodeError) as exc:
        raise Blocker("browser_use_record_batch_action_metadata_invalid") from exc
    if not isinstance(parsed, list) or len(parsed) != count:
        raise Blocker("browser_use_record_batch_action_metadata_invalid")
    result: list[dict[str, Any]] = []
    for index, item in enumerate(parsed):
        if not isinstance(item, dict):
            raise Blocker("browser_use_record_batch_action_metadata_invalid")
        sequence = item.get("sequence")
        nonce = str(item.get("nonce") or "")
        if not isinstance(sequence, int) or sequence < 1 or not re.fullmatch(r"[A-Za-z0-9._:-]{8,180}", nonce):
            raise Blocker("browser_use_record_batch_action_metadata_invalid")
        result.append({
            "index": index,
            "sequence": sequence,
            "nonce": nonce,
            "name": str(item.get("name") or ""),
            "argument_count": int(item.get("argument_count") or 0),
            "origins": sorted({str(origin) for origin in item.get("origins", []) if str(origin)}),
        })
    return result


@recording_command_exclusive
def record_batch(args: argparse.Namespace) -> int:
    """Run a bounded read-only command batch in one Browser Use process."""
    global _RECORD_BATCH_TRANSPORT
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor_path = os.path.realpath(args.descriptor)
    descriptor = read_recording_descriptor(
        config,
        descriptor_path,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
    )
    descriptor = ensure_current_helper_generation(config, descriptor, descriptor_path)
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    authority = recording_authority(
        config,
        descriptor,
        args.authority,
        command_class="record-command",
        renewal_path=getattr(args, "authority_renewal", None),
        auto_renew=bool(getattr(args, "auto_renew", False)),
    )
    if getattr(args, "authority_renewal", None) or getattr(args, "auto_renew", False):
        _write_recording_descriptor(config, descriptor_path, descriptor, replace=True)
    validate_recording_process(config, descriptor)
    def _batch_authority_readback() -> dict[str, Any]:
        current = descriptor
        try:
            current = read_recording_descriptor(
                config,
                descriptor_path,
                run_id,
                session,
                allow_helper_hash_mismatch=True,
                allow_pinned_helper_reexec=False,
            )
        except Blocker:
            pass
        return {
            "authority_sha256": current.get("authority_sha256"),
            "authority_generation": current.get("authority_generation"),
            "authority_current_path": current.get("authority_current_path"),
            "authority_expires_at": current.get("authority_expires_at"),
        }
    try:
        raw_commands = json.loads(str(args.commands_json or ""))
    except (TypeError, ValueError, json.JSONDecodeError) as exc:
        raise Blocker("browser_use_record_batch_commands_invalid") from exc
    if not isinstance(raw_commands, list) or not raw_commands or len(raw_commands) > 8:
        raise Blocker("browser_use_record_batch_commands_invalid")
    commands: list[list[str]] = []
    command_origins: list[list[str]] = []
    for raw_command in raw_commands:
        if not isinstance(raw_command, list) or not raw_command:
            raise Blocker("browser_use_record_batch_command_invalid")
        command, origins, _uploads = validate_command(
            [str(value) for value in raw_command],
            descriptor["mode"],
            config,
            list(descriptor["target_origins"]),
            descriptor["download_dir"],
        )
        if not is_read_only_command(command):
            raise Blocker("browser_use_record_batch_effectful_command_rejected")
        if command[0] == "close":
            raise Blocker("browser_use_record_batch_helper_owned_command_rejected")
        if command[0] == "screenshot":
            command[1] = validate_capture_path(command[1], os.path.realpath(descriptor["recording_dir"]))
        commands.append(command)
        command_origins.append(sorted({str(origin) for origin in origins if str(origin)}))
    action_metadata = _validate_record_batch_action_metadata(getattr(args, "batch_actions_json", ""), len(commands))
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])
    try:
        batch_transport = run_cli3_record_batch_transport(
            config,
            config["roots"]["browser_use_home"],
            descriptor["port"],
            descriptor["session"],
            commands,
            recording=recording,
        )
    except Blocker as exc:
        try:
            _cleanup_record_batch_transport_paths(recording["recording_source_dir"])
        except Blocker as cleanup_exc:
            raise cleanup_exc from exc
        raise
    _RECORD_BATCH_TRANSPORT = batch_transport
    results: list[dict[str, Any]] = []
    captured: dict[str, str] = {}
    for index, command in enumerate(commands):
        child_values = vars(args).copy()
        child_values["command"] = ["--", *command]
        child_values["capture_dispatch_proof"] = False
        child_values["refresh_helper"] = False
        # The one-process transport supplies the same transient envelope to
        # the existing command finalizer.  The caller may still ask us not to
        # return raw readback; it is filtered from the outer result below.
        child_values["capture_readback"] = True
        child_values.pop("commands_json", None)
        child_values.pop("batch_actions_json", None)
        child_args = argparse.Namespace(**child_values)
        buffer = io.StringIO()
        try:
            with contextlib.redirect_stdout(buffer):
                return_code = record_command.__wrapped__(child_args)
        except Blocker as exc:
            parsed = _last_json_object(buffer.getvalue()) or {}
            results.append({
                "index": index,
                "status": "blocked",
                "exact_blocker": exc.code,
                "return_code": 1,
                "command": {
                    "name": command[0],
                    "argument_count": max(0, len(command) - 1),
                    "origins": command_origins[index],
                },
                **({"helper": parsed} if parsed else {}),
            })
            print(json.dumps({
                "status": "blocked",
                "exact_blocker": exc.code,
                "descriptor": descriptor_path,
                "run_id": run_id,
                "session": descriptor["session"],
                "recording_status": "active",
                "external_effects": "none",
                "batch": True,
                "command_count": len(commands),
                "completed_count": index,
                "batch_actions": action_metadata,
                "results": results,
                "captured_readback": captured,
                "finalized": False,
                **_batch_authority_readback(),
            }, sort_keys=True))
            _cleanup_record_batch_transport_paths(recording["recording_source_dir"])
            _RECORD_BATCH_TRANSPORT = None
            return 1
        parsed = _last_json_object(buffer.getvalue()) or {}
        if bool(getattr(args, "capture_readback", False)) and isinstance(parsed.get("captured_readback"), str):
            captured[str(index)] = parsed["captured_readback"][:MAX_CAPTURED_READBACK_CHARS]
        results.append({
            "index": index,
            "status": str(parsed.get("status") or ("completed" if return_code == 0 else "blocked")),
            "exact_blocker": str(parsed.get("exact_blocker") or ""),
            "return_code": int(return_code),
            "operation_id": str(parsed.get("operation_id") or ""),
            "external_effects": str(parsed.get("external_effects") or "none"),
            "readback": parsed.get("readback"),
            "navigation_readback": parsed.get("navigation_readback"),
        })
        if return_code != 0 or results[-1]["status"] != "recording_continued":
            blocker = results[-1]["exact_blocker"] or "browser_use_record_batch_command_failed"
            print(json.dumps({
                "status": "blocked",
                "exact_blocker": blocker,
                "descriptor": descriptor_path,
                "run_id": run_id,
                "session": descriptor["session"],
                "recording_status": "active",
                "external_effects": "none",
                "batch": True,
                "command_count": len(commands),
                "completed_count": index + 1,
                "batch_actions": action_metadata,
                "results": results,
                "captured_readback": captured,
                "finalized": False,
                **_batch_authority_readback(),
            }, sort_keys=True))
            _cleanup_record_batch_transport_paths(recording["recording_source_dir"])
            _RECORD_BATCH_TRANSPORT = None
            return 1
    if batch_transport.get("capture_queue") or batch_transport.get("frame_queue"):
        _cleanup_record_batch_transport_paths(recording["recording_source_dir"])
        _RECORD_BATCH_TRANSPORT = None
        raise Blocker("browser_use_record_batch_transport_queue_not_consumed")
    _RECORD_BATCH_TRANSPORT = None
    print(json.dumps({
        "status": "recording_continued",
        "descriptor": descriptor_path,
        "run_id": run_id,
        "session": descriptor["session"],
        "recording_status": "active",
        "external_effects": "none",
        "business_effect_proof": "not_applicable",
        "batch": True,
        "transport": batch_transport.get("transport"),
        "browser_process_count": batch_transport.get("browser_process_count"),
        "transport_job_count": batch_transport.get("job_count"),
        "command_count": len(commands),
        "completed_count": len(commands),
        "batch_actions": action_metadata,
        "results": results,
        "captured_readback": captured,
        "finalized": False,
        **_batch_authority_readback(),
    }, sort_keys=True))
    return 0

def record_auth_wait(args: argparse.Namespace) -> int:
    """Resume a bounded human-login wait on the exact existing recording room."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        # This command is read-only with respect to the browser and may be
        # the first continuation after a helper sync.  Adopt the current
        # helper generation atomically before polling; no navigation or
        # effectful command is replayed.
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
    )
    descriptor = ensure_current_helper_generation(config, descriptor, os.path.realpath(args.descriptor))
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    authority = recording_authority(
        config,
        descriptor,
        args.authority,
        command_class="record-auth-wait",
        renewal_path=getattr(args, "authority_renewal", None),
        auto_renew=bool(getattr(args, "auto_renew", False)),
    )
    if getattr(args, "authority_renewal", None) or getattr(args, "auto_renew", False):
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    validate_recording_process(config, descriptor)
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])
    wait_state = descriptor.get("authentication_wait") or {}
    checkpoint = None
    checkpoint_path = descriptor.get("checkpoint_path")
    if isinstance(checkpoint_path, str) and os.path.lexists(checkpoint_path):
        checkpoint = read_json_safe(checkpoint_path)
    if descriptor.get("authentication_state") != "waiting":
        if not isinstance(checkpoint, dict) or checkpoint.get("exact_blocker") != "browser_use_authentication_required":
            raise Blocker("browser_use_authentication_wait_not_pending")
        wait_state = {
            "operation_id": checkpoint.get("operation_id"),
            "expected_navigation": None,
        }
    operation_id = wait_state.get("operation_id") if isinstance(wait_state.get("operation_id"), str) else None
    result = _wait_for_authentication(
        config,
        descriptor,
        os.path.realpath(args.descriptor),
        recording,
        expected_origins=list(descriptor["target_origins"]),
        expected_url=None,
        operation_id=operation_id,
        timeout_seconds=float(getattr(args, "auth_wait_timeout_seconds", AUTHENTICATION_WAIT_TIMEOUT_SECONDS)),
        poll_interval_seconds=float(getattr(args, "auth_wait_poll_seconds", AUTHENTICATION_WAIT_POLL_SECONDS)),
    )
    if result.get("status") != "authenticated":
        print(json.dumps({
            "status": "authentication_waiting",
            "descriptor": os.path.realpath(args.descriptor),
            "run_id": run_id,
            "session": descriptor["session"],
            "room_id": descriptor.get("room_id"),
            "port": descriptor.get("port"),
            "same_profile": True,
            "exact_blocker": result.get("exact_blocker", "browser_use_authentication_required"),
            "attempts": result.get("attempts", 0),
            "resume_command": "record-auth-wait",
            "finalized": False,
        }, sort_keys=True))
        return 1

    if operation_id:
        mark_navigation_readback_verified(descriptor, operation_id)
    pending = update_reconciliation_summary(descriptor)
    if not pending:
        descriptor["recovery_state"] = "reconciled"
        descriptor["effectful_retry_allowed"] = True
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    print(json.dumps({
        "status": "authentication_resumed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "room_id": descriptor.get("room_id"),
        "port": descriptor.get("port"),
        "same_profile": True,
        "operation_id": operation_id,
        "pending_reconciliation": pending,
        "effectful_resume_allowed": not pending,
        "next_action": "continue the original same-run flow" if not pending else "reconcile the pending external effect before retry",
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_resume(args: argparse.Namespace) -> int:
    """Resume recording on the same verified scheduled Chrome process."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        # A resumed recording is aligned automatically before the first
        # browser command; no manual refresh flag is required.
        allow_pinned_helper_reexec=False,
    )
    descriptor = ensure_current_helper_generation(config, descriptor, os.path.realpath(args.descriptor))
    require_temporary_task_id(args, descriptor)
    if descriptor.get("status") not in {"active", "continued"}:
        raise Blocker("browser_use_recording_resume_descriptor_not_continuable")
    recording_authority(
        config,
        descriptor,
        args.authority,
        command_class="record-resume",
        renewal_path=getattr(args, "authority_renewal", None),
        auto_renew=bool(getattr(args, "auto_renew", False)),
    )
    if getattr(args, "authority_renewal", None) or getattr(args, "auto_renew", False):
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    validate_recording_process(config, descriptor)
    old_status = read_json_safe(descriptor["status_path"])
    if old_status.get("finalized") is not True:
        raise Blocker("browser_use_recording_resume_requires_finalized_recorder")
    recording_dir = validate_recording_output_dir(args.recording_dir)
    recording = recording_env(
        config,
        recording_dir,
        recording_status_path(recording_dir),
        descriptor["recording_framerate"],
        run_id=run_id,
        session=session,
    )
    command = [
        "record-start",
        recording["recording_name"],
        recording["recording_source_dir"],
        f"{run_id} browser recording resumed",
    ]
    code, readback_exit = run_cli_keep_alive(
        config,
        config["roots"]["browser_use_home"],
        descriptor["port"],
        descriptor["session"],
        command,
        True,
        recording=recording,
    )
    if code != 0:
        raise Blocker("browser_use_recording_resume_start_failed", _LAST_RECORDING_CLI_FAILURE or str(code))
    if readback_exit != 0:
        raise Blocker("browser_use_recording_resume_readback_failed", str(readback_exit))
    write_harness_recording_status(recording["status_path"], recording, active=True, finalized=False)
    descriptor.update({
        "status": "continued",
        "helper_sha256": sha256_trusted_helper(canonical_helper_path()),
        "recording_dir": recording["recording_dir"],
        "status_path": recording["status_path"],
        "recording_source_dir": recording["recording_source_dir"],
        "harness_workspace": recording.get("harness_workspace"),
        "tab_inventory_path": recording.get("tab_inventory_path"),
        "recording_backend": "browser-harness",
        "operations": list(descriptor.get("operations", [])) + ["record-resume"],
        "tab_inventory": read_recording_tab_inventory(recording["tab_inventory_path"]),
    })
    if descriptor.get("owned_chrome") and descriptor.get("room_id"):
        room_registry_update(config, descriptor["room_id"], run_id=descriptor["run_id"], state="active", activity="record-resume")
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    print(json.dumps({
        "status": "recording_resumed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "recording_dir": recording["recording_dir"],
        "recording_status": "active",
        "same_process": True,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_recover(args: argparse.Namespace) -> int:
    """Perform bounded, read-only same-run reconciliation before resuming work."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=True,
        allow_stale_runtime_recovery=True,
    )
    descriptor = ensure_current_helper_generation(config, descriptor, os.path.realpath(args.descriptor), allow_historical=True)
    require_temporary_task_id(args, descriptor)
    recording_authority(
        config,
        descriptor,
        args.authority,
        command_class="record-recover",
        renewal_path=getattr(args, "authority_renewal", None),
        auto_renew=bool(getattr(args, "auto_renew", False)),
    )
    if getattr(args, "authority_renewal", None) or getattr(args, "auto_renew", False):
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    stale_runtime = _recording_runtime_is_stale(config, descriptor)
    if stale_runtime:
        try:
            output = reconcile_stale_recording_runtime(
                config,
                descriptor,
                os.path.realpath(args.descriptor),
                max_attempts=getattr(args, "max_attempts", MAX_RECORDING_RECOVERY_ATTEMPTS),
            )
        except Blocker as exc:
            current_attempts = int(descriptor.get("recovery_retry_count", 0))
            configured_limit = max(1, min(int(descriptor.get("recovery_max_attempts", getattr(args, "max_attempts", MAX_RECORDING_RECOVERY_ATTEMPTS))), MAX_RECORDING_RECOVERY_ATTEMPTS))
            descriptor["recovery_max_attempts"] = configured_limit
            descriptor["recovery_retry_count"] = min(current_attempts + 1, configured_limit)
            try:
                write_recovery_checkpoint(
                    descriptor,
                    exact_blocker=exc.code,
                    next_action="preserve unknown effects and retry only within the descriptor recovery limit",
                )
                _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
            except Exception:
                pass
            print(json.dumps({"status": "blocked", "descriptor": os.path.realpath(args.descriptor), "exact_blocker": exc.code, "detail": public_blocker_detail(exc.detail), "finalized": False}, sort_keys=True))
            return 1
        print(json.dumps(output, sort_keys=True))
        return 0
    require_recording_continuable(descriptor)
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    validate_recording_process(config, descriptor)
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])
    # Close only the missing ledger outcome records.  The replacement outcome
    # is deliberately ``unknown`` so recovery cannot make an effectful retry
    # admissible or turn finalization into a false success.
    close_orphan_operation_intents(descriptor)
    max_attempts = max(1, min(int(getattr(args, "max_attempts", MAX_RECORDING_RECOVERY_ATTEMPTS)), MAX_RECORDING_RECOVERY_ATTEMPTS))
    descriptor_max_attempts = max(1, min(int(descriptor.get("recovery_max_attempts", max_attempts)), MAX_RECORDING_RECOVERY_ATTEMPTS))
    prior_recovery_attempts = int(descriptor.get("recovery_retry_count", 0))
    if prior_recovery_attempts >= descriptor_max_attempts:
        write_recovery_checkpoint(
            descriptor,
            exact_blocker="browser_use_recording_recovery_attempt_limit",
            next_action="fresh same-task admission or new owned run",
        )
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
        print(json.dumps({"status": "blocked", "descriptor": os.path.realpath(args.descriptor), "exact_blocker": "browser_use_recording_recovery_attempt_limit", "recovery_attempts": prior_recovery_attempts, "finalized": False}, sort_keys=True))
        return 1
    max_attempts = min(max_attempts, descriptor_max_attempts - prior_recovery_attempts)
    descriptor["recovery_max_attempts"] = descriptor_max_attempts
    last_blocker = "browser_use_recording_recovery_readback_failed"
    for attempt in range(1, max_attempts + 1):
        operation_id = uuid.uuid4().hex
        append_operation_intent_durable(descriptor, operation_id=operation_id, command=["state"], external_effects="none", outcome="recovery_readback_intent")
        try:
            code, readback_exit, stdout = run_cli_keep_alive_capture(
                config,
                config["roots"]["browser_use_home"],
                descriptor["port"],
                descriptor["session"],
                ["state"],
                recording=recording,
            )
            if code != 0 or readback_exit != 0:
                last_blocker = "browser_use_recording_recovery_readback_failed"
                append_operation_outcome_durable(descriptor, operation_id=operation_id, command=["state"], external_effects="none", outcome=last_blocker)
                continue
            parsed = _parse_cli_json(stdout)
            raw_state = _state_text_from_cli(parsed)
            summary = _target_state_summary(parsed, raw_state)
            append_operation_outcome_durable(descriptor, operation_id=operation_id, command=["state"], external_effects="none", outcome="recovery_readback_verified")
            if descriptor.get("tab_inventory_path"):
                descriptor["tab_inventory"] = read_recording_tab_inventory(descriptor["tab_inventory_path"])
            descriptor["status"] = "continued"
            descriptor["recovery_retry_count"] = prior_recovery_attempts + attempt - 1
            descriptor["last_recovery_readback"] = summary
            pending = update_reconciliation_summary(descriptor)
            _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
            print(json.dumps({"status": "recording_recovered", "descriptor": os.path.realpath(args.descriptor), "run_id": run_id, "session": descriptor["session"], "attempts": attempt, "navigation_verified": descriptor.get("navigation_verified") is True, "readback": summary, "pending_reconciliation": pending, "effectful_resume_allowed": not pending, "finalized": False}, sort_keys=True))
            return 0
        except Exception as exc:
            last_blocker = exc.code if isinstance(exc, Blocker) else "browser_use_recording_recovery_failed"
            try:
                append_operation_outcome_durable(descriptor, operation_id=operation_id, command=["state"], external_effects="none", outcome=last_blocker)
            except Blocker as outcome_exc:
                # A recovery attempt must not continue as if its own ledger
                # outcome were durable.  Stop the bounded loop and persist the
                # stronger reconciliation blocker.
                last_blocker = outcome_exc.code
                break
    descriptor["recovery_retry_count"] = prior_recovery_attempts + max_attempts
    update_reconciliation_summary(descriptor)
    write_recovery_checkpoint(descriptor, exact_blocker=last_blocker, next_action="fresh same-run admission or new owned run")
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    print(json.dumps({"status": "blocked", "descriptor": os.path.realpath(args.descriptor), "exact_blocker": last_blocker, "recovery_attempts": max_attempts, "finalized": False}, sort_keys=True))
    return 1


def record_reconcile_navigation(args: argparse.Namespace) -> int:
    """Clear one recovered ``open`` intent only after fresh same-run readback.

    ``record-recover`` deliberately records an unknown outcome and therefore
    cannot reopen effectful work.  This command is the narrowly scoped owner
    path for the read-only case where the original intent was already marked
    ``external_effects=none`` and the live run now proves the authorized page
    is present.  It never dispatches the original navigation again.
    """
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        # A live run may be undergoing this helper's bounded, read-only
        # reconciliation after a canonical helper update.  The immutable
        # run-pinned snapshot remains the fallback for all later commands.
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
    )
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    recording_authority(config, descriptor, args.authority)
    validate_recording_process(config, descriptor)
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])

    pending = pending_operation_reconciliation_ids(descriptor)
    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    # A prior invocation of this same bounded read-only repair may have
    # stopped after dispatching its get/state probe but before appending the
    # probe outcome.  Only the helper's own, externally-none readback intents
    # are eligible for this idempotent closure; the original open intent is
    # never touched here.
    outcome_ids = {
        str(row.get("operation_id"))
        for row in rows
        if row.get("phase") == "outcome"
    }
    for row in rows:
        if (
            row.get("phase") == "intent"
            and str(row.get("operation_id")) not in outcome_ids
            and row.get("external_effects") == "none"
            and row.get("outcome") == "navigation_reconciliation_readback_intent"
            and isinstance(row.get("command"), dict)
            and row["command"].get("name") in {"get", "state"}
        ):
            append_operation_outcome_durable(
                descriptor,
                operation_id=str(row["operation_id"]),
                command=[str(row["command"].get("name")), "readback"],
                external_effects="none",
                outcome="navigation_reconciliation_readback_recovered",
            )
    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    if args.operation_id not in pending:
        reconciled = {
            operation_id
            for item in descriptor.get("reconciliations", [])
            if isinstance(item, dict) and item.get("resolution") in {"none", "executed"}
            for operation_id in item.get("operation_ids", [])
            if isinstance(operation_id, str)
        }
        ledger_reconciled = {
            str(row.get("operation_id"))
            for row in rows
            if row.get("phase") == "reconciliation" and row.get("external_effects") in {"none", "executed"}
        }
        if args.operation_id in reconciled or args.operation_id in ledger_reconciled:
            remaining = pending_operation_reconciliation_ids(descriptor)
            print(json.dumps({
                "status": "recording_reconciliation_already_completed",
                "descriptor": os.path.realpath(args.descriptor),
                "run_id": run_id,
                "session": descriptor["session"],
                "operation_id": args.operation_id,
                "resolution": "none",
                "pending_reconciliation": remaining,
                "fresh_run_admission_allowed": not remaining,
                "effectful_resume_allowed": not remaining,
                "finalized": False,
            }, sort_keys=True))
            return 0
        raise Blocker("browser_use_navigation_reconciliation_operation_not_pending")

    _navigation_reconciliation_candidate(
        rows,
        args.operation_id,
        expected_lineage_digest=descriptor.get("operation_lineage_digest"),
    )

    def readback_operation(command: list[str], outcome: str) -> dict[str, Any]:
        readback_id = uuid.uuid4().hex
        append_operation_intent_durable(
            descriptor,
            operation_id=readback_id,
            command=command,
            external_effects="none",
            outcome="navigation_reconciliation_readback_intent",
        )
        try:
            code, readback_exit, stdout = run_cli_keep_alive_capture(
                config,
                config["roots"]["browser_use_home"],
                descriptor["port"],
                descriptor["session"],
                command,
                recording=recording,
            )
            if code != 0 or readback_exit != 0:
                append_operation_outcome_durable(
                    descriptor,
                    operation_id=readback_id,
                    command=command,
                    external_effects="none",
                    outcome=outcome,
                )
                raise Blocker("browser_use_navigation_reconciliation_readback_failed", command[0])
            parsed = _parse_cli_json(stdout)
            if command == ["state"]:
                raw_state = _state_text_from_cli(parsed)
                summary = _target_state_summary(parsed, raw_state)
            else:
                # ``get url`` is a URL envelope, not a page-state envelope.
                # Keep only a digest/length so no URL text enters durable state.
                url_value = str(_first_field(parsed, {"url", "href"}) or "")
                summary = {
                    "url_sha256": hashlib.sha256(url_value.encode("utf-8")).hexdigest(),
                    "url_length": len(url_value),
                }
            append_operation_outcome_durable(
                descriptor,
                operation_id=readback_id,
                command=command,
                external_effects="none",
                outcome="navigation_reconciliation_readback_verified",
            )
            return {"operation_id": readback_id, **summary}
        except Blocker as exc:
            try:
                append_operation_outcome_durable(
                    descriptor,
                    operation_id=readback_id,
                    command=command,
                    external_effects="none",
                    outcome="navigation_reconciliation_readback_failed",
                )
            except Blocker:
                pass
            raise
        except Exception as exc:
            append_operation_outcome_durable(
                descriptor,
                operation_id=readback_id,
                command=command,
                external_effects="none",
                outcome=outcome,
            )
            raise Blocker("browser_use_navigation_reconciliation_readback_failed", type(exc).__name__) from exc

    try:
        navigation = _verified_navigation_with_checkpoint(
            config,
            descriptor,
            recording,
            os.path.realpath(args.descriptor),
            expected_origins=list(descriptor["target_origins"]),
        )
        url_readback = readback_operation(["get", "url"], "navigation_url_readback_failed")
        state_readback = readback_operation(["state"], "navigation_state_readback_failed")
    except Exception as exc:
        blocker = exc.code if isinstance(exc, Blocker) else "browser_use_navigation_reconciliation_readback_failed"
        try:
            write_recovery_checkpoint(
                descriptor,
                exact_blocker=blocker,
                next_action="preserve the pending navigation intent and stop before any effectful operation",
                operation_id=args.operation_id,
            )
            _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
        except Exception:
            pass
        raise

    append_operation_reconciliation_durable(
        descriptor,
        operation_id=args.operation_id,
        external_effects="none",
        outcome="navigation_readback_verified_no_external_effect",
    )
    descriptor.setdefault("reconciliations", []).append({
        "operation_ids": [args.operation_id],
        "resolution": "none",
        "basis": "browser_use_navigation_readback_verified_no_external_effect",
        "readback_operation_ids": [url_readback["operation_id"], state_readback["operation_id"]],
        "navigation_origin": navigation.get("origin") if isinstance(navigation, dict) else str(navigation),
        "navigation_path_sha256": navigation.get("path_sha256") if isinstance(navigation, dict) else None,
        "navigation_path_length": navigation.get("path_length") if isinstance(navigation, dict) else None,
        "state_sha256": state_readback["state_sha256"],
        "state_length": state_readback["state_length"],
        "recorded_at": iso(now_utc()),
    })
    mark_navigation_readback_verified(descriptor, args.operation_id)
    remaining = update_reconciliation_summary(descriptor, completed_blocker="browser_use_navigation_reconciliation_completed")
    descriptor["last_navigation_readback"] = navigation
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_navigation_reconciliation_completed",
        next_action="fresh same-task target inspection before any effectful UI operation",
        operation_id=args.operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    remaining = pending_operation_reconciliation_ids(descriptor)
    print(json.dumps({
        "status": "recording_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_id": args.operation_id,
        "resolution": "none",
        "evidence": "browser_use_navigation_readback_verified_no_external_effect",
        "readback": {"navigation": navigation, "url": url_readback, "state": state_readback},
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "effectful_resume_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_cleanup_daemon(args: argparse.Namespace) -> int:
    """Close one dead-Chrome recording daemon through an explicit cleanup lane.

    This is intentionally separate from ``record-recover``.  It is the
    compatibility path for a temporary descriptor pinned to an older helper
    generation after Chrome has already disappeared.  The command never
    resumes the browser or clears unknown effects; it only accepts a
    user-approved, descriptor-bound terminal cleanup.
    """
    config = read_toml()
    versions = validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor_path = os.path.realpath(args.descriptor)
    descriptor = read_recording_descriptor(
        config,
        descriptor_path,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
        allow_expired_temporary=True,
        allow_stale_runtime_recovery=True,
    )
    descriptor = ensure_current_helper_generation(config, descriptor, descriptor_path, allow_historical=True)
    require_temporary_task_id(args, descriptor)
    if not bool(getattr(args, "delete_approved", False)):
        raise Blocker("browser_use_temporary_delete_approval_required")
    if descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE or descriptor.get("owned_chrome") is not True:
        raise Blocker("browser_use_temporary_daemon_cleanup_unsupported")
    recording_authority(config, descriptor, args.authority, cleanup_only=True)
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    try:
        process_present = validate_handoff_process_identity(
            config,
            {"process": descriptor["process"], "port": descriptor["port"], "profile": descriptor["profile"]},
            allow_missing=True,
        )
    except Blocker as exc:
        if exc.code != "browser_use_handoff_chrome_missing":
            raise
        process_present = False
    if process_present:
        raise Blocker("browser_use_recording_cleanup_process_still_live")
    assert_debug_listener_absent(int(descriptor["port"]))
    _close_stale_recording_daemon_if_present(config, descriptor)
    assert_debug_listener_absent(int(descriptor["port"]))
    descriptor.update({
        "status": "stale",
        "recovery_state": "restartable",
        "completion_assessment": "ai_judged_complete",
        "retention_decision": "delete_approved",
        "task_completion_signal": "delete_approval_received",
        "delete_approval_at": iso(now_utc()),
        "stale_state": {
            "state": "abandoned",
            "uncertain": True,
            "exact_blocker": "browser_use_recording_stale_runtime_reconciled",
            "updated_at": iso(now_utc()),
        },
    })
    _write_recording_descriptor(config, descriptor_path, descriptor, replace=True)
    cleanup = cleanup_stale_recording_descriptor(
        config,
        versions,
        descriptor,
        descriptor_path,
        delete_approved=True,
    )
    print(json.dumps({
        "status": "cleanup_completed" if cleanup.get("external_effects") != "unknown" else "cleanup_completed_external_effects_pending",
        "descriptor": descriptor_path,
        "cleanup_receipt": cleanup.get("cleanup_receipt"),
        "cleanup": cleanup.get("cleanup", {}),
        "pending_reconciliation": cleanup.get("pending_reconciliation", []),
        "external_effects": cleanup.get("external_effects"),
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_reconcile_eval_syntax_error(args: argparse.Namespace) -> int:
    """Reconcile one parser-level eval failure without replaying the eval."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
    )
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    recording_authority(config, descriptor, args.authority)
    validate_recording_process(config, descriptor)
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])

    pending = pending_operation_reconciliation_ids(descriptor)
    reconciled = {
        operation_id
        for item in descriptor.get("reconciliations", [])
        if isinstance(item, dict) and item.get("resolution") in {"none", "executed"}
        for operation_id in item.get("operation_ids", [])
        if isinstance(operation_id, str)
    }
    if args.operation_id not in pending:
        if args.operation_id in reconciled:
            remaining = pending_operation_reconciliation_ids(descriptor)
            print(json.dumps({
                "status": "recording_reconciliation_already_completed",
                "descriptor": os.path.realpath(args.descriptor),
                "run_id": run_id,
                "session": descriptor["session"],
                "operation_id": args.operation_id,
                "resolution": "none",
                "evidence": args.evidence_code,
                "pending_reconciliation": remaining,
                "fresh_run_admission_allowed": not remaining,
                "effectful_resume_allowed": not remaining,
                "finalized": False,
            }, sort_keys=True))
            return 0
        raise Blocker("browser_use_eval_reconciliation_operation_not_pending")

    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    _eval_syntax_error_reconciliation_candidate(rows, args.operation_id)
    navigation = _verified_navigation_with_checkpoint(
        config,
        descriptor,
        recording,
        os.path.realpath(args.descriptor),
        expected_origins=list(descriptor["target_origins"]),
    )

    expected_path = str(args.expected_path)
    parsed_expected = urllib.parse.urlparse(expected_path)
    if (
        not expected_path.startswith("/")
        or parsed_expected.path != expected_path
        or parsed_expected.query
        or parsed_expected.fragment
    ):
        raise Blocker("browser_use_eval_reconciliation_expected_path_invalid")
    if (
        not isinstance(navigation, dict)
        or navigation.get("path_length") != len(expected_path)
        or navigation.get("path_sha256") != hashlib.sha256(expected_path.encode("utf-8")).hexdigest()
    ):
        raise Blocker("browser_use_eval_reconciliation_expected_path_mismatch")

    readback_id = uuid.uuid4().hex
    readback_command = ["state"]
    append_operation_intent_durable(
        descriptor,
        operation_id=readback_id,
        command=readback_command,
        external_effects="none",
        outcome="eval_reconciliation_readback_intent",
    )
    try:
        code, readback_exit, stdout = run_cli_keep_alive_capture(
            config,
            config["roots"]["browser_use_home"],
            descriptor["port"],
            descriptor["session"],
            readback_command,
            recording=recording,
        )
        if code != 0 or readback_exit != 0:
            append_operation_outcome_durable(
                descriptor,
                operation_id=readback_id,
                command=readback_command,
                external_effects="none",
                outcome="eval_reconciliation_readback_failed",
            )
            raise Blocker("browser_use_eval_reconciliation_state_readback_failed")
        parsed = _parse_cli_json(stdout)
        raw_state = _state_text_from_cli(parsed)
        state_marker = str(args.state_marker)
        if not state_marker or state_marker not in raw_state:
            append_operation_outcome_durable(
                descriptor,
                operation_id=readback_id,
                command=readback_command,
                external_effects="none",
                outcome="eval_reconciliation_state_marker_missing",
            )
            raise Blocker("browser_use_eval_reconciliation_state_marker_missing")
        append_operation_outcome_durable(
            descriptor,
            operation_id=readback_id,
            command=readback_command,
            external_effects="none",
            outcome="eval_reconciliation_readback_verified",
        )
    except Blocker:
        try:
            append_operation_outcome_durable(
                descriptor,
                operation_id=readback_id,
                command=readback_command,
                external_effects="none",
                outcome="eval_reconciliation_readback_failed",
            )
        except Blocker:
            pass
        raise
    except Exception as exc:
        append_operation_outcome_durable(
            descriptor,
            operation_id=readback_id,
            command=readback_command,
            external_effects="none",
            outcome="eval_reconciliation_readback_failed",
        )
        raise Blocker("browser_use_eval_reconciliation_state_readback_failed", type(exc).__name__) from exc

    append_operation_reconciliation_durable(
        descriptor,
        operation_id=args.operation_id,
        external_effects="none",
        outcome="eval_syntax_error_before_page_dispatch",
    )
    descriptor.setdefault("reconciliations", []).append({
        "operation_ids": [args.operation_id],
        "resolution": "none",
        "basis": args.evidence_code,
        "eval_shape": "one_scalar_argument",
        "navigation_origin": navigation.get("origin"),
        "navigation_path_sha256": navigation.get("path_sha256"),
        "navigation_path_length": navigation.get("path_length"),
        "state_marker_sha256": hashlib.sha256(str(args.state_marker).encode("utf-8")).hexdigest(),
        "state_marker_length": len(str(args.state_marker)),
        "state_sha256": hashlib.sha256(raw_state.encode("utf-8")).hexdigest(),
        "state_length": len(raw_state),
        "readback_operation_ids": [readback_id],
        "recorded_at": iso(now_utc()),
    })
    mark_navigation_readback_verified(descriptor, args.operation_id)
    remaining = update_reconciliation_summary(descriptor, completed_blocker="browser_use_eval_reconciliation_completed")
    descriptor["last_navigation_readback"] = navigation
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_eval_reconciliation_completed",
        next_action="fresh target inspect before the next effectful operation",
        operation_id=args.operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    remaining = pending_operation_reconciliation_ids(descriptor)
    print(json.dumps({
        "status": "recording_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_id": args.operation_id,
        "resolution": "none",
        "evidence": args.evidence_code,
        "navigation_readback": navigation,
        "state_marker_sha256": hashlib.sha256(str(args.state_marker).encode("utf-8")).hexdigest(),
        "state_marker_length": len(str(args.state_marker)),
        "state_sha256": hashlib.sha256(raw_state.encode("utf-8")).hexdigest(),
        "state_length": len(raw_state),
        "readback_operation_id": readback_id,
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "effectful_resume_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_reconcile_target_not_interactive_live(args: argparse.Namespace) -> int:
    """Reconcile one live target-click rejection after fresh noninteractive proof."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
    )
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    authority = recording_authority(config, descriptor, args.authority)
    if not authority:
        raise Blocker("browser_use_authority_required")
    validate_recording_process(config, descriptor)
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])

    target_hash = hashlib.sha256(str(args.target_text).encode("utf-8")).hexdigest()
    failures = [
        item
        for item in descriptor.get("failed_operations", [])
        if isinstance(item, dict)
        and item.get("operation") == "target-click"
        and item.get("operation_id") == args.operation_id
        and item.get("exact_blocker") == "browser_use_target_click_failed"
        and item.get("external_action_possible") is True
        and item.get("target_text_length") == len(args.target_text)
        and item.get("target_text_sha256") == target_hash
    ]
    if len(failures) != 1:
        raise Blocker("browser_use_target_reconciliation_evidence_mismatch")
    pending = pending_operation_reconciliation_ids(descriptor)
    if args.operation_id not in pending:
        raise Blocker("browser_use_target_reconciliation_operation_not_pending")
    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    _target_click_reconciliation_candidate(rows, args.operation_id)

    navigation = _verified_navigation_with_checkpoint(
        config,
        descriptor,
        recording,
        os.path.realpath(args.descriptor),
        expected_origins=list(descriptor["target_origins"]),
    )
    candidate, before = _target_capture(config, descriptor, recording, args.target_text)
    if candidate.get("interactive") is not False:
        raise Blocker("browser_use_target_reconciliation_candidate_changed")
    if candidate.get("text_length") != len(args.target_text) or candidate.get("match_text_sha256") != target_hash:
        raise Blocker("browser_use_target_reconciliation_evidence_mismatch")

    append_operation_reconciliation_durable(
        descriptor,
        operation_id=args.operation_id,
        external_effects="none",
        outcome="target_rejected_noninteractive_before_dispatch",
    )
    descriptor.setdefault("reconciliations", []).append({
        "operation_ids": [args.operation_id],
        "resolution": "none",
        "basis": "runtime_error_browser_use_target_not_interactive",
        "target_text_length": len(args.target_text),
        "target_text_sha256": target_hash,
        "candidate_interactive": False,
        "candidate_bbox": candidate.get("bbox"),
        "navigation_origin": navigation.get("origin") if isinstance(navigation, dict) else str(navigation),
        "before_state": before,
        "recorded_at": iso(now_utc()),
    })
    mark_navigation_readback_verified(descriptor, args.operation_id)
    remaining = update_reconciliation_summary(descriptor, completed_blocker="browser_use_target_reconciliation_completed")
    descriptor["last_navigation_readback"] = navigation
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_target_reconciliation_completed",
        next_action="fresh target inspect, then one explicit fresh-bbox coordinate click if still authorized",
        operation_id=args.operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    remaining = pending_operation_reconciliation_ids(descriptor)
    print(json.dumps({
        "status": "recording_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_id": args.operation_id,
        "resolution": "none",
        "evidence": "runtime_error_browser_use_target_not_interactive",
        "candidate": candidate,
        "before_state": before,
        "navigation_readback": navigation,
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "effectful_resume_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_reconcile_target_not_interactive_history(args: argparse.Namespace) -> int:
    """Reconcile a helper rejection when the target disappeared after a later UI state change."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
    )
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    authority = recording_authority(config, descriptor, args.authority)
    if not authority:
        raise Blocker("browser_use_authority_required")
    validate_recording_process(config, descriptor)
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])

    target_hash = str(args.target_text_sha256)
    failures = [
        item
        for item in descriptor.get("failed_operations", [])
        if isinstance(item, dict)
        and item.get("operation") == "target-click"
        and item.get("operation_id") == args.operation_id
        and item.get("exact_blocker") == "browser_use_target_click_failed"
        and item.get("external_action_possible") is True
        and item.get("target_text_length") == args.target_text_length
        and item.get("target_text_sha256") == target_hash
    ]
    if len(failures) != 1:
        raise Blocker("browser_use_target_reconciliation_evidence_mismatch")
    pending = pending_operation_reconciliation_ids(descriptor)
    reconciled = {
        operation_id
        for item in descriptor.get("reconciliations", [])
        if isinstance(item, dict) and item.get("resolution") in {"none", "executed"}
        for operation_id in item.get("operation_ids", [])
        if isinstance(operation_id, str)
    }
    if args.operation_id not in pending:
        if args.operation_id in reconciled:
            remaining = pending_operation_reconciliation_ids(descriptor)
            print(json.dumps({
                "status": "recording_reconciliation_already_completed",
                "descriptor": os.path.realpath(args.descriptor),
                "run_id": run_id,
                "session": descriptor["session"],
                "operation_id": args.operation_id,
                "resolution": "none",
                "pending_reconciliation": remaining,
                "fresh_run_admission_allowed": not remaining,
                "effectful_resume_allowed": not remaining,
                "finalized": False,
            }, sort_keys=True))
            return 0
        raise Blocker("browser_use_target_reconciliation_operation_not_pending")

    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    _target_click_reconciliation_candidate(rows, args.operation_id)
    navigation = _verified_navigation_with_checkpoint(
        config,
        descriptor,
        recording,
        os.path.realpath(args.descriptor),
        expected_origins=list(descriptor["target_origins"]),
    )
    code, readback_exit, stdout = run_cli_keep_alive_capture(
        config,
        config["roots"]["browser_use_home"],
        descriptor["port"],
        descriptor["session"],
        ["state"],
        recording=recording,
    )
    if code != 0 or readback_exit != 0:
        raise Blocker("browser_use_target_reconciliation_state_readback_failed")
    parsed = _parse_cli_json(stdout)
    raw_state = _state_text_from_cli(parsed)
    state_marker = str(args.state_marker)
    if not state_marker or state_marker not in raw_state:
        raise Blocker("browser_use_target_reconciliation_state_marker_missing")

    append_operation_reconciliation_durable(
        descriptor,
        operation_id=args.operation_id,
        external_effects="none",
        outcome="target_rejected_noninteractive_before_dispatch",
    )
    descriptor.setdefault("reconciliations", []).append({
        "operation_ids": [args.operation_id],
        "resolution": "none",
        "basis": args.evidence_code,
        "target_text_length": args.target_text_length,
        "target_text_sha256": target_hash,
        "candidate_status": "not_present_after_later_same_run_state_change",
        "navigation_origin": navigation.get("origin") if isinstance(navigation, dict) else str(navigation),
        "state_marker_sha256": hashlib.sha256(state_marker.encode("utf-8")).hexdigest(),
        "state_marker_length": len(state_marker),
        "state_sha256": hashlib.sha256(raw_state.encode("utf-8")).hexdigest(),
        "state_length": len(raw_state),
        "recorded_at": iso(now_utc()),
    })
    mark_navigation_readback_verified(descriptor, args.operation_id)
    remaining = update_reconciliation_summary(descriptor, completed_blocker="browser_use_target_reconciliation_completed")
    descriptor["last_navigation_readback"] = navigation
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_target_reconciliation_completed",
        next_action="fresh target inspect before the next effectful operation",
        operation_id=args.operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    remaining = pending_operation_reconciliation_ids(descriptor)
    print(json.dumps({
        "status": "recording_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_id": args.operation_id,
        "resolution": "none",
        "evidence": "target_click_helper_rejected_before_dispatch_after_same_run_state_change",
        "candidate_status": "not_present_after_later_same_run_state_change",
        "navigation_readback": navigation,
        "state_marker_length": len(state_marker),
        "state_marker_sha256": hashlib.sha256(state_marker.encode("utf-8")).hexdigest(),
        "state_length": len(raw_state),
        "state_sha256": hashlib.sha256(raw_state.encode("utf-8")).hexdigest(),
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "effectful_resume_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_reconcile_no_dispatch(args: argparse.Namespace) -> int:
    """Resolve a click or upload only from a persisted no-dispatch receipt.

    This command intentionally performs no browser dispatch or fresh page
    interpretation.  A generic ``dispatch_failed`` is not enough; the
    receipt must have been produced by the opt-in pre/post proof path with an
    allowlisted pre-dispatch failure marker and unchanged secret-free
    observations.
    """
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=False,
        allow_pinned_helper_reexec=False,
    )
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    recording_authority(config, descriptor, args.authority, command_class="record-reconcile")
    validate_recording_process(config, descriptor)
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    read_recording_status(descriptor["status_path"], require_active=True)

    pending = pending_operation_reconciliation_ids(descriptor)
    reconciled = {
        operation_id
        for item in descriptor.get("reconciliations", [])
        if isinstance(item, dict) and item.get("resolution") in {"none", "executed"}
        for operation_id in item.get("operation_ids", [])
        if isinstance(operation_id, str)
    }
    terminal_path = _no_dispatch_terminal_receipt_path(descriptor, args.operation_id)
    if args.operation_id not in pending:
        if args.operation_id in reconciled and os.path.lexists(terminal_path):
            terminal = read_json_safe(terminal_path)
            _validate_no_dispatch_receipt(descriptor, args.operation_id, terminal, terminal=True)
            print(json.dumps({
                "status": "recording_reconciliation_already_completed",
                "descriptor": os.path.realpath(args.descriptor),
                "run_id": run_id,
                "session": descriptor["session"],
                "operation_id": args.operation_id,
                "resolution": "confirmed_not_executed",
                "pending_reconciliation": pending,
                "fresh_run_admission_allowed": not pending,
                "finalized": False,
            }, sort_keys=True))
            return 0
        raise Blocker("browser_use_no_dispatch_reconciliation_operation_not_pending")

    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    _no_dispatch_reconciliation_candidate(rows, args.operation_id)
    proof = _read_no_dispatch_receipt(descriptor, args.operation_id)
    _validate_no_dispatch_receipt(descriptor, args.operation_id, proof)
    if proof.get("failure_marker") != args.evidence_code:
        raise Blocker("browser_use_no_dispatch_receipt_evidence_mismatch")

    terminal = dict(proof)
    terminal.update({
        "status": "confirmed_not_executed",
        "terminal_state": "confirmed_not_executed",
        "terminal_recorded_at": iso(now_utc()),
        "proof_receipt_sha256": sha256_file(_no_dispatch_receipt_path(descriptor, args.operation_id)),
    })
    terminal_path = _no_dispatch_terminal_receipt_path(descriptor, args.operation_id)
    try:
        json_atomic_no_replace(terminal_path, terminal)
    except Blocker as exc:
        if exc.code != "browser_use_receipt_already_exists":
            raise
        existing = read_json_safe(terminal_path)
        _validate_no_dispatch_receipt(descriptor, args.operation_id, existing, terminal=True)
        terminal = existing

    command_name = str(proof.get("command_name"))
    append_operation_reconciliation_durable(
        descriptor,
        operation_id=args.operation_id,
        external_effects="none",
        outcome=f"{command_name}_confirmed_not_executed",
    )
    if args.operation_id not in reconciled:
        descriptor.setdefault("reconciliations", []).append({
            "operation_ids": [args.operation_id],
            "resolution": "none",
            "terminal_state": "confirmed_not_executed",
            "basis": args.evidence_code,
            "command_name": command_name,
            "receipt": os.path.realpath(terminal_path),
            "recorded_at": iso(now_utc()),
        })
    remaining = update_reconciliation_summary(descriptor, completed_blocker="browser_use_no_dispatch_confirmed_not_executed")
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_no_dispatch_confirmed_not_executed",
        next_action="fresh target inspection before any new effectful operation",
        operation_id=args.operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    print(json.dumps({
        "status": "recording_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_id": args.operation_id,
        "resolution": "confirmed_not_executed",
        "external_effects": "none",
        "evidence": args.evidence_code,
        "receipt": os.path.realpath(terminal_path),
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "effectful_resume_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_reconcile_click_no_dispatch(args: argparse.Namespace) -> int:
    """Backward-compatible alias for the generic no-dispatch reconciliation."""
    return record_reconcile_no_dispatch(args)


def record_reconcile_click_readback(args: argparse.Namespace) -> int:
    """Resolve one click only after exact same-run URL and page-state proof."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
    )
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    authority = recording_authority(config, descriptor, args.authority)
    if not authority:
        raise Blocker("browser_use_authority_required")
    validate_recording_process(config, descriptor)
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])
    pending = pending_operation_reconciliation_ids(descriptor)
    if args.operation_id not in pending:
        raise Blocker("browser_use_click_reconciliation_operation_not_pending")
    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    _coordinate_click_reconciliation_candidate(rows, args.operation_id)

    def readback(command: list[str], *, state: bool) -> tuple[str, dict[str, Any]]:
        readback_id = uuid.uuid4().hex
        append_operation_intent_durable(
            descriptor,
            operation_id=readback_id,
            command=command,
            external_effects="none",
            outcome="click_reconciliation_readback_intent",
        )
        try:
            code, readback_exit, stdout = run_cli_keep_alive_capture(
                config,
                config["roots"]["browser_use_home"],
                descriptor["port"],
                descriptor["session"],
                command,
                recording=recording,
            )
            if code != 0 or readback_exit != 0:
                append_operation_outcome_durable(
                    descriptor,
                    operation_id=readback_id,
                    command=command,
                    external_effects="none",
                    outcome="click_reconciliation_readback_failed",
                )
                raise Blocker("browser_use_click_reconciliation_readback_failed", command[0])
            parsed = _parse_cli_json(stdout)
            if state:
                raw_state = _state_text_from_cli(parsed)
                if "デザインワークスペースへようこそ" not in raw_state:
                    append_operation_outcome_durable(
                        descriptor,
                        operation_id=readback_id,
                        command=command,
                        external_effects="none",
                        outcome="click_reconciliation_business_state_missing",
                    )
                    raise Blocker("browser_use_click_reconciliation_business_state_missing")
                summary = _target_state_summary(parsed, raw_state)
            else:
                value = str(_first_field(parsed, {"url", "href"}) or "")
                parsed_url = urllib.parse.urlparse(value)
                if (
                    parsed_url.scheme != "https"
                    or (parsed_url.hostname or "").lower().rstrip(".") != "jp.linkaigc.com"
                    or (parsed_url.path or "/") != "/designProduction"
                    or parsed_url.query
                    or parsed_url.fragment
                ):
                    append_operation_outcome_durable(
                        descriptor,
                        operation_id=readback_id,
                        command=command,
                        external_effects="none",
                        outcome="click_reconciliation_url_mismatch",
                    )
                    raise Blocker("browser_use_click_reconciliation_url_mismatch")
                summary = {
                    "origin": "https://jp.linkaigc.com",
                    "path_sha256": hashlib.sha256("/designProduction".encode("utf-8")).hexdigest(),
                    "path_length": len("/designProduction"),
                    "path_representation": "sha256_only",
                }
            append_operation_outcome_durable(
                descriptor,
                operation_id=readback_id,
                command=command,
                external_effects="none",
                outcome="click_reconciliation_readback_verified",
            )
            return readback_id, summary
        except Blocker:
            raise
        except Exception as exc:
            try:
                append_operation_outcome_durable(
                    descriptor,
                    operation_id=readback_id,
                    command=command,
                    external_effects="none",
                    outcome="click_reconciliation_readback_failed",
                )
            except Blocker:
                pass
            raise Blocker("browser_use_click_reconciliation_readback_failed", type(exc).__name__) from exc

    url_id, navigation = readback(["get", "url"], state=False)
    state_id, state_summary = readback(["state"], state=True)
    append_operation_reconciliation_durable(
        descriptor,
        operation_id=args.operation_id,
        external_effects="executed",
        outcome="click_navigation_readback_verified",
    )
    descriptor.setdefault("reconciliations", []).append({
        "operation_ids": [args.operation_id],
        "resolution": "executed",
        "basis": "browser_use_click_navigation_readback_verified",
        "readback_operation_ids": [url_id, state_id],
        "navigation": navigation,
        "state": state_summary,
        "recorded_at": iso(now_utc()),
    })
    mark_navigation_readback_verified(descriptor, args.operation_id)
    descriptor["last_navigation_readback"] = {"schema": "browser-use-navigation-readback.v1", **navigation, "ready_state_verified": False}
    remaining = update_reconciliation_summary(descriptor, completed_blocker="browser_use_click_reconciliation_completed")
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_click_reconciliation_completed",
        next_action="fresh read-only state and feature inspection in design workspace",
        operation_id=args.operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    remaining = pending_operation_reconciliation_ids(descriptor)
    print(json.dumps({
        "status": "recording_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_id": args.operation_id,
        "resolution": "executed",
        "evidence": "browser_use_click_navigation_readback_verified",
        "navigation": navigation,
        "state": state_summary,
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "effectful_resume_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_reconcile_click_readback_live(args: argparse.Namespace) -> int:
    """Reconcile a coordinate click after fresh same-run route and state proof."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
    )
    require_recording_continuable(descriptor)
    require_temporary_task_id(args, descriptor)
    authority = recording_authority(config, descriptor, args.authority)
    if not authority:
        raise Blocker("browser_use_authority_required")
    validate_recording_process(config, descriptor)
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])

    pending = pending_operation_reconciliation_ids(descriptor)
    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    if args.operation_id not in pending:
        reconciled = {
            operation_id
            for item in descriptor.get("reconciliations", [])
            if isinstance(item, dict) and item.get("resolution") in {"none", "executed"}
            for operation_id in item.get("operation_ids", [])
            if isinstance(operation_id, str)
        }
        if args.operation_id in reconciled:
            remaining = pending_operation_reconciliation_ids(descriptor)
            print(json.dumps({
                "status": "recording_reconciliation_already_completed",
                "descriptor": os.path.realpath(args.descriptor),
                "run_id": run_id,
                "session": descriptor["session"],
                "operation_id": args.operation_id,
                "resolution": "executed",
                "pending_reconciliation": remaining,
                "fresh_run_admission_allowed": not remaining,
                "effectful_resume_allowed": not remaining,
                "finalized": False,
            }, sort_keys=True))
            return 0
        raise Blocker("browser_use_click_reconciliation_operation_not_pending")
    _coordinate_click_reconciliation_candidate(rows, args.operation_id)

    expected_path = str(args.expected_path)
    parsed_expected = urllib.parse.urlparse(expected_path)
    if (
        not expected_path.startswith("/")
        or parsed_expected.path != expected_path
        or parsed_expected.query
        or parsed_expected.fragment
    ):
        raise Blocker("browser_use_click_reconciliation_expected_path_invalid")
    state_marker = str(args.state_marker)
    if not state_marker:
        raise Blocker("browser_use_click_reconciliation_state_marker_empty")

    navigation = _verified_navigation_with_checkpoint(
        config,
        descriptor,
        recording,
        os.path.realpath(args.descriptor),
        expected_origins=list(descriptor["target_origins"]),
    )
    if not isinstance(navigation, dict):
        raise Blocker("browser_use_click_reconciliation_navigation_evidence_missing")
    if (
        navigation.get("path_length") != len(expected_path)
        or navigation.get("path_sha256") != hashlib.sha256(expected_path.encode("utf-8")).hexdigest()
    ):
        raise Blocker("browser_use_click_reconciliation_expected_path_mismatch")

    code, readback_exit, stdout = run_cli_keep_alive_capture(
        config,
        config["roots"]["browser_use_home"],
        descriptor["port"],
        descriptor["session"],
        ["state"],
        recording=recording,
    )
    if code != 0 or readback_exit != 0:
        raise Blocker("browser_use_click_reconciliation_state_readback_failed")
    parsed = _parse_cli_json(stdout)
    raw_state = _state_text_from_cli(parsed)
    if state_marker not in raw_state:
        raise Blocker("browser_use_click_reconciliation_state_marker_missing")

    append_operation_reconciliation_durable(
        descriptor,
        operation_id=args.operation_id,
        external_effects="executed",
        outcome="click_navigation_readback_verified",
    )
    descriptor.setdefault("reconciliations", []).append({
        "operation_ids": [args.operation_id],
        "resolution": "executed",
        "basis": "browser_use_coordinate_click_navigation_readback_verified",
        "navigation": {
            "origin": navigation.get("origin"),
            "path_sha256": navigation.get("path_sha256"),
            "path_length": navigation.get("path_length"),
        },
        "state_marker_sha256": hashlib.sha256(state_marker.encode("utf-8")).hexdigest(),
        "state_marker_length": len(state_marker),
        "state_sha256": hashlib.sha256(raw_state.encode("utf-8")).hexdigest(),
        "state_length": len(raw_state),
        "recorded_at": iso(now_utc()),
    })
    mark_navigation_readback_verified(descriptor, args.operation_id)
    remaining = update_reconciliation_summary(descriptor, completed_blocker="browser_use_coordinate_click_reconciliation_completed")
    descriptor["last_navigation_readback"] = navigation
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_coordinate_click_reconciliation_completed",
        next_action="fresh same-task target inspection before any effectful UI operation",
        operation_id=args.operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    remaining = pending_operation_reconciliation_ids(descriptor)
    print(json.dumps({
        "status": "recording_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_id": args.operation_id,
        "resolution": "executed",
        "evidence": "browser_use_coordinate_click_navigation_readback_verified",
        "navigation_readback": navigation,
        "state_marker_length": len(state_marker),
        "state_marker_sha256": hashlib.sha256(state_marker.encode("utf-8")).hexdigest(),
        "state_length": len(raw_state),
        "state_sha256": hashlib.sha256(raw_state.encode("utf-8")).hexdigest(),
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "effectful_resume_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def record_reconcile_target_not_interactive(args: argparse.Namespace) -> int:
    """Resolve only a helper-proven non-interactive target rejection."""
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
        allow_stale_runtime_recovery=True,
    )
    require_temporary_task_id(args, descriptor)
    recording_authority(config, descriptor, args.authority, cleanup_only=True)
    if descriptor.get("status") != "stale" or descriptor.get("recovery_state") != "restartable":
        raise Blocker("browser_use_recording_reconciliation_requires_restartable_stale")
    failures = [
        item
        for item in descriptor.get("failed_operations", [])
        if isinstance(item, dict)
        and item.get("exact_blocker") == "browser_use_target_click_failed"
        and item.get("external_action_possible") is True
        and item.get("target_text_length") == args.target_text_length
        and item.get("target_text_sha256") == args.target_text_sha256
    ]
    if len(failures) != 1:
        raise Blocker("browser_use_target_reconciliation_evidence_mismatch")
    pending = pending_operation_reconciliation_ids(descriptor)
    descriptor_reconciled = {
        operation_id
        for item in descriptor.get("reconciliations", [])
        if isinstance(item, dict) and item.get("resolution") in {"none", "executed"}
        for operation_id in item.get("operation_ids", [])
        if isinstance(operation_id, str)
    }
    if args.operation_id not in pending and args.operation_id not in descriptor_reconciled:
        raise Blocker("browser_use_target_reconciliation_operation_not_pending")
    operation_ids = [] if args.operation_id in descriptor_reconciled else [args.operation_id]
    if "failed-operation" in pending and "failed-operation" not in operation_ids:
        operation_ids.append("failed-operation")
    for operation_id in operation_ids:
        if re.fullmatch(r"[a-f0-9]{32}", operation_id):
            append_operation_reconciliation_durable(
                descriptor,
                operation_id=operation_id,
                external_effects="none",
                outcome="target_rejected_noninteractive_before_dispatch",
            )
    rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    intents = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "intent"}
    outcomes = {str(row.get("operation_id")): row for row in rows if row.get("phase") == "outcome"}
    for operation_id, intent in intents.items():
        outcome = outcomes.get(operation_id)
        if (
            operation_id in pending
            and operation_id not in operation_ids
            and intent.get("external_effects") == "none"
            and outcome is not None
            and outcome.get("external_effects") == "unknown"
            and outcome.get("outcome") == "orphan_intent_closed_by_recover"
        ):
            append_operation_reconciliation_durable(
                descriptor,
                operation_id=operation_id,
                external_effects="none",
                outcome="read_only_recovery_orphan_reconciled",
            )
            operation_ids.append(operation_id)
    descriptor.setdefault("reconciliations", []).append(
        {
            "operation_ids": operation_ids,
            "resolution": "none",
            "basis": args.evidence_code,
            "target_text_length": args.target_text_length,
            "target_text_sha256": args.target_text_sha256,
            "recorded_at": iso(now_utc()),
        }
    )
    remaining = update_reconciliation_summary(descriptor, completed_blocker="browser_use_target_reconciliation_completed")
    checkpoint = write_recovery_checkpoint(
        descriptor,
        exact_blocker="browser_use_target_reconciliation_completed",
        next_action="fresh same-task record-start after noninteractive target rejection reconciliation",
        operation_id=args.operation_id,
    )
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    remaining = pending_operation_reconciliation_ids(descriptor)
    print(json.dumps({
        "status": "recording_reconciliation_completed",
        "descriptor": os.path.realpath(args.descriptor),
        "run_id": run_id,
        "session": descriptor["session"],
        "operation_ids": operation_ids,
        "resolution": "none",
        "evidence": args.evidence_code,
        "pending_reconciliation": remaining,
        "fresh_run_admission_allowed": not remaining,
        "checkpoint": checkpoint,
        "finalized": False,
    }, sort_keys=True))
    return 0


def recording_video_render_command(ffmpeg: str, framerate: int | float, pattern: str, video_path: str) -> list[str]:
    """Build the deterministic ffmpeg command used for frame-to-video render."""
    return [
        ffmpeg,
        "-v",
        "error",
        "-y",
        "-framerate",
        str(framerate),
        "-pattern_type",
        "glob",
        "-i",
        pattern,
        # libx264 requires even dimensions. Pad only the right/bottom edge
        # so odd-sized headed surfaces retain every captured pixel.
        "-vf",
        "pad=ceil(iw/2)*2:ceil(ih/2)*2",
        "-c:v",
        "libx264",
        "-pix_fmt",
        "yuv420p",
        "-movflags",
        "+faststart",
        video_path,
    ]


def record_finalize(args: argparse.Namespace) -> int:
    config = read_toml()
    versions = validate_installation(config)
    recording_tools = validate_recording_tools(config)
    versions = {**versions, "recording_tools": {kind: {"canonical_path": path} for kind, path in recording_tools.items()}}
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    cleanup_only = bool(getattr(args, "cleanup_only", False))
    preserve_temporary = bool(getattr(args, "preserve_temporary", False))
    descriptor = read_recording_descriptor(
        config,
        args.descriptor,
        run_id,
        session,
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=not cleanup_only,
        allow_expired_temporary=cleanup_only,
        allow_stale_runtime_recovery=cleanup_only,
    )
    descriptor = ensure_current_helper_generation(config, descriptor, os.path.realpath(args.descriptor), allow_historical=cleanup_only)
    borrowed_handoff_cleanup = (
        cleanup_only
        and descriptor.get("status") in {"continued", "cleanup_pending"}
        and descriptor.get("owned_chrome") is False
        and isinstance(descriptor.get("source_handoff_descriptor"), str)
        and os.path.lexists(os.path.realpath(str(descriptor["source_handoff_descriptor"])))
    )
    if borrowed_handoff_cleanup:
        # Rebind before the temporary terminal gate and authority readback so
        # every later cleanup operation is evaluated against the exact source
        # handoff, not stale recording fields.
        _rebind_borrowed_handoff_recording_descriptor(config, descriptor)
    require_temporary_task_id(args, descriptor)
    source_cleanup_marker_reconciliation = (
        cleanup_only
        and _source_handoff_cleanup_marker_reconciliation_eligible(config, descriptor)
    )
    if source_cleanup_marker_reconciliation and descriptor.get("status") == "continued":
        # The marker is the terminal source-of-truth for a consumed handoff;
        # keep the existing temporary cleanup gate strict by classifying only
        # this proven dead source-handoff recording as cleanup-pending.
        descriptor["status"] = "cleanup_pending"
    if cleanup_only and promote_verified_terminal_cleanup(config, descriptor):
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    require_temporary_delete_approval(
        descriptor,
        delete_approved=delete_approval_signal(args),
        cleanup_only=cleanup_only,
        preserve_temporary=preserve_temporary,
    )
    if descriptor.get("lifecycle") == TEMPORARY_LIFECYCLE and preserve_temporary:
        descriptor["retention_decision"] = "retain_temporary_profile"
        descriptor["task_completion_signal"] = "temporary_profile_preserve_requested"
        descriptor["profile_preservation_requested_at"] = iso(now_utc())
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    if descriptor.get("lifecycle") == TEMPORARY_LIFECYCLE and delete_approval_signal(args):
        descriptor["completion_assessment"] = "ai_judged_complete"
        descriptor["retention_decision"] = "delete_approved"
        descriptor["task_completion_signal"] = "delete_approval_received"
        descriptor["delete_approval_at"] = iso(now_utc())
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    if descriptor.get("status") == "stale" and not cleanup_only:
        raise Blocker("browser_use_recording_stale_descriptor_requires_cleanup_only")
    recording_authority(
        config,
        descriptor,
        args.authority,
        cleanup_only=cleanup_only,
        command_class="record-finalize" if not cleanup_only else None,
        renewal_path=getattr(args, "authority_renewal", None) if not cleanup_only else None,
    )
    if getattr(args, "authority_renewal", None) and not cleanup_only:
        _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    if borrowed_handoff_cleanup:
        cleanup = cleanup_borrowed_handoff_recording_descriptor(
            config,
            versions,
            descriptor,
            os.path.realpath(args.descriptor),
        )
        print(json.dumps({
            "status": "cleanup_completed",
            "descriptor": os.path.realpath(args.descriptor),
            "cleanup_receipt": cleanup["cleanup_receipt"],
            "cleanup": cleanup.get("cleanup", {}),
            "pending_reconciliation": cleanup.get("pending_reconciliation", []),
            "external_effects": cleanup.get("external_effects"),
            "exact_blocker": cleanup.get("exact_blocker"),
            "phases": descriptor.get("phases", {}),
            "finalized": False,
            "cleanup_reconciled": True,
        }, sort_keys=True))
        return 1 if cleanup.get("external_effects") == "unknown" else 0
    if (
        cleanup_only
        and descriptor.get("status") in {"continued", "cleanup_pending"}
        and descriptor.get("source_handoff_descriptor")
        and not os.path.lexists(os.path.realpath(str(descriptor["source_handoff_descriptor"])))
        and source_cleanup_marker_reconciliation
    ):
        cleanup = reconcile_cleanup_complete_source_recording(
            config,
            versions,
            descriptor,
            os.path.realpath(args.descriptor),
        )
        print(json.dumps({
            "status": "cleanup_completed",
            "descriptor": os.path.realpath(args.descriptor),
            "cleanup_receipt": cleanup["cleanup_receipt"],
            "cleanup": cleanup.get("cleanup", {}),
            "pending_reconciliation": cleanup.get("pending_reconciliation", []),
            "external_effects": cleanup.get("external_effects"),
            "exact_blocker": cleanup.get("exact_blocker"),
            "phases": descriptor.get("phases", {}),
            "finalized": False,
            "cleanup_reconciled": True,
        }, sort_keys=True))
        return 1 if cleanup.get("external_effects") == "unknown" else 0
    if cleanup_only and descriptor.get("status") == "stale":
        cleanup = cleanup_stale_recording_descriptor(
            config,
            versions,
            descriptor,
            os.path.realpath(args.descriptor),
            delete_approved=delete_approval_signal(args),
        )
        if cleanup.get("external_effects") == "unknown":
            print(json.dumps({
                "status": "blocked",
                "descriptor": os.path.realpath(args.descriptor),
                "cleanup_receipt": cleanup["cleanup_receipt"],
                "cleanup": cleanup.get("cleanup", {}),
                "pending_reconciliation": cleanup.get("pending_reconciliation", []),
                "external_effects": cleanup.get("external_effects"),
                "exact_blocker": "browser_use_external_effects_unknown",
                "phases": descriptor.get("phases", {}),
                "finalized": False,
                "cleanup_reconciled": True,
            }, sort_keys=True))
            return 1
        print(json.dumps({
            "status": "cleanup_completed",
            "descriptor": os.path.realpath(args.descriptor),
            "cleanup_receipt": cleanup["cleanup_receipt"],
            "cleanup": cleanup.get("cleanup", {}),
            "pending_reconciliation": cleanup.get("pending_reconciliation", []),
            "external_effects": cleanup.get("external_effects"),
            "phases": descriptor.get("phases", {}),
            "finalized": False,
            "cleanup_reconciled": True,
        }, sort_keys=True))
        return 0
    status = read_json_safe(descriptor["status_path"])
    # A close can finish asynchronously.  Once the recorder has truthfully
    # reported finalized, allow a retry to finish probing/cleanup even if the
    # Browser Use session has already disappeared.
    reconcile_cleanup = (
        cleanup_only
        and descriptor.get("status") == "cleanup_pending"
        and bool(descriptor.get("finalize_failure"))
        and (descriptor.get("cleanup_state") or {}).get("status") == "cleaned"
    )
    if status.get("finalized") is not True and not reconcile_cleanup:
        validate_recording_process(config, descriptor, allow_cleanup_complete=cleanup_only)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])
    if descriptor.get("status") == "cleanup_pending" and descriptor.get("finalize_failure"):
        cleanup_state = descriptor.get("cleanup_state") or {}
        if cleanup_only and cleanup_state.get("status") == "cleaned":
            if cleanup_state.get("process_terminated") is not True or cleanup_state.get("listener_absent") is not True:
                raise Blocker("browser_use_recording_cleanup_readback_incomplete")
            assert_debug_listener_absent(int(descriptor["port"]))
            if any(os.path.lexists(path) for path in descriptor.get("lock_paths", [])):
                raise Blocker("browser_use_recording_cleanup_locks_remain")
            if browser_harness_cli_enabled():
                write_harness_recording_status(descriptor["status_path"], recording, active=False, finalized=False)
            receipt_path = os.path.join(
                config["roots"]["receipts"],
                descriptor["run_id"],
                f"{descriptor['session']}-{descriptor['nonce']}.json",
            )
            if not os.path.lexists(receipt_path):
                raise Blocker("browser_use_recording_blocked_receipt_missing")
            print(json.dumps({"status": "blocked", "descriptor": os.path.realpath(args.descriptor), "receipt": receipt_path, "exact_blocker": str(descriptor["finalize_failure"]), "phases": descriptor.get("phases", {}), "finalized": False, "cleanup_reconciled": True}, sort_keys=True))
            return 1
        raise Blocker("browser_use_recording_finalize_already_blocked", str(descriptor["finalize_failure"]))
    final_visual_readback: dict[str, Any] | None = None
    final_visual_blocker: str | None = None
    if status.get("finalized") is not True and browser_harness_cli_enabled():
        code, readback_exit, captured_stop = run_cli_keep_alive_capture(
            config,
            config["roots"]["browser_use_home"],
            descriptor["port"],
            descriptor["session"],
            ["record-stop", descriptor.get("recording_source_dir", descriptor["recording_dir"])],
            recording=recording,
        )
        if code != 0:
            stop_failure = "browser_use_recording_stop_failed"
            receipt_path, final_failure = _recording_finalize_cleanup_after_stop_failure(
                config,
                versions,
                descriptor,
                os.path.realpath(args.descriptor),
                stop_failure,
                preserve_temporary=preserve_temporary,
            )
            print(json.dumps({"status": "blocked", "descriptor": os.path.realpath(args.descriptor), "receipt": receipt_path, "exact_blocker": final_failure, "recording_stop_blocker": _LAST_RECORDING_CLI_FAILURE or str(code), "cleanup": descriptor.get("cleanup_state", {}), "cleanup_completed": descriptor.get("cleanup_completed") is True, "external_effects": operation_effect_summary(descriptor), "phases": descriptor.get("phases", {}), "finalized": False}, sort_keys=True))
            return 1
        if readback_exit not in (None, 0):
            final_visual_blocker = "browser_use_recording_final_visual_readback_failed"
        else:
            try:
                final_visual_readback = final_visual_readback_from_stop_capture(recording, captured_stop)
            except Exception as exc:
                final_visual_blocker = exc.code if isinstance(exc, Blocker) else "browser_use_recording_final_visual_readback_failed"
        write_harness_recording_status(
            descriptor["status_path"],
            recording,
            active=False,
            finalized=True,
            media_finalized=False,
            state="stopped_pending_media_finalize",
            reason="recorder stopped; MP4 probe is still required",
        )
        code, _ = run_cli_keep_alive(config, config["roots"]["browser_use_home"], descriptor["port"], descriptor["session"], ["close"], False, recording=recording)
    elif status.get("finalized") is not True:
        try:
            code, _ = run_cli_keep_alive(config, config["roots"]["browser_use_home"], descriptor["port"], descriptor["session"], ["close"], False, recording=recording)
            if code != 0:
                raise Blocker("browser_use_recording_close_failed", _LAST_RECORDING_CLI_FAILURE or str(code))
            wait_for_recording_stop(descriptor["status_path"])
        except Blocker as exc:
            if _recording_cleanup_only_preserve_recovery_eligible(
                descriptor,
                status,
                cleanup_only=cleanup_only,
                preserve_temporary=preserve_temporary,
            ):
                receipt_path, final_failure = _recording_finalize_cleanup_after_stop_failure(
                    config,
                    versions,
                    descriptor,
                    os.path.realpath(args.descriptor),
                    exc.code,
                    preserve_temporary=True,
                )
                print(json.dumps({
                    "status": "blocked",
                    "descriptor": os.path.realpath(args.descriptor),
                    "receipt": receipt_path,
                    "exact_blocker": final_failure,
                    "cleanup": descriptor.get("cleanup_state", {}),
                    "cleanup_completed": descriptor.get("cleanup_completed") is True,
                    "external_effects": operation_effect_summary(descriptor),
                    "phases": descriptor.get("phases", {}),
                    "finalized": False,
                }, sort_keys=True))
                return 1
            raise
    try:
        if browser_harness_cli_enabled():
            source_dir = pathlib.Path(descriptor.get("recording_source_dir", descriptor["recording_dir"]))
            frames = sorted(p for p in source_dir.glob("*.jpg") if p.stem.isdigit())
            if not frames:
                raise Blocker("browser_use_recording_frames_missing")
            video_path = source_dir / "browser-recording.mp4"
            ffmpeg = config["executables"]["ffmpeg"]["canonical_path"]
            # Only numbered recorder frames are video inputs.  Derived artifacts
            # such as representative-frame.jpg and video-final-frame.jpg must not
            # be fed back into a later render retry.
            pattern = str(source_dir / "[0-9]*.jpg")
            render = subprocess.run(
                recording_video_render_command(ffmpeg, descriptor["recording_framerate"], pattern, str(video_path)),
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=120,
            )
            if render.returncode != 0:
                raise Blocker("browser_use_recording_video_render_failed")
            if video_path.is_symlink() or not video_path.is_file():
                raise Blocker("browser_use_recording_video_path_invalid")
            if video_path.stat().st_size <= 0:
                raise Blocker("browser_use_recording_video_empty")
            video = probe_recording_video(config, str(source_dir))
        else:
            video = probe_recording_video(config, descriptor["recording_dir"])
        if browser_harness_cli_enabled():
            write_harness_recording_status(
                descriptor["status_path"],
                recording,
                active=False,
                finalized=True,
                media_finalized=True,
                state="media_finalized",
                reason="MP4 probe passed with positive duration and frames",
            )
    except (Blocker, OSError, subprocess.SubprocessError, ValueError, json.JSONDecodeError) as exc:
        media_failure = exc.code if isinstance(exc, Blocker) else "browser_use_recording_video_finalize_failed"
        receipt_path, final_failure = _recording_finalize_cleanup_after_media_failure(
            config,
            versions,
            descriptor,
            os.path.realpath(args.descriptor),
            media_failure,
            failure_phase="video_finalize",
            preserve_temporary=preserve_temporary,
        )
        print(json.dumps({
            "status": "blocked",
            "descriptor": os.path.realpath(args.descriptor),
            "receipt": receipt_path,
            "exact_blocker": final_failure,
            "video_finalize_blocker": media_failure,
            "finalized": False,
        }, sort_keys=True))
        return 1
    if final_visual_readback is not None and final_visual_blocker is None:
        try:
            final_visual_readback = bind_final_visual_readback_to_video(final_visual_readback, video)
        except Exception as exc:
            final_visual_blocker = exc.code if isinstance(exc, Blocker) else "browser_use_recording_final_video_binding_failed"
    cleanup_blocker: str | None = None
    if descriptor["owned_chrome"]:
        cleaned, cleanup_blocker = _cleanup_recording_owned_session(
            config,
            descriptor,
            preserve_temporary=preserve_temporary,
        )
        if not cleaned:
            raise Blocker(cleanup_blocker or "browser_use_recording_cleanup_uncertain")
        if preserve_temporary and descriptor.get("lifecycle") == TEMPORARY_LIFECYCLE:
            mark_temporary_profile_shareable(config, descriptor)
    else:
        validate_recording_process(config, descriptor)
    phases = dict(descriptor.get("phases") or {})
    phases["terminal_cleanup"] = lifecycle_phase(observed=True, requested=True, executed=True, completed=True)
    descriptor["phases"] = phases
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    effect_state = operation_effect_summary(descriptor)
    completion_blocker = (
        "browser_use_external_effects_unknown"
        if effect_state == "unknown"
        else final_visual_blocker
    )
    ledger_rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    ledger_tail_digest = ledger_rows[-1].get("chain_digest") if ledger_rows else "0" * 64
    semantic_bundle = semantic_readback_bundle(descriptor)
    manifest = {"schema": RECORDING_SCHEMA, "status": "blocked" if completion_blocker else "completed", "run_id": descriptor["run_id"], "session": descriptor["session"], "recording_dir": descriptor["recording_dir"], "operations": descriptor["operations"], "failed_operations": descriptor.get("failed_operations", []), "target_origins": descriptor["target_origins"], "recording_framerate": descriptor["recording_framerate"], "video": video, "external_effects": effect_state, "business_effect_proof": descriptor.get("business_effect_proof", "not_applicable"), "recording_finalized": True, "cleanup_completed": True, "completion_status": "blocked" if completion_blocker else "completed", "completion_blocker": completion_blocker, "final_visual_readback": final_visual_readback, "semantic_readback": semantic_bundle, "operation_ledger_path": operation_ledger_path(descriptor), "operation_ledger_tail_digest": ledger_tail_digest}
    if descriptor.get("tab_inventory_path"):
        manifest["tab_inventory_path"] = descriptor["tab_inventory_path"]
        inventory_reader = read_recording_tab_inventory_for_terminal_cleanup if cleanup_only else read_recording_tab_inventory
        manifest["tab_inventory"] = inventory_reader(descriptor["tab_inventory_path"])
    manifest_path = recording_manifest_path(descriptor["recording_dir"])
    write_recording_manifest(manifest_path, manifest)
    descriptor["status"] = "finalized"
    descriptor["external_effects"] = effect_state
    descriptor["recording_finalized"] = True
    descriptor["cleanup_required"] = bool(descriptor.get("owned_chrome"))
    descriptor["cleanup_completed"] = True
    descriptor["completion_status"] = "blocked" if completion_blocker else "completed"
    descriptor["completion_blocker"] = completion_blocker
    descriptor["cleanup_scope"] = "owned_recording" if descriptor.get("owned_chrome") else "source_handoff_preserved"
    descriptor["manifest_path"] = manifest_path
    descriptor["video"] = video
    if final_visual_readback is not None:
        descriptor["final_visual_readback"] = final_visual_readback
    descriptor["versions_hashes"] = versions
    if descriptor.get("tab_inventory_path"):
        descriptor["tab_inventory"] = manifest["tab_inventory"]
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    ctx = _recording_context(config, descriptor)
    cleanup_status = (
        "cleaned"
        if descriptor["owned_chrome"] and descriptor.get("lifecycle") == "single-use"
        else "scheduled_profile_preserved"
        if descriptor["owned_chrome"] and descriptor.get("lifecycle") == "scheduled"
        else "shared_profile_preserved"
        if descriptor["owned_chrome"] and descriptor.get("lifecycle") == TEMPORARY_LIFECYCLE and descriptor.get("shared_profile_lease_path")
        else "temporary_profile_preserved"
        if descriptor["owned_chrome"] and descriptor.get("lifecycle") == TEMPORARY_LIFECYCLE and preserve_temporary
        else "temporary_profile_removed"
        if descriptor["owned_chrome"] and descriptor.get("lifecycle") == TEMPORARY_LIFECYCLE
        else "source_handoff_preserved"
    )
    cleanup_receipt = {
        "status": cleanup_status,
        "recording_finalized": True,
        "cleanup_completed": True,
        "completion_status": "blocked" if completion_blocker else "completed",
        "completion_blocker": completion_blocker,
        "profile_removed": not os.path.lexists(descriptor["profile"]),
        "profile_preserved": (bool(descriptor.get("shared_profile_lease_path")) or preserve_temporary) and os.path.lexists(descriptor["profile"]),
        "download_dir_removed": not os.path.lexists(descriptor["download_dir"]),
        "locks_removed": list(descriptor["lock_paths"]) if descriptor["owned_chrome"] else [],
        "locks_retained": [],
    }
    ctx.update({"port": descriptor["port"], "task_id": descriptor.get("task_id"), "creation_binding": descriptor.get("creation_binding"), "authority_scope": descriptor.get("authority_scope"), "authority_sha256": descriptor.get("authority_sha256"), "profile_hash": profile_hash(descriptor["profile"], descriptor["nonce"]) if descriptor["owned_chrome"] else None, "target_origins": descriptor["target_origins"], "account_identity": descriptor["account_identity"], "authority_summary": {"data_exposure": "authorized_recording" if descriptor["mode"] == "authorized" else "public_read_only", "side_effect_scope": "bounded_recording", "approval": "approved" if descriptor["mode"] == "authorized" else "not_required"}, "preflight": True, "listener_verified": True, "process_identity_verified": True, "readback_exit": 0, "recording_manifest": manifest_path, "operation_ledger_path": operation_ledger_path(descriptor), "operation_ledger_tail_digest": ledger_tail_digest, "external_effects": effect_state, "cleanup": cleanup_receipt})
    receipt = finalized_receipt(config, versions, ctx, completion_blocker)
    descriptor["receipt_path"] = receipt
    _write_recording_descriptor(config, os.path.realpath(args.descriptor), descriptor, replace=True)
    manifest["receipt_path"] = receipt
    json_atomic_replace(manifest_path, manifest)
    if completion_blocker:
        print(json.dumps({"status": "blocked", "descriptor": os.path.realpath(args.descriptor), "manifest": manifest_path, "receipt": receipt, "video": video, "external_effects": effect_state, "exact_blocker": completion_blocker, "finalized": False}, sort_keys=True))
        return 1
    print(json.dumps({"status": "completed", "descriptor": os.path.realpath(args.descriptor), "manifest": manifest_path, "receipt": receipt, "video": video, "external_effects": effect_state, "finalized": True}, sort_keys=True))
    return 0


def validate_finalized_lease_artifacts(config: dict[str, Any], lease: dict[str, Any], descriptor_path: str, run_id: str, session: str) -> dict[str, Any]:
    """Revalidate an idempotent finalize call; a marker alone is not proof."""
    descriptor = read_recording_descriptor(config, descriptor_path, run_id, session, allow_finalized=True)
    effect_state = operation_effect_summary(descriptor)
    if effect_state == "unknown" or descriptor.get("external_effects") == "unknown":
        raise Blocker("browser_use_flow_lease_finalized_external_effects_unknown")
    manifest_path = os.path.realpath(str(descriptor.get("manifest_path") or ""))
    if not manifest_path or not os.path.lexists(manifest_path):
        raise Blocker("browser_use_flow_lease_finalized_manifest_missing")
    manifest = read_json_safe(manifest_path)
    if manifest.get("schema") != RECORDING_SCHEMA or manifest.get("status") != "completed" or manifest.get("run_id") != run_id or manifest.get("session") != session or manifest.get("external_effects") == "unknown":
        raise Blocker("browser_use_flow_lease_finalized_manifest_invalid")
    receipt_path = os.path.realpath(str(lease.get("receipt_path") or descriptor.get("receipt_path") or ""))
    if not receipt_path:
        nonce = safe_id(str(descriptor.get("nonce") or ""), "nonce")
        receipt_path = os.path.join(config["roots"]["receipts"], run_id, f"{session}-{nonce}.json")
    receipt = read_json_safe(receipt_path)
    if receipt.get("schema") != "browser-use-receipt.v1" or receipt.get("run_id") != run_id or receipt.get("session") != session or receipt.get("finalized") is not True or receipt.get("external_effects") == "unknown":
        raise Blocker("browser_use_flow_lease_finalized_receipt_invalid")
    authority_path = os.path.realpath(str(lease.get("authority_path") or ""))
    if authority_path:
        assert_regular_file(authority_path, mode=0o600)
        if descriptor.get("authority_sha256") and sha256_file(authority_path) != descriptor.get("authority_sha256"):
            raise Blocker("browser_use_flow_lease_finalized_authority_changed")
    assert_debug_listener_absent(int(descriptor["port"]))
    if any(os.path.lexists(path) for path in descriptor.get("lock_paths", [])):
        raise Blocker("browser_use_flow_lease_finalized_locks_remain")
    ledger_rows = _operation_ledger_rows(operation_ledger_path(descriptor))
    if ledger_rows and manifest.get("operation_ledger_tail_digest") != ledger_rows[-1].get("chain_digest"):
        raise Blocker("browser_use_flow_lease_finalized_ledger_tail_mismatch")
    return {"descriptor": descriptor, "manifest": manifest, "receipt": receipt, "receipt_path": receipt_path}


def flow_finalize_lease(args: argparse.Namespace) -> int:
    """Finalize one run-owned flow lease at the task/run boundary.

    A flow lease is intentionally separate from individual Browser Use
    commands: command boundaries keep the same Chrome alive, while this
    boundary closes the session exactly once after the whole task is over.
    """
    config = read_toml()
    validate_installation(config)
    lease_path = os.path.realpath(str(args.lease))
    lease = read_json_safe(lease_path)
    lease_schema = str(lease.get("schema") or "")
    if lease_schema not in {"browser-use-flow-lease.v1", "browser-use-flow-lease.v2"} or lease.get("status") not in {"held", "finalized"}:
        raise Blocker("browser_use_flow_lease_binding_invalid")
    if lease_schema == "browser-use-flow-lease.v2":
        contract = lease.get("contract")
        owner = lease.get("owner")
        session_binding = lease.get("session_binding")
        if (
            not isinstance(contract, dict)
            or contract.get("schema") != "browser_use_cli_authorized_scheduled_flow.v1"
            or not isinstance(owner, dict)
            or not isinstance(session_binding, dict)
            or str(owner.get("run_id") or "") != str(contract.get("run_id") or "")
            or str(owner.get("automation_id") or "") != str(contract.get("automation_id") or "")
            or str(session_binding.get("effective") or "") != str(contract.get("effective_session") or "")
            or str(lease.get("run_id") or "") != str(contract.get("run_id") or "")
            or str(lease.get("automation_id") or "") != str(contract.get("automation_id") or "")
            or str(lease.get("session") or "") != str(contract.get("effective_session") or "")
        ):
            raise Blocker("browser_use_flow_lease_contract_binding_invalid")
        run_id_value = str(contract.get("run_id") or "")
        session_value = str(contract.get("effective_session") or "")
        automation_value = str(contract.get("automation_id") or "")
    else:
        if (
            not str(lease.get("run_id") or "").strip()
            or not str(lease.get("session") or "").strip()
            or not str(lease.get("automation_id") or "").strip()
        ):
            raise Blocker("browser_use_flow_lease_binding_invalid")
        run_id_value = str(lease["run_id"])
        session_value = str(lease["session"])
        automation_value = str(lease["automation_id"])
    if not str(lease.get("descriptor_path") or "").strip() or not str(lease.get("profile") or "").strip():
        raise Blocker("browser_use_flow_lease_binding_invalid")
    run_id = safe_id(run_id_value, "flow_lease_run_id")
    requested_session = validate_id(session_value, "flow_lease_session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    if session != requested_session:
        raise Blocker("browser_use_flow_lease_session_alias_rejected")
    descriptor_path = os.path.realpath(str(lease["descriptor_path"]))
    assert_recording_descriptor_path(config, descriptor_path)
    profile = os.path.realpath(str(lease["profile"]))
    lifecycle = str(lease.get("lifecycle") or "")
    automation_id = safe_id(automation_value, "flow_lease_automation_id")
    if lifecycle == "scheduled":
        expected_profile = os.path.join(config["roots"]["scheduled_profiles"], automation_id)
        if profile != expected_profile:
            raise Blocker("browser_use_flow_lease_scheduled_profile_binding_invalid")
    elif lifecycle == TEMPORARY_LIFECYCLE:
        task_id = lease.get("task_id")
        creation_binding = lease.get("creation_binding")
        if not isinstance(task_id, str) or not isinstance(creation_binding, str) or profile != temporary_profile_path(config, creation_binding):
            raise Blocker("browser_use_flow_lease_temporary_profile_binding_invalid")
    elif lifecycle == "single-use":
        if not profile.startswith(os.path.realpath(config["roots"]["single_use_profiles"]) + os.sep):
            raise Blocker("browser_use_flow_lease_single_use_profile_binding_invalid")
    else:
        raise Blocker("browser_use_flow_lease_lifecycle_invalid")
    if lease.get("status") == "finalized":
        validated = validate_finalized_lease_artifacts(config, lease, descriptor_path, run_id, session)
        lease["finalized"] = True
        print(json.dumps({"status": "completed", "lease": lease_path, "receipt": validated["receipt_path"], "finalized": True, "external_effects": validated["receipt"].get("external_effects", "none"), "cleanup_status": lease.get("cleanup_status")}, sort_keys=True))
        return 0
    authority_path = os.path.realpath(str(lease.get("authority_path") or ""))
    if not authority_path:
        raise Blocker("browser_use_flow_lease_authority_missing")
    assert_regular_file(authority_path, mode=0o600)
    record_args = argparse.Namespace(
        run_id=run_id,
        session=requested_session,
        descriptor=descriptor_path,
        authority=authority_path,
        task_id=lease.get("task_id"),
        delete_approved=delete_approval_signal(args),
        preserve_temporary=bool(getattr(args, "preserve_temporary", False)),
    )
    record_finalize(record_args)
    descriptor = read_json_safe(descriptor_path)
    nonce = str(descriptor.get("nonce") or "")
    receipt_path = os.path.join(config["roots"]["receipts"], run_id, f"{session}-{nonce}.json")
    receipt = read_json_safe(receipt_path)
    if receipt.get("finalized") is not True:
        raise Blocker("browser_use_flow_lease_finalize_receipt_invalid")
    lease.update({
        "status": "finalized",
        "finalized": True,
        "receipt_path": receipt_path,
        "manifest_path": descriptor.get("manifest_path"),
        "cleanup_status": receipt.get("cleanup", {}).get("status"),
        "updated_at": iso(now_utc()),
    })
    json_atomic_replace(lease_path, lease)
    print(json.dumps({"status": "completed", "lease": lease_path, "receipt": receipt_path, "finalized": True, "cleanup_status": lease.get("cleanup_status")}, sort_keys=True))
    return 0


def scan_downloads(path: str, maximum: int) -> list[dict[str, Any]]:
    records: list[dict[str, Any]] = []
    for entry in pathlib.Path(path).iterdir():
        if entry.is_symlink() or not entry.is_file():
            raise Blocker("browser_use_download_file_type_rejected")
        st = entry.stat()
        if st.st_nlink != 1 or st.st_size > maximum:
            raise Blocker("browser_use_download_size_exceeded")
        records.append({"name": entry.name, "size": st.st_size, "sha256": sha256_file(str(entry)), "classification": mimetypes.guess_type(entry.name)[0] or "application/octet-stream", "destination": path, "auto_open": False, "auto_execute": False})
    return records


def quarantine_profile(config: dict[str, Any], profile: str, ctx: dict[str, Any]) -> str | None:
    if ctx.get("process_terminated") is not True or ctx.get("listener_absent") is not True:
        raise Blocker("browser_use_quarantine_process_cleanup_unverified")
    if not profile or not os.path.lexists(profile):
        return None
    single_use_root = os.path.realpath(config["roots"]["single_use_profiles"])
    if os.path.realpath(profile) != profile or not profile.startswith(single_use_root + os.sep):
        raise Blocker("browser_use_profile_cleanup_scope_mismatch")
    assert_directory(profile)
    assert_debug_listener_absent(int(ctx.get("port") or 0))
    quarantine_root = config["roots"]["quarantine"]
    assert_directory(quarantine_root, create=True)
    destination = os.path.join(quarantine_root, os.path.basename(profile))
    if os.path.lexists(destination):
        raise Blocker("browser_use_quarantine_destination_exists")
    expires = now_utc() + dt.timedelta(seconds=config["limits"]["quarantine_ttl_seconds"])
    marker = {"schema": "browser-use-quarantine.v1", "run_id": ctx["run_id"], "session": ctx["session"], "nonce": ctx["nonce"], "quarantined_at": iso(now_utc()), "expires_at": iso(expires), "related_pid": ctx.get("process", {}).get("root_pid"), "related_start_time": ctx.get("process", {}).get("root_start_time"), "port": ctx.get("port"), "lock_paths": ctx.get("lock_paths", []), "canonical_profile": os.path.realpath(profile), "owner_uid": EUID}
    marker["quarantine_path"] = os.path.join(quarantine_root, os.path.basename(profile))
    json_atomic_no_replace(os.path.join(profile, ".quarantine.json"), marker)
    os.rename(profile, destination)
    if os.path.lexists(profile) or not os.path.isdir(destination):
        raise Blocker("browser_use_quarantine_readback_failed")
    os.chmod(destination, 0o700)
    return destination


def cleanup_exact_profile(profile: str, single_use_root: str, run_id: str, nonce: str) -> None:
    if os.path.realpath(profile) != profile or not profile.startswith(single_use_root + os.sep):
        raise Blocker("browser_use_profile_cleanup_scope_mismatch")
    assert_directory(profile)
    marker = os.path.join(profile, ".browser-use-profile.json")
    assert_regular_file(marker, mode=0o600)
    marker_value = read_json_safe(marker)
    if marker_value.get("run_id") != run_id or marker_value.get("nonce") != nonce:
        raise Blocker("browser_use_profile_marker_binding_mismatch")
    shutil.rmtree(profile)


def cleanup_temporary_profile(
    config: dict[str, Any],
    descriptor: dict[str, Any],
    *,
    process_verified: bool = False,
    allow_released_locks: bool = False,
) -> None:
    """Delete one temporary profile only after immutable binding and ownership rechecks.

    A stale ``record-recover`` may have already released the exact run-owned
    locks before terminal cleanup is requested.  Only its restartable stale
    state may use that fact as a positive lock-absence readback; live/normal
    cleanup still requires every lock to be present and owner-validated.
    """
    profile = descriptor.get("profile")
    if not isinstance(profile, str) or not os.path.lexists(profile):
        if (descriptor.get("cleanup_state") or {}).get("profile_removed") is True:
            return
        raise Blocker("browser_use_temporary_profile_missing")
    expected = {
        "mode": descriptor.get("mode"),
        "lifecycle": TEMPORARY_LIFECYCLE,
        "automation_id": descriptor.get("automation_id"),
        "task_id": descriptor.get("task_id"),
        "run_id": descriptor.get("run_id"),
        "creation_binding": descriptor.get("creation_binding"),
        "canonical_profile": os.path.realpath(profile),
        "port": int(descriptor.get("port")),
        "authority_sha256": descriptor.get("authority_sha256"),
        "authority_scope": descriptor.get("authority_scope"),
        "account_identity": descriptor.get("account_identity"),
        "origins": sorted(descriptor.get("origins") or descriptor.get("target_origins") or []),
    }
    if descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE or not process_verified:
        raise Blocker("browser_use_temporary_cleanup_recheck_required")
    validate_temporary_marker(config, os.path.realpath(profile), expected, require_unexpired=False)
    marker_path = os.path.join(profile, ".browser-use-profile.json")
    before_profile = lstat(profile)
    before_marker = lstat(marker_path)
    marker_digest = sha256_file(marker_path)
    lock_paths = list(descriptor.get("lock_paths") or [])
    expected_profile_lock = temporary_profile_lock_path(config, profile)
    if expected_profile_lock not in lock_paths:
        raise Blocker("browser_use_temporary_profile_lock_missing")
    if allow_released_locks:
        if descriptor.get("status") != "stale" or descriptor.get("recovery_state") != "restartable":
            raise Blocker("browser_use_temporary_released_lock_state_invalid")
        _acquire_stale_cleanup_locks(config, descriptor)
    else:
        assert_owned_locks(lock_paths, descriptor["run_id"], descriptor["nonce"])
    if os.path.realpath(profile) != profile or os.path.islink(profile) or before_profile.st_uid != EUID:
        raise Blocker("browser_use_temporary_profile_recheck_failed")
    if os.path.realpath(marker_path) != marker_path or before_marker.st_uid != EUID:
        raise Blocker("browser_use_temporary_marker_recheck_failed")
    after_profile = lstat(profile)
    after_marker = lstat(marker_path)
    if (before_profile.st_dev, before_profile.st_ino) != (after_profile.st_dev, after_profile.st_ino) or (before_marker.st_dev, before_marker.st_ino) != (after_marker.st_dev, after_marker.st_ino) or sha256_file(marker_path) != marker_digest:
        raise Blocker("browser_use_temporary_profile_changed_during_recheck")
    shutil.rmtree(profile)
    if os.path.lexists(profile):
        raise Blocker("browser_use_temporary_profile_cleanup_readback_failed")


def cleanup_exact_download_dir(path: str, downloads_root: str) -> None:
    canonical_root = os.path.realpath(downloads_root)
    if not os.path.isabs(path) or os.path.realpath(path) != path or not path.startswith(canonical_root + os.sep):
        raise Blocker("browser_use_download_cleanup_scope_mismatch")
    assert_directory(path)
    shutil.rmtree(path)


def cleanup_empty_download_dir(path: str, downloads_root: str) -> bool:
    """Remove only an empty run-scoped download directory.

    Non-empty download output may be a workflow artifact, so it is retained
    for the caller and recorded in the receipt rather than deleted implicitly.
    """
    canonical_root = os.path.realpath(downloads_root)
    if not os.path.isabs(path) or os.path.realpath(path) != path or not path.startswith(canonical_root + os.sep):
        raise Blocker("browser_use_download_cleanup_scope_mismatch")
    assert_directory(path)
    if any(pathlib.Path(path).iterdir()):
        return False
    os.rmdir(path)
    if os.path.lexists(path):
        raise Blocker("browser_use_download_cleanup_readback_failed")
    return True


def _handoff_base_path(path: str) -> str:
    path = os.path.realpath(path)
    for suffix in (HANDOFF_CLAIM_SUFFIX, HANDOFF_CONSUMED_SUFFIX):
        if path.endswith(suffix):
            return path[: -len(suffix)]
    return path


def _cleanup_complete_path(base_path: str) -> str:
    return base_path + HANDOFF_COMPLETE_SUFFIX


def _cleanup_pending_path(base_path: str) -> str:
    return base_path + ".cleanup-pending.json"


def _read_cleanup_complete_marker(path: str, run_id: str, session: str) -> dict[str, Any] | None:
    if not os.path.lexists(path):
        return None
    try:
        value = read_json_safe(path)
    except (Blocker, json.JSONDecodeError) as exc:
        raise Blocker("browser_use_cleanup_completion_readback_failed") from exc
    if (
        value.get("schema") != "browser-use-cleanup-complete.v1"
        or value.get("completed") is not True
        or value.get("run_id") != run_id
        or value.get("session") != session
    ):
        raise Blocker("browser_use_cleanup_completion_binding_mismatch")
    return value


def _recording_source_cleanup_marker(config: dict[str, Any], descriptor: dict[str, Any]) -> dict[str, Any] | None:
    """Return a verified source-handoff cleanup marker, if one exists.

    Terminal cleanup may replace a consumed handoff with a marker. This is
    accepted only for a dead source-handoff recording and only when the
    marker is bound to the exact recording nonce/task/lifecycle. It never
    authorizes browser commands or profile deletion.
    """
    source_value = descriptor.get("source_handoff_descriptor")
    if not isinstance(source_value, str) or not source_value:
        raise Blocker("browser_use_recording_handoff_source_missing")
    source_path = os.path.realpath(source_value)
    assert_handoff_path(source_path, handoff_root(config))
    source_run_id = safe_id(descriptor.get("source_run_id"), "run_id")
    source_session = validate_id(descriptor.get("source_session"), "session")
    marker_path = _cleanup_complete_path(_handoff_base_path(source_path))
    marker = _read_cleanup_complete_marker(marker_path, source_run_id, source_session)
    if marker is None:
        return None
    if (
        marker.get("nonce") != descriptor.get("creation_binding")
        or marker.get("task_id") != descriptor.get("task_id")
        or marker.get("lifecycle") != descriptor.get("lifecycle")
    ):
        raise Blocker("browser_use_cleanup_completion_binding_mismatch")
    return marker


def _source_handoff_cleanup_marker_reconciliation_eligible(config: dict[str, Any], descriptor: dict[str, Any]) -> bool:
    """Recognize only a dead, marker-backed source-handoff recording."""
    if descriptor.get("status") not in {"continued", "cleanup_pending"}:
        return False
    if descriptor.get("owned_chrome") is not False:
        return False
    source_value = descriptor.get("source_handoff_descriptor")
    if not isinstance(source_value, str) or not source_value:
        return False
    if os.path.lexists(os.path.realpath(source_value)):
        return False
    return _recording_source_cleanup_marker(config, descriptor) is not None


def _read_cleanup_complete(base_path: str, run_id: str, session: str) -> bool:
    return _read_cleanup_complete_marker(_cleanup_complete_path(base_path), run_id, session) is not None


def _write_cleanup_complete(base_path: str, descriptor: dict[str, Any]) -> None:
    path = _cleanup_complete_path(base_path)
    value = {
        "schema": "browser-use-cleanup-complete.v1",
        "completed": True,
        "run_id": descriptor["run_id"],
        "session": descriptor["session"],
        "nonce": descriptor["nonce"],
        "lifecycle": descriptor.get("lifecycle"),
        "task_id": descriptor.get("task_id"),
        "profile_preserved": bool((descriptor.get("cleanup_state") or {}).get("profile_preserved")),
        "profile_removed": bool((descriptor.get("cleanup_state") or {}).get("profile_removed")),
        "shared_profile_available": bool((descriptor.get("cleanup_state") or {}).get("shared_profile_available")),
    }
    try:
        json_atomic_no_replace(path, value)
    except Blocker as exc:
        # Another retry may have finalized the same lease between the
        # pre-check and this no-replace write.  Accept only a matching,
        # positively read-back completion marker.
        if exc.code != "browser_use_receipt_already_exists" or not _read_cleanup_complete(base_path, descriptor["run_id"], descriptor["session"]):
            raise


def _record_cleanup_state(path: str, descriptor: dict[str, Any], **updates: Any) -> None:
    state = dict(descriptor.get("cleanup_state") or {})
    state.update(updates)
    descriptor["cleanup_state"] = state
    update_handoff(path, descriptor)


def _cleanup_failure_code(error: BaseException, default: str = "browser_use_cleanup_uncertain") -> str:
    return error.code if isinstance(error, Blocker) else default


def _record_context_cleanup_pending(ctx: dict[str, Any], blocker: str) -> None:
    cleanup = dict(ctx.get("cleanup") or {})
    cleanup.update({"status": "cleanup_pending", "state": "uncertain", "uncertain": True, "exact_blocker": blocker})
    # Keep the complete lease evidence.  A release attempt may have removed a
    # prior lock before a later lock became uncertain; filtering by existence
    # would erase that partial-release history from the durable receipt.
    cleanup["locks_retained"] = list(ctx.get("lock_paths") or [])
    ctx["cleanup"] = cleanup


def _release_lock_set(paths: list[str], run_id: str, nonce: str) -> tuple[bool, str | None, list[str]]:
    """Release an owned lock set, stopping at the first uncertain result."""
    # Finalization is retryable.  A previous attempt may already have removed
    # one or both exact locks; missing is safe, while an existing lock must
    # still be positively bound to this run before it is touched.
    for lock_path in paths:
        if not os.path.lexists(lock_path):
            continue
        try:
            value = read_json_safe(lock_path)
            if value.get("run_id") != run_id or value.get("nonce") != nonce:
                raise Blocker("browser_use_lock_owner_recheck_failed")
        except Exception as exc:
            return False, _cleanup_failure_code(exc), []

    released: list[str] = []
    for lock_path in paths:
        try:
            release_lock(lock_path, run_id, nonce)
            if os.path.lexists(lock_path):
                raise Blocker("browser_use_lock_cleanup_readback_failed")
        except Exception as exc:
            # Once one member is uncertain, do not touch any later member.
            return False, _cleanup_failure_code(exc), released
        released.append(lock_path)
    return True, None, released


def _release_locks_after_verified_cleanup(ctx: dict[str, Any], run_id: str, nonce: str) -> tuple[bool, str | None]:
    cleanup = dict(ctx.get("cleanup") or {})
    if cleanup.get("state") == "uncertain" or cleanup.get("uncertain") is True:
        return False, str(cleanup.get("exact_blocker") or "browser_use_cleanup_uncertain")
    paths = list(ctx.get("lock_paths") or [])
    released_ok, code, released = _release_lock_set(paths, run_id, nonce)
    if not released_ok:
        _record_context_cleanup_pending(ctx, code)
        return False, code
    room_id = ctx.get("room_id")
    if room_id:
        try:
            lifecycle = str(ctx.get("lifecycle") or "")
            terminal_cleanup = bool(ctx.get("room_terminal_cleanup"))
            if lifecycle == "single-use" or terminal_cleanup:
                room_registry_release(ctx["config"], room_id, run_id=run_id, activity="release")
            else:
                room_registry_update(ctx["config"], room_id, run_id=run_id, state="held", activity="held")
        except (Blocker, OSError, ValueError, KeyError) as exc:
            code = _cleanup_failure_code(exc, "browser_use_room_registry_release_failed")
            _record_context_cleanup_pending(ctx, code)
            return False, code
    shared_lease_path = ctx.get("shared_profile_lease_path")
    if isinstance(shared_lease_path, str):
        try:
            mark_shared_profile_lease_released(
                ctx["config"],
                os.path.realpath(shared_lease_path),
                run_id=run_id,
                session=str(ctx.get("session") or ""),
                task_id=str(ctx.get("task_id") or ""),
                room=room_registry_lookup(ctx["config"], room_id) if room_id else None,
            )
        except (Blocker, OSError, ValueError, KeyError) as exc:
            code = _cleanup_failure_code(exc, "browser_use_shared_profile_release_uncertain")
            _record_context_cleanup_pending(ctx, code)
            return False, code
    capability_path = ctx.get("cleanup_capability_path")
    if isinstance(capability_path, str):
        phase = lifecycle_phase(observed=True, requested=True, executed=True, completed=True)
        try:
            update_recording_cleanup_capability(
                capability_path,
                expected_run_id=str(run_id),
                expected_session=str(ctx.get("session") or ""),
                expected_nonce=str(nonce),
                cleanup_phase=phase,
                resource_binding={"room_id": room_id, "port": ctx.get("port"), "profile": ctx.get("profile")},
            )
        except Exception as exc:
            code = _cleanup_failure_code(exc, "browser_use_recording_cleanup_capability_persistence_failed")
            _record_context_cleanup_pending(ctx, code)
            return False, code
    cleanup.update({"status": "cleaned", "locks_removed": released})
    phases = dict(ctx.get("phases") or {})
    phases["terminal_cleanup"] = phase if isinstance(capability_path, str) else lifecycle_phase(observed=True, requested=True, executed=True, completed=True)
    ctx["phases"] = phases
    ctx["cleanup"] = cleanup
    return True, None


def _mark_cleanup_pending(base_path: str, claim_path: str, descriptor: dict[str, Any], blocker: str) -> None:
    state = dict(descriptor.get("cleanup_state") or {})
    state.update({"status": "cleanup_pending", "state": "uncertain", "uncertain": True, "exact_blocker": blocker, "updated_at": iso(now_utc()), "locks_retained": list(descriptor.get("lock_paths") or [])})
    descriptor["status"] = "cleanup_pending"
    descriptor["cleanup_state"] = state
    descriptor_write_failed = False
    try:
        update_handoff(claim_path, descriptor)
    except Exception:
        descriptor_write_failed = True
    sidecar_write_failed = False
    try:
        json_atomic_replace(
            _cleanup_pending_path(base_path),
            {"schema": "browser-use-cleanup-pending.v1", "status": "cleanup_pending", "state": "uncertain", "uncertain": True, "run_id": descriptor["run_id"], "session": descriptor["session"], "nonce": descriptor["nonce"], "lock_paths": list(descriptor.get("lock_paths") or []), "exact_blocker": blocker, "updated_at": iso(now_utc())},
        )
    except Exception:
        sidecar_write_failed = True
    if descriptor_write_failed or sidecar_write_failed:
        # Keep the descriptor and locks in place and expose only a stable,
        # secret-safe blocker; never replace it with the persistence exception.
        raise Blocker("browser_use_cleanup_pending_persistence_failed") from None


def _select_cleanup_candidate(base_path: str) -> str | None:
    for candidate in (base_path + HANDOFF_CLAIM_SUFFIX, base_path + HANDOFF_CONSUMED_SUFFIX, base_path):
        if os.path.lexists(candidate):
            return candidate
    return None


def _claim_handoff_for_cleanup(config: dict[str, Any], base_path: str, run_id: str, session: str) -> tuple[str, dict[str, Any]]:
    claim_path = base_path + HANDOFF_CLAIM_SUFFIX
    consumed_path = base_path + HANDOFF_CONSUMED_SUFFIX
    if os.path.lexists(claim_path):
        selected = claim_path
    elif os.path.lexists(consumed_path):
        selected = consumed_path
    else:
        try:
            os.link(base_path, claim_path)
        except FileExistsError as exc:
            if os.path.lexists(claim_path):
                selected = claim_path
            else:
                raise Blocker("browser_use_handoff_cleanup_claim_exists") from exc
        except FileNotFoundError as exc:
            if os.path.lexists(claim_path):
                selected = claim_path
            elif os.path.lexists(consumed_path):
                selected = consumed_path
            else:
                raise Blocker("browser_use_handoff_missing") from exc
        else:
            selected = claim_path

    # The selected descriptor is the only descriptor read after claiming.
    descriptor = read_handoff(config, selected, run_id, session, require_unexpired=False)
    if descriptor["status"] not in {"active", "continued", "claimed", "cleanup_pending"}:
        raise Blocker("browser_use_handoff_not_active")
    descriptor["status"] = "claimed"
    descriptor["lease_path"] = os.path.realpath(selected)
    _record_cleanup_state(selected, descriptor, claimed=True, claimed_at=iso(now_utc()))
    if os.path.lexists(base_path) and base_path != selected:
        try:
            os.unlink(base_path)
        except OSError as exc:
            raise Blocker("browser_use_handoff_claim_source_cleanup_pending") from exc
    return selected, descriptor


def _remove_handoff_descriptors(base_path: str, claim_path: str) -> None:
    for path in {base_path, base_path + HANDOFF_CONSUMED_SUFFIX, claim_path}:
        if os.path.lexists(path):
            try:
                os.unlink(path)
            except OSError as exc:
                raise Blocker("browser_use_handoff_cleanup_readback_failed") from exc


def cleanup_abandoned_handoff(config: dict[str, Any], descriptor_path: str, run_id: str, session: str, *, require_expired: bool = True, preserve_temporary: bool = False) -> dict[str, Any]:
    base_path = _handoff_base_path(descriptor_path)
    if _read_cleanup_complete(base_path, run_id, session):
        return {"status": "handoff_already_cleaned", "cleaned": False, "finalized": True}
    candidate = _select_cleanup_candidate(base_path)
    if candidate is None:
        raise Blocker("browser_use_handoff_missing")
    candidate_descriptor = read_handoff(config, candidate, run_id, session, require_unexpired=False)
    existing_claim = candidate.endswith(HANDOFF_CLAIM_SUFFIX) or candidate_descriptor.get("status") in {"claimed", "cleanup_pending"}
    if require_expired and not existing_claim and handoff_expiry(candidate_descriptor) > now_utc():
        if candidate.endswith(HANDOFF_CONSUMED_SUFFIX):
            return {"status": "handoff_consumed", "cleaned": False, "finalized": True}
        raise Blocker("browser_use_handoff_not_expired")
    if not existing_claim:
        # Validate the owned filesystem lease before creating a cleanup claim.
        validate_handoff_resources(config, candidate_descriptor)

    claim_path = candidate
    descriptor = candidate_descriptor
    try:
        claim_path, descriptor = _claim_handoff_for_cleanup(config, base_path, run_id, session)
        state = dict(descriptor.get("cleanup_state") or {})
        if not state.get("process_terminated"):
            process_present = validate_handoff_process_identity(config, descriptor, allow_missing=True)
            if process_present:
                daemon_code, _ = run_cli_keep_alive(config, config["roots"]["browser_use_home"], descriptor["port"], session, ["close"], False)
                if daemon_code != 0:
                    raise Blocker("browser_use_handoff_daemon_close_failed")
            ok, cleanup_error = terminate_chrome(None, descriptor["process"], config["executables"]["chrome"]["canonical_path"], descriptor["port"], descriptor["profile"])
            if not ok or cleanup_error:
                raise Blocker(cleanup_error or "browser_use_handoff_chrome_cleanup_failed")
            assert_debug_listener_absent(descriptor["port"])
            _record_cleanup_state(claim_path, descriptor, process_terminated=True, listener_absent=True)
            state = dict(descriptor.get("cleanup_state") or {})
        if not state.get("listener_absent"):
            raise Blocker("browser_use_listener_recheck_failed")

        lifecycle = str(descriptor.get("lifecycle", "single-use"))
        if lifecycle == "single-use":
            if not state.get("profile_removed"):
                cleanup_exact_profile(descriptor["profile"], config["roots"]["single_use_profiles"], run_id, descriptor["nonce"])
                if os.path.lexists(descriptor["profile"]):
                    raise Blocker("browser_use_profile_cleanup_readback_failed")
                _record_cleanup_state(claim_path, descriptor, profile_removed=True)
                state = dict(descriptor.get("cleanup_state") or {})
            elif os.path.lexists(descriptor["profile"]):
                raise Blocker("browser_use_profile_cleanup_readback_failed")
        elif lifecycle == "scheduled":
            if not os.path.lexists(descriptor["profile"]):
                raise Blocker("browser_use_scheduled_profile_missing_after_cleanup")
            if not state.get("profile_preserved"):
                _record_cleanup_state(claim_path, descriptor, profile_preserved=True)
                state = dict(descriptor.get("cleanup_state") or {})
        elif lifecycle == TEMPORARY_LIFECYCLE:
            if preserve_temporary:
                if not os.path.lexists(descriptor["profile"]):
                    raise Blocker("browser_use_temporary_profile_missing")
                assert_regular_file(os.path.join(descriptor["profile"], ".browser-use-profile.json"), mode=0o600)
                if not state.get("profile_preserved"):
                    _record_cleanup_state(claim_path, descriptor, profile_preserved=True)
                    state = dict(descriptor.get("cleanup_state") or {})
            elif not state.get("profile_removed"):
                cleanup_temporary_profile(config, descriptor, process_verified=True)
                _record_cleanup_state(claim_path, descriptor, profile_removed=True, temporary_profile_removed=True)
                state = dict(descriptor.get("cleanup_state") or {})
            elif os.path.lexists(descriptor["profile"]):
                raise Blocker("browser_use_temporary_profile_cleanup_readback_failed")
        else:
            raise Blocker("browser_use_handoff_lifecycle_invalid")

        if not state.get("download_dir_removed"):
            cleanup_exact_download_dir(descriptor["download_dir"], config["roots"]["downloads"])
            if os.path.lexists(descriptor["download_dir"]):
                raise Blocker("browser_use_download_cleanup_readback_failed")
            _record_cleanup_state(claim_path, descriptor, download_dir_removed=True)
            state = dict(descriptor.get("cleanup_state") or {})
        elif os.path.lexists(descriptor["download_dir"]):
            raise Blocker("browser_use_download_cleanup_readback_failed")

        if not state.get("locks_release_started"):
            assert_owned_locks(descriptor["lock_paths"], run_id, descriptor["nonce"])
            _record_cleanup_state(claim_path, descriptor, locks_release_started=True)
        released_ok, release_error, released = _release_lock_set(descriptor["lock_paths"], run_id, descriptor["nonce"])
        if not released_ok:
            raise Blocker(release_error or "browser_use_cleanup_uncertain")
        _record_cleanup_state(claim_path, descriptor, locks_released=True, locks_removed=released)
        room_id = descriptor.get("room_id")
        if room_id:
            if lifecycle == "single-use" or lifecycle == TEMPORARY_LIFECYCLE:
                room_registry_release(config, room_id, run_id=run_id, activity="release")
            else:
                room_registry_update(config, room_id, run_id=run_id, state="held", activity="held")
        shared_profile_available = False
        if lifecycle == TEMPORARY_LIFECYCLE and preserve_temporary:
            # Retention and cross-session claimability are separate lifecycle
            # transitions. Publish only after process/listener/lock/room
            # cleanup has completed, so a retained profile can never enter
            # the shared pool while its source handoff is still live.
            mark_temporary_profile_shareable(config, descriptor)
            _record_cleanup_state(claim_path, descriptor, shared_profile_available=True)
            shared_profile_available = True
        _write_cleanup_complete(base_path, descriptor)
        _remove_handoff_descriptors(base_path, claim_path)
    except Exception as exc:
        code = exc.code if isinstance(exc, Blocker) else "browser_use_cleanup_uncertain"
        _mark_cleanup_pending(base_path, claim_path, descriptor, code)
        raise
    return {
        "status": "abandoned_handoff_cleaned",
        "cleaned": True,
        "finalized": True,
        "profile_preserved": lifecycle == TEMPORARY_LIFECYCLE and preserve_temporary,
        "shared_profile_available": shared_profile_available,
    }


def handoff_watchdog(args: argparse.Namespace) -> int:
    try:
        config = read_toml()
        run_id = safe_id(args.run_id, "run_id")
        requested_session = validate_id(args.session, "session")
        session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
        descriptor_path = os.path.realpath(args.descriptor)
        descriptor = read_handoff(config, descriptor_path, run_id, session, require_unexpired=False)
        watchdog_raw = descriptor.get("watchdog_expires_at") or descriptor.get("authority_lineage_expires_at")
        expires = handoff_expiry({"expires_at": watchdog_raw}) if watchdog_raw else handoff_expiry(descriptor)
        remaining = (expires - now_utc()).total_seconds()
        if remaining > 0:
            time.sleep(remaining)
        write_task_resume_checkpoint(
            config,
            descriptor,
            descriptor_path,
            state="claimed",
            next_action="finish the exact watchdog cleanup and read back all owned resources",
            restart_point="same descriptor while watchdog cleanup is in progress; no browser command is dispatched",
        )
        try:
            result = cleanup_abandoned_handoff(config, descriptor_path, run_id, session)
        except (Blocker, OSError, subprocess.SubprocessError, ValueError, json.JSONDecodeError) as exc:
            write_task_resume_checkpoint(
                config,
                descriptor,
                descriptor_path,
                state="cleanup_pending",
                exact_blocker=exc.code if isinstance(exc, Blocker) else "browser_use_runtime_error",
                next_action="reconcile the exact cleanup-pending handoff before starting another handoff",
                restart_point="same task_id after cleanup readback; prior login state is not assumed",
            )
            raise
        write_task_resume_checkpoint(
            config,
            descriptor,
            descriptor_path,
            state="cleanup_complete",
            next_action="create a new authorized handoff for the same task_id when continuing the work",
            restart_point="old descriptor is cleanup-complete; prior cookies/profile are not assumed",
        )
        print(json.dumps(result, sort_keys=True))
        return 0
    except Blocker as exc:
        print(json.dumps({"status": "blocked", "exact_blocker": exc.code, "finalized": False}, sort_keys=True))
        return 1
    except Exception as exc:
        print(json.dumps({"status": "blocked", "exact_blocker": _cleanup_failure_code(exc), "finalized": False}, sort_keys=True))
        return 1


def finalized_receipt(config: dict[str, Any], versions: dict[str, Any], ctx: dict[str, Any], failure: str | None) -> str:
    receipt_root = config["roots"]["receipts"]
    run_dir = os.path.join(receipt_root, ctx["run_id"])
    assert_directory(run_dir, create=True)
    base_path = os.path.join(run_dir, f"{ctx['session']}-{ctx['nonce']}.json")
    path = base_path
    existing_base = read_json_safe(base_path) if os.path.lexists(base_path) else None
    reconciliation_upgrade = (
        failure is None
        and isinstance(existing_base, dict)
        and existing_base.get("schema") == "browser-use-receipt.v1"
        and existing_base.get("run_id") == ctx["run_id"]
        and existing_base.get("session") == ctx["session"]
        and existing_base.get("finalized") is False
        and existing_base.get("completion_blocker") == "browser_use_external_effects_unknown"
        and ctx.get("reconciliation_state") == "completed"
        and not ctx.get("pending_reconciliation")
    )
    if reconciliation_upgrade:
        # Receipts are append-only. Preserve the original blocked receipt and
        # publish a distinct terminal receipt after owner-bound reconciliation.
        path = os.path.join(run_dir, f"{ctx['session']}-{ctx['nonce']}-reconciled.json")
    end_time = now_utc()
    completion_blocker = ctx.get("completion_blocker") or failure
    completion_status = ctx.get("completion_status") or ("blocked" if failure else "completed")
    receipt = {
        "schema": "browser-use-receipt.v1",
        "authority_mode": ctx["mode"],
        "lifecycle": ctx["lifecycle"],
        "run_id": ctx["run_id"],
        "session": ctx["session"],
        "requested_session": ctx.get("requested_session", ctx["session"]),
        "automation_id": ctx["automation_id"],
        "task_id": ctx.get("task_id"),
        "creation_binding": ctx.get("creation_binding"),
        "authority_sha256": ctx.get("authority_sha256"),
        "authority_scope": ctx.get("authority_scope"),
        "paths": {"profile": ctx.get("profile"), "download_dir": ctx.get("download_dir"), "browser_use_home": config["roots"]["browser_use_home"]},
        "versions_hashes": versions,
        "pid": ctx.get("process", {}).get("root_pid"),
        "start_time": ctx.get("started_at"),
        "end_time": iso(end_time),
        "port": ctx.get("port"),
        "profile_hash": ctx.get("profile_hash"),
        "target_origins": sorted(ctx.get("target_origins", [])),
        "account_identity": ctx.get("account_identity", "public"),
        "shared_profile_lease": {"path": ctx.get("shared_profile_lease_path"), "profile_preserved": True} if ctx.get("shared_profile_lease_path") else None,
        "authority_summary": ctx.get("authority_summary", {"data_exposure": "public_read_only", "side_effect_scope": "none", "approval": "not_required"}),
        "external_effects": ctx.get("external_effects", "none"),
        "operation_ledger_path": ctx.get("operation_ledger_path"),
        "operation_ledger_tail_digest": ctx.get("operation_ledger_tail_digest"),
        "audit_freshness": build_audit_freshness(
            run_id=ctx.get("run_id"),
            session=ctx.get("session"),
            nonce=ctx.get("nonce"),
            room_id=ctx.get("room_id"),
            port=ctx.get("port"),
            helper_sha256=ctx.get("helper_sha256"),
            generated_at=iso(end_time),
        ),
        "guard_readback": {"preflight": ctx.get("preflight", False), "listener_verified": ctx.get("listener_verified", False), "process_identity_verified": ctx.get("process_identity_verified", False), "post_command_state_readback": ctx.get("readback_exit") is not None, "readback_exit": ctx.get("readback_exit"), "readback_required": ctx.get("readback_required", True)},
        "uploads": ctx.get("uploads", []),
        "downloads": ctx.get("downloads", []),
        "exit": {"code": 1 if failure else 0, "exact_blocker": failure},
        "cleanup": ctx.get("cleanup", {}),
        "cleanup_capability_path": ctx.get("cleanup_capability_path"),
        "phases": ctx.get("phases", {}),
        "recording_finalized": ctx.get("recording_finalized"),
        "cleanup_completed": ctx.get("cleanup_completed"),
        "completion_status": completion_status,
        "completion_blocker": completion_blocker,
        **({
            "reconciliation_upgrade": {
                "prior_receipt_path": base_path,
                "prior_receipt_sha256": sha256_file(base_path),
                "resolution": "owner_bound_history_evidence",
            }
        } if reconciliation_upgrade else {}),
        "quarantine": ctx.get("quarantine"),
        "finalized": failure is None,
    }
    try:
        json_atomic_no_replace(path, receipt)
    except Blocker as exc:
        if exc.code != "browser_use_receipt_already_exists":
            raise
        existing = read_json_safe(path)
        existing_blocker = existing.get("completion_blocker") or (existing.get("exit") or {}).get("exact_blocker")
        if (
            existing.get("schema") != "browser-use-receipt.v1"
            or existing.get("run_id") != ctx["run_id"]
            or existing.get("session") != ctx["session"]
            or existing.get("finalized") is not (failure is None)
            or (failure is None and existing.get("completion_status") == "blocked")
            or (failure is not None and existing_blocker not in {None, failure, completion_blocker})
        ):
            raise Blocker("browser_use_receipt_binding_mismatch")
    return path


def _login_handoff_descriptor_for_pending(descriptor_path: str, ctx: dict[str, Any], run_id: str, session: str, nonce: str) -> dict[str, Any]:
    if os.path.lexists(descriptor_path):
        try:
            descriptor = read_json_safe(descriptor_path)
            if isinstance(descriptor, dict):
                return descriptor
        except Exception:
            pass
    return {"run_id": run_id, "session": session, "nonce": nonce, "lock_paths": list(ctx.get("lock_paths") or [])}


def _record_login_handoff_cleanup_pending(ctx: dict[str, Any], descriptor_path: str | None, run_id: str, session: str, nonce: str, blocker: str) -> None:
    _record_context_cleanup_pending(ctx, blocker)
    if not descriptor_path:
        return
    base_path = _handoff_base_path(descriptor_path)
    descriptor = _login_handoff_descriptor_for_pending(descriptor_path, ctx, run_id, session, nonce)
    _mark_cleanup_pending(base_path, descriptor_path, descriptor, blocker)
    config = ctx.get("config")
    if isinstance(config, dict):
        try:
            write_task_resume_checkpoint(
                config,
                descriptor,
                descriptor_path,
                state="cleanup_pending",
                exact_blocker=blocker,
                next_action="reconcile the exact cleanup-pending descriptor before starting another handoff",
                restart_point="same task_id after cleanup readback; prior login state is not assumed",
            )
        except (Blocker, OSError, ValueError, json.JSONDecodeError):
            # The cleanup-pending descriptor and sidecar remain the primary
            # recovery evidence if the optional index cannot be written.
            pass


def _cleanup_login_handoff_failure(config: dict[str, Any], ctx: dict[str, Any], descriptor_path: str | None, run_id: str, session: str, nonce: str, profile: str, download_dir: str, process_cleanup_ok: bool, cleanup_error: str | None) -> str:
    failure = cleanup_error or "browser_use_cleanup_uncertain"
    if not process_cleanup_ok:
        # Do not call quarantine_profile until process termination and
        # listener absence are verified.  Its guard intentionally rejects an
        # uncertain process state; surfacing that guard error here would hide
        # the original cleanup failure and leave the run harder to resume.
        ctx["quarantine"] = "quarantine_pending"
        _record_login_handoff_cleanup_pending(ctx, descriptor_path, run_id, session, nonce, failure)
        return failure

    try:
        lifecycle = str(ctx.get("lifecycle", "single-use"))
        if lifecycle == "single-use":
            if os.path.lexists(profile):
                cleanup_exact_profile(profile, config["roots"]["single_use_profiles"], run_id, nonce)
                if os.path.lexists(profile):
                    raise Blocker("browser_use_profile_cleanup_readback_failed")
        elif lifecycle == TEMPORARY_LIFECYCLE:
            if not os.path.lexists(profile):
                if ctx.get("profile_created") is not False:
                    raise Blocker("browser_use_temporary_profile_missing_after_cleanup")
            else:
                ctx.setdefault("cleanup", {})["temporary_profile_preserved"] = True
        elif lifecycle == "scheduled" and not os.path.lexists(profile):
            raise Blocker("browser_use_scheduled_profile_missing_after_cleanup")
        elif lifecycle not in {"single-use", "scheduled", TEMPORARY_LIFECYCLE}:
            raise Blocker("browser_use_lifecycle_invalid")
        if os.path.lexists(download_dir):
            cleanup_exact_download_dir(download_dir, config["roots"]["downloads"])
            if os.path.lexists(download_dir):
                raise Blocker("browser_use_download_cleanup_readback_failed")
    except Exception as exc:
        failure = _cleanup_failure_code(exc)
        _record_login_handoff_cleanup_pending(ctx, descriptor_path, run_id, session, nonce, failure)
        return failure

    released, release_error = _release_locks_after_verified_cleanup(ctx, run_id, nonce)
    if not released:
        failure = release_error or "browser_use_cleanup_uncertain"
        _record_login_handoff_cleanup_pending(ctx, descriptor_path, run_id, session, nonce, failure)
        return failure
    if descriptor_path and os.path.lexists(descriptor_path):
        try:
            os.unlink(descriptor_path)
            if os.path.lexists(descriptor_path):
                raise Blocker("browser_use_handoff_cleanup_readback_failed")
        except Exception as exc:
            failure = _cleanup_failure_code(exc)
            _record_login_handoff_cleanup_pending(ctx, descriptor_path, run_id, session, nonce, failure)
    return failure


def login_handoff(args: argparse.Namespace) -> int:
    config = read_toml()
    lifecycle = resolve_default_lifecycle("authorized", getattr(args, "lifecycle", None))
    if lifecycle not in {"single-use", "scheduled", TEMPORARY_LIFECYCLE}:
        raise Blocker("browser_use_handoff_lifecycle_invalid")
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    args.lifecycle = lifecycle
    ensure_temporary_task_id(args, requested_session)
    automation_id = safe_id(args.automation_id, "automation_id")
    nonce = uuid.uuid4().hex
    validate_installation(config)
    configure_logging(config["roots"]["logs"])
    if not args.authority:
        raise Blocker("browser_use_authority_required")
    if lifecycle == TEMPORARY_LIFECYCLE:
        if not getattr(args, "task_id", None):
            raise Blocker("browser_use_temporary_task_id_required")
        safe_id(args.task_id, "task_id")
    authority = parse_authority(args.authority, run_id, session, aliases=session_aliases(config, requested_session, session))
    authority_digest = sha256_file(args.authority)
    authority_scope = temporary_authority_scope(authority)
    if lifecycle == TEMPORARY_LIFECYCLE:
        nonce = temporary_binding(mode="authorized", lifecycle=lifecycle, automation_id=automation_id, task_id=args.task_id, run_id=run_id, authority_digest=authority_digest, authority_scope=authority_scope, account_identity=authority["account_identity"], origins=list(authority["allowed_origins"]))
        profile = temporary_profile_path(config, nonce)
        download_dir = os.path.join(config["roots"]["downloads"], f"temporary-{nonce[:32]}")
    else:
        profile = os.path.join(config["roots"]["scheduled_profiles"], automation_id) if lifecycle == "scheduled" else None
        download_dir = os.path.join(config["roots"]["downloads"], f"{run_id}-{nonce}")
    allowed_origins = list(authority["allowed_origins"])
    origin = preflight_url(args.url, allowed_origins, config["policy"]["unsafe_path_fragments"])
    command = ["open", args.url]
    _, origins, uploads = validate_command(command, "authorized", config, allowed_origins, download_dir)
    if origins != [origin] or uploads:
        raise Blocker("browser_use_handoff_url_binding_failed")
    ctx: dict[str, Any] = {"mode": "authorized", "lifecycle": lifecycle, "run_id": run_id, "session": session, "requested_session": requested_session, "automation_id": automation_id, "nonce": nonce, "task_id": getattr(args, "task_id", None), "creation_binding": nonce if lifecycle == TEMPORARY_LIFECYCLE else None, "authority_scope": authority_scope if lifecycle == TEMPORARY_LIFECYCLE else None, "started_at": iso(now_utc()), "lock_paths": [], "cleanup": {}, "port": None, "profile": profile, "profile_created": False, "launch_attempted": False, "download_dir": download_dir, "config": config, "room_id": None}
    chrome_proc: subprocess.Popen[bytes] | None = None
    process_identity: dict[str, Any] | None = None
    process_cleanup_ok = True
    diagnostic_detail: str | None = None
    try:
        if lifecycle == "scheduled":
            port_start, port_end = config["ports"]["scheduled_start"], config["ports"]["scheduled_end"]
        elif lifecycle == "single-use":
            port_start, port_end = config["ports"]["single_use_start"], config["ports"]["single_use_end"]
        else:
            port_start, port_end = config["ports"]["temporary_start"], config["ports"]["temporary_end"]
        if args.port is not None and not port_start <= args.port <= port_end:
            raise Blocker("browser_use_handoff_port_out_of_range")
        port = args.port
        room = room_registry_claim(
            config,
            lifecycle=lifecycle,
            run_id=run_id,
            profile=profile if lifecycle != "single-use" else None,
            port=port,
            task_id=getattr(args, "task_id", None),
            automation_id=automation_id,
            activity="handoff-start",
        )
        ctx["room_id"] = room["room_id"]
        profile, port = room["profile"], room["port"]
        ctx["profile"], ctx["port"] = profile, port
        ctx["port"] = port
        if lifecycle == TEMPORARY_LIFECYCLE:
            temp_info = prepare_temporary_profile(config, mode="authorized", automation_id=automation_id, task_id=args.task_id, run_id=run_id, authority_digest=authority_digest, authority_scope=authority_scope, account_identity=authority["account_identity"], origins=list(authority["allowed_origins"]), download_dir=download_dir, requested_port=port)
            ctx["lock_paths"].append(temp_info["profile_lock"])
            ctx["profile_created"] = True
        else:
            prepare_profile(profile, lifecycle == "scheduled", automation_id, download_dir, run_id, nonce)
        if os.path.exists(download_dir):
            raise Blocker("browser_use_download_directory_collision")
        os.mkdir(download_dir, 0o700)
        assert_directory(download_dir)
        profile_lock = temporary_profile_lock_path(config, profile) if lifecycle == TEMPORARY_LIFECYCLE else os.path.join(config["roots"]["locks"], f"profile-{hashlib.sha256(os.path.realpath(profile).encode()).hexdigest()[:24]}.lock")
        port_lock = os.path.join(config["roots"]["locks"], f"port-{port}.lock")
        payload = {"schema": "browser-use-lock.v1", "run_id": run_id, "nonce": nonce, "helper_pid": os.getpid(), "helper_start_time": psutil.Process(os.getpid()).create_time(), "automation_id": automation_id, "port": port, "canonical_profile": os.path.realpath(profile)}
        if lifecycle != TEMPORARY_LIFECYCLE:
            lock_file(profile_lock, payload)
            ctx["lock_paths"].append(profile_lock)
        lock_file(port_lock, payload)
        ctx["lock_paths"].append(port_lock)
        ctx["launch_attempted"] = True
        chrome_proc, process_identity = launch_chrome(config, profile, port, download_dir, config["roots"]["browser_use_home"])
        annotate_lock_process_identity(ctx["lock_paths"], run_id, nonce, process_identity)
        ctx["process"] = process_identity
        ctx["listener_verified"] = True
        ctx["process_identity_verified"] = True
        code, readback_exit = run_cli_keep_alive(config, config["roots"]["browser_use_home"], port, session, command, True, diagnostic=True)
        if code != 0:
            detail = f"{code}:{_LAST_CLI_FAILURE}" if _LAST_CLI_FAILURE else str(code)
            diagnostic_detail = detail
            raise Blocker("browser_use_handoff_open_failed", detail)
        if readback_exit != 0:
            raise Blocker("browser_use_handoff_readback_failed", str(readback_exit))
        assert_handoff_keep_alive(config, process_identity, port, profile)
        marker = os.path.join(profile, ".browser-use-profile.json")
        descriptor_path = os.path.join(handoff_root(config), run_id, f"{session}-{nonce}.json")
        descriptor = {"schema": HANDOFF_SCHEMA, "status": "active", "mode": "authorized", "lifecycle": lifecycle, "completion_policy": TEMPORARY_COMPLETION_POLICY if lifecycle == TEMPORARY_LIFECYCLE else None, "completion_assessment": "not_assessed" if lifecycle == TEMPORARY_LIFECYCLE else None, "retention_decision": "retain_until_ai_assessment" if lifecycle == TEMPORARY_LIFECYCLE else None, "task_completion_signal": "not_received" if lifecycle == TEMPORARY_LIFECYCLE else None, "run_id": run_id, "requested_session": requested_session, "session": session, "automation_id": automation_id, "task_id": getattr(args, "task_id", None), "creation_binding": nonce if lifecycle == TEMPORARY_LIFECYCLE else None, "authority_scope": authority_scope if lifecycle == TEMPORARY_LIFECYCLE else None, "nonce": nonce, "authority_sha256": authority_digest, "authority_issued_at": authority.get("authority_issued_at"), "authority_lineage_expires_at": authority.get("authority_lineage_expires_at"), "authority_generation": 1, "authority_current_path": os.path.realpath(args.authority), "account_identity": authority["account_identity"], "origin": origin, "origins": sorted({normalize_origin(item) for item in allowed_origins}), "expires_at": authority["expires_at"], "watchdog_expires_at": authority.get("authority_lineage_expires_at") or authority["expires_at"], "profile": os.path.realpath(profile), "profile_hash": profile_hash(profile, nonce), "profile_marker_sha256": sha256_file(marker), "port": port, "daemon_session": session, "process": process_identity, "lock_paths": list(ctx["lock_paths"]), "room_id": ctx.get("room_id"), "lease_path": os.path.realpath(descriptor_path), "download_dir": os.path.realpath(download_dir), "human_completion_signal": "not_received", "readback_exit": readback_exit}
        json_atomic_no_replace(descriptor_path, descriptor)
        write_task_resume_checkpoint(config, descriptor, descriptor_path)
        ctx["descriptor_path"] = descriptor_path
        launch_handoff_watchdog(config, descriptor_path, run_id, session)
        print(json.dumps({"status": "handoff_ready", "descriptor": descriptor_path, "run_id": run_id, "requested_session": requested_session, "session": session, "session_socket_path_bytes": session_socket_path_bytes(config["roots"]["browser_use_home"], session), "nonce": nonce, "origin": origin, "human_completion_required": True, "human_completion_is_not_auth": True, "abandonment_watchdog": "bounded_to_expiry", "finalized": False}, sort_keys=True))
        return 0
    except (Blocker, OSError, subprocess.SubprocessError, ValueError, json.JSONDecodeError) as exc:
        failure = exc.code if isinstance(exc, Blocker) else "browser_use_runtime_error"
        daemon_cleanup_error: str | None = None
        if isinstance(ctx.get("port"), int):
            daemon_closed, daemon_cleanup_error = close_owned_daemon_if_active(
                config,
                config["roots"]["browser_use_home"],
                int(ctx["port"]),
                session,
            )
            if not daemon_closed:
                process_cleanup_ok = False
                failure = daemon_cleanup_error or "browser_use_daemon_cleanup_unverified"
        if chrome_proc is not None:
            daemon_cleanup_ok = process_cleanup_ok
            if process_identity is None:
                chrome_cleanup_ok, cleanup_error = False, "browser_use_process_identity_unavailable"
            else:
                try:
                    chrome_cleanup_ok, cleanup_error = terminate_chrome(chrome_proc, process_identity, config["executables"]["chrome"]["canonical_path"], int(ctx["port"]), profile)
                except Exception as cleanup_exc:
                    chrome_cleanup_ok, cleanup_error = False, _cleanup_failure_code(cleanup_exc)
            process_cleanup_ok = daemon_cleanup_ok and chrome_cleanup_ok
            if cleanup_error:
                process_cleanup_ok = False
            if process_cleanup_ok:
                ctx["process_terminated"] = True
                ctx["listener_absent"] = True
            if cleanup_error:
                failure = cleanup_error
        if process_cleanup_ok and chrome_proc is None and ctx.get("launch_attempted") is True and ctx.get("process_terminated") is not True:
            try:
                if not isinstance(ctx.get("port"), int):
                    raise Blocker("browser_use_process_identity_unavailable")
                verify_chrome_absent(
                    config["executables"]["chrome"]["canonical_path"],
                    int(ctx["port"]),
                    profile,
                )
            except Exception as cleanup_exc:
                process_cleanup_ok = False
                failure = _cleanup_failure_code(cleanup_exc)
        if process_cleanup_ok:
            ctx["process_terminated"] = True
            ctx["listener_absent"] = True
        ctx["process"] = process_identity or {}
        try:
            cleanup_result = _cleanup_login_handoff_failure(config, ctx, ctx.get("descriptor_path"), run_id, session, nonce, profile, download_dir, process_cleanup_ok, failure)
        except Blocker as cleanup_exc:
            failure = cleanup_exc.code
            cleanup_result = failure
        if cleanup_result:
            failure = cleanup_result
        print(json.dumps({"status": "blocked", "exact_blocker": failure, "diagnostic_detail": diagnostic_detail, "cleanup": ctx.get("cleanup", {}), "quarantine": ctx.get("quarantine"), "finalized": False}, sort_keys=True))
        return 1


def continue_handoff(args: argparse.Namespace) -> int:
    config = read_toml()
    # Runtime admission is provided by the canonical executable/root/hash/version
    # checks here, followed by descriptor-bound process, profile, lock, listener,
    # and post-command readback below.  Do not require a separate attestation
    # producer that is not part of this Browser Use lane.
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    if not args.human_complete:
        raise Blocker("browser_use_handoff_human_completion_signal_required")
    # Read the owner-bound lease even when the short command authority has
    # expired.  The same live Chrome/profile is still the only resumable
    # resource; renewal below is bounded by the original authority lineage.
    preview = read_handoff(config, args.descriptor, run_id, session, require_unexpired=False)
    require_temporary_task_id(args, preview)
    consumed_path = consume_handoff(config, args.descriptor, run_id, session)
    descriptor = read_handoff(config, consumed_path, run_id, session, require_unexpired=False)
    require_temporary_task_id(args, descriptor)
    authority_candidate = args.authority or descriptor.get("authority_current_path") or descriptor.get("authority_path")
    if not authority_candidate:
        raise Blocker("browser_use_authority_required")
    supplied_authority_path = assert_authority_file(str(authority_candidate))
    current_authority_path = assert_authority_file(str(descriptor.get("authority_current_path") or supplied_authority_path))
    current_authority = parse_authority(
        current_authority_path,
        run_id,
        session,
        aliases=session_aliases(config, descriptor.get("requested_session", session), session),
        require_unexpired=False,
    )
    supplied_digest = sha256_file(supplied_authority_path)
    accepted_digests = {str(descriptor.get("authority_sha256"))}
    previous_digest = current_authority.get("previous_authority_sha256")
    if isinstance(previous_digest, str):
        accepted_digests.add(previous_digest)
    if supplied_digest not in accepted_digests:
        raise Blocker("browser_use_handoff_authority_changed")
    if _handoff_authority_needs_renewal(descriptor):
        authority = renew_handoff_authority(config, consumed_path, descriptor)
    else:
        authority = authority_for_handoff(args.authority, run_id, session, descriptor, config)
    validate_handoff_identity(config, descriptor)
    command = list(args.command)
    if command and command[0] == "--":
        command = command[1:]
    if command and command[0] == "close":
        raise Blocker("browser_use_continue_close_requires_finalize")
    command, origins, _ = validate_command(command, "authorized", config, list(authority["allowed_origins"]), descriptor["download_dir"])
    if origins and descriptor["origin"] not in origins:
        raise Blocker("browser_use_handoff_origin_drift")
    code, readback_exit = run_cli_keep_alive(config, config["roots"]["browser_use_home"], descriptor["port"], session, command, True)
    if code != 0:
        raise Blocker("browser_use_command_failed", str(code))
    if readback_exit != 0:
        raise Blocker("browser_use_readback_failed", str(readback_exit))
    validate_handoff_process_identity(config, descriptor, allow_missing=False)
    owner_completion = owner_completion_receipt(
        descriptor,
        command=command,
        readback_exit=readback_exit,
    )
    descriptor["status"] = "continued"
    descriptor["human_completion_signal"] = "one_time_untrusted_signal_consumed"
    descriptor["human_completion_at"] = iso(now_utc())
    descriptor["owner_completion_receipt"] = owner_completion
    descriptor["owner_completion_state"] = "consumed_not_auth_proof"
    descriptor["last_command"] = command[0]
    descriptor["readback_exit"] = readback_exit
    update_handoff(consumed_path, descriptor)
    write_task_resume_checkpoint(config, descriptor, consumed_path)
    print(json.dumps({"status": "continued", "descriptor": consumed_path, "run_id": run_id, "session": session, "human_completion_signal": "consumed_not_auth_proof", "finalized": False}, sort_keys=True))
    return 0


def finalize_handoff(args: argparse.Namespace) -> int:
    config = read_toml()
    versions = validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    descriptor_path = os.path.realpath(args.descriptor)
    base_path = _handoff_base_path(descriptor_path)
    candidate = _select_cleanup_candidate(base_path)
    if candidate is None and _read_cleanup_complete(base_path, run_id, session):
        marker = read_json_safe(_cleanup_complete_path(base_path))
        if marker.get("lifecycle") == TEMPORARY_LIFECYCLE:
            if not getattr(args, "task_id", None) or marker.get("task_id") != args.task_id:
                raise Blocker("browser_use_temporary_task_id_required")
        nonce = marker.get("nonce")
        if not isinstance(nonce, str) or not safe_id(nonce, "nonce"):
            raise Blocker("browser_use_cleanup_completion_binding_mismatch")
        receipt_path = os.path.join(config["roots"]["receipts"], run_id, f"{session}-{nonce}.json")
        if not os.path.lexists(receipt_path):
            raise Blocker("browser_use_cleanup_completion_receipt_missing")
        print(json.dumps({"status": "completed", "receipt": receipt_path, "exact_blocker": None, "quarantine": None, "finalized": True}, sort_keys=True))
        return 0
    if candidate is None:
        raise Blocker("browser_use_handoff_missing")
    descriptor = read_handoff(config, candidate, run_id, session, require_unexpired=False)
    require_temporary_task_id(args, descriptor)
    cleanup_only = bool(getattr(args, "cleanup_only", False))
    require_temporary_delete_approval(
        descriptor,
        delete_approved=delete_approval_signal(args),
        cleanup_only=cleanup_only,
        preserve_temporary=bool(getattr(args, "preserve_temporary", False)),
    )
    if descriptor.get("lifecycle") == TEMPORARY_LIFECYCLE and getattr(args, "preserve_temporary", False):
        descriptor["retention_decision"] = "retain_temporary_profile"
        descriptor["task_completion_signal"] = "temporary_profile_preserve_requested"
        descriptor["profile_preservation_requested_at"] = iso(now_utc())
        update_handoff(candidate, descriptor)
    if descriptor.get("lifecycle") == TEMPORARY_LIFECYCLE and delete_approval_signal(args):
        descriptor["completion_assessment"] = "ai_judged_complete"
        descriptor["retention_decision"] = "delete_approved"
        descriptor["task_completion_signal"] = "delete_approval_received"
        descriptor["delete_approval_at"] = iso(now_utc())
        update_handoff(candidate, descriptor)
    write_task_resume_checkpoint(
        config,
        descriptor,
        candidate,
        state="claimed",
        next_action="finish the exact handoff cleanup and read back process, listener, profile, download, locks, and room",
        restart_point="same descriptor while cleanup is in progress; no browser command is dispatched",
    )
    ctx: dict[str, Any] = {"mode": "authorized", "lifecycle": str(descriptor.get("lifecycle", "single-use")), "run_id": run_id, "requested_session": descriptor.get("requested_session", session), "session": session, "automation_id": descriptor["automation_id"], "task_id": descriptor.get("task_id"), "creation_binding": descriptor.get("creation_binding"), "authority_sha256": descriptor.get("authority_sha256"), "authority_scope": descriptor.get("authority_scope"), "nonce": descriptor["nonce"], "started_at": descriptor.get("started_at", iso(now_utc())), "lock_paths": descriptor["lock_paths"], "cleanup": {}, "profile": descriptor["profile"], "download_dir": descriptor["download_dir"], "port": descriptor["port"], "process": descriptor["process"], "profile_hash": descriptor["profile_hash"], "target_origins": descriptor.get("origins", [descriptor["origin"]]), "account_identity": descriptor.get("account_identity", "authorized"), "authority_summary": {"data_exposure": "authorized", "side_effect_scope": "bounded_by_authority", "approval": "approved"}, "readback_required": True, "config": config, "room_id": descriptor.get("room_id")}
    failure: str | None = None
    try:
        result = cleanup_abandoned_handoff(
            config,
            base_path,
            run_id,
            session,
            require_expired=False,
            preserve_temporary=bool(getattr(args, "preserve_temporary", False)),
        )
        ctx["cleanup"] = result
    except (Blocker, OSError, subprocess.SubprocessError, ValueError, json.JSONDecodeError) as exc:
        failure = exc.code if isinstance(exc, Blocker) else "browser_use_runtime_error"
        _record_context_cleanup_pending(ctx, failure)
        write_task_resume_checkpoint(
            config,
            descriptor,
            candidate,
            state="cleanup_pending",
            exact_blocker=failure,
            next_action="reconcile the exact cleanup-pending handoff before starting another handoff",
            restart_point="same task_id after cleanup readback; prior login state is not assumed",
        )
    else:
        write_task_resume_checkpoint(
            config,
            descriptor,
            candidate,
            state="cleanup_complete",
            exact_blocker=None,
            next_action="create a new authorized handoff for the same task_id when continuing the work",
            restart_point="old descriptor is cleanup-complete; prior cookies/profile are not assumed",
        )
    receipt_path = finalized_receipt(config, versions, ctx, failure)
    print(json.dumps({"status": "blocked" if failure else "completed", "receipt": receipt_path, "exact_blocker": failure, "quarantine": ctx.get("quarantine"), "finalized": not failure}, sort_keys=True))
    return 1 if failure else 0


def _cleanup_execute_failure(config: dict[str, Any], ctx: dict[str, Any], chrome_proc: subprocess.Popen[bytes] | None, lifecycle: str) -> str | None:
    # A recording started from a login handoff borrows the handoff's Chrome,
    # profile, download directory, and locks. Never quarantine or release
    # those shared resources on a recording-start failure; the handoff owner
    # remains responsible for their eventual cleanup.
    if ctx.get("owned_chrome") is False:
        ctx.setdefault("cleanup", {})["shared_handoff_preserved"] = True
        return None
    process_cleanup_ok = True
    cleanup_error: str | None = None
    home = ctx.get("home") or config["roots"]["browser_use_home"]
    session = ctx.get("session")
    port = ctx.get("port")
    if isinstance(session, str) and isinstance(port, int):
        daemon_closed, daemon_error = close_owned_daemon_if_active(config, home, port, session)
        if not daemon_closed:
            _record_context_cleanup_pending(ctx, daemon_error or "browser_use_daemon_cleanup_unverified")
            return daemon_error or "browser_use_daemon_cleanup_unverified"
    if chrome_proc is not None:
        try:
            process_cleanup_ok, cleanup_error = terminate_chrome(chrome_proc, ctx.get("process"), config["executables"]["chrome"]["canonical_path"], ctx.get("port", 0), ctx.get("profile", ""))
        except Exception as exc:
            process_cleanup_ok, cleanup_error = False, _cleanup_failure_code(exc)
        if cleanup_error:
            process_cleanup_ok = False
        if process_cleanup_ok:
            ctx["process_terminated"] = True
            ctx["listener_absent"] = True
    else:
        # A launch that was never attempted has no process/listener to clean.
        # Once launch was attempted, however, a missing Popen object is not
        # proof of absence; verify the exact process and listener before
        # allowing any profile or lock cleanup.
        if ctx.get("process_terminated") is True and ctx.get("listener_absent") is True:
            pass
        elif ctx.get("launch_attempted") is True:
            try:
                if not isinstance(ctx.get("port"), int) or not ctx.get("profile"):
                    raise Blocker("browser_use_process_identity_unavailable")
                verify_chrome_absent(
                    config["executables"]["chrome"]["canonical_path"],
                    int(ctx["port"]),
                    str(ctx["profile"]),
                )
            except Exception as exc:
                process_cleanup_ok, cleanup_error = False, _cleanup_failure_code(exc)
            else:
                ctx["process_terminated"] = True
                ctx["listener_absent"] = True
        else:
            ctx["process_terminated"] = True
            ctx["listener_absent"] = True
    if not process_cleanup_ok:
        _record_context_cleanup_pending(ctx, cleanup_error or "browser_use_cleanup_uncertain")
        return cleanup_error or "browser_use_cleanup_uncertain"

    download_dir = ctx.get("download_dir")
    if isinstance(download_dir, str) and os.path.lexists(download_dir):
        try:
            removed = cleanup_empty_download_dir(download_dir, config["roots"]["downloads"])
        except Exception as exc:
            cleanup_error = _cleanup_failure_code(exc)
            _record_context_cleanup_pending(ctx, cleanup_error)
            return cleanup_error
        ctx.setdefault("cleanup", {})["download_dir_removed"] = removed
        if not removed:
            ctx["cleanup"]["download_dir_retained"] = "non_empty"

    quarantine_ok = True
    if lifecycle == "single-use":
        # A single-use launch can fail before room/profile creation (for
        # example, an invalid readback artifact directory). In that case
        # there is nothing to quarantine. Do not replace the original
        # pre-launch blocker with a misleading lifecycle error.
        if ctx.get("profile") and os.path.lexists(ctx["profile"]):
            try:
                ctx["quarantine"] = quarantine_profile(config, ctx["profile"], ctx)
            except Exception as exc:
                cleanup_error = _cleanup_failure_code(exc)
                ctx["quarantine"] = "quarantine_pending"
                quarantine_ok = False
    elif lifecycle == TEMPORARY_LIFECYCLE:
        if ctx.get("profile") and os.path.lexists(ctx["profile"]):
            shared_marker_digest = ctx.get("shared_profile_marker_sha256")
            if shared_marker_digest:
                marker_path = os.path.join(str(ctx["profile"]), ".browser-use-profile.json")
                if not os.path.lexists(marker_path) or sha256_file(marker_path) != shared_marker_digest:
                    cleanup_error = "browser_use_shared_profile_marker_changed"
                    quarantine_ok = False
                else:
                    ctx.setdefault("cleanup", {})["shared_profile_preserved"] = True
            else:
                ctx.setdefault("cleanup", {})["temporary_profile_preserved"] = True
        elif ctx.get("profile") and ctx.get("profile_created") is not False:
            cleanup_error = "browser_use_temporary_profile_missing_after_cleanup"
            quarantine_ok = False
    elif lifecycle != "scheduled":
        cleanup_error = "browser_use_lifecycle_invalid"
        quarantine_ok = False
    if not quarantine_ok:
        _record_context_cleanup_pending(ctx, cleanup_error or "browser_use_cleanup_uncertain")
        return cleanup_error or "browser_use_cleanup_uncertain"
    if ctx.get("cleanup", {}).get("state") == "uncertain":
        return str(ctx["cleanup"].get("exact_blocker") or "browser_use_cleanup_uncertain")
    released, release_error = _release_locks_after_verified_cleanup(ctx, ctx["run_id"], ctx["nonce"])
    if not released:
        return release_error or "browser_use_cleanup_uncertain"
    return None


def execute(args: argparse.Namespace) -> int:
    if args.lifecycle == TEMPORARY_LIFECYCLE and args.mode != "authorized":
        raise Blocker("browser_use_temporary_requires_authorized_mode")
    if args.lifecycle == TEMPORARY_LIFECYCLE and not getattr(args, "task_id", None):
        raise Blocker("browser_use_temporary_task_id_required")
    config = read_toml()
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    automation_id = safe_id(args.automation_id, "automation_id")
    nonce = uuid.uuid4().hex
    shared_lease: dict[str, Any] | None = None
    shared_lease_path: str | None = None
    ctx: dict[str, Any] = {"mode": args.mode, "lifecycle": args.lifecycle, "run_id": run_id, "requested_session": requested_session, "session": session, "automation_id": automation_id, "nonce": nonce, "started_at": iso(now_utc()), "lock_paths": [], "cleanup": {}, "profile_created": False, "launch_attempted": False, "config": config}
    versions: dict[str, Any] = {}
    failure: str | None = None
    chrome_proc: subprocess.Popen[bytes] | None = None
    try:
        versions = validate_installation(config)
        configure_logging(config["roots"]["logs"])
        authority: dict[str, Any] | None = None
        if args.mode == "authorized":
            if not args.authority:
                raise Blocker("browser_use_authority_required")
            authority = parse_authority(args.authority, run_id, session, aliases=session_aliases(config, requested_session, session))
        shared_lease_arg = getattr(args, "shared_lease", None)
        if shared_lease_arg:
            if args.mode != "authorized" or args.lifecycle != TEMPORARY_LIFECYCLE:
                raise Blocker("browser_use_shared_profile_requires_authorized_temporary")
            if authority is None:
                raise Blocker("browser_use_authority_required")
            shared_lease_path = os.path.realpath(str(shared_lease_arg))
            shared_lease = read_shared_profile_lease(
                config,
                shared_lease_path,
                run_id=run_id,
                session=session,
                task_id=args.task_id,
                authority=authority,
            )
        if args.mode == "public" and args.lifecycle != "single-use":
            raise Blocker("browser_use_public_requires_single_use")
        allowed_origins = args.allowed_origin if args.mode == "public" else authority["allowed_origins"]
        if not allowed_origins:
            raise Blocker("browser_use_allowed_origins_required")
        if args.lifecycle == "scheduled" and args.automation_id == "manual":
            raise Blocker("browser_use_scheduled_automation_id_required")
        if args.lifecycle == "single-use" and args.port is not None and not (config["ports"]["single_use_start"] <= args.port <= config["ports"]["single_use_end"]):
            raise Blocker("browser_use_single_use_port_out_of_range")
        if args.lifecycle == "scheduled" and args.port is not None and not (config["ports"]["scheduled_start"] <= args.port <= config["ports"]["scheduled_end"]):
            raise Blocker("browser_use_scheduled_port_out_of_range")
        if args.lifecycle not in {"single-use", "scheduled", TEMPORARY_LIFECYCLE}:
            raise Blocker("browser_use_lifecycle_invalid")
        authority_scope = temporary_authority_scope(authority) if args.lifecycle == TEMPORARY_LIFECYCLE else None
        if shared_lease is not None:
            if args.port is not None and int(args.port) != int(shared_lease["port"]):
                raise Blocker("browser_use_shared_profile_port_mismatch")
            nonce = str(shared_lease["nonce"])
            port = int(shared_lease["port"])
        elif args.lifecycle == TEMPORARY_LIFECYCLE:
            nonce = temporary_binding(mode=args.mode, lifecycle=args.lifecycle, automation_id=automation_id, task_id=args.task_id, run_id=run_id, authority_digest=sha256_file(args.authority), authority_scope=authority_scope or {}, account_identity=authority["account_identity"], origins=list(authority["allowed_origins"]))
            port = args.port
        else:
            port = args.port
        ctx["port"] = port
        ctx["task_id"] = getattr(args, "task_id", None)
        ctx["creation_binding"] = nonce if args.lifecycle == TEMPORARY_LIFECYCLE else None
        ctx["authority_scope"] = authority_scope
        ctx["account_identity"] = authority["account_identity"] if authority else "public"
        ctx["readback_required"] = bool(authority["readback_required"]) if authority else True
        ctx["authority_summary"] = {"data_exposure": authority["data_exposure"], "side_effect_scope": authority["side_effect_scope"], "approval": authority["approval"]} if authority else {"data_exposure": "public_read_only", "side_effect_scope": "none", "approval": "not_required"}
        ctx["home"] = config["roots"]["browser_use_home"]
        if shared_lease is not None:
            profile = os.path.realpath(str(shared_lease["profile"]))
            download_dir = os.path.join(config["roots"]["downloads"], f"temporary-{run_id}-{nonce[:32]}")
        elif args.lifecycle == TEMPORARY_LIFECYCLE:
            profile = temporary_profile_path(config, nonce)
            download_dir = os.path.join(config["roots"]["downloads"], f"temporary-{nonce[:32]}")
        else:
            profile_parent = config["roots"]["scheduled_profiles"] if args.lifecycle == "scheduled" else config["roots"]["single_use_profiles"]
            profile = os.path.join(profile_parent, automation_id if args.lifecycle == "scheduled" else f"{run_id}-{nonce}") if args.lifecycle == "scheduled" else None
            download_dir = os.path.join(config["roots"]["downloads"], f"{run_id}-{nonce}")
        ctx["profile"], ctx["download_dir"] = profile, download_dir
        ctx["shared_profile_lease_path"] = shared_lease_path
        ctx["shared_profile_marker_sha256"] = shared_lease.get("profile_marker_sha256") if shared_lease is not None else None
        ctx["profile_owner_task_id"] = shared_lease.get("source_task_id") if shared_lease is not None else None
        ctx["profile_owner_authority_scope"] = shared_lease.get("profile_owner_authority_scope") if shared_lease is not None else None
        if args.lifecycle == TEMPORARY_LIFECYCLE:
            ctx["room_terminal_cleanup"] = True
        if shared_lease is not None:
            ctx["lock_paths"] = [os.path.realpath(str(item)) for item in shared_lease["lock_paths"]]
        ctx["profile_hash"] = profile_hash(profile, nonce) if profile else None
        command_args = list(args.command)
        if command_args and command_args[0] == "--":
            command_args = command_args[1:]
        command, origins, uploads = validate_command(command_args, args.mode, config, list(allowed_origins), download_dir)
        for upload in uploads:
            upload["destination"] = origins[0] if origins else "authorized_browser_origin"
        ctx["target_origins"], ctx["uploads"], ctx["preflight"] = origins, uploads, True
        post_commands: list[list[str]] = []
        if args.post_command_json:
            try:
                raw_post_commands = json.loads(args.post_command_json)
            except (TypeError, ValueError, json.JSONDecodeError) as exc:
                raise Blocker("browser_use_post_commands_json_invalid") from exc
            if not isinstance(raw_post_commands, list) or len(raw_post_commands) > 8:
                raise Blocker("browser_use_post_commands_invalid")
            artifact_dir = os.path.realpath(str(args.artifact_dir or ""))
            assert_directory(artifact_dir)
            for raw_post in raw_post_commands:
                if not isinstance(raw_post, list) or not raw_post or not isinstance(raw_post[0], str):
                    raise Blocker("browser_use_post_command_invalid")
                post_command, _, _ = validate_command([str(value) for value in raw_post], args.mode, config, list(allowed_origins), download_dir)
                if post_command[0] not in {"state", "screenshot", "get", "eval", "extract"}:
                    raise Blocker("browser_use_post_command_not_read_only")
                if post_command[0] == "eval":
                    if len(post_command) != 2 or post_command[1] not in {"location.href", "document.title"}:
                        raise Blocker("browser_use_post_eval_not_allowlisted")
                if post_command[0] == "screenshot":
                    if len(post_command) != 2:
                        raise Blocker("browser_use_post_screenshot_path_required")
                    post_command[1] = validate_capture_path(post_command[1], artifact_dir)
                post_commands.append(post_command)
            ctx["post_commands"] = [{"name": item[0], "argument_count": max(0, len(item) - 1)} for item in post_commands]
        room = room_registry_claim(
            config,
            lifecycle=args.lifecycle,
            run_id=run_id,
            profile=profile if args.lifecycle != "single-use" else None,
            port=port,
            task_id=getattr(args, "task_id", None),
            automation_id=automation_id,
            activity=f"execute-{command[0]}",
        )
        ctx["room_id"] = room["room_id"]
        profile, port = room["profile"], room["port"]
        ctx["profile"], ctx["port"] = profile, port
        ctx["profile_hash"] = profile_hash(profile, nonce)
        if args.lifecycle == TEMPORARY_LIFECYCLE:
            if shared_lease is None:
                temp_info = prepare_temporary_profile(config, mode=args.mode, automation_id=automation_id, task_id=args.task_id, run_id=run_id, authority_digest=sha256_file(args.authority), authority_scope=authority_scope or {}, account_identity=authority["account_identity"], origins=list(authority["allowed_origins"]), download_dir=download_dir, requested_port=port)
                ctx["lock_paths"].append(temp_info["profile_lock"])
                ctx["profile_created"] = True
        else:
            prepare_profile(profile, args.lifecycle == "scheduled", automation_id, download_dir, run_id, nonce)
        if os.path.exists(download_dir):
            raise Blocker("browser_use_download_directory_collision")
        os.mkdir(download_dir, 0o700)
        assert_directory(download_dir)
        profile_lock_name = hashlib.sha256(os.path.realpath(profile).encode()).hexdigest()[:24]
        profile_lock = temporary_profile_lock_path(config, profile) if args.lifecycle == TEMPORARY_LIFECYCLE else os.path.join(config["roots"]["locks"], f"profile-{profile_lock_name}.lock")
        port_lock = os.path.join(config["roots"]["locks"], f"port-{port}.lock")
        payload = {"schema": "browser-use-lock.v1", "run_id": run_id, "nonce": nonce, "helper_pid": os.getpid(), "helper_start_time": psutil.Process(os.getpid()).create_time(), "automation_id": automation_id, "port": port, "canonical_profile": os.path.realpath(profile)}
        if args.lifecycle != TEMPORARY_LIFECYCLE:
            lock_file(profile_lock, payload)
            ctx["lock_paths"].append(profile_lock)
        elif shared_lease is None:
            lock_file(port_lock, payload)
            ctx["lock_paths"].append(port_lock)
        ctx["launch_attempted"] = True
        chrome_proc, process = launch_chrome(config, profile, port, download_dir, ctx["home"])
        annotate_lock_process_identity(ctx["lock_paths"], run_id, nonce, process)
        ctx["process"] = process
        ctx["listener_verified"] = True
        ctx["process_identity_verified"] = True
        if post_commands:
            code, readback_exit, captured_readback = run_cli_with_post_commands(
                config,
                ctx["home"],
                port,
                session,
                command,
                ctx["readback_required"],
                post_commands,
            )
            ctx["captured_readback"] = captured_readback
        else:
            code, readback_exit = run_cli(config, ctx["home"], port, session, command, ctx["readback_required"])
        ctx["readback_exit"] = readback_exit
        ctx["downloads"] = scan_downloads(download_dir, config["limits"]["max_download_bytes"])
        if code != 0:
            raise Blocker("browser_use_command_failed", str(code))
        if ctx["readback_required"] and readback_exit != 0:
            raise Blocker("browser_use_readback_failed", str(readback_exit))
        ok, cleanup_error = terminate_chrome(chrome_proc, process, config["executables"]["chrome"]["canonical_path"], port, profile)
        chrome_proc = None
        if not ok or cleanup_error:
            raise Blocker(cleanup_error or "browser_use_chrome_cleanup_failed")
        ctx["process_terminated"] = True
        ctx["listener_absent"] = True
        if cleanup_empty_download_dir(download_dir, config["roots"]["downloads"]):
            ctx["cleanup"]["download_dir_removed"] = True
        else:
            ctx["cleanup"]["download_dir_retained"] = "non_empty"
        if args.lifecycle == "single-use":
            assert_owned_locks(ctx["lock_paths"], run_id, nonce)
            cleanup_exact_profile(profile, config["roots"]["single_use_profiles"], run_id, nonce)
            ctx["cleanup"]["profile_removed"] = True
        elif args.lifecycle == TEMPORARY_LIFECYCLE:
            if not os.path.lexists(profile):
                raise Blocker("browser_use_temporary_profile_missing_after_execute")
            ctx["cleanup"]["temporary_profile_preserved"] = True
        elif args.lifecycle != "scheduled":
            raise Blocker("browser_use_lifecycle_invalid")
        released, release_error = _release_locks_after_verified_cleanup(ctx, run_id, nonce)
        if not released:
            raise Blocker(release_error or "browser_use_cleanup_uncertain")
    except Blocker as exc:
        failure = exc.code
        logging.critical("browser_use_blocked code=%s", exc.code)
        cleanup_failure = _cleanup_execute_failure(config, ctx, chrome_proc, args.lifecycle)
        if cleanup_failure:
            failure = cleanup_failure
    except (OSError, subprocess.SubprocessError, ValueError, json.JSONDecodeError) as exc:
        failure = "browser_use_runtime_error"
        logging.critical("browser_use_runtime_error type=%s", type(exc).__name__)
        cleanup_failure = _cleanup_execute_failure(config, ctx, chrome_proc, args.lifecycle)
        if cleanup_failure:
            failure = cleanup_failure
    receipt_path = finalized_receipt(config, versions, ctx, failure)
    print(json.dumps({"status": "blocked" if failure else "completed", "receipt": receipt_path, "exact_blocker": failure, "finalized": failure is None, "captured_readback": ctx.get("captured_readback", {})}, sort_keys=True))
    return 1 if failure else 0


def verified_stale_temporary_lock_set(config: dict[str, Any], marker: dict[str, Any], profile: str, port: int) -> tuple[list[str], bool]:
    """Return the exact stale lock set and whether it can be adopted.

    Expired profiles used to remain forever when their previous helper died
    after creating locks.  Janitor may adopt such locks only when both exact
    expected files exist and every field still binds to the profile marker;
    partial or foreign locks remain a hard skip.
    """
    lock_paths = [
        os.path.realpath(marker["profile_lock_path"]),
        os.path.realpath(marker["port_lock_path"]),
    ]
    locks_root = os.path.realpath(config["roots"]["locks"])
    if any(os.path.dirname(path) != locks_root for path in lock_paths):
        raise Blocker("browser_use_temporary_lock_scope_mismatch")
    existing = [path for path in lock_paths if os.path.lexists(path)]
    if not existing:
        return lock_paths, False
    if len(existing) != len(lock_paths):
        raise Blocker("browser_use_temporary_lock_set_incomplete")
    expected = {
        "run_id": marker["run_id"],
        "nonce": marker["creation_binding"],
        "port": int(port),
        "canonical_profile": os.path.realpath(profile),
    }
    for path in lock_paths:
        value = read_json_safe(path)
        if value.get("schema") != "browser-use-lock.v1" or any(value.get(key) != expected_value for key, expected_value in expected.items()):
            raise Blocker("browser_use_temporary_lock_owner_mismatch")
    return lock_paths, True


def janitor(config: dict[str, Any]) -> int:
    validate_installation(config)
    temporary_root = os.path.realpath(config["roots"]["temporary_profiles"])
    temporary_removed = 0
    skipped: list[dict[str, str]] = []
    for entry in pathlib.Path(temporary_root).iterdir():
        if entry.is_symlink() or not entry.is_dir() or os.path.realpath(entry.parent) != temporary_root:
            continue
        profile = os.path.realpath(str(entry))
        try:
            marker = read_json_safe(os.path.join(profile, ".browser-use-profile.json"))
            expected = {field: marker.get(field) for field in ("mode", "lifecycle", "automation_id", "task_id", "run_id", "creation_binding", "canonical_profile", "port", "authority_sha256", "authority_scope", "account_identity", "origins")}
            validate_temporary_marker(config, profile, expected, require_unexpired=False)
            if marker.get("retention_mode", TEMPORARY_RETENTION_RUN_TTL) == TEMPORARY_RETENTION_MANUAL:
                # Explicitly retained authenticated profiles are user-managed;
                # only an owner-bound cleanup with delete approval may remove
                # them. They must never be reclaimed by the TTL janitor.
                continue
            if _parse_temporary_time(marker["expires_at"], "expires_at") > now_utc():
                continue
            port = int(marker["port"])
            if port_listener(port) or lsof_listener(port):
                skipped.append({"profile": profile, "reason": "browser_use_temporary_listener_active"})
                continue
            active = False
            if psutil is not None:
                for process in psutil.process_iter(["cmdline"]):
                    try:
                        command_line = process.info.get("cmdline") or []
                        if f"--user-data-dir={profile}" in command_line or f"--remote-debugging-port={port}" in command_line:
                            active = True
                            break
                    except (psutil.Error, OSError):
                        active = True
                        break
            if active:
                skipped.append({"profile": profile, "reason": "browser_use_temporary_process_active_or_unknown"})
                continue
            lock_paths, adopted_locks = verified_stale_temporary_lock_set(config, marker, profile, port)
            payload = {"schema": "browser-use-lock.v1", "run_id": marker["run_id"], "nonce": marker["creation_binding"], "helper_pid": os.getpid(), "helper_start_time": psutil.Process(os.getpid()).create_time(), "automation_id": marker["automation_id"], "task_id": marker["task_id"], "port": port, "canonical_profile": profile, "lifecycle": TEMPORARY_LIFECYCLE, "janitor": True}
            acquired: list[str] = []
            created_by_janitor: list[str] = []
            cleanup_succeeded = False
            try:
                if adopted_locks:
                    acquired = list(lock_paths)
                else:
                    for path in lock_paths:
                        lock_file(path, payload)
                        acquired.append(path)
                        created_by_janitor.append(path)
                descriptor = {"mode": marker["mode"], "lifecycle": TEMPORARY_LIFECYCLE, "automation_id": marker["automation_id"], "task_id": marker["task_id"], "run_id": marker["run_id"], "creation_binding": marker["creation_binding"], "profile": profile, "port": port, "authority_sha256": marker["authority_sha256"], "authority_scope": marker["authority_scope"], "account_identity": marker["account_identity"], "origins": marker["origins"], "target_origins": marker["origins"], "nonce": marker["creation_binding"], "lock_paths": lock_paths, "cleanup_state": {}}
                cleanup_temporary_profile(config, descriptor, process_verified=True)
                cleanup_succeeded = True
                temporary_removed += 1
            finally:
                # Adopted stale locks are retained if profile deletion is
                # uncertain.  Release them only after successful deletion;
                # freshly-created janitor locks retain the historical
                # retryable behavior on a failed cleanup.
                release_paths = created_by_janitor + (lock_paths if adopted_locks and cleanup_succeeded else [])
                for path in release_paths:
                    try:
                        release_lock(path, marker["run_id"], marker["creation_binding"])
                    except Exception:
                        skipped.append({"profile": profile, "reason": "browser_use_temporary_janitor_lock_release_uncertain"})
        except (Blocker, KeyError, ValueError, OSError) as exc:
            skipped.append({"profile": profile, "reason": exc.code if isinstance(exc, Blocker) else "browser_use_temporary_profile_unverified"})

    root = config["roots"]["quarantine"]
    removed = 0
    for entry in pathlib.Path(root).iterdir():
        if entry.is_symlink() or not entry.is_dir() or os.path.realpath(entry.parent) != os.path.realpath(root):
            continue
        marker_path = entry / ".quarantine.json"
        try:
            marker = read_json_safe(str(marker_path))
            expires = dt.datetime.fromisoformat(str(marker["expires_at"]).replace("Z", "+00:00"))
            if expires > now_utc():
                continue
            if marker.get("owner_uid") != EUID or marker.get("quarantine_path") != os.path.realpath(str(entry)):
                continue
            canonical_profile = marker.get("canonical_profile")
            if not isinstance(canonical_profile, str) or not os.path.isabs(canonical_profile) or os.path.realpath(canonical_profile) != canonical_profile:
                continue
            profile_marker = read_json_safe(str(entry / ".browser-use-profile.json"))
            if profile_marker.get("run_id") != marker.get("run_id") or profile_marker.get("nonce") != marker.get("nonce"):
                continue
            pid = marker.get("related_pid")
            start = marker.get("related_start_time")
            if pid and psutil:
                try:
                    process = psutil.Process(int(pid))
                    if start and abs(process.create_time() - float(start)) < 0.5:
                        continue
                except psutil.NoSuchProcess:
                    pass
            if port_listener(int(marker.get("port", 0))) or lsof_listener(int(marker.get("port", 0))):
                continue
            lock_paths = marker.get("lock_paths", [])
            if any(os.path.exists(path) for path in lock_paths):
                continue
            assert_directory(str(entry))
            shutil.rmtree(entry)
            removed += 1
        except (Blocker, KeyError, ValueError, OSError):
            continue
    print(json.dumps({"status": "completed", "removed": removed, "temporary_removed": temporary_removed, "skipped": skipped, "finalized": True}, sort_keys=True))
    return 0


def reconcile_failed_startup(args: argparse.Namespace) -> int:
    """Reconcile one run-owned single-use launch that produced no descriptor.

    This is intentionally narrower than recording finalization: it accepts
    only the exact profile lock created by the failed run, proves the profile
    marker and lock binding, proves that the exact Chrome profile/port has no
    process or listener, then quarantines the profile and releases only locks
    positively owned by that run.  It never terminates a process and never
    touches a foreign port lock.
    """
    config = read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    profile = os.path.realpath(args.profile)
    profile_root = os.path.realpath(config["roots"]["single_use_profiles"])
    if not os.path.isabs(args.profile) or profile != args.profile or not profile.startswith(profile_root + os.sep):
        raise Blocker("browser_use_profile_cleanup_scope_mismatch")
    profile_lock = os.path.realpath(args.profile_lock)
    locks_root = os.path.realpath(config["roots"]["locks"])
    expected_profile_lock = os.path.join(locks_root, f"profile-{hashlib.sha256(profile.encode()).hexdigest()[:24]}.lock")
    if not os.path.isabs(args.profile_lock) or profile_lock != args.profile_lock or profile_lock != expected_profile_lock:
        raise Blocker("browser_use_lock_cleanup_scope_mismatch")
    if not isinstance(args.port, int) or not (config["ports"]["single_use_start"] <= args.port <= config["ports"]["single_use_end"]):
        raise Blocker("browser_use_recording_port_out_of_range")
    quarantine_path = os.path.join(os.path.realpath(config["roots"]["quarantine"]), os.path.basename(profile))
    if not os.path.lexists(profile_lock) and os.path.isdir(quarantine_path):
        quarantine_marker_path = os.path.join(quarantine_path, ".quarantine.json")
        assert_regular_file(quarantine_marker_path, mode=0o600)
        quarantine_marker = read_json_safe(quarantine_marker_path)
        if (
            quarantine_marker.get("schema") != "browser-use-quarantine.v1"
            or quarantine_marker.get("run_id") != run_id
            or quarantine_marker.get("canonical_profile") != profile
            or quarantine_marker.get("port") != args.port
        ):
            raise Blocker("browser_use_quarantine_binding_mismatch")
        nonce = safe_id(quarantine_marker.get("nonce"), "nonce")
        if not os.path.lexists(os.path.join(quarantine_path, ".browser-use-profile.json")):
            raise Blocker("browser_use_quarantine_profile_marker_missing")
        verify_chrome_absent(config["executables"]["chrome"]["canonical_path"], args.port, profile)
        receipt = {
            "schema": "browser-use-startup-reconciliation.v1",
            "status": "completed",
            "run_id": run_id,
            "nonce": nonce,
            "profile": profile,
            "quarantine_path": quarantine_path,
            "port": args.port,
            "process_absent": True,
            "listener_absent": True,
            "locks_removed": list(quarantine_marker.get("lock_paths") or []),
            "foreign_port_lock_retained": True,
            "recovery_reason": "already_quarantined",
        }
        receipt_path = os.path.join(config["roots"]["receipts"], f"{run_id}-startup-reconciliation-{nonce}.json")
        if os.path.lexists(receipt_path):
            existing = read_json_safe(receipt_path)
            if existing != receipt:
                raise Blocker("browser_use_receipt_binding_mismatch")
        else:
            json_atomic_no_replace(receipt_path, receipt)
        print(json.dumps({"status": "completed", "receipt": receipt_path, **receipt}, sort_keys=True))
        return 0
    assert_regular_file(profile_lock, mode=0o600)
    lock_value = read_json_safe(profile_lock)
    if lock_value.get("schema") != "browser-use-lock.v1" or lock_value.get("run_id") != run_id or lock_value.get("canonical_profile") != profile or int(lock_value.get("port", -1)) != args.port:
        raise Blocker("browser_use_lock_owner_recheck_failed")
    nonce = safe_id(lock_value.get("nonce"), "nonce")
    if not os.path.isdir(profile):
        raise Blocker("browser_use_profile_missing")
    marker_path = os.path.join(profile, ".browser-use-profile.json")
    assert_regular_file(marker_path, mode=0o600)
    marker = read_json_safe(marker_path)
    if marker.get("schema") != "browser-use-profile.v1" or marker.get("run_id") != run_id or marker.get("nonce") != nonce:
        raise Blocker("browser_use_profile_marker_binding_mismatch")
    port_lock = os.path.join(locks_root, f"port-{args.port}.lock")
    lock_paths = [profile_lock]
    foreign_port_lock = False
    if os.path.lexists(port_lock):
        assert_regular_file(port_lock, mode=0o600)
        port_value = read_json_safe(port_lock)
        if port_value.get("run_id") == run_id and port_value.get("nonce") == nonce and port_value.get("canonical_profile") == profile:
            lock_paths.append(port_lock)
        else:
            foreign_port_lock = True
    verify_chrome_absent(config["executables"]["chrome"]["canonical_path"], args.port, profile)
    ctx = {
        "run_id": run_id,
        "session": f"startup-reconcile-{run_id}",
        "nonce": nonce,
        "process": {},
        "port": args.port,
        "profile": profile,
        "lock_paths": lock_paths,
        "process_terminated": True,
        "listener_absent": True,
    }
    quarantine_path = quarantine_profile(config, profile, ctx)
    released_ok, release_error, released = _release_lock_set(lock_paths, run_id, nonce)
    if not released_ok:
        raise Blocker(release_error or "browser_use_cleanup_uncertain")
    receipt = {
        "schema": "browser-use-startup-reconciliation.v1",
        "status": "completed",
        "run_id": run_id,
        "nonce": nonce,
        "profile": profile,
        "quarantine_path": quarantine_path,
        "port": args.port,
        "process_absent": True,
        "listener_absent": True,
        "locks_removed": released,
        "foreign_port_lock_retained": foreign_port_lock,
    }
    receipt_path = os.path.join(config["roots"]["receipts"], f"{run_id}-startup-reconciliation-{nonce}.json")
    json_atomic_no_replace(receipt_path, receipt)
    print(json.dumps({"status": "completed", "receipt": receipt_path, **receipt}, sort_keys=True))
    return 0


SINGLE_USE_EXECUTE_RECONCILIATION_SCHEMA = "browser-use-single-use-execute-reconciliation.v1"


def _single_use_execute_room(config: dict[str, Any], *, room_id: str, run_id: str, profile: str, port: int) -> dict[str, Any]:
    """Require the failed one-shot room to remain positively run-owned."""
    if not isinstance(room_id, str) or not room_id.startswith("room-"):
        raise Blocker("browser_use_single_use_execute_room_id_invalid")
    ledger = room_registry_read(config)
    room = next((item for item in ledger["rooms"] if item.get("room_id") == room_id), None)
    owner = room.get("owner") if isinstance(room, dict) and isinstance(room.get("owner"), dict) else {}
    if (
        room is None
        or room.get("lifecycle") != "single-use"
        or room.get("state") not in ROOM_REGISTRY_ACTIVE_STATES
        or room.get("profile") != profile
        or room.get("port") != port
        or owner.get("kind") != "task"
        or owner.get("id") != run_id
        or room.get("task_id") != run_id
        or room.get("lease_digest") != hashlib.sha256(run_id.encode("utf-8")).hexdigest()
    ):
        raise Blocker("browser_use_single_use_execute_room_owner_conflict")
    return room


def _single_use_execute_lock(lock_path: str, *, run_id: str, profile: str, port: int) -> dict[str, Any]:
    assert_regular_file(lock_path, mode=0o600)
    value = read_json_safe(lock_path)
    if (
        value.get("schema") != "browser-use-lock.v1"
        or value.get("run_id") != run_id
        or value.get("canonical_profile") != profile
        or value.get("port") != port
    ):
        raise Blocker("browser_use_single_use_execute_lock_owner_conflict")
    safe_id(value.get("nonce"), "nonce")
    return value


def reconcile_failed_single_use_execute(args: argparse.Namespace, config: dict[str, Any] | None = None) -> int:
    """Close and reconcile one failed descriptorless public one-shot launch.

    ``public`` is intentionally a non-recording one-shot command, so an
    early cleanup failure has no recording descriptor to pass to the normal
    finalize lanes.  This command is the owner-bound recovery path: it
    validates the room, profile marker, both exact locks, and the exact Chrome
    command line before closing only that process, quarantining the profile,
    releasing the locks, releasing the room, and writing one immutable receipt.
    """
    config = config or read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    profile = os.path.realpath(args.profile)
    profile_root = os.path.realpath(config["roots"]["single_use_profiles"])
    if not os.path.isabs(args.profile) or profile != args.profile or not profile.startswith(profile_root + os.sep):
        raise Blocker("browser_use_single_use_execute_profile_scope_mismatch")
    if not isinstance(args.port, int) or not (int(config["ports"]["single_use_start"]) <= args.port <= int(config["ports"]["single_use_end"])):
        raise Blocker("browser_use_single_use_execute_port_out_of_range")
    port = args.port
    _single_use_execute_room(config, room_id=args.room_id, run_id=run_id, profile=profile, port=port)
    if not os.path.isdir(profile) or os.path.islink(profile):
        raise Blocker("browser_use_single_use_execute_profile_binding_mismatch")
    marker = read_json_safe(os.path.join(profile, ".browser-use-profile.json"))
    if marker.get("schema") != "browser-use-profile.v1" or marker.get("run_id") != run_id:
        raise Blocker("browser_use_single_use_execute_profile_marker_binding_mismatch")
    locks_root = os.path.realpath(config["roots"]["locks"])
    profile_lock = os.path.join(locks_root, f'profile-{hashlib.sha256(profile.encode("utf-8")).hexdigest()[:24]}.lock')
    port_lock = os.path.join(locks_root, f"port-{port}.lock")
    profile_value = _single_use_execute_lock(profile_lock, run_id=run_id, profile=profile, port=port)
    port_value = _single_use_execute_lock(port_lock, run_id=run_id, profile=profile, port=port)
    nonce = safe_id(profile_value.get("nonce"), "nonce")
    if port_value.get("nonce") != nonce:
        raise Blocker("browser_use_single_use_execute_lock_nonce_mismatch")
    receipt_dir = os.path.realpath(os.path.join(config["roots"]["receipts"], run_id))
    assert_directory(receipt_dir, create=True)
    receipt_path = os.path.join(receipt_dir, f"{session}-{nonce}-single-use-reconciliation.json")
    if os.path.lexists(receipt_path):
        existing = read_json_safe(receipt_path)
        if (
            existing.get("schema") != SINGLE_USE_EXECUTE_RECONCILIATION_SCHEMA
            or existing.get("status") != "completed"
            or existing.get("run_id") != run_id
            or existing.get("session") != session
            or existing.get("room_id") != args.room_id
            or existing.get("profile") != profile
            or existing.get("port") != port
            or existing.get("nonce") != nonce
        ):
            raise Blocker("browser_use_single_use_execute_receipt_binding_mismatch")
        verify_chrome_absent(config["executables"]["chrome"]["canonical_path"], port, profile)
        print(json.dumps({"status": "completed", "receipt": receipt_path, **existing}, sort_keys=True))
        return 0

    process_candidates: list[Any] = []
    if psutil is None:
        raise Blocker("browser_use_process_identity_recheck_failed")
    try:
        for candidate in psutil.process_iter():
            try:
                if process_matches(candidate, config["executables"]["chrome"]["canonical_path"], port, profile):
                    process_candidates.append(candidate)
            except psutil.NoSuchProcess:
                continue
            except psutil.AccessDenied as exc:
                raise Blocker("browser_use_process_identity_recheck_failed") from exc
    except Blocker:
        raise
    except psutil.Error as exc:
        raise Blocker("browser_use_process_identity_recheck_failed") from exc
    if len(process_candidates) > 1:
        raise Blocker("browser_use_single_use_execute_multiple_processes")
    process: dict[str, Any] = {}
    if process_candidates:
        candidate = process_candidates[0]
        try:
            process = {"pid": candidate.pid, "root_pid": candidate.pid, "start_time": candidate.create_time(), "root_start_time": candidate.create_time()}
        except psutil.Error as exc:
            raise Blocker("browser_use_process_identity_recheck_failed") from exc

    runtime = os.path.join(browser_harness_root(session), "runtime")
    markers = [os.path.join(runtime, name) for name in ("bu.sock", "bu.pid", "bu.port")]
    if any(os.path.lexists(path) for path in markers):
        daemon_closed, daemon_error = close_owned_daemon_if_active(config, config["roots"]["browser_use_home"], port, session)
        if not daemon_closed:
            raise Blocker(daemon_error or "browser_use_daemon_cleanup_unverified")
    if any(os.path.lexists(path) for path in markers):
        raise Blocker("browser_use_single_use_execute_harness_daemon_present")
    if process:
        process_ok, process_error = terminate_chrome(None, process, config["executables"]["chrome"]["canonical_path"], port, profile)
        if not process_ok:
            raise Blocker(process_error or "browser_use_chrome_process_cleanup_unverified")
    verify_chrome_absent(config["executables"]["chrome"]["canonical_path"], port, profile)
    ctx = {"config": config, "lifecycle": "single-use", "run_id": run_id, "session": session, "nonce": nonce, "port": port, "profile": profile, "process": process, "room_id": args.room_id, "lock_paths": [profile_lock, port_lock], "cleanup": {}, "process_terminated": True, "listener_absent": True}
    quarantine_path = quarantine_profile(config, profile, ctx)
    released_ok, release_error = _release_locks_after_verified_cleanup(ctx, run_id, nonce)
    if not released_ok:
        raise Blocker(release_error or "browser_use_single_use_execute_cleanup_uncertain")
    if any(os.path.lexists(path) for path in (profile_lock, port_lock)):
        raise Blocker("browser_use_single_use_execute_lock_cleanup_readback_failed")
    receipt = {
        "schema": SINGLE_USE_EXECUTE_RECONCILIATION_SCHEMA,
        "status": "completed",
        "run_id": run_id,
        "session": session,
        "room_id": args.room_id,
        "nonce": nonce,
        "profile": profile,
        "port": port,
        "process_absent": True,
        "listener_absent": True,
        "harness_daemon_absent": True,
        "quarantine_path": quarantine_path,
        "locks_removed": [profile_lock, port_lock],
        "room_state": "released",
        "external_effects": "none",
    }
    json_atomic_no_replace(receipt_path, receipt)
    print(json.dumps({"status": "completed", "receipt": receipt_path, **receipt}, sort_keys=True))
    return 0


TEMPORARY_STARTUP_RECONCILIATION_SCHEMA = "browser-use-temporary-startup-reconciliation.v1"


def _temporary_startup_lock_value(lock_path: str, *, run_id: str, profile: str, port: int) -> dict[str, Any]:
    """Read one exact temporary startup lock without changing it."""
    assert_regular_file(lock_path, mode=0o600)
    value = read_json_safe(lock_path)
    if value.get("schema") != "browser-use-lock.v1":
        raise Blocker("browser_use_temporary_startup_lock_schema_mismatch")
    if value.get("run_id") != run_id or value.get("canonical_profile") != profile or value.get("port") != port:
        raise Blocker("browser_use_temporary_startup_lock_binding_mismatch")
    nonce = value.get("nonce")
    safe_id(nonce, "nonce")
    # The lock file path is itself part of the owner binding.  Newer payloads
    # may carry it explicitly; older temporary locks are bound by their
    # canonical derived path and are accepted only under that exact path.
    declared_path = value.get("path")
    if declared_path is not None and os.path.realpath(str(declared_path)) != os.path.realpath(lock_path):
        raise Blocker("browser_use_temporary_startup_lock_path_mismatch")
    return value


def _temporary_startup_room(config: dict[str, Any], *, room_id: str, run_id: str, task_id: str, profile: str, port: int) -> dict[str, Any]:
    """Require a temporary room whose persisted lease is exactly run-owned."""
    if not isinstance(room_id, str) or not room_id.startswith("room-"):
        raise Blocker("browser_use_temporary_startup_room_id_invalid")
    ledger = room_registry_read(config)
    room = next((item for item in ledger["rooms"] if item.get("room_id") == room_id), None)
    if room is None:
        raise Blocker("browser_use_temporary_startup_room_missing")
    expected_lease = hashlib.sha256(run_id.encode("utf-8")).hexdigest()
    owner = room.get("owner") if isinstance(room.get("owner"), dict) else {}
    if (
        room.get("lifecycle") != TEMPORARY_LIFECYCLE
        or room.get("state") not in ROOM_REGISTRY_STATES
        or room.get("profile") != profile
        or room.get("port") != port
        or room.get("task_id") != task_id
        or owner.get("kind") != "task"
        or owner.get("id") != task_id
        or room.get("lease_digest") != expected_lease
    ):
        raise Blocker("browser_use_temporary_startup_room_owner_conflict")
    return room


def _temporary_startup_daemon_absent(session: str) -> None:
    """Fail closed if any Harness marker for this exact session remains."""
    runtime_root = os.path.join(browser_harness_root(session), "runtime")
    markers = [os.path.join(runtime_root, name) for name in ("bu.sock", "bu.pid", "bu.port")]
    present = [path for path in markers if os.path.lexists(path)]
    if present:
        raise Blocker("browser_use_temporary_startup_harness_daemon_present")


def reconcile_temporary_startup(args: argparse.Namespace, config: dict[str, Any] | None = None) -> int:
    """Reconcile a descriptorless temporary startup failure owner-safely.

    This is deliberately separate from the single-use ``reconcile-failed-startup``
    command.  It never removes a temporary profile and never terminates a
    process; it only releases two exact locks after fresh absence readback,
    then releases the matching room and writes a bound receipt.
    """
    config = config or read_toml()
    validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    session = safe_id(args.session, "session")
    task_id = safe_id(args.task_id, "task_id")
    room_id = args.room_id
    if not isinstance(args.profile, str) or not os.path.isabs(args.profile) or os.path.realpath(args.profile) != args.profile:
        raise Blocker("browser_use_temporary_startup_profile_path_invalid")
    profile = args.profile
    temporary_root = os.path.realpath(config["roots"]["temporary_profiles"])
    if not profile.startswith(temporary_root + os.sep):
        raise Blocker("browser_use_temporary_startup_profile_scope_mismatch")
    if not isinstance(args.port, int) or not (int(config["ports"]["temporary_start"]) <= args.port <= int(config["ports"]["temporary_end"])):
        raise Blocker("browser_use_temporary_startup_port_out_of_range")
    port = args.port
    profile_lock = os.path.realpath(temporary_profile_lock_path(config, profile))
    port_lock = os.path.realpath(temporary_port_lock_path(config, port))
    locks_root = os.path.realpath(config["roots"]["locks"])
    if not profile_lock.startswith(locks_root + os.sep) or not port_lock.startswith(locks_root + os.sep):
        raise Blocker("browser_use_temporary_startup_lock_scope_mismatch")

    room = _temporary_startup_room(config, room_id=room_id, run_id=run_id, task_id=task_id, profile=profile, port=port)
    receipt_dir = os.path.realpath(config["roots"]["receipts"])
    if not os.path.isabs(config["roots"]["receipts"]) or receipt_dir != config["roots"]["receipts"]:
        raise Blocker("browser_use_temporary_startup_receipt_scope_mismatch")

    profile_exists = os.path.lexists(profile)
    if profile_exists:
        if os.path.islink(profile) or not os.path.isdir(profile):
            raise Blocker("browser_use_temporary_startup_profile_binding_mismatch")
        marker_path = os.path.join(profile, ".browser-use-profile.json")
        assert_regular_file(marker_path, mode=0o600)
        marker = read_json_safe(marker_path)
        if (
            marker.get("schema") != TEMPORARY_PROFILE_MARKER_SCHEMA
            or marker.get("lifecycle") != TEMPORARY_LIFECYCLE
            or marker.get("run_id") != run_id
            or marker.get("task_id") != task_id
            or marker.get("canonical_profile") != profile
            or marker.get("port") != port
            or marker.get("profile_lock_path") != profile_lock
            or marker.get("port_lock_path") != port_lock
        ):
            raise Blocker("browser_use_temporary_startup_profile_binding_mismatch")

    lock_exists = [os.path.lexists(profile_lock), os.path.lexists(port_lock)]
    if not any(lock_exists):
        raise Blocker("browser_use_temporary_startup_lock_set_missing")
    if not all(lock_exists):
        raise Blocker("browser_use_temporary_startup_lock_set_incomplete")
    profile_lock_value = _temporary_startup_lock_value(profile_lock, run_id=run_id, profile=profile, port=port)
    port_lock_value = _temporary_startup_lock_value(port_lock, run_id=run_id, profile=profile, port=port)
    nonce = profile_lock_value.get("nonce")
    if nonce != port_lock_value.get("nonce"):
        raise Blocker("browser_use_temporary_startup_lock_nonce_mismatch")
    nonce = safe_id(nonce, "nonce")

    # The receipt is immutable.  Check for a same-path collision before any
    # lock mutation, while still allowing a matching receipt to be read back.
    receipt_path = os.path.join(receipt_dir, f"{run_id}-temporary-startup-reconciliation-{nonce}.json")
    if os.path.lexists(receipt_path):
        existing = read_json_safe(receipt_path)
        if (
            existing.get("schema") != TEMPORARY_STARTUP_RECONCILIATION_SCHEMA
            or existing.get("status") != "completed"
            or existing.get("run_id") != run_id
            or existing.get("session") != session
            or existing.get("task_id") != task_id
            or existing.get("room_id") != room_id
            or existing.get("profile") != profile
            or existing.get("port") != port
            or existing.get("nonce") != nonce
        ):
            raise Blocker("browser_use_temporary_startup_receipt_binding_mismatch")

    verify_chrome_absent(config["executables"]["chrome"]["canonical_path"], port, profile)
    _temporary_startup_daemon_absent(session)
    released_ok, release_error, released = _release_lock_set([profile_lock, port_lock], run_id, nonce)
    if not released_ok:
        raise Blocker(release_error or "browser_use_temporary_startup_lock_release_uncertain")
    if any(os.path.lexists(path) for path in (profile_lock, port_lock)):
        raise Blocker("browser_use_temporary_startup_lock_cleanup_readback_failed")
    released_room = room_registry_release(config, room_id, run_id=run_id, activity="failed-temporary-startup-reconcile")
    receipt = {
        "schema": TEMPORARY_STARTUP_RECONCILIATION_SCHEMA,
        "status": "completed",
        "run_id": run_id,
        "session": session,
        "task_id": task_id,
        "room_id": room_id,
        "nonce": nonce,
        "profile": profile,
        "port": port,
        "process_absent": True,
        "listener_absent": True,
        "harness_daemon_absent": True,
        "locks_removed": released,
        "room_state": released_room.get("state"),
        "profile_preserved": profile_exists,
        "external_effects": "none",
    }
    if os.path.lexists(receipt_path):
        existing = read_json_safe(receipt_path)
        if existing != receipt:
            raise Blocker("browser_use_temporary_startup_receipt_binding_mismatch")
    else:
        json_atomic_no_replace(receipt_path, receipt)
    print(json.dumps({"status": "completed", "receipt": receipt_path, **receipt}, sort_keys=True))
    return 0


def _adopt_helper_for_terminal_stop(config: dict[str, Any], descriptor: dict[str, Any], descriptor_path: str) -> dict[str, Any]:
    """Adopt one current helper generation for an explicit local stop.

    Terminal stop does not dispatch a page command.  Once the descriptor,
    process identity, profile, port, and locks are bound, an explicit
    stop-only request is the read-only authorization to refresh the helper
    snapshot.  Keep the stricter explicit refresh requirement for normal
    ``record-command`` because that path can dispatch a visible action.
    """
    if descriptor.get("status") is None and descriptor.get("helper_sha256") != sha256_trusted_helper(canonical_helper_path()):
        return refresh_recording_helper_generation(config, descriptor, descriptor_path)
    return ensure_current_helper_generation(config, descriptor, descriptor_path, allow_historical=True)


def record_stop_preserve_temporary(args: argparse.Namespace) -> int:
    """Stop one owned temporary recording while retaining its login profile.

    This is an explicit alternative to ``record-finalize``.  It does not claim
    a finalized video; it records an honest stale/abandoned cleanup receipt and
    preserves the temporary profile for a later fresh-run decision.
    """
    config = read_toml()
    versions = validate_installation(config)
    run_id = safe_id(args.run_id, "run_id")
    requested_session = validate_id(args.session, "session")
    session = canonical_session_id(requested_session, config["roots"]["browser_use_home"])
    cleanup_only = bool(getattr(args, "cleanup_only", False))
    descriptor_path = os.path.realpath(args.descriptor)
    descriptor = read_recording_descriptor(
        config,
        descriptor_path,
        run_id,
        session,
        # This lane only stops the recorder and owned runtime.  It may adopt
        # one new helper generation after the exact descriptor is read, but it
        # never uses that generation for a page command.
        allow_helper_hash_mismatch=True,
        allow_pinned_helper_reexec=False,
        allow_expired_temporary=cleanup_only,
        allow_stale_runtime_recovery=cleanup_only,
    )
    descriptor = _adopt_helper_for_terminal_stop(config, descriptor, descriptor_path)
    require_temporary_task_id(args, descriptor)
    if descriptor.get("lifecycle") != TEMPORARY_LIFECYCLE or descriptor.get("owned_chrome") is not True:
        raise Blocker("browser_use_temporary_profile_preserve_unsupported")
    if descriptor.get("status") not in {"active", "continued"}:
        raise Blocker("browser_use_temporary_profile_preserve_requires_live_descriptor")
    effect_state = operation_effect_summary(descriptor)
    if effect_state != "none":
        raise Blocker("browser_use_temporary_profile_preserve_external_effects_not_none")
    recording_authority(
        config,
        descriptor,
        args.authority,
        cleanup_only=cleanup_only,
        command_class=None if cleanup_only else "record-stop-preserve-temporary",
    )
    assert_owned_locks(descriptor["lock_paths"], descriptor["run_id"], descriptor["nonce"])
    validate_recording_process(config, descriptor)
    status = read_recording_status(descriptor["status_path"], require_active=True)
    recording = recording_env(config, descriptor["recording_dir"], descriptor["status_path"], descriptor["recording_framerate"])
    source_dir = descriptor.get("recording_source_dir", descriptor["recording_dir"])
    code, readback_exit, _captured_stop = run_cli_keep_alive_capture(
        config,
        config["roots"]["browser_use_home"],
        descriptor["port"],
        descriptor["session"],
        ["record-stop", source_dir],
        recording=recording,
    )
    if code != 0 or readback_exit not in (None, 0):
        raise Blocker("browser_use_recording_stop_preserve_failed")
    write_harness_recording_status(
        descriptor["status_path"],
        recording,
        active=False,
        finalized=False,
        state="stopped_preserved",
        reason="temporary profile retained by explicit stop-only lane",
    )
    runtime = os.path.join(browser_harness_root(descriptor["session"]), "runtime")
    daemon_markers = [os.path.join(runtime, name) for name in ("bu.sock", "bu.pid", "bu.port")]
    if any(os.path.lexists(path) for path in daemon_markers):
        daemon_closed, daemon_blocker = close_owned_daemon_if_active(
            config,
            config["roots"]["browser_use_home"],
            descriptor["port"],
            descriptor["session"],
        )
        if not daemon_closed:
            raise Blocker(daemon_blocker or "browser_use_temporary_profile_preserve_daemon_cleanup_failed")
    if any(os.path.lexists(path) for path in daemon_markers):
        raise Blocker("browser_use_temporary_profile_preserve_daemon_readback_failed")
    process_ok, process_blocker = terminate_chrome(
        None,
        descriptor["process"],
        config["executables"]["chrome"]["canonical_path"],
        descriptor["port"],
        descriptor["profile"],
    )
    if not process_ok:
        raise Blocker(process_blocker or "browser_use_temporary_profile_preserve_process_cleanup_failed")
    if os.path.lexists(descriptor["profile"]):
        marker_path = os.path.join(descriptor["profile"], ".browser-use-profile.json")
        assert_regular_file(marker_path, mode=0o600)
    descriptor.update(
        {
            "status": "stale",
            "recovery_state": "cleanup_pending",
            "recording_status_state": "stopped_preserved",
            "recording_stop_preserved": True,
            "external_effects": effect_state,
            "completion_blocker": "browser_use_temporary_profile_preserved_recording_not_finalized",
        }
    )
    _write_recording_descriptor(config, descriptor_path, descriptor, replace=True)
    cleanup = cleanup_stale_recording_descriptor(
        config,
        versions,
        descriptor,
        descriptor_path,
        delete_approved=False,
    )
    if cleanup.get("cleanup", {}).get("profile_preserved") is True:
        mark_temporary_profile_shareable(config, descriptor)
    print(json.dumps({
        "status": "cleanup_completed",
        "descriptor": descriptor_path,
        "cleanup_receipt": cleanup["cleanup_receipt"],
        "cleanup": cleanup.get("cleanup", {}),
        "pending_reconciliation": cleanup.get("pending_reconciliation", []),
        "external_effects": cleanup.get("external_effects"),
        "profile_preserved": cleanup.get("cleanup", {}).get("profile_preserved") is True,
        "finalized": False,
    }, sort_keys=True))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="codex-browser-use", description="Bounded Browser Use CLI runtime; no stdout/page body/cookies/tokens/CDP URLs are persisted.")
    sub = parser.add_subparsers(dest="action", required=True)
    authority_issue = sub.add_parser("authority-issue", help="issue one fresh temporary authorized authority")
    authority_issue.add_argument("--run-id", required=True)
    authority_issue.add_argument("--session", required=True)
    authority_issue.add_argument("--output", required=True, help="absolute 0600 authority JSON path; existing files are never overwritten")
    authority_issue.add_argument("--allowed-origin", action="append", required=True)
    authority_issue.add_argument("--account-identity", required=True)
    authority_issue.add_argument("--data-exposure", required=True)
    authority_issue.add_argument("--side-effect-scope", required=True)
    authority_issue.add_argument("--ttl-seconds", type=int, required=True)
    authority_issue.add_argument("--approval", choices=("approved",), required=True)
    authority_issue.set_defaults(action="authority-issue")
    authority_renew = sub.add_parser("authority-renew", help="issue one append-only renewal for an existing recording authority")
    authority_renew.add_argument("--descriptor", required=True)
    authority_renew.add_argument("--authority", help="optional existing 0600 authority JSON; defaults to the descriptor current authority")
    authority_renew.add_argument("--output", required=True, help="new immutable 0600 renewal JSON path")
    authority_renew.add_argument("--ttl-seconds", type=int, required=True)
    authority_renew.add_argument("--approval", choices=("approved",), required=True)
    authority_renew.set_defaults(action="authority-renew")
    handoff = sub.add_parser("login-handoff", help="open one authorized URL and leave a bounded human-login session")
